# Exact upstream SpecTec sources (specs/spectec/src/README.md).
specs/spectec/src/** -whitespace
# Source under test (corpus/, see corpus/UNDER-TEST.md): third-party upstream releases kept verbatim
# so that their builds can be checked, and files generated by their build systems. They are not
# part of silmaril-lean's own code.
corpus/*/upstream/** linguist-vendored
corpus/*/generated/** linguist-generated
corpus/elf/** linguist-generated -diff
corpus/*/funcmap/** linguist-generated
corpus/*/tv/** linguist-generated
# Variant subjects keep their upstream/generated distinction; build orchestration stays owned.
corpus/variants/**/upstream/** linguist-vendored
corpus/variants/**/generated/** linguist-generated
corpus/variants/**/unstripped/** linguist-generated -diff
corpus/variants/**/stripped/** linguist-generated -diff
# Provenance remains reviewable text even alongside binary artifacts.
corpus/elf/**/receipt.json diff
corpus/elf/**/SHA256SUMS diff
corpus/variants/**/receipt.json diff
corpus/variants/**/SHA256SUMS diff
