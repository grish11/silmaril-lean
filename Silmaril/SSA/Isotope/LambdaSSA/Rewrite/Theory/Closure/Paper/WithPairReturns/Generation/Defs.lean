module

public import Silmaril.SSA.Isotope.LambdaSSA.Rewrite.Theory.Closure.Paper.WithPairReturns.Defs
public import Silmaril.SSA.Isotope.LambdaSSA.Rewrite.Theory.Closure.Paper.RetainedLet.Generation.PackedTerm.Thms
public import Silmaril.SSA.Isotope.LambdaSSA.Rewrite.Theory.Closure.Paper.WithProductDestructureReturns.Term.Defs

/-! # A recursive fragment of singleton return terms -/

public section

namespace Silmaril.Isotope.LambdaSSA.Region.Paper.WithPairReturns

open Silmaril Silmaril.Isotope.LambdaSSA

universe u v w

variable {τ : Type u} [TypeFormers τ] {Φ : Type v} [HasTy Φ τ]
  {ε : Type w} [HasEff Φ ε] (pe : ε)

open CfgEta.TypeCategory (returnRegion)
open Paper.PackedBody (applyPackedTerm_typed)
open Paper.RetainedLet (unpackBody unpackTerm unpackTerm_typed)

/-- Singleton returns generated by constructor values, calls on constructor
operands, unary sequences with packed bodies, pure cases on the input, pairs, and the two
direct projections of the input. Pair and projection returns can occur inside
the recursive cases. The flags add computed operands and returned product
destructuring where the seed supplies their respective equations. -/
inductive ReturnFragmentWithRules (computedCalls productReturns : Bool) : {X D : τ} → {t : Tm Φ} → Tm.HasType [X] t D → Prop where
  | value {X D : τ} {t : Tm Φ} (ht : Tm.BranchValue [X] t D) : ReturnFragmentWithRules computedCalls productReturns ht.hasType
  | primitive {X : τ} {t : Tm Φ} (p : Φ) (ht : Tm.BranchValue [X] t (instrSrc p)) :
      ReturnFragmentWithRules computedCalls productReturns (.op (f := p) ht.hasType)
  | call {X : τ} {t : Tm Φ} (p : Φ) {ht : Tm.HasType [X] t (instrSrc p)}
      (enabled : computedCalls = true) :
      ReturnFragmentWithRules computedCalls productReturns ht → ReturnFragmentWithRules computedCalls productReturns (.op (f := p) ht)
  | seq {X A D : τ} {a b : Tm Φ} {ha : Tm.HasType [X] a A} {hb : Tm.HasType [A] b D} :
      ReturnFragmentWithRules computedCalls productReturns ha → ReturnFragmentWithRules computedCalls productReturns hb →
      ReturnFragmentWithRules computedCalls productReturns (.let₁ ha (hb.rename ((Ren.wk [] X).lift A)))
  | retained {X A D : τ} {a c : Tm Φ} {ha : Tm.HasType [X] a A}
      {hc : Tm.HasType [product X A] c D} :
      ReturnFragmentWithRules computedCalls productReturns ha → ReturnFragmentWithRules computedCalls productReturns hc →
      ReturnFragmentWithRules computedCalls productReturns (.let₁ ha (applyPackedTerm_typed hc))
  | destructure {X A D : τ} {c : Tm Φ} {hc : Tm.HasType [product X A] c D}
      (enabled : productReturns = true) :
      ReturnFragmentWithRules computedCalls productReturns hc →
      ReturnFragmentWithRules computedCalls productReturns (unpackTerm_typed (applyPackedTerm_typed hc))
  | caseInput {A B D : τ} {a b : Tm Φ} {ha : Tm.HasType [A] a D} {hb : Tm.HasType [B] b D}
      (pa : Tm.Pure pe a) (pb : Tm.Pure pe b) : ReturnFragmentWithRules computedCalls productReturns ha → ReturnFragmentWithRules computedCalls productReturns hb →
      ReturnFragmentWithRules computedCalls productReturns (.case (.var (i := 0) rfl)
        (ha.rename ((Ren.wk [] (coprod A B)).lift A)) (hb.rename ((Ren.wk [] (coprod A B)).lift B)))
  | pair {X A B : τ} {a b : Tm Φ} {ha : Tm.HasType [X] a A} {hb : Tm.HasType [X] b B} :
      ReturnFragmentWithRules computedCalls productReturns ha → ReturnFragmentWithRules computedCalls productReturns hb → ReturnFragmentWithRules computedCalls productReturns (.pair ha hb)
  | fst (A B : τ) : ReturnFragmentWithRules computedCalls productReturns (WithProjectionReturns.fstTerm A B)
  | snd (A B : τ) : ReturnFragmentWithRules computedCalls productReturns (WithProjectionReturns.sndTerm A B)

/-- The computed-call fragment over seeds with direct projections. -/
abbrev ReturnFragmentWithCalls (computedCalls : Bool)
    {X D : τ} {t : Tm Φ} (ht : Tm.HasType [X] t D) :=
  ReturnFragmentWithRules pe computedCalls false ht

namespace ReturnFragmentWithCalls

variable {pe} {computedCalls : Bool}

abbrev value := @ReturnFragmentWithRules.value τ _ Φ _ ε _ pe computedCalls false
abbrev primitive := @ReturnFragmentWithRules.primitive τ _ Φ _ ε _ pe computedCalls false
abbrev call := @ReturnFragmentWithRules.call τ _ Φ _ ε _ pe computedCalls false
abbrev seq := @ReturnFragmentWithRules.seq τ _ Φ _ ε _ pe computedCalls false
abbrev retained := @ReturnFragmentWithRules.retained τ _ Φ _ ε _ pe computedCalls false
abbrev caseInput := @ReturnFragmentWithRules.caseInput τ _ Φ _ ε _ pe computedCalls false
abbrev pair := @ReturnFragmentWithRules.pair τ _ Φ _ ε _ pe computedCalls false
abbrev fst := @ReturnFragmentWithRules.fst τ _ Φ _ ε _ pe computedCalls false
abbrev snd := @ReturnFragmentWithRules.snd τ _ Φ _ ε _ pe computedCalls false

end ReturnFragmentWithCalls

/-- The ordered-pair fragment with constructor operands for calls. -/
abbrev ReturnFragment {X D : τ} {t : Tm Φ} (ht : Tm.HasType [X] t D) :=
  ReturnFragmentWithCalls pe false ht

namespace ReturnFragment

variable {pe}

abbrev value := @ReturnFragmentWithCalls.value τ _ Φ _ ε _ pe false
abbrev primitive := @ReturnFragmentWithCalls.primitive τ _ Φ _ ε _ pe false
abbrev seq := @ReturnFragmentWithCalls.seq τ _ Φ _ ε _ pe false
abbrev retained := @ReturnFragmentWithCalls.retained τ _ Φ _ ε _ pe false
abbrev caseInput := @ReturnFragmentWithCalls.caseInput τ _ Φ _ ε _ pe false
abbrev pair := @ReturnFragmentWithCalls.pair τ _ Φ _ ε _ pe false
abbrev fst := @ReturnFragmentWithCalls.fst τ _ Φ _ ε _ pe false
abbrev snd := @ReturnFragmentWithCalls.snd τ _ Φ _ ε _ pe false

end ReturnFragment

/-- The exact rewrite equation needed to extend generation recursively to
computed primitive operands. -/
abbrev CallReturnAgreement (Seed : VCtx τ → Region Φ → Region Φ → LCtx τ → Prop) : Prop :=
  ∀ {Γ : VCtx τ} {a : Tm Φ} (p : Φ), Tm.HasType Γ a (instrSrc p) →
    Extension.Eqv Seed Γ (returnRegion (.op p a))
      (returnRegion (.let₁ a (.op p (.var 0)))) [instrTrg p]

/-- The binary binder decodes a product input at the single return. -/
abbrev ProductReturnAgreement (Seed : VCtx τ → Region Φ → Region Φ → LCtx τ → Prop) : Prop :=
  ∀ {X A D : τ} {b : Tm Φ}, Tm.HasType [A, X] b D →
    Extension.Eqv Seed [product X A] (unpackBody (returnRegion b)) (returnRegion (unpackTerm b)) [D]

end Silmaril.Isotope.LambdaSSA.Region.Paper.WithPairReturns
