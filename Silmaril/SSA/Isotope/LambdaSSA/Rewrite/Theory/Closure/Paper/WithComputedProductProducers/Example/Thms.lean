module

public import Silmaril.SSA.Isotope.LambdaSSA.Rewrite.Theory.Closure.Paper.WithComputedProductProducers.Thms
public import Silmaril.SSA.Isotope.LambdaSSA.Rewrite.Theory.Closure.Paper.WithProductDestructureReturns.Example.Computed.Thms

/-! # A native binary let with a primitive in its right field -/

public section

namespace Silmaril.Isotope.LambdaSSA.Region.Paper.WithComputedProductProducers.Example

open Silmaril Silmaril.Isotope.LambdaSSA
open Paper.WithComputedCallReturns.Example (Atom Payload)
open Paper.WithProductDestructureReturns.Example.Computed (Packet packet_typed)
open Paper.RetainedLet.Generation.Example (Op)
open Paper.SingletonReification.BinaryLet (applyPackedPair_typed)
open Paper.Extension.Singleton (ofRegion)
open Paper.Extension.Singleton.Generation (Generated)

abbrev Seed := JoinedStep (τ := Ty Atom) (Φ := Op) false

/-- The packed body returns a record of the original input and both bound fields. -/
theorem packedBody : ValueBranches [product Payload Packet] (.br 0 (.var 0) : Region Op)
    [product Payload Packet] :=
  .br rfl (.var rfl)

/-- The native destructure of the effectful product is generated by the enlarged grammar. -/
theorem native_computed_binary_generated :
    Generated Seed (ofRegion Seed (.let₂ packet_typed (applyPackedPair_typed packedBody))) :=
  generated_guardedFragment false
    (.let₂Computed (.pair (.value (.var rfl)) (.primitive Op.produce (.var rfl))) (.branch (.var rfl)))

end Silmaril.Isotope.LambdaSSA.Region.Paper.WithComputedProductProducers.Example
