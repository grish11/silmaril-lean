module

public import Silmaril.SSA.Isotope.LambdaSSA.Typing.Defs

/-! # Typed CFG entry rewrites for λSSA

This relation closes three equations under region constructors and equivalence.
It includes empty CFG elimination, outward entry branches, and unfolding a
local entry branch with a pure value argument. Local block types are shared by
the two sides of each CFG rule.
-/

public section

universe u v

namespace Silmaril.Isotope.LambdaSSA

variable {τ : Type u} [TypeFormers τ] {Φ : Type v} [HasTy Φ τ]

set_option autoImplicit true in
set_option relaxedAutoImplicit true in
/-- Constructor values for which the categorical interpretation is a value map.
The grammar consists of variables, unit, pairs and injections. -/
inductive Tm.BranchValue : VCtx τ → Tm Φ → τ → Prop where
  | var : At Γ i A → BranchValue Γ (.var i) A
  | unit : BranchValue Γ .unit Silmaril.unit
  | pair : BranchValue Γ a A → BranchValue Γ b B → BranchValue Γ (.pair a b) (Silmaril.product A B)
  | inl : BranchValue Γ a A → BranchValue Γ (.inl a) (Silmaril.coprod A B)
  | inr : BranchValue Γ b B → BranchValue Γ (.inr b) (Silmaril.coprod A B)

namespace Region

set_option autoImplicit true in
set_option relaxedAutoImplicit true in
/-- Equivalence generated by the typed CFG entry rules and region congruence. -/
inductive CfgEquiv : VCtx τ → Region Φ → Region Φ → LCtx τ → Prop where
  | refl (h : HasType Γ r L) : CfgEquiv Γ r r L
  | symm : CfgEquiv Γ r s L → CfgEquiv Γ s r L
  | trans : CfgEquiv Γ r s L → CfgEquiv Γ s t L → CfgEquiv Γ r t L
  | let₁ (ha : Tm.HasType Γ a A) (hr : CfgEquiv (A :: Γ) r s L) :
      CfgEquiv Γ (.let₁ a r) (.let₁ a s) L
  | let₂ (ha : Tm.HasType Γ a (Silmaril.product A B)) (hr : CfgEquiv (B :: A :: Γ) r s L) :
      CfgEquiv Γ (.let₂ a r) (.let₂ a s) L
  | case (ha : Tm.HasType Γ a (Silmaril.coprod A B))
      (hl : CfgEquiv (A :: Γ) l l' L) (hr : CfgEquiv (B :: Γ) r r' L) :
      CfgEquiv Γ (.case a l r) (.case a l' r') L
  | cfg (R : Fin n → τ) (he : CfgEquiv Γ entry entry' (List.ofFn R ++ L))
      (hb : ∀ i, CfgEquiv (R i :: Γ) (blocks i) (blocks' i) (List.ofFn R ++ L)) :
      CfgEquiv Γ (.cfg entry n blocks) (.cfg entry' n blocks') L
  | cfgZero (he : HasType Γ entry L) (blocks : Fin 0 → Region Φ) :
      CfgEquiv Γ (.cfg entry 0 blocks) entry L
  | cfgBrExit (R : Fin (n + 1) → τ) (hℓ : At L ℓ A) (ha : Tm.BranchValue Γ a A)
      (hb : ∀ i, HasType (R i :: Γ) (blocks i) (List.ofFn R ++ L)) :
      CfgEquiv Γ (.cfg (.br (n + 1 + ℓ) a) (n + 1) blocks) (.br ℓ a) L
  | cfgBrLocal (R : Fin (n + 1) → τ) (i : Fin (n + 1)) (ha : Tm.BranchValue Γ a (R i))
      (hb : ∀ j, HasType (R j :: Γ) (blocks j) (List.ofFn R ++ L)) :
      CfgEquiv Γ (.cfg (.br i a) (n + 1) blocks)
        (.cfg (.let₁ a (blocks i)) (n + 1) blocks) L

end Region

end Silmaril.Isotope.LambdaSSA
