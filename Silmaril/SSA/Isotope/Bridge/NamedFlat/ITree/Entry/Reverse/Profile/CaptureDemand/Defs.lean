module

public import Silmaril.SSA.Isotope.Bridge.NamedFlat.ITree.Entry.Reverse.Profile.Straight.Defs
public import Silmaril.Semantics.Dataflow.FiniteHeight.Thms
public import Mathlib.Data.Fintype.Prod

/-! # Backward demand and installed capture layouts for named tables -/

@[expose] public section

namespace Silmaril.Isotope.Bridge.NamedFlat.Entry.Reverse.CaptureDemand

open Silmaril.SSA.LambdaRTL
open Silmaril.SSA.LambdaRTL.CFG.Cyclic
open Silmaril.Semantics.Dataflow.FiniteHeight (HeightBound)
open LambdaSSA.Semantics.Interaction.Typed.Ordered

universe u v w

section Analysis

variable {V K : Type w} {F : Type v} {n : Nat} [DecidableEq V] [DecidableEq K]
  (graph : CFG V K F) (names : Fin n → V)

/-- Resolve each syntactic jump to the first matching internal row. -/
def successors (i : Fin graph.blocks.length) : Finset (Fin graph.blocks.length) :=
  (graph.blocks[i].2.body.targets.filterMap fun label =>
    graph.blocks.findFinIdx? (fun item => label == item.1)).toFinset

/-- Free reads of entry slots other than reads of the block argument. -/
def direct (i : Fin graph.blocks.length) : Finset (Fin n) :=
  let block := graph.blocks[i].2
  Finset.univ.filter fun slot => names slot ≠ block.param ∧ names slot ∈ block.body.toRegion.fv

/-- Demand is generated by direct reads and propagated from successors.
A block parameter cannot supply an overwritten entry value. Shadowing is
checked separately, so propagation retains a downstream demand for it. -/
def transfer : Finset (Fin graph.blocks.length × Fin n) →o Finset (Fin graph.blocks.length × Fin n) where
  toFun live := Finset.univ.filter fun (row, slot) =>
    slot ∈ direct graph names row ∨ ∃ target ∈ successors graph row, (target, slot) ∈ live
  monotone' := by
    intro low high includes cell found
    refine Finset.mem_filter.mpr ⟨Finset.mem_univ _, ?_⟩
    rcases (Finset.mem_filter.mp found).2 with reads | ⟨target, edge, needed⟩
    · exact Or.inl reads
    · exact Or.inr ⟨target, edge, includes needed⟩

/-- The executable least solution over all written rows and entry slots.
The solver materializes the set of demanded row-slot pairs each round. -/
def solution : Finset (Fin graph.blocks.length × Fin n) :=
  (HeightBound.finset (Fin graph.blocks.length × Fin n)).solve (transfer graph names)

/-- Required entry slots at each row. -/
def infer : Fin graph.blocks.length → Finset (Fin n) :=
  let live := solution graph names
  fun row => Finset.univ.filter fun slot => (row, slot) ∈ live

/-- An ordered candidate keeps the caller's ordering of the selected slots. -/
def ordered (entry : List (Fin n)) (i : Fin graph.blocks.length) : List (Fin n) :=
  entry.filter fun slot => decide (slot ∈ infer graph names i)

/-- The profile includes every direct read and can supply every outgoing
internal edge from its own saved record. -/
def Closed (live : Fin graph.blocks.length → Finset (Fin n)) : Prop :=
  ∀ i, direct graph names i ⊆ live i ∧ ∀ j ∈ successors graph i, live j ⊆ live i

/-- No required entry value is stored in a register replaced by the row's argument. -/
def NoShadow (live : Fin graph.blocks.length → Finset (Fin n)) : Prop :=
  ∀ i slot, slot ∈ live i → names slot ≠ graph.blocks[i].2.param

end Analysis

section Reference

variable {κ K : Type (u + 1)} {n blocks : Nat} [DecidableEq K]
  {P : FlatInstitution.Signature.{u, v} κ}
  {context : BoundCtx (Ty κ) n} {exits : List K} {external : Fin exits.length → Ty κ}
  {fields : K → List (Register × Ty κ)}
  {code : LambdaSSA.FiniteCFG P.Instr blocks exits.length n}

variable (a : Lowered (numberedInterface context exits external) fields code)

local notation "attached" => withLiveOut (P := P) fields a.source
local notation "versioned" => Versioning.compile attached

/-- Interpret a numbered register as an entry slot if it is in range. -/
def toSlot (n : Nat) (reg : Register.{u}) : Option (Fin n) :=
  if bound : reg.down < n then some ⟨reg.down, bound⟩ else none

/-- Numbered registers saved by at least one destination, in the actual
versioner's support order. -/
def referenceEntry : List (Fin n) :=
  let used := (Versioning.registers attached).filter fun reg =>
    decide (∃ i : Fin (attached).blocks.length, reg ≠ (attached).blocks[i].2.param)
  used.filterMap (toSlot n)

/-- The actual installed slot lists, restricted to numbered captures.
The reference check rejects any out-of-range installed field. -/
def referenceLayouts (i : Fin (versioned).blocks.length) : List (Fin n) :=
  (a.savedRegisters i).filterMap (toSlot n)

/-- Check exactly the premises for source-local admission of the installed
layouts. Their ordered projections are derived from the actual slot rule. -/
def referenceReady [DecidableEq κ] (R : Fin blocks → Ty κ) : Bool :=
  decide a.SavesCaptures && Straight.keepsEntryCaptures a (referenceEntry a) &&
    Straight.checksCaptureEdges a (referenceLayouts a) && Straight.checks a R

end Reference

end Silmaril.Isotope.Bridge.NamedFlat.Entry.Reverse.CaptureDemand
