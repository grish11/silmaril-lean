module

public import Silmaril.SSA.SeaOfNodes.Memory.Loop.TwoAddress.Institution.Sequential.Linked.Satisfaction.Defs
public import Silmaril.SSA.SeaOfNodes.Memory.Loop.TwoAddress.Institution.Sequential.Linked.Triple.Defs
public import Silmaril.SSA.SeaOfNodes.Memory.Loop.TwoAddress.Institution.Sequential.Linked.Triple.MemRef.Defs

/-! Opt-in sentences for the emitted three-loop Boundary chain. -/

@[expose] public section

namespace Silmaril.SSA.SeaOfNodes.Memory.Loop.TwoAddress.Institution.Sequential.Linked.Triple.Satisfaction

open CategoryTheory
open RVSDG (Tuple)
open RVSDG.NestedTheta.Institution
open Silmaril.MLIR.MemRef (Buffer)
open Memory.Diamond.Institution renaming Signature → EntrySignature, Model → EntryModel

variable {P Q : EntrySignature} {cells : Nat}

/-- Extend the existing typed pair boundary with a third loop. The last
wiring reads the second return and the second entry captures. -/
structure Program (P : EntrySignature) where
  pair : Linked.Satisfaction.Program P
  last : EntrySignature
  third : Graph last.args
  wiring : Boundary.Wiring pair.next.args last.args

/-- Re-emit the pair at its new ambient boundary. The last wiring is
still over the second loop's unchanged capture signature. -/
def Program.map (h : P ⟶ Q) (p : Program P) : Program Q :=
  ⟨p.pair.map h, p.last, p.third, p.wiring⟩

def Program.emitNumbered (p : Program P) :
    RuntimeObservation.Program target (carrier P.args) (carrier [.word, .word, .word]) :=
  Triple.program p.pair.first p.pair.second p.third p.pair.wiring p.wiring

def Program.runMemRef (p : Program P) (model : EntryModel P) (fuel : Nat) (initial : Buffer model.cells) :
    Option (MemRef.Result model.cells) :=
  MemRef.runFuel p.pair.first p.pair.second p.third p.pair.wiring p.wiring model.input fuel initial

noncomputable def Program.numberedObserve (p : Program P) (model : EntryModel P)
    (initial : Heap model.cells) : Part (Tuple (WireVal model.cells) (carrier [.word, .word, .word])) :=
  RuntimeObservation.observe (P := target) (thetaRuntime model.cells) p.emitNumbered.graph
    (encodeInput initial model.input)

abbrev Returns (cells : Nat) := Heap cells → Triple.Result cells → Prop

/-- Each relation witnesses a result from its own actual backend. -/
def Program.numberedReturns (p : Program P) (model : EntryModel P) : Returns model.cells :=
  fun initial out => p.emitNumbered.graph.Returns (thetaRuntime model.cells)
    (encodeInput initial model.input) (resultCodec model.cells out)

def Program.memrefReturns (p : Program P) (model : EntryModel P) : Returns model.cells :=
  fun initial (firstWord, secondWord, thirdWord, final) =>
    ∃ fuel, p.runMemRef model fuel ⟨initial⟩ = some (firstWord, secondWord, thirdWord, ⟨final⟩)

def Program.colouredReturns (p : Program P) (model : EntryModel P) : Returns model.cells :=
  fun initial out => RVSDG.NestedTheta.Petri.Finishes (thetaRuntime model.cells) p.emitNumbered.graph
    (encodeInput initial model.input) (resultCodec model.cells out)

/-- The checked fragment of the runtime observation syntax generated by
typed three-loop chains at a common ambient capture signature. -/
inductive Sentence (P : EntrySignature) where
  | equation (lhs rhs : Program P)
  | terminates (p : Program P)

def Sentence.numbered : Sentence P → RuntimeObservation.Sentence target
  | .equation lhs rhs => .equation lhs.emitNumbered rhs.emitNumbered
  | .terminates p => .terminates p.emitNumbered

def Sentence.map (h : P ⟶ Q) : Sentence P → Sentence Q
  | .equation lhs rhs => .equation (lhs.map h) (rhs.map h)
  | .terminates p => .terminates (p.map h)

/-- At a fixed typed valuation, equations compare finite results over
all initialized heaps. Termination requires a finite result for each heap. -/
def Sentence.HoldsWith (s : Sentence P) (returns : Program P → Returns cells) : Prop :=
  match s with
  | .equation lhs rhs => ∀ initial out, returns lhs initial out ↔ returns rhs initial out
  | .terminates p => ∀ initial, ∃ out, returns p initial out

def Sentence.NumberedHolds (s : Sentence P) (model : EntryModel P) : Prop :=
  s.HoldsWith (Program.numberedReturns · model)

def Sentence.MemRefHolds (s : Sentence P) (model : EntryModel P) : Prop :=
  s.HoldsWith (Program.memrefReturns · model)

def Sentence.ColouredHolds (s : Sentence P) (model : EntryModel P) : Prop :=
  s.HoldsWith (Program.colouredReturns · model)

end Silmaril.SSA.SeaOfNodes.Memory.Loop.TwoAddress.Institution.Sequential.Linked.Triple.Satisfaction
