private theorem crossSharedDropDestructorSetup {left right : Config (core3 grow) (HostState sig)}
    {thread frames rest peerFrames peerRest} {callerFrame : Seg (core3 grow) (HostState sig)}
    {leftTicket rightTicket} {leading trailing : Trace grow sig}
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (result : InstId × DtorRequest (core3 grow))
    (split : labels = leading ++ trailing)
    (paired : HostFrame.Related.Paired older start incoming)
    (paths : OccurrenceTransport profile ready base bindings start incoming (.tau :: leading) (.tau :: leading)
      left right [some (.active 0 0)])
    (writers : VisitorWriterPath profile ready base bindings start incoming (.tau :: leading) (.tau :: leading) left right)
    (site : PairedComponentSite older left right ⟨thread, callerFrame :: frames, rest⟩ ⟨thread, callerFrame :: peerFrames, peerRest⟩)
    (leftFocus : left.ctl = (PayloadPrefix.Cursor.mk thread (callerFrame :: frames) rest).control
      (SharedOwnerDrop.afterSpend leftTicket result))
    (rightFocus : right.ctl = (PayloadPrefix.Cursor.mk thread (callerFrame :: peerFrames) peerRest).control
      (SharedOwnerDrop.afterSpend rightTicket result))
    (run : Steps profile ready (specDispatch ready base) left trailing finish)
    (compare : ShorterCallbackSlices profile ready base bindings (.tau :: labels).length) :
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, callerFrame :: frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, callerFrame :: peerFrames, peerRest⟩
  cases implementation : result.2.impl with
  | none =>
    rw [sharedDestructorCode] at leftFocus rightFocus
    simp only [sharedDestructorWorker, implementation, sharedDestructorStart, Prog.pure_eq,
      Prog.bind_eq, Prog.pure_bind'] at leftFocus rightFocus
    exact finishSharedResult (leftTicket := leftTicket) (rightTicket := rightTicket) (.ok 0)
      split paired paths writers site leftFocus rightFocus run
  | some impl =>
    rw [sharedDestructorTaskCode result impl implementation] at leftFocus rightFocus
    let checked (task : TaskId) := sharedDestructorStart (sig := sig) leftTicket (some (sharedDestructorThread task result.2.dtor))
    let canonical (task : TaskId) := sharedDestructorStart (sig := sig) rightTicket (some (sharedDestructorThread task result.2.dtor))
    let callerEntry := (Caller.sub (.destructor result.2.rep) : Caller (core3 grow))
    let allocateTask (rep : AddrType) (caller : CallerId) : Session grow sig TaskId :=
      allocObj ArenaField.tasks (sharedDestructorTaskRecord impl rep caller).val
    let allocateCaller : Session grow sig CallerId := allocObj ArenaField.callers callerEntry
    let afterCallerChecked rep caller := allocateTask rep caller >>= checked
    let afterCallerCanonical rep caller := allocateTask rep caller >>= canonical
    obtain ⟨used, suffix, reached, peer, divided, localPaths, residual, boundary, _, _, checkedPath, rawPath, stationary⟩ :=
      cutComponentStoreBodyFramed (bindings := bindings) (closed := True) (sharedDestructorResourceRep result)
        (fun rep => allocateCaller >>= afterCallerChecked rep) (fun rep => allocateCaller >>= afterCallerCanonical rep)
        (fun _ => sharedDestructorResourceRepEffects result) (trivialPreserves _) trivial leftFocus rightFocus site run
    have usedAll : labels = (leading ++ used) ++ suffix := by rw [split, divided, List.append_assoc]
    have traced : VisitorWriterPath profile ready base bindings start incoming (.tau :: (leading ++ used))
        (.tau :: (leading ++ used)) reached peer := by
      simpa only [List.cons_append] using writers.append (.framed checkedPath rawPath)
    obtain ⟨_, through, _⟩ := CallbackPrefix.transportAppend paths localPaths
    have stop (terminal : suffix = [] ∨ (reached.ctl = [] ∧ peer.ctl = [])) :
        CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
      exact .inr (callbackTerminalSlice paired (by
        rw [usedAll, ← List.cons_append]
        exact .coreAcceptTerminal (by simpa only [List.cons_append] using through) traced residual
          (terminal.elim Or.inl (fun trapped => .inr (.inr (.inr trapped))))))
    cases boundary with
    | pending _ _ _ _ _ normal => exact stop (.inl (normal.resolve_right (fun unsupported => unsupported.1 trivial)))
    | trapped checked raw aligned => exact stop (.inr ⟨checked, raw⟩)
    | returned rep atCheck atCanon frame =>
      have retained := retainComparedOccurrences paths (stationary (by
        rw [atCheck]
        cases check
        exact List.cons_ne_nil _ _)).2
      refine crossSharedDestructorAllocation ArenaField.callers callerEntry (afterCallerChecked rep) (afterCallerCanonical rep)
        usedAll paired (by simpa only [List.cons_append] using retained) traced frame atCheck atCanon residual ?_
      intro remaining usedCaller
      dsimp only
      intro callerPaths callerWriters callerSite callerRun
      let caller := ArenaField.callers.alloc reached.store callerEntry
      let entry := sharedDestructorTaskRecord (grow := grow) impl rep caller.2
      refine crossSharedDestructorAllocation ArenaField.tasks entry.val checked canonical usedCaller paired
        callerPaths callerWriters callerSite rfl rfl callerRun ?_
      intro rest usedTask
      dsimp only
      intro taskPaths taskWriters taskSite taskRun
      let allocation := ArenaField.tasks.alloc caller.1 entry.val
      exact crossSharedDestructorWorker (leftTicket := leftTicket) (rightTicket := rightTicket)
        embedder allocation.2 result.2.dtor (sharedDestructorThread allocation.2 result.2.dtor) rfl
        (ArenaField.tasks.get?_alloc_self caller.1 entry.val) entry.property
        (width := rep) rfl rfl
        (ArenaField.callers.get?_alloc_self reached.store callerEntry)
        usedTask paired taskPaths taskWriters taskSite rfl rfl taskRun compare

open ReturnFrame.Occurrence Stored.OwnedMemory.Claims in
private theorem crossSharedDropSpend {left right checked raw : Config (core3 grow) (HostState sig)}
    {thread frames rest peerFrames peerRest} {callerFrame : Seg (core3 grow) (HostState sig)}
    {leftTicket rightTicket rep} {leading remaining : Trace grow sig}
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (drop : SharedOwnerDrop)
    (split : labels = leading ++ .tau :: remaining)
    (paired : HostFrame.Related.Paired older start incoming)
    (paths : OccurrenceTransport profile ready base bindings start incoming (.tau :: leading) (.tau :: leading)
      left right [some (.active 0 0)])
    (writers : VisitorWriterPath profile ready base bindings start incoming (.tau :: leading) (.tau :: leading) left right)
    (before : PairedComponentSite older left right ⟨thread, callerFrame :: frames, rest⟩ ⟨thread, callerFrame :: peerFrames, peerRest⟩)
    (leftFocus : left.ctl = (PayloadPrefix.Cursor.mk thread (callerFrame :: frames) rest).control (drop.claim.probe drop.inst leftTicket))
    (rightFocus : right.ctl = (PayloadPrefix.Cursor.mk thread (callerFrame :: peerFrames) peerRest).control (drop.claim.probe drop.inst rightTicket))
    (leftLive : drop.claim.observe left.host.writer = .ok rep)
    (rightLive : drop.claim.observe right.host.writer = .ok rep)
    (leftGuard : checked = { left with
      ctl := (PayloadPrefix.Cursor.mk thread (callerFrame :: frames) rest).control
        (drop.prepare rep >>= drop.spend leftTicket) })
    (rightGuard : raw = { right with
      ctl := (PayloadPrefix.Cursor.mk thread (callerFrame :: peerFrames) peerRest).control
        (drop.prepare rep >>= drop.spend rightTicket) })
    (guard : Step profile ready (specDispatch ready base) left .tau checked)
    (peerGuard : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) right .tau raw)
    (run : Steps profile ready (specDispatch ready base) checked remaining finish)
    (compare : ShorterCallbackSlices profile ready base bindings (.tau :: labels).length) :
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, callerFrame :: frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, callerFrame :: peerFrames, peerRest⟩
  subst checked
  subst raw
  let checked := { left with ctl := check.control (drop.prepare rep >>= drop.spend leftTicket) }
  let raw := { right with ctl := canon.control (drop.prepare rep >>= drop.spend rightTicket) }
  have frame : PairedComponentSite older checked raw check canon := by
    unfold PairedComponentSite HostFrame.Related.Paired HostFrame.replace at before ⊢
    exact before
  have guards := retainComparedOccurrences paths (fun place =>
    ⟨Prefix.step guard (by rw [transitionEdit, leftFocus]; cases place <;> rfl) (.done _ _),
     Prefix.step peerGuard (by rw [transitionEdit, rightFocus]; cases place <;> rfl) (.done _ _)⟩)
  have guardedWriters := writers.append (.framed (.same guard rfl (.done _)) (.same peerGuard rfl (.done _)))
  obtain ⟨prep, suffix, reached, peer, divided, localPaths, residual, boundary, _, _, checkedPath, rawPath, stationary⟩ :=
    cutComponentStoreBodyFramed (bindings := bindings) (closed := True) (drop.prepare rep)
      (drop.spend leftTicket) (drop.spend rightTicket) (fun _ => sharedDropPrepareEffects drop rep)
      (trivialPreserves _) trivial rfl rfl frame run
  let leadingPrep := leading ++ .tau :: prep
  have used : labels = leadingPrep ++ suffix := by
    rw [split, divided]
    simp only [leadingPrep, List.cons_append, List.append_assoc]
  have preparedWriters : VisitorWriterPath profile ready base bindings start incoming
      (.tau :: leadingPrep) (.tau :: leadingPrep) reached peer := by
    simpa only [leadingPrep, List.cons_append, List.append_assoc, List.singleton_append, List.nil_append] using
      guardedWriters.append (.framed checkedPath rawPath)
  have early (terminal : suffix = [] ∨ (reached.ctl = [] ∧ peer.ctl = [])) :
      CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
    obtain ⟨_, through, _⟩ := CallbackPrefix.transportAppend guards localPaths
    exact .inr (callbackTerminalSlice paired (by
      rw [used, ← List.cons_append]
      exact .coreAcceptTerminal
        (by simpa only [leadingPrep, List.cons_append, List.append_assoc, List.singleton_append, List.nil_append] using through)
        preparedWriters residual (terminal.elim Or.inl (fun trapped => .inr (.inr (.inr trapped))))))
  cases boundary with
  | pending op next leftAt rightAt atSite normal =>
    exact early (.inl (normal.resolve_right (fun unsupported => unsupported.1 trivial)))
  | trapped leftAt rightAt atSite => exact early (.inr ⟨leftAt, rightAt⟩)
  | returned result leftAt rightAt atSite =>
    have prepared : OccurrenceTransport profile ready base bindings start incoming (.tau :: leadingPrep) (.tau :: leadingPrep)
        reached peer [some (.active 0 0)] := by
      have retained := stationary (by rw [leftAt]; cases check; exact List.cons_ne_nil _ _)
      simpa only [leadingPrep, List.cons_append, List.append_assoc, List.singleton_append, List.nil_append] using
        retainComparedOccurrences guards retained.2
    let spendHost (host : HostState sig) : HostState sig :=
      { host with writer := (Spend.owner drop.identity).apply host.writer }
    let writeAfter (ticket : Nat) (host : HostState sig) : Session grow sig (Ret (core3 grow)) :=
      .op (.hostSet (spendHost host)) (fun _ => SharedOwnerDrop.afterSpend ticket result)
    let leftWrite := { reached with ctl := check.control (writeAfter leftTicket reached.host) }
    let rightWrite := { peer with ctl := canon.control (writeAfter rightTicket peer.host) }
    have read : Step profile ready (specDispatch ready base) reached .tau leftWrite :=
      .hostGet (th := check.thread) (segs := check.frames) (rest := check.rest) (k := writeAfter leftTicket) leftAt
    have peerRead : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) peer .tau rightWrite :=
      .hostGet (th := canon.thread) (segs := canon.frames) (rest := canon.rest) (k := writeAfter rightTicket) rightAt
    rcases splitSilent (count := 1) (.cons read (.refl _)) residual with ⟨thenLabels, readUsed, afterRead⟩ | short
    · have beforeCommit := retainComparedOccurrences prepared (fun place =>
        ⟨Prefix.step read (by rw [transitionEdit, leftAt]; cases place <;> rfl) (.done _ _),
         Prefix.step peerRead (by rw [transitionEdit, rightAt]; cases place <;> rfl) (.done _ _)⟩)
      let leftDone := { leftWrite with
        host := spendHost leftWrite.host
        ctl := check.control (SharedOwnerDrop.afterSpend leftTicket result) }
      let rightDone := { rightWrite with
        host := spendHost rightWrite.host
        ctl := canon.control (SharedOwnerDrop.afterSpend rightTicket result) }
      have commit : Step profile ready (specDispatch ready base) leftWrite .tau leftDone :=
        .hostSet (th := check.thread) (segs := check.frames) (rest := check.rest)
          (s := leftDone.host) (k := fun _ => SharedOwnerDrop.afterSpend leftTicket result) rfl
      have peerCommit : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) rightWrite .tau rightDone :=
        .hostSet (th := canon.thread) (segs := canon.frames) (rest := canon.rest)
          (s := rightDone.host) (k := fun _ => SharedOwnerDrop.afterSpend rightTicket result) rfl
      rcases splitSilent (count := 1) (.cons commit (.refl _)) afterRead with ⟨tail, committed, continuation⟩ | short
      · obtain ⟨leftSpent, leftPrepared⟩ := reachedOwnerPrepared drop.resource drop.identity leftLive
        obtain ⟨rightSpent, rightPrepared⟩ := reachedOwnerPrepared drop.resource drop.identity rightLive
        have certified : ExecutedSharedDropSpend profile ready (specDispatch ready base) drop rep leftTicket result prep left leftDone :=
          ⟨check, checked, reached, leftWrite, leftSpent, leftFocus, leftPrepared, rfl, leftAt, rfl, rfl,
            guard, checkedPath, read, commit⟩
        have rawCertified : ExecutedSharedDropSpend profile ready (specDispatch ready (LiveDispatch.host bindings base))
            drop rep rightTicket result prep right rightDone :=
          ⟨canon, raw, peer, rightWrite, rightSpent, rightFocus, rightPrepared, rfl, rightAt, rfl, rfl,
            peerGuard, rawPath, peerRead, peerCommit⟩
        let consumed := leading ++ .tau :: (prep ++ [.tau, .tau])
        have whole : labels = consumed ++ tail := by
          rw [used, readUsed, committed]
          simp only [consumed, leadingPrep, List.append_assoc, List.cons_append,
            List.replicate_succ, List.replicate_zero, List.nil_append]
        have moved : OccurrenceTransport profile ready base bindings start incoming (.tau :: consumed) (.tau :: consumed)
            leftDone rightDone [some (.active 0 0)] := by
          simpa only [consumed, leadingPrep, List.cons_append, List.append_assoc, List.singleton_append, List.nil_append] using
            retainComparedOccurrences beforeCommit (fun place =>
              ⟨Prefix.step commit (by cases place <;> rfl) (.done _ _),
               Prefix.step peerCommit (by cases place <;> rfl) (.done _ _)⟩)
        have traced : VisitorWriterPath profile ready base bindings start incoming (.tau :: consumed) (.tau :: consumed) leftDone rightDone := by
          simpa only [consumed, List.cons_append] using writers.append (.dropCommit certified rawCertified)
        exact crossSharedDropDestructorSetup (leftTicket := leftTicket) (rightTicket := rightTicket) embedder result whole paired moved traced
          (by
            unfold PairedComponentSite HostFrame.Related.Paired HostFrame.replace at atSite ⊢
            exact pairQuietHost atSite _) rfl rfl continuation compare
      · have empty : thenLabels = [] := List.length_eq_zero_iff.mp (by omega)
        have stopped : finish = leftWrite := by
          have atEnd : Steps profile ready (specDispatch ready base) leftWrite [] finish := empty ▸ afterRead
          exact stepsAtEmpty atEnd
        exact .inr (callbackTerminalSlice paired (by
          rw [used, readUsed, empty, stopped]
          simpa only [List.cons_append, List.append_assoc, List.singleton_append, List.append_nil, List.replicate_succ,
            List.replicate_zero] using
            (CallbackSliceEnd.coreAcceptTerminal (changes := older) beforeCommit
              (preparedWriters.append (.framed (.same read rfl (.done _)) (.same peerRead rfl (.done _)))) (.refl _) (.inl rfl))))
    · exact early (.inl (List.length_eq_zero_iff.mp (by omega)))

open ReturnFrame.Occurrence in
private theorem crossSharedClaim {left right : Config (core3 grow) (HostState sig)}
    {thread frames rest peerFrames peerRest} {callerFrame : Seg (core3 grow) (HostState sig)}
    {name kind inst leftTicket rightTicket position} {tree : Stored.OwnedMemory.Tree sig}
    {action : SharedGiveAction} {claim : SharedGiveClaim}
    {leading trailing : Trace grow sig}
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (linked : resolveBinding bindings name kind = .ok ⟨name, inst, action.bindingAction⟩)
    (source : action.claimAt tree position = some claim)
    (split : labels = leading ++ trailing)
    (paired : HostFrame.Related.Paired older start incoming)
    (paths : OccurrenceTransport profile ready base bindings start incoming (.tau :: leading) (.tau :: leading)
      left right [some (.active 0 0)])
    (writers : VisitorWriterPath profile ready base bindings start incoming (.tau :: leading) (.tau :: leading) left right)
    (site : PairedComponentSite older left right ⟨thread, callerFrame :: frames, rest⟩ ⟨thread, callerFrame :: peerFrames, peerRest⟩)
    (leftFocus : left.ctl = (PayloadPrefix.Cursor.mk thread (callerFrame :: frames) rest).control (claim.probe inst leftTicket))
    (rightFocus : right.ctl = (PayloadPrefix.Cursor.mk thread (callerFrame :: peerFrames) peerRest).control (claim.probe inst rightTicket))
    (run : Steps profile ready (specDispatch ready base) left trailing finish)
    (compare : ShorterCallbackSlices profile ready base bindings (.tau :: labels).length) :
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  classical
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, callerFrame :: frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, callerFrame :: peerFrames, peerRest⟩
  cases run with
  | refl =>
    exact .inr (callbackTerminalSlice paired (by
      rw [split, ← List.cons_append]
      exact .coreAcceptTerminal paths writers (.refl _) (.inl rfl)))
  | @cons _ _ finish label tail actual residual =>
    let lhs := claim.observe left.host.writer
    let rhs := claim.observe right.host.writer
    let checked := { left with ctl := check.control (claim.afterRead inst leftTicket lhs) }
    let raw := { right with ctl := canon.control (claim.afterRead inst rightTicket rhs) }
    have first : Step profile ready (specDispatch ready base) left .tau checked := .hostGet leftFocus
    have other : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) right .tau raw := .hostGet rightFocus
    obtain ⟨rfl, rfl⟩ := silentStepUnique first actual
    have moved : OccurrenceTransport profile ready base bindings start incoming
        (.tau :: (leading ++ [.tau])) (.tau :: (leading ++ [.tau])) checked raw [some (.active 0 0)] := by
      simpa only [List.cons_append] using retainComparedOccurrences paths (fun place =>
        ⟨Prefix.step first (by rw [transitionEdit, leftFocus]; cases place <;> rfl) (.done _ _),
         Prefix.step other (by rw [transitionEdit, rightFocus]; cases place <;> rfl) (.done _ _)⟩)
    have used : labels = (leading ++ [.tau]) ++ tail := by
      rw [split]
      simp only [List.append_assoc, List.singleton_append]
    have atReads : PairedComponentSite older checked raw check canon := by
      unfold PairedComponentSite HostFrame.Related.Paired HostFrame.replace at site ⊢
      exact site
    let checkedPath : WriterPath profile ready (specDispatch ready base) left [.tau] checked [] :=
      .same first rfl (.done _)
    let rawPath : WriterPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) right [.tau] raw [] :=
      .same other rfl (.done _)
    by_cases agrees : lhs = rhs
    · have extended : VisitorWriterPath profile ready base bindings start incoming
          (.tau :: (leading ++ [.tau])) (.tau :: (leading ++ [.tau])) checked raw := by
        simpa only [List.cons_append] using writers.append (.framed checkedPath rawPath)
      cases outcome : lhs with
      | error issue =>
        exact finishSharedResult (leftTicket := leftTicket) (rightTicket := rightTicket) (.error (.claim issue))
          used paired moved extended atReads
          (by show check.control (claim.afterRead inst leftTicket lhs) = _; rw [outcome]; rfl)
          (by show canon.control (claim.afterRead inst rightTicket rhs) = _; rw [← agrees, outcome]; rfl) residual
      | ok permit =>
        cases claim with
        | endpoint channel element identity =>
          cases permit
          let endpoint : SharedEndpointGive := ⟨channel, element, identity, inst⟩
          have leftObserved : endpoint.claim.observe left.host.writer = .ok () := outcome
          have rightObserved : endpoint.claim.observe right.host.writer = .ok () := by
            change rhs = .ok ()
            rw [← agrees, outcome]
          exact crossSharedEndpointReady (leftTicket := leftTicket) (rightTicket := rightTicket) endpoint split paired paths writers
            site leftFocus rightFocus leftObserved rightObserved
            (by change { left with ctl := check.control (endpoint.claim.afterRead inst leftTicket lhs) } = _
                rw [outcome]
                exact congrArg (fun program => { left with ctl := check.control program })
                  (sharedEndpointReadyCode endpoint leftTicket))
            (by change { right with ctl := canon.control (endpoint.claim.afterRead inst rightTicket rhs) } = _
                rw [← agrees, outcome]
                exact congrArg (fun program => { right with ctl := canon.control program })
                  (sharedEndpointReadyCode endpoint rightTicket)) first other residual
        | giveOwner resource identity =>
          let owner : SharedOwnerGive := ⟨resource, identity, inst⟩
          have leftObserved : owner.claim.observe left.host.writer = .ok permit := outcome
          have rightObserved : owner.claim.observe right.host.writer = .ok permit := by
            change rhs = .ok permit
            rw [← agrees, outcome]
          exact crossSharedOwnerSpend (leftTicket := leftTicket) (rightTicket := rightTicket) owner split paired paths writers
            site leftFocus rightFocus leftObserved rightObserved
            (by change { left with ctl := check.control (owner.claim.afterRead inst leftTicket lhs) } = _
                rw [outcome]
                exact congrArg (fun program => { left with ctl := check.control program })
                  (sharedOwnerSpendCode owner permit leftTicket))
            (by change { right with ctl := canon.control (owner.claim.afterRead inst rightTicket rhs) } = _
                rw [← agrees, outcome]
                exact congrArg (fun program => { right with ctl := canon.control program })
                  (sharedOwnerSpendCode owner permit rightTicket)) first other residual
        | dropOwner resource identity =>
          let drop : SharedOwnerDrop := ⟨resource, identity, inst⟩
          have leftObserved : drop.claim.observe left.host.writer = .ok permit := outcome
          have rightObserved : drop.claim.observe right.host.writer = .ok permit := by
            change rhs = .ok permit
            rw [← agrees, outcome]
          exact crossSharedDropSpend (leftTicket := leftTicket) (rightTicket := rightTicket) embedder drop split paired paths writers
            site leftFocus rightFocus leftObserved rightObserved
            (by change { left with ctl := check.control (drop.claim.afterRead inst leftTicket lhs) } = _
                rw [outcome]
                exact congrArg (fun program => { left with ctl := check.control program })
                  (sharedOwnerDropCode drop permit leftTicket))
            (by change { right with ctl := canon.control (drop.claim.afterRead inst rightTicket rhs) } = _
                rw [← agrees, outcome]
                exact congrArg (fun program => { right with ctl := canon.control program })
                  (sharedOwnerDropCode drop permit rightTicket)) first other residual compare
    · have difference : SharedGiveProbeMismatch claim inst leftTicket rightTicket left right checked raw check canon :=
        ⟨leftFocus, rightFocus, rfl, rfl, agrees⟩
      have extended : VisitorWriterPath profile ready base bindings start incoming
          (.tau :: (leading ++ [.tau])) (.tau :: (leading ++ [.tau])) checked raw := by
        simpa only [List.cons_append] using writers.append (.sharedGiveMismatch difference checkedPath rawPath)
      exact .inr (callbackTerminalSlice paired (by
        rw [used, ← List.cons_append]
        exact .sharedGiveProbeMismatch linked source difference moved extended residual))

private theorem sharedRecordVisibleAppend {live leading : Trace grow sig}
    (used : Trace grow sig) (seen : PayloadPrefix.visible live = PayloadPrefix.visible (.tau :: leading)) :
    PayloadPrefix.visible (live ++ used) = PayloadPrefix.visible (.tau :: (leading ++ used)) := by
  rw [← List.cons_append, visibleAppend, visibleAppend, seen]

open ReturnFrame.Occurrence Stored.Endpoints in
private def SharedRecordAt (profile : ProfileKind) (ready : HostReady (HostState sig))
    (base : HostImpl (core3 grow) (HostState sig)) (bindings : List (Binding sig))
    (older : ReturnFrame.Substitutions (core3 grow) (HostState sig)) (start incoming : Config (core3 grow) (HostState sig))
    (labels : Trace grow sig) (finish : Config (core3 grow) (HostState sig))
    (check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig))
    {Result : Type} (checked canonical : Result → Session grow sig (Ret (core3 grow))) : Prop :=
  ∀ {left right : Config (core3 grow) (HostState sig)} {leading live trailing : Trace grow sig}
    (result : Result),
    labels = leading ++ trailing →
    PayloadPrefix.visible live = PayloadPrefix.visible (.tau :: leading) →
    OccurrenceTransport profile ready base bindings start incoming (.tau :: leading) live
      left right [some (.active 0 0)] →
    VisitorWriterPath profile ready base bindings start incoming (.tau :: leading) live left right →
    PairedComponentSite older left right check canon →
    left.ctl = check.control (checked result) →
    right.ctl = canon.control (canonical result) →
    Steps profile ready (specDispatch ready base) left trailing finish →
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish

open ReturnFrame.Occurrence in
private def SharedRecordContinuation (profile : ProfileKind) (ready : HostReady (HostState sig))
    (base : HostImpl (core3 grow) (HostState sig)) (bindings : List (Binding sig))
    (older : ReturnFrame.Substitutions (core3 grow) (HostState sig)) (start incoming : Config (core3 grow) (HostState sig))
    (labels : Trace grow sig) (finish : Config (core3 grow) (HostState sig))
    (caller : Seg (core3 grow) (HostState sig))
    {Result : Type} (checked canonical : Result → Session grow sig (Ret (core3 grow))) : Prop :=
  ∀ {thread frames rest peerFrames peerRest},
    SharedRecordAt profile ready base bindings older start incoming labels finish
      ⟨thread, caller :: frames, rest⟩ ⟨thread, caller :: peerFrames, peerRest⟩ checked canonical

open ReturnFrame.Occurrence Stored.OwnedMemory.Claims Stored.Endpoints in
private theorem cutSharedRecordPrepare {left right : Config (core3 grow) (HostState sig)}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    (plan : List RecordLower.Object)
    (checkedNext canonicalNext : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow)))
    (site : PairedComponentSite older left right check canon)
    (leftFocus : left.ctl = check.control
      (.op .get (fun store => .op .hostGet (fun state => checkedNext (Record.prepare store state.writer plan)))))
    (rightFocus : right.ctl = canon.control
      (.op .get (fun store => .op .hostGet (fun state => canonicalNext (Record.prepare store state.writer plan)))))
    (run : Steps profile ready (specDispatch ready base) left labels finish) :
    ∃ used trailing reached peer, labels = used ++ trailing ∧
      (∀ place, Prefix profile ready (specDispatch ready base) left place used reached place ∧
        Prefix profile ready (specDispatch ready (LiveDispatch.host bindings base)) right place used peer place) ∧
      VisitorWriterPath profile ready base bindings left right used used reached peer ∧
      Steps profile ready (specDispatch ready base) reached trailing finish ∧
      (trailing = [] ∨
        (∃ result, reached.ctl = check.control (checkedNext result) ∧
          peer.ctl = canon.control (canonicalNext result) ∧ PairedComponentSite older reached peer check canon) ∨
        ∃ beforeLeft beforeRight, Nonempty (SharedRecordPrepareMismatch beforeLeft beforeRight reached peer plan check canon)) := by
  classical
  let leftRead := { left with ctl := check.control (.op .hostGet
    (fun state => checkedNext (Record.prepare left.store state.writer plan))) }
  let rightRead := { right with ctl := canon.control (.op .hostGet
    (fun state => canonicalNext (Record.prepare right.store state.writer plan))) }
  have leftGet : Step profile ready (specDispatch ready base) left .tau leftRead := .get leftFocus
  have rightGet : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) right .tau rightRead := .get rightFocus
  have got (place : Location) : Prefix profile ready (specDispatch ready base) left place [.tau] leftRead place ∧
      Prefix profile ready (specDispatch ready (LiveDispatch.host bindings base)) right place [.tau] rightRead place :=
    ⟨.step leftGet (by rw [transitionEdit, leftFocus]; rfl) (.done _ _),
      .step rightGet (by rw [transitionEdit, rightFocus]; rfl) (.done _ _)⟩
  have readStore := VisitorWriterPath.framed (bindings := bindings)
    (WriterPaths.frameSingle (.cons leftGet (.refl _)) rfl) (WriterPaths.frameSingle (.cons rightGet (.refl _)) rfl)
  cases run with
  | refl => exact ⟨[], [], _, right, rfl, fun place => ⟨.done _ _, .done _ _⟩,
      WriterPaths.empty, .refl _, .inl rfl⟩
  | @cons _ _ _ _ tail first residual =>
    obtain ⟨rfl, rfl⟩ := silentStepUnique leftGet first
    let leftResult := Record.prepare left.store left.host.writer plan
    let rightResult := Record.prepare right.store right.host.writer plan
    let reached := { leftRead with ctl := check.control (checkedNext leftResult) }
    let peer := { rightRead with ctl := canon.control (canonicalNext rightResult) }
    have checkedRead : Step profile ready (specDispatch ready base) leftRead .tau reached :=
      .hostGet (th := check.thread) (segs := check.frames) (rest := check.rest)
        (k := fun state => checkedNext (Record.prepare left.store state.writer plan)) rfl
    have canonicalRead : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) rightRead .tau peer :=
      .hostGet (th := canon.thread) (segs := canon.frames) (rest := canon.rest)
        (k := fun state => canonicalNext (Record.prepare right.store state.writer plan)) rfl
    rcases splitSilent (count := 1) (.cons checkedRead (.refl _)) residual with ⟨suffix, divided, continuation⟩ | short
    · have used : .tau :: tail = [.tau, .tau] ++ suffix := congrArg (List.cons .tau) divided
      have paths (place : Location) :
          Prefix profile ready (specDispatch ready base) left place [.tau, .tau] reached place ∧
          Prefix profile ready (specDispatch ready (LiveDispatch.host bindings base)) right place [.tau, .tau] peer place :=
        ⟨(got place).1.append (.step checkedRead (by cases place <;> rfl) (.done _ _)),
          (got place).2.append (.step canonicalRead (by cases place <;> rfl) (.done _ _))⟩
      have lhs := WriterPaths.frameSingle (.cons checkedRead (.refl _)) rfl
      have rhs := WriterPaths.frameSingle (.cons canonicalRead (.refl _)) rfl
      by_cases same : leftResult = rightResult
      · have canonAt : peer.ctl = canon.control (canonicalNext leftResult) := by
          change canon.control (canonicalNext rightResult) = _
          rw [same]
        exact ⟨[.tau, .tau], suffix, reached, peer, used, paths, readStore.append (.framed lhs rhs),
          continuation, .inr (.inl ⟨leftResult, rfl, canonAt, site⟩)⟩
      · have mismatch : SharedRecordPrepareMismatch leftRead rightRead reached peer plan check canon :=
          ⟨checkedNext, canonicalNext, (HostFrame.Related.Paired.data site).1, rfl, rfl, rfl, rfl, same⟩
        exact ⟨[.tau, .tau], suffix, reached, peer, used, paths,
          readStore.append (.sharedRecordPrepare mismatch lhs rhs), continuation, .inr (.inr ⟨_, _, ⟨mismatch⟩⟩)⟩
    · have empty : tail = [] := List.length_eq_zero_iff.mp (by omega)
      exact ⟨[.tau], [], leftRead, rightRead, congrArg (List.cons .tau) empty, got, readStore, empty ▸ residual, .inl rfl⟩

open ReturnFrame.Occurrence Stored.OwnedMemory.Claims Stored.Endpoints in
private theorem crossSharedRecordPrepare {left right : Config (core3 grow) (HostState sig)}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)} {leading live trailing : Trace grow sig}
    (plan : List RecordLower.Object)
    (checkedNext canonicalNext : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow)))
    (onRead : SharedRecordAt profile ready base bindings older start incoming labels finish
      check canon checkedNext canonicalNext)
    (split : labels = leading ++ trailing) (paired : HostFrame.Related.Paired older start incoming)
    (observed : PayloadPrefix.visible live = PayloadPrefix.visible (.tau :: leading))
    (paths : OccurrenceTransport profile ready base bindings start incoming (.tau :: leading) live
      left right [some (.active 0 0)])
    (writers : VisitorWriterPath profile ready base bindings start incoming (.tau :: leading) live left right)
    (site : PairedComponentSite older left right check canon)
    (leftFocus : left.ctl = check.control
      (.op .get (fun store => .op .hostGet (fun state => checkedNext (Record.prepare store state.writer plan)))))
    (rightFocus : right.ctl = canon.control
      (.op .get (fun store => .op .hostGet (fun state => canonicalNext (Record.prepare store state.writer plan)))))
    (run : Steps profile ready (specDispatch ready base) left trailing finish) :
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  obtain ⟨used, suffix, reached, peer, divided, localPaths, localWriters, residual, ending⟩ :=
    cutSharedRecordPrepare (bindings := bindings) plan checkedNext canonicalNext site leftFocus rightFocus run
  have consumed : labels = (leading ++ used) ++ suffix := by rw [split, divided, List.append_assoc]
  have moved := retainComparedOccurrences paths localPaths
  have traced := writers.append localWriters
  rcases ending with empty | ⟨result, checked, canonical, frame⟩ | ⟨_, _, ⟨conflict⟩⟩
  · exact .inr (callbackTerminalSlice paired (by
      rw [consumed, ← List.cons_append]
      exact .coreAcceptTerminal moved traced residual (.inl empty)))
  · exact onRead result consumed (sharedRecordVisibleAppend used observed) (by simpa only [List.cons_append] using moved)
      (by simpa only [List.cons_append] using traced) frame checked canonical residual
  · exact .inr (callbackTerminalSlice paired (by
      rw [consumed, ← List.cons_append]
      exact .sharedRecordPrepareMismatch conflict moved traced residual))

private theorem sharedRecordRangeEffects (cx : LiftLowerContext (core3 grow)) (area : ABI.Layout) (count : Nat)
    (result : Ret (core3 grow)) : StoreEffects (sharedRecordRange cx area count result : Session grow sig Nat) := by
  cases result
  case nat ptr =>
    exact (storeEffectTrapIf (decide (ptr ≠ ABI.alignTo ptr area.alignment)) .unalignedPointer).bind fun _ =>
      (storeEffectBounds cx ptr (count * area.size)).bind fun _ => .pure ptr
  all_goals exact storeEffectTrap (.internal "late-bound call: expected Ret.nat")

open Stored.Endpoints in
private def sharedRecordCollectionResult (cx : LiftLowerContext (core3 grow)) (width : AddrType)
    (count index dest ptr : Nat) : Except RecordLower.Issue Unit → Session grow sig (Except RecordLower.Issue Unit)
  | .error issue => .pure (.error (.nested index issue))
  | .ok () => ListLower.publish cx width ptr count (.memory dest) >>= fun published => .pure (.ok published)

open Stored.Endpoints in
private theorem sharedRecordCollectionResultEffects (cx : LiftLowerContext (core3 grow)) (width : AddrType)
    (count index dest ptr : Nat) (result : Except RecordLower.Issue Unit) :
    StoreEffects (sharedRecordCollectionResult cx width count index dest ptr result : Session grow sig _) := by
  cases result with
  | error issue => exact .pure _
  | ok accepted =>
    cases accepted
    have widthRead : StoreEffects (ptrSize cx : Session grow sig Nat) := (storeEffectPtrType cx).bind fun _ => .pure _
    exact ((widthRead.bind fun size =>
      (storeEffectWrite cx dest _).bind fun _ => storeEffectWrite cx (dest + size) _).bind fun _ => .pure _)

open Stored.OwnedMemory.Claims Stored.Endpoints LinkedCallback.MemorySequence in
private theorem sharedRecordAfterPrepareVisit (cx : LiftLowerContext (core3 grow)) (width : AddrType)
    (element : Stored.TypeOf) (entries : List RecordLower.Field) (index dest ptr : Nat)
    (next : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow))) :
    (sharedRecordAfterAllocationPrepare cx width element entries index dest ptr (.ok ()) >>= next) =
      sharedRecordMemory (.elements (ABI.layout width element).size) cx width entries ptr 0
        (fun result => sharedRecordCollectionResult cx width entries.length index dest ptr result >>= next) := by
  let body : Session grow sig (Except RecordLower.Issue Unit) := RecordLower.Internal.runElements Limits.spec Quirks.none cx
    (Record.authority recordClaims Limits.spec cx) width entries (ABI.layout width element).size ptr 0
  let report := sharedRecordCollectionResult (sig := sig) cx width entries.length index dest ptr
  change (body.bind report).bind next = _
  exact Prog.bind_assoc body report next

open ReturnFrame.Occurrence in
private theorem advanceSharedRecordLocal {Result : Type} {left right : Config (core3 grow) (HostState sig)} {leading live trailing : Trace grow sig}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    (body : Session grow sig Result) (effects : StoreEffects body)
    (nextCheck nextCanon : Result → Session grow sig (Ret (core3 grow)))
    (resume : SharedRecordAt profile ready base bindings older start incoming labels finish
      check canon nextCheck nextCanon)
    (paired : HostFrame.Related.Paired older start incoming)
    (split : labels = leading ++ trailing)
    (observed : PayloadPrefix.visible live = PayloadPrefix.visible (.tau :: leading))
    (paths : OccurrenceTransport profile ready base bindings start incoming (.tau :: leading) live
      left right [some (.active 0 0)])
    (writers : VisitorWriterPath profile ready base bindings start incoming (.tau :: leading) live left right)
    (site : PairedComponentSite older left right check canon)
    (leftFocus : left.ctl = check.control (body >>= nextCheck))
    (rightFocus : right.ctl = canon.control (body >>= nextCanon))
    (run : Steps profile ready (specDispatch ready base) left trailing finish) :
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  obtain ⟨used, suffix, reached, peer, divided, localPaths, residual, frontier, _, _, leftWriter, rightWriter, stationary⟩ :=
    cutComponentStoreBodyFramed (bindings := bindings) (closed := True) body nextCheck nextCanon
      (fun _ => effects)
      (trivialPreserves _) trivial leftFocus rightFocus site run
  have consumed : labels = (leading ++ used) ++ suffix := by rw [split, divided, List.append_assoc]
  have traced : VisitorWriterPath profile ready base bindings start incoming (.tau :: (leading ++ used))
      (live ++ used) reached peer := by
    simpa only [List.cons_append] using writers.append (.framed leftWriter rightWriter)
  obtain ⟨_, through, _⟩ := CallbackPrefix.transportAppend paths localPaths
  have stop (terminal : suffix = [] ∨ (reached.ctl = [] ∧ peer.ctl = [])) :
      CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish :=
    .inr (callbackTerminalSlice paired (by
      rw [consumed, ← List.cons_append]
      exact .coreAcceptTerminal (by simpa only [List.cons_append] using through) traced residual
        (terminal.elim Or.inl (fun trapped => .inr (.inr (.inr trapped))))))
  cases frontier with
  | pending _ _ _ _ _ normal => exact stop (.inl (normal.resolve_right (fun unsupported => unsupported.1 trivial)))
  | trapped checked canonical _ => exact stop (.inr ⟨checked, canonical⟩)
  | returned result checked canonical frame =>
    have retained := retainComparedOccurrences paths (stationary (by rw [checked]; exact List.cons_ne_nil _ _)).2
    have allPaths : OccurrenceTransport profile ready base bindings start incoming
        (.tau :: (leading ++ used)) (live ++ used) reached peer [some (.active 0 0)] := by
      simpa only [List.cons_append] using retained
    exact resume result consumed (sharedRecordVisibleAppend used observed) allPaths traced frame checked canonical residual

open ReturnFrame.Occurrence Stored.Endpoints LinkedCallback.MemorySequence in
private theorem crossSharedRecordRange {caller : Seg (core3 grow) (HostState sig)}
    (paired : HostFrame.Related.Paired older start incoming)
    (cx : LiftLowerContext (core3 grow)) (width : AddrType) (element : Stored.TypeOf)
    (entries : List RecordLower.Field) (index dest : Nat)
    (checkNext canonNext : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow)))
    (onField : SharedRecordContinuation profile ready base bindings older start incoming labels finish caller
      checkNext canonNext)
    (onVisit : ∀ ptr, SharedRecordContinuation profile ready base bindings older start incoming labels finish caller
      (fun _ : Unit => sharedRecordMemory (.elements (ABI.layout width element).size) cx width entries ptr 0
        (fun result => sharedRecordCollectionResult cx width entries.length index dest ptr result >>= checkNext))
      (fun _ : Unit => sharedRecordMemory (.elements (ABI.layout width element).size) cx width entries ptr 0
        (fun result => sharedRecordCollectionResult cx width entries.length index dest ptr result >>= canonNext))) :
    SharedRecordContinuation profile ready base bindings older start incoming labels finish caller
      (sharedRecordAllocationResume cx width element entries index dest checkNext)
      (sharedRecordAllocationResume cx width element entries index dest canonNext) := by
  classical
  intro thread frames rest peerFrames peerRest left right leading live trailing value split observed paths writers site checked canonical run
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, caller :: frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, caller :: peerFrames, peerRest⟩
  let body := sharedRecordRange (sig := sig) cx (ABI.layout width element) entries.length value
  let checkedNext (ptr : Nat) := sharedRecordAllocated cx width element entries index dest ptr >>= checkNext
  let canonicalNext (ptr : Nat) := sharedRecordAllocated cx width element entries index dest ptr >>= canonNext
  refine advanceSharedRecordLocal body (sharedRecordRangeEffects cx _ _ value) checkedNext canonicalNext ?_
    paired split observed paths writers site checked canonical run
  intro beforeLeft beforeRight leading live trailing ptr split observed paths writers frame checked canonical residual
  let plan := RecordLower.Field.listObjects entries
  let nextCheck (result : Except RecordLower.Issue Unit) :=
    sharedRecordAfterAllocationPrepare cx width element entries index dest ptr result >>= checkNext
  let nextCanon (result : Except RecordLower.Issue Unit) :=
    sharedRecordAfterAllocationPrepare cx width element entries index dest ptr result >>= canonNext
  refine crossSharedRecordPrepare (check := check) (canon := canon) plan nextCheck nextCanon ?_
    split paired observed paths writers frame checked canonical residual
  intro reached peer leading live trailing result split observed paths writers frame checked canonical tail
  cases result with
  | error issue =>
    let body := sharedRecordAfterAllocationPrepare (sig := sig) cx width element entries index dest ptr (.error issue)
    have effects : StoreEffects body := by cases issue <;> exact .pure _
    exact advanceSharedRecordLocal body effects checkNext canonNext onField paired split observed paths writers
      frame checked canonical tail
  | ok result =>
    cases result
    change reached.ctl = check.control (sharedRecordAfterAllocationPrepare cx width element entries index dest ptr (.ok ()) >>= checkNext) at checked
    change peer.ctl = canon.control (sharedRecordAfterAllocationPrepare cx width element entries index dest ptr (.ok ()) >>= canonNext) at canonical
    rw [sharedRecordAfterPrepareVisit] at checked canonical
    exact onVisit ptr () split observed paths writers frame checked canonical tail

open ReturnFrame.Occurrence in
private theorem sharedRecordTrailEndpoint {dispatch : Call (core3 grow) → Session grow sig (Ret (core3 grow))}
    {left right peer : Config (core3 grow) (HostState sig)} {traversed : Trace grow sig} {mark reached canonical : Option Location}
    (lhs : Trail profile ready dispatch left mark traversed right reached)
    (rhs : Trail profile ready dispatch left mark traversed peer canonical) : reached = canonical := by
  induction lhs generalizing peer with
  | done => cases rhs; rfl
  | step first _ ih =>
    cases rhs with
    | step second tail =>
      cases labelledStepUnique first second
      exact ih tail

open ReturnFrame.Occurrence in
private theorem sharedRecordCallerFrames {state : Config (core3 grow) (HostState sig)}
    {cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    {body : Session grow sig (Ret (core3 grow))} {caller : Seg (core3 grow) (HostState sig)}
    (top : segmentAt (segmentStorage { state with ctl := cursor.control body }) (.active 0 0) = some caller) :
    ∃ remaining, cursor.frames = caller :: remaining := by
  cases frames : cursor.frames with
  | nil => simp [segmentStorage, segmentAt, PayloadPrefix.Cursor.control, frames] at top
  | cons frame remaining =>
    have equal : frame = caller := by
      simpa [segmentStorage, segmentAt, PayloadPrefix.Cursor.control, frames] using top
    exact ⟨remaining, by rw [equal]⟩

open ReturnFrame.Occurrence in
private theorem crossSharedReallocate {left right : Config (core3 grow) (HostState sig)}
    {thread frames rest peerFrames peerRest} {caller : Seg (core3 grow) (HostState sig)}
    {leading live trailing : Trace grow sig}
    (cx : LiftLowerContext (core3 grow)) (old oldLen alignment newLen : Nat)
    (first second : ReturnFrame.Continuation (core3 grow) (HostState sig))
    (resume : SharedRecordContinuation profile ready base bindings older start incoming labels finish caller first second)
    (split : labels = leading ++ trailing)
    (paired : HostFrame.Related.Paired older start incoming)
    (observed : PayloadPrefix.visible live = PayloadPrefix.visible (.tau :: leading))
    (paths : OccurrenceTransport profile ready base bindings start incoming (.tau :: leading) live
      left right [some (.active 0 0)])
    (writers : VisitorWriterPath profile ready base bindings start incoming (.tau :: leading) live left right)
    (site : PairedComponentSite older left right ⟨thread, caller :: frames, rest⟩ ⟨thread, caller :: peerFrames, peerRest⟩)
    (leftFocus : left.ctl = (PayloadPrefix.Cursor.mk thread (caller :: frames) rest).control
      (.op (.call (.reallocate cx old oldLen alignment newLen)) first))
    (rightFocus : right.ctl = (PayloadPrefix.Cursor.mk thread (caller :: peerFrames) peerRest).control
      (.op (.call (.reallocate cx old oldLen alignment newLen)) second))
    (run : Steps profile ready (specDispatch ready base) left trailing finish)
    (compare : ShorterCallbackSlices profile ready base bindings (.tau :: labels).length) :
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  classical
  let call : Call (core3 grow) := .reallocate cx old oldLen alignment newLen
  let program := specDispatch ready base call
  let leftEntered := { left with ctl := ⟨thread, .prog program, .prog first :: caller :: frames⟩ :: rest }
  let rightEntered := { right with ctl := ⟨thread, .prog program, .prog second :: caller :: peerFrames⟩ :: peerRest }
  have leftInstall : Step profile ready (specDispatch ready base) left .tau leftEntered := .call leftFocus
  have rightInstall : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) right .tau rightEntered :=
    .call rightFocus
  have noRun : trailing = [] →
      CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
    intro empty
    exact .inr (callbackTerminalSlice paired (by
      rw [split, ← List.cons_append]
      exact .coreAcceptTerminal paths writers run (.inl empty)))
  cases run with
  | refl => exact noRun rfl
  | @cons _ _ finish label tail firstStep residual =>
    obtain ⟨rfl, rfl⟩ := silentStepUnique leftInstall firstStep
    obtain ⟨otherFrames, otherRest, otherFocus, installed⟩ := ReturnFrame.Related.Paired.push site
      (thread := thread) (frames := caller :: frames) (rest := rest) rfl program first second
    have sameCursor : caller :: peerFrames = otherFrames ∧ peerRest = otherRest := by
      simpa [PayloadPrefix.Cursor.control] using otherFocus
    obtain ⟨rfl, rfl⟩ := sameCursor
    have checkEdit : transitionEdit left .tau = .push (.prog first) := by rw [transitionEdit, leftFocus]; rfl
    have canonEdit : transitionEdit right .tau = .push (.prog second) := by rw [transitionEdit, rightFocus]; rfl
    have shift (frame : Seg (core3 grow) (HostState sig)) (place : Option Location) :
        place.bind (Edit.push frame).follow = place.map Location.pushed := by
      cases place with
      | none => rfl
      | some place => cases place with
        | active activation _ => cases activation <;> rfl
        | saved => rfl
    have installedPaths : OccurrenceTransport profile ready base bindings left right [.tau] [.tau]
        leftEntered rightEntered [some (.active 0 0)] := by
      refine ⟨(·.map Location.pushed), fun place => ⟨.step leftInstall ?_, .step rightInstall ?_⟩, ?_⟩
      · rw [checkEdit, shift]; exact .done _ _
      · rw [canonEdit, shift]; exact .done _ _
      · intro previous marks outside
        rw [step_edit leftInstall, step_edit rightInstall, checkEdit, canonEdit]
        exact outside.push _ _
    have installedMark : Outside older (segmentStorage leftEntered) (segmentStorage rightEntered) (some (.active 0 0)) := by
      rw [step_edit leftInstall, step_edit rightInstall, checkEdit, canonEdit]
      apply outside_push
      simpa only [segmentStorage, HostFrame.replace, leftFocus, rightFocus, PayloadPrefix.Cursor.control, List.map_cons] using
        paired_outside (left := HostFrame.replace
          { left with ctl := (PayloadPrefix.Cursor.mk thread (caller :: frames) rest).control (.pure (.cancel .none)) } right.host) site
    have enteredWriters := VisitorWriterPath.framed (bindings := bindings)
      (WriterPaths.frameSingle (.cons leftInstall (.refl _)) rfl) (WriterPaths.frameSingle (.cons rightInstall (.refl _)) rfl)
    have shorter : tail.length < (.tau :: labels).length := by
      rw [split]
      simp only [List.length_cons, List.length_append]
      omega
    obtain ⟨checked, canonLabels, remaining, resumed, canonical, divided, segment, ending⟩ :=
      compare shorter residual (show HostFrame.Related.Paired (ReturnFrame.Extend older first second)
        leftEntered rightEntered from installed)
    obtain ⟨move, tracks, outside⟩ := segment.occurrences
    let top : Option Location := some (.active 0 0)
    have marked : AllocatorMark profile ready base bindings older leftEntered rightEntered checked canonLabels
        resumed canonical (move top) := by
      refine ⟨outsideMarks_singleton.mp (outside older [top] (outsideMarks_singleton.mpr installedMark)),
        (tracks top).1, (tracks top).2, fun place => ⟨_, tracks place⟩⟩
    have stop : CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
      apply Or.inr
      refine callbackTerminalSlice paired ?_
      rw [split, ← List.cons_append]
      apply CallbackSliceEnd.comparedPrefix paths writers
      rw [divided]
      simpa only [List.singleton_append, List.append_assoc, List.cons_append, List.nil_append] using
        (CallbackSliceEnd.sharedRecordAllocator installedPaths enteredWriters marked segment ending)
    by_cases returns : ∃ (cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)) (value : Ret (core3 grow)),
      resumed.ctl = { cursor with frames := .prog first :: cursor.frames }.control (.pure value)
    · obtain ⟨cursor, value, returning⟩ := returns
      have residual := returningCallbackEndSteps ending returning
      have installedPeer : segmentAt (segmentStorage rightEntered) (.active 0 0) = some (.prog second) := rfl
      by_cases active : move top = some (.active 0 0)
      · cases residual with
        | refl => exact stop
        | @cons _ _ _ label suffix actual tail =>
          obtain ⟨peerCursor, frame, leftPop, rightPop, _, _, _, rawAt⟩ :=
            CallbackPrefix.pop (active ▸ marked) segment.paired returning installedPeer
          obtain ⟨rfl, rfl⟩ := silentStepUnique leftPop actual
          have transported : OccurrenceTransport profile ready base bindings left right
              ([.tau] ++ checked) ([.tau] ++ canonLabels) resumed canonical [some (.active 0 0)] := by
            obtain ⟨enter, prior, keep⟩ := installedPaths
            refine ⟨move ∘ enter, fun place => ⟨(prior place).1.append (tracks (enter place)).1,
              (prior place).2.append (tracks (enter place)).2⟩, ?_⟩
            intro older marks before
            simpa only [List.map_append, List.map_cons, List.map_map, List.map_nil, List.nil_append, active, top] using
              outside older _ (keep older marks before)
          have popped := CallbackPrefix.transportAllocatorPop returning rawAt transported
          have traced := enteredWriters.append segment.writers
          have completed := traced.append (.framed (WriterPaths.frameSingle (.cons leftPop (.refl _)) rfl)
            (WriterPaths.frameSingle (.cons rightPop (.refl _)) rfl))
          have topTrail := (tracks top).1
          rw [active] at topTrail
          obtain ⟨place, equal, liveTrail⟩ := topTrail.survives
          change some (.active 0 0) = some place at equal
          obtain rfl := Option.some.inj equal
          have pops : (transitionEdit resumed .tau).pops (.active 0 0) := by
            rw [transitionEdit, returning]
            trivial
          -- The allocator mark has survived, so the enclosing slot moved with it.
          have retained := Prefix.under_call leftFocus leftInstall liveTrail leftPop pops 0
          obtain ⟨moved, whole, last⟩ := CallbackPrefix.transportAppend paths popped
          have atTop : moved top = top :=
            sharedRecordTrailEndpoint (last top).1 (by
              simpa only [top, List.singleton_append] using retained.toTrail)
          have kept : OccurrenceTransport profile ready base bindings start incoming
              ((.tau :: leading) ++ (([.tau] ++ checked) ++ [.tau]))
              (live ++ (([.tau] ++ canonLabels) ++ [.tau]))
              { resumed with ctl := cursor.control (first value) }
              { canonical with ctl := peerCursor.control (second value) } [top] := by
            simpa only [List.map_cons, List.map_nil, List.nil_append, atTop, top] using whole
          have leftFrame : segmentAt (segmentStorage { resumed with ctl := cursor.control (first value) })
              (.active 0 0) = some caller := by
            rw [(prefix_survives retained).2]
            simp [segmentStorage, leftFocus, PayloadPrefix.Cursor.control, segmentAt]
          have rightFrame : segmentAt (segmentStorage { canonical with ctl := peerCursor.control (second value) })
              (.active 0 0) = some caller := by
            have same := (last top).2
            rw [atTop] at same
            obtain ⟨place, samePlace, peerTrail⟩ := same.survives
            change some (.active 0 0) = some place at samePlace
            obtain rfl := Option.some.inj samePlace
            rw [(prefix_survives peerTrail).2]
            simp [segmentStorage, rightFocus, PayloadPrefix.Cursor.control, segmentAt]
          obtain ⟨leftFrames, leftTails⟩ := sharedRecordCallerFrames leftFrame
          obtain ⟨rightFrames, rightTails⟩ := sharedRecordCallerFrames rightFrame
          have checkCursor : PayloadPrefix.Cursor.mk cursor.thread (caller :: leftFrames) cursor.rest = cursor := by
            rw [← leftTails]
          have rawCursor : PayloadPrefix.Cursor.mk cursor.thread (caller :: rightFrames) peerCursor.rest = peerCursor := by
            rw [← rightTails, frame.thread]
          have frameSite : PairedComponentSite older { resumed with ctl := cursor.control (first value) }
              { canonical with ctl := peerCursor.control (second value) } cursor peerCursor :=
            pairAfterComponentPop (left := resumed) (right := canonical) (program := .pure (.cancel .none)) frame
          have seen : PayloadPrefix.visible (live ++ (([.tau] ++ canonLabels) ++ [.tau])) =
              PayloadPrefix.visible (.tau :: (leading ++ (([.tau] ++ checked) ++ [.tau]))) := by
            rw [← List.cons_append, visibleAppend, visibleAppend, observed]
            simp only [List.singleton_append, visibleAppend, visibleTauCons, segment.observed]
          have finalSplit : labels = (leading ++ (([.tau] ++ checked) ++ [.tau])) ++ suffix := by
            simp only [split, divided, List.append_assoc, List.cons_append, List.nil_append]
          exact resume (thread := cursor.thread) (frames := leftFrames) (rest := cursor.rest)
            (peerFrames := rightFrames) (peerRest := peerCursor.rest) value finalSplit seen
            (by simpa only [List.cons_append] using kept)
            (by simpa only [List.cons_append] using writers.append completed)
            (by rw [checkCursor, rawCursor]; exact frameSite)
            (by rw [checkCursor]) (by rw [rawCursor]) tail
      · exact stop
    · exact stop

open ReturnFrame.Occurrence Stored.Endpoints LinkedCallback.MemorySequence in
private theorem crossSharedRecordAllocator {left right : Config (core3 grow) (HostState sig)}
    {thread frames rest peerFrames peerRest} {caller : Seg (core3 grow) (HostState sig)}
    {leading live trailing : Trace grow sig}
    (cx : LiftLowerContext (core3 grow)) (width : AddrType)
    (element : Stored.TypeOf) (entries : List RecordLower.Field) (index dest : Nat)
    (checkNext canonNext : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow)))
    (onField : SharedRecordContinuation profile ready base bindings older start incoming labels finish caller checkNext canonNext)
    (onVisit : ∀ ptr, SharedRecordContinuation profile ready base bindings older start incoming labels finish caller
      (fun _ : Unit => sharedRecordMemory (.elements (ABI.layout width element).size) cx width entries ptr 0
        (fun result => sharedRecordCollectionResult cx width entries.length index dest ptr result >>= checkNext))
      (fun _ : Unit => sharedRecordMemory (.elements (ABI.layout width element).size) cx width entries ptr 0
        (fun result => sharedRecordCollectionResult cx width entries.length index dest ptr result >>= canonNext)))
    (split : labels = leading ++ trailing) (paired : HostFrame.Related.Paired older start incoming)
    (observed : PayloadPrefix.visible live = PayloadPrefix.visible (.tau :: leading))
    (paths : OccurrenceTransport profile ready base bindings start incoming (.tau :: leading) live
      left right [some (.active 0 0)])
    (writers : VisitorWriterPath profile ready base bindings start incoming (.tau :: leading) live left right)
    (site : PairedComponentSite older left right ⟨thread, caller :: frames, rest⟩ ⟨thread, caller :: peerFrames, peerRest⟩)
    (leftFocus : left.ctl = (PayloadPrefix.Cursor.mk thread (caller :: frames) rest).control
      (sharedRecordAllocate cx width element entries index dest >>= checkNext))
    (rightFocus : right.ctl = (PayloadPrefix.Cursor.mk thread (caller :: peerFrames) peerRest).control
      (sharedRecordAllocate cx width element entries index dest >>= canonNext))
    (run : Steps profile ready (specDispatch ready base) left trailing finish)
    (compare : ShorterCallbackSlices profile ready base bindings (.tau :: labels).length) :
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  rw [sharedRecordAllocatorCode] at leftFocus rightFocus
  let area := ABI.layout width element
  exact crossSharedReallocate cx 0 0 area.alignment.bytes (entries.length * area.size) _ _
    (crossSharedRecordRange paired cx width element entries index dest checkNext canonNext onField onVisit)
    split paired observed paths writers site leftFocus rightFocus run compare

private def sharedStringLocalStep : ABI.StoreStep → Bool
  | .allocate .. | .reallocate .. => false
  | _ => true

private theorem sharedStringStepEffects (cx : LiftLowerContext (core3 grow)) (ptr : Nat)
    (step : ABI.StoreStep) (localStep : sharedStringLocalStep step = true) :
    StoreEffects (runStoreStep cx ptr step : Session grow sig Nat) := by
  have readEffects (len : Nat) : StoreEffects (readMem cx ptr len : Session grow sig ByteArray) := by
    unfold readMem memAddr
    exact (storeEffectOrTrap _ _).bind fun _ => storeEffectGet.bind fun _ => storeEffectOrTrap _ _
  cases step with
  | allocate | reallocate => contradiction
  | trapIfMisaligned => exact (storeEffectTrapIf _ _).bind fun _ => .pure _
  | trapIfOutOfBounds => exact (storeEffectBounds cx ptr _).bind fun _ => .pure _
  | write => exact (storeEffectWrite cx _ _).bind fun _ => .pure _
  | inflateLatin1 | deflateUtf16 =>
    exact (readEffects _).bind fun _ => (storeEffectWrite cx ptr _).bind fun _ => .pure _

private theorem sharedStringDescriptorEffects (cx : LiftLowerContext (core3 grow)) (tagged dest pointer : Nat) :
    StoreEffects (sharedRecordStringDescriptor cx tagged dest pointer : Session grow sig Unit) := by
  have size : StoreEffects (ptrSize cx : Session grow sig Nat) := (storeEffectPtrType cx).bind fun _ => .pure _
  exact size.bind fun n => (storeEffectWrite cx dest _).bind fun _ => storeEffectWrite cx (dest + n) _

open Stored.Endpoints in
private theorem sharedRecordStringRemainingCons (cx : LiftLowerContext (core3 grow))
    (step : ABI.StoreStep) (steps : List ABI.StoreStep) (tagged dest pointer : Nat)
    (next : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow))) :
    sharedRecordStringRemaining cx (step :: steps) tagged dest pointer next =
      (runStoreStep cx pointer step >>= fun ptr => sharedRecordStringRemaining cx steps tagged dest ptr next) := by
  unfold sharedRecordStringRemaining runStoreSteps
  simp only [Prog.foldlM, Prog.bind_eq, Prog.bind_assoc]

open ReturnFrame.Occurrence Stored.Endpoints in
private theorem crossSharedStringResume {caller : Seg (core3 grow) (HostState sig)}
    (paired : HostFrame.Related.Paired older start incoming)
    (cx : LiftLowerContext (core3 grow)) (steps : List ABI.StoreStep) (tagged dest : Nat)
    (checkNext canonNext : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow)))
    (resumeNat : ∀ ptr, SharedRecordContinuation profile ready base bindings older start incoming labels finish caller
      (fun _ : Unit => sharedRecordStringRemaining cx steps tagged dest ptr checkNext)
      (fun _ : Unit => sharedRecordStringRemaining cx steps tagged dest ptr canonNext)) :
    SharedRecordContinuation profile ready base bindings older start incoming labels finish caller
      (sharedRecordStringResume cx steps tagged dest checkNext)
      (sharedRecordStringResume cx steps tagged dest canonNext) := by
  intro thread frames rest peerFrames peerRest left right leading live trailing value split observed paths writers site checked canonical run
  cases value
  case nat ptr => exact resumeNat ptr () split observed paths writers site checked canonical run
  all_goals
    let msg := "late-bound call: expected Ret.nat"
    let body : Session grow sig Empty := internal msg
    let impossible (value : Empty) : Session grow sig (Ret (core3 grow)) := nomatch value
    have stuck : body >>= impossible = internal msg := internalBind msg impossible
    exact advanceSharedRecordLocal body (storeEffectTrap (.internal msg)) impossible impossible
      (fun value => nomatch value) paired split observed paths writers site
      (by rw [stuck]; exact checked) (by rw [stuck]; exact canonical) run

open ReturnFrame.Occurrence Stored.Endpoints in
private theorem crossSharedStringSteps {caller : Seg (core3 grow) (HostState sig)}
    (paired : HostFrame.Related.Paired older start incoming)
    (cx : LiftLowerContext (core3 grow)) (steps : List ABI.StoreStep) (tagged dest : Nat)
    (checkNext canonNext : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow)))
    (onField : SharedRecordContinuation profile ready base bindings older start incoming labels finish caller
      checkNext canonNext)
    (compare : ShorterCallbackSlices profile ready base bindings (.tau :: labels).length) (pointer : Nat) :
    SharedRecordContinuation profile ready base bindings older start incoming labels finish caller
      (fun _ : Unit => sharedRecordStringRemaining cx steps tagged dest pointer checkNext)
      (fun _ : Unit => sharedRecordStringRemaining cx steps tagged dest pointer canonNext) := by
  induction steps generalizing pointer with
  | nil =>
    intro thread frames rest peerFrames peerRest left right leading live trailing result split observed paths writers site checked canonical run
    exact advanceSharedRecordLocal (sharedRecordStringDescriptor cx tagged dest pointer)
      (sharedStringDescriptorEffects cx tagged dest pointer)
      (fun _ => checkNext (.ok ())) (fun _ => canonNext (.ok ()))
      (fun _ => onField (.ok ())) paired split observed paths writers site checked canonical run
  | cons step remaining ih =>
    intro thread frames rest peerFrames peerRest left right leading live trailing result split observed paths writers site checked canonical run
    change left.ctl = (PayloadPrefix.Cursor.mk thread (caller :: frames) rest).control
      (sharedRecordStringRemaining cx (step :: remaining) tagged dest pointer checkNext) at checked
    change right.ctl = (PayloadPrefix.Cursor.mk thread (caller :: peerFrames) peerRest).control
      (sharedRecordStringRemaining cx (step :: remaining) tagged dest pointer canonNext) at canonical
    rw [sharedRecordStringRemainingCons] at checked canonical
    by_cases noAllocation : sharedStringLocalStep step = true
    · exact advanceSharedRecordLocal (runStoreStep cx pointer step) (sharedStringStepEffects cx pointer step noAllocation)
        (fun ptr => sharedRecordStringRemaining cx remaining tagged dest ptr checkNext)
        (fun ptr => sharedRecordStringRemaining cx remaining tagged dest ptr canonNext)
        (fun ptr => ih ptr ()) paired split observed paths writers site checked canonical run
    · let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, caller :: frames, rest⟩
      let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, caller :: peerFrames, peerRest⟩
      have cross (old oldLen alignment size : Nat)
          (callChecked : left.ctl = check.control (.op (.call (.reallocate cx old oldLen alignment size))
            (sharedRecordStringResume cx remaining tagged dest checkNext)))
          (callCanonical : right.ctl = canon.control (.op (.call (.reallocate cx old oldLen alignment size))
            (sharedRecordStringResume cx remaining tagged dest canonNext))) :
          CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish :=
        crossSharedReallocate cx old oldLen alignment size _ _
          (crossSharedStringResume paired cx remaining tagged dest checkNext canonNext ih)
          split paired observed paths writers site callChecked callCanonical run compare
      cases step
      case allocate alignment size =>
        exact cross 0 0 alignment.bytes size
          (checked.trans (congrArg check.control (sharedRecordStringRequestCode cx dest tagged 0 0 checkNext alignment.bytes size remaining)))
          (canonical.trans (congrArg canon.control (sharedRecordStringRequestCode cx dest tagged 0 0 canonNext alignment.bytes size remaining)))
      case reallocate oldLen alignment size =>
        exact cross pointer oldLen alignment.bytes size
          (checked.trans (congrArg check.control (sharedRecordStringRequestCode cx dest tagged pointer oldLen checkNext alignment.bytes size remaining)))
          (canonical.trans (congrArg canon.control (sharedRecordStringRequestCode cx dest tagged pointer oldLen canonNext alignment.bytes size remaining)))
      all_goals exact False.elim (noAllocation rfl)

open ReturnFrame.Occurrence Stored.OwnedMemory.Claims Stored.Endpoints LinkedCallback.MemorySequence in
private theorem crossSharedRecordMemory {left right : Config (core3 grow) (HostState sig)}
    {thread frames rest peerFrames peerRest} {callerFrame : Seg (core3 grow) (HostState sig)}
    {leading live trailing : Trace grow sig}
    (mode : Track) (cx : LiftLowerContext (core3 grow)) (width : AddrType) (fields : List RecordLower.Field) (cursor index : Nat)
    (emitted : ∀ field ∈ fields, RecordLower.Field.Emitted field)
    (checkDone canonDone : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow)))
    (onDone : SharedRecordContinuation profile ready base bindings older start incoming labels finish
      callerFrame checkDone canonDone)
    (split : labels = leading ++ trailing)
    (paired : HostFrame.Related.Paired older start incoming)
    (observed : PayloadPrefix.visible live = PayloadPrefix.visible (.tau :: leading))
    (paths : OccurrenceTransport profile ready base bindings start incoming (.tau :: leading) live
      left right [some (.active 0 0)])
    (writers : VisitorWriterPath profile ready base bindings start incoming (.tau :: leading) live left right)
    (site : PairedComponentSite older left right ⟨thread, callerFrame :: frames, rest⟩ ⟨thread, callerFrame :: peerFrames, peerRest⟩)
    (leftFocus : left.ctl = (PayloadPrefix.Cursor.mk thread (callerFrame :: frames) rest).control
      (sharedRecordMemory mode cx width fields cursor index checkDone))
    (rightFocus : right.ctl = (PayloadPrefix.Cursor.mk thread (callerFrame :: peerFrames) peerRest).control
      (sharedRecordMemory mode cx width fields cursor index canonDone))
    (run : Steps profile ready (specDispatch ready base) left trailing finish)
    (compare : ShorterCallbackSlices profile ready base bindings (.tau :: labels).length) :
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  classical
  induction fieldSize : sizeOf fields using Nat.strong_induction_on
    generalizing thread frames rest peerFrames peerRest mode fields cursor index left right leading live trailing checkDone canonDone
  rename_i size ih
  cases fields with
  | nil =>
    cases mode <;> exact onDone (.ok ()) split observed paths writers site leftFocus rightFocus run
  | cons field fields =>
    have fieldEmitted := emitted field (List.mem_cons_self ..)
    have tailEmitted : ∀ item ∈ fields, RecordLower.Field.Emitted item := fun item atTail =>
      emitted item (List.mem_cons_of_mem field atTail)
    let slot := mode.slot width field cursor
    let ptr := slot.1
    let check := (PayloadPrefix.Cursor.mk thread (callerFrame :: frames) rest : PayloadPrefix.Cursor (E := core3 grow) (HostState sig))
    let canon := (PayloadPrefix.Cursor.mk thread (callerFrame :: peerFrames) peerRest : PayloadPrefix.Cursor (E := core3 grow) (HostState sig))
    let checkNext := sharedRecordAfterField (sig := sig) mode cx width fields slot.2 (index + 1) checkDone
    let canonNext := sharedRecordAfterField (sig := sig) mode cx width fields slot.2 (index + 1) canonDone
    have finishField : SharedRecordContinuation profile ready base bindings older start incoming labels finish
        callerFrame checkNext canonNext := by
      intro thread frames rest peerFrames peerRest left right leading live trailing result split observed paths writers site leftFocus rightFocus run
      cases result with
      | error issue => exact onDone (.error issue) split observed paths writers site leftFocus rightFocus run
      | ok unitResult =>
        cases unitResult
        have smaller : sizeOf fields < size := by
          rw [← fieldSize]
          simp
        exact ih (sizeOf fields) smaller mode fields slot.2 (index + 1) tailEmitted checkDone canonDone
          onDone split observed paths writers site leftFocus rightFocus run rfl
    by_cases localField : SharedRecordLocalField field
    · have checked := leftFocus
      have raw := rightFocus
      rw [sharedRecordMemoryCons] at checked raw
      exact advanceSharedRecordLocal _ (sharedRecordLocalFieldEffects cx width localField index ptr) checkNext canonNext finishField
        paired split observed paths writers site checked raw run
    by_cases aggregateField : ∃ type children, field = .aggregate type children
    · obtain ⟨type, children, rfl⟩ := aggregateField
      have childrenEmitted : ∀ item ∈ children, RecordLower.Field.Emitted item := by
        cases fieldEmitted with
        | aggregate emitted => exact emitted
      let body : Session grow sig Unit := checkInBounds cx ptr (ABI.layout width type).size
      let checkChildDone (result : Except RecordLower.Issue Unit) := checkNext (result.mapError (.nested index))
      let canonChildDone (result : Except RecordLower.Issue Unit) := canonNext (result.mapError (.nested index))
      let checkChild (_ : Unit) := sharedRecordMemory .fields cx width children ptr 0 checkChildDone
      let canonChild (_ : Unit) := sharedRecordMemory .fields cx width children ptr 0 canonChildDone
      have checked := leftFocus
      have raw := rightFocus
      rw [sharedRecordMemoryCons, sharedRecordAggregateCode] at checked raw
      have smaller : sizeOf children < size := by
        rw [← fieldSize]
        simp
        omega
      have onChild : SharedRecordContinuation profile ready base bindings older start incoming labels finish
          callerFrame checkChildDone canonChildDone := by
        intro thread frames rest peerFrames peerRest left right leading live trailing result split observed paths writers frame checked canonical residual
        exact finishField (result.mapError (.nested index)) split observed paths writers frame checked canonical residual
      have resume : SharedRecordAt profile ready base bindings older start incoming labels finish
          check canon checkChild canonChild := by
        intro left right leading live trailing result split observed paths writers frame checked canonical residual
        cases result
        exact ih (sizeOf children) smaller .fields children ptr 0 childrenEmitted checkChildDone canonChildDone
          onChild split observed paths writers frame checked canonical residual rfl
      exact advanceSharedRecordLocal body (storeEffectBounds cx ptr (ABI.layout width type).size) checkChild canonChild resume
        paired split observed paths writers site checked raw run
    by_cases fixedField : ∃ element length entries, field = .fixed element length entries
    · obtain ⟨element, length, entries, rfl⟩ := fixedField
      have entriesEmitted : ∀ item ∈ entries, RecordLower.Field.Emitted item := by
        cases fieldEmitted with
        | fixed emitted => exact emitted
      let childMode := Track.elements (ABI.layout width element).size
      let checkChildDone (result : Except RecordLower.Issue Unit) := checkNext (result.mapError (.nested index))
      let canonChildDone (result : Except RecordLower.Issue Unit) := canonNext (result.mapError (.nested index))
      have checked := leftFocus
      have raw := rightFocus
      rw [sharedRecordMemoryCons, sharedRecordFixedCode] at checked raw
      have smaller : sizeOf entries < size := by
        rw [← fieldSize]
        simp
        omega
