                    ⟨check, leftCaptured, leftPrepared, leftWrite, leftSpent, lhs, leftAdmitted, rfl, rfl, spendRead, commit⟩
                  have rawCertified :
                      ExecutedSharedRecordEndpointSpend profile ready (specDispatch ready (LiveDispatch.host bindings base))
                        endpoint cx index ptr canonNext right rightDone :=
                    ⟨canon, rightCaptured, rightPrepared, rightWrite, rightSpent, rhs, rightAdmitted, rfl, rfl, peerSpendRead, peerCommit⟩
                  have usedAll : labels = (leading ++ [.tau, .tau, .tau, .tau]) ++ tail := by
                    rw [consumed, staged, assigned]
                    simp only [List.replicate_succ, List.replicate_zero, List.nil_append, List.append_assoc, List.cons_append]
                  have allPaths := retainComparedOccurrences beforeCommit (fun place =>
                    ⟨Prefix.step commit (by cases place <;> rfl) (.done _ _),
                     Prefix.step peerCommit (by cases place <;> rfl) (.done _ _)⟩)
                  have allWriters := writers.append (.recordEndpointCommit certified rawCertified)
                  have effects : StoreEffects body :=
                    (sharedEndpointTransferEffects endpoint).bind fun _ => (storeEffectWrite _ _ _).bind fun _ => .pure _
                  have pairedAfter : PairedComponentSite older leftDone rightDone check canon := by
                    unfold PairedComponentSite HostFrame.Related.Paired HostFrame.replace at site ⊢
                    exact pairQuietHost site _
                  exact advanceSharedRecordLocal body effects checkNext canonNext finishField paired usedAll (sharedRecordVisibleAppend [.tau, .tau, .tau, .tau] observed)
                    (by simpa only [List.cons_append, List.append_assoc, List.nil_append] using allPaths)
                    (by simpa only [List.cons_append] using allWriters) pairedAfter rfl rfl nextRun
                · have empty : remaining = [] := List.length_eq_zero_iff.mp (by omega)
                  have stopped : finish = leftWrite := stepsAtEmpty (empty ▸ atWrite)
                  have framed := traced.append (.framed (.same spendRead rfl (.done _)) (.same peerSpendRead rfl (.done _)))
                  exact .inr (callbackTerminalSlice paired (by
                    rw [consumed, staged, empty, stopped]
                    simpa only [List.cons_append, List.append_assoc, List.nil_append, List.append_nil,
                      List.replicate_succ, List.replicate_zero] using
                      (CallbackSliceEnd.coreAcceptTerminal (changes := older) beforeCommit framed (.refl _) (.inl rfl))))
              · have empty : suffix = [] := List.length_eq_zero_iff.mp (by omega)
                exact .inr (callbackTerminalSlice paired (by
                  rw [consumed, ← List.cons_append]
                  exact .coreAcceptTerminal moved traced residual (.inl empty)))
          · have mismatch : SharedRecordEndpointMismatch profile ready base bindings endpoint left right leftPrepared rightPrepared :=
              ⟨cx, index, ptr, check, canon, checkNext, canonNext, leftCaptured, rightCaptured, lhs, rhs, (HostFrame.Related.Paired.data site).1, agrees⟩
            have traced : VisitorWriterPath profile ready base bindings start incoming
                (.tau :: (leading ++ [.tau, .tau])) (live ++ [.tau, .tau])
                leftPrepared rightPrepared := by
              simpa only [List.cons_append] using writers.append (.recordEndpointMismatch mismatch)
            exact .inr (callbackTerminalSlice paired (by
              rw [consumed, ← List.cons_append]
              exact .sharedRecordEndpointMismatch mismatch moved traced residual))
        · have empty : remaining = [] := List.length_eq_zero_iff.mp (by omega)
          have stopped : finish = leftCaptured := stepsAtEmpty (empty ▸ afterCapture)
          have traced := writers.append (.framed (.same capture rfl (.done _)) (.same peerCapture rfl (.done _)))
          exact .inr (callbackTerminalSlice paired (by
            rw [split, used, empty, stopped]
            simpa only [List.replicate_succ, List.replicate_zero, List.cons_append, List.nil_append, List.append_nil] using
              (CallbackSliceEnd.coreAcceptTerminal (changes := older) captured traced (.refl _) (.inl rfl))))
      · have empty : trailing = [] := List.length_eq_zero_iff.mp (by omega)
        exact .inr (callbackTerminalSlice paired (by
          rw [split, ← List.cons_append]
          exact .coreAcceptTerminal paths writers run (.inl empty)))
    · have stringField : ∃ text : Stored.Payload (.prim .string), field = .data (.prim .string) text := by
        cases fieldEmitted with
        | @primitive primitive payload =>
          by_cases string : primitive = .string
          · subst primitive
            exact ⟨payload, rfl⟩
          · exact (localField (.data (.primitive string))).elim
        | enum payload schema => exact (localField (.data (.enum schema))).elim
        | flags payload schema => exact (localField (.data (.flags schema))).elim
        | endpoint => exact (endpointField ⟨_, _, _, rfl⟩).elim
        | context => exact (contextField ⟨_, rfl⟩).elim
        | owner => exact (ownerField ⟨_, rfl⟩).elim
        | aggregate => exact (aggregateField ⟨_, _, rfl⟩).elim
        | fixed => exact (fixedField ⟨_, _, _, rfl⟩).elim
        | list => exact (dynamicField ⟨_, _, _, rfl⟩).elim
        | map => exact (dynamicField ⟨_, _, _, rfl⟩).elim
        | @sum type arms tag selected _ =>
          cases selected with
          | none => exact (localField .sumNone).elim
          | some child => exact (sumField ⟨_, _, _, child, rfl⟩).elim
      obtain ⟨text, rfl⟩ := stringField
      rw [sharedRecordMemoryCons, sharedRecordStringCode] at leftFocus rightFocus
      let nextCheck := sharedRecordStringEmit cx text ptr checkNext
      let nextCanon := sharedRecordStringEmit cx text ptr canonNext
      have finishPlacement : SharedRecordAt profile ready base bindings older start incoming labels finish
          check canon nextCheck nextCanon := by
        intro left right leading live trailing result split observed paths writers frame checked canonical residual
        cases result with
        | error issue => exact finishField (.error issue) split observed paths writers frame checked canonical residual
        | ok placed =>
          cases placed
          obtain ⟨value, typed⟩ := text
          cases typed with
          | int kind _ => cases kind
          | @string value valid =>
            have checkAt : left.ctl = check.control
                (Canon.store Limits.spec Quirks.none cx (.string value) (.prim .string) ptr >>= fun _ => checkNext (.ok ())) := checked
            have canonAt : right.ctl = canon.control
                (Canon.store Limits.spec Quirks.none cx (.string value) (.prim .string) ptr >>= fun _ => canonNext (.ok ())) := canonical
            rw [sharedRecordStringPlanCode] at checkAt canonAt
            let planCheck := sharedRecordStringPlan cx value ptr checkNext
            let planCanon := sharedRecordStringPlan cx value ptr canonNext
            have finishWidth : SharedRecordAt profile ready base bindings older start incoming labels finish
                check canon planCheck planCanon := by
              intro left right leading live trailing width split observed paths writers frame checked canonical residual
              obtain ⟨alignment, size, remaining, steps⟩ := stringPlanInitialAllocation cx.opts.encoding width
                (storeSource Quirks.none width value)
              let tagged := (storePlanFor Quirks.none cx.opts.encoding width value).taggedCodeUnits
              have checkedAt : left.ctl = check.control (.op (.call (.reallocate cx 0 0 alignment.bytes size))
                  (sharedRecordStringResume cx remaining tagged ptr checkNext)) :=
                checked.trans (congrArg check.control (sharedRecordStringAllocationCode cx width value ptr checkNext
                  alignment size remaining steps))
              have canonicalAt : right.ctl = canon.control (.op (.call (.reallocate cx 0 0 alignment.bytes size))
                  (sharedRecordStringResume cx remaining tagged ptr canonNext)) :=
                canonical.trans (congrArg canon.control (sharedRecordStringAllocationCode cx width value ptr canonNext
                  alignment size remaining steps))
              exact crossSharedReallocate cx 0 0 alignment.bytes size _ _
                (crossSharedStringResume paired cx remaining tagged ptr checkNext canonNext
                  (crossSharedStringSteps paired cx remaining tagged ptr checkNext canonNext finishField compare))
                split paired observed paths writers frame checkedAt canonicalAt residual compare
            exact advanceSharedRecordLocal (ptrType cx) (storeEffectPtrType cx) planCheck planCanon finishWidth
              paired split observed paths writers frame checkAt canonAt residual
      exact advanceSharedRecordLocal _ (sharedRecordStringPlacementEffects cx text index ptr) nextCheck nextCanon finishPlacement
        paired split observed paths writers site leftFocus rightFocus run

open ReturnFrame.Occurrence Stored.Endpoints in
private theorem crossSharedRecordEmit {left right : Config (core3 grow) (HostState sig)}
    {thread frames rest peerFrames peerRest} {callerFrame : Seg (core3 grow) (HostState sig)}
    {leftTicket rightTicket ptr} {leading live trailing : Trace grow sig}
    (cx : LiftLowerContext (core3 grow)) (type : Stored.TypeOf) (value : Value.Val) (fields : List RecordLower.Field)
    (emitted : ∀ field ∈ fields, RecordLower.Field.Emitted field)
    (split : labels = leading ++ trailing)
    (paired : HostFrame.Related.Paired older start incoming)
    (observed : PayloadPrefix.visible live = PayloadPrefix.visible (.tau :: leading))
    (paths : OccurrenceTransport profile ready base bindings start incoming (.tau :: leading) live
      left right [some (.active 0 0)])
    (writers : VisitorWriterPath profile ready base bindings start incoming (.tau :: leading) live left right)
    (site : PairedComponentSite older left right ⟨thread, callerFrame :: frames, rest⟩ ⟨thread, callerFrame :: peerFrames, peerRest⟩)
    (leftFocus : left.ctl = (PayloadPrefix.Cursor.mk thread (callerFrame :: frames) rest).control
      (sharedRecordEmit cx type value fields ptr leftTicket))
    (rightFocus : right.ctl = (PayloadPrefix.Cursor.mk thread (callerFrame :: peerFrames) peerRest).control
      (sharedRecordEmit cx type value fields ptr rightTicket))
    (run : Steps profile ready (specDispatch ready base) left trailing finish)
    (compare : ShorterCallbackSlices profile ready base bindings (.tau :: labels).length) :
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  rw [sharedRecordPlacementCode] at leftFocus rightFocus
  obtain ⟨used, suffix, reached, peer, divided, localPaths, residual, boundary, _, _, checkedPath, rawPath, stationary⟩ :=
    cutComponentStoreBodyFramed (bindings := bindings) (closed := True) (sharedRecordPlace cx type value ptr)
      (sharedRecordVisit cx fields ptr leftTicket) (sharedRecordVisit cx fields ptr rightTicket)
      (fun _ => sharedRecordPlaceEffects cx type value ptr) (trivialPreserves _) trivial leftFocus rightFocus site run
  have usedAll : labels = (leading ++ used) ++ suffix := by rw [split, divided, List.append_assoc]
  have traced : VisitorWriterPath profile ready base bindings start incoming (.tau :: (leading ++ used))
      (live ++ used) reached peer := by
    simpa only [List.cons_append] using writers.append (.framed checkedPath rawPath)
  obtain ⟨_, through, _⟩ := CallbackPrefix.transportAppend paths localPaths
  have stop (terminal : suffix = [] ∨ (reached.ctl = [] ∧ peer.ctl = [])) :
      CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
    exact .inr (callbackTerminalSlice paired (by
      rw [usedAll, ← List.cons_append]
      exact .coreAcceptTerminal (by simpa only [List.cons_append] using through) traced residual
        (terminal.elim Or.inl (fun trapped => .inr (.inr (.inr trapped))))))
  cases boundary with
  | pending _ _ _ _ _ normal => exact stop (.inl (normal.resolve_right (fun unsupported => unsupported.1 trivial)))
  | trapped checked canonical _ => exact stop (.inr ⟨checked, canonical⟩)
  | returned width checked canonical frame =>
    have retained := retainComparedOccurrences paths (stationary (by rw [checked]; exact List.cons_ne_nil _ _)).2
    have allPaths : OccurrenceTransport profile ready base bindings start incoming
        (.tau :: (leading ++ used)) (live ++ used) reached peer [some (.active 0 0)] := by
      simpa only [List.cons_append] using retained
    have seen : PayloadPrefix.visible (live ++ used) = PayloadPrefix.visible (.tau :: (leading ++ used)) := by
      rw [← List.cons_append, visibleAppend, visibleAppend, observed]
    cases width with
    | none =>
      exact finishSharedResultCompared (leftTicket := leftTicket) (rightTicket := rightTicket)
        (.error (.lowerRecord (.preflight (.abi .allocationPrecondition)))) usedAll paired seen allPaths traced
        frame checked canonical residual
    | some width =>
      refine crossSharedRecordMemory .fields cx width fields ptr 0 emitted (sharedRecordReport leftTicket) (sharedRecordReport rightTicket)
        ?_ usedAll paired seen allPaths traced frame checked canonical residual compare
      intro thread frames rest peerFrames peerRest left right leading live trailing result split observed paths writers frame checked canonical residual
      let verdict : Except Scheduled.Issue Nat := (result.mapError Scheduled.Issue.lowerRecord).map (fun _ => 0)
      exact finishSharedResultCompared (leftTicket := leftTicket) (rightTicket := rightTicket) verdict split paired observed
        paths writers frame checked canonical residual

open ReturnFrame.Occurrence Stored.OwnedMemory.Claims Stored.Endpoints in
private theorem crossSharedRecord {left right : Config (core3 grow) (HostState sig)}
    {thread frames rest peerFrames peerRest} {callerFrame : Seg (core3 grow) (HostState sig)}
    {inst leftTicket rightTicket ptr} {leading trailing : Trace grow sig}
    (destination : RecordDestination) (tree : Stored.OwnedMemory.Tree sig)
    (split : labels = leading ++ trailing)
    (paired : HostFrame.Related.Paired older start incoming)
    (paths : OccurrenceTransport profile ready base bindings start incoming (.tau :: leading) (.tau :: leading)
      left right [some (.active 0 0)])
    (writers : VisitorWriterPath profile ready base bindings start incoming (.tau :: leading) (.tau :: leading) left right)
    (site : PairedComponentSite older left right ⟨thread, callerFrame :: frames, rest⟩ ⟨thread, callerFrame :: peerFrames, peerRest⟩)
    (leftFocus : left.ctl = (PayloadPrefix.Cursor.mk thread (callerFrame :: frames) rest).control
      ((SharedGiveAction.record destination).afterLookup inst leftTicket ptr (some tree)))
    (rightFocus : right.ctl = (PayloadPrefix.Cursor.mk thread (callerFrame :: peerFrames) peerRest).control
      ((SharedGiveAction.record destination).afterLookup inst rightTicket ptr (some tree)))
    (run : Steps profile ready (specDispatch ready base) left trailing finish)
    (compare : ShorterCallbackSlices profile ready base bindings (.tau :: labels).length) :
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  classical
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, callerFrame :: frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, callerFrame :: peerFrames, peerRest⟩
  cases tree with
  | atom impossible => exact impossible.elim
  | tag payload count children =>
    rw [sharedRecordCode (grow := grow) (sig := sig) destination inst leftTicket ptr payload count children] at leftFocus
    rw [sharedRecordCode (grow := grow) (sig := sig) destination inst rightTicket ptr payload count children] at rightFocus
    let cx := destination.context (grow := grow) inst
    let type := sig.payload payload.1
    let value := payload.2.val.value
    cases compiled : Record.preflight cx type payload.2 (.memory ptr) with
    | error issue =>
      have refused : Record.preflight (destination.context (grow := grow) inst) (sig.payload payload.1) payload.2
          (.memory ptr) = .error issue := compiled
      rw [refused] at leftFocus rightFocus
      exact finishSharedResult (leftTicket := leftTicket) (rightTicket := rightTicket) (.error (.lowerRecord issue))
        split paired paths writers site leftFocus rightFocus run
    | ok result =>
      obtain ⟨fields, objects⟩ := result
      have compiledAt : Record.preflight (destination.context (grow := grow) inst) (sig.payload payload.1) payload.2 (.memory ptr) =
          .ok (fields, objects) := compiled
      rw [compiledAt] at leftFocus rightFocus
      have emitted := RecordLower.compileRecord_emitted cx type value payload.2.val.owners (.memory ptr)
        fields objects (by
          simp only [Record.preflight, bind, Except.bind, Except.mapError] at compiled
          split at compiled <;> first | contradiction | exact compiled)
      let plan := RecordLower.Field.listObjects fields
      let checkedNext := sharedRecordAfterPrepare (sig := sig) cx type value fields ptr leftTicket
      let canonicalNext := sharedRecordAfterPrepare (sig := sig) cx type value fields ptr rightTicket
      refine crossSharedRecordPrepare plan checkedNext canonicalNext ?_ split paired rfl paths writers site
        leftFocus rightFocus run
      intro reached peer leading live trailing result split observed paths writers frame checked canonical residual
      cases result with
      | error issue =>
        exact finishSharedResultCompared (leftTicket := leftTicket) (rightTicket := rightTicket) (.error (.lowerRecord issue))
          split paired observed paths writers frame checked canonical residual
      | ok result =>
        cases result
        exact crossSharedRecordEmit (leftTicket := leftTicket) (rightTicket := rightTicket)
          cx type value fields emitted split paired observed paths writers frame checked canonical residual compare

open ReturnFrame.Occurrence in
private theorem crossAdmittedSharedGive {worker frames rest peerFrames peerRest name kind args inst}
    {action : SharedGiveAction} {callerFrame : Seg (core3 grow) (HostState sig)}
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (linked : resolveBinding bindings name kind = .ok ⟨name, inst, action.bindingAction⟩)
    (caller : Plain.callerInstance start.store (some worker) = .ok (some inst))
    (mayLeave : (start.store.inst? inst).any (·.mayLeave) = true)
    (paired : HostFrame.Related.Paired older start incoming) :
    let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, callerFrame :: frames, rest⟩
    let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, callerFrame :: peerFrames, peerRest⟩
    let checked := installedAccept ready base start check name kind args
    let raw := installedAccept ready (LiveDispatch.host bindings base) incoming canon name kind args
    PairedComponentSite older checked raw check canon →
    OccurrenceTransport profile ready base bindings start incoming [.tau] [.tau] checked raw [some (.active 0 0)] →
    Steps profile ready (specDispatch ready base) checked labels finish →
    ShorterCallbackSlices profile ready base bindings (.tau :: labels).length →
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  classical
  dsimp only
  intro site installed run compare
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, callerFrame :: frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, callerFrame :: peerFrames, peerRest⟩
  let checked := installedAccept ready base start check name kind args
  let raw := installedAccept ready (LiveDispatch.host bindings base) incoming canon name kind args
  let leftBody := { start with ctl := check.control (calloutBody Limits.spec Quirks.none ready base start.store
    check.thread (.embedder name kind) args) }
  let rightBody := { incoming with ctl := canon.control (calloutBody Limits.spec Quirks.none ready (LiveDispatch.host bindings base)
    incoming.store canon.thread (.embedder name kind) args) }
  have same : start.store = incoming.store := paired.data.1
  have leftPrelude := directGivePreludePath (profile := profile) (ready := ready) (start := checked) base name kind args check rfl
  have rightPrelude := directGivePreludePath (profile := profile) (ready := ready) (start := raw)
    (LiveDispatch.host bindings base) name kind args canon rfl
  have leftEntry := leftPrelude.append
    (scheduledEntryPath (profile := profile) (ready := ready) (start := leftBody) base (sharedGiveRoute linked)
      (congrFun (congrFun (congrFun embedder name) kind) args) check rfl caller mayLeave rfl)
  have rightEntry := rightPrelude.append
    (scheduledEntryPath (profile := profile) (ready := ready) (start := rightBody) (LiveDispatch.host bindings base) (sharedGiveRoute linked)
      (sharedGiveRawEmbedder linked embedder) canon rfl (same ▸ caller) (same ▸ mayLeave) rfl)
  let leftSelection := { start with
    host := start.host.enter name kind args
    ctl := check.control (action.selection args >>= finishSharedSelection action inst start.host.nextTicket) }
  let rightSelection := { incoming with
    host := incoming.host.enter name kind args
    ctl := canon.control (action.selection args >>= finishSharedSelection action inst incoming.host.nextTicket) }
  have leftScan := scanSelectorPath (profile := profile) (ready := ready) (dispatch := specDispatch ready base)
    (start := leftSelection) check (action.selection args) (finishSharedSelection action inst start.host.nextTicket) rfl
  have rightScan := scanSelectorPath (profile := profile) (ready := ready) (dispatch := specDispatch ready (LiveDispatch.host bindings base))
    (start := rightSelection) canon (action.selection args) (finishSharedSelection action inst incoming.host.nextTicket) rfl
  rw [sharedGiveBeforeSelection] at leftEntry rightEntry
  generalize scanned : scanSelector start.store (some worker) (action.selection (sig := sig) args) = reached
  obtain ⟨count, program⟩ := reached
  have rightScanned : scanSelector incoming.store (some worker) (action.selection (sig := sig) args) = (count, program) :=
    same ▸ scanned
  change FramedQuietPath _ _ _ _ _ (List.replicate
    (scanSelector start.store (some worker) (action.selection (sig := sig) args)).1 id) _ at leftScan
  dsimp only [leftSelection, rightSelection, check, canon] at leftScan rightScan
  rw [scanned] at leftScan
  rw [rightScanned] at rightScan
  have selected := sharedSelectionFrontier action args start.store (some worker) (sig := sig)
  rw [scanned] at selected
  have installedWriters := frameCalloutStep installed rfl rfl
  have early {edits : List (ComponentStoreEdit grow)} {left right : Config (core3 grow) (HostState sig)}
      (l : FramedQuietPath profile ready (specDispatch ready base) check checked edits left)
      (r : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon raw edits right)
      (short : labels.length < edits.length) :
      CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
    obtain ⟨_, _, moved, _, framed, _, _⟩ := compareFramedQuietShort l r site ⟨_, rfl⟩ ⟨_, rfl⟩ run short
    obtain ⟨_, whole, _⟩ := CallbackPrefix.transportAppend installed moved
    apply Or.inr
    apply callbackTerminalSlice paired
    simpa only [List.singleton_append, List.append_nil] using
      (CallbackSliceEnd.coreAcceptTerminal (changes := older) whole (installedWriters.append framed) (.refl _) (.inl rfl))
  cases selected with
  | refused issue =>
    have lhs := leftEntry.append leftScan
    have rhs := rightEntry.append rightScan
    rcases splitSilent (lhs.1.track (.active 0 0)).toTrail.steps run with ⟨suffix, split, residual⟩ | short
    · have paths := retainInstalledWaitable installed (fun place => ⟨lhs.1.track place, rhs.1.track place⟩)
      have writers := installedWriters.append (.framed lhs.2 rhs.2)
      exact finishSharedResult (.error issue) split paired paths writers (by
        unfold PairedComponentSite HostFrame.Related.Paired HostFrame.replace
        exact pairQuietHost site _) rfl rfl residual
    · exact early lhs rhs short
  | lookup handle position =>
    change FramedQuietPath _ _ _ check leftSelection (List.replicate count id)
      { leftSelection with ctl := check.control ((select handle >>= selectedAt position) >>=
        finishSharedSelection action inst start.host.nextTicket) } at leftScan
    change FramedQuietPath _ _ _ canon rightSelection (List.replicate count id)
      { rightSelection with ctl := canon.control ((select handle >>= selectedAt position) >>=
        finishSharedSelection action inst incoming.host.nextTicket) } at rightScan
    rw [sharedSelectionFinishLookup] at leftScan rightScan
    have lhs := leftEntry.append leftScan
    have rhs := rightEntry.append rightScan
    let leftBefore := { leftSelection with ctl := check.control (select handle >>= action.afterLookup inst start.host.nextTicket position) }
    let rightBefore := { rightSelection with ctl := canon.control (select handle >>= action.afterLookup inst incoming.host.nextTicket position) }
    let leftRoot := Stored.Endpoints.Core.childFromHistory leftBefore.host.writer.accepted handle
    let rightRoot := Stored.Endpoints.Core.childFromHistory rightBefore.host.writer.accepted handle
    let left := { leftBefore with ctl := check.control (action.afterLookup inst start.host.nextTicket position leftRoot) }
    let right := { rightBefore with ctl := canon.control (action.afterLookup inst incoming.host.nextTicket position rightRoot) }
    have leftPath : FramedQuietPath profile ready (specDispatch ready base) check checked _ left :=
      lhs.append (trailing := [id]) (selectorReadStep check handle (action.afterLookup inst start.host.nextTicket position)
        (start := leftBefore) rfl).2
    have rightPath : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon raw _ right :=
      rhs.append (trailing := [id]) (selectorReadStep canon handle (action.afterLookup inst incoming.host.nextTicket position)
        (start := rightBefore) rfl).2
    rcases splitSilent (leftPath.1.track (.active 0 0)).toTrail.steps run with ⟨suffix, split, residual⟩ | short
    · have paths := retainInstalledWaitable installed (fun place => ⟨leftPath.1.track place, rightPath.1.track place⟩)
      have writers := installedWriters.append (.framed leftPath.2 rightPath.2)
      by_cases agrees : leftRoot = rightRoot
      · cases chosen : leftRoot with
        | none =>
          exact finishSharedResult (leftTicket := start.host.nextTicket) (rightTicket := incoming.host.nextTicket)
            (.error .badSelection) split paired paths writers (by
            unfold PairedComponentSite HostFrame.Related.Paired HostFrame.replace
            exact pairQuietHost site _)
            (by change _ = check.control _; simp only [left, chosen, SharedGiveAction.afterLookup])
            (by change _ = canon.control _; simp only [right, ← agrees, chosen, SharedGiveAction.afterLookup]) residual
        | some tree =>
          have leftFound : left.ctl = check.control (action.afterLookup inst start.host.nextTicket position (some tree)) := by
            rw [← chosen]
          have rightFound : right.ctl = canon.control (action.afterLookup inst incoming.host.nextTicket position (some tree)) := by
            rw [← chosen, agrees]
          by_cases missing : missingSharedPosition action tree position
          · rw [sharedPositionRefusal _ _ _ _ _ missing] at leftFound rightFound
            exact finishSharedResult (leftTicket := start.host.nextTicket) (rightTicket := incoming.host.nextTicket)
              (.error .badSelection) split paired paths writers (by
                unfold PairedComponentSite HostFrame.Related.Paired HostFrame.replace
                exact pairQuietHost site _) leftFound rightFound residual
          · cases source : action.claimAt tree position with
            | none =>
              have record : ∃ destination, action = .record destination := by
                cases action with
                | record destination => exact ⟨destination, rfl⟩
                | giveOwner resource =>
                  exact (missing (Option.map_eq_none_iff.mp source)).elim
                | dropOwner resource =>
                  exact (missing (Option.map_eq_none_iff.mp source)).elim
                | endpoint channel element =>
                  exact (missing (Option.map_eq_none_iff.mp source)).elim
              obtain ⟨destination, rfl⟩ := record
              exact crossSharedRecord (leftTicket := start.host.nextTicket) (rightTicket := incoming.host.nextTicket)
                destination tree split paired paths writers (by
                  unfold PairedComponentSite HostFrame.Related.Paired HostFrame.replace
                  exact pairQuietHost site _) leftFound rightFound residual compare
            | some claim =>
              rw [sharedClaimProgram action inst _ position tree source] at leftFound rightFound
              exact crossSharedClaim embedder linked source split paired paths writers (by
                unfold PairedComponentSite HostFrame.Related.Paired HostFrame.replace
                exact pairQuietHost site _) leftFound rightFound residual compare
      · have mismatch : SharedGiveHistoryMismatch action inst start.host.nextTicket incoming.host.nextTicket position handle
            leftBefore rightBefore left right check canon :=
          ⟨rfl, rfl, rfl, rfl, agrees⟩
        let selectorEdits : List (ComponentStoreEdit grow) := [id, id] ++ [id, id, id, id, id, id] ++ List.replicate count id
        let leading : Trace grow sig := .tau :: List.replicate selectorEdits.length .tau
        have beforeRead := retainInstalledWaitable installed (fun place => ⟨lhs.1.track place, rhs.1.track place⟩)
        have leftRead := (selectorReadStep (profile := profile) (ready := ready) (dispatch := specDispatch ready base)
          check handle (action.afterLookup inst start.host.nextTicket position) (start := leftBefore) rfl).1
        have rightRead := (selectorReadStep (profile := profile) (ready := ready) (dispatch := specDispatch ready (LiveDispatch.host bindings base))
          canon handle (action.afterLookup inst incoming.host.nextTicket position) (start := rightBefore) rfl).1
        have leftReached : ReachedReadOccurrences profile ready (specDispatch ready base) start leftBefore left leading := by
          intro place
          let middle := beforeRead.choose place
          refine ⟨middle, (beforeRead.choose_spec.1 place).1, .step leftRead ?_⟩
          rw [show transitionEdit leftBefore .tau = .same from rfl]
          cases middle <;> exact .done _ _
        have rightReached : ReachedReadOccurrences profile ready (specDispatch ready (LiveDispatch.host bindings base))
            incoming rightBefore right leading := by
          intro place
          let middle := beforeRead.choose place
          refine ⟨middle, (beforeRead.choose_spec.1 place).2, .step rightRead ?_⟩
          rw [show transitionEdit rightBefore .tau = .same from rfl]
          cases middle <;> exact .done _ _
        let allLabels : Trace grow sig := .tau :: List.replicate (selectorEdits ++ [id]).length .tau
        have complete : allLabels = leading ++ [.tau] := by
          dsimp only [allLabels, leading]
          rw [List.length_append, List.replicate_add]
          rfl
        have allPaths : OccurrenceTransport profile ready base bindings start incoming allLabels allLabels left right
            [some (.active 0 0)] := paths
        have allWriters : VisitorWriterPath profile ready base bindings start incoming allLabels allLabels left right := by
          simpa only [List.singleton_append] using writers
        exact .inr (callbackTerminalSlice paired (by
          rw [split]
          have used := congrArg (· ++ suffix) complete
          change (.tau :: List.replicate (selectorEdits ++ [id]).length .tau) ++ suffix = _ at used
          rw [List.cons_append] at used
          rw [used]
          exact .sharedGiveSelectionMismatch mismatch leftReached rightReached (complete ▸ allPaths) (complete ▸ allWriters) residual))
    · exact early leftPath rightPath short

open ReturnFrame.Occurrence in
private theorem crossInstalledSharedGive {thread frames rest peerFrames peerRest name kind args inst}
    {action : SharedGiveAction} {callerFrame : Seg (core3 grow) (HostState sig)}
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (linked : resolveBinding bindings name kind = .ok ⟨name, inst, action.bindingAction⟩)
    (paired : HostFrame.Related.Paired older start incoming) :
    let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, callerFrame :: frames, rest⟩
    let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, callerFrame :: peerFrames, peerRest⟩
    let checked := installedAccept ready base start check name kind args
    let raw := installedAccept ready (LiveDispatch.host bindings base) incoming canon name kind args
    PairedComponentSite older checked raw check canon →
    OccurrenceTransport profile ready base bindings start incoming [.tau] [.tau] checked raw [some (.active 0 0)] →
    Steps profile ready (specDispatch ready base) checked labels finish →
    ShorterCallbackSlices profile ready base bindings (.tau :: labels).length →
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  classical
  dsimp only
  intro site installed run compare
  by_cases admitted : Plain.callerInstance start.store thread = .ok (some inst) ∧
      (start.store.inst? inst).any (·.mayLeave) = true
  · cases thread with
    | none => simp [Plain.callerInstance] at admitted
    | some worker => exact crossAdmittedSharedGive embedder linked admitted.1 admitted.2 paired site installed run compare
  · exact crossDeniedScheduledBody embedder (sharedGiveRawEmbedder linked embedder) (sharedGiveRoute linked) admitted paired site installed run

private theorem classifiedSharedGiveCrossing
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder) :
    CallbackSharedGiveCrossing profile ready base bindings := by
  intro _ _ _ _ _ _ _ _ _ _ _ _ call linked step run paired compare
  cases call with
  | core focus calling =>
    obtain ⟨_, _, rfl, rfl, site, installed, _, _⟩ := cutSharedCalloutInstall _ _ focus calling step paired
    exact crossInstalledSharedGive embedder linked paired site installed run compare
  | program focus =>
    obtain ⟨_, _, rfl, rfl, site, installed, _, _, _⟩ :=
      cutProgramCallInstall (.prog (.pure (.cancel .none))) focus step paired
    exact crossInstalledSharedGive embedder linked paired site installed run compare

private theorem foldMixedCallbacks {callees : List (ComponentCall.Callee sig)}
    (run : Steps profile ready (specDispatch ready (ComponentCall.hostWithComponent bindings callees)) start labels finish)
    (paired : HostFrame.Related.Paired older start incoming) :
    CallbackSlice profile ready (ComponentCall.hostWithComponent bindings callees) bindings older start incoming labels finish :=
  foldCallbackSlicesWith (classifiedGiveCrossing (base := ComponentCall.hostWithComponent bindings callees) rfl)
    (some ⟨classifiedComponentCrossing⟩) (some ⟨classifiedPollCrossing⟩) (some ⟨classifiedWaitCrossing⟩)
    (some ⟨classifiedWaitResumeCrossing⟩) (some ⟨classifiedCancelResumeCrossing⟩)
    (some ⟨classifiedCancelCrossing⟩) (some ⟨classifiedCoreAcceptCrossing (base := ComponentCall.hostWithComponent bindings callees) rfl⟩)
    (some ⟨classifiedSharedGiveCrossing (base := ComponentCall.hostWithComponent bindings callees) rfl⟩) run paired

theorem actualSelectedGive {route : GiveEffectRoute} {request : CoreGiveRequest bindings start}
    (selection : request.Selected route) {callees : List (ComponentCall.Callee sig)} {label next}
    (install : GiveInstall bindings (specDispatch ready (ComponentCall.hostWithComponent bindings callees)) start label next)
    (tail : Steps profile ready (specDispatch ready (ComponentCall.hostWithComponent bindings callees)) next labels finish)
    (paired : HostFrame.Related.Paired older start incoming)
    (selected : Stored.Endpoints.Core.childFromHistory incoming.host.writer.accepted selection.handle = some selection.tree) :
    ActualSelectedGive profile ready (ComponentCall.hostWithComponent bindings callees)
      selection older incoming (label :: labels) finish :=
  actualSelectedCallback selection install tail paired selected rfl (fun _ => foldMixedCallbacks)

open ReturnFrame.Occurrence in
theorem classifyCancelHookCallbacks {callees : List (ComponentCall.Callee sig)}
    (async : Bool) (subtask : SubtaskId) (hook : CancelRef)
    {thread frames rest peerFrames peerRest}
    (leftFocus : start.ctl = ⟨thread, .prog (cancelAfterRequestWrite async subtask hook), frames⟩ :: rest)
    (rightFocus : incoming.ctl = ⟨thread, .prog (cancelAfterRequestWrite async subtask hook), peerFrames⟩ :: peerRest)
    (paired : PairedComponentSite older start incoming ⟨thread, frames, rest⟩ ⟨thread, peerFrames, peerRest⟩)
    (run : Steps profile ready (specDispatch ready (ComponentCall.hostWithComponent bindings callees)) start labels finish) :
    CancelHookCallbackSlice profile ready (ComponentCall.hostWithComponent bindings callees) bindings older
      (cancelHookReturn async subtask) start incoming labels finish :=
  classifyCancelHookWith async subtask hook leftFocus rightFocus paired run (Nat.le_refl _) (fun _ => foldMixedCallbacks)

open ReturnFrame.Occurrence in
private theorem classifyParkedCoreCallbacks {callees : List (ComponentCall.Callee sig)}
    (savedProgram : Session grow sig (Ret (core3 grow)))
    {thread core resume frames rest peerFrames peerRest}
    (leftFocus : start.ctl = ⟨some thread, .prog (.op (.block none) (fun _ => savedProgram)), .core core resume :: frames⟩ :: rest)
    (rightFocus : incoming.ctl = ⟨some thread, .prog (.op (.block none) (fun _ => savedProgram)),
      .core core resume :: peerFrames⟩ :: peerRest)
    (paired : PairedComponentSite older start incoming ⟨some thread, .core core resume :: frames, rest⟩
      ⟨some thread, .core core resume :: peerFrames, peerRest⟩)
    (run : Steps profile ready (specDispatch ready (ComponentCall.hostWithComponent bindings callees)) start labels finish) :
    ParkedCoreCalloutSlice profile ready (ComponentCall.hostWithComponent bindings callees) bindings older start incoming labels finish := by
  rcases cutCoreCalloutPark (bindings := bindings) savedProgram leftFocus rightFocus paired run with stopped | parked
  · exact .inl stopped
  obtain ⟨_, split, residual, aligned, paths, leftMark, rightMark⟩ := parked
  obtain ⟨checked, canonical, trailing, reached, peer, used, compared, ending⟩ := foldMixedCallbacks residual aligned
  obtain ⟨move, whole, tracks⟩ := CallbackPrefix.transportAppend paths compared.occurrences
  obtain ⟨left, right⟩ := tracks (some (.saved thread.idx 0))
  exact .inr ⟨checked, canonical, trailing, reached, peer, move (some (.saved thread.idx 0)),
    by rw [split, used]; rfl, whole, leftMark.append left, rightMark.append right, ending⟩

theorem classifyParkedWaitCallbacks {callees : List (ComponentCall.Callee sig)}
    (mem : (core3 grow).MemAddr) (entry : WaitableCalloutEntry)
    {thread core resume frames rest peerFrames peerRest}
    (leftFocus : start.ctl = ⟨some thread, .prog (waitableWaitAfterDecision mem entry (some thread)), .core core resume :: frames⟩ :: rest)
    (rightFocus : incoming.ctl = ⟨some thread, .prog (waitableWaitAfterDecision mem entry (some thread)),
      .core core resume :: peerFrames⟩ :: peerRest)
    (paired : PairedComponentSite older start incoming ⟨some thread, .core core resume :: frames, rest⟩
      ⟨some thread, .core core resume :: peerFrames, peerRest⟩)
    (run : Steps profile ready (specDispatch ready (ComponentCall.hostWithComponent bindings callees)) start labels finish) :
    ParkedWaitCallbackSlice profile ready (ComponentCall.hostWithComponent bindings callees) bindings older start incoming labels finish :=
  classifyParkedCoreCallbacks (waitableWaitContinue mem entry) leftFocus rightFocus paired run

theorem classifyParkedCancelCallbacks {callees : List (ComponentCall.Callee sig)}
    (subtask : SubtaskId)
    {thread core resume frames rest peerFrames peerRest}
    (leftFocus : start.ctl = ⟨some thread, .prog (cancelAfterHookDecision subtask (some thread)), .core core resume :: frames⟩ :: rest)
    (rightFocus : incoming.ctl = ⟨some thread, .prog (cancelAfterHookDecision subtask (some thread)),
      .core core resume :: peerFrames⟩ :: peerRest)
    (paired : PairedComponentSite older start incoming ⟨some thread, .core core resume :: frames, rest⟩
      ⟨some thread, .core core resume :: peerFrames, peerRest⟩)
    (run : Steps profile ready (specDispatch ready (ComponentCall.hostWithComponent bindings callees)) start labels finish) :
    ParkedCoreCalloutSlice profile ready (ComponentCall.hostWithComponent bindings callees) bindings older start incoming labels finish :=
  classifyParkedCoreCallbacks (cancelFinish subtask) leftFocus rightFocus paired run

theorem classifyMixedCallbacks {callees : List (ComponentCall.Callee sig)}
    (run : Steps profile ready (specDispatch ready (ComponentCall.hostWithComponent bindings callees)) start labels finish)
    (paired : HostFrame.Related.Paired older start incoming) :
    MixedCallbackSlice profile ready bindings callees older start incoming labels finish := by
  obtain ⟨checked, canonical, trailing, reached, peer, split, front, ending⟩ := foldMixedCallbacks run paired
  have residual := callbackEndSteps ending
  refine ⟨checked, canonical, trailing, reached, peer, split, front, WriterPaths.ofVisitor front.writers,
    ending, WriterPaths.ofSteps residual, ?_⟩
  cases residual with
  | refl => exact .inl ⟨rfl, rfl⟩
  | cons step tail => exact .inr ⟨_, _, _, rfl, step, tail, classifyComponentInstallOutcome step tail front.paired⟩

open ReturnFrame.Occurrence in
theorem compareComponentMarkedWorker {callees : List (ComponentCall.Callee sig)}
    {reached peer : Config (core3 grow) (HostState sig)} {leading suffix : Trace grow sig}
    {check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    {first second : ReturnFrame.Continuation (core3 grow) (HostState sig)}
    (moved : OccurrenceTransport profile ready (ComponentCall.hostWithComponent bindings callees) bindings
      start incoming leading leading reached peer)
    (reply : ComponentMarkedReplyTail profile ready (ComponentCall.hostWithComponent bindings callees) bindings older
      start incoming reached peer leading check first second suffix finish) :
    ComponentMarkedWorkerTail profile ready (ComponentCall.hostWithComponent bindings callees) bindings older
      start incoming reached peer leading check first second suffix finish := by
  classical
  by_cases focus : reached.ctl = check.control (.pure (.cancel .none))
  · obtain ⟨mark, tracked, result⟩ := reply
    rcases result focus with lost | ⟨after, _, pop⟩
    · exact .inr (.inl ⟨mark, tracked, lost⟩)
    rcases pop with lost | empty | ⟨remaining, rightAfter, _, actual, smaller, residual, _, frame, _, _, transport⟩
    · exact .inr (.inl ⟨mark, tracked, lost⟩)
    · exact .inr (.inr (.inl empty))
    have continued := transport (markTransport moved)
    refine .inr (.inr (.inr ⟨remaining, after, rightAfter, actual, smaller, residual, continued, ?_⟩))
    by_cases common : first (.cancel .none) = second (.cancel .none)
    · have pair : HostFrame.Related.Paired older
          { reached with ctl := after.control (first (.cancel .none)) }
          { peer with ctl := rightAfter.control (second (.cancel .none)) } := by
        rw [← common]
        exact pairAfterComponentPop frame
      obtain ⟨checked, canonical, trailing, worker, workerPeer, split, segment, ending⟩ :=
        foldMixedCallbacks residual pair
      exact .inr ⟨checked, canonical, trailing, worker, workerPeer, split,
        by simpa only [List.map_nil, List.append_nil] using
          (CallbackPrefix.transportAppend continued segment.occurrences).choose_spec.1, segment.observed, ending⟩
    · exact .inl common
  · exact .inl focus

