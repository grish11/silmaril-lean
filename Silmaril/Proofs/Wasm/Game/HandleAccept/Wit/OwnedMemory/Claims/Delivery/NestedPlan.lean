    (storeEffectTrapIf (entry.rt != resource) .resourceTypeMismatch).bind fun _ => .pure entry.rep).bind fun rep =>
    (storeEffectGetObject ArenaField.resourceTypes resource).bind fun rty => .pure [ptrFlat rty.rep rep]

