private def CallbackCancelCrossing (profile : ProfileKind) (ready : HostReady (HostState sig))
    (base : HostImpl (core3 grow) (HostState sig)) (bindings : List (Binding sig)) : Prop :=
  ∀ {changes : ReturnFrame.Substitutions (core3 grow) (HostState sig)} {checked canonical next finish label trailing}
    {thread core resume frames rest async inst args},
    checked.ctl = ⟨thread, .core core resume, frames⟩ :: rest →
    (core3 grow).status checked.store.core core = .callout (.builtin (.subtaskCancel async) inst) args →
    Step profile ready (specDispatch ready base) checked label next →
    Steps profile ready (specDispatch ready base) next trailing finish →
    HostFrame.Related.Paired changes checked canonical →
    ShorterCallbackSlices profile ready base bindings (label :: trailing).length →
    CallbackCrossingAt profile ready base bindings changes checked canonical label trailing finish

open ReturnFrame.Occurrence in
private theorem compareNonGrowingUpdate {changes : ReturnFrame.Substitutions (core3 grow) (HostState sig)} {label next}
    (failed : ¬ CoreUpdateGrows start) (step : Step profile ready (specDispatch ready base) start label next)
    (tail : Steps profile ready (specDispatch ready base) next labels finish)
    (paired : HostFrame.Related.Paired changes start incoming) :
    CallbackSliceEnd profile ready base bindings changes start incoming (label :: labels) finish := by
  have openUpdate := failed
  unfold CoreUpdateGrows at failed
  split at failed
  next thread update resume frames rest focus =>
    obtain ⟨rfl, rfl⟩ := silentStepUnique (.modify focus) step
    obtain ⟨peerFrames, peerRest, atPeer, continued⟩ :=
      paired.retarget focus (.prog (resume ())) start.host incoming.host
    have live : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau
        { incoming with store := update start.store, ctl := ⟨thread, .prog (resume ()), peerFrames⟩ :: peerRest } := by
      rw [paired.data.1]
      exact .modify atPeer
    have aligned := continued.set_store (update start.store)
    have path := CallbackPrefix.stationaryTransport (base := base) (bindings := bindings)
      (fun place => Prefix.step (.modify focus) (by rw [transitionEdit, focus]; rfl) (.done _ place))
      (fun place => Prefix.step live (by rw [transitionEdit, atPeer]; rfl) (.done _ place))
    refine .nonGrowing ⟨[], .tau, [], start, _, rfl, .refl _, openUpdate, .modify focus, .refl _⟩
      aligned path (.framed (.same (.modify focus) rfl (.done _)) (.same live rfl (.done _))) tail
  next => simp at failed

private theorem foldCallbackSlicesWith (cross : CallbackGiveCrossing profile ready base bindings)
    (component : Option (PLift (CallbackComponentCrossing profile ready base bindings)))
    (poll : Option (PLift (CallbackWaitableCrossing profile ready base bindings true)))
    (wait : Option (PLift (CallbackWaitableCrossing profile ready base bindings false)))
    (waitResume : Option (PLift (CallbackWaitResumeCrossing profile ready base bindings)))
    (cancelResume : Option (PLift (CallbackCancelResumeCrossing profile ready base bindings)))
    (cancel : Option (PLift (CallbackCancelCrossing profile ready base bindings)))
    (accept : Option (PLift (CallbackCoreAcceptCrossing profile ready base bindings)))
    (shared : Option (PLift (CallbackSharedGiveCrossing profile ready base bindings)))
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (paired : HostFrame.Related.Paired older start incoming) :
    CallbackSlice profile ready base bindings older start incoming labels finish := by
  induction size : labels.length using Nat.strong_induction_on generalizing start incoming labels finish older with
  | ind budget ih =>
    cases cutExecutedCallback run paired component.isSome poll.isSome (wait.isSome || waitResume.isSome) cancelResume.isSome
        cancel.isSome accept.isSome shared.isSome with
    | complete segment _ => exact ⟨labels, labels, [], finish, _, (List.append_nil _).symm, segment, .exhausted⟩
    | @boundary leading label trailing reached peer next split front _ kind step tail smaller =>
      have stop (ending : CallbackSliceEnd profile ready base bindings older reached peer (label :: trailing) finish) :
          CallbackSlice profile ready base bindings older start incoming labels finish :=
        ⟨leading, leading, label :: trailing, reached, peer, split, front, ending⟩
      have advance (crossed : CallbackCrossingAt profile ready base bindings older reached peer label trailing finish) :
          CallbackSlice profile ready base bindings older start incoming labels finish := by
        rcases crossed with
          ⟨consumed, canonLabels, residual, replied, peerReply, used, reply, rest⟩ | ending
        · have remaining : residual.length < budget := by
            have lengths := congrArg List.length used
            simp only [List.length_append] at lengths
            omega
          obtain ⟨checked, canonical, trailing, reached, peer, suffix, continued, ending⟩ :=
            ih residual.length remaining rest reply.paired rfl
          exact ⟨leading ++ (label :: consumed) ++ checked, leading ++ canonLabels ++ canonical, trailing, reached, peer,
            by rw [split, used, suffix]; simp only [List.append_assoc, List.cons_append],
            CallbackPrefix.appendExecutedCallbacks (CallbackPrefix.appendExecutedCallbacks front reply) continued, ending⟩
        · obtain ⟨checked, canonical, trailing, reached, peer, tailSplit, nested, ending⟩ := ending
          exact ⟨leading ++ checked, leading ++ canonical, trailing, reached, peer,
            by rw [split, tailSplit, List.append_assoc], CallbackPrefix.appendExecutedCallbacks front nested, ending⟩
      have available : ShorterCallbackSlices profile ready base bindings (label :: trailing).length := by
        intro _ _ _ _ actual shorter actualRun actualPair
        have cutLength : (label :: trailing).length ≤ budget := by
          rw [← size, split, List.length_append]
          omega
        exact ih actual.length (Nat.lt_of_lt_of_le shorter cutLength) actualRun actualPair rfl
      cases kind with
      | give install => exact advance (cross install tail front.paired available)
      | @read thread resume frames rest focus _ =>
        by_cases agrees : resume reached.host = resume peer.host
        · obtain ⟨afterRead, read⟩ := CallbackPrefix.compareReachedHostRead focus step front.paired agrees
          obtain ⟨checked, canonical, trailing, lhs, rhs, used, continued, ending⟩ :=
            ih trailing.length (size ▸ smaller) tail read.paired rfl
          exact ⟨leading ++ [label] ++ checked, leading ++ [label] ++ canonical, trailing, lhs, rhs,
            by rw [split, used]; simp only [List.append_assoc, List.cons_append, List.nil_append],
            CallbackPrefix.appendExecutedCallbacks (CallbackPrefix.appendExecutedCallbacks front read) continued, ending⟩
        · by_cases assignment : ∃ left right next,
              resume reached.host = .op (.hostSet left) (fun _ => next) ∧
                resume peer.host = .op (.hostSet right) (fun _ => next)
          · obtain ⟨left, right, nextProgram, checkedWrite, canonicalWrite⟩ := assignment
            obtain ⟨afterWrite, compared⟩ := CallbackPrefix.compareReachedHostAssignment focus front.paired checkedWrite canonicalWrite
            rcases splitSilent (count := 2) compared.checkedRun.steps (.cons step tail) with ⟨remaining, consumed, actual⟩ | _
            · have decreases : remaining.length < budget := by
                rw [← size, split, consumed, List.length_append, List.length_append, List.length_replicate]
                omega
              obtain ⟨checked, canonical, trailing, lhs, rhs, used, continued, ending⟩ :=
                ih remaining.length decreases actual compared.paired rfl
              exact ⟨leading ++ [.tau, .tau] ++ checked, leading ++ [.tau, .tau] ++ canonical, trailing, lhs, rhs,
                by rw [split, consumed, used]; simp only [List.replicate_succ, List.replicate_zero, List.append_assoc],
                CallbackPrefix.appendExecutedCallbacks (CallbackPrefix.appendExecutedCallbacks front compared) continued, ending⟩
            · rename_i short
              cases trailing with
              | nil =>
                cases tail
                exact stop (CallbackPrefix.comparePendingHostAssignment focus step front.paired checkedWrite canonicalWrite)
              | cons => simp only [List.length_cons] at short; omega
          · exact stop (CallbackPrefix.compareDivergentHostRead focus step tail front.paired agrees)
      | protectedPop retained focus => exact stop (.boundary (.protectedPop retained focus) step tail)
      | coreAcceptInstall call source =>
        cases accept with
        | none => exact stop (.boundary (.coreAcceptInstall call source) step tail)
        | some rule => exact advance (rule.down call source step tail front.paired)
      | sharedGiveInstall call linked =>
        cases shared with
        | none => exact stop (.boundary (.sharedGiveInstall call linked) step tail)
        | some rule => exact advance (rule.down call linked step tail front.paired available)
      | componentInstall focus =>
        cases component with
        | none => exact stop (.boundary (.componentInstall focus) step tail)
        | some rule => exact advance (rule.down focus step tail front.paired)
      | pollInstall focus calling =>
        cases poll with
        | none => exact stop (.boundary (.pollInstall focus calling) step tail)
        | some rule => exact advance (rule.down focus calling step tail front.paired)
      | waitInstall focus calling =>
        cases wait with
        | none => exact stop (.boundary (.waitInstall focus calling) step tail)
        | some rule => exact advance (rule.down focus calling step tail front.paired)
      | waitResume focus found =>
        cases waitResume with
        | none => exact stop (.boundary (.waitResume focus found) step tail)
        | some rule => exact advance (rule.down focus found step tail front.paired)
      | cancelResume focus found =>
        cases cancelResume with
        | none => exact stop (.boundary (.cancelResume focus found) step tail)
        | some rule => exact advance (rule.down focus found step tail front.paired)
      | cancelInstall focus calling =>
        cases cancel with
        | none => exact stop (.boundary (.cancelInstall focus calling) step tail)
        | some rule => exact advance (rule.down focus calling step tail front.paired available)
      | write focus =>
        obtain ⟨rfl, rfl⟩ := silentStepUnique (.hostSet focus) step
        obtain ⟨afterWrite, compared⟩ := CallbackPrefix.compareReachedHostWrite focus front.paired
        obtain ⟨checked, canonical, trailing, lhs, rhs, used, continued, ending⟩ :=
          ih trailing.length (size ▸ smaller) tail compared.paired rfl
        exact ⟨leading ++ [.tau] ++ checked, leading ++ [.tau] ++ canonical, trailing, lhs, rhs,
          by rw [split, used]; simp only [List.append_assoc, List.cons_append, List.nil_append],
          CallbackPrefix.appendExecutedCallbacks (CallbackPrefix.appendExecutedCallbacks front compared) continued, ending⟩
      | nonGrowingUpdate failed => exact stop (compareNonGrowingUpdate failed step tail front.paired)

theorem foldCallbackSlices (cross : CallbackGiveCrossing profile ready base bindings)
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (paired : HostFrame.Related.Paired older start incoming) :
    CallbackSlice profile ready base bindings older start incoming labels finish :=
  foldCallbackSlicesWith cross none none none none none none none none run paired

private theorem callbackEndSteps {changes : ReturnFrame.Substitutions (core3 grow) (HostState sig)}
    (ending : CallbackSliceEnd profile ready base bindings changes start incoming labels finish) :
    Steps profile ready (specDispatch ready base) start labels finish := by
  induction ending with
  | exhausted => exact .refl _
  | boundary _ step tail => exact .cons step tail
  | observation _ _ paths _ tail => exact append (paths.choose_spec.1 none).1.steps tail
  | pendingAssignment _ _ _ _ paths _ => exact (paths.choose_spec.1 none).1.steps
  | coreAcceptTerminal paths _ tail _ => exact append (paths.choose_spec.1 none).1.steps tail
  | sharedDropSource _ _ _ _ _ _ _ _ _ _ ih => exact ih
  | sharedDropWorkerImport _ _ _ _ _ _ residual => exact residual
  | sharedDropRecordPrepared _ _ _ _ _ _ _ _ _ _ _ _ ih => exact ih
  | sharedDropRecordAllocatorBody _ _ _ _ _ _ _ _ _ _ _ _ _ ih => exact ih
  | sharedDropRecordAllocatorResumed _ _ _ _ _ _ _ _ _ _ _ _ ih => exact ih
  | sharedDropRecordAllocatorRegistered _ _ _ _ _ _ _ _ ih => exact ih
  | sharedDropRecordAllocatorArguments _ _ _ _ _ _ _ _ _ _ _ _ _ _ ih => exact ih
  | sharedDropRecordAllocatorCoreCallout _ _ _ _ _ _ _ _ _ _ _ residual => exact residual
  | sharedDropRecordAllocatorCoreReturned _ _ _ _ _ _ _ _ _ _ _ ih => exact ih
  | sharedDropRecordAllocatorResolved _ _ _ _ _ _ _ _ _ residual => exact residual
  | sharedDropNestedResumed _ _ _ _ _ _ _ _ _ residual => exact residual
  | sharedDropSwitch _ _ _ _ _ residual => exact residual
  | sharedDropSwitchTarget _ _ _ _ _ _ _ residual => exact residual
  | destructorPrefix paths _ _ _ ih => exact append (paths.choose_spec.1 none).1.steps ih
  | sharedDropParentJoined paths _ _ _ _ _ ih => exact append (paths.choose_spec.1 none).1.steps ih
  | sharedDropParentPop paths _ _ _ _ residual => exact append (paths.choose_spec.1 none).1.steps residual
  | sharedDropParentLoop paths _ _ _ residual => exact append (paths.choose_spec.1 none).1.steps residual
  | sharedDropParentLoopJoined paths _ _ _ ih => exact append (paths.choose_spec.1 none).1.steps ih
  | sharedDropLoopReturn paths _ _ _ _ _ _ ih => exact append (paths.choose_spec.1 none).1.steps ih
  | sharedDropCompared _ _ paths _ compared _ ih =>
    exact append (paths.choose_spec.1 none).1.steps (append compared.checkedRun.steps ih)
  | sharedGiveProbeMismatch _ _ _ paths _ tail => exact append (paths.choose_spec.1 none).1.steps tail
  | comparedPrefix paths _ _ ih => exact append (paths.choose_spec.1 none).1.steps ih
  | sharedRecordAllocator paths _ _ compared _ ih =>
    simpa only [List.append_assoc] using append (paths.choose_spec.1 none).1.steps (append compared.checkedRun.steps ih)
  | sharedRecordAllocatorPop _ _ _ _ _ paths _ _ ih => exact append (paths.choose_spec.1 none).1.steps ih
  | sharedRecordPrepareMismatch _ paths _ tail => exact append (paths.choose_spec.1 none).1.steps tail
  | sharedRecordOwnerMismatch _ paths _ tail => exact append (paths.choose_spec.1 none).1.steps tail
  | sharedRecordEndpointMismatch _ paths _ tail => exact append (paths.choose_spec.1 none).1.steps tail
  | sharedGiveSelectionMismatch _ _ _ paths _ tail => exact append (paths.choose_spec.1 none).1.steps tail
  | componentEntryPrefix _ _ _ paths _ => exact (paths.choose_spec.1 none).1.steps
  | componentObserverTerminal _ paths _ tail => exact append (paths.choose_spec.1 none).1.steps tail
  | componentPreflightMismatch _ _ _ _ paths _ tail => exact append (paths.choose_spec.1 none).1.steps tail
  | componentRefusedTerminal _ _ paths _ tail => exact append (paths.choose_spec.1 none).1.steps tail
  | componentRegistrationMismatch _ _ paths _ _ tail => exact append (paths.choose_spec.1 none).1.steps tail
  | componentAcceptedTerminal _ _ paths _ _ tail => exact append (paths.choose_spec.1 none).1.steps tail
  | componentReplyDisplaced _ _ _ paths _ tail => exact append (paths.choose_spec.1 none).1.steps tail
  | refused _ _ _ _ reply =>
    obtain ⟨_, _, rfl, front, completed, tail, _, _, _, _, _⟩ := reply
    exact append front (append completed tail)
  | directGiveTrap cut _ _ _ => exact append (cut.paths.choose_spec.1 none).1.steps cut.residual
  | giveLookupMismatch _ cut _ _ _ _ _ _ => exact append (cut.paths.choose_spec.1 none).1.steps cut.residual
  | directGiveSelected _ _ cut _ _ _ _ _ => exact append (cut.paths.choose_spec.1 none).1.steps cut.residual
  | compilerRefused _ _ _ checked _ _ _ _ tail _ => exact append (checked (.active 0 0)).steps tail
  | placementTrap _ _ _ checked _ _ _ _ tail _ => exact append (checked (.active 0 0)).steps tail
  | body _ cut _ => exact append (cut.paths.choose_spec.1 none).1.steps cut.residual
  | directGiveLateReply _ _ cut _ _ => exact append (cut.paths.choose_spec.1 none).1.steps cut.residual
  | directGiveFinite cut => exact (cut.paths.choose_spec.1 none).1.steps
  | allocator _ cut _ _ _ _ => exact append (cut.paths.choose_spec.1 none).1.steps cut.residual
  | nonGrowing _ _ paths _ residual => exact append (paths.choose_spec.1 none).1.steps residual
  | pollTerminal paths _ _ _ _ residual => exact append (paths.choose_spec.1 none).1.steps residual
  | waitTerminal paths _ _ _ residual => exact append (paths.choose_spec.1 none).1.steps residual
  | cancelTerminal paths _ _ _ _ residual => exact append (paths.choose_spec.1 none).1.steps residual
  | cancelHookBody paths _ _ _ _ ih => exact append (paths.choose_spec.1 none).1.steps ih
  | cancelDecisionTerminal paths _ _ _ _ residual => exact append (paths.choose_spec.1 none).1.steps residual
  | cancelParked paths _ _ _ ih => exact append (paths.choose_spec.1 none).1.steps ih

private theorem returningCallbackEndSteps {changes : ReturnFrame.Substitutions (core3 grow) (HostState sig)}
    {cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)} {resume value}
    (ending : CallbackSliceEnd profile ready base bindings changes start incoming labels finish)
    (focus : start.ctl = { cursor with frames := .prog resume :: cursor.frames }.control (.pure value)) :
    Steps profile ready (specDispatch ready base) start labels finish := by
  cases ending with
  | exhausted => exact .refl _
  | boundary _ step tail => exact .cons step tail
  | observation read _ _ _ _ => simp_all [PayloadPrefix.Cursor.control]
  | pendingAssignment _ _ _ _ paths _ => exact (paths.choose_spec.1 none).1.steps
  | coreAcceptTerminal paths _ tail _ => exact append (paths.choose_spec.1 none).1.steps tail
  | sharedDropSource _ _ _ _ _ _ _ _ _ ending => exact callbackEndSteps ending
  | sharedDropWorkerImport _ _ _ _ _ _ residual => exact residual
  | sharedDropRecordPrepared _ _ _ _ _ _ _ _ _ _ _ ending => exact callbackEndSteps ending
  | sharedDropRecordAllocatorBody _ _ _ _ _ _ _ _ _ _ _ _ ending => exact callbackEndSteps ending
  | sharedDropRecordAllocatorResumed _ _ _ _ _ _ _ _ _ _ _ ending => exact callbackEndSteps ending
  | sharedDropRecordAllocatorRegistered _ _ _ _ _ _ _ ending => exact callbackEndSteps ending
  | sharedDropRecordAllocatorArguments _ _ _ _ _ _ _ _ _ _ _ _ _ ending => exact callbackEndSteps ending
  | sharedDropRecordAllocatorCoreCallout _ _ _ _ _ _ _ _ _ _ _ residual => exact residual
  | sharedDropRecordAllocatorCoreReturned _ _ _ _ _ _ _ _ _ _ ending => exact callbackEndSteps ending
  | sharedDropRecordAllocatorResolved _ _ _ _ _ _ _ _ _ residual => exact residual
  | sharedDropNestedResumed _ _ _ _ _ _ _ _ _ residual => exact residual
  | sharedDropSwitch _ _ _ _ _ residual => exact residual
  | sharedDropSwitchTarget _ _ _ _ _ _ _ residual => exact residual
  | destructorPrefix paths _ _ ending => exact append (paths.choose_spec.1 none).1.steps (callbackEndSteps ending)
  | sharedDropParentJoined paths _ _ _ _ ending => exact append (paths.choose_spec.1 none).1.steps (callbackEndSteps ending)
  | sharedDropParentPop paths _ _ _ _ residual => exact append (paths.choose_spec.1 none).1.steps residual
  | sharedDropParentLoop paths _ _ _ residual => exact append (paths.choose_spec.1 none).1.steps residual
  | sharedDropParentLoopJoined paths _ _ ending =>
    exact append (paths.choose_spec.1 none).1.steps (callbackEndSteps ending)
  | sharedDropLoopReturn paths _ _ _ _ _ ending =>
    exact append (paths.choose_spec.1 none).1.steps (callbackEndSteps ending)
  | sharedDropCompared _ _ paths _ compared ending =>
    exact append (paths.choose_spec.1 none).1.steps (append compared.checkedRun.steps (callbackEndSteps ending))
  | sharedGiveProbeMismatch _ _ _ paths _ tail => exact append (paths.choose_spec.1 none).1.steps tail
  | comparedPrefix paths _ ending => exact append (paths.choose_spec.1 none).1.steps (callbackEndSteps ending)
  | sharedRecordAllocator paths _ _ compared ending =>
    simpa only [List.append_assoc] using
      append (paths.choose_spec.1 none).1.steps (append compared.checkedRun.steps (callbackEndSteps ending))
  | sharedRecordAllocatorPop _ _ _ _ _ paths _ ending =>
    exact append (paths.choose_spec.1 none).1.steps (callbackEndSteps ending)
  | sharedRecordPrepareMismatch _ paths _ tail => exact append (paths.choose_spec.1 none).1.steps tail
  | sharedRecordOwnerMismatch _ paths _ tail => exact append (paths.choose_spec.1 none).1.steps tail
  | sharedRecordEndpointMismatch _ paths _ tail => exact append (paths.choose_spec.1 none).1.steps tail
  | sharedGiveSelectionMismatch _ _ _ paths _ tail => exact append (paths.choose_spec.1 none).1.steps tail
  | componentEntryPrefix _ _ _ paths _ => exact (paths.choose_spec.1 none).1.steps
  | componentObserverTerminal _ paths _ tail => exact append (paths.choose_spec.1 none).1.steps tail
  | componentPreflightMismatch _ _ _ _ paths _ tail => exact append (paths.choose_spec.1 none).1.steps tail
  | componentRefusedTerminal _ _ paths _ tail => exact append (paths.choose_spec.1 none).1.steps tail
  | componentRegistrationMismatch _ _ paths _ _ tail => exact append (paths.choose_spec.1 none).1.steps tail
  | componentAcceptedTerminal _ _ paths _ _ tail => exact append (paths.choose_spec.1 none).1.steps tail
  | componentReplyDisplaced _ _ _ paths _ tail => exact append (paths.choose_spec.1 none).1.steps tail
  | refused install _ _ _ _ => cases install <;> simp_all [PayloadPrefix.Cursor.control]
  | directGiveTrap cut _ _ _ => exact append (cut.paths.choose_spec.1 none).1.steps cut.residual
  | giveLookupMismatch _ cut _ _ _ _ _ _ => exact append (cut.paths.choose_spec.1 none).1.steps cut.residual
  | directGiveSelected _ _ cut _ _ _ _ _ => exact append (cut.paths.choose_spec.1 none).1.steps cut.residual
  | compilerRefused _ install _ _ _ _ _ _ _ _ => cases install <;> simp_all [PayloadPrefix.Cursor.control]
  | placementTrap _ install _ _ _ _ _ _ _ _ => cases install <;> simp_all [PayloadPrefix.Cursor.control]
  | body install _ _ => cases install <;> simp_all [PayloadPrefix.Cursor.control]
  | directGiveLateReply _ _ cut _ _ => exact append (cut.paths.choose_spec.1 none).1.steps cut.residual
  | directGiveFinite cut => exact (cut.paths.choose_spec.1 none).1.steps
  | allocator install _ _ _ _ _ => cases install <;> simp_all [PayloadPrefix.Cursor.control]
  | nonGrowing _ _ paths _ residual => exact append (paths.choose_spec.1 none).1.steps residual
  | pollTerminal paths _ _ _ _ residual => exact append (paths.choose_spec.1 none).1.steps residual
  | waitTerminal paths _ _ _ residual => exact append (paths.choose_spec.1 none).1.steps residual
  | cancelTerminal paths _ _ _ _ residual => exact append (paths.choose_spec.1 none).1.steps residual
  | cancelHookBody paths _ _ _ ending => exact append (paths.choose_spec.1 none).1.steps (callbackEndSteps ending)
  | cancelDecisionTerminal paths _ _ _ _ residual => exact append (paths.choose_spec.1 none).1.steps residual
  | cancelParked paths _ _ ending => exact append (paths.choose_spec.1 none).1.steps (callbackEndSteps ending)

private theorem callbackTerminalSlice {changes : ReturnFrame.Substitutions (core3 grow) (HostState sig)}
    (paired : HostFrame.Related.Paired changes start incoming)
    (ending : CallbackSliceEnd profile ready base bindings changes start incoming labels finish) :
    CallbackSlice profile ready base bindings changes start incoming labels finish :=
  ⟨[], [], _, start, incoming, rfl,
    ⟨.refl _, rfl, paired, CallbackPrefix.stationaryTransport (fun place => .done _ place) (fun place => .done _ place), WriterPaths.empty⟩,
    ending⟩

theorem prependCheckedOnlyReply {route : GiveEffectRoute} {destination ticket issue}
    {left right checkStop canonStop : Config (core3 grow) (HostState sig)}
    {checkPrefix canonPrefix checkBody canonBody trailing : Trace grow sig} {marks}
    (leading : OccurrenceTransport profile ready base bindings start incoming checkPrefix canonPrefix left right marks)
    (reply : CheckedOnlyGiveReply profile ready base bindings route destination ticket issue left right checkStop canonStop
      checkBody canonBody trailing finish) :
    CheckedOnlyGiveReply profile ready base bindings route destination ticket issue start incoming checkStop canonStop
      (checkPrefix ++ checkBody) (canonPrefix ++ canonBody) trailing finish := by
  obtain ⟨move, before, _⟩ := leading
  obtain ⟨suffix, checked, split, front, complete, tail, stored, recorded, framed, written, paths⟩ := reply
  refine ⟨suffix, checked, split, append (before none).1.steps front, complete, tail, stored, recorded, framed, written, fun place => ?_⟩
  obtain ⟨checkedMark, canonicalMark, checkPath, canonPath⟩ := paths (move place)
  exact ⟨checkedMark, canonicalMark,
    (List.append_assoc _ _ _).symm ▸ (before place).1.append checkPath, (before place).2.append canonPath⟩

theorem sliceInstalledCallback
    {first second : ReturnFrame.Continuation (core3 grow) (HostState sig)}
    {checkEntry canonEntry : Config (core3 grow) (HostState sig)} {checkCount canonCount : Nat}
    (installed : PairedAllocatorInstall profile ready base bindings older first second start incoming checkEntry canonEntry
      checkCount canonCount)
    (positive : 0 < checkCount) (run : Steps profile ready (specDispatch ready base) start labels finish)
    (compare : ShorterCallbackSlices profile ready base bindings labels.length) :
    InstalledCallbackSlice profile ready base bindings older first second checkEntry canonEntry checkCount labels finish := by
  rcases splitSilent installed.checkedRun run with ⟨residual, split, tail⟩ | inside
  · have smaller : residual.length < labels.length := by
      simp only [split, List.length_append, List.length_replicate]
      omega
    obtain ⟨checked, canonical, trailing, reached, peer, splitTail, segment, ending⟩ := compare smaller tail installed.paired
    exact .inr ⟨checked, canonical, trailing, reached, peer, by rw [split, splitTail, List.append_assoc], .executed segment, ending⟩
  · exact .inl inside

private theorem faultUnique {before : Config (core3 grow) (HostState sig)} {left right : String}
    (first : Fault before left) (second : Fault before right) : left = right := by
  cases first <;> cases second <;> simp_all
  all_goals
    have heads := (show (_ ∧ Prog.op (S := Eff (core3 grow) (HostState sig)) (α := Ret (core3 grow)) _ _ = Prog.op _ _ ∧ _) ∧ _
      from by assumption)
    obtain ⟨⟨_, programs, _⟩, _⟩ := heads
    exact (by cases (progOpEq programs).1 : False).elim

set_option maxHeartbeats 2000000 in
private theorem differentStepBranch {dispatch : Call (core3 grow) → Session grow sig (Ret (core3 grow))}
    {before left right : Config (core3 grow) (HostState sig)} {expected taken}
    (planned : Step profile ready dispatch before expected left) (actual : Step profile ready dispatch before taken right)
    (different : expected ≠ taken) : workerBranchLabel expected ∧ workerBranchLabel taken := by
  cases planned <;> cases actual
  case fault.fault =>
    rename_i first leftFault second rightFault
    have same := faultUnique leftFault rightFault
    subst second
    exact (different rfl).elim
  all_goals try (cases (show Fault before _ from by assumption))
  all_goals simp_all [workerBranchLabel, StepDefs.HostReadyCfg]
  all_goals
    have heads := (show (_ ∧ Prog.op (S := Eff (core3 grow) (HostState sig)) (α := Ret (core3 grow)) _ _ = Prog.op _ _ ∧ _) ∧ _
      from by assumption)
    obtain ⟨⟨_, programs, _⟩, _⟩ := heads
    obtain ⟨operation, continuation⟩ := progOpEq programs
    simp_all
  all_goals (injection operation; subst_vars; simp_all)

private theorem alignWorkerBody {dispatch : Call (core3 grow) → Session grow sig (Ret (core3 grow))}
    {before body finish : Config (core3 grow) (HostState sig)} {bodyLabels actual : Trace grow sig}
    (bodyRun : Steps profile ready dispatch before bodyLabels body)
    (checkedRun : Steps profile ready dispatch before actual finish) :
    WorkerBodyAlignment profile ready dispatch before body bodyLabels actual finish := by
  classical
  induction bodyRun generalizing actual with
  | refl => exact .reached rfl checkedRun
  | @cons before middle body expected rest planned bodyTail ih =>
    cases checkedRun with
    | refl => exact .inside rfl (List.cons_ne_nil _ _) (.cons planned bodyTail)
    | @cons _ actualNext _ taken suffix actualStep actualTail =>
      by_cases agree : expected = taken
      · subst taken
        cases labelledStepUnique planned actualStep
        cases ih actualTail with
        | reached split tail => exact .reached (congrArg (expected :: ·) split) tail
        | inside split nonempty remaining => exact .inside (congrArg (expected :: ·) split) nonempty remaining
        | departure bodySplit actualSplit shared different branch first afterFirst second afterSecond =>
          exact .departure (congrArg (expected :: ·) bodySplit) (congrArg (expected :: ·) actualSplit)
            (.cons planned shared) different branch first afterFirst second afterSecond
      · exact .departure (leading := []) rfl rfl (.refl _) agree (differentStepBranch planned actualStep agree)
          planned bodyTail actualStep actualTail

private theorem alignLocalBody {before target last : Config (core3 grow) (HostState sig)}
    {planned actual : Trace grow sig}
    (localRun : Steps profile ready (specDispatch ready base) before planned target)
    (actualRun : Steps profile ready (specDispatch ready base) before actual last)
    (notBranch : ∀ action ∈ planned, ¬ workerBranchLabel action) :
    LocalRunAlignment profile ready (specDispatch ready base) target planned actual last := by
  cases alignWorkerBody localRun actualRun with
  | reached split tail => exact .reached split tail
  | inside split nonempty tail => exact .inside split nonempty tail
  | departure split _ _ _ branch _ _ _ _ =>
    exact False.elim (notBranch _ (split ▸ List.mem_append_right _ (List.mem_cons_self ..)) branch.1)

private theorem noBranchOfVisible {raw observed : Trace grow sig} (seen : PayloadPrefix.visible raw = observed)
    (notBranch : ∀ action ∈ observed, ¬ workerBranchLabel action) :
    ∀ action ∈ raw, ¬ workerBranchLabel action := by
  intro action member branch
  apply notBranch action _ branch
  rw [← seen]
  apply List.mem_filter.mpr
  refine ⟨member, ?_⟩
  cases action <;> simp_all [workerBranchLabel]

open ReturnFrame.Occurrence in
private theorem pairedLeafPrefix {leftEnd rightEnd : Config (core3 grow) (HostState sig)}
    {planned remaining : Trace grow sig}
    (path : PairedLeafSteps profile ready (specDispatch ready base) (specDispatch ready (LiveDispatch.host bindings base))
      start incoming planned leftEnd rightEnd)
    (split : planned = labels ++ remaining) (run : Steps profile ready (specDispatch ready base) start labels finish) :
    ∃ peer, finish.store = peer.store ∧ finish.host = start.host ∧ peer.host = incoming.host ∧
      OccurrenceTransport profile ready base bindings start incoming labels labels finish peer ∧
      WriterPath profile ready (specDispatch ready base) start labels finish [] ∧
      WriterPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming labels peer [] := by
  induction run generalizing incoming planned with
  | refl state =>
    have same : state.store = incoming.store := by cases path <;> assumption
    exact ⟨incoming, same, rfl, rfl, CallbackPrefix.stationaryTransport (fun place => .done _ place) (fun place => .done _ place),
      .done state, .done incoming⟩
  | @cons before middle finish label labels step tail ih =>
    cases path with
    | done => simp at split
    | @step _ _ _ _ _ _ action _ same checked raw checkedHost rawHost checkedEdit agree rest =>
      obtain ⟨sameLabel, shorter⟩ := List.cons.inj split
      subst label
      cases labelledStepUnique step checked
      obtain ⟨peer, stores, leftHost, rightHost, ⟨move, paths, transported⟩, leftPath, rightPath⟩ := ih rest shorter
      let edit := transitionEdit before action
      refine ⟨peer, stores, leftHost.trans checkedHost, rightHost.trans rawHost, ⟨fun mark => move (mark.bind edit.follow), ?_, ?_⟩,
        .same step (congrArg HostState.writer checkedHost) leftPath, .same raw (congrArg HostState.writer rawHost) rightPath⟩
      · intro mark
        obtain ⟨lhs, rhs⟩ := paths (mark.bind edit.follow)
        exact ⟨.step step lhs, .step raw (by rw [agree]; exact rhs)⟩
      · intro older marks outside
        have moved := outside.edit edit
        have leftStorage := step_edit step
        have rightStorage := step_edit raw
        rw [agree] at rightStorage
        change _ = edit.apply _ at leftStorage rightStorage
        rw [← leftStorage, ← rightStorage] at moved
        simpa only [List.map_map, Function.comp_def] using transported older _ moved

theorem driveValueCommit {output : Stored.Lower.Output} {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    {checkNext : LinkedCallback.MemorySequence.ValueCheckNext grow sig output}
    {canonNext : LinkedCallback.MemorySequence.ValueCanonNext grow sig output}
    {published : LinkedCallback.MemorySequence.ValueFinish grow sig output}
    (commit : LiveValueCommit profile ready base bindings output checkNext canonNext published start incoming check canon)
    (actual : Steps profile ready (specDispatch ready base) start labels finish) :
    ValueCommitRun profile ready base bindings output checkNext canonNext published start incoming check canon labels finish := by
  obtain ⟨store, verdict, effects, shape, checked, _, path, movement, continues⟩ := commit
  refine ⟨store, verdict, effects, movement, path, alignLocalBody checked.steps actual (noBranchOfVisible (CallbackPrefix.visibleLeaf shape) ?_),
    fun value success => (continues value success).2.2⟩
  cases verdict <;> simp [workerBranchLabel]

private theorem silentVisible {trace : Trace grow sig} (silent : trace.all (· matches .tau) = true) :
    PayloadPrefix.visible trace = [] := by
  induction trace with
  | nil => rfl
  | cons label trace ih =>
    have main := List.all_eq_true.mp silent label List.mem_cons_self
    cases label <;> try contradiction
    apply ih
    exact List.all_eq_true.mpr fun next member => List.all_eq_true.mp silent next (List.mem_cons_of_mem _ member)

private theorem entryVisible {route : GiveEffectRoute}
    (entry : Transition profile ready base start (.give route .entered) labels finish) : PayloadPrefix.visible labels = [] := by
  cases entry with
  | giveEntry _ _ silent _ _ _ => exact silent
  | giveStopped _ _ _ _ _ _ stopped => cases stopped

private theorem visibleAppend (left right : Trace grow sig) :
    PayloadPrefix.visible (left ++ right) = PayloadPrefix.visible left ++ PayloadPrefix.visible right :=
  List.filter_append left right

private theorem visibleTauCons (labels : Trace grow sig) :
    PayloadPrefix.visible (.tau :: labels) = PayloadPrefix.visible labels := rfl

private theorem visibleTaus (count : Nat) :
    PayloadPrefix.visible (List.replicate count (.tau : Label (core3 grow) (HostState sig))) = [] := by
  induction count with
  | zero => rfl
  | succ count ih =>
    rw [List.replicate_succ]
    exact (visibleAppend [_] _).trans ih

open PayloadPrefix ReturnFrame.Occurrence in
private theorem driveStringSlice {cx : LiftLowerContext (core3 grow)}
    {checkNext canonNext : Nat → Session grow sig (Ret (core3 grow))}
    {check canon : Cursor (E := core3 grow) (HostState sig)} {length budget : Nat}
    {describe : Nat → Config (core3 grow) (HostState sig) → Config (core3 grow) (HostState sig) →
      Cursor (E := core3 grow) (HostState sig) → Cursor (E := core3 grow) (HostState sig) → Prop}
    (paths : LiveStringReplay profile ready base bindings older cx checkNext canonNext describe length start incoming check canon)
    (same : start.store = incoming.store)
    (actual : Steps profile ready (specDispatch ready base) start labels finish)
    (bounded : labels.length ≤ budget) (compare : ShorterCallbackSlices profile ready base bindings budget) :
    StringRunSliceWithWriters profile ready base bindings older describe start incoming labels finish := by
  classical
  induction length using Nat.strong_induction_on generalizing start incoming check canon labels with
  | ind length ih =>
    rw [LiveStringReplay] at paths
    obtain ⟨store, result, localLabels, observed, checked, _, path, localTrail, visit⟩ := paths
    have localOnly : ∀ action ∈ PayloadPrefix.visible localLabels, ¬ workerBranchLabel action := by
      rw [CallbackPrefix.visibleLeaf observed]
      cases result <;> simp [workerBranchLabel]
    cases alignLocalBody checked.steps actual (noBranchOfVisible rfl localOnly) with
    | inside split nonempty localTail =>
      obtain ⟨peer, same, _, _, movement, lhsEffects, rhsEffects⟩ := pairedLeafPrefix path split actual
      exact ⟨labels, labels, [], finish, peer, [], (List.append_nil _).symm, rfl, movement,
        same, .refl _, .framed lhsEffects rhsEffects, .localPrefix nonempty localTail⟩
    | @reached remaining split remainder =>
      obtain ⟨lhsEffects, rhsEffects⟩ := WriterPaths.frameLeaf path
      cases result with
      | error reason => exact ⟨localLabels, localLabels, remaining, _, _, [], split, rfl, localTrail, rfl,
          remainder, .framed lhsEffects rhsEffects, .trap rfl rfl⟩
      | ok front =>
        obtain ⟨_, _, visit⟩ := visit front rfl
        cases front with
        | done pointer => exact ⟨localLabels, localLabels, remaining, _, _, [], split, rfl, localTrail, rfl,
            remainder, .framed lhsEffects rhsEffects, .descriptor visit⟩
        | call pointer oldSize alignment size rest smaller =>
          have boundedLocal : remaining.length ≤ budget := by
            rw [split, List.length_append] at bounded
            omega
          rcases sliceInstalledCallback visit.1 (by decide) remainder
            (fun smaller run pair => compare (Nat.lt_of_lt_of_le smaller boundedLocal) run pair) with
            beforeInstall | ⟨checkCall, canonCall, trailing, reached, reference, installSplit, input, boundary⟩
          · have exhausted : remaining = [] := List.length_eq_zero_iff.mp (by omega)
            exact ⟨localLabels, localLabels, remaining, _, _, [], split, rfl, localTrail, rfl, remainder,
              .framed lhsEffects rhsEffects, .installPrefix exhausted⟩
          obtain ⟨checkProof, canonProof, referenceProof, mark, _, _, checkSeen, canonSeen, paired, _,
            tracked, movement, index, returns⟩ := visit.2 input
          change (checkCall, canonCall, reference) = (checkProof, canonProof, referenceProof) at index
          rcases Prod.mk.inj index with ⟨rfl, paths⟩
          rcases Prod.mk.inj paths with ⟨rfl, rfl⟩
          have installWriter := VisitorWriterPath.framed (base := base) (bindings := bindings)
            (WriterPaths.frameSingle visit.1.checkedRun rfl) (WriterPaths.frameSingle visit.1.canonicalRun rfl)
          have callbackWriter := by
            cases input with
            | executed segment => exact segment.writers
          have bodyWriter := installWriter.append callbackWriter
          have reachedRun := callbackEndSteps boundary
          have ending (stopped : trailing = [] ∨ mark ≠ some (.active 0 0) ∨ ¬ ∃ (value : Nat) (cursor : Cursor (E := core3 grow) (HostState sig)),
              reached.ctl = { cursor with frames := .prog (stringPlanResume cx rest checkNext) :: cursor.frames }.control (.pure (.nat value))) :
              StringRunSliceWithWriters profile ready base bindings older describe start incoming labels finish := by
            exact ⟨localLabels ++ .tau :: checkCall, localLabels ++ .tau :: canonCall, trailing, reached, reference,
              [mark], by rw [split, installSplit]; simp [List.append_assoc],
              by rw [visibleAppend, visibleAppend]; exact congrArg (PayloadPrefix.visible localLabels ++ ·) (canonSeen.trans checkSeen.symm),
              (CallbackPrefix.transportAppend localTrail movement).choose_spec.1, paired.data.1,
              reachedRun, .append (.framed lhsEffects rhsEffects) bodyWriter,
              .callback tracked paired boundary stopped⟩
          by_cases atTop : mark = some (.active 0 0)
          · by_cases returning : ∃ (value : Nat) (cursor : Cursor (E := core3 grow) (HostState sig)),
              reached.ctl = { cursor with frames := .prog (stringPlanResume cx rest checkNext) :: cursor.frames }.control (.pure (.nat value))
            · obtain ⟨value, cursor, focus⟩ := returning
              cases returningCallbackEndSteps boundary focus with
              | refl => exact ending (.inl rfl)
              | @cons _ next _ label residual first tail =>
                have pop : Step profile ready (specDispatch ready base) reached .tau
                    { reached with ctl := cursor.control (stringPlanResume cx rest checkNext (.nat value)) } := .popProg focus
                obtain ⟨rfl, rfl⟩ := silentStepUnique pop first
                obtain ⟨peer, _, _, transported, continued⟩ := returns value cursor atTop focus
                have rawPrefix := (movement.choose_spec.1 none).2.steps
                have rawThroughPop := (transported.choose_spec.1 none).2.steps
                have popRun := stripExactPrefix rawPrefix (by simpa only [List.cons_append] using rawThroughPop)
                have popWriter := VisitorWriterPath.framed (base := base) (bindings := bindings)
                  (.same pop rfl (.done _)) (WriterPaths.frameSingle popRun rfl)
                have smallerRun : residual.length < labels.length := by
                  rw [split, installSplit]
                  simp only [List.length_append, List.length_cons, List.length_replicate]
                  omega
                obtain ⟨checkLabels, canonLabels, trailing, reached, reference, marks, used, observed, travel, store, after, writer, ending⟩ :=
                  ih rest.length smaller continued paired.data.1 tail (Nat.le_trans (Nat.le_of_lt smallerRun) bounded)
                have movement := (CallbackPrefix.transportAppend
                  (CallbackPrefix.transportAppend localTrail transported).choose_spec.1 travel).choose_spec.1
                refine ⟨localLabels ++ (.tau :: checkCall ++ [.tau]) ++ checkLabels,
                  localLabels ++ (.tau :: canonCall ++ [.tau]) ++ canonLabels, trailing, reached, reference, marks,
                  ?_, ?_, by simpa only [List.map_nil, List.append_nil] using movement, store, after,
                  .append (.append (.framed lhsEffects rhsEffects) (by
                    simpa only [List.cons_append, List.nil_append] using bodyWriter.append popWriter)) writer, ending⟩
                · rw [split, installSplit, used]
                  simp only [List.replicate_succ, List.replicate_zero, List.append_assoc, List.cons_append, List.nil_append]
                · have quiet (trace : Trace grow sig) : PayloadPrefix.visible (.tau :: trace ++ [.tau]) = PayloadPrefix.visible trace := by
                    change PayloadPrefix.visible (trace ++ [.tau]) = PayloadPrefix.visible trace
                    rw [visibleAppend, show PayloadPrefix.visible ([.tau] : Trace grow sig) = [] from rfl, List.append_nil]
                  have view (middle next : Trace grow sig) :
                      PayloadPrefix.visible (localLabels ++ (.tau :: middle ++ [.tau]) ++ next) =
                        PayloadPrefix.visible localLabels ++ PayloadPrefix.visible middle ++ PayloadPrefix.visible next :=
                    (visibleAppend ..).trans (congrArg (· ++ PayloadPrefix.visible next)
                      ((visibleAppend ..).trans (congrArg (PayloadPrefix.visible localLabels ++ ·) (quiet middle))))
                  rw [view canonCall canonLabels, view checkCall checkLabels, canonSeen, checkSeen, observed]
            · exact ending (.inr (.inr returning))
          · exact ending (.inr (.inl atTop))

open PayloadPrefix ReturnFrame.Occurrence in
private theorem prefixReadWriters {target : Config (core3 grow) (HostState sig)} {planned remaining : Trace grow sig}
    (path : SilentLocalPath profile ready (specDispatch ready base) start planned target)
    (split : planned = labels ++ remaining) (run : Steps profile ready (specDispatch ready base) start labels finish) :
    finish.store = start.store ∧ visible labels = [] ∧
    (∀ place, Prefix profile ready (specDispatch ready base) start place labels finish place) ∧
    WriterPath profile ready (specDispatch ready base) start labels finish [] := by
  induction run generalizing planned with
  | refl => exact ⟨rfl, rfl, fun place => .done _ place, .done _⟩
  | cons step tail ih =>
    cases path with
    | done => simp at split
    | read read more =>
      simp only [List.cons_append, List.cons.injEq] at split
      obtain ⟨rfl, shorter⟩ := split
      cases (prefix_survives (read.tracks (.active 0 0))).1 with
      | cons actual empty =>
        cases empty
        cases labelledStepUnique step actual
        obtain ⟨store, quiet, tracks, writes⟩ := ih more shorter
        exact ⟨store.trans read.store.symm, quiet, fun place => (read.tracks place).append (tracks place),
          WriterPaths.append (WriterPaths.frameRead read) writes⟩

open PayloadPrefix ReturnFrame.Occurrence in
private theorem driveStringValueWithWriters {destination : RecordDestination} {inst : InstId} {key : LinkedCallback.StringField}
    {output : Stored.Lower.Output} {check canon : Cursor (E := core3 grow) (HostState sig)}
    {checkNext : LinkedCallback.MemorySequence.ValueCheckNext grow sig output}
    {canonNext : LinkedCallback.MemorySequence.ValueCanonNext grow sig output} {budget : Nat}
    {describe : Nat → Config (core3 grow) (HostState sig) → Config (core3 grow) (HostState sig) →
      Cursor (E := core3 grow) (HostState sig) → Cursor (E := core3 grow) (HostState sig) → Prop}
    (field : StringValueThen profile ready base bindings older destination inst key output start incoming check canon checkNext canonNext describe)
    (actual : Steps profile ready (specDispatch ready base) start labels finish)
    (bounded : labels.length ≤ budget) (compare : ShorterCallbackSlices profile ready base bindings budget) :
    StringRunSliceWithWriters profile ready base bindings older describe start incoming labels finish := by
  obtain ⟨checkEntry, canonEntry, checkQuiet, canonQuiet, entry, enterPeer, checkReads, canonReads, frame, body⟩ := field
  have same : start.store = incoming.store := frame.store
  cases alignWorkerBody (entry (.active 0 0)).toTrail.steps actual with
  | inside split nonempty localTail =>
    obtain ⟨stores, quiet, tracks, writer⟩ := prefixReadWriters checkReads split actual
    exact ⟨labels, [], [], finish, incoming, [], (List.append_nil _).symm, quiet.symm,
      CallbackPrefix.stationaryTransport tracks (fun place => .done incoming place),
      stores.trans same, .refl _, .framed writer (.done _), .localPrefix nonempty localTail⟩
  | departure planned split shared _ branch _ _ step tail =>
    obtain ⟨stores, quiet, tracks, writer⟩ := prefixReadWriters checkReads planned shared
    exact ⟨_, [], _, _, incoming, [], split, quiet.symm,
      CallbackPrefix.stationaryTransport tracks (fun place => .done incoming place),
      stores.trans same, .cons step tail, .framed writer (.done _), .localChoice rfl branch.2 (.refl _) step tail⟩
  | @reached remaining split remainder =>
    have shorter : remaining.length ≤ budget := by rw [split, List.length_append] at bounded; omega
    obtain ⟨checked, canonical, trailing, reached, peer, marks, used, observed, traces, same, tail, writer, ending⟩ :=
      driveStringSlice body frame.store remainder shorter compare
    have entryPath := CallbackPrefix.stationaryTransport (base := base) (bindings := bindings) entry enterPeer
    exact ⟨checkEntry ++ checked, canonEntry ++ canonical, trailing, reached, peer, marks,
      by rw [split, used, List.append_assoc],
      by rw [visibleAppend, visibleAppend, checkQuiet, canonQuiet, observed],
      by simpa only [List.map_nil, List.append_nil] using
        (CallbackPrefix.transportAppend entryPath traces).choose_spec.1,
      same, tail, .append (.framed (WriterPaths.frameReads checkReads) (WriterPaths.frameReads canonReads)) writer, ending⟩

open PayloadPrefix in
theorem driveStringValue {destination : RecordDestination} {inst : InstId} {key : LinkedCallback.StringField}
    {output : Stored.Lower.Output} {check canon : Cursor (E := core3 grow) (HostState sig)}
    {checkNext : LinkedCallback.MemorySequence.ValueCheckNext grow sig output}
    {canonNext : LinkedCallback.MemorySequence.ValueCanonNext grow sig output} {budget : Nat}
    {describe : Nat → Config (core3 grow) (HostState sig) → Config (core3 grow) (HostState sig) →
      Cursor (E := core3 grow) (HostState sig) → Cursor (E := core3 grow) (HostState sig) → Prop}
    (field : StringValueThen profile ready base bindings older destination inst key output start incoming check canon checkNext canonNext describe)
    (actual : Steps profile ready (specDispatch ready base) start labels finish)
    (bounded : labels.length ≤ budget) (compare : ShorterCallbackSlices profile ready base bindings budget) :
    StringRunSlice profile ready base bindings older describe start incoming labels finish := by
  obtain ⟨checked, canonical, trailing, reached, peer, marks, used, observed, traces, same, tail, _, ending⟩ :=
    driveStringValueWithWriters field actual bounded compare
  exact ⟨checked, canonical, trailing, reached, peer, marks, used, observed, traces, same, tail, ending⟩

open PayloadPrefix ReturnFrame.Occurrence in
private theorem driveStringCommitWithWriters {destination : RecordDestination} {inst : InstId} {key : LinkedCallback.StringField}
    {output : Stored.Lower.Output} {check canon : Cursor (E := core3 grow) (HostState sig)}
    {checkNext : LinkedCallback.MemorySequence.ValueCheckNext grow sig output}
    {canonNext : LinkedCallback.MemorySequence.ValueCanonNext grow sig output} {budget : Nat}
    {published : LinkedCallback.MemorySequence.ValueFinish grow sig output}
    (field : StringValueThen profile ready base bindings older destination inst key output start incoming check canon checkNext canonNext
      (fun _ => LiveValueCommit profile ready base bindings output checkNext canonNext published))
    (actual : Steps profile ready (specDispatch ready base) start labels finish)
    (bounded : labels.length ≤ budget) (compare : ShorterCallbackSlices profile ready base bindings budget) :
    StringRunSliceWithWriters profile ready base bindings older
      (fun _ lhs rhs cursor peer => ∃ value, published value lhs rhs cursor peer) start incoming labels finish := by
  obtain ⟨checked, canonical, trailing, reached, reference, marks, split, observed, movement, same, remainder, writer, ending⟩ :=
    driveStringValueWithWriters field actual bounded compare
  have stop (stopped : StringSliceEnd profile ready base bindings older
      (fun _ lhs rhs cursor peer => ∃ value, published value lhs rhs cursor peer) reached reference trailing finish marks) :
      StringRunSliceWithWriters profile ready base bindings older (fun _ lhs rhs cursor peer => ∃ value, published value lhs rhs cursor peer)
        start incoming labels finish :=
    ⟨checked, canonical, trailing, reached, reference, marks, split, observed, movement, same, remainder, writer, stopped⟩
  cases ending with
  | localPrefix nonempty tail => exact stop (.localPrefix nonempty tail)
  | localChoice split choice shared step tail => exact stop (.localChoice split choice shared step tail)
  | installPrefix exhausted => exact stop (.installPrefix exhausted)
  | collectionInstall exhausted => exact stop (.collectionInstall exhausted)
  | collectionRange nonempty tail => exact stop (.collectionRange nonempty tail)
  | callback mark paired ending noPop => exact stop (.callback mark paired ending noPop)
  | trap checked canonical => exact stop (.trap checked canonical)
  | @descriptor pointer cursor peer commit =>
    obtain ⟨store, verdict, effects, writes, path, aligned, continues⟩ := driveValueCommit commit remainder
    cases aligned with
    | inside planned nonempty tail =>
      obtain ⟨peer, same, _, _, prefixPath, lhsEffects, rhsEffects⟩ := pairedLeafPrefix path planned remainder
      refine ⟨checked ++ trailing, canonical ++ trailing, [], finish, peer, [], ?_, ?_, ?_, same, .refl _,
        .append writer (.framed lhsEffects rhsEffects), .localPrefix nonempty tail⟩
      · simpa only [List.append_nil] using split
      · rw [visibleAppend, visibleAppend, observed]
      · simpa only [List.nil_append, List.map_nil] using (CallbackPrefix.transportAppend movement prefixPath).choose_spec.1
    | @reached suffix used tail =>
      have reachedWrites := (CallbackPrefix.transportAppend movement writes).choose_spec.1
      obtain ⟨lhsEffects, rhsEffects⟩ := WriterPaths.frameLeaf path
      refine ⟨checked ++ effects, canonical ++ effects, suffix, _, _, [],
        by rw [split, used, List.append_assoc],
        by rw [visibleAppend, visibleAppend, observed],
        by simpa only [List.nil_append, List.map_nil] using reachedWrites, ?_, tail,
        .append writer (.framed lhsEffects rhsEffects), ?_⟩
      · cases verdict <;> rfl
      · cases verdict with
        | error reason => exact .trap rfl rfl
        | ok value => exact .descriptor (pointer := pointer) ⟨value, continues value rfl⟩

open PayloadPrefix in
theorem driveStringCommit {destination : RecordDestination} {inst : InstId} {key : LinkedCallback.StringField}
    {output : Stored.Lower.Output} {check canon : Cursor (E := core3 grow) (HostState sig)}
    {checkNext : LinkedCallback.MemorySequence.ValueCheckNext grow sig output}
    {canonNext : LinkedCallback.MemorySequence.ValueCanonNext grow sig output} {budget : Nat}
    {published : LinkedCallback.MemorySequence.ValueFinish grow sig output}
    (field : StringValueThen profile ready base bindings older destination inst key output start incoming check canon checkNext canonNext
      (fun _ => LiveValueCommit profile ready base bindings output checkNext canonNext published))
    (actual : Steps profile ready (specDispatch ready base) start labels finish)
    (bounded : labels.length ≤ budget) (compare : ShorterCallbackSlices profile ready base bindings budget) :
    StringRunSlice profile ready base bindings older
      (fun _ lhs rhs cursor peer => ∃ value, published value lhs rhs cursor peer) start incoming labels finish := by
  obtain ⟨checked, canonical, trailing, reached, peer, marks, split, seen, tracks, stores, tail, _, ending⟩ :=
    driveStringCommitWithWriters field actual bounded compare
  exact ⟨checked, canonical, trailing, reached, peer, marks, split, seen, tracks, stores, tail, ending⟩

private theorem mapStringEnd
    {first second : Nat → Config (core3 grow) (HostState sig) → Config (core3 grow) (HostState sig) →
      PayloadPrefix.Cursor (E := core3 grow) (HostState sig) → PayloadPrefix.Cursor (E := core3 grow) (HostState sig) → Prop}
    {trailing : Trace grow sig} {marks}
    (map : ∀ pointer check canon, first pointer start incoming check canon → second pointer start incoming check canon)
    (ending : StringSliceEnd profile ready base bindings older first start incoming trailing finish marks) :
    StringSliceEnd profile ready base bindings older second start incoming trailing finish marks := by
  cases ending with
  | descriptor reached => exact .descriptor (map _ _ _ reached)
  | trap left right => exact .trap left right
  | localPrefix nonempty tail => exact .localPrefix nonempty tail
  | localChoice split choice shared step tail => exact .localChoice split choice shared step tail
  | installPrefix exhausted => exact .installPrefix exhausted
  | collectionInstall exhausted => exact .collectionInstall exhausted
  | collectionRange nonempty tail => exact .collectionRange nonempty tail
  | callback tracked paired terminal notPopped => exact .callback tracked paired terminal notPopped

open PayloadPrefix ReturnFrame.Occurrence in
private theorem pairedLocalStartStore {left right leftEnd rightEnd : Config (core3 grow) (HostState sig)}
    {checked canonical : Trace grow sig}
    (path : PairedLocalPath profile ready (specDispatch ready base) (specDispatch ready (LiveDispatch.host bindings base))
      left right checked canonical leftEnd rightEnd) : left.store = right.store := by
  induction path with
  | done same | step same _ _ _ _ _ _ _ => exact same
  | checkedRead read _ ih => exact read.store.trans ih
  | canonicalRead read _ ih => exact ih.trans read.store.symm

open PayloadPrefix ReturnFrame.Occurrence in
theorem pairedLocalPrefix {planned reference remaining : Trace grow sig}
    {leftEnd rightEnd : Config (core3 grow) (HostState sig)}
    (path : PairedLocalPath profile ready (specDispatch ready base) (specDispatch ready (LiveDispatch.host bindings base))
      start incoming planned reference leftEnd rightEnd)
    (split : planned = labels ++ remaining) (run : Steps profile ready (specDispatch ready base) start labels finish) :
    ∃ used peer, finish.store = peer.store ∧ visible labels = visible used ∧
      finish.host = start.host ∧ peer.host = incoming.host ∧
      OccurrenceTransport profile ready base bindings start incoming labels used finish peer ∧
      WriterPath profile ready (specDispatch ready base) start labels finish [] ∧
      WriterPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming used peer [] := by
  have stopped {left right : Config (core3 grow) (HostState sig)} (same : left.store = right.store) :
      ∃ used peer, left.store = peer.store ∧ visible ([] : Trace grow sig) = visible used ∧
        left.host = left.host ∧ peer.host = right.host ∧
        OccurrenceTransport profile ready base bindings left right [] used left peer ∧
        WriterPath profile ready (specDispatch ready base) left [] left [] ∧
        WriterPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) right used peer [] :=
    ⟨[], right, same, rfl, rfl, rfl, CallbackPrefix.stationaryTransport (fun place => .done _ place) (fun place => .done _ place), .done _, .done _⟩
  induction path generalizing labels remaining with
  | done same =>
    cases run with
    | refl => exact stopped same
    | cons => simp at split
  | @checkedRead left middle right checked canonical after reached read path ih =>
    cases run with
    | refl => exact stopped (read.store.trans (pairedLocalStartStore path))
    | cons step run =>
      obtain ⟨sameLabel, rest⟩ := List.cons.inj split
      subst sameLabel
      obtain ⟨taken, _⟩ := prefix_survives (read.tracks (.active 0 0))
      cases taken with
      | cons first empty =>
        cases empty
        cases labelledStepUnique step first
        obtain ⟨used, peer, same, seen, leftHost, rightHost, movement, lhs, rhs⟩ := ih rest run
        have front := CallbackPrefix.stationaryTransport (base := base) (bindings := bindings) read.tracks (fun place => .done right place)
        exact ⟨used, peer, same, seen, leftHost.trans read.host, rightHost,
          by simpa only [List.cons_append, List.nil_append, List.map_nil] using (CallbackPrefix.transportAppend front movement).choose_spec.1,
          WriterPaths.append (WriterPaths.frameRead read) lhs, rhs⟩
  | @canonicalRead left right middle checked canonical after reached read path ih =>
    cases labels with
    | nil =>
      cases run
      exact stopped ((pairedLocalStartStore path).trans read.store.symm)
    | cons label labels =>
      obtain ⟨used, peer, same, seen, leftHost, rightHost, movement, lhs, rhs⟩ := ih split run
      have front := CallbackPrefix.stationaryTransport (base := base) (bindings := bindings) (fun place => .done left place) read.tracks
      exact ⟨.tau :: used, peer, same, seen, leftHost, rightHost.trans read.host,
        by simpa only [List.cons_append, List.nil_append, List.map_nil] using (CallbackPrefix.transportAppend front movement).choose_spec.1,
        lhs, WriterPaths.append (WriterPaths.frameRead read) rhs⟩
  | @step left right middle rawMiddle _ _ label checked canonical same leftStep rightStep leftFrame rightFrame edit path ih =>
    cases run with
    | refl => exact stopped same
    | cons step run =>
      obtain ⟨sameLabel, rest⟩ := List.cons.inj split
      subst sameLabel
      cases labelledStepUnique step leftStep
      obtain ⟨used, peer, store, seen, leftHost, rightHost, ⟨move, paths, transported⟩, lhs, rhs⟩ := ih rest run
      refine ⟨label :: used, peer, store, ?_, leftHost.trans leftFrame, rightHost.trans rightFrame,
        ⟨fun mark => move (mark.bind (transitionEdit left label).follow), ?_, ?_⟩,
        .same step (congrArg HostState.writer leftFrame) lhs, .same rightStep (congrArg HostState.writer rightFrame) rhs⟩
      · change visible ([label] ++ _) = visible ([label] ++ _)
        rw [visibleAppend, visibleAppend, seen]
      · intro mark
        obtain ⟨lhs, rhs⟩ := paths (mark.bind (transitionEdit left label).follow)
        exact ⟨.step step lhs, .step rightStep (by rw [edit]; exact rhs)⟩
      · intro older marks outside
        have moved := outside.edit (transitionEdit left label)
        have leftStorage := step_edit step
        have rightStorage := step_edit rightStep
        rw [edit] at rightStorage
        rw [← leftStorage, ← rightStorage] at moved
        simpa only [List.map_map, Function.comp_def] using transported older _ moved

