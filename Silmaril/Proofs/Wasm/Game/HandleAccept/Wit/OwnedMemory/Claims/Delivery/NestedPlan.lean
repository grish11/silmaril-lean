private def sharedRecordPreAllocationIssue (index : Nat) : RecordLower.Issue → RecordLower.Issue
  | .preflight issue => .field index (.beforeAllocation issue)
  | issue => .nested index issue

open Stored.Endpoints in
private def sharedRecordBeforeAllocation (cx : LiftLowerContext (core3 grow)) (width : AddrType)
    (element : Stored.TypeOf) (entries : List RecordLower.Field) (index dest : Nat) :
    Except RecordLower.Issue Unit → Session grow sig (Except RecordLower.Issue Unit)
  | .error issue => pure (.error (sharedRecordPreAllocationIssue index issue))
  | .ok () => sharedRecordAllocate cx width element entries index dest

open Stored.OwnedMemory.Claims Stored.Endpoints in
private theorem sharedRecordCollectionCode (cx : LiftLowerContext (core3 grow)) (width : AddrType)
    (type element : Stored.TypeOf) (entries : List RecordLower.Field) (index dest : Nat)
    (next : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow))) :
    (RecordLower.Internal.runField Limits.spec Quirks.none cx (Record.authority recordClaims Limits.spec cx)
      width (.dynamic type element entries) index (.memory dest) >>= next) =
    .op .get (fun store => .op .hostGet fun state =>
      sharedRecordBeforeAllocation cx width element entries index dest
        (Record.prepare store state.writer (RecordLower.Field.listObjects entries)) >>= next) := by
  let plan := RecordLower.Field.listObjects entries
  let prepare : Session grow sig (Except RecordLower.Issue Unit) :=
    (Record.authority recordClaims Limits.spec cx).prepare plan
  let checked := sharedRecordBeforeAllocation (sig := sig) cx width element entries index dest
  have program : (RecordLower.Internal.runField Limits.spec Quirks.none cx (Record.authority recordClaims Limits.spec cx)
      width (.dynamic type element entries) index (.memory dest) : Session grow sig (Except RecordLower.Issue Unit)) =
      prepare.bind checked := by
    simp only [RecordLower.Internal.runField, Prog.bind_eq]
    refine congrArg prepare.bind (funext fun result => ?_)
    cases result with
    | error issue => cases issue <;> rfl
    | ok result => cases result; rfl
  rw [program]
  change (prepare.bind checked).bind next = _
  rw [Prog.bind_assoc]
  rfl

open Stored.Endpoints in
private theorem sharedRecordAllocatorCode (cx : LiftLowerContext (core3 grow)) (width : AddrType)
    (element : Stored.TypeOf) (entries : List RecordLower.Field) (index dest : Nat)
    (next : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow))) :
    (sharedRecordAllocate cx width element entries index dest >>= next) =
      .op (.call (.reallocate cx 0 0 (ABI.layout width element).alignment.bytes (entries.length * (ABI.layout width element).size)))
        (sharedRecordAllocationResume cx width element entries index dest next) := by
  let area := ABI.layout width element
  let call : Call (core3 grow) := .reallocate cx 0 0 area.alignment.bytes (entries.length * area.size)
  let read (result : Ret (core3 grow)) : Session grow sig Nat := match result with
    | .nat ptr => pure ptr
    | _ => internal "late-bound call: expected Ret.nat"
  have callCode : (callNat call : Session grow sig Nat) = .op (.call call) read := by
    simp [callNat, callRet, perform, Prog.lift, bind, Prog.bind, read]
    refine congrArg (Prog.op (S := Eff (core3 grow) (HostState sig)) (.call call)) (funext fun result => ?_)
    cases result <;> rfl
  unfold sharedRecordAllocate ListLower.allocateRange allocateListRange allocate reallocate
  rw [callCode]
  simp only [Prog.bind_eq, Prog.bind_assoc]
  change Prog.op (S := Eff (core3 grow) (HostState sig)) (.call call) (fun result => (read result).bind fun ptr =>
    (validateListRange cx area entries.length ptr).bind fun address =>
      (sharedRecordAllocated cx width element entries index dest address).bind next) = _
  refine congrArg (Prog.op (S := Eff (core3 grow) (HostState sig)) (.call call)) (funext fun result => ?_)
  cases result <;> try rfl
  all_goals
    change Prog.op (S := Eff (core3 grow) (HostState sig)) (.trap (.internal "late-bound call: expected Ret.nat")) _ =
      Prog.op (S := Eff (core3 grow) (HostState sig)) (.trap (.internal "late-bound call: expected Ret.nat")) _
    congr 1
    funext impossible
    cases impossible

open ReturnFrame.Occurrence Stored.OwnedMemory.Claims Stored.Endpoints in
private theorem crossDestructorRecordPrepare {limit : Nat}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    (plan : List RecordLower.Object)
    (checkedNext canonicalNext : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow)))
    (onRead : ∀ result, DestructorRecordAt (check := check) (canon := canon) profile ready base bindings older limit finish
      (checkedNext result) (canonicalNext result)) :
    DestructorRecordAt (check := check) (canon := canon) profile ready base bindings older limit finish
      (.op .get (fun store => .op .hostGet fun state => checkedNext (Record.prepare store state.writer plan)))
      (.op .get (fun store => .op .hostGet fun state => canonicalNext (Record.prepare store state.writer plan))) := by
  classical
  intro left right labels stores checked canonical scheduler run bounded
  let leftRead := { left with ctl := check.control (.op .hostGet
    (fun state => checkedNext (Record.prepare left.store state.writer plan))) }
  let rightRead := { right with ctl := canon.control (.op .hostGet
    (fun state => canonicalNext (Record.prepare right.store state.writer plan))) }
  let leftResult := Record.prepare left.store left.host.writer plan
  let rightResult := Record.prepare right.store right.host.writer plan
  let reached := { leftRead with ctl := check.control (checkedNext leftResult) }
  let peer := { rightRead with ctl := canon.control (canonicalNext rightResult) }
  have leftGet : Step profile ready (specDispatch ready base) left .tau leftRead := .get checked
  have rightGet : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) right .tau rightRead := .get canonical
  have leftProbe : Step profile ready (specDispatch ready base) leftRead .tau reached :=
    .hostGet (th := check.thread) (segs := check.frames) (rest := check.rest)
      (k := fun state => checkedNext (Record.prepare left.store state.writer plan)) rfl
  have rightProbe : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) rightRead .tau peer :=
    .hostGet (th := canon.thread) (segs := canon.frames) (rest := canon.rest)
      (k := fun state => canonicalNext (Record.prepare right.store state.writer plan)) rfl
  have lhs : FramedQuietPath profile ready (specDispatch ready base) check left [id, id] reached :=
    .step leftGet (by rw [transitionEdit, checked]; rfl) rfl (.step leftProbe rfl rfl .done)
  have rhs : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon right [id, id] peer :=
    .step rightGet (by rw [transitionEdit, canonical]; rfl) rfl (.step rightProbe rfl rfl .done)
  rcases splitSilent (count := 2) (.cons leftGet (.cons leftProbe (.refl _))) run with ⟨suffix, used, residual⟩ | short
  · rw [used]
    by_cases agrees : leftResult = rightResult
    · have paths := CallbackPrefix.stationaryTransport (bindings := bindings) lhs.1.track rhs.1.track
      refine .destructorPrefix paths (.framed lhs.2 rhs.2) (fun aligned => aligned) ?_
      exact onRead leftResult stores rfl (congrArg (fun result => canon.control (canonicalNext result)) agrees.symm)
        scheduler residual (by rw [used, List.length_append, List.length_replicate] at bounded; omega)
    · have mismatch : SharedRecordPrepareMismatch leftRead rightRead reached peer plan check canon :=
        ⟨checkedNext, canonicalNext, stores, rfl, rfl, rfl, rfl, agrees⟩
      have readStores := sharedSchedulerTransport (bindings := bindings) (edit := .same) leftGet rightGet
        (by rw [transitionEdit, checked]; rfl) (by rw [transitionEdit, canonical]; rfl)
      have readWriters := frameCalloutStep readStores rfl rfl
      have readClaims := sharedSchedulerTransport (bindings := bindings) (edit := .same) leftProbe rightProbe rfl rfl
      exact .destructorPrefix (leading := [.tau]) readStores readWriters (fun aligned => aligned)
        (.sharedRecordPrepareMismatch mismatch readClaims
          (.sharedRecordPrepare mismatch (.same leftProbe rfl (.done _)) (.same rightProbe rfl (.done _))) residual)
  · exact finishDestructorFramedCut lhs rhs run (by simp only [List.length_cons, List.length_nil]; omega)

private def sharedRecordAllocatorSelect (cx : LiftLowerContext (core3 grow)) :
    Session grow sig (AddrType × (core3 grow).FuncAddr) := do
  let width ← ptrType cx
  let callee ← orTrap (.internal "reallocate: realloc option missing") cx.opts.realloc
  return (width, callee)

private def sharedRecordAllocatorConfine (cx : LiftLowerContext (core3 grow)) : Session grow sig Unit := do
  let thread ← currentThread
  trapIf (!(← getInst cx.inst).mayLeave) .cannotLeave
  modifyInst cx.inst (LiftSt.setMayLeave false thread)
  modifyStore LiftSt.incNestingSt

private def sharedRecordAllocatorTask (cx : LiftLowerContext (core3 grow)) (width : AddrType) (caller : CallerId) : Task (core3 grow) :=
  { ft := reallocType width, opts := {}, inst := cx.inst, caller }

private def sharedRecordAllocatorSetup (cx : LiftLowerContext (core3 grow)) (request : ABI.ReallocRequest) :
    Session grow sig ((core3 grow).FuncAddr × TaskId × CallerId) := do
  let (width, callee) ← sharedRecordAllocatorSelect cx
  let caller ← allocObj ArenaField.callers (Caller.sub (.realloc (sharedRecordAllocatorArgs width request) none) : Caller (core3 grow))
  sharedRecordAllocatorConfine cx
  let task ← allocObj ArenaField.tasks (sharedRecordAllocatorTask cx width caller)
  return (callee, task, caller)

private theorem sharedRecordAllocatorSelectEffects (cx : LiftLowerContext (core3 grow)) :
    StoreEffects (sharedRecordAllocatorSelect cx : Session grow sig _) :=
  (storeEffectPtrType cx).bind fun _ => (storeEffectOrTrap _ _).bind fun _ => .pure _

private theorem sharedRecordAllocatorConfineEffects (cx : LiftLowerContext (core3 grow)) :
    StoreEffects (sharedRecordAllocatorConfine cx : Session grow sig Unit) := by
  have readThread : StoreEffects (currentThread : Session grow sig (Option ThreadId)) := .op rfl fun thread => .pure thread
  unfold sharedRecordAllocatorConfine
  refine readThread.bind fun thread => (storeEffectGetObject ArenaField.insts cx.inst).bind fun inst => ?_
  exact (storeEffectTrapIf (!inst.mayLeave) .cannotLeave).bind fun _ =>
    (storeEffectModify _).bind fun _ => storeEffectModify _

private theorem sharedRecordAllocatorConfinePreserves (cx : LiftLowerContext (core3 grow)) (caller : CallerId)
    (entry : Caller (core3 grow)) :
    Prog.Every (storePreserves (fun store => ArenaField.callers.get? store caller = some entry))
      (sharedRecordAllocatorConfine cx : Session grow sig Unit) := by
  let retained (store : CStore (core3 grow)) := ArenaField.callers.get? store caller = some entry
  have readThread : Prog.Every (storePreserves retained) (currentThread : Session grow sig (Option ThreadId)) :=
    .op trivial fun _ => .pure _
  have readInstance : Prog.Every (storePreserves retained) (getInst cx.inst : Session grow sig InstState) := by
    unfold getInst getObj
    refine (show Prog.Every (storePreserves retained) (getStore : Session grow sig _) from
      .op trivial fun _ => .pure _).bind fun _ => ?_
    split
    · exact .pure _
    · exact .op trivial (fun impossible => nomatch impossible)
  have guard (denied : Bool) : Prog.Every (storePreserves retained) (trapIf denied .cannotLeave : Session grow sig Unit) := by
    cases denied
    · exact .pure ()
    · exact .op trivial (fun impossible => nomatch impossible)
  unfold sharedRecordAllocatorConfine
  refine readThread.bind fun _ => readInstance.bind fun inst => (guard (!inst.mayLeave)).bind fun _ => ?_
  exact .op (fun _ proof => proof) (fun _ => .op (fun _ proof => proof) (fun answer => .pure answer))

private theorem crossSharedRecordArenaAlloc {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    {Id Data : Type} (field : ArenaField (core3 grow) Id Data) (entry : Data)
    (next : Id → Session grow sig (Ret (core3 grow)))
    (stores : start.store = incoming.store)
    (checked : start.ctl = check.control (allocObj field entry >>= next))
    (canonical : incoming.ctl = canon.control (allocObj field entry >>= next))
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (continueAt : ∀ {remaining}, let allocation := field.alloc start.store entry
      let reached := { start with store := allocation.1, ctl := check.control (next allocation.2) }
      let peer := { incoming with store := allocation.1, ctl := canon.control (next allocation.2) }
      Steps profile ready (specDispatch ready base) reached remaining finish →
      CallbackSliceEnd profile ready base bindings older reached peer remaining finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  obtain ⟨leading, remaining, reached, peer, split, paths, writers, residual, ending⟩ :=
    cutSharedQuietWorker (sharedDestructorAllocationPath check field entry next checked)
      (by simpa only [← stores] using (sharedDestructorAllocationPath (start := incoming) canon field entry next canonical)) run
  rw [split]
  rcases ending with empty | ⟨rfl, rfl⟩
  · subst remaining
    cases residual
    exact .comparedPrefix paths writers .exhausted
  · exact .destructorPrefix paths writers (fun aligned => aligned) (continueAt residual)

private theorem sharedRecordAllocatorSourceFrame {cx : LiftLowerContext (core3 grow)} {request width task caller}
    {previous reached : CStore (core3 grow)} (source : SharedRecordAllocatorSource cx request width task caller previous)
    (tasks : ArenaField.tasks.get? reached task = ArenaField.tasks.get? previous task)
    (callers : ArenaField.callers.get? reached caller = ArenaField.callers.get? previous caller) :
    SharedRecordAllocatorSource cx request width task caller reached :=
  ⟨by rw [tasks]; exact source.taskEntry, callers.trans source.callerEntry⟩

private theorem sharedRecordAllocatorSetupCode (cx : LiftLowerContext (core3 grow)) (request : ABI.ReallocRequest) :
    (reallocProg Limits.spec Quirks.none cx request.oldPtr request.oldSize request.alignment request.newSize :
      Session grow sig (Ret (core3 grow))) =
    (sharedRecordAllocatorSetup cx request >>= fun (callee, task, caller) =>
      .op (.newThread (.liftImplicit task callee)) (sharedRecordAllocatorAfterThread cx task caller)) := by
  have entered (callee : (core3 grow).FuncAddr) (task : TaskId) (caller : CallerId) :
      ((newThread (.liftImplicit task callee) : Session grow sig ThreadId) >>= fun worker => do
        Thread.resume worker
        callUnit (.loop (.syncLiftLoop task))
        pure (Ret.cancel (.task task) : Ret (core3 grow))) >>= (fun _ => sharedRecordAllocatorResult cx caller) =
      .op (.newThread (.liftImplicit task callee)) (sharedRecordAllocatorAfterThread cx task caller) := by
    simp only [Prog.bind_eq, Prog.bind_assoc, Prog.pure_eq, Prog.pure_bind']
    rfl
  simp [reallocProg, sharedRecordAllocatorSetup, sharedRecordAllocatorSelect, sharedRecordAllocatorConfine,
    sharedRecordAllocatorArgs, sharedRecordAllocatorTask, canonLift, reallocType, Prog.bind_assoc,
    sharedRecordAllocatorResult, ← entered]
  iterate 15 (congr 1; funext)
  rename_i record
  cases record <;> try rfl
  rename_i sub
  cases sub <;> try rfl
  rename_i result
  cases result with
  | none => rfl
  | some value => cases value <;> rfl


open ReturnFrame.Occurrence in
private theorem sharedRecordAllocatorOnStartPath {impl : HostImpl (core3 grow) (HostState sig)}
    (caller : CallerId) (cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)) (args : List Value.Val)
    (focus : start.ctl = cursor.control (specDispatch ready impl (.onStart caller)))
    (found : ArenaField.callers.get? start.store caller = some (.sub (.realloc args none))) :
    FramedQuietPath profile ready (specDispatch ready impl) cursor start [id, id]
      { start with ctl := cursor.control (.pure (.vals args)) } := by
  rw [sharedDestructorCallerStartSource, sharedArenaReaderCode] at focus
  refine .get focus (body := onStartProg caller) ?_ ?_
  · simp only [sharedArenaReader, found, sharedDestructorCallerStartFromRecord]
  have inner : (onStartProg caller : Session grow sig (Ret (core3 grow))) =
      .op .get (sharedArenaReader ArenaField.callers caller (sharedDestructorInnerStartFromRecord caller)) := by
    rw [sharedDestructorInnerStartSource, sharedArenaReaderCode]
  refine .get (congrArg cursor.control inner) ?_ .done
  simp only [sharedArenaReader, found, sharedDestructorInnerStartFromRecord]

private theorem sharedRecordAllocatorSourceStart {cx : LiftLowerContext (core3 grow)} {request width task caller}
    {store : CStore (core3 grow)} (source : SharedRecordAllocatorSource cx request width task caller store) :
    SharedRecordAllocatorSource cx request width task caller (CStore.setTaskState task .started store) := by
  obtain ⟨entry, found, typeAt, optionsAt, instanceAt, callerAt⟩ := source.taskEntry
  refine ⟨⟨entry.withState .started, ?_, typeAt, optionsAt, instanceAt, callerAt⟩, source.callerEntry⟩
  rw [CStore.setTaskState, ArenaField.get?_modify_self, found]
  rfl

private theorem sharedRecordAllocatorFlatArgumentCode (cx : LiftLowerContext (core3 grow)) (width : AddrType)
    (request : ABI.ReallocRequest) :
    (lowerFlatValues Limits.spec Quirks.none cx ABI.maxFlatParams (sharedRecordAllocatorArgs width request)
      (paramTypes (reallocType width)) none : Session grow sig (List FlatValue)) =
    .op .get (fun _ => .pure (sharedRecordAllocatorFlatArgs width request)) := by
  unfold lowerFlatValues ptrType
  simp [gets, getStore, perform, Prog.lift, bind, Prog.bind]
  congr 1
  funext store
  change CStore (core3 grow) at store
  generalize ptrTypeIn store cx = address
  have fits : ¬ ABI.maxFlatParams < (ABI.flattenTypes address (paramTypes (reallocType width))).length := by
    cases width <;> simp [reallocType, ptrPrim, paramTypes, ABI.flattenTypes, ABI.flatten, ABI.flattenPrimitive, ABI.maxFlatParams]
  simp only [fits, ite_false]
  cases width <;> cases address <;> rfl

private theorem sharedRecordAllocatorArgumentCode (task : TaskId) (callee : (core3 grow).FuncAddr)
    (entry : Task (core3 grow)) (width : AddrType) (request : ABI.ReallocRequest)
    (typeAt : entry.ft = reallocType width) (optionsAt : entry.opts = {}) :
    (sharedDestructorArguments task (some callee) entry (sharedRecordAllocatorArgs width request) : Session grow sig (Ret (core3 grow))) =
      .op .get (fun _ =>
        .op (.callCore callee (sharedRecordAllocatorFlatArgs width request)) (sharedDestructorCoreResult task entry)) := by
  let cx : LiftLowerContext (core3 grow) := { opts := entry.opts, inst := entry.inst, scope := .task task }
  have flat : (lowerFlatValues Limits.spec Quirks.none cx ABI.maxFlatParams (sharedRecordAllocatorArgs width request)
      (paramTypes entry.ft) none : Session grow sig (List FlatValue)) =
      .op .get (fun _ => .pure (sharedRecordAllocatorFlatArgs width request)) := by
    rw [typeAt]
    exact sharedRecordAllocatorFlatArgumentCode cx width request
  unfold sharedDestructorArguments liftArgumentsBody
  change (lowerFlatValues Limits.spec Quirks.none cx ABI.maxFlatParams (sharedRecordAllocatorArgs width request)
    (paramTypes entry.ft) none >>= liftArgumentsTail Limits.spec Quirks.none task callee entry cx) = _
  rw [flat]
  unfold liftArgumentsTail liftSyncTail
  simp [optionsAt, cx, callCore, perform, Prog.lift, bind, Prog.bind, Prog.bind_assoc]
  congr 1
  funext store
  congr 1
  funext words
  simp [sharedDestructorCoreResult, sharedDestructorFinish, optionsAt, bind]

private def sharedRecordAllocatorLiftedResult (width : AddrType) (words : List FlatValue) :
    Session grow sig (List Value.Val × FlatCursor) :=
  match words with
  | [] => internal "CoreValueIter.next: no more flat values"
  | word :: _ =>
    let kind := ptrIntKind width
    .pure ([.int kind (liftFlatInt kind word)], ⟨words, 1⟩)

private theorem sharedRecordAllocatorFlatResultCode (cx : LiftLowerContext (core3 grow)) (width : AddrType)
    (words : List FlatValue) :
    (liftFlatValues Limits.spec Quirks.none cx ABI.maxFlatResults (.ofList words)
      (resultTypes (reallocType width)) : Session grow sig (List Value.Val × FlatCursor)) =
    .op .get (fun _ => sharedRecordAllocatorLiftedResult width words) := by
  unfold liftFlatValues ptrType
  simp [gets, getStore, perform, Prog.lift, bind, Prog.bind]
  congr 1
  funext store
  change CStore (core3 grow) at store
  generalize ptrTypeIn store cx = address
  have fits : ¬ ABI.maxFlatResults < (ABI.flattenTypes address (resultTypes (reallocType width))).length := by
    cases width <;> simp [reallocType, ptrPrim, resultTypes, ABI.flattenTypes, ABI.flatten, ABI.flattenPrimitive, ABI.maxFlatResults]
  simp only [fits, ite_false]
  cases width <;> cases address <;> cases words <;> try rfl
  all_goals
    let reason := TrapReason.internal "CoreValueIter.next: no more flat values"
    change Prog.op (S := Eff (core3 grow) (HostState sig)) (.trap reason) _ =
      Prog.op (S := Eff (core3 grow) (HostState sig)) (.trap reason) _
    congr 1
    funext impossible
    cases impossible

private def sharedRecordAllocatorInnerResolve (caller : CallerId) (value : Value.Val) :
    Caller (core3 grow) → Session grow sig (Ret (core3 grow))
  | .sub (.realloc _ _) => modifyObj ArenaField.callers caller (LiftSt.recordReallocResult value) >>= fun _ => .pure .unit
  | .sub (.destructor _) => .pure .unit
  | .sub .start => .pure .unit
  | _ => internal "onResolveProg: not an internal caller"

private theorem sharedRecordAllocatorInnerResolveCode (caller : CallerId) (value : Value.Val) :
    (onResolveProg caller (some [value]) : Session grow sig (Ret (core3 grow))) =
      getObj ArenaField.callers caller >>= sharedRecordAllocatorInnerResolve caller value := by
  unfold onResolveProg
  simp only [Prog.bind_eq]
  congr 1
  funext record
  cases record <;> try rfl
  rename_i tag
  cases tag <;> rfl

open ReturnFrame.Occurrence in
private theorem sharedRecordAllocatorResolvePath {impl : HostImpl (core3 grow) (HostState sig)}
    (caller : CallerId) (args : List Value.Val) (value : Value.Val)
    (cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig))
    (focus : start.ctl = cursor.control (specDispatch ready impl (.onResolve caller (some [value]))))
    (found : ArenaField.callers.get? start.store caller = some (.sub (.realloc args none))) :
    let update := ArenaOps.updateSt (E := core3 grow) ArenaField.callers caller (LiftSt.recordReallocResult value)
    FramedQuietPath profile ready (specDispatch ready impl) cursor start [id, id, update]
      { start with store := update start.store, ctl := cursor.control (.pure .unit) } := by
  dsimp only
  rw [sharedDestructorResolveDispatchCode caller ready impl [value], sharedArenaReaderCode] at focus
  refine .get focus (body := onResolveProg caller (some [value])) ?_ ?_
  · simp only [sharedArenaReader, found, sharedDestructorResolveFromRecord]
  have inner : (onResolveProg caller (some [value]) : Session grow sig (Ret (core3 grow))) =
      .op .get (sharedArenaReader ArenaField.callers caller (sharedRecordAllocatorInnerResolve caller value)) := by
    rw [sharedRecordAllocatorInnerResolveCode, sharedArenaReaderCode]
  let update := ArenaOps.updateSt (E := core3 grow) ArenaField.callers caller (LiftSt.recordReallocResult value)
  refine .get (congrArg cursor.control inner) (body := .op (.modify update) (fun _ => .pure .unit)) ?_ ?_
  · simp only [sharedArenaReader, found, sharedRecordAllocatorInnerResolve]
    rfl
  exact .step (.modify (th := cursor.thread) (segs := cursor.frames) (rest := cursor.rest)
    (f := update) (k := fun _ => .pure .unit) rfl) rfl rfl .done

private theorem sharedRecordAllocatorSourceResolve {cx : LiftLowerContext (core3 grow)} {request width task caller}
    {store : CStore (core3 grow)} (value : Value.Val)
    (source : SharedRecordAllocatorSource cx request width task caller store) :
    SharedRecordAllocatorSource cx request width task caller
      (ArenaOps.updateSt ArenaField.callers caller (LiftSt.recordReallocResult value) store) (some value) := by
  refine ⟨source.taskEntry, ?_⟩
  rw [ArenaOps.updateSt, ArenaField.get?_modify_self, source.callerEntry]
  rfl

open ReturnFrame.Occurrence in
private theorem crossDestructorRecordAllocatorResolve {body : ThreadBody (core3 grow)}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    (parents : DestructorParentChain older body check.rest canon.rest) (thread : check.thread = canon.thread)
    (cx : LiftLowerContext (core3 grow)) (task : TaskId) (caller : CallerId) (worker : ThreadId)
    {request : ABI.ReallocRequest} {width : AddrType} (value : Value.Val)
    (source : SharedRecordAllocatorSource cx request width task caller start.store)
    (stores : start.store = incoming.store)
    (checked : start.ctl = (PayloadPrefix.Cursor.mk (some worker) []
      (check.control (sharedRecordAllocatorAfterResume cx task caller))).control
      (.op (.call (.onResolve caller (some [value]))) (sharedDestructorResolveReply task)))
    (canonical : incoming.ctl = (PayloadPrefix.Cursor.mk (some worker) []
      (canon.control (sharedRecordAllocatorAfterResume cx task caller))).control
      (.op (.call (.onResolve caller (some [value]))) (sharedDestructorResolveReply task)))
    (scheduler : DestructorSchedulerAlignment older start incoming)
    (run : Steps profile ready (specDispatch ready base) start labels finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  let parent := sharedRecordAllocatorAfterResume (sig := sig) cx task caller
  let leftWorker : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, [], check.control parent⟩
  let rightWorker : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, [], canon.control parent⟩
  let resume := sharedDestructorResolveReply (grow := grow) (sig := sig) task
  let call : Call (core3 grow) := .onResolve caller (some [value])
  let leftCursor := { leftWorker with frames := .prog resume :: leftWorker.frames }
  let rightCursor := { rightWorker with frames := .prog resume :: rightWorker.frames }
  let leftEntered := { start with ctl := leftCursor.control (specDispatch ready base call) }
  let rightEntered := { incoming with ctl := rightCursor.control (specDispatch ready (LiveDispatch.host bindings base) call) }
  have install : Step profile ready (specDispatch ready base) start .tau leftEntered :=
    .call (th := leftWorker.thread) (c := call) (k := resume) (segs := leftWorker.frames) (rest := leftWorker.rest) checked
  have peerInstall : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau rightEntered :=
    .call (th := rightWorker.thread) (c := call) (k := resume) (segs := rightWorker.frames) (rest := rightWorker.rest) canonical
  cases run with
  | refl => exact .exhausted
  | cons actual residual =>
    obtain ⟨rfl, rfl⟩ := silentStepUnique install actual
    have installed := sharedPushTransport install peerInstall
      (show transitionEdit start .tau = .push (.prog resume) by rw [transitionEdit, checked]; rfl)
      (show transitionEdit incoming .tau = .push (.prog resume) by rw [transitionEdit, canonical]; rfl)
    refine .destructorPrefix installed (frameCalloutStep installed rfl rfl) (fun aligned => aligned) ?_
    let update := ArenaOps.updateSt (E := core3 grow) ArenaField.callers caller (LiftSt.recordReallocResult value)
    let leftReturn := { leftEntered with store := update leftEntered.store, ctl := leftCursor.control (.pure .unit) }
    let rightReturn := { rightEntered with store := update rightEntered.store, ctl := rightCursor.control (.pure .unit) }
    let args := sharedRecordAllocatorArgs width request
    have callerAt : ArenaField.callers.get? leftEntered.store caller = some (.sub (.realloc args none)) := source.callerEntry
    have peerCaller : ArenaField.callers.get? rightEntered.store caller = some (.sub (.realloc args none)) := stores ▸ source.callerEntry
    have leftReads : FramedQuietPath profile ready (specDispatch ready base) leftCursor leftEntered [id, id, update] leftReturn :=
      sharedRecordAllocatorResolvePath caller args value leftCursor rfl callerAt
    have rightReads : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) rightCursor rightEntered
        [id, id, update] rightReturn :=
      sharedRecordAllocatorResolvePath caller args value rightCursor rfl peerCaller
    obtain ⟨used, remaining, reached, peer, split, paths, writers, tail, ending⟩ :=
      cutSharedQuietWorker leftReads rightReads residual
    rw [split]
    rcases ending with empty | ⟨rfl, rfl⟩
    · subst remaining
      cases tail
      exact .comparedPrefix paths writers .exhausted
    · refine .destructorPrefix paths writers (fun aligned => aligned) ?_
      let leftDone := { leftReturn with ctl := leftWorker.control (resume .unit) }
      let rightDone := { rightReturn with ctl := rightWorker.control (resume .unit) }
      have pop : Step profile ready (specDispatch ready base) leftReturn .tau leftDone :=
        .popProg (th := leftWorker.thread) (k := resume) (segs := leftWorker.frames) (rest := leftWorker.rest) rfl
      have peerPop : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) rightReturn .tau rightDone :=
        .popProg (th := rightWorker.thread) (k := resume) (segs := rightWorker.frames) (rest := rightWorker.rest) rfl
      rcases splitSilent (count := 1) (.cons pop (.refl _)) tail with ⟨suffix, consumed, actual⟩ | short
      · rw [consumed]
        have popped := sharedSchedulerTransport (bindings := bindings) (edit := .pop) pop peerPop rfl rfl
        exact .destructorPrefix popped (frameCalloutStep popped rfl rfl) (fun aligned => aligned)
          (.sharedDropRecordAllocatorResolved (check := check) (canon := canon) parents thread
            (congrArg update stores) scheduler (sharedRecordAllocatorSourceResolve value source)
            ⟨start, leftEntered, leftReturn, checked, install, rfl, leftReads.1.track _, rfl, rfl, pop⟩
            ⟨incoming, rightEntered, rightReturn, canonical, peerInstall, rfl, rightReads.1.track _, rfl, rfl, peerPop⟩
            rfl rfl actual)
      · have empty : remaining = [] := List.length_eq_zero_iff.mp (by omega)
        have stopped := stepsAtEmpty (empty ▸ tail)
        exact empty.symm ▸ stopped ▸ CallbackSliceEnd.exhausted

open ReturnFrame.Occurrence in
private theorem crossDestructorRecordAllocatorTaskReturn {body : ThreadBody (core3 grow)}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    (parents : DestructorParentChain older body check.rest canon.rest) (thread : check.thread = canon.thread)
    (cx : LiftLowerContext (core3 grow)) (task : TaskId) (caller : CallerId) (worker : ThreadId)
    {request : ABI.ReallocRequest} {width : AddrType} (value : Value.Val)
    (source : SharedRecordAllocatorSource cx request width task caller start.store)
    (stores : start.store = incoming.store)
    (checked : start.ctl = (PayloadPrefix.Cursor.mk (some worker) []
      (check.control (sharedRecordAllocatorAfterResume cx task caller))).control (sharedDestructorFinish task [value]))
    (canonical : incoming.ctl = (PayloadPrefix.Cursor.mk (some worker) []
      (canon.control (sharedRecordAllocatorAfterResume cx task caller))).control (sharedDestructorFinish task [value]))
    (scheduler : DestructorSchedulerAlignment older start incoming)
    (run : Steps profile ready (specDispatch ready base) start labels finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  obtain ⟨entry, found, _, _, _, callerAt⟩ := source.taskEntry
  let parent := sharedRecordAllocatorAfterResume (sig := sig) cx task caller
  let leftWorker : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, [], check.control parent⟩
  let rightWorker : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, [], canon.control parent⟩
  rw [sharedDestructorCompletionCode task [value]] at checked canonical
  let read : CStore (core3 grow) → Session grow sig (Ret (core3 grow)) := fun store =>
    match ArenaField.tasks.get? store task with
    | none => internal "dangling arena id"
    | some taskRecord => sharedDestructorReturnCall task taskRecord [value]
  let program := sharedDestructorReturnCall (sig := sig) task entry [value]
  let leftRead := { start with ctl := leftWorker.control program }
  let rightRead := { incoming with ctl := rightWorker.control program }
  have actualRead : read start.store = program := by simp only [read, found, program]
  have actualPeerRead : read incoming.store = program := by rw [← stores, actualRead]
  have readLeft : Step profile ready (specDispatch ready base) start .tau leftRead := by
    have step := Step.get (prof := profile) (hr := ready) (dispatch := specDispatch ready base)
      (th := leftWorker.thread) (segs := leftWorker.frames) (rest := leftWorker.rest) (k := read) checked
    rw [actualRead] at step
    exact step
  have readRight : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau rightRead := by
    have step := Step.get (prof := profile) (hr := ready) (dispatch := specDispatch ready (LiveDispatch.host bindings base))
      (th := rightWorker.thread) (segs := rightWorker.frames) (rest := rightWorker.rest) (k := read) canonical
    rw [actualPeerRead] at step
    exact step
  cases run with
  | refl => exact .exhausted
  | cons actual tail =>
    obtain ⟨rfl, rfl⟩ := silentStepUnique readLeft actual
    have paths := sharedSchedulerTransport (bindings := bindings) (edit := .same) readLeft readRight
      (by rw [transitionEdit, checked]; rfl) (by rw [transitionEdit, canonical]; rfl)
    refine .destructorPrefix paths (frameCalloutStep paths rfl rfl) (fun aligned => aligned) ?_
    by_cases resolved : entry.state = .resolved
    · have code : program = trap .taskReturnTwice := by simp only [program, sharedDestructorReturnCall, resolved, ite_true]
      exact compareSharedDestructorTrap .taskReturnTwice (congrArg leftWorker.control code) (congrArg rightWorker.control code) tail
    by_cases borrows : entry.numBorrows > 0
    · have code : program = trap .borrowsRemain := by simp only [program, sharedDestructorReturnCall, resolved, borrows, ite_true, ite_false]
      exact compareSharedDestructorTrap .borrowsRemain (congrArg leftWorker.control code) (congrArg rightWorker.control code) tail
    have code : program = .op (.call (.onResolve caller (some [value]))) (sharedDestructorResolveReply task) := by
      simp only [program, sharedDestructorReturnCall, resolved, borrows, ite_false]
      exact congrArg (fun target => Prog.op (S := Eff (core3 grow) (HostState sig))
        (.call (.onResolve target (some [value]))) (sharedDestructorResolveReply task)) callerAt
    exact crossDestructorRecordAllocatorResolve (check := check) (canon := canon) parents thread cx task caller worker value
      source stores (congrArg leftWorker.control code) (congrArg rightWorker.control code) scheduler tail

open ReturnFrame.Occurrence in
private theorem crossDestructorRecordAllocatorResult {body : ThreadBody (core3 grow)}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    (parents : DestructorParentChain older body check.rest canon.rest) (thread : check.thread = canon.thread)
    (cx : LiftLowerContext (core3 grow)) (task : TaskId) (caller : CallerId) (worker : ThreadId)
    (entry : Task (core3 grow)) {request : ABI.ReallocRequest} {width : AddrType} (words : List FlatValue)
    (typeAt : entry.ft = reallocType width)
    (source : SharedRecordAllocatorSource cx request width task caller start.store)
    (stores : start.store = incoming.store)
    (checked : start.ctl = (PayloadPrefix.Cursor.mk (some worker) []
      (check.control (sharedRecordAllocatorAfterResume cx task caller))).control (sharedDestructorCoreResult task entry words))
    (canonical : incoming.ctl = (PayloadPrefix.Cursor.mk (some worker) []
      (canon.control (sharedRecordAllocatorAfterResume cx task caller))).control (sharedDestructorCoreResult task entry words))
    (scheduler : DestructorSchedulerAlignment older start incoming)
    (run : Steps profile ready (specDispatch ready base) start labels finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  let parent := sharedRecordAllocatorAfterResume (sig := sig) cx task caller
  let leftWorker : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, [], check.control parent⟩
  let rightWorker : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, [], canon.control parent⟩
  let program : Session grow sig (Ret (core3 grow)) :=
    sharedRecordAllocatorLiftedResult width words >>= fun result => sharedDestructorFinish task result.1
  have code : (sharedDestructorCoreResult task entry words : Session grow sig (Ret (core3 grow))) =
      .op .get (fun _ => program) := by
    let context : LiftLowerContext (core3 grow) := { opts := entry.opts, inst := entry.inst, scope := .task task }
    change ((liftFlatValues Limits.spec Quirks.none context ABI.maxFlatResults (.ofList words) (resultTypes entry.ft) :
      Session grow sig (List Value.Val × FlatCursor)) >>= fun (values, _) => sharedDestructorFinish task values) = _
    rw [typeAt, sharedRecordAllocatorFlatResultCode (sig := sig) context width words]
    rfl
  have leftAt := checked.trans (congrArg leftWorker.control code)
  have rightAt := canonical.trans (congrArg rightWorker.control code)
  let left := { start with ctl := leftWorker.control program }
  let right := { incoming with ctl := rightWorker.control program }
  have read : Step profile ready (specDispatch ready base) start .tau left :=
    .get (th := leftWorker.thread) (segs := leftWorker.frames) (rest := leftWorker.rest) (k := fun _ => program) leftAt
  have peerRead : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau right :=
    .get (th := rightWorker.thread) (segs := rightWorker.frames) (rest := rightWorker.rest) (k := fun _ => program) rightAt
  cases run with
  | refl => exact .exhausted
  | cons actual tail =>
    obtain ⟨rfl, rfl⟩ := silentStepUnique read actual
    have paths := sharedSchedulerTransport (bindings := bindings) (edit := .same) read peerRead
      (by rw [transitionEdit, leftAt]; rfl) (by rw [transitionEdit, rightAt]; rfl)
    refine .destructorPrefix paths (frameCalloutStep paths rfl rfl) (fun aligned => aligned) ?_
    cases words with
    | nil =>
      let message := "CoreValueIter.next: no more flat values"
      have stuck : program = internal message := internalBind message _
      exact compareSharedDestructorTrap (.internal message)
        (congrArg leftWorker.control stuck) (congrArg rightWorker.control stuck) tail
    | cons word tailWords =>
      let value : Value.Val := .int (ptrIntKind width) (liftFlatInt (ptrIntKind width) word)
      exact crossDestructorRecordAllocatorTaskReturn (check := check) (canon := canon)
        parents thread cx task caller worker value source stores rfl rfl scheduler tail

open ReturnFrame.Occurrence in
private theorem crossDestructorRecordAllocatorCore {body : ThreadBody (core3 grow)}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    (parents : DestructorParentChain older body check.rest canon.rest) (thread : check.thread = canon.thread)
    (cx : LiftLowerContext (core3 grow)) (callee : (core3 grow).FuncAddr) (task : TaskId) (caller : CallerId) (worker : ThreadId)
    (entry : Task (core3 grow)) (width : AddrType) (request : ABI.ReallocRequest)
    (typeAt : entry.ft = reallocType width) (optionsAt : entry.opts = {}) (callerAt : entry.caller = caller)
    (source : SharedRecordAllocatorSource cx request width task caller start.store)
    (stores : start.store = incoming.store)
    (checked : start.ctl = (PayloadPrefix.Cursor.mk (some worker) []
        (check.control (sharedRecordAllocatorAfterResume cx task caller))).control
        (sharedDestructorArguments task (some callee) entry (sharedRecordAllocatorArgs width request)))
    (canonical : incoming.ctl = (PayloadPrefix.Cursor.mk (some worker) []
        (canon.control (sharedRecordAllocatorAfterResume cx task caller))).control
        (sharedDestructorArguments task (some callee) entry (sharedRecordAllocatorArgs width request)))
    (scheduler : DestructorSchedulerAlignment older start incoming)
    (run : Steps profile ready (specDispatch ready base) start labels finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  let parent := sharedRecordAllocatorAfterResume (sig := sig) cx task caller
  let leftWorker : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, [], check.control parent⟩
  let rightWorker : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, [], canon.control parent⟩
  rw [sharedRecordAllocatorArgumentCode task callee entry width request typeAt optionsAt] at checked canonical
  let args := sharedRecordAllocatorFlatArgs width request
  let result := sharedDestructorCoreResult (sig := sig) task entry
  let program := Prog.op (S := Eff (core3 grow) (HostState sig)) (.callCore callee args) result
  let left := { start with ctl := leftWorker.control program }
  let right := { incoming with ctl := rightWorker.control program }
  have read : Step profile ready (specDispatch ready base) start .tau left :=
    .get (th := leftWorker.thread) (segs := leftWorker.frames) (rest := leftWorker.rest) (k := fun _ => program) checked
  have peerRead : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau right :=
    .get (th := rightWorker.thread) (segs := rightWorker.frames) (rest := rightWorker.rest) (k := fun _ => program) canonical
  rcases splitSilent (count := 1) (.cons read (.refl _)) run with ⟨afterRead, used, residual⟩ | short
  · rw [used]
    have paths := sharedSchedulerTransport (bindings := bindings) (edit := .same) read peerRead
      (by rw [transitionEdit, checked]; rfl) (by rw [transitionEdit, canonical]; rfl)
    refine .destructorPrefix paths (frameCalloutStep paths rfl rfl) (fun aligned => aligned) ?_
    let core : (core3 grow).Thread (CanonHost (core3 grow)) := (core3 grow).invoke callee args
    let leftCore := { left with ctl := ⟨leftWorker.thread, .core core result, leftWorker.frames⟩ :: leftWorker.rest }
    let rightCore := { right with ctl := ⟨rightWorker.thread, .core core result, rightWorker.frames⟩ :: rightWorker.rest }
    have call : Step profile ready (specDispatch ready base) left .tau leftCore :=
      .callCore (th := leftWorker.thread) (segs := leftWorker.frames) (rest := leftWorker.rest) (f := callee) (args := args) (k := result) rfl
    have peerCall : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) right .tau rightCore :=
      .callCore (th := rightWorker.thread) (segs := rightWorker.frames) (rest := rightWorker.rest) (f := callee) (args := args) (k := result) rfl
    rcases splitSilent (count := 1) (.cons call (.refl _)) residual with ⟨afterCall, installed, bodyRun⟩ | short
    · rw [installed]
      have invoked := sharedSchedulerTransport (bindings := bindings) (edit := .same) call peerCall rfl rfl
      refine .destructorPrefix invoked (frameCalloutStep invoked rfl rfl) (fun aligned => aligned) ?_
      let frame (left right : Config (core3 grow) (HostState sig)) :=
        DestructorSchedulerAlignment older left right ∧ SharedRecordAllocatorSource cx request width task caller left.store
      exact crossSharedDestructorCoreWith (check := leftWorker) (canon := rightWorker) (frame := frame)
        task entry (fun retained _ _ _ _ => ⟨retained.1, sharedRecordAllocatorSourceFrame retained.2 rfl rfl⟩)
        stores ⟨scheduler, source⟩ rfl rfl bodyRun
        (fun same retained leftAt rightAt status remaining _ =>
          .sharedDropRecordAllocatorCoreCallout (check := check) (canon := canon)
            parents thread same retained.1 retained.2 typeAt optionsAt callerAt leftAt rightAt status remaining)
        (fun words same retained leftAt rightAt remaining =>
          .sharedDropRecordAllocatorCoreReturned (check := check) (canon := canon)
            parents thread same retained.1 retained.2 typeAt optionsAt callerAt leftAt rightAt
            (crossDestructorRecordAllocatorResult (check := check) (canon := canon)
              parents thread cx task caller worker entry words typeAt retained.2 same leftAt rightAt retained.1 remaining))
    · have empty : afterRead = [] := List.length_eq_zero_iff.mp (by omega)
      have stopped := stepsAtEmpty (empty ▸ residual)
      exact empty.symm ▸ stopped ▸ CallbackSliceEnd.exhausted
  · have empty : labels = [] := List.length_eq_zero_iff.mp (by omega)
    have stopped := stepsAtEmpty (empty ▸ run)
    exact empty.symm ▸ stopped ▸ CallbackSliceEnd.exhausted

open ReturnFrame.Occurrence in
private theorem crossDestructorRecordAllocatorOnStart {body : ThreadBody (core3 grow)}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    (parents : DestructorParentChain older body check.rest canon.rest) (thread : check.thread = canon.thread)
    (cx : LiftLowerContext (core3 grow)) (callee : (core3 grow).FuncAddr) (task : TaskId) (caller : CallerId) (worker : ThreadId)
    {request : ABI.ReallocRequest} {width : AddrType}
    (source : SharedRecordAllocatorSource cx request width task caller start.store)
    (stores : start.store = incoming.store)
    (checked : start.ctl = (PayloadPrefix.Cursor.mk (some worker) []
      (check.control (sharedRecordAllocatorAfterResume cx task caller))).control (sharedDestructorAfterAdmission task (some callee) true))
    (canonical : incoming.ctl = (PayloadPrefix.Cursor.mk (some worker) []
      (canon.control (sharedRecordAllocatorAfterResume cx task caller))).control (sharedDestructorAfterAdmission task (some callee) true))
    (scheduler : DestructorSchedulerAlignment older start incoming)
    (run : Steps profile ready (specDispatch ready base) start labels finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  obtain ⟨entry, taskAt, typeAt, optionsAt, instanceAt, callerAt⟩ := source.taskEntry
  have rawTask : ArenaField.tasks.get? incoming.store task = some entry := stores ▸ taskAt
  let parent := sharedRecordAllocatorAfterResume (sig := sig) cx task caller
  let leftWorker : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, [], check.control parent⟩
  let rightWorker : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, [], canon.control parent⟩
  let resume := sharedDestructorStartReply (sig := sig) task (some callee) entry
  let dispatchCall := Call.onStart (E := core3 grow) entry.caller
  let program := Prog.op (S := Eff (core3 grow) (HostState sig)) (.call dispatchCall) resume
  let leftCall := { start with store := CStore.setTaskState task .started start.store, ctl := leftWorker.control program }
  let rightCall := { incoming with store := CStore.setTaskState task .started incoming.store, ctl := rightWorker.control program }
  have leftStart : FramedQuietPath profile ready (specDispatch ready base) leftWorker start
      [id, id, CStore.setTaskState task .started] leftCall :=
    sharedDestructorStartPath task (some callee) leftWorker entry checked taskAt
  have rightStart : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) rightWorker incoming
      [id, id, CStore.setTaskState task .started] rightCall :=
    sharedDestructorStartPath task (some callee) rightWorker entry canonical rawTask
  obtain ⟨leading, remaining, reached, peer, split, paths, writers, residual, ending⟩ :=
    cutSharedQuietWorker leftStart rightStart run
  rw [split]
  rcases ending with empty | ⟨rfl, rfl⟩
  · subst remaining
    cases residual
    exact .comparedPrefix paths writers .exhausted
  · refine .destructorPrefix paths writers (fun aligned => aligned) ?_
    let leftCursor := { leftWorker with frames := .prog resume :: leftWorker.frames }
    let rightCursor := { rightWorker with frames := .prog resume :: rightWorker.frames }
    let leftEntered := { leftCall with ctl := leftCursor.control (specDispatch ready base dispatchCall) }
    let rightEntered := { rightCall with ctl := rightCursor.control (specDispatch ready (LiveDispatch.host bindings base) dispatchCall) }
    have install : Step profile ready (specDispatch ready base) leftCall .tau leftEntered :=
      .call (th := leftWorker.thread) (k := resume) (c := dispatchCall) (segs := leftWorker.frames) (rest := leftWorker.rest) rfl
    have peerInstall : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) rightCall .tau rightEntered :=
      .call (th := rightWorker.thread) (k := resume) (c := dispatchCall) (segs := rightWorker.frames) (rest := rightWorker.rest) rfl
    rcases splitSilent (count := 1) (.cons install (.refl _)) residual with ⟨onStart, used, remainingRun⟩ | short
    · rw [used]
      have entered := sharedPushTransport (bindings := bindings) install peerInstall rfl rfl
      refine .destructorPrefix entered (frameCalloutStep entered rfl rfl) (fun aligned => aligned) ?_
      let args := sharedRecordAllocatorArgs width request
      have startedSource := sharedRecordAllocatorSourceStart source
      have fresh : ArenaField.callers.get? leftEntered.store entry.caller = some (.sub (.realloc args none)) := by
        rw [callerAt]
        exact startedSource.callerEntry
      have sameEntered : leftEntered.store = rightEntered.store := congrArg (CStore.setTaskState task .started) stores
      have rawFresh : ArenaField.callers.get? rightEntered.store entry.caller = some (.sub (.realloc args none)) := sameEntered ▸ fresh
      let leftReturn := { leftEntered with ctl := leftCursor.control (.pure (.vals args)) }
      let rightReturn := { rightEntered with ctl := rightCursor.control (.pure (.vals args)) }
      have leftReads : FramedQuietPath profile ready (specDispatch ready base) leftCursor leftEntered [id, id] leftReturn :=
        sharedRecordAllocatorOnStartPath entry.caller leftCursor args rfl fresh
      have rightReads : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) rightCursor rightEntered
          [id, id] rightReturn :=
        sharedRecordAllocatorOnStartPath entry.caller rightCursor args rfl rawFresh
      obtain ⟨seen, following, reached, peer, divided, moved, traced, tail, didRead⟩ :=
        cutSharedQuietWorker leftReads rightReads remainingRun
      rw [divided]
      rcases didRead with empty | ⟨rfl, rfl⟩
      · subst following
        cases tail
        exact .comparedPrefix moved traced .exhausted
      · refine .destructorPrefix moved traced (fun aligned => aligned) ?_
        let leftDone := { leftReturn with ctl := leftWorker.control (resume (.vals args)) }
        let rightDone := { rightReturn with ctl := rightWorker.control (resume (.vals args)) }
        have pop : Step profile ready (specDispatch ready base) leftReturn .tau leftDone :=
          .popProg (th := leftWorker.thread) (k := resume) (segs := leftWorker.frames) (rest := leftWorker.rest) rfl
        have peerPop : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) rightReturn .tau rightDone :=
          .popProg (th := rightWorker.thread) (k := resume) (segs := rightWorker.frames) (rest := rightWorker.rest) rfl
        rcases splitSilent (count := 1) (.cons pop (.refl _)) tail with ⟨suffix, consumed, afterPop⟩ | short
        · rw [consumed]
          have popped := sharedSchedulerTransport (bindings := bindings) pop peerPop rfl rfl
          exact .destructorPrefix popped (frameCalloutStep popped rfl rfl) (fun aligned => aligned)
            (.sharedDropRecordAllocatorArguments (check := check) (canon := canon)
              parents thread sameEntered scheduler startedSource typeAt optionsAt instanceAt callerAt
              ⟨leftCall, leftEntered, leftReturn, rfl, install, rfl, leftReads.1.track _, rfl, pop⟩
              ⟨rightCall, rightEntered, rightReturn, rfl, peerInstall, rfl, rightReads.1.track _, rfl, peerPop⟩
              rfl rfl
              (crossDestructorRecordAllocatorCore (check := check) (canon := canon)
                parents thread cx callee task caller worker entry width request typeAt optionsAt callerAt
                startedSource sameEntered rfl rfl scheduler afterPop))
        · have empty : following = [] := List.length_eq_zero_iff.mp (by omega)
          have stopped := stepsAtEmpty (empty ▸ tail)
          exact empty.symm ▸ stopped ▸ CallbackSliceEnd.exhausted
    · have empty : remaining = [] := List.length_eq_zero_iff.mp (by omega)
      have stopped := stepsAtEmpty (empty ▸ residual)
      exact empty.symm ▸ stopped ▸ CallbackSliceEnd.exhausted

private theorem sharedRecordAllocatorSourceRegister {cx : LiftLowerContext (core3 grow)} {request width task caller}
    {store : CStore (core3 grow)} (worker : ThreadId)
    (source : SharedRecordAllocatorSource cx request width task caller store) :
    SharedRecordAllocatorSource cx request width task caller (CStore.registerThreadSt task worker store) := by
  obtain ⟨entry, found, typeAt, optionsAt, instanceAt, callerAt⟩ := source.taskEntry
  have taskAt : store.task? task = some entry := found
  cases room : (store.inst? entry.inst).bind (InstState.addThread? worker) with
  | none => simpa only [CStore.registerThreadSt, taskAt, room] using source
  | some result =>
    obtain ⟨slot, target⟩ := result
    simp only [CStore.registerThreadSt, taskAt, room]
    refine ⟨⟨{ entry with threads := entry.threads ++ [worker] }, ?_, typeAt, optionsAt, instanceAt, callerAt⟩,
      source.callerEntry⟩
    change ArenaField.tasks.get? (ArenaField.tasks.modify store task
      (fun previous => { previous with threads := previous.threads ++ [worker] })) task = _
    rw [ArenaField.get?_modify_self, found]
    rfl

open ReturnFrame.Occurrence in
private theorem crossDestructorAllocatorRegisteredWorker {body : ThreadBody (core3 grow)}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    (parents : DestructorParentChain older body check.rest canon.rest) (thread : check.thread = canon.thread)
    (cx : LiftLowerContext (core3 grow)) (callee : (core3 grow).FuncAddr) (task : TaskId) (caller : CallerId) (worker : ThreadId)
    {request : ABI.ReallocRequest} {width : AddrType}
    (source : SharedRecordAllocatorSource cx request width task caller start.store)
    (sameStore : start.store = incoming.store)
    (checked : start.ctl = StepDefs.threadAct (specDispatch ready base) worker (.liftImplicit task callee) ::
      check.control (sharedRecordAllocatorAfterResume cx task caller))
    (canonical : incoming.ctl = StepDefs.threadAct (specDispatch ready (LiveDispatch.host bindings base)) worker (.liftImplicit task callee) ::
      canon.control (sharedRecordAllocatorAfterResume cx task caller))
    (scheduler : DestructorSchedulerAlignment older start incoming)
    (run : Steps profile ready (specDispatch ready base) start labels finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  let parent := sharedRecordAllocatorAfterResume (sig := sig) cx task caller
  let checkWorker : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, [], check.control parent⟩
  let canonWorker : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, [], canon.control parent⟩
  let enter (store : CStore (core3 grow)) := CStore.setImplicitThread task worker store
  let read := sharedDestructorAfterTaskRead (sig := sig) task (some callee) worker
  let readLeft := { start with store := enter start.store, ctl := checkWorker.control (read (enter start.store)) }
  let readRight := { incoming with store := enter incoming.store, ctl := canonWorker.control (read (enter incoming.store)) }
  have lhs : FramedQuietPath profile ready (specDispatch ready base) checkWorker start [id, enter, id] readLeft :=
    sharedDestructorEntryPath task (some callee) worker (check.control parent) checked
  have rhs : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canonWorker incoming [id, enter, id] readRight :=
    sharedDestructorEntryPath task (some callee) worker (canon.control parent) canonical
  obtain ⟨leading, remaining, reached, peer, split, paths, writers, residual, ending⟩ := cutSharedQuietWorker lhs rhs run
  rw [split]
  rcases ending with empty | ⟨rfl, rfl⟩
  · subst remaining
    cases residual
    exact .comparedPrefix paths writers .exhausted
  · refine .destructorPrefix paths writers (fun aligned => aligned) ?_
    obtain ⟨entry, found, typeAt, optionsAt, instanceAt, callerAt⟩ := source.taskEntry
    let entered := { entry with implicitThread := some worker }
    have sync : entered.ft.async_ = false := by change entry.ft.async_ = false; rw [typeAt]; rfl
    have leftTask : ArenaField.tasks.get? readLeft.store task = some entered := by
      change ArenaField.tasks.get? (CStore.setImplicitThread task worker start.store) task = _
      rw [CStore.setImplicitThread, ArenaField.get?_modify_self, found]
      rfl
    have stores : readLeft.store = readRight.store := congrArg enter sameStore
    have rightTask : ArenaField.tasks.get? readRight.store task = some entered := stores ▸ leftTask
    have readSource : SharedRecordAllocatorSource cx request width task caller readLeft.store :=
      ⟨⟨entered, leftTask, typeAt, optionsAt, instanceAt, callerAt⟩, source.callerEntry⟩
    let next := sharedDestructorAfterAdmission (sig := sig) task (some callee) true
    have leftAt : readLeft.ctl = checkWorker.control (Task.registerThread task worker >>= fun _ => next) :=
      congrArg checkWorker.control (sharedDestructorSyncCode task (some callee) worker _ entered leftTask sync)
    have rightAt : readRight.ctl = canonWorker.control (Task.registerThread task worker >>= fun _ => next) :=
      congrArg canonWorker.control (sharedDestructorSyncCode task (some callee) worker _ entered rightTask sync)
    have leftRegistration := sharedDestructorRegisterPath (profile := profile) (ready := ready)
      (dispatch := specDispatch ready base) task worker checkWorker next entered leftTask leftAt
    have rightRegistration := sharedDestructorRegisterPath (profile := profile) (ready := ready)
      (dispatch := specDispatch ready (LiveDispatch.host bindings base)) task worker canonWorker next entered rightTask rightAt
    have sameDecision := congrArg (fun store => sharedDestructorRegisterResult store entered.inst worker) stores
    dsimp only at leftRegistration rightRegistration
    rw [← sameDecision] at rightRegistration
    obtain ⟨used, suffix, reached, peer, cut, moved, wrote, tail, registered⟩ :=
      cutSharedQuietWorker leftRegistration rightRegistration residual
    rw [cut]
    rcases registered with empty | ⟨rfl, rfl⟩
    · subst suffix
      cases tail
      exact .comparedPrefix moved wrote .exhausted
    · refine .destructorPrefix moved wrote (fun aligned => aligned) ?_
      let verdict := sharedDestructorRegisterResult readLeft.store entered.inst worker
      let afterCheck := { readLeft with
        store := sharedDestructorRegisterStore task worker readLeft.store verdict
        ctl := checkWorker.control (sharedDestructorRegisterTail next verdict) }
      let afterCanon := { readRight with
        store := sharedDestructorRegisterStore task worker readRight.store verdict
        ctl := canonWorker.control (sharedDestructorRegisterTail next verdict) }
      change Steps profile ready (specDispatch ready base) afterCheck suffix finish at tail
      cases result : verdict with
      | error reason =>
        exact classifySharedDestructorTrap (check := checkWorker) (canon := canonWorker)
          (start := afterCheck) (incoming := afterCanon) reason
          (by simp only [afterCheck, result, sharedDestructorRegisterTail])
          (by simp only [afterCanon, result, sharedDestructorRegisterTail]) tail
      | ok done =>
        cases done
        have sourceAfter : SharedRecordAllocatorSource cx request width task caller afterCheck.store := by
          simp only [afterCheck, result, sharedDestructorRegisterStore]
          exact sharedRecordAllocatorSourceRegister worker readSource
        have sameAfter : afterCheck.store = afterCanon.store := by
          simp only [afterCheck, afterCanon, result, sharedDestructorRegisterStore]
          exact congrArg (CStore.registerThreadSt task worker) stores
        have checkedAt : afterCheck.ctl = checkWorker.control next := by simp only [afterCheck, result, sharedDestructorRegisterTail]
        have canonicalAt : afterCanon.ctl = canonWorker.control next := by simp only [afterCanon, result, sharedDestructorRegisterTail]
        exact .sharedDropRecordAllocatorRegistered (check := check) (canon := canon) parents thread sameAfter scheduler sourceAfter
          checkedAt canonicalAt
          (crossDestructorRecordAllocatorOnStart (check := check) (canon := canon)
            parents thread cx callee task caller worker sourceAfter sameAfter checkedAt canonicalAt scheduler tail)

open ReturnFrame.Occurrence in
private theorem crossDestructorRecordAllocatorWorker {body : ThreadBody (core3 grow)}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    (parents : DestructorParentChain older body check.rest canon.rest) (thread : check.thread = canon.thread)
    (cx : LiftLowerContext (core3 grow)) (callee : (core3 grow).FuncAddr) (task : TaskId) (caller : CallerId)
    {request : ABI.ReallocRequest} {width : AddrType}
    (allocatorSource : SharedRecordAllocatorSource cx request width task caller start.store)
    (stores : start.store = incoming.store)
    (checked : start.ctl = check.control (.op (.newThread (.liftImplicit task callee)) (sharedRecordAllocatorAfterThread cx task caller)))
    (canonical : incoming.ctl = canon.control (.op (.newThread (.liftImplicit task callee)) (sharedRecordAllocatorAfterThread cx task caller)))
    (scheduler : DestructorSchedulerAlignment older start incoming)
    (run : Steps profile ready (specDispatch ready base) start labels finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  let source : ThreadBody (core3 grow) := .liftImplicit task callee
  let allocated := ArenaField.threads.alloc start.store { task := task }
  let worker := allocated.2
  let saved := StepDefs.threadAct (specDispatch ready base) worker source
  let afterThread := sharedRecordAllocatorAfterThread (sig := sig) cx task caller
  let parent := sharedRecordAllocatorAfterResume (sig := sig) cx task caller
  let left := { start.setCont worker (some saved) with store := allocated.1, ctl := check.control (afterThread worker) }
  let right := { incoming.setCont worker (some saved) with store := allocated.1, ctl := canon.control (afterThread worker) }
  have install : Step profile ready (specDispatch ready base) start .tau left := .newThread checked rfl
  have peerInstall : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau right :=
    .newThread canonical (by rw [← stores]; rfl)
  rcases splitSilent (count := 1) (.cons install (.refl _)) run with ⟨afterInstall, used, residual⟩ | short
  · rw [used]
    have installed := sharedSchedulerTransport (bindings := bindings) (edit := .write worker.idx []) install peerInstall
      (by rw [transitionEdit, checked]; rfl) (by rw [transitionEdit, canonical, ← stores]; rfl)
    have savedAlignment (aligned : DestructorSchedulerAlignment older start incoming) :
        DestructorSchedulerAlignment older left right :=
      ⟨relatedSetSlot .none aligned.1 worker.idx (.some (.mk .nil)), aligned.2⟩
    refine .destructorPrefix installed (frameCalloutStep installed rfl rfl) savedAlignment ?_
    let leftResume := { left with
      store := destructorResumeStore worker left.store, ctl := check.control (.op (.resumeThread worker) (fun _ => parent)) }
    let rightResume := { right with
      store := destructorResumeStore worker right.store, ctl := canon.control (.op (.resumeThread worker) (fun _ => parent)) }
    have beforeResume := sharedThreadResumePath (profile := profile) (ready := ready) (dispatch := specDispatch ready base)
      (start := left) worker check parent rfl
    have peerBeforeResume := sharedThreadResumePath (profile := profile) (ready := ready)
      (dispatch := specDispatch ready (LiveDispatch.host bindings base)) (start := right) worker canon parent rfl
    obtain ⟨leading, remaining, reached, peer, split, paths, writers, tail, ending⟩ :=
      cutSharedQuietWorker beforeResume peerBeforeResume residual
    rw [split]
    rcases ending with empty | ⟨rfl, rfl⟩
    · subst remaining
      cases tail
      exact .comparedPrefix paths writers .exhausted
    · refine .destructorPrefix paths writers (fun aligned => aligned) ?_
      have leftFound : leftResume.cont? worker = some saved := Config.cont?_setCont_self start worker (some saved)
      have rightFound : rightResume.cont? worker = some saved := Config.cont?_setCont_self incoming worker (some saved)
      let active := { leftResume.setCont worker none with
        store := StepDefs.threadStatusSt worker .running leftResume.store, ctl := saved :: check.control parent }
      let peerActive := { rightResume.setCont worker none with
        store := StepDefs.threadStatusSt worker .running rightResume.store, ctl := saved :: canon.control parent }
      have resume : Step profile ready (specDispatch ready base) leftResume .tau active :=
        .resumeThread (th := check.thread) (k := fun _ => parent) (segs := check.frames) (rest := check.rest) rfl leftFound
      have peerResume : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) rightResume .tau peerActive :=
        .resumeThread (th := canon.thread) (k := fun _ => parent) (segs := canon.frames) (rest := canon.rest) rfl rightFound
      rcases splitSilent (count := 1) (.cons resume (.refl _)) tail with ⟨suffix, usedResume, actual⟩ | short
      · rw [usedResume]
        have moved := sharedSchedulerTransport (bindings := bindings) (edit := .resume worker.idx) resume peerResume rfl rfl
        have activeAlignment (aligned : DestructorSchedulerAlignment older leftResume rightResume) :
            DestructorSchedulerAlignment older active peerActive := ⟨relatedSetSlot .none aligned.1 worker.idx .none, aligned.2⟩
        have sourceAtResume : SharedRecordAllocatorSource cx request width task caller active.store := by
          apply sharedRecordAllocatorSourceFrame allocatorSource <;>
            simp only [active, leftResume, left, destructorResumeStore] <;> split <;> rfl
        exact .destructorPrefix moved (frameCalloutStep moved rfl rfl) activeAlignment
          (.sharedDropRecordAllocatorResumed parents thread rfl (activeAlignment (savedAlignment scheduler))
            sourceAtResume leftFound rightFound resume peerResume rfl rfl
            (crossDestructorAllocatorRegisteredWorker (check := check) (canon := canon)
              parents thread cx callee task caller worker sourceAtResume rfl rfl rfl
              (activeAlignment (savedAlignment scheduler)) actual))
      · have empty : remaining = [] := List.length_eq_zero_iff.mp (by omega)
        have stopped := stepsAtEmpty (empty ▸ tail)
        rw [empty, stopped]
        exact .exhausted
  · have empty : labels = [] := List.length_eq_zero_iff.mp (by omega)
    have stopped := stepsAtEmpty (empty ▸ run)
    rw [empty, stopped]
    exact .exhausted

open ReturnFrame.Occurrence Stored.Endpoints in
private theorem crossDestructorRecordAllocator {limit : Nat} {body : ThreadBody (core3 grow)}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    (parents : DestructorParentChain older body check.rest canon.rest)
    (thread : check.thread = canon.thread)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) check.frames canon.frames)
    (cx : LiftLowerContext (core3 grow)) (site : SharedRecordAllocation) (compiled : site.compiled cx)
    (leftNext rightNext : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow))) :
    DestructorRecordAt (check := check) (canon := canon) profile ready base bindings older limit finish
      (.op (.call (site.call cx)) (site.resume cx leftNext))
      (.op (.call (site.call cx)) (site.resume cx rightNext)) := by
  classical
  intro left right labels stores checked canonical scheduler run _
  let call := site.call cx
  let first := site.resume cx leftNext
  let second := site.resume cx rightNext
  let checkEntered := { check with frames := .prog first :: check.frames }
  let canonEntered := { canon with frames := .prog second :: canon.frames }
  let program := specDispatch ready base call
  let reached := { left with ctl := checkEntered.control program }
  let peer := { right with ctl := canonEntered.control program }
  have install : Step profile ready (specDispatch ready base) left .tau reached := .call checked
  have peerInstall : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) right .tau peer := .call canonical
  cases run with
  | refl => exact .exhausted
  | cons actual residual =>
    obtain ⟨rfl, rfl⟩ := silentStepUnique install actual
    have paths := sharedPushTransport install peerInstall
      (show transitionEdit left .tau = .push (.prog first) by rw [transitionEdit, checked]; rfl)
      (show transitionEdit right .tau = .push (.prog second) by rw [transitionEdit, canonical]; rfl)
    refine .destructorPrefix paths (frameCalloutStep paths rfl rfl) (fun aligned => aligned) ?_
    refine .sharedDropRecordAllocatorBody (check := check) (canon := canon) (site := site)
      parents thread segments compiled stores scheduler checked canonical install peerInstall rfl rfl ?_
    have code : program = (sharedRecordAllocatorSetup cx site.request >>= fun (callee, task, caller) =>
        .op (.newThread (.liftImplicit task callee)) (sharedRecordAllocatorAfterThread cx task caller)) :=
      sharedRecordAllocatorSetupCode cx site.request
    let next (selected : AddrType × (core3 grow).FuncAddr) : Session grow sig (Ret (core3 grow)) :=
      let (width, callee) := selected
      allocObj ArenaField.callers (.sub (.realloc (sharedRecordAllocatorArgs width site.request) none)) >>= fun caller => do
        sharedRecordAllocatorConfine cx
        let task ← allocObj ArenaField.tasks (sharedRecordAllocatorTask cx width caller)
        .op (.newThread (.liftImplicit task callee)) (sharedRecordAllocatorAfterThread cx task caller)
    have split : program = sharedRecordAllocatorSelect cx >>= next := by
      rw [code]
      simp only [sharedRecordAllocatorSetup, Prog.bind_eq, Prog.bind_assoc, Prog.pure_eq, Prog.pure_bind']
      congr 1
    let selection := sharedRecordAllocatorSelect (sig := sig) cx
    refine crossSharedWorkerBodyWith (check := checkEntered) (canon := canonEntered) thread selection next next
      (liftDestructorStoreEffects (sharedRecordAllocatorSelectEffects cx) (trivialPreserves _)) trivial stores
      (congrArg checkEntered.control split) (congrArg canonEntered.control split) residual ?_
    intro before beforePeer remaining selected _ _ same leftAt rightAt aligned tail
    obtain ⟨width, callee⟩ := selected
    let args := sharedRecordAllocatorArgs width site.request
    let callerEntry : Caller (core3 grow) := .sub (.realloc args none)
    let installWorker (caller : CallerId) (task : TaskId) : Session grow sig (Ret (core3 grow)) :=
      .op (.newThread (.liftImplicit task callee)) (sharedRecordAllocatorAfterThread cx task caller)
    let allocateTask (caller : CallerId) :=
      allocObj ArenaField.tasks (sharedRecordAllocatorTask cx width caller) >>= installWorker caller
    let afterCaller (caller : CallerId) : Session grow sig (Ret (core3 grow)) :=
      sharedRecordAllocatorConfine cx >>= fun _ => allocateTask caller
    refine crossSharedRecordArenaAlloc ArenaField.callers callerEntry afterCaller same leftAt rightAt tail ?_
    intro remaining
    dsimp only
    intro callerRun
    let allocation := ArenaField.callers.alloc before.store callerEntry
    let caller := allocation.2
    let confine := sharedRecordAllocatorConfine (sig := sig) cx
    let preserved := sharedRecordAllocatorConfinePreserves (sig := sig) cx caller callerEntry
    let continues (_ : Unit) := allocateTask caller
    refine crossSharedWorkerBodyWith (check := checkEntered) (canon := canonEntered) thread confine continues continues
      (liftDestructorStoreEffects (sharedRecordAllocatorConfineEffects cx) preserved)
      (ArenaField.callers.get?_alloc_self before.store callerEntry) rfl rfl rfl callerRun ?_
    intro taskStart taskPeer remaining _ _ callerFound same taskAt taskAtPeer afterConfine taskRun
    let entry := sharedRecordAllocatorTask cx width caller
    refine crossSharedRecordArenaAlloc ArenaField.tasks entry (installWorker caller) same taskAt taskAtPeer taskRun ?_
    intro remaining
    dsimp only
    intro afterTask
    let fresh := ArenaField.tasks.alloc taskStart.store entry
    have allocatorSource : SharedRecordAllocatorSource cx site.request width fresh.2 caller fresh.1 :=
      ⟨⟨entry, ArenaField.tasks.get?_alloc_self taskStart.store entry, rfl, rfl, rfl, rfl⟩, callerFound⟩
    exact crossDestructorRecordAllocatorWorker (check := checkEntered) (canon := canonEntered)
      parents thread cx callee fresh.2 caller allocatorSource rfl rfl rfl
      (afterConfine (aligned scheduler)) afterTask


open Stored.Endpoints in
private def sharedRecordStringPlacement (cx : LiftLowerContext (core3 grow))
    (text : Stored.Payload (.prim .string)) (index ptr : Nat) :
    Session grow sig (Except RecordLower.Issue Unit) :=
  let type : Stored.TypeOf := .prim .string
  let refuse := fun issue => .error (.field index (.beforeAllocation (.abi issue)))
  match Stored.Lower.checkSchema type >>= fun _ => Stored.Lower.checkOptions cx type (.memory ptr) with
  | .error issue => pure (refuse issue)
  | .ok () => do
    let width ← ptrType cx
    if !Stored.Lower.fits Quirks.none cx.opts.encoding width type text.val then
      return refuse .allocationPrecondition
    let area := ABI.layout width type
    checkAligned ptr area.alignment.bytes
    checkInBounds cx ptr area.size
    return .ok ()

open Stored.Endpoints in
private def sharedRecordStringEmit (cx : LiftLowerContext (core3 grow))
    (text : Stored.Payload (.prim .string)) (ptr : Nat)
    (next : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow))) :
    Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow))
  | .error issue => next (.error issue)
  | .ok () => Canon.store Limits.spec Quirks.none cx text.val (.prim .string) ptr >>= fun _ => next (.ok ())

open Stored.Endpoints in
private theorem sharedRecordStringPlacementEffects (cx : LiftLowerContext (core3 grow))
    (text : Stored.Payload (.prim .string)) (index ptr : Nat) :
    StoreEffects (sharedRecordStringPlacement cx text index ptr : Session grow sig (Except RecordLower.Issue Unit)) := by
  unfold sharedRecordStringPlacement
  dsimp only
  split
  · exact .pure _
  · refine (storeEffectPtrType cx).bind fun width => ?_
    split
    · exact .pure _
    · exact (storeEffectTrapIf _ _).bind fun _ =>
        (storeEffectBounds cx ptr (ABI.layout width (.prim .string)).size).bind fun _ => .pure _

open Stored.OwnedMemory.Claims Stored.Endpoints in
private theorem sharedRecordStringCode (cx : LiftLowerContext (core3 grow)) (width : AddrType)
    (text : Stored.Payload (.prim .string)) (index ptr : Nat)
    (next : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow))) :
    (RecordLower.Internal.runField Limits.spec Quirks.none cx (Record.authority recordClaims Limits.spec cx)
      width (.data (.prim .string) text) index (.memory ptr) >>= next) =
    (sharedRecordStringPlacement cx text index ptr >>= sharedRecordStringEmit cx text ptr next) := by
  let type : Stored.TypeOf := .prim .string
  let initialWidth : Session grow sig AddrType := ptrType cx
  let fits (width : AddrType) := Stored.Lower.fits Quirks.none cx.opts.encoding width type text.val
  let issue := RecordLower.Issue.field index ∘ ListLower.Issue.beforeAllocation ∘ Stored.Endpoints.Lower.Issue.abi
  let lower (width : AddrType) : Session grow sig (Except Stored.Lower.Issue Unit) :=
    if !fits width then pure (.error .allocationPrecondition)
    else do return .ok (← Stored.Lower.emit Limits.spec Quirks.none cx width type text (.memory ptr))
  let place (width : AddrType) : Session grow sig (Except RecordLower.Issue Unit) :=
    if !fits width then pure (.error (issue .allocationPrecondition))
    else do
      let area := ABI.layout width type
      checkAligned ptr area.alignment.bytes
      checkInBounds cx ptr area.size
      return .ok ()
  let packed (result : Except Stored.Lower.Issue Unit) : Session grow sig (Except RecordLower.Issue Unit) :=
    .pure (result.mapError issue)
  let emit := sharedRecordStringEmit cx text ptr next
  simp only [RecordLower.Internal.runField, Stored.Lower.lower, sharedRecordStringPlacement]
  cases (Stored.Lower.checkSchema type >>= fun _ => Stored.Lower.checkOptions cx type (.memory ptr)) with
  | error rejected => rfl
  | ok accepted =>
    cases accepted
    change ((initialWidth.bind lower).bind packed).bind next = (initialWidth.bind place).bind emit
    simp only [Prog.bind_assoc]
    refine congrArg initialWidth.bind (funext fun actualWidth => ?_)
    cases ready : fits actualWidth with
    | false => simp [lower, place, ready, packed, emit]; rfl
    | true =>
      simp [lower, place, ready, Stored.Lower.emit, Prog.bind_assoc, packed, emit, sharedRecordStringEmit]
      let area := ABI.layout actualWidth type
      let aligned : Session grow sig Unit := checkAligned ptr area.alignment.bytes
      let bounded : Session grow sig Unit := checkInBounds cx ptr area.size
      let storeText : Session grow sig Unit := Canon.store Limits.spec Quirks.none cx text.val type ptr
      change (((aligned.bind fun _ => bounded.bind fun _ => storeText).bind
        fun value => .pure (.ok value : Except Stored.Lower.Issue Unit)).bind (fun result => next (result.mapError issue))) =
        aligned.bind (fun _ => bounded.bind (fun _ => storeText.bind (fun _ => next (.ok ()))))
      simp only [Prog.bind_assoc, Prog.pure_bind', Except.mapError]

open Stored.Endpoints in
private theorem sharedRecordStringPlanCode (cx : LiftLowerContext (core3 grow)) (value : Value.StrVal) (dest : Nat)
    (next : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow))) :
    (Canon.store Limits.spec Quirks.none cx (.string value) (.prim .string) dest >>= fun _ => next (.ok ())) =
      (ptrType cx >>= sharedRecordStringPlan cx value dest next) := by
  rw [Canon.store.eq_def]
  simp [storePrim, storeString, storeStringIntoRange, bind, Prog.bind_assoc]
  refine congrArg (ptrType (σ := HostState sig) cx).bind (funext fun width => ?_)
  unfold sharedRecordStringPlan sharedRecordStringRemaining sharedRecordStringDescriptor
  simp [bind, Prog.bind_assoc]

/-- The first instruction of each canonical string encoding plan allocates its initial range. -/
private theorem stringPlanInitialAllocation (encoding : ABI.StringEncoding) (width : AddrType) (value : ABI.StringValue) :
    ∃ alignment size remaining,
      (ABI.storeStringIntoRange encoding width value).steps = .allocate alignment size :: remaining := by
  unfold ABI.storeStringIntoRange
  dsimp only
  split
  all_goals
    simp only [ABI.storeStringCopy, ABI.storeUtf16ToUtf8, ABI.storeLatin1ToUtf8, ABI.storeStringToUtf8,
      ABI.storeUtf8ToUtf16]
  all_goals
    repeat' first | (exact ⟨_, _, _, rfl⟩) | split |
      (simp only [ABI.storeProbablyUtf16ToLatin1OrUtf16, ABI.storeStringToLatin1OrUtf16])

open Stored.Endpoints in
private theorem sharedRecordStringRequestCode (cx : LiftLowerContext (core3 grow)) (dest tagged old oldLen : Nat)
    (next : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow)))
    (alignment size : Nat) (remaining : List ABI.StoreStep) :
    (reallocate cx old oldLen alignment size >>= fun ptr => sharedRecordStringRemaining cx remaining tagged dest ptr next) =
      .op (.call (.reallocate cx old oldLen alignment size))
        (sharedRecordStringResume cx remaining tagged dest next) := by
  let call : Call (core3 grow) := .reallocate cx old oldLen alignment size
  let read (result : Ret (core3 grow)) : Session grow sig Nat := match result with
    | .nat ptr => pure ptr
    | _ => internal "late-bound call: expected Ret.nat"
  have callCode : (callNat call : Session grow sig Nat) = .op (.call call) read := by
    simp [callNat, callRet, perform, Prog.lift, bind, Prog.bind, read]
    refine congrArg (Prog.op (S := Eff (core3 grow) (HostState sig)) (.call call)) (funext fun result => ?_)
    cases result <;> rfl
  unfold reallocate
  rw [callCode]
  change Prog.op (S := Eff (core3 grow) (HostState sig)) (.call call)
    (fun result => (read result).bind fun ptr => sharedRecordStringRemaining cx remaining tagged dest ptr next) = _
  refine congrArg (Prog.op (S := Eff (core3 grow) (HostState sig)) (.call call)) (funext fun result => ?_)
  cases result
  case nat => rfl
  all_goals
    change ((internal "late-bound call: expected Ret.nat" : Session grow sig Nat).bind _) = _
    rw [internalBind]
    rfl

open Stored.Endpoints in
private theorem sharedRecordStringAllocationCode (cx : LiftLowerContext (core3 grow)) (width : AddrType)
    (value : Value.StrVal) (dest : Nat)
    (next : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow)))
    (alignment : ABI.Alignment) (size : Nat) (remaining : List ABI.StoreStep)
    (steps : (storePlanFor Quirks.none cx.opts.encoding width value).steps = .allocate alignment size :: remaining) :
    sharedRecordStringPlan cx value dest next width =
      .op (.call (.reallocate cx 0 0 alignment.bytes size))
        (sharedRecordStringResume cx remaining (storePlanFor Quirks.none cx.opts.encoding width value).taggedCodeUnits dest next) := by
  unfold sharedRecordStringPlan
  dsimp only
  rw [steps]
  change (((runStoreStep cx 0 (.allocate alignment size)).bind
      fun ptr => runStoreSteps cx ptr remaining) : Session grow sig Nat).bind _ = _
  rw [Prog.bind_assoc]
  exact sharedRecordStringRequestCode cx dest _ 0 0 next alignment.bytes size remaining

open Stored.OwnedMemory.Claims Stored.Endpoints LinkedCallback.MemorySequence in
private theorem visitDestructorRecordFields {limit : Nat} {body : ThreadBody (core3 grow)}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)} (leftTicket rightTicket : Nat)
    (cx : LiftLowerContext (core3 grow)) (width : AddrType)
    (mode : Track) (fields : List RecordLower.Field) (cursor index : Nat) (join : SharedRecordJoin)
    (emitted : ∀ field ∈ fields, RecordLower.Field.Emitted field)
    (parents : DestructorParentChain older body check.rest canon.rest)
    (thread : check.thread = canon.thread)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) check.frames canon.frames)
    (onJoin : ∀ result, DestructorRecordAt (check := check) (canon := canon) profile ready base bindings older limit finish
      (join.reply cx width leftTicket result) (join.reply cx width rightTicket result)) :
    DestructorRecordAt (check := check) (canon := canon) profile ready base bindings older limit finish
      (sharedRecordMemory mode cx width fields cursor index (join.reply cx width leftTicket))
      (sharedRecordMemory mode cx width fields cursor index (join.reply cx width rightTicket)) := by
  classical
  induction fieldSize : sizeOf fields using Nat.strong_induction_on generalizing mode fields cursor index join
  rename_i size ih
  cases fields with
  | nil =>
    intro left right remaining stores checked canonical scheduler run bounded
    cases mode <;> exact onJoin (.ok ()) stores checked canonical scheduler run bounded
  | cons field fields =>
    have fieldEmitted := emitted field (List.mem_cons_self ..)
    have tailEmitted : ∀ item ∈ fields, RecordLower.Field.Emitted item :=
      fun item inTail => emitted item (List.mem_cons_of_mem field inTail)
    let slot := mode.slot width field cursor
    let ptr := slot.1
    let following (ticket : Nat) := sharedRecordAfterField (sig := sig) mode cx width fields slot.2 (index + 1) (join.reply cx width ticket)
    have onField (result : Except RecordLower.Issue Unit) :
        DestructorRecordAt (check := check) (canon := canon) profile ready base bindings older limit finish
          (following leftTicket result) (following rightTicket result) := by
      cases result with
      | error issue => exact onJoin (.error issue)
      | ok done =>
        cases done
        have smaller : sizeOf fields < size := by rw [← fieldSize]; simp
        exact @ih (sizeOf fields) smaller mode fields slot.2 (index + 1) join tailEmitted onJoin rfl
    let childJoin := SharedRecordJoin.field mode fields slot.2 (index + 1) index join
    have onChild (result : Except RecordLower.Issue Unit) :
        DestructorRecordAt (check := check) (canon := canon) profile ready base bindings older limit finish
          (childJoin.reply cx width leftTicket result) (childJoin.reply cx width rightTicket result) :=
      @onField (result.mapError (.nested index))
    intro left right remaining stores checked canonical scheduler run bounded
    by_cases localField : SharedRecordLocalField field
    · let visit : Session grow sig (Except RecordLower.Issue Unit) :=
        RecordLower.Internal.runField Limits.spec Quirks.none cx (Record.authority recordClaims Limits.spec cx) width field index (.memory ptr)
      rw [sharedRecordMemoryCons] at checked canonical
      exact crossSharedWorkerBodyWith (check := check) (canon := canon) thread visit (following leftTicket) (following rightTicket)
        (liftDestructorStoreEffects (sharedRecordLocalFieldEffects cx width localField index ptr) (trivialPreserves _))
        trivial stores checked canonical run
        (fun result shorter _ same leftAt rightAt aligned residual =>
          onField result same leftAt rightAt (aligned scheduler) residual (shorter.trans bounded))
    by_cases aggregate : ∃ type children, field = .aggregate type children
    · obtain ⟨type, children, rfl⟩ := aggregate
      have childrenEmitted : ∀ item ∈ children, RecordLower.Field.Emitted item := by
        cases fieldEmitted with
        | aggregate compiled => exact compiled
      have smaller : sizeOf children < size := by rw [← fieldSize]; simp; omega
      let resume (ticket : Nat) (_ : Unit) := sharedRecordMemory (sig := sig) .fields cx width children ptr 0 (childJoin.reply cx width ticket)
      rw [sharedRecordMemoryCons, sharedRecordAggregateCode] at checked canonical
      exact crossSharedWorkerBodyWith (check := check) (canon := canon) thread
        (checkInBounds cx ptr (ABI.layout width type).size) (resume leftTicket) (resume rightTicket)
        (liftDestructorStoreEffects (storeEffectBounds cx ptr (ABI.layout width type).size) (trivialPreserves _))
        trivial stores checked canonical run
        (fun _ shorter _ same leftAt rightAt aligned residual =>
          ih (sizeOf children) smaller .fields children ptr 0 childJoin childrenEmitted onChild rfl
            same leftAt rightAt (aligned scheduler) residual (shorter.trans bounded))
    by_cases fixed : ∃ element length entries, field = .fixed element length entries
    · obtain ⟨element, length, entries, rfl⟩ := fixed
      have entriesEmitted : ∀ item ∈ entries, RecordLower.Field.Emitted item := by
        cases fieldEmitted with
        | fixed compiled => exact compiled
      have smaller : sizeOf entries < size := by rw [← fieldSize]; simp; omega
      rw [sharedRecordMemoryCons, sharedRecordFixedCode] at checked canonical
      exact ih (sizeOf entries) smaller (.elements (ABI.layout width element).size) entries ptr 0 childJoin entriesEmitted onChild rfl
        stores checked canonical scheduler run bounded
    by_cases sum : ∃ type arms tag child, field = .sum type arms tag (some child)
    · obtain ⟨type, arms, tag, child, rfl⟩ := sum
      have childEmitted : ∀ item ∈ [child], RecordLower.Field.Emitted item := by
        intro item member
        rw [List.mem_singleton] at member
        subst item
        cases fieldEmitted with
        | sum compiled => exact compiled _ rfl
      have smaller : sizeOf ([child] : List RecordLower.Field) < size := by rw [← fieldSize]; simp; omega
      let head : Session grow sig Nat :=
        storeVariantHead cx arms.length (ABI.maxCaseAlignment (arms.map (ABI.layoutOption width))) tag ptr
      let resume (ticket address : Nat) :=
        sharedRecordMemory (sig := sig) (.elements 0) cx width [child] address 0 (childJoin.reply cx width ticket)
      rw [sharedRecordMemoryCons, sharedRecordSumCode] at checked canonical
      exact crossSharedWorkerBodyWith (check := check) (canon := canon) thread head (resume leftTicket) (resume rightTicket)
        (liftDestructorStoreEffects (sharedRecordVariantHeadEffects cx width arms tag ptr) (trivialPreserves _))
        trivial stores checked canonical run
        (fun address shorter _ same leftAt rightAt aligned residual =>
          ih (sizeOf ([child] : List RecordLower.Field)) smaller (.elements 0) [child] address 0 childJoin childEmitted onChild rfl
            same leftAt rightAt (aligned scheduler) residual (shorter.trans bounded))
    by_cases context : ∃ identity, field = .context identity
    · obtain ⟨identity, rfl⟩ := context
      rw [sharedRecordMemoryCons, sharedRecordContextCode] at checked canonical
      exact crossDestructorRecordContext thread cx identity index ptr
        (following leftTicket) (following rightTicket) onField stores checked canonical scheduler run bounded
    by_cases owner : ∃ receipt, field = .owner receipt
    · obtain ⟨receipt, rfl⟩ := owner
      rw [sharedRecordMemoryCons, sharedRecordOwnerCode] at checked canonical
      exact crossDestructorRecordOwner thread cx receipt index ptr
        (following leftTicket) (following rightTicket) onField stores checked canonical scheduler run bounded
    by_cases endpoint : ∃ channel element identity, field = .endpoint channel element identity
    · obtain ⟨channel, element, identity, rfl⟩ := endpoint
      rw [sharedRecordMemoryCons, sharedRecordEndpointCode] at checked canonical
      exact crossDestructorRecordEndpoint thread cx ⟨channel, element, identity, cx.inst⟩ index ptr
        (following leftTicket) (following rightTicket) onField stores checked canonical scheduler run bounded
    by_cases dynamic : ∃ type element entries, field = .dynamic type element entries
    · obtain ⟨type, element, entries, rfl⟩ := dynamic
      have entriesEmitted : ∀ item ∈ entries, RecordLower.Field.Emitted item := by
        intro item member
        cases fieldEmitted with
        | list compiled => exact compiled item member
        | map shapes values =>
          obtain ⟨payload, value, rfl⟩ := shapes item member
          refine RecordLower.Field.Emitted.aggregate ?_
          intro child atChild
          simp only [List.mem_cons, List.not_mem_nil, or_false] at atChild
          rcases atChild with keyChild | valueChild
          · exact keyChild.symm ▸ RecordLower.Field.Emitted.primitive payload
          · exact valueChild.symm ▸ values payload value member
      let next (ticket : Nat) (result : Except RecordLower.Issue Unit) :=
        sharedRecordBeforeAllocation cx width element entries index ptr result >>= following ticket
      rw [sharedRecordMemoryCons, sharedRecordCollectionCode] at checked canonical
      refine crossDestructorRecordPrepare (RecordLower.Field.listObjects entries) (next leftTicket) (next rightTicket)
        ?_ stores checked canonical scheduler run bounded
      intro result left right remaining stores checked canonical scheduler run bounded
      cases result with
      | error issue =>
        exact onField (.error (sharedRecordPreAllocationIssue index issue)) stores checked canonical scheduler run bounded
      | ok done =>
        cases done
        let site := SharedRecordAllocation.collection width element entries index ptr
        change left.ctl = check.control (sharedRecordAllocate cx width element entries index ptr >>= following leftTicket) at checked
        change right.ctl = canon.control (sharedRecordAllocate cx width element entries index ptr >>= following rightTicket) at canonical
        rw [sharedRecordAllocatorCode] at checked canonical
        exact crossDestructorRecordAllocator parents thread segments cx site entriesEmitted
          (following leftTicket) (following rightTicket) stores checked canonical scheduler run bounded
    have stringField : ∃ text : Stored.Payload (.prim .string), field = .data (.prim .string) text := by
      cases fieldEmitted with
      | @primitive primitive payload =>
        by_cases string : primitive = .string
        · subst primitive
          exact ⟨payload, rfl⟩
        · exact (localField (.data (.primitive string))).elim
      | enum payload schema => exact (localField (.data (.enum schema))).elim
      | flags payload schema => exact (localField (.data (.flags schema))).elim
      | endpoint => exact (endpoint ⟨_, _, _, rfl⟩).elim
      | context => exact (context ⟨_, rfl⟩).elim
      | owner => exact (owner ⟨_, rfl⟩).elim
      | aggregate => exact (aggregate ⟨_, _, rfl⟩).elim
      | fixed => exact (fixed ⟨_, _, _, rfl⟩).elim
      | list => exact (dynamic ⟨_, _, _, rfl⟩).elim
      | map => exact (dynamic ⟨_, _, _, rfl⟩).elim
      | @sum type arms tag selected _ =>
        cases selected with
        | none => exact (localField .sumNone).elim
        | some child => exact (sum ⟨_, _, _, child, rfl⟩).elim
    obtain ⟨text, rfl⟩ := stringField
    rw [sharedRecordMemoryCons, sharedRecordStringCode] at checked canonical
    let placed (ticket : Nat) := sharedRecordStringEmit cx text ptr (following ticket)
    refine crossDestructorRecordStore thread (sharedRecordStringPlacement cx text index ptr)
      (sharedRecordStringPlacementEffects cx text index ptr) (placed leftTicket) (placed rightTicket)
      ?_ stores checked canonical scheduler run bounded
    intro result left right remaining stores checked canonical scheduler run bounded
    cases result with
    | error issue => exact onField (.error issue) stores checked canonical scheduler run bounded
    | ok done =>
      cases done
      obtain ⟨value, typed⟩ := text
      cases typed with
      | int kind _ => cases kind
      | @string value valid =>
        have checkedAt : left.ctl = check.control
            (Canon.store Limits.spec Quirks.none cx (.string value) (.prim .string) ptr >>= fun _ => following leftTicket (.ok ())) := checked
        have canonicalAt : right.ctl = canon.control
            (Canon.store Limits.spec Quirks.none cx (.string value) (.prim .string) ptr >>= fun _ => following rightTicket (.ok ())) := canonical
        rw [sharedRecordStringPlanCode] at checkedAt canonicalAt
        refine crossDestructorRecordStore thread (ptrType cx) (storeEffectPtrType cx)
          (sharedRecordStringPlan cx value ptr (following leftTicket)) (sharedRecordStringPlan cx value ptr (following rightTicket))
          ?_ stores checkedAt canonicalAt scheduler run bounded
        intro actualWidth left right remaining stores checked canonical scheduler run bounded
        obtain ⟨alignment, size, tail, steps⟩ := stringPlanInitialAllocation cx.opts.encoding actualWidth
          (storeSource Quirks.none actualWidth value)
        let site := SharedRecordAllocation.string actualWidth value ptr alignment size tail
        exact crossDestructorRecordAllocator parents thread segments cx site steps (following leftTicket) (following rightTicket)
          stores
          (checked.trans (congrArg check.control (sharedRecordStringAllocationCode cx actualWidth value ptr
            (following leftTicket) alignment size tail steps)))
          (canonical.trans (congrArg canon.control (sharedRecordStringAllocationCode cx actualWidth value ptr
            (following rightTicket) alignment size tail steps)))
          scheduler run bounded

open Stored.Endpoints in
private theorem finishDestructorRecordFields {limit : Nat} {body : ThreadBody (core3 grow)}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)} {leftTicket rightTicket : Nat}
    (cx : LiftLowerContext (core3 grow)) (width : AddrType) (fields : List RecordLower.Field) (cursor index : Nat)
    (emitted : ∀ field ∈ fields, RecordLower.Field.Emitted field)
    (parents : DestructorParentChain older body check.rest canon.rest)
    (thread : check.thread = canon.thread)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) check.frames canon.frames)
    (stores : start.store = incoming.store)
    (checked : start.ctl = check.control (sharedRecordMemory .fields cx width fields cursor index (sharedRecordReport leftTicket)))
    (canonical : incoming.ctl = canon.control (sharedRecordMemory .fields cx width fields cursor index (sharedRecordReport rightTicket)))
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (scheduler : DestructorSchedulerAlignment older start incoming)
    (bounded : labels.length ≤ limit) (compare : ShorterCallbackSlices profile ready base bindings limit) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  refine visitDestructorRecordFields (check := check) (canon := canon) leftTicket rightTicket
    cx width .fields fields cursor index .report emitted parents thread segments ?_ stores checked canonical scheduler run bounded
  intro result left right remaining stores checked canonical scheduler run bounded
  cases result with
  | error issue =>
    exact finishDestructorScheduledReply parents thread segments stores (.error (.lowerRecord issue))
      checked canonical scheduler run bounded compare
  | ok done =>
    cases done
    exact finishDestructorScheduledReply parents thread segments stores (.ok 0) checked canonical scheduler run bounded compare

open Stored.Endpoints in
private theorem finishDestructorRecordPlacement {limit : Nat} {body : ThreadBody (core3 grow)}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)} {ptr leftTicket rightTicket : Nat}
    (cx : LiftLowerContext (core3 grow)) (type : Stored.TypeOf) (value : Value.Val) (fields : List RecordLower.Field)
    (emitted : ∀ field ∈ fields, RecordLower.Field.Emitted field)
    (parents : DestructorParentChain older body check.rest canon.rest)
    (thread : check.thread = canon.thread)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) check.frames canon.frames)
    (stores : start.store = incoming.store)
    (checked : start.ctl = check.control (sharedRecordEmit cx type value fields ptr leftTicket))
    (canonical : incoming.ctl = canon.control (sharedRecordEmit cx type value fields ptr rightTicket))
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (scheduler : DestructorSchedulerAlignment older start incoming)
    (bounded : labels.length ≤ limit) (compare : ShorterCallbackSlices profile ready base bindings limit) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  rw [sharedRecordPlacementCode] at checked canonical
  refine crossSharedWorkerBodyWith (check := check) (canon := canon) thread (sharedRecordPlace cx type value ptr)
    (sharedRecordVisit cx fields ptr leftTicket) (sharedRecordVisit cx fields ptr rightTicket)
    (liftDestructorStoreEffects (sharedRecordPlaceEffects cx type value ptr) (trivialPreserves _))
    trivial stores checked canonical run ?_
  intro left right remaining width shorter _ same leftAt rightAt align residual
  cases width with
  | none =>
    exact finishDestructorScheduledReply (check := check) (canon := canon) (leftTicket := leftTicket) (rightTicket := rightTicket)
      parents thread segments same (.error (.lowerRecord (.preflight (.abi .allocationPrecondition))))
      leftAt rightAt (align scheduler) residual (shorter.trans bounded) compare
  | some width =>
    exact finishDestructorRecordFields (check := check) (canon := canon) (leftTicket := leftTicket) (rightTicket := rightTicket)
      cx width fields ptr 0 emitted parents thread segments same leftAt rightAt residual (align scheduler) (shorter.trans bounded) compare

open ReturnFrame.Occurrence Stored.OwnedMemory.Claims Stored.Endpoints in
private theorem finishDestructorSharedRecord {limit : Nat} {body : ThreadBody (core3 grow)}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    {name kind inst ptr leftTicket rightTicket} {tree : Stored.OwnedMemory.Tree sig}
    (destination : RecordDestination)
    (parents : DestructorParentChain older body check.rest canon.rest)
    (thread : check.thread = canon.thread)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) check.frames canon.frames)
    (linked : resolveBinding bindings name kind = .ok ⟨name, inst, .giveRecord destination⟩)
    (stores : start.store = incoming.store)
    (checked : start.ctl = check.control ((SharedGiveAction.record destination).afterLookup inst leftTicket ptr (some tree)))
    (canonical : incoming.ctl = canon.control ((SharedGiveAction.record destination).afterLookup inst rightTicket ptr (some tree)))
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (scheduler : DestructorSchedulerAlignment older start incoming)
    (bounded : labels.length ≤ limit) (compare : ShorterCallbackSlices profile ready base bindings limit) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  classical
  cases tree with
  | atom impossible => exact impossible.elim
  | tag payload count children =>
    rw [sharedRecordCode (grow := grow) (sig := sig) destination inst leftTicket ptr payload count children] at checked
    rw [sharedRecordCode (grow := grow) (sig := sig) destination inst rightTicket ptr payload count children] at canonical
    let cx := destination.context (grow := grow) inst
    let type := sig.payload payload.1
    let value := payload.2.val.value
    cases compiled : Record.preflight cx type payload.2 (.memory ptr) with
    | error issue =>
      have refused : Record.preflight (destination.context (grow := grow) inst) (sig.payload payload.1) payload.2
          (.memory ptr) = .error issue := compiled
      rw [refused] at checked canonical
      exact finishDestructorScheduledReply parents thread segments stores (.error (.lowerRecord issue))
        checked canonical scheduler run bounded compare
    | ok result =>
      obtain ⟨fields, objects⟩ := result
      have compiledAt : Record.preflight (destination.context (grow := grow) inst) (sig.payload payload.1) payload.2
          (.memory ptr) = .ok (fields, objects) := compiled
      rw [compiledAt] at checked canonical
      have emitted := RecordLower.compileRecord_emitted cx type value payload.2.val.owners (.memory ptr)
        fields objects (by
          simp only [Record.preflight, bind, Except.bind, Except.mapError] at compiled
          split at compiled <;> first | contradiction | exact compiled)
      let plan := RecordLower.Field.listObjects fields
      let checkedNext := sharedRecordAfterPrepare (sig := sig) cx type value fields ptr leftTicket
      let canonicalNext := sharedRecordAfterPrepare (sig := sig) cx type value fields ptr rightTicket
      let leftRead := { start with ctl := check.control (.op .hostGet
        (fun state => checkedNext (Record.prepare start.store state.writer plan))) }
      let rightRead := { incoming with ctl := canon.control (.op .hostGet
        (fun state => canonicalNext (Record.prepare incoming.store state.writer plan))) }
      have leftGet : Step profile ready (specDispatch ready base) start .tau leftRead := .get checked
      have rightGet : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau rightRead :=
        .get canonical
      cases run with
      | refl => exact .exhausted
      | @cons _ _ _ _ trailing first tail =>
        obtain ⟨rfl, rfl⟩ := silentStepUnique leftGet first
        have got := sharedSchedulerTransport (bindings := bindings) (edit := .same) leftGet rightGet
          (by rw [transitionEdit, checked]; rfl) (by rw [transitionEdit, canonical]; rfl)
        refine .destructorPrefix got (frameCalloutStep got rfl rfl) (fun aligned => aligned) ?_
        let lhs := Record.prepare start.store start.host.writer plan
        let rhs := Record.prepare incoming.store incoming.host.writer plan
        let left := { leftRead with ctl := check.control (checkedNext lhs) }
        let right := { rightRead with ctl := canon.control (canonicalNext rhs) }
        have lread : Step profile ready (specDispatch ready base) leftRead .tau left :=
          .hostGet (th := check.thread) (segs := check.frames) (rest := check.rest)
            (k := fun state => checkedNext (Record.prepare start.store state.writer plan)) rfl
        have rread : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) rightRead .tau right :=
          .hostGet (th := canon.thread) (segs := canon.frames) (rest := canon.rest)
            (k := fun state => canonicalNext (Record.prepare incoming.store state.writer plan)) rfl
        rcases splitSilent (count := 1) (.cons lread (.refl _)) tail with ⟨suffix, used, residual⟩ | short
        · rw [used]
          rw [used] at bounded
          have reads := sharedSchedulerTransport (bindings := bindings) (edit := .same) lread rread rfl rfl
          by_cases agrees : lhs = rhs
          · refine .destructorPrefix reads (frameCalloutStep reads rfl rfl) (fun aligned => aligned) ?_
            cases outcome : lhs with
            | error issue =>
              refine finishDestructorScheduledReply (check := check) (canon := canon) (start := left) (incoming := right)
                (leftTicket := leftTicket) (rightTicket := rightTicket) parents thread segments stores (.error (.lowerRecord issue)) ?_ ?_ scheduler residual ?_ compare
              · change check.control (checkedNext lhs) = _
                rw [outcome]
                rfl
              · change canon.control (canonicalNext rhs) = _
                rw [← agrees, outcome]
                rfl
              · simp only [List.length_cons, List.length_append, List.length_replicate] at bounded
                omega
            | ok permit =>
              cases permit
              have within : suffix.length ≤ limit := by
                simp only [List.length_cons, List.length_append, List.length_replicate] at bounded
                omega
              have checkedPlaced : left.ctl = check.control (sharedRecordEmit cx type value fields ptr leftTicket) := by
                change check.control (checkedNext lhs) = _
                rw [outcome]
                rfl
              have canonicalPlaced : right.ctl = canon.control (sharedRecordEmit cx type value fields ptr rightTicket) := by
                change canon.control (canonicalNext rhs) = _
                rw [← agrees, outcome]
                rfl
              exact .sharedDropRecordPrepared parents thread segments linked compiledAt emitted stores outcome
                (agrees.symm.trans outcome) checkedPlaced canonicalPlaced
                (finishDestructorRecordPlacement cx type value fields emitted parents thread segments stores
                  checkedPlaced canonicalPlaced residual scheduler within compare)
          · have mismatch : SharedRecordPrepareMismatch leftRead rightRead left right plan check canon :=
              ⟨checkedNext, canonicalNext, stores, rfl, rfl, rfl, rfl, agrees⟩
            exact .sharedRecordPrepareMismatch mismatch reads
              (.sharedRecordPrepare mismatch (.same lread rfl (.done _)) (.same rread rfl (.done _))) residual
        · have empty : trailing = [] := List.length_eq_zero_iff.mp (by omega)
          have stopped := stepsAtEmpty (empty ▸ tail)
          rw [empty, stopped]
          exact .exhausted

private theorem finishDestructorNominalTransfer {limit : Nat} {body : ThreadBody (core3 grow)}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    {leftTicket rightTicket : Nat}
    (transfer : Session grow sig Nat) (effects : StoreEffects transfer)
    (parents : DestructorParentChain older body check.rest canon.rest)
    (thread : check.thread = canon.thread)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) check.frames canon.frames)
    (stores : start.store = incoming.store)
    (leftFocus : start.ctl = check.control (transfer >>= fun idx => scheduledReply leftTicket (.ok idx)))
    (rightFocus : incoming.ctl = canon.control (transfer >>= fun idx => scheduledReply rightTicket (.ok idx)))
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (scheduler : DestructorSchedulerAlignment older start incoming)
    (bounded : labels.length ≤ limit) (compare : ShorterCallbackSlices profile ready base bindings limit) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  refine crossSharedWorkerBodyWith (check := check) (canon := canon) thread transfer
    (fun idx => scheduledReply leftTicket (.ok idx)) (fun idx => scheduledReply rightTicket (.ok idx))
    (liftDestructorStoreEffects effects (trivialPreserves _)) trivial stores leftFocus rightFocus run ?_
  intro left right suffix idx shorter _ same leftAt rightAt aligned residual
  exact finishDestructorScheduledReply parents thread segments same (.ok idx) leftAt rightAt
    (aligned scheduler) residual (shorter.trans bounded) compare

open ReturnFrame.Occurrence Stored.OwnedMemory.Claims in
private theorem finishDestructorOwnerGive {limit : Nat} {body : ThreadBody (core3 grow)}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    {rep leftTicket rightTicket : Nat} (owner : SharedOwnerGive)
    (parents : DestructorParentChain older body check.rest canon.rest)
    (thread : check.thread = canon.thread)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) check.frames canon.frames)
    (stores : start.store = incoming.store)
    (leftFocus : start.ctl = check.control (owner.claim.probe owner.inst leftTicket))
    (rightFocus : incoming.ctl = canon.control (owner.claim.probe owner.inst rightTicket))
    (leftLive : owner.claim.observe start.host.writer = .ok rep)
    (rightLive : owner.claim.observe incoming.host.writer = .ok rep)
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (scheduler : DestructorSchedulerAlignment older start incoming)
    (bounded : labels.length ≤ limit) (compare : ShorterCallbackSlices profile ready base bindings limit) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  let spendHost (host : HostState sig) : HostState sig :=
    { host with writer := (Spend.owner owner.identity).apply host.writer }
  let writeAfter (ticket : Nat) (host : HostState sig) : Session grow sig (Ret (core3 grow)) :=
    .op (.hostSet (spendHost host)) (fun _ => owner.afterSpend rep ticket)
  let checked := { start with ctl := check.control (owner.spend rep leftTicket) }
  let raw := { incoming with ctl := canon.control (owner.spend rep rightTicket) }
  let leftWrite := { checked with ctl := check.control (writeAfter leftTicket checked.host) }
  let rightWrite := { raw with ctl := canon.control (writeAfter rightTicket raw.host) }
  let leftDone := { leftWrite with host := spendHost leftWrite.host, ctl := check.control (owner.afterSpend rep leftTicket) }
  let rightDone := { rightWrite with host := spendHost rightWrite.host, ctl := canon.control (owner.afterSpend rep rightTicket) }
  have guard : Step profile ready (specDispatch ready base) start .tau checked := by
    have step : Step profile ready (specDispatch ready base) start .tau
        { start with ctl := check.control (owner.claim.afterRead owner.inst leftTicket (owner.claim.observe start.host.writer)) } :=
      .hostGet (th := check.thread) (segs := check.frames) (rest := check.rest) leftFocus
    rw [leftLive, sharedOwnerSpendCode] at step
    exact step
  have peerGuard : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau raw := by
    have step : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau
        { incoming with ctl := canon.control (owner.claim.afterRead owner.inst rightTicket (owner.claim.observe incoming.host.writer)) } :=
      .hostGet (th := canon.thread) (segs := canon.frames) (rest := canon.rest) rightFocus
    rw [rightLive, sharedOwnerSpendCode] at step
    exact step
  have read : Step profile ready (specDispatch ready base) checked .tau leftWrite :=
    .hostGet (th := check.thread) (segs := check.frames) (rest := check.rest) (k := writeAfter leftTicket) rfl
  have peerRead : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) raw .tau rightWrite :=
    .hostGet (th := canon.thread) (segs := canon.frames) (rest := canon.rest) (k := writeAfter rightTicket) rfl
  have commit : Step profile ready (specDispatch ready base) leftWrite .tau leftDone :=
    .hostSet (th := check.thread) (segs := check.frames) (rest := check.rest)
      (s := leftDone.host) (k := fun _ => owner.afterSpend rep leftTicket) rfl
  have peerCommit : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) rightWrite .tau rightDone :=
    .hostSet (th := canon.thread) (segs := canon.frames) (rest := canon.rest)
      (s := rightDone.host) (k := fun _ => owner.afterSpend rep rightTicket) rfl
  have lhs : FramedQuietPath profile ready (specDispatch ready base) check start [id, id] leftWrite :=
    .step guard (by rw [transitionEdit, leftFocus]; rfl) rfl (.step read rfl rfl .done)
  have rhs : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon incoming [id, id] rightWrite :=
    .step peerGuard (by rw [transitionEdit, rightFocus]; rfl) rfl (.step peerRead rfl rfl .done)
  have leftPath : ComponentQuietPath profile ready (specDispatch ready base) check start [id, id, id] leftDone :=
    lhs.1.append (ComponentQuietPath.step (update := id) commit rfl (.done _))
  have rightPath : ComponentQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon incoming
      [id, id, id] rightDone :=
    rhs.1.append (ComponentQuietPath.step (update := id) peerCommit rfl (.done _))
  rcases splitSilent (count := 3) (.cons guard (.cons read (.cons commit (.refl _)))) run with ⟨remaining, used, tail⟩ | short
  · rw [used]
    obtain ⟨leftSpent, leftPrepared⟩ := reachedOwnerPrepared owner.resource owner.identity leftLive
    obtain ⟨rightSpent, rightPrepared⟩ := reachedOwnerPrepared owner.resource owner.identity rightLive
    have certified : ExecutedSharedOwnerSpend profile ready (specDispatch ready base) owner rep leftTicket start leftDone :=
      ⟨check, checked, leftWrite, leftSpent, leftFocus, leftPrepared, rfl, rfl, rfl, guard, read, commit⟩
    have rawCertified : ExecutedSharedOwnerSpend profile ready (specDispatch ready (LiveDispatch.host bindings base))
        owner rep rightTicket incoming rightDone :=
      ⟨canon, raw, rightWrite, rightSpent, rightFocus, rightPrepared, rfl, rfl, rfl, peerGuard, peerRead, peerCommit⟩
    have paths := CallbackPrefix.stationaryTransport (bindings := bindings) leftPath.track rightPath.track
    refine .destructorPrefix paths (.ownerCommit certified rawCertified) (fun aligned => aligned) ?_
    have within : remaining.length ≤ limit := by
      rw [used, List.length_append, List.length_replicate] at bounded
      omega
    exact finishDestructorNominalTransfer (check := check) (canon := canon) (leftTicket := leftTicket) (rightTicket := rightTicket)
      (owner.transfer rep) (sharedOwnerTransferEffects owner rep) parents thread segments stores rfl rfl tail scheduler within compare
  · exact finishDestructorFramedCut lhs rhs run (by simp only [List.length_cons, List.length_nil]; omega)

open ReturnFrame.Occurrence Stored.OwnedMemory.Claims in
private theorem finishDestructorEndpointGive {limit : Nat} {body : ThreadBody (core3 grow)}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    {leftTicket rightTicket : Nat} (endpoint : SharedEndpointGive)
    (parents : DestructorParentChain older body check.rest canon.rest)
    (thread : check.thread = canon.thread)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) check.frames canon.frames)
    (stores : start.store = incoming.store)
    (leftFocus : start.ctl = check.control (endpoint.claim.probe endpoint.inst leftTicket))
    (rightFocus : incoming.ctl = canon.control (endpoint.claim.probe endpoint.inst rightTicket))
    (leftLive : endpoint.claim.observe start.host.writer = .ok ())
    (rightLive : endpoint.claim.observe incoming.host.writer = .ok ())
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (scheduler : DestructorSchedulerAlignment older start incoming)
    (bounded : labels.length ≤ limit) (compare : ShorterCallbackSlices profile ready base bindings limit) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  let checked := { start with ctl := check.control (endpoint.checkedStore leftTicket) }
  let raw := { incoming with ctl := canon.control (endpoint.checkedStore rightTicket) }
  have guard : Step profile ready (specDispatch ready base) start .tau checked := by
    have step : Step profile ready (specDispatch ready base) start .tau
        { start with ctl := check.control (endpoint.claim.afterRead endpoint.inst leftTicket (endpoint.claim.observe start.host.writer)) } :=
      .hostGet (th := check.thread) (segs := check.frames) (rest := check.rest) leftFocus
    rw [leftLive, sharedEndpointReadyCode] at step
    exact step
  have peerGuard : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau raw := by
    have step : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau
        { incoming with ctl := canon.control (endpoint.claim.afterRead endpoint.inst rightTicket (endpoint.claim.observe incoming.host.writer)) } :=
      .hostGet (th := canon.thread) (segs := canon.frames) (rest := canon.rest) rightFocus
    rw [rightLive, sharedEndpointReadyCode] at step
    exact step
  let leftReady := { checked with ctl := check.control (endpoint.afterReady leftTicket start.store) }
  let rightReady := { raw with ctl := canon.control (endpoint.afterReady rightTicket incoming.store) }
  have readiness : Step profile ready (specDispatch ready base) checked .tau leftReady := .get rfl
  have peerReadiness : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) raw .tau rightReady := .get rfl
  have lhs : FramedQuietPath profile ready (specDispatch ready base) check start [id, id] leftReady :=
    .step guard (by rw [transitionEdit, leftFocus]; rfl) rfl (.step readiness rfl rfl .done)
  have rhs : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon incoming [id, id] rightReady :=
    .step peerGuard (by rw [transitionEdit, rightFocus]; rfl) rfl (.step peerReadiness rfl rfl .done)
  cases verdict : Async.Transfer.readyToGive start.store endpoint.channel endpoint.element ⟨endpoint.identity⟩ with
  | error issue =>
    rcases splitSilent (count := 2) (.cons guard (.cons readiness (.refl _))) run with ⟨remaining, used, tail⟩ | short
    · rw [used]
      have paths := CallbackPrefix.stationaryTransport (bindings := bindings) lhs.1.track rhs.1.track
      refine .destructorPrefix paths (.framed lhs.2 rhs.2) (fun aligned => aligned) ?_
      have within : remaining.length ≤ limit := by rw [used, List.length_append, List.length_replicate] at bounded; omega
      exact finishDestructorScheduledReply (check := check) (canon := canon) (start := leftReady) (incoming := rightReady)
        (leftTicket := leftTicket) (rightTicket := rightTicket) parents thread segments stores (.error (.claim (.endpointTransfer issue)))
        (by simp only [leftReady, SharedEndpointGive.afterReady, verdict]; rfl)
        (by simp only [rightReady, SharedEndpointGive.afterReady, ← stores, verdict]; rfl)
        scheduler tail within compare
    · exact finishDestructorFramedCut lhs rhs run (by simp only [List.length_cons, List.length_nil]; omega)
  | ok valid =>
    cases valid
    let leftSpend := { checked with ctl := check.control (endpoint.spend leftTicket) }
    let rightSpend := { raw with ctl := canon.control (endpoint.spend rightTicket) }
    have leftSelected : leftReady = leftSpend := by simp only [leftReady, leftSpend, SharedEndpointGive.afterReady, verdict]
    have rightSelected : rightReady = rightSpend := by
      simp only [rightReady, rightSpend, SharedEndpointGive.afterReady, ← stores, verdict]
    let spendHost (host : HostState sig) : HostState sig :=
      { host with writer := (Spend.endpoint endpoint.identity).apply host.writer }
    let writeAfter (ticket : Nat) (host : HostState sig) : Session grow sig (Ret (core3 grow)) :=
      .op (.hostSet (spendHost host)) (fun _ => endpoint.afterSpend ticket)
    let leftWrite := { leftSpend with ctl := check.control (writeAfter leftTicket leftSpend.host) }
    let rightWrite := { rightSpend with ctl := canon.control (writeAfter rightTicket rightSpend.host) }
    let leftDone := { leftWrite with host := spendHost leftWrite.host, ctl := check.control (endpoint.afterSpend leftTicket) }
    let rightDone := { rightWrite with host := spendHost rightWrite.host, ctl := canon.control (endpoint.afterSpend rightTicket) }
    have read : Step profile ready (specDispatch ready base) leftSpend .tau leftWrite :=
      .hostGet (th := check.thread) (segs := check.frames) (rest := check.rest) (k := writeAfter leftTicket) rfl
    have peerRead : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) rightSpend .tau rightWrite :=
      .hostGet (th := canon.thread) (segs := canon.frames) (rest := canon.rest) (k := writeAfter rightTicket) rfl
    have commit : Step profile ready (specDispatch ready base) leftWrite .tau leftDone :=
      .hostSet (th := check.thread) (segs := check.frames) (rest := check.rest)
        (s := leftDone.host) (k := fun _ => endpoint.afterSpend leftTicket) rfl
    have peerCommit : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) rightWrite .tau rightDone :=
      .hostSet (th := canon.thread) (segs := canon.frames) (rest := canon.rest)
        (s := rightDone.host) (k := fun _ => endpoint.afterSpend rightTicket) rfl
    have leftPrepared : FramedQuietPath profile ready (specDispatch ready base) check start [id, id] leftSpend :=
      leftSelected ▸ lhs
    have rightPrepared : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon incoming [id, id] rightSpend :=
      rightSelected ▸ rhs
    have leftQuiet : FramedQuietPath profile ready (specDispatch ready base) check start [id, id, id] leftWrite :=
      leftPrepared.append (.step (update := id) read rfl rfl .done)
    have rightQuiet : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon incoming [id, id, id] rightWrite :=
      rightPrepared.append (.step (update := id) peerRead rfl rfl .done)
    have leftPath : ComponentQuietPath profile ready (specDispatch ready base) check start [id, id, id, id] leftDone :=
      leftQuiet.1.append (ComponentQuietPath.step (update := id) commit rfl (.done _))
    have rightPath : ComponentQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon incoming
        [id, id, id, id] rightDone :=
      rightQuiet.1.append (ComponentQuietPath.step (update := id) peerCommit rfl (.done _))
    rcases splitSilent (leftPath.track (.active 0 0)).toTrail.steps run with ⟨remaining, used, tail⟩ | short
    · rw [used]
      have certified : ExecutedSharedEndpointSpend profile ready (specDispatch ready base) endpoint leftTicket start leftDone :=
        ⟨check, checked, leftSpend, leftWrite, leftFocus, sharedEndpointLive endpoint leftLive, verdict,
          rfl, rfl, rfl, rfl, guard, leftSelected ▸ readiness, read, commit⟩
      have rawCertified : ExecutedSharedEndpointSpend profile ready (specDispatch ready (LiveDispatch.host bindings base))
          endpoint rightTicket incoming rightDone :=
        ⟨canon, raw, rightSpend, rightWrite, rightFocus, sharedEndpointLive endpoint rightLive, stores ▸ verdict,
          rfl, rfl, rfl, rfl, peerGuard, rightSelected ▸ peerReadiness, peerRead, peerCommit⟩
      have paths := CallbackPrefix.stationaryTransport (bindings := bindings) leftPath.track rightPath.track
      refine .destructorPrefix paths (.endpointCommit certified rawCertified) (fun aligned => aligned) ?_
      have within : remaining.length ≤ limit := by rw [used, List.length_append, List.length_replicate] at bounded; omega
      exact finishDestructorNominalTransfer (check := check) (canon := canon) (leftTicket := leftTicket) (rightTicket := rightTicket)
        endpoint.transfer (sharedEndpointTransferEffects endpoint) parents thread segments stores rfl rfl tail scheduler within compare
    · exact finishDestructorFramedCut leftQuiet rightQuiet run (by simp only [List.length_cons, List.length_nil] at short ⊢; omega)

open ReturnFrame.Occurrence in
private theorem finishNestedDestructorStart {limit : Nat} {parentBody : ThreadBody (core3 grow)}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    {request : InstId × DtorRequest (core3 grow)} {impl task leftTicket rightTicket}
    (parents : DestructorParentChain older parentBody check.rest canon.rest)
    (thread : check.thread = canon.thread)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) check.frames canon.frames)
    (implementation : request.2.impl = some impl)
    (stores : start.store = incoming.store)
    (leftAt : start.ctl = check.control (sharedDestructorStart leftTicket (some (sharedDestructorThread task request.2.dtor))))
    (rightAt : incoming.ctl = canon.control (sharedDestructorStart rightTicket (some (sharedDestructorThread task request.2.dtor))))
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (scheduler : DestructorSchedulerAlignment older start incoming)
    (bounded : labels.length ≤ limit) (compare : ShorterCallbackSlices profile ready base bindings limit) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  classical
  let body := sharedDestructorThread task request.2.dtor
  let allocated := ArenaField.threads.alloc start.store { task := body.task }
  let worker := allocated.2
  let saved := StepDefs.threadAct (specDispatch ready base) worker body
  have savedAgreement : StepDefs.threadAct (specDispatch ready (LiveDispatch.host bindings base)) worker body = saved := by
    change Activation.ofProg (some worker) (specDispatch ready (LiveDispatch.host bindings base) (.threadBody body)) =
      Activation.ofProg (some worker) (specDispatch ready base (.threadBody body))
    rw [← LiveDispatch.unchanged_dispatch (ready := ready) (base := base) (bindings := bindings)
      (call := .threadBody body) trivial]
  let left := { start.setCont worker (some saved) with
    store := allocated.1, ctl := check.control (sharedDestructorAfterInstall body leftTicket worker) }
  let right := { incoming.setCont worker (some saved) with
    store := allocated.1, ctl := canon.control (sharedDestructorAfterInstall body rightTicket worker) }
  have leftAlloc : Step profile ready (specDispatch ready base) start .tau left := .newThread leftAt rfl
  have rawAllocated : ArenaField.threads.alloc incoming.store { task := body.task } = (allocated.1, worker) := by rw [← stores]
  have rightAlloc : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau right := by
    have raw := Step.newThread (prof := profile) (hr := ready) (dispatch := specDispatch ready (LiveDispatch.host bindings base))
      rightAt rawAllocated
    rw [savedAgreement] at raw
    exact raw
  rcases splitSilent (count := 1) (.cons leftAlloc (.refl _)) run with ⟨afterAlloc, usedAlloc, restRun⟩ | short
  · rw [usedAlloc]
    have installed := sharedSchedulerTransport (bindings := bindings) (edit := .write worker.idx []) leftAlloc rightAlloc
      (by rw [transitionEdit, leftAt]; rfl)
      (by rw [transitionEdit, rightAt]; change (Edit.write (ArenaField.threads.alloc incoming.store { task := body.task }).2.idx [] :
        Edit (core3 grow) (HostState sig)) = .write worker.idx []; rw [rawAllocated])
    have afterInstall (before : DestructorSchedulerAlignment older start incoming) : DestructorSchedulerAlignment older left right :=
      ⟨relatedSetSlot .none before.1 worker.idx (.some (.mk .nil)), before.2⟩
    refine .destructorPrefix installed (frameCalloutStep installed rfl rfl) afterInstall ?_
    let leftResume := { left with
      store := destructorResumeStore worker left.store, ctl := check.control (.op (.resumeThread worker) (fun _ => sharedDestructorAfterResume body leftTicket)) }
    let rightResume := { right with
      store := destructorResumeStore worker right.store, ctl := canon.control (.op (.resumeThread worker) (fun _ => sharedDestructorAfterResume body rightTicket)) }
    have beforeResume := sharedDestructorResumePath (profile := profile) (ready := ready) (dispatch := specDispatch ready base)
      (start := left) body leftTicket worker check rfl
    have rawBeforeResume := sharedDestructorResumePath (profile := profile) (ready := ready)
      (dispatch := specDispatch ready (LiveDispatch.host bindings base)) (start := right) body rightTicket worker canon rfl
    obtain ⟨used, remaining, reached, peer, split, paths, writers, residual, ending⟩ :=
      cutSharedQuietWorker beforeResume rawBeforeResume restRun
    rw [split]
    rcases ending with empty | ⟨rfl, rfl⟩
    · subst remaining
      cases residual
      exact .comparedPrefix paths writers .exhausted
    · refine .destructorPrefix paths writers (fun aligned => aligned) ?_
      have leftFound : leftResume.cont? worker = some saved := Config.cont?_setCont_self start worker (some saved)
      have rightFound : rightResume.cont? worker = some saved := Config.cont?_setCont_self incoming worker (some saved)
      let lhs := { leftResume.setCont worker none with
        store := StepDefs.threadStatusSt worker .running leftResume.store, ctl := saved :: check.control (sharedDestructorAfterResume body leftTicket) }
      let rhs := { rightResume.setCont worker none with
        store := StepDefs.threadStatusSt worker .running rightResume.store, ctl := saved :: canon.control (sharedDestructorAfterResume body rightTicket) }
      have leftStep : Step profile ready (specDispatch ready base) leftResume .tau lhs :=
        .resumeThread (th := check.thread) (k := fun _ => sharedDestructorAfterResume body leftTicket)
          (segs := check.frames) (rest := check.rest) rfl leftFound
      have rawStep : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) rightResume .tau rhs :=
        .resumeThread (th := canon.thread) (k := fun _ => sharedDestructorAfterResume body rightTicket)
          (segs := canon.frames) (rest := canon.rest) rfl rightFound
      rcases splitSilent (count := 1) (.cons leftStep (.refl _)) residual with ⟨suffix, usedResume, tail⟩ | short
      · rw [usedResume]
        have moved := sharedSchedulerTransport (bindings := bindings) (edit := .resume worker.idx) leftStep rawStep rfl rfl
        have afterResume (before : DestructorSchedulerAlignment older leftResume rightResume) :
            DestructorSchedulerAlignment older lhs rhs :=
          ⟨relatedSetSlot .none before.1 worker.idx .none, before.2⟩
        refine .destructorPrefix moved (frameCalloutStep moved rfl rfl) afterResume ?_
        have aligned : DestructorSchedulerAlignment older lhs rhs := afterResume (afterInstall scheduler)
        by_cases tickets : leftTicket = rightTicket
        · have parent : ReturnFrame.Related.Active older
              ⟨check.thread, .prog (sharedDestructorAfterResume body leftTicket), check.frames⟩
              ⟨canon.thread, .prog (sharedDestructorAfterResume body rightTicket), canon.frames⟩ := by
            rw [← thread, ← tickets]
            exact .mk segments
          have target : ReturnFrame.Related.Active older saved saved := .mk .nil
          have within : suffix.length ≤ limit := by
            rw [usedAlloc, split, usedResume] at bounded
            simp only [List.length_append, List.length_replicate] at bounded
            omega
          exact finishDestructorSwitchTarget parents target (.cons parent .nil) rfl aligned rfl rfl tail within compare
        · have checkedResume : SharedDestructorResumed profile ready (specDispatch ready base)
              body leftTicket worker leftResume lhs check := ⟨rfl, leftFound, leftStep, rfl⟩
          have canonicalResume : SharedDestructorResumed profile ready (specDispatch ready (LiveDispatch.host bindings base))
              body rightTicket worker rightResume rhs canon :=
            ⟨rfl, savedAgreement.symm ▸ rightFound, rawStep, by simp only [rhs, savedAgreement]⟩
          exact .sharedDropNestedResumed (request := request) (task := task) parents thread segments implementation tickets rfl aligned checkedResume canonicalResume tail
      · have empty : remaining = [] := List.length_eq_zero_iff.mp (by omega)
        have stopped := stepsAtEmpty (empty ▸ residual)
        rw [empty, stopped]
        exact .exhausted
  · have empty : labels = [] := List.length_eq_zero_iff.mp (by omega)
    have stopped := stepsAtEmpty (empty ▸ run)
    rw [empty, stopped]
    exact .exhausted

private theorem finishDestructorDropSetup {limit : Nat} {body : ThreadBody (core3 grow)}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)} {leftTicket rightTicket : Nat}
    (result : InstId × DtorRequest (core3 grow))
    (parents : DestructorParentChain older body check.rest canon.rest)
    (thread : check.thread = canon.thread)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) check.frames canon.frames)
    (stores : start.store = incoming.store)
    (checked : start.ctl = check.control (SharedOwnerDrop.afterSpend leftTicket result))
    (canonical : incoming.ctl = canon.control (SharedOwnerDrop.afterSpend rightTicket result))
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (scheduler : DestructorSchedulerAlignment older start incoming)
    (bounded : labels.length ≤ limit) (compare : ShorterCallbackSlices profile ready base bindings limit) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  cases implementation : result.2.impl with
  | none =>
    rw [sharedDestructorCode] at checked canonical
    simp only [sharedDestructorWorker, implementation, sharedDestructorStart, Prog.pure_eq,
      Prog.bind_eq, Prog.pure_bind'] at checked canonical
    exact finishDestructorScheduledReply parents thread segments stores (.ok 0) checked canonical scheduler run bounded compare
  | some impl =>
    rw [sharedDestructorTaskCode result impl implementation] at checked canonical
    have effects : StoreEffects (sharedDestructorTask result impl : Session grow sig TaskId) := by
      unfold sharedDestructorTask sharedDestructorTaskDescription
      refine ((sharedDestructorResourceRepEffects result).bind fun rep => ?_).bind fun entry =>
        storeEffectArenaAlloc ArenaField.tasks entry.val
      exact (storeEffectArenaAlloc ArenaField.callers (.sub (.destructor result.2.rep))).bind fun caller =>
        .pure (sharedDestructorTaskRecord impl rep caller)
    exact crossSharedWorkerBodyWith (check := check) (canon := canon) thread (sharedDestructorTask result impl)
      (fun task => sharedDestructorStart leftTicket (some (sharedDestructorThread task result.2.dtor)))
      (fun task => sharedDestructorStart rightTicket (some (sharedDestructorThread task result.2.dtor)))
      (liftDestructorStoreEffects effects (trivialPreserves _)) trivial stores
      (by simpa [sharedDestructorTask, sharedDestructorTaskDescription, bind, Prog.bind_assoc] using checked)
      (by simpa [sharedDestructorTask, sharedDestructorTaskDescription, bind, Prog.bind_assoc] using canonical) run
      (fun task shorter _ same atLeft atRight aligned tail =>
        finishNestedDestructorStart (request := result) (task := task) (check := check) (canon := canon)
          parents thread segments implementation same atLeft atRight tail (aligned scheduler) (shorter.trans bounded) compare)

open ReturnFrame.Occurrence Stored.OwnedMemory.Claims in
private theorem finishDestructorOwnerDrop {limit : Nat} {body : ThreadBody (core3 grow)}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    {rep leftTicket rightTicket : Nat} (drop : SharedOwnerDrop)
    (parents : DestructorParentChain older body check.rest canon.rest)
    (thread : check.thread = canon.thread)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) check.frames canon.frames)
    (stores : start.store = incoming.store)
    (leftFocus : start.ctl = check.control (drop.claim.probe drop.inst leftTicket))
    (rightFocus : incoming.ctl = canon.control (drop.claim.probe drop.inst rightTicket))
    (leftLive : drop.claim.observe start.host.writer = .ok rep)
    (rightLive : drop.claim.observe incoming.host.writer = .ok rep)
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (scheduler : DestructorSchedulerAlignment older start incoming)
    (bounded : labels.length ≤ limit) (compare : ShorterCallbackSlices profile ready base bindings limit) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  let checked := { start with ctl := check.control (drop.prepare rep >>= drop.spend leftTicket) }
  let raw := { incoming with ctl := canon.control (drop.prepare rep >>= drop.spend rightTicket) }
  have guard : Step profile ready (specDispatch ready base) start .tau checked := by
    have step : Step profile ready (specDispatch ready base) start .tau
        { start with ctl := check.control (drop.claim.afterRead drop.inst leftTicket (drop.claim.observe start.host.writer)) } :=
      .hostGet (th := check.thread) (segs := check.frames) (rest := check.rest) leftFocus
    rw [leftLive, sharedOwnerDropCode] at step
    exact step
  have peerGuard : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau raw := by
    have step : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau
        { incoming with ctl := canon.control (drop.claim.afterRead drop.inst rightTicket (drop.claim.observe incoming.host.writer)) } :=
      .hostGet (th := canon.thread) (segs := canon.frames) (rest := canon.rest) rightFocus
    rw [rightLive, sharedOwnerDropCode] at step
    exact step
  let Frame (left right : Config (core3 grow) (HostState sig)) :=
    left.store = right.store ∧ DestructorSchedulerAlignment older left right
  cases run with
  | refl => exact .exhausted
  | @cons _ _ _ _ trailing first tail =>
    obtain ⟨rfl, rfl⟩ := silentStepUnique guard first
    have guards := sharedSchedulerTransport (bindings := bindings) (edit := .same) guard peerGuard
      (by rw [transitionEdit, leftFocus]; rfl) (by rw [transitionEdit, rightFocus]; rfl)
    obtain ⟨prep, suffix, reached, peer, split, paths, residual, frontier, _, _, leftPath, rightPath, _⟩ :=
      cutStoreBodyFramed (check := check) (canon := canon) (start := checked) (incoming := raw)
        (closed := True) (drop.prepare rep) (drop.spend leftTicket) (drop.spend rightTicket)
        (fun _ => sharedDropPrepareEffects drop rep) (trivialPreserves _) trivial rfl rfl
        Frame (fun aligned => aligned.1) (fun aligned _ _ _ => ⟨rfl, aligned.2⟩)
        thread ⟨stores, scheduler⟩ tail
    obtain ⟨_, through, _⟩ := CallbackPrefix.transportAppend guards paths
    have throughPrep : OccurrenceTransport profile ready base bindings start incoming
        (.tau :: prep) (.tau :: prep) reached peer := through
    have prepWriters : VisitorWriterPath profile ready base bindings start incoming
        (.tau :: prep) (.tau :: prep) reached peer := (frameCalloutStep guards rfl rfl).append (.framed leftPath rightPath)
    have stop (ending : suffix = [] ∨ (reached.ctl = [] ∧ peer.ctl = [])) :
        CallbackSliceEnd profile ready base bindings older start incoming (.tau :: trailing) finish := by
      rw [split, ← List.cons_append]
      exact .coreAcceptTerminal throughPrep prepWriters residual
        (ending.elim Or.inl (fun traps => .inr (.inr (.inr traps))))
    cases frontier with
    | pending _ _ _ _ _ boundary => exact stop (.inl (boundary.resolve_right (fun openBody => openBody.1 trivial)))
    | trapped leftEmpty rightEmpty _ => exact stop (.inr ⟨leftEmpty, rightEmpty⟩)
    | returned result leftAt rightAt frame =>
      let spendHost (host : HostState sig) : HostState sig :=
        { host with writer := (Spend.owner drop.identity).apply host.writer }
      let writeAfter (ticket : Nat) (host : HostState sig) : Session grow sig (Ret (core3 grow)) :=
        .op (.hostSet (spendHost host)) (fun _ => SharedOwnerDrop.afterSpend ticket result)
      let leftWrite := { reached with ctl := check.control (writeAfter leftTicket reached.host) }
      let rightWrite := { peer with ctl := canon.control (writeAfter rightTicket peer.host) }
      let leftDone := { leftWrite with
        host := spendHost leftWrite.host
        ctl := check.control (SharedOwnerDrop.afterSpend leftTicket result) }
      let rightDone := { rightWrite with
        host := spendHost rightWrite.host
        ctl := canon.control (SharedOwnerDrop.afterSpend rightTicket result) }
      have read : Step profile ready (specDispatch ready base) reached .tau leftWrite :=
        .hostGet (th := check.thread) (segs := check.frames) (rest := check.rest) (k := writeAfter leftTicket) leftAt
      have peerRead : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) peer .tau rightWrite :=
        .hostGet (th := canon.thread) (segs := canon.frames) (rest := canon.rest) (k := writeAfter rightTicket) rightAt
      have readPaths := sharedSchedulerTransport (bindings := bindings) (edit := .same) read peerRead
        (by rw [transitionEdit, leftAt]; rfl) (by rw [transitionEdit, rightAt]; rfl)
      have commit : Step profile ready (specDispatch ready base) leftWrite .tau leftDone :=
        .hostSet (th := check.thread) (segs := check.frames) (rest := check.rest)
          (s := leftDone.host) (k := fun _ => SharedOwnerDrop.afterSpend leftTicket result) rfl
      have peerCommit : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) rightWrite .tau rightDone :=
        .hostSet (th := canon.thread) (segs := canon.frames) (rest := canon.rest)
          (s := rightDone.host) (k := fun _ => SharedOwnerDrop.afterSpend rightTicket result) rfl
      rcases splitSilent (count := 2) (.cons read (.cons commit (.refl _))) residual with ⟨remaining, used, tail⟩ | short
      · obtain ⟨leftSpent, leftPrepared⟩ := reachedOwnerPrepared drop.resource drop.identity leftLive
        obtain ⟨rawSpent, rawPrepared⟩ := reachedOwnerPrepared drop.resource drop.identity rightLive
        have proof : ExecutedSharedDropSpend profile ready (specDispatch ready base) drop rep leftTicket result prep start leftDone :=
          ⟨check, checked, reached, leftWrite, leftSpent, leftFocus, leftPrepared, rfl, leftAt, rfl, rfl, guard, leftPath, read, commit⟩
        have rawProof : ExecutedSharedDropSpend profile ready (specDispatch ready (LiveDispatch.host bindings base))
            drop rep rightTicket result prep incoming rightDone :=
          ⟨canon, raw, peer, rightWrite, rawSpent, rightFocus, rawPrepared, rfl, rightAt, rfl, rfl, peerGuard, rightPath, peerRead, peerCommit⟩
        have commitPaths := sharedSchedulerTransport (bindings := bindings) (edit := .same) commit peerCommit rfl rfl
        obtain ⟨_, wrote, _⟩ := CallbackPrefix.transportAppend readPaths commitPaths
        have throughWrite : OccurrenceTransport profile ready base bindings reached peer [.tau, .tau] [.tau, .tau] leftDone rightDone := wrote
        obtain ⟨_, whole, _⟩ := CallbackPrefix.transportAppend throughPrep throughWrite
        have compared : OccurrenceTransport profile ready base bindings start incoming (.tau :: (prep ++ [.tau, .tau]))
            (.tau :: (prep ++ [.tau, .tau])) leftDone rightDone := whole
        have splitAfter : .tau :: trailing = (.tau :: (prep ++ [.tau, .tau])) ++ remaining := by
          rw [split, used]
          simp only [List.replicate_succ, List.replicate_zero, List.cons_append, List.nil_append, List.append_assoc]
        rw [splitAfter]
        refine .destructorPrefix compared (.dropCommit proof rawProof) (fun _ => frame.2) ?_
        have within : remaining.length ≤ limit := by
          rw [splitAfter] at bounded
          simp only [List.length_append, List.length_cons, List.length_nil] at bounded
          omega
        exact finishDestructorDropSetup (check := check) (canon := canon) (leftTicket := leftTicket) (rightTicket := rightTicket)
          result parents thread segments frame.1 rfl rfl tail frame.2 within compare
      · rw [split, ← List.cons_append]
        refine .comparedPrefix throughPrep prepWriters ?_
        have leftQuiet : FramedQuietPath profile ready (specDispatch ready base) check reached [id] leftWrite :=
          .step read (by rw [transitionEdit, leftAt]; rfl) rfl .done
        have rightQuiet : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon peer [id] rightWrite :=
          .step peerRead (by rw [transitionEdit, rightAt]; rfl) rfl .done
        exact finishDestructorFramedCut leftQuiet rightQuiet residual (by simp only [List.length_cons, List.length_nil]; omega)

open ReturnFrame.Occurrence in
private theorem finishDestructorSelectedSharedGive {limit : Nat} {body : ThreadBody (core3 grow)}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    {name kind inst position leftTicket rightTicket} {action : SharedGiveAction} {tree : Stored.OwnedMemory.Tree sig}
    (parents : DestructorParentChain older body check.rest canon.rest)
    (thread : check.thread = canon.thread)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) check.frames canon.frames)
    (linked : resolveBinding bindings name kind = .ok ⟨name, inst, action.bindingAction⟩)
    (present : ¬ missingSharedPosition action tree position)
    (stores : start.store = incoming.store)
    (checked : start.ctl = check.control (action.afterLookup inst leftTicket position (some tree)))
    (canonical : incoming.ctl = canon.control (action.afterLookup inst rightTicket position (some tree)))
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (scheduler : DestructorSchedulerAlignment older start incoming)
    (bounded : labels.length ≤ limit) (compare : ShorterCallbackSlices profile ready base bindings limit) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  classical
  cases source : action.claimAt tree position with
  | none =>
    have record : ∃ destination, action = .record destination := by
      cases action with
      | record destination => exact ⟨destination, rfl⟩
      | giveOwner resource => exact (present (Option.map_eq_none_iff.mp source)).elim
      | dropOwner resource => exact (present (Option.map_eq_none_iff.mp source)).elim
      | endpoint channel element => exact (present (Option.map_eq_none_iff.mp source)).elim
    obtain ⟨destination, rfl⟩ := record
    exact finishDestructorSharedRecord destination parents thread segments linked stores checked canonical run scheduler bounded compare
  | some claim =>
    rw [sharedClaimProgram action inst _ position tree source] at checked canonical
    cases run with
    | refl => exact .exhausted
    | cons actual tail =>
      let lhs := claim.observe start.host.writer
      let rhs := claim.observe incoming.host.writer
      let left := { start with ctl := check.control (claim.afterRead inst leftTicket lhs) }
      let right := { incoming with ctl := canon.control (claim.afterRead inst rightTicket rhs) }
      have checkedRead : Step profile ready (specDispatch ready base) start .tau left :=
        .hostGet (th := check.thread) (segs := check.frames) (rest := check.rest) checked
      have rawRead : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau right :=
        .hostGet (th := canon.thread) (segs := canon.frames) (rest := canon.rest) canonical
      obtain ⟨rfl, rfl⟩ := silentStepUnique checkedRead actual
      have paths := sharedSchedulerTransport (bindings := bindings) (edit := .same) checkedRead rawRead
        (by rw [transitionEdit, checked]; rfl) (by rw [transitionEdit, canonical]; rfl)
      by_cases agrees : lhs = rhs
      · cases observed : lhs with
        | error issue =>
          refine .destructorPrefix paths (frameCalloutStep paths rfl rfl) (fun aligned => aligned) ?_
          exact finishDestructorScheduledReply (check := check) (canon := canon) (start := left) (incoming := right)
            parents thread segments stores (.error (.claim issue))
            (by change check.control (claim.afterRead inst leftTicket lhs) = _; rw [observed]; rfl)
            (by change canon.control (claim.afterRead inst rightTicket rhs) = _; rw [← agrees, observed]; rfl)
            scheduler tail (Nat.le_trans (Nat.le_succ _) bounded) compare
        | ok permit =>
          cases claim with
          | giveOwner resource identity =>
            exact finishDestructorOwnerGive ⟨resource, identity, inst⟩ parents thread segments stores checked canonical
              observed (agrees.symm.trans observed) (.cons checkedRead tail) scheduler bounded compare
          | endpoint channel element identity =>
            cases permit
            exact finishDestructorEndpointGive ⟨channel, element, identity, inst⟩ parents thread segments stores
              checked canonical observed (agrees.symm.trans observed) (.cons checkedRead tail) scheduler bounded compare
          | dropOwner resource identity =>
            exact finishDestructorOwnerDrop ⟨resource, identity, inst⟩ parents thread segments stores checked canonical
              observed (agrees.symm.trans observed) (.cons checkedRead tail) scheduler bounded compare
      · have mismatch : SharedGiveProbeMismatch claim inst leftTicket rightTicket start incoming left right check canon :=
          ⟨checked, canonical, rfl, rfl, agrees⟩
        exact .sharedGiveProbeMismatch linked source mismatch paths
          (.sharedGiveMismatch mismatch (.same checkedRead rfl (.done _)) (.same rawRead rfl (.done _))) tail

open ReturnFrame.Occurrence in
private theorem finishAdmittedSharedDestructor {limit : Nat}
    {worker frames peerFrames rest peerRest name kind args inst parentBody} {action : SharedGiveAction}
    {frame : Seg (core3 grow) (HostState sig)}
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (linked : resolveBinding bindings name kind = .ok ⟨name, inst, action.bindingAction⟩)
    (caller : Plain.callerInstance start.store (some worker) = .ok (some inst))
    (mayLeave : (start.store.inst? inst).any (·.mayLeave) = true)
    (parents : DestructorParentChain older parentBody rest peerRest)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) frames peerFrames)
    (stores : start.store = incoming.store)
    (checked : start.ctl = (PayloadPrefix.Cursor.mk (some worker) (frame :: frames) rest).control
      (calloutBody Limits.spec Quirks.none ready base start.store (some worker) (.embedder name kind) args))
    (canonical : incoming.ctl = (PayloadPrefix.Cursor.mk (some worker) (frame :: peerFrames) peerRest).control
      (calloutBody Limits.spec Quirks.none ready (LiveDispatch.host bindings base) incoming.store (some worker) (.embedder name kind) args))
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (scheduler : DestructorSchedulerAlignment older start incoming)
    (bounded : labels.length ≤ limit) (compare : ShorterCallbackSlices profile ready base bindings limit) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  classical
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, frame :: frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, frame :: peerFrames, peerRest⟩
  have leftEntry := scheduledEntryPath (profile := profile) (start := start) base (sharedGiveRoute linked)
    (congrFun (congrFun (congrFun embedder name) kind) args) check rfl caller mayLeave checked
  have rightEntry := scheduledEntryPath (profile := profile) (start := incoming) (LiveDispatch.host bindings base)
    (sharedGiveRoute linked) (sharedGiveRawEmbedder linked embedder) canon rfl (stores ▸ caller) (stores ▸ mayLeave) canonical
  let leftSelection := { start with
    host := start.host.enter name kind args
    ctl := check.control (action.selection args >>= finishSharedSelection action inst start.host.nextTicket) }
  let rightSelection := { incoming with
    host := incoming.host.enter name kind args
    ctl := canon.control (action.selection args >>= finishSharedSelection action inst incoming.host.nextTicket) }
  have leftScan := scanSelectorPath (profile := profile) (ready := ready) (dispatch := specDispatch ready base)
    (start := leftSelection) check (action.selection args) (finishSharedSelection action inst start.host.nextTicket) rfl
  have rightScan := scanSelectorPath (profile := profile) (ready := ready) (dispatch := specDispatch ready (LiveDispatch.host bindings base))
    (start := rightSelection) canon (action.selection args) (finishSharedSelection action inst incoming.host.nextTicket) rfl
  rw [sharedGiveBeforeSelection] at leftEntry rightEntry
  generalize scanned : scanSelector start.store (some worker) (action.selection (sig := sig) args) = reached
  obtain ⟨count, program⟩ := reached
  have rightScanned : scanSelector incoming.store (some worker) (action.selection (sig := sig) args) = (count, program) :=
    stores ▸ scanned
  dsimp only [leftSelection, rightSelection, check, canon] at leftScan rightScan
  rw [scanned] at leftScan
  rw [rightScanned] at rightScan
  have selected := sharedSelectionFrontier action args start.store (some worker) (sig := sig)
  rw [scanned] at selected
  have refusal {left right : Config (core3 grow) (HostState sig)} {edits}
      (lhs : FramedQuietPath profile ready (specDispatch ready base) check start edits left)
      (rhs : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon incoming edits right)
      (same : left.store = right.store)
      (keep : DestructorSchedulerAlignment older left right)
      (issue : Scheduled.Issue)
      (leftAt : left.ctl = check.control (do return .flat (← Scheduled.finish start.host.nextTicket (.error issue))))
      (rightAt : right.ctl = canon.control (do return .flat (← Scheduled.finish incoming.host.nextTicket (.error issue)))) :
      CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
    obtain ⟨used, remaining, reached, peer, split, paths, writers, tail, ending⟩ := cutSharedQuietWorker lhs rhs run
    rw [split]
    rcases ending with empty | ⟨rfl, rfl⟩
    · subst remaining
      cases tail
      exact .comparedPrefix paths writers .exhausted
    · refine .destructorPrefix paths writers (fun _ => keep) ?_
      have within : remaining.length ≤ limit := by rw [split, List.length_append] at bounded; omega
      exact finishDestructorScheduledReply (check := check) (canon := canon) parents rfl (.cons (.same _) segments) same (.error issue)
        leftAt rightAt keep tail within compare
  cases selected with
  | refused issue =>
    exact refusal (leftEntry.append leftScan) (rightEntry.append rightScan) stores scheduler issue rfl rfl
  | lookup handle position =>
    change FramedQuietPath _ _ _ check leftSelection (List.replicate count id)
      { leftSelection with ctl := check.control ((select handle >>= selectedAt position) >>=
        finishSharedSelection action inst start.host.nextTicket) } at leftScan
    change FramedQuietPath _ _ _ canon rightSelection (List.replicate count id)
      { rightSelection with ctl := canon.control ((select handle >>= selectedAt position) >>=
        finishSharedSelection action inst incoming.host.nextTicket) } at rightScan
    rw [sharedSelectionFinishLookup] at leftScan rightScan
    have lhs := leftEntry.append leftScan
    have rhs := rightEntry.append rightScan
    let leftBefore := { leftSelection with ctl := check.control (select handle >>= action.afterLookup inst start.host.nextTicket position) }
    let rightBefore := { rightSelection with ctl := canon.control (select handle >>= action.afterLookup inst incoming.host.nextTicket position) }
    let leftRoot := Stored.Endpoints.Core.childFromHistory leftBefore.host.writer.accepted handle
    let rightRoot := Stored.Endpoints.Core.childFromHistory rightBefore.host.writer.accepted handle
    let left := { leftBefore with ctl := check.control (action.afterLookup inst start.host.nextTicket position leftRoot) }
    let right := { rightBefore with ctl := canon.control (action.afterLookup inst incoming.host.nextTicket position rightRoot) }
    have leftRead := (selectorReadStep (profile := profile) (ready := ready) (dispatch := specDispatch ready base)
      check handle (action.afterLookup inst start.host.nextTicket position) (start := leftBefore) rfl).1
    have rightRead := (selectorReadStep (profile := profile) (ready := ready) (dispatch := specDispatch ready (LiveDispatch.host bindings base))
      canon handle (action.afterLookup inst incoming.host.nextTicket position) (start := rightBefore) rfl).1
    have leftPath : FramedQuietPath profile ready (specDispatch ready base) check start _ left :=
      lhs.append (trailing := [id]) (selectorReadStep check handle (action.afterLookup inst start.host.nextTicket position)
        (start := leftBefore) rfl).2
    have rightPath : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon incoming _ right :=
      rhs.append (trailing := [id]) (selectorReadStep canon handle (action.afterLookup inst incoming.host.nextTicket position)
        (start := rightBefore) rfl).2
    by_cases agrees : leftRoot = rightRoot
    · cases found : leftRoot with
      | none =>
        exact refusal leftPath rightPath stores scheduler .badSelection
          (by simp only [left, found, SharedGiveAction.afterLookup])
          (by simp only [right, ← agrees, found, SharedGiveAction.afterLookup])
      | some tree =>
        have leftAt : left.ctl = check.control (action.afterLookup inst start.host.nextTicket position (some tree)) := by
          rw [← found]
        have rightAt : right.ctl = canon.control (action.afterLookup inst incoming.host.nextTicket position (some tree)) := by
          rw [← found, agrees]
        by_cases missing : missingSharedPosition action tree position
        · rw [sharedPositionRefusal _ _ _ _ _ missing] at leftAt rightAt
          exact refusal leftPath rightPath stores scheduler .badSelection leftAt rightAt
        · obtain ⟨used, remaining, reached, peer, split, paths, writers, tail, ending⟩ :=
            cutSharedQuietWorker leftPath rightPath run
          rw [split]
          rcases ending with empty | ⟨rfl, rfl⟩
          · subst remaining
            cases tail
            exact .comparedPrefix paths writers .exhausted
          · refine .destructorPrefix paths writers (fun aligned => aligned) ?_
            have within : remaining.length ≤ limit := by rw [split, List.length_append] at bounded; omega
            exact finishDestructorSelectedSharedGive (check := check) (canon := canon) parents rfl (.cons (.same _) segments) linked missing stores
              leftAt rightAt tail scheduler within compare
    · obtain ⟨used, remaining, reached, peer, split, paths, writers, tail, ending⟩ := cutSharedQuietWorker lhs rhs run
      rw [split]
      rcases ending with empty | ⟨rfl, rfl⟩
      · subst remaining
        cases tail
        exact .comparedPrefix paths writers .exhausted
      · cases tail with
        | refl => exact .comparedPrefix paths writers .exhausted
        | cons actual residual =>
          obtain ⟨rfl, rfl⟩ := silentStepUnique leftRead actual
          have readPaths := sharedSchedulerTransport (bindings := bindings) (edit := .same) leftRead rightRead rfl rfl
          have mismatch : SharedGiveHistoryMismatch action inst start.host.nextTicket incoming.host.nextTicket position handle
              leftBefore rightBefore left right check canon := ⟨rfl, rfl, rfl, rfl, agrees⟩
          refine .comparedPrefix paths writers ?_
          exact .sharedGiveSelectionMismatch (leading := []) mismatch
            (fun place => ⟨place, .done _ _, .step leftRead (by cases place <;> exact .done _ _)⟩)
            (fun place => ⟨place, .done _ _, .step rightRead (by cases place <;> exact .done _ _)⟩)
            readPaths (frameCalloutStep readPaths rfl rfl) residual

private theorem finishSharedDestructorImport {limit : Nat}
    {thread frames peerFrames rest peerRest core host args task tk body}
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (parents : DestructorParentChain older body rest peerRest)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) frames peerFrames)
    (admitted : calloutEntry start.store thread host = none)
    (stores : start.store = incoming.store)
    (checked : start.ctl = ⟨thread, .prog (calloutBody Limits.spec Quirks.none ready base start.store thread host args),
      .core core (sharedDestructorCoreResult task tk) :: frames⟩ :: rest)
    (canonical : incoming.ctl = ⟨thread, .prog (calloutBody Limits.spec Quirks.none ready (LiveDispatch.host bindings base)
      incoming.store thread host args), .core core (sharedDestructorCoreResult task tk) :: peerFrames⟩ :: peerRest)
    (residual : Steps profile ready (specDispatch ready base) start labels finish)
    (scheduler : DestructorSchedulerAlignment older start incoming)
    (bounded : labels.length ≤ limit) (compare : ShorterCallbackSlices profile ready base bindings limit) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  have follow
      (code : calloutBody Limits.spec Quirks.none ready (LiveDispatch.host bindings base) incoming.store thread host args =
        calloutBody Limits.spec Quirks.none ready base start.store thread host args) :
      CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
    rw [code] at canonical
    exact finishDestructorSwitchTarget parents (.mk (.cons (.same _) segments)) .nil stores scheduler
      checked canonical residual bounded compare
  cases host with
  | embedder name kind =>
    classical
    by_cases legacy : ∃ inst loader, LinkedCoreAcceptLoader (grow := grow) bindings name kind args inst loader
    · obtain ⟨inst, loader, linked⟩ := legacy
      by_cases context : Plain.callerInstance start.store thread = .ok (some inst) ∧
          (start.store.inst? inst).any (·.mayLeave) = true
      · cases thread with
        | none => simp [Plain.callerInstance] at context
        | some worker =>
          exact finishAdmittedLegacyDestructor embedder linked context.1 context.2
            parents segments stores checked canonical residual scheduler bounded compare
      · exact finishDeniedDestructorImport embedder (coreAcceptRawEmbedder linked embedder) (coreAcceptRoute linked)
          context parents segments stores checked canonical residual scheduler bounded compare
    · by_cases shared : ∃ (inst : InstId) (action : SharedGiveAction),
          resolveBinding bindings name kind = .ok ⟨name, inst, action.bindingAction⟩
      · obtain ⟨inst, action, linked⟩ := shared
        by_cases context : Plain.callerInstance start.store thread = .ok (some inst) ∧
            (start.store.inst? inst).any (·.mayLeave) = true
        · cases thread with
          | none => simp [Plain.callerInstance] at context
          | some worker =>
            exact finishAdmittedSharedDestructor embedder linked context.1 context.2 parents segments stores
              checked canonical residual scheduler bounded compare
        · exact finishDeniedDestructorImport embedder (sharedGiveRawEmbedder linked embedder) (sharedGiveRoute linked)
            context parents segments stores checked canonical residual scheduler bounded compare
      · cases linked : resolveBinding bindings name kind with
        | error issue =>
          exact finishDestructorBindingTrap
            (check := ⟨thread, .core core (sharedDestructorCoreResult task tk) :: frames, rest⟩)
            (canon := ⟨thread, .core core (sharedDestructorCoreResult task tk) :: peerFrames, peerRest⟩)
            embedder linked checked canonical residual
        | ok _ => exact .sharedDropWorkerImport parents segments admitted stores checked canonical residual
  | _ => exact follow rfl

/-- Discharge the pending enclosing return after following the source worker
prefix. Every recursive use of the mixed classifier consumes the actual pop. -/
private theorem rejoinDestructorSuffix {limit : Nat} {sourceCfg peerCfg : Config (core3 grow) (HostState sig)}
    {actualLabels : Trace grow sig}
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (ending : CallbackSliceEnd profile ready base bindings older sourceCfg peerCfg actualLabels finish)
    (scheduler : DestructorSchedulerAlignment older sourceCfg peerCfg)
    (bounded : actualLabels.length ≤ limit) (compare : ShorterCallbackSlices profile ready base bindings limit) :
    CallbackSliceEnd profile ready base bindings older sourceCfg peerCfg actualLabels finish := by
  match ending with
  | .destructorPrefix paths writers next tail =>
    exact .destructorPrefix paths writers next
      (rejoinDestructorSuffix embedder tail (next scheduler) (by simp only [List.length_append] at bounded; omega) compare)
  | .sharedDropSource installed canonical resumed peerResume selected source checkPop rawPop tickets tail =>
    exact .sharedDropSource installed canonical resumed peerResume selected source checkPop rawPop tickets
      (rejoinDestructorSuffix embedder tail scheduler bounded compare)
  | .sharedDropWorkerImport parents segments admitted stores checked canonical residual =>
    exact finishSharedDestructorImport embedder parents segments admitted stores checked canonical residual scheduler bounded compare
  | .sharedDropSwitch parents segments stores checked canonical residual =>
    exact finishDestructorSwitch parents segments stores checked canonical residual scheduler bounded compare
  | .sharedDropParentLoop paths writers frames restore residual =>
    exact rejoinDestructorLoopEntry
      (.sharedDropParentLoop paths writers frames restore residual) scheduler bounded compare
  | .sharedDropParentPop paths writers checkedLost canonicalLost restore residual =>
    exact rejoinDestructorParentJournal
      (.sharedDropParentPop paths writers checkedLost canonicalLost restore residual) scheduler bounded compare
  | other => exact other
termination_by structural ending

open ReturnFrame.Occurrence in
private theorem crossSharedDestructorWorker {left right : Config (core3 grow) (HostState sig)}
    {thread frames rest peerFrames peerRest} {callerFrame : Seg (core3 grow) (HostState sig)}
    {leftTicket rightTicket} {leading trailing : Trace grow sig}
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (task : TaskId) (callee : Option (core3 grow).FuncAddr)
    (body : ThreadBody (core3 grow)) (source : body = sharedDestructorThread task callee)
    {entry : Task (core3 grow)}
    (fresh : ArenaField.tasks.get? left.store task = some entry)
    (synchronous : entry.ft.async_ = false)
    {width : AddrType}
    (typeAt : entry.ft = dtorType width) (optionsAt : entry.opts = {})
    {rep : Nat}
    (caller : ArenaField.callers.get? left.store entry.caller = some (.sub (.destructor rep)))
    (split : labels = leading ++ trailing)
    (paired : HostFrame.Related.Paired older start incoming)
    (paths : OccurrenceTransport profile ready base bindings start incoming (.tau :: leading) (.tau :: leading)
      left right [some (.active 0 0)])
    (writers : VisitorWriterPath profile ready base bindings start incoming (.tau :: leading) (.tau :: leading) left right)
    (site : PairedComponentSite older left right ⟨thread, callerFrame :: frames, rest⟩ ⟨thread, callerFrame :: peerFrames, peerRest⟩)
    (leftFocus : left.ctl = (PayloadPrefix.Cursor.mk thread (callerFrame :: frames) rest).control
      (sharedDestructorStart leftTicket (some body)))
    (rightFocus : right.ctl = (PayloadPrefix.Cursor.mk thread (callerFrame :: peerFrames) peerRest).control
      (sharedDestructorStart rightTicket (some body)))
    (run : Steps profile ready (specDispatch ready base) left trailing finish)
    (compare : ShorterCallbackSlices profile ready base bindings (.tau :: labels).length) :
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, callerFrame :: frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, callerFrame :: peerFrames, peerRest⟩
  obtain ⟨framesPaired, restPaired⟩ := destructorEnclosingControl site
  let allocation := ArenaField.threads.alloc left.store { task := body.task }
  let worker := allocation.2
  let leftSaved := StepDefs.threadAct (specDispatch ready base) worker body
  let rightSaved := StepDefs.threadAct (specDispatch ready (LiveDispatch.host bindings base)) worker body
  let leftInstalled := { (left.setCont worker (some leftSaved)) with
    store := allocation.1
    ctl := check.control (sharedDestructorAfterInstall body leftTicket worker) }
  let rightInstalled := { (right.setCont worker (some rightSaved)) with
    store := allocation.1
    ctl := canon.control (sharedDestructorAfterInstall body rightTicket worker) }
  have sameStore : left.store = right.store := (HostFrame.Related.Paired.data site).1
  have allocationRight : ArenaField.threads.alloc right.store { task := body.task } = (allocation.1, worker) := by
    rw [← sameStore]
  have newLeft : Step profile ready (specDispatch ready base) left .tau leftInstalled :=
    .newThread (th := check.thread) (segs := check.frames) (rest := check.rest)
      (k := sharedDestructorAfterInstall body leftTicket) leftFocus rfl
  have newRight : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) right .tau rightInstalled :=
    .newThread (th := canon.thread) (segs := canon.frames) (rest := canon.rest)
      (k := sharedDestructorAfterInstall body rightTicket) rightFocus allocationRight
  rcases splitSilent (count := 1) (.cons newLeft (.refl _)) run with ⟨suffix, created, installedRun⟩ | short
  · have used : labels = (leading ++ [.tau]) ++ suffix := by
      rw [split, created]
      simp only [List.replicate_succ, List.replicate_zero, List.append_assoc, List.cons_append, List.nil_append]
    have leftSavedAt : leftInstalled.cont? worker = some leftSaved :=
      Config.cont?_setCont_self left worker (some leftSaved)
    have rightSavedAt : rightInstalled.cont? worker = some rightSaved :=
      Config.cont?_setCont_self right worker (some rightSaved)
    have leftCertificate : SharedDestructorInstalled profile ready (specDispatch ready base) body leftTicket worker left leftInstalled check :=
      ⟨leftFocus, rfl, newLeft, leftSavedAt, rfl⟩
    have rightCertificate : SharedDestructorInstalled profile ready (specDispatch ready (LiveDispatch.host bindings base))
        body rightTicket worker right rightInstalled canon :=
      ⟨rightFocus, allocationRight, newRight, rightSavedAt, rfl⟩
    have installedPaths := sharedSchedulerTransport newLeft newRight (edit := .write worker.idx [])
      (by rw [transitionEdit, leftFocus]; rfl) (by
        rw [transitionEdit, rightFocus]
        change (Edit.write (ArenaField.threads.alloc right.store { task := body.task }).2.idx [] :
          Edit (core3 grow) (HostState sig)) = .write worker.idx []
        rw [allocationRight])
    obtain ⟨_, throughInstall, _⟩ := CallbackPrefix.transportAppend paths installedPaths
    have installedWriters := writers.append (frameCalloutStep installedPaths rfl rfl)
    have savedAgreement : leftSaved = rightSaved := by cases body <;> rfl
    have frame : PairedComponentSite older leftInstalled rightInstalled check canon := by
      have savedPair : ReturnFrame.Related.Saved older (some leftSaved) (some rightSaved) := by
        rw [← savedAgreement]
        exact .some (.mk .nil)
      unfold PairedComponentSite HostFrame.Related.Paired HostFrame.replace at site ⊢
      exact pairedSetContinuation (ReturnFrame.Related.Paired.set_store site allocation.1) worker savedPair
    let resumeLeft := { leftInstalled with
      store := destructorResumeStore worker leftInstalled.store
      ctl := check.control (.op (.resumeThread worker) (fun _ => sharedDestructorAfterResume body leftTicket)) }
    let resumeRight := { rightInstalled with
      store := destructorResumeStore worker rightInstalled.store
      ctl := canon.control (.op (.resumeThread worker) (fun _ => sharedDestructorAfterResume body rightTicket)) }
    have quietLeft := sharedDestructorResumePath (profile := profile) (ready := ready) (dispatch := specDispatch ready base)
      (start := leftInstalled) body leftTicket worker check rfl
    have quietRight := sharedDestructorResumePath (profile := profile) (ready := ready)
      (dispatch := specDispatch ready (LiveDispatch.host bindings base)) (start := rightInstalled) body rightTicket worker canon rfl
    let count := (destructorResumeEdits worker leftInstalled.store).length
    rcases splitSilent (count := count) (quietLeft.1.track (.active 0 0)).toTrail.steps installedRun with
      ⟨afterReady, prepared, resumeRun⟩ | short
    · have resumedPrefix : labels = ((leading ++ [.tau]) ++ List.replicate count .tau) ++ afterReady := by
        rw [used, prepared]
        simp only [List.append_assoc]
      have beforeResume := CallbackPrefix.stationaryTransport (bindings := bindings) quietLeft.1.track quietRight.1.track
      obtain ⟨_, throughReady, _⟩ := CallbackPrefix.transportAppend throughInstall beforeResume
      have readyWriters := installedWriters.append (.framed quietLeft.2 quietRight.2)
      let activeLeft := { (resumeLeft.setCont worker none) with
        store := StepDefs.threadStatusSt worker .running resumeLeft.store
        ctl := leftSaved :: check.control (sharedDestructorAfterResume body leftTicket) }
      let activeRight := { (resumeRight.setCont worker none) with
        store := StepDefs.threadStatusSt worker .running resumeRight.store
        ctl := rightSaved :: canon.control (sharedDestructorAfterResume body rightTicket) }
      have resumeStep : Step profile ready (specDispatch ready base) resumeLeft .tau activeLeft :=
        .resumeThread (th := check.thread) (k := fun _ => sharedDestructorAfterResume body leftTicket)
          (segs := check.frames) (rest := check.rest) rfl leftSavedAt
      have peerResume : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) resumeRight .tau activeRight :=
        .resumeThread (th := canon.thread) (k := fun _ => sharedDestructorAfterResume body rightTicket)
          (segs := canon.frames) (rest := canon.rest) rfl rightSavedAt
      rcases splitSilent (count := 1) (.cons resumeStep (.refl _)) resumeRun with ⟨remaining, resumed, residual⟩ | short
      · have resumedPaths := sharedSchedulerTransport resumeStep peerResume (edit := .resume worker.idx) rfl rfl
        obtain ⟨_, through, _⟩ := CallbackPrefix.transportAppend throughReady resumedPaths
        have traced := readyWriters.append (frameCalloutStep resumedPaths rfl rfl)
        have allUsed : .tau :: labels =
            (((.tau :: leading) ++ [.tau]) ++ List.replicate count .tau ++ [.tau]) ++ remaining := by
          rw [resumedPrefix, resumed]
          simp only [List.cons_append, List.append_assoc, List.replicate_succ, List.replicate_zero, List.nil_append]
        have activeCertificate : SharedDestructorResumed profile ready (specDispatch ready base)
            body leftTicket worker resumeLeft activeLeft check := ⟨rfl, leftSavedAt, resumeStep, rfl⟩
        have peerCertificate : SharedDestructorResumed profile ready (specDispatch ready (LiveDispatch.host bindings base))
            body rightTicket worker resumeRight activeRight canon := ⟨rfl, rightSavedAt, peerResume, rfl⟩
        classical
        by_cases tickets : leftTicket = rightTicket
        · have parentPair : HostFrame.Related.Paired older
              { resumeLeft with ctl := check.control (sharedDestructorAfterResume body leftTicket) }
              { resumeRight with ctl := canon.control (sharedDestructorAfterResume body rightTicket) } := by
            rw [← tickets]
            have parent := pairComponentFocus
              (start := { leftInstalled with ctl := check.control (sharedDestructorAfterResume body leftTicket) })
              (incoming := { rightInstalled with ctl := canon.control (sharedDestructorAfterResume body leftTicket) })
              rfl rfl frame
            exact parent.set_store (destructorResumeStore worker leftInstalled.store)
          have workersPaired : HostFrame.Related.Paired older activeLeft activeRight := by
            have cleared := pairedSetContinuation parentPair worker (.none (changes := older))
            have running := ReturnFrame.Related.Paired.set_store cleared
              (StepDefs.threadStatusSt worker .running resumeLeft.store)
            have workerPair : ReturnFrame.Related.Active older leftSaved rightSaved := by
              rw [← savedAgreement]
              exact .mk .nil
            exact pairedPushActivation running workerPair
          have shorter : remaining.length < (.tau :: labels).length := by
            rw [allUsed, List.length_append]
            simp only [List.length_append, List.length_cons, List.length_nil]
            omega
          obtain ⟨_, _, _, _, _, sliced, compared, ending⟩ := compare shorter residual workersPaired
          exact .inr (callbackTerminalSlice paired (by
            rw [allUsed, sliced]
            exact .sharedDropCompared activeCertificate (tickets.symm ▸ peerCertificate)
              (by simpa only [List.append_assoc] using through) (by simpa only [List.append_assoc] using traced)
              compared ending))
        · let checkRest := check.control (sharedDestructorAfterResume body leftTicket)
          let canonRest := canon.control (sharedDestructorAfterResume body rightTicket)
          have parents : PairedComponentSite older activeLeft activeRight check canon := by
            unfold PairedComponentSite HostFrame.Related.Paired HostFrame.replace at frame ⊢
            exact ReturnFrame.Related.Paired.set_store (pairedSetContinuation frame worker .none) activeLeft.store
          have activeScheduler : DestructorSchedulerAlignment older activeLeft activeRight := by
            unfold PairedComponentSite at parents
            have extracted := destructorSchedulerOfPair parents
            exact extracted
          have checkedEntry : activeLeft.ctl = (PayloadPrefix.Cursor.mk (some worker) [] checkRest).control
              (specDispatch ready base (.threadBody (sharedDestructorThread task callee))) := by
            rw [← source]
            rfl
          have canonicalEntry : activeRight.ctl = (PayloadPrefix.Cursor.mk (some worker) [] canonRest).control
              (specDispatch ready (LiveDispatch.host bindings base) (.threadBody (sharedDestructorThread task callee))) := by
            rw [← source]
            rfl
          obtain ⟨visited, following, reached, peer, split, moved, writer, remaining, ending⟩ :=
            cutSharedQuietWorker (sharedDestructorEntryPath task callee worker checkRest checkedEntry)
              (sharedDestructorEntryPath task callee worker canonRest canonicalEntry) residual
          obtain ⟨_, finalPaths, _⟩ := CallbackPrefix.transportAppend through moved
          have finalWriters := traced.append writer
          have checkedUsed : .tau :: labels =
              ((((.tau :: leading) ++ [.tau]) ++ List.replicate count .tau ++ [.tau]) ++ visited) ++ following := by
            simp only [allUsed, split, List.append_assoc]
          have conclude (ending : CallbackSliceEnd profile ready base bindings older reached peer following finish) :
              CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
            exact .inr (callbackTerminalSlice paired (by
              rw [checkedUsed]
              exact .comparedPrefix finalPaths finalWriters ending))
          rcases ending with empty | ⟨rfl, rfl⟩
          · subst following
            cases remaining
            exact conclude .exhausted
          · let workerCheck : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, [], checkRest⟩
            let workerCanon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, [], canonRest⟩
            let leftStore := CStore.setImplicitThread task worker activeLeft.store
            let rightStore := CStore.setImplicitThread task worker activeRight.store
            let read := sharedDestructorAfterTaskRead (sig := sig) task callee worker
            let readLeft := { activeLeft with store := leftStore, ctl := workerCheck.control (read leftStore) }
            let readRight := { activeRight with store := rightStore, ctl := workerCanon.control (read rightStore) }
            have sameStore : leftStore = rightStore := rfl
            have stopAt {left right : Config (core3 grow) (HostState sig)}
                {leading trailing : Trace grow sig} {marks : List (Option Location)}
                (allUsed : .tau :: labels = leading ++ trailing)
                (paths : OccurrenceTransport profile ready base bindings start incoming leading leading left right marks)
                (writers : VisitorWriterPath profile ready base bindings start incoming leading leading left right)
                (workerSource : SharedDestructorRegisteredSource task left.store right.store)
                (scheduler : DestructorSchedulerAlignment older left right)
                (checked : left.ctl = workerCheck.control (sharedDestructorAfterAdmission task callee true))
                (canonical : right.ctl = workerCanon.control (sharedDestructorAfterAdmission task callee true))
                (tail : Steps profile ready (specDispatch ready base) left trailing finish) :
                CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
              exact .inr (callbackTerminalSlice paired (by
                rw [allUsed]
                have covers : trailing.length ≤ (.tau :: labels).length := by
                  rw [allUsed, List.length_append]
                  omega
                refine .comparedPrefix paths writers (rejoinDestructorSuffix embedder ?_ scheduler covers compare)
                exact crossSharedDestructorOnStart task callee workerSource checked canonical tail
                  (fun tk args width rep typeAt optionsAt integer stores leftPop rightPop leftAt rightAt residual =>
                    CallbackSliceEnd.sharedDropSource leftCertificate rightCertificate activeCertificate peerCertificate
                      source workerSource leftPop rightPop tickets
                      (crossSharedDestructorScalars task callee tk width rep args typeAt optionsAt integer stores leftAt rightAt residual
                        (fun same checkedBody canonicalBody tail => by
                          have finishWorker {l r : Config (core3 grow) (HostState sig)} {remaining : Trace grow sig}
                              (stores : l.store = r.store)
                              (atLeft : l.ctl = workerCheck.control (sharedDestructorFinish task []))
                              (atRight : r.ctl = workerCanon.control (sharedDestructorFinish task []))
                              (run : Steps profile ready (specDispatch ready base) l remaining finish) :
                              CallbackSliceEnd profile ready base bindings older l r remaining finish :=
                            crossSharedDestructorCompletion (check := workerCheck) (canon := workerCanon) task rfl stores atLeft atRight run
                              (fun same lAt rAt tail =>
                                crossSharedDestructorExit task worker same lAt rAt tail
                                  (fun resolved stores leftAt rightAt run =>
                                    compareDestructorParentLoop body leftTicket rightTicket
                                      (by
                                        have taskOfBody : body.task = task := by rw [source]; cases callee <;> rfl
                                        simpa only [taskOfBody] using resolved)
                                      stores framesPaired restPaired leftAt rightAt run))
                          cases callee with
                          | none => exact finishWorker same checkedBody canonicalBody tail
                          | some f =>
                            exact crossSharedDestructorCore task tk same checkedBody canonicalBody tail
                              (fun stores leftAt rightAt status run reenter =>
                                crossSharedDestructorImport task tk (.paired framesPaired restPaired tickets)
                                  ⟨worker, rfl⟩ .nil stores leftAt rightAt status run reenter)
                              (fun words stores leftAt rightAt run =>
                                crossSharedDestructorCoreResult task tk width words typeAt stores leftAt rightAt run finishWorker))))))
            change Steps profile ready (specDispatch ready base) readLeft following finish at remaining
            let reachedTask := { entry with implicitThread := some worker }
            have taskAt : ArenaField.tasks.get? leftStore task = some reachedTask := by
              change ArenaField.tasks.get? (ArenaField.tasks.modify activeLeft.store task
                (fun old => { old with implicitThread := some worker })) task = _
              rw [ArenaField.get?_modify_self]
              have retained : ArenaField.tasks.get? activeLeft.store task = ArenaField.tasks.get? left.store task := by
                change ArenaField.tasks.get? (destructorResumeStore worker allocation.1) task = _
                unfold destructorResumeStore
                split <;> rfl
              rw [retained, fresh]
              rfl
            let next := sharedDestructorAfterAdmission (sig := sig) task callee true
            have rawTask : ArenaField.tasks.get? rightStore task = some reachedTask := sameStore ▸ taskAt
            have checked : readLeft.ctl = workerCheck.control (Task.registerThread task worker >>= fun _ => next) :=
              congrArg workerCheck.control (sharedDestructorSyncCode task callee worker leftStore reachedTask taskAt synchronous)
            have canonical : readRight.ctl = workerCanon.control (Task.registerThread task worker >>= fun _ => next) :=
              congrArg workerCanon.control (sharedDestructorSyncCode task callee worker rightStore reachedTask rawTask synchronous)
            have checkRegistration := sharedDestructorRegisterPath (profile := profile) (ready := ready)
              (dispatch := specDispatch ready base) task worker workerCheck next reachedTask taskAt checked
            have rawRegistration := sharedDestructorRegisterPath (profile := profile) (ready := ready)
              (dispatch := specDispatch ready (LiveDispatch.host bindings base)) task worker workerCanon next reachedTask rawTask canonical
            have decision : sharedDestructorRegisterResult readLeft.store entry.inst worker =
                sharedDestructorRegisterResult readRight.store entry.inst worker :=
              congrArg (fun store => sharedDestructorRegisterResult store entry.inst worker) sameStore
            dsimp only at checkRegistration rawRegistration
            rw [← decision] at rawRegistration
            obtain ⟨used, suffix, reached, peer, split, movement, writes, residual, ending⟩ :=
              cutSharedQuietWorker checkRegistration rawRegistration remaining
            rcases ending with empty | ⟨rfl, rfl⟩
            · subst suffix
              cases residual
              exact conclude (by rw [split]; exact .comparedPrefix movement writes .exhausted)
            · let verdict := sharedDestructorRegisterResult readLeft.store entry.inst worker
              let afterCheck := { readLeft with
                store := sharedDestructorRegisterStore task worker readLeft.store verdict
                ctl := workerCheck.control (sharedDestructorRegisterTail next verdict) }
              let afterCanon := { readRight with
                store := sharedDestructorRegisterStore task worker readRight.store verdict
                ctl := workerCanon.control (sharedDestructorRegisterTail next verdict) }
              change Steps profile ready (specDispatch ready base) afterCheck suffix finish at residual
              cases result : verdict with
              | error reason =>
                have atCheck : afterCheck.ctl = workerCheck.control (trap reason) := by
                  simp only [afterCheck, result, sharedDestructorRegisterTail]
                have atCanon : afterCanon.ctl = workerCanon.control (trap reason) := by
                  simp only [afterCanon, result, sharedDestructorRegisterTail]
                exact conclude (by
                  rw [split]
                  exact .comparedPrefix movement writes (classifySharedDestructorTrap reason atCheck atCanon residual))
              | ok accepted =>
                cases accepted
                have atCheck : afterCheck.ctl = workerCheck.control (sharedDestructorAfterAdmission task callee true) := by
                  simp only [afterCheck, result, sharedDestructorRegisterTail, next]
                have atCanon : afterCanon.ctl = workerCanon.control (sharedDestructorAfterAdmission task callee true) := by
                  simp only [afterCanon, result, sharedDestructorRegisterTail, next]
                have allUsed : .tau :: labels =
                    (((((.tau :: leading) ++ [.tau]) ++ List.replicate count .tau ++ [.tau]) ++ visited) ++ used) ++ suffix := by
                  simp only [checkedUsed, split, List.append_assoc]
                obtain ⟨_, whole, _⟩ := CallbackPrefix.transportAppend finalPaths movement
                have checkedStore : afterCheck.store = CStore.registerThreadSt task worker readLeft.store := by
                  simp only [afterCheck, result, sharedDestructorRegisterStore]
                have canonicalStore : afterCanon.store = CStore.registerThreadSt task worker readRight.store := by
                  simp only [afterCanon, result, sharedDestructorRegisterStore]
                have callerAt : ArenaField.callers.get? readLeft.store entry.caller = some (.sub (.destructor rep)) := by
                  change ArenaField.callers.get? (destructorResumeStore worker allocation.1) entry.caller = _
                  unfold destructorResumeStore
                  split <;> exact caller
                have registeredTask : ArenaField.tasks.get? afterCheck.store task =
                    some { reachedTask with threads := reachedTask.threads ++ [worker] } := by
                  have found : readLeft.store.task? task = some reachedTask := taskAt
                  have room : ∃ slot, (readLeft.store.inst? reachedTask.inst).bind (InstState.addThread? worker) = some slot := by
                    change sharedDestructorRegisterResult readLeft.store entry.inst worker = .ok () at result
                    unfold sharedDestructorRegisterResult at result
                    cases live : ArenaField.insts.get? readLeft.store entry.inst with
                    | none => simp [live] at result
                    | some inst =>
                      cases available : inst.addThread? worker with
                      | none => simp [live, available] at result
                      | some slot =>
                        refine ⟨slot, ?_⟩
                        change (ArenaField.insts.get? readLeft.store entry.inst).bind (InstState.addThread? worker) = _
                        simp only [live, Option.bind_some, available]
                  obtain ⟨⟨slot, instanceState⟩, room⟩ := room
                  simp only [checkedStore, CStore.registerThreadSt, found, room]
                  change ArenaField.tasks.get? (ArenaField.tasks.modify readLeft.store task
                    (fun old => { old with threads := old.threads ++ [worker] })) task = _
                  rw [ArenaField.get?_modify_self, taskAt]
                  rfl
                have registeredCaller : ArenaField.callers.get? afterCheck.store entry.caller = some (.sub (.destructor rep)) := by
                  rw [checkedStore]
                  unfold CStore.registerThreadSt
                  split
                  · exact callerAt
                  · split <;> exact callerAt
                have workerSource : SharedDestructorRegisteredSource task afterCheck.store afterCanon.store :=
                  ⟨checkedStore.trans ((congrArg (CStore.registerThreadSt task worker) sameStore).trans canonicalStore.symm),
                    _, width, rep, registeredTask, typeAt, optionsAt, registeredCaller⟩
                exact stopAt allUsed whole (finalWriters.append writes) workerSource activeScheduler atCheck atCanon residual
      · have empty : afterReady = [] := List.length_eq_zero_iff.mp (by omega)
        have stopped : finish = resumeLeft := by
          have atEnd : Steps profile ready (specDispatch ready base) resumeLeft [] finish := empty ▸ resumeRun
          exact stepsAtEmpty atEnd
        exact .inr (callbackTerminalSlice paired (by
          rw [resumedPrefix, empty, stopped]
          simpa only [List.cons_append, List.append_assoc, List.append_nil] using
            (CallbackSliceEnd.coreAcceptTerminal (changes := older) throughReady readyWriters (.refl _) (.inl rfl))))
    · obtain ⟨_, _, prefixPath, _, prefixWriters, _, _⟩ :=
        compareFramedQuietShort quietLeft quietRight frame ⟨_, rfl⟩ ⟨_, rfl⟩ installedRun short
      obtain ⟨_, through, _⟩ := CallbackPrefix.transportAppend throughInstall prefixPath
      exact .inr (callbackTerminalSlice paired (by
        rw [used]
        simpa only [List.cons_append, List.append_assoc, List.append_nil] using
          (CallbackSliceEnd.coreAcceptTerminal (changes := older) through (installedWriters.append prefixWriters)
            (.refl _) (.inl rfl))))
  · have empty : trailing = [] := List.length_eq_zero_iff.mp (by omega)
    have stopped : finish = left := stepsAtEmpty (empty ▸ run)
    exact .inr (callbackTerminalSlice paired (by
      rw [split, empty, stopped, ← List.cons_append]
      exact .coreAcceptTerminal paths writers (.refl _) (.inl rfl)))

