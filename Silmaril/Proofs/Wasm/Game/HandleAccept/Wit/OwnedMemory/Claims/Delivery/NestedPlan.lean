private theorem sharedDestructorThreadResumeLater (index : Nat) :
    StoreEffects (Builtins.threadResumeLater index : Session grow sig (List FlatValue)) := by
  unfold Builtins.threadResumeLater Runtime.Thread.resumeLater Runtime.Thread.startWaiting getInst
  exact storeEffectCurrentInst.bind fun inst =>
    (storeEffectGetObject ArenaField.insts inst).bind fun record =>
    (storeEffectTrapIf (!record.mayLeave) .cannotLeave).bind fun _ =>
    (storeEffectThreadsGet inst index).bind fun thread => (storeEffectUnlessSuspended thread).bind fun _ =>
    (storeEffectModify _).bind fun _ => .pure []

private theorem storeEffectCurrentTask : StoreEffects (currentTask : Session grow sig TaskId) := by
  have current : StoreEffects (currentTask? : Session grow sig (Option TaskId)) := by
    unfold currentTask? getThread
    refine (show StoreEffects (currentThread : Session grow sig (Option ThreadId)) from
      .op rfl fun thread => .pure thread).bind fun thread => ?_
    cases thread with
    | none => exact .pure none
    | some thread => exact (storeEffectGetObject ArenaField.threads thread).bind fun record => .pure (some record.task)
  unfold currentTask
  refine current.bind fun task => ?_
  cases task
  · exact storeEffectTrap _
  · exact .pure _

private theorem sharedDestructorThreadNewIndirect (table : (core3 grow).TableAddr) (type : V1.FuncType)
    (index : Nat) (arg : FlatValue) :
    DestructorWorkerEffects (fun _ => True) (Builtins.threadNewIndirect table type index arg : Session grow sig (List FlatValue)) := by
  have closed {Result : Type} {body : Session grow sig Result} (effects : StoreEffects body) :
      DestructorWorkerEffects (fun _ => True) body := liftDestructorStoreEffects effects (trivialPreserves body)
  have register (task : TaskId) (thread : ThreadId) : StoreEffects (Task.registerThread task thread : Session grow sig Nat) := by
    unfold Task.registerThread getTask getInst
    refine (storeEffectGetObject ArenaField.tasks task).bind fun record =>
      (storeEffectGetObject ArenaField.insts record.inst).bind fun inst => ?_
    split
    · exact storeEffectTrap _
    · exact (storeEffectModify _).bind fun _ => .pure _
  unfold Builtins.threadNewIndirect getTask getInst
  exact (closed storeEffectCurrentTask).bind fun task =>
    (closed (storeEffectGetObject ArenaField.tasks task)).bind fun entry =>
    (closed (storeEffectGetObject ArenaField.insts entry.inst)).bind fun inst =>
    (closed (storeEffectTrapIf (!inst.mayLeave) .cannotLeave)).bind fun _ =>
    (closed storeEffectGet).bind fun store =>
    (closed (storeEffectOrTrap .threadNewIndirectNull (((core3 grow).tableFunc? store.core table index).join))).bind fun function =>
    (closed (storeEffectTrapIf ((core3 grow).funcType? store.core function != some ((core3 grow).ofFlatType type))
      .threadNewIndirectType)).bind fun _ =>
    (show DestructorWorkerEffects (fun _ => True) (newThread (.newIndirect task function arg) : Session grow sig ThreadId) from
      .op (fun _ _ => trivial) fun thread => .pure thread).bind fun thread =>
    (closed (register task thread)).bind fun index => .pure [i32Flat index]

private def sharedDestructorLocalImport : CanonHost (core3 grow) → Bool
  | .builtin (.contextGet ..) _ | .builtin (.contextSet ..) _
  | .builtin .backpressureInc _ | .builtin .backpressureDec _ | .builtin .threadIndex _
  | .builtin (.resourceNew ..) _ | .builtin (.resourceRep ..) _
  | .builtin .waitableSetNew _ | .builtin .waitableSetDrop _ | .builtin .waitableJoin _
  | .builtin .subtaskDrop _ | .builtin .errorContextDrop _ | .builtin (.waitableSetPoll ..) _
  | .builtin (.streamNew ..) _ | .builtin (.futureNew ..) _
  | .builtin (.streamDropReadable ..) _ | .builtin (.streamDropWritable ..) _
  | .builtin (.futureDropReadable ..) _ | .builtin (.futureDropWritable ..) _
  | .builtin .threadResumeLater _ | .builtin (.threadNewIndirect ..) _ => true
  | _ => false

private theorem destructorThreadEntryEffects :
    StoreEffects (Builtins.enterThreadBuiltin : Session grow sig (ThreadId × Runtime.Thread × Task (core3 grow))) := by
  unfold Builtins.enterThreadBuiltin getThread getTask getInst
  exact storeEffectCurrentThread.bind fun thread =>
    (storeEffectGetObject ArenaField.threads thread).bind fun record =>
    (storeEffectGetObject ArenaField.tasks record.task).bind fun task =>
    (storeEffectGetObject ArenaField.insts task.inst).bind fun inst =>
    (storeEffectTrapIf (!inst.mayLeave) .cannotLeave).bind fun _ => .pure _

private theorem sharedDestructorLocalProgram (host : CanonHost (core3 grow)) (args : List FlatValue)
    (selected : sharedDestructorLocalImport host = true) :
    ∃ body : Session grow sig (List FlatValue), DestructorWorkerEffects (fun _ => True) body ∧
      ∀ (ready : HostReady (HostState sig)) (impl : HostImpl (core3 grow) (HostState sig))
        (store : CStore (core3 grow)) (thread : Option ThreadId),
        calloutBody Limits.spec Quirks.none ready impl store thread host args =
          (body >>= fun words => .pure (.flat words)) := by
  have closed {Result : Type} {body : Session grow sig Result} (effects : StoreEffects body) :
      DestructorWorkerEffects (fun _ => True) body := liftDestructorStoreEffects effects (trivialPreserves body)
  cases host with
  | builtin builtin inst =>
    cases builtin with
    | contextGet width index =>
      refine ⟨withArgs0 args (Builtins.contextGet width index), ?_, fun _ _ _ _ => rfl⟩
      apply closed
      cases args with
      | nil =>
        unfold withArgs0 Builtins.contextGet getThread
        exact storeEffectCurrentThread.bind fun thread =>
          (storeEffectGetObject ArenaField.threads thread).bind fun record =>
          (storeEffectOrTrap _ record.storage[index]?).bind fun _ => .pure _
      | cons => exact storeEffectTrap _
    | contextSet width index =>
      refine ⟨withArgs1 args (Builtins.contextSet width index), ?_, fun _ _ _ _ => rfl⟩
      apply closed
      rcases args with _ | ⟨word, _ | ⟨extra, tail⟩⟩
      · exact storeEffectTrap _
      · unfold withArgs1 Builtins.contextSet getThread
        exact storeEffectCurrentThread.bind fun thread =>
          (storeEffectGetObject ArenaField.threads thread).bind fun record =>
          (storeEffectTrapIf _ .contextIndex).bind fun _ =>
          (storeEffectModify _).bind fun _ => .pure _
      · exact storeEffectTrap _
    | backpressureInc =>
      refine ⟨withArgs0 args Builtins.backpressureInc, ?_, fun _ _ _ _ => rfl⟩
      apply closed
      cases args with
      | nil =>
        unfold withArgs0 Builtins.backpressureInc getInst modifyInst modifyObj
        exact storeEffectCurrentInst.bind fun inst =>
          (storeEffectGetObject ArenaField.insts inst).bind fun record =>
          (storeEffectTrapIf _ .backpressureOverflow).bind fun _ =>
          (storeEffectModify _).bind fun _ => .pure _
      | cons => exact storeEffectTrap _
    | backpressureDec =>
      refine ⟨withArgs0 args Builtins.backpressureDec, ?_, fun _ _ _ _ => rfl⟩
      apply closed
      cases args with
      | nil =>
        unfold withArgs0 Builtins.backpressureDec getInst modifyInst modifyObj
        exact storeEffectCurrentInst.bind fun inst =>
          (storeEffectGetObject ArenaField.insts inst).bind fun record =>
          (storeEffectTrapIf _ .backpressureUnderflow).bind fun _ =>
          (storeEffectModify _).bind fun _ => .pure _
      | cons => exact storeEffectTrap _
    | threadIndex =>
      refine ⟨withArgs0 args Builtins.threadIndex, ?_, fun _ _ _ _ => rfl⟩
      apply closed
      cases args with
      | nil =>
        unfold withArgs0 Builtins.threadIndex
        exact destructorThreadEntryEffects.bind fun (_, record, _) =>
          (storeEffectOrTrap _ record.index).bind fun _ => .pure _
      | cons => exact storeEffectTrap _
    | resourceNew resource width =>
      exact ⟨_, closed (storeEffectWithArgs1 args _ (sharedDestructorResourceNew resource)), fun _ _ _ _ => rfl⟩
    | resourceRep resource width =>
      exact ⟨_, closed (storeEffectWithArgs1 args _ (sharedDestructorBuiltinResourceRep resource)), fun _ _ _ _ => rfl⟩
    | waitableSetNew =>
      exact ⟨_, closed (storeEffectWithArgs0 args sharedDestructorWaitableSetNew), fun _ _ _ _ => rfl⟩
    | waitableSetDrop =>
      exact ⟨_, closed (storeEffectWithArgs1 args _ sharedDestructorWaitableSetDrop), fun _ _ _ _ => rfl⟩
    | waitableJoin =>
      exact ⟨_, closed (storeEffectWithArgs2 args _ sharedDestructorWaitableJoin), fun _ _ _ _ => rfl⟩
    | subtaskDrop =>
      exact ⟨_, closed (storeEffectWithArgs1 args _ sharedDestructorSubtaskDrop), fun _ _ _ _ => rfl⟩
    | errorContextDrop =>
      exact ⟨_, closed (storeEffectWithArgs1 args _ sharedDestructorErrorContextDrop), fun _ _ _ _ => rfl⟩
    | waitableSetPoll memory =>
      exact ⟨_, closed (storeEffectWithArgs2 args _ (sharedDestructorWaitablePoll memory)), fun _ _ _ _ => rfl⟩
    | streamNew type =>
      exact ⟨_, closed (storeEffectWithArgs0 args (sharedDestructorNewEnds .readableStream type)), fun _ _ _ _ => rfl⟩
    | futureNew type =>
      exact ⟨_, closed (storeEffectWithArgs0 args (sharedDestructorNewEnds .readableFuture type)), fun _ _ _ _ => rfl⟩
    | streamDropReadable type =>
      exact ⟨_, closed (storeEffectWithArgs1 args _ (sharedDestructorDropEnd .readableStream type)), fun _ _ _ _ => rfl⟩
    | streamDropWritable type =>
      exact ⟨_, closed (storeEffectWithArgs1 args _ (sharedDestructorDropEnd .writableStream type)), fun _ _ _ _ => rfl⟩
    | futureDropReadable type =>
      exact ⟨_, closed (storeEffectWithArgs1 args _ (sharedDestructorDropEnd .readableFuture type)), fun _ _ _ _ => rfl⟩
    | futureDropWritable type =>
      exact ⟨_, closed (storeEffectWithArgs1 args _ (sharedDestructorDropEnd .writableFuture type)), fun _ _ _ _ => rfl⟩
    | threadResumeLater =>
      exact ⟨_, closed (storeEffectWithArgs1 args _ sharedDestructorThreadResumeLater), fun _ _ _ _ => rfl⟩
    | threadNewIndirect table type =>
      refine ⟨builtinProg Limits.spec Quirks.none (fun _ _ => false) (.threadNewIndirect table type) args,
        ?_, fun _ _ _ _ => rfl⟩
      rcases args with _ | ⟨first, _ | ⟨second, _ | ⟨extra, tail⟩⟩⟩
      · exact closed (storeEffectTrap _)
      · exact closed (storeEffectTrap _)
      · exact sharedDestructorThreadNewIndirect _ _ _ _
      · exact closed (storeEffectTrap _)
    | _ => contradiction
  | _ => contradiction

open ReturnFrame.Occurrence in
private theorem crossDestructorPark {worker : ThreadId} {frames peerFrames rest peerRest body}
    (parents : DestructorParentChain older body rest peerRest)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) frames peerFrames)
    (reply : Session grow sig (Ret (core3 grow))) (stores : start.store = incoming.store)
    (leftAt : start.ctl = (PayloadPrefix.Cursor.mk (some worker) frames rest).control (.op (.block none) fun _ => reply))
    (rightAt : incoming.ctl = (PayloadPrefix.Cursor.mk (some worker) peerFrames peerRest).control (.op (.block none) fun _ => reply))
    (run : Steps profile ready (specDispatch ready base) start labels finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  let savedLeft := StepDefs.blockedAct (E := core3 grow) worker (fun _ => reply) frames
  let savedRight := StepDefs.blockedAct (E := core3 grow) worker (fun _ => reply) peerFrames
  let parkedLeft := { start.setCont worker (some savedLeft) with
    store := StepDefs.threadStatusSt worker .blocked start.store, ctl := rest }
  let parkedRight := { incoming.setCont worker (some savedRight) with
    store := StepDefs.threadStatusSt worker .blocked incoming.store, ctl := peerRest }
  have leftBlock : Step profile ready (specDispatch ready base) start .tau parkedLeft := .block leftAt
  have rightBlock : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau parkedRight := .block rightAt
  cases run with
  | refl => exact .exhausted
  | cons actual tail =>
    obtain ⟨rfl, rfl⟩ := silentStepUnique leftBlock actual
    have path := sharedSchedulerTransport (bindings := bindings) (edit := .block worker.idx) leftBlock rightBlock
      (by rw [transitionEdit, leftAt]; rfl) (by rw [transitionEdit, rightAt]; rfl)
    refine .destructorPrefix path (frameCalloutStep path rfl rfl) ?_
      (enterDestructorParentLoop parents (congrArg (StepDefs.threadStatusSt worker .blocked) stores) tail)
    intro scheduler
    exact ⟨relatedSetSlot .none scheduler.1 worker.idx (.some (.mk segments)), scheduler.2⟩

open ReturnFrame.Occurrence in
private theorem crossDestructorSuspend {worker : ThreadId} {frames peerFrames rest peerRest body}
    (parents : DestructorParentChain older body rest peerRest)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) frames peerFrames)
    (stores : start.store = incoming.store)
    (leftAt : start.ctl = (PayloadPrefix.Cursor.mk (some worker) frames rest).control
      (Builtins.threadSuspend >>= fun words => .pure (.flat words)))
    (rightAt : incoming.ctl = (PayloadPrefix.Cursor.mk (some worker) peerFrames peerRest).control
      (Builtins.threadSuspend >>= fun words => .pure (.flat words)))
    (run : Steps profile ready (specDispatch ready base) start labels finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, peerFrames, peerRest⟩
  let reply : Session grow sig (Ret (core3 grow)) := .pure (.flat [i32Flat 0])
  let suspend : Session grow sig (Ret (core3 grow)) := .op (.block none) fun _ => reply
  have code : (Builtins.threadSuspend >>= fun words => .pure (.flat words) : Session grow sig (Ret (core3 grow))) =
      Builtins.enterThreadBuiltin >>= fun _ => suspend := by
    change (Prog.bind (Prog.bind (Builtins.enterThreadBuiltin : Session grow sig _) fun _ =>
      Prog.bind (block none : Session grow sig Unit) fun _ => Prog.pure [i32Flat 0]) fun words =>
        Prog.pure (Ret.flat (E := core3 grow) words)) = _
    rw [Prog.bind_assoc]
    rfl
  refine crossSharedWorkerBody (check := check) (canon := canon) rfl Builtins.enterThreadBuiltin (fun _ => suspend)
    (liftDestructorStoreEffects destructorThreadEntryEffects (trivialPreserves _)) trivial stores
    (congrArg check.control code ▸ leftAt) (congrArg canon.control code ▸ rightAt) run ?_
  intro left right remaining _ _ _ same lAt rAt tail
  exact crossDestructorPark parents segments reply same lAt rAt tail

private def sharedDestructorYieldDecision : Session grow sig Bool := do
  let t ← currentThreadId
  let now ← Thread.readyNow (fun _ _ => false) .always
  let early ← (if now then choose (.earlyReturn .yield_) else pure false : Session grow sig Bool)
  if early then pure true else do
    Thread.startWaiting t .always
    pure false

private def sharedDestructorYieldAfter (early : Bool) : Session grow sig (Ret (core3 grow)) :=
  if early then .pure (.flat [i32Flat 0]) else .op (.block none) fun _ => .pure (.flat [i32Flat 0])

private theorem sharedDestructorYieldCode :
    (Runtime.Thread.yield_ >>= fun _ => .pure (.flat [i32Flat 0]) : Session grow sig (Ret (core3 grow))) =
    sharedDestructorYieldDecision >>= sharedDestructorYieldAfter := by
  unfold Runtime.Thread.yield_ Thread.waitUntilGuest Thread.waitUntil sharedDestructorYieldDecision
  simp only [Prog.bind_eq, Prog.bind_assoc]
  congr 1
  funext thread
  congr 1
  funext now
  congr 1
  funext early
  cases early <;> simp [sharedDestructorYieldAfter, block, perform, Prog.bind_assoc]
  change (Prog.bind (Prog.bind (Thread.startWaiting thread .always : Session grow sig Unit)
    fun _ => (block none : Session grow sig Unit)) fun _ =>
      Prog.pure (Ret.flat (E := core3 grow) [i32Flat 0])) = _
  rw [Prog.bind_assoc]
  rfl

private theorem sharedDestructorYieldSpec :
    (Builtins.threadYield >>= fun words => .pure (.flat words) : Session grow sig (Ret (core3 grow))) =
    ((Builtins.enterThreadBuiltin >>= fun _ => sharedDestructorYieldDecision) >>= sharedDestructorYieldAfter) := by
  change (Prog.bind (Prog.bind (Builtins.enterThreadBuiltin : Session grow sig _) fun _ =>
      Prog.bind (Runtime.Thread.yield_ : Session grow sig Unit) fun _ => Prog.pure [i32Flat 0]) fun words =>
      Prog.pure (Ret.flat (E := core3 grow) words)) = _
  simp only [Prog.bind_eq, Prog.bind_assoc]
  congr 1
  funext entry
  change (Prog.bind (Runtime.Thread.yield_ : Session grow sig Unit) fun _ =>
    Prog.pure (Ret.flat (E := core3 grow) [i32Flat 0])) = _
  exact sharedDestructorYieldCode

private theorem destructorYieldDecisionEffects :
    StoreEffects (sharedDestructorYieldDecision : Session grow sig Bool) := by
  have choice (now : Bool) :
      StoreEffects ((if now then choose (.earlyReturn .yield_) else pure false) : Session grow sig Bool) := by
    cases now
    · exact .pure _
    · exact .op rfl fun _ => .pure _
  unfold sharedDestructorYieldDecision
  refine storeEffectCurrentThread.bind fun thread =>
    (storeEffectGet.bind fun _ => .pure _).bind fun now => (choice now).bind fun early => ?_
  cases early
  · exact (storeEffectModify _).bind fun _ => .pure _
  · exact .pure _

private theorem crossDestructorYield {worker : ThreadId} {frames peerFrames rest peerRest body}
    (parents : DestructorParentChain older body rest peerRest)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) frames peerFrames)
    (stores : start.store = incoming.store)
    (leftAt : start.ctl = (PayloadPrefix.Cursor.mk (some worker) frames rest).control
      (Builtins.threadYield >>= fun words => .pure (.flat words)))
    (rightAt : incoming.ctl = (PayloadPrefix.Cursor.mk (some worker) peerFrames peerRest).control
      (Builtins.threadYield >>= fun words => .pure (.flat words)))
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (returned : ∀ {left right : Config (core3 grow) (HostState sig)} {remaining : Trace grow sig},
      remaining.length ≤ labels.length → left.store = right.store →
      left.ctl = (PayloadPrefix.Cursor.mk (some worker) frames rest).control (.pure (.flat [i32Flat 0])) →
      right.ctl = (PayloadPrefix.Cursor.mk (some worker) peerFrames peerRest).control (.pure (.flat [i32Flat 0])) →
      Steps profile ready (specDispatch ready base) left remaining finish →
      CallbackSliceEnd profile ready base bindings older left right remaining finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, peerFrames, peerRest⟩
  let decision : Session grow sig Bool := Builtins.enterThreadBuiltin >>= fun _ => sharedDestructorYieldDecision
  have effects : StoreEffects decision := destructorThreadEntryEffects.bind fun _ => destructorYieldDecisionEffects
  refine crossSharedWorkerBody (check := check) (canon := canon) rfl decision sharedDestructorYieldAfter
    (liftDestructorStoreEffects effects (trivialPreserves _)) trivial stores
    (congrArg check.control sharedDestructorYieldSpec ▸ leftAt)
    (congrArg canon.control sharedDestructorYieldSpec ▸ rightAt) run ?_
  intro left right remaining early bounded _ same lAt rAt tail
  cases early with
  | false => exact crossDestructorPark parents segments (.pure (.flat [i32Flat 0])) same lAt rAt tail
  | true => exact returned bounded same lAt rAt tail

private theorem crossDestructorWait {worker : ThreadId} {frames peerFrames rest peerRest body}
    (parents : DestructorParentChain older body rest peerRest)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) frames peerFrames)
    (mem : (core3 grow).MemAddr) (index ptr : Nat) (stores : start.store = incoming.store)
    (leftAt : start.ctl = (PayloadPrefix.Cursor.mk (some worker) frames rest).control
      (Builtins.waitableSetWait Limits.spec mem index ptr >>= fun words => .pure (.flat words)))
    (rightAt : incoming.ctl = (PayloadPrefix.Cursor.mk (some worker) peerFrames peerRest).control
      (Builtins.waitableSetWait Limits.spec mem index ptr >>= fun words => .pure (.flat words)))
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (returned : ∀ {left right : Config (core3 grow) (HostState sig)} {remaining : Trace grow sig} (reply : List FlatValue),
      remaining.length ≤ labels.length → left.store = right.store →
      left.ctl = (PayloadPrefix.Cursor.mk (some worker) frames rest).control (.pure (.flat reply)) →
      right.ctl = (PayloadPrefix.Cursor.mk (some worker) peerFrames peerRest).control (.pure (.flat reply)) →
      Steps profile ready (specDispatch ready base) left remaining finish →
      CallbackSliceEnd profile ready base bindings older left right remaining finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, peerFrames, peerRest⟩
  let entered : Session grow sig WaitableCalloutEntry := do
    let current ← Builtins.enterWaitableBuiltin
    let set ← Builtins.expectWset (← handlesGet current index)
    pure ⟨current, set, ptr⟩
  let decision : Session grow sig (WaitableCalloutEntry × Option ThreadId) := do
    let entry ← entered
    let answer ← waitableWaitDecision entry
    pure (entry, answer)
  let afterDecision (result : WaitableCalloutEntry × Option ThreadId) : Session grow sig (Ret (core3 grow)) :=
    waitableWaitAfterDecision mem result.1 result.2
  have effects : StoreEffects decision :=
    (storeEffectEnterWaitable.bind fun inst => (storeEffectHandlesGet inst index).bind fun handle =>
      (storeEffectExpectWset handle).bind fun _ => .pure _).bind fun entry =>
      (waitableWaitDecisionEffects entry).bind fun answer => .pure (entry, answer)
  have source : (Builtins.waitableSetWait Limits.spec mem index ptr >>= fun words => .pure (.flat words) :
        Session grow sig (Ret (core3 grow))) = entered >>= waitableCalloutBody false mem := by
    simp [Builtins.waitableSetWait, entered, waitableCalloutBody, Prog.bind_assoc]
  have code : (Builtins.waitableSetWait Limits.spec mem index ptr >>= fun words => .pure (.flat words) :
        Session grow sig (Ret (core3 grow))) = decision >>= afterDecision := by
    rw [source]
    simp only [decision, afterDecision, Prog.bind_eq, Prog.bind_assoc, Prog.pure_eq, Prog.pure_bind']
    congr 1
    funext entry
    exact waitableWaitSplit mem entry
  refine crossSharedWorkerBody (check := check) (canon := canon) rfl decision afterDecision
    (liftDestructorStoreEffects effects (trivialPreserves _)) trivial stores
    (congrArg check.control code ▸ leftAt) (congrArg canon.control code ▸ rightAt) run ?_
  intro left right remaining result bounded _ same lAt rAt tail
  obtain ⟨entry, answer⟩ := result
  cases answer with
  | some thread =>
    exact crossDestructorPark parents segments (waitableWaitContinue mem entry) same lAt rAt tail
  | none =>
    let delivery : Session grow sig (List FlatValue) := do
      modifyStore (CStore.wsetDecWaitingSt entry.set)
      let event ← wsetGetPendingEvent entry.set
      let code ← unpackEvent (Builtins.eventCx mem entry.inst) entry.ptr event
      pure [i32Flat code]
    have deliveryCode : waitableWaitContinue mem entry = delivery >>= fun words => .pure (.flat words) := by
      simp [waitableWaitContinue, delivery, Prog.bind_assoc]
    have delivered : StoreEffects delivery := (storeEffectModify _).bind fun _ =>
      (selectWaitableEffects entry.set).bind fun event =>
      (waitableBufferEffects (Builtins.eventCx mem entry.inst) entry.ptr event).bind fun code => .pure [i32Flat code]
    have leftDelivery : left.ctl = check.control (delivery >>= fun words => .pure (.flat words)) :=
      lAt.trans (congrArg check.control deliveryCode)
    have rightDelivery : right.ctl = canon.control (delivery >>= fun words => .pure (.flat words)) :=
      rAt.trans (congrArg canon.control deliveryCode)
    exact crossSharedWorkerBody (check := check) (canon := canon) rfl delivery (fun words => .pure (.flat words))
      (liftDestructorStoreEffects delivered (trivialPreserves _)) trivial same leftDelivery rightDelivery tail
      (fun words shorter _ stores lAt rAt tail => returned words (shorter.trans bounded) stores lAt rAt tail)

private def destructorSwitchTarget (yielding : Bool) (index : Nat) : Session grow sig ThreadId := do
  let (_, _, task) ← Builtins.enterThreadBuiltin
  let target ← threadsGet task.inst index
  Builtins.trapUnlessSuspended target
  if yielding then
    let thread ← currentThreadId
    Thread.startWaiting thread .always
  pure target

private def destructorSwitchReply (target : ThreadId) : Session grow sig (Ret (core3 grow)) :=
  .op (.block (some target)) (fun _ => .pure (.flat [i32Flat 0]))

private theorem destructorSwitchSource (yielding : Bool) (index : Nat) :
    ((if yielding then Builtins.threadYieldThenResume index else Builtins.threadSuspendThenResume index) >>=
      fun words => .pure (.flat words) : Session grow sig (Ret (core3 grow))) =
      destructorSwitchTarget yielding index >>= destructorSwitchReply := by
  cases yielding <;>
    simp [Builtins.threadYieldThenResume, Builtins.threadSuspendThenResume, destructorSwitchTarget,
      destructorSwitchReply, Runtime.Thread.yieldThenResume, Runtime.Thread.suspendThenResume, Prog.bind_assoc] <;>
    congr 1

private theorem destructorSwitchEffects (yielding : Bool) (index : Nat) :
    StoreEffects (destructorSwitchTarget yielding index : Session grow sig ThreadId) := by
  unfold destructorSwitchTarget
  refine destructorThreadEntryEffects.bind fun (_, _, task) => (storeEffectThreadsGet task.inst index).bind fun target =>
    (storeEffectUnlessSuspended target).bind fun _ => ?_
  cases yielding
  · exact .pure target
  · exact storeEffectCurrentThread.bind fun thread =>
      (storeEffectModify (CStore.startWaitingSt thread .always)).bind fun _ => .pure target

private theorem crossDestructorSwitchBuiltin {worker : ThreadId} {frames peerFrames rest peerRest body}
    (parents : DestructorParentChain older body rest peerRest)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) frames peerFrames)
    (yielding : Bool) (index : Nat) (stores : start.store = incoming.store)
    (leftAt : start.ctl = (PayloadPrefix.Cursor.mk (some worker) frames rest).control
      ((if yielding then Builtins.threadYieldThenResume index else Builtins.threadSuspendThenResume index) >>=
        fun words => .pure (.flat words)))
    (rightAt : incoming.ctl = (PayloadPrefix.Cursor.mk (some worker) peerFrames peerRest).control
      ((if yielding then Builtins.threadYieldThenResume index else Builtins.threadSuspendThenResume index) >>=
        fun words => .pure (.flat words)))
    (run : Steps profile ready (specDispatch ready base) start labels finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, peerFrames, peerRest⟩
  have code := destructorSwitchSource (grow := grow) (sig := sig) yielding index
  refine crossSharedWorkerBody (check := check) (canon := canon) rfl (destructorSwitchTarget yielding index)
    destructorSwitchReply (liftDestructorStoreEffects (destructorSwitchEffects yielding index) (trivialPreserves _))
    trivial stores (congrArg check.control code ▸ leftAt) (congrArg canon.control code ▸ rightAt) run ?_
  intro left right _ target _ _ same lAt rAt tail
  exact .sharedDropSwitch parents segments same lAt rAt tail

private def destructorPromotionTarget (index : Nat) : Session grow sig ThreadId := do
  let (_, current, task) ← Builtins.enterThreadBuiltin
  trapIf (current.index == some index) .cannotResumeThread
  threadsGet task.inst index

private def destructorAfterPromotion (yielding : Bool) (target : ThreadId) (runnable : Bool) :
    Session grow sig (Ret (core3 grow)) :=
  (if runnable then
    Thread.stopWaiting target >>= fun _ =>
      if yielding then Thread.yieldThenResume target else Thread.suspendThenResume target
  else if yielding then Thread.yield_ else Thread.suspend) >>= fun _ => .pure (.flat [i32Flat 0])

private def destructorPromotionAfterStore (ready : HostReady (HostState sig)) (yielding : Bool)
    (target : ThreadId) (store : CStore (core3 grow)) (host : HostState sig) : Session grow sig (Ret (core3 grow)) :=
  destructorAfterPromotion yielding target (store.threadReady (ready host) target)

private def destructorPromotionRead (ready : HostReady (HostState sig)) (yielding : Bool) (target : ThreadId) :
    Session grow sig (Ret (core3 grow)) :=
  .op .get (fun store => .op .hostGet (destructorPromotionAfterStore ready yielding target store))

private theorem destructorPromotionSource (ready : HostReady (HostState sig)) (yielding : Bool) (index : Nat) :
    ((if yielding then Builtins.threadYieldThenPromote ready Quirks.none index
      else Builtins.threadSuspendThenPromote ready Quirks.none index) >>=
        fun words => .pure (.flat words) : Session grow sig (Ret (core3 grow))) =
      destructorPromotionTarget index >>= destructorPromotionRead ready yielding := by
  cases yielding <;>
    simp [Builtins.threadYieldThenPromote, Builtins.threadSuspendThenPromote, destructorPromotionTarget,
      Runtime.Thread.yieldThenPromote,
      Runtime.Thread.suspendThenPromote, Runtime.Thread.isPromotable, Runtime.Thread.isReady, Quirks.none,
      getStore, hostGet, perform, Prog.lift, Prog.bind_assoc, Prog.bind] <;>
    congr 1

private theorem destructorPromotionTargetEffects (index : Nat) :
    StoreEffects (destructorPromotionTarget index : Session grow sig ThreadId) := by
  unfold destructorPromotionTarget
  exact destructorThreadEntryEffects.bind fun (_, current, task) =>
    (storeEffectTrapIf (current.index == some index) .cannotResumeThread).bind fun _ =>
    storeEffectThreadsGet task.inst index

private theorem destructorPromotionSwitch (yielding : Bool) (target : ThreadId) :
    let edits : Session grow sig Unit := do
      Thread.stopWaiting target
      if yielding then
        let thread ← currentThreadId
        Thread.startWaiting thread .always
    destructorAfterPromotion yielding target true = edits >>= fun _ => destructorSwitchReply target := by
  cases yielding <;> simp [destructorAfterPromotion, destructorSwitchReply, Runtime.Thread.yieldThenResume,
    Runtime.Thread.suspendThenResume, block, perform, Prog.lift, Prog.bind_assoc, Prog.bind] <;> rfl

open ReturnFrame.Occurrence in
private theorem crossDestructorPromotionRead {worker : ThreadId} {frames peerFrames rest peerRest body}
    (parents : DestructorParentChain older body rest peerRest)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) frames peerFrames)
    (yielding : Bool) (target : ThreadId) (stores : start.store = incoming.store)
    (leftAt : start.ctl = (PayloadPrefix.Cursor.mk (some worker) frames rest).control
      (destructorPromotionRead ready yielding target))
    (rightAt : incoming.ctl = (PayloadPrefix.Cursor.mk (some worker) peerFrames peerRest).control
      (destructorPromotionRead ready yielding target))
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (returned : ∀ {left right : Config (core3 grow) (HostState sig)} {remaining : Trace grow sig},
      remaining.length ≤ labels.length → left.store = right.store →
      left.ctl = (PayloadPrefix.Cursor.mk (some worker) frames rest).control (.pure (.flat [i32Flat 0])) →
      right.ctl = (PayloadPrefix.Cursor.mk (some worker) peerFrames peerRest).control (.pure (.flat [i32Flat 0])) →
      Steps profile ready (specDispatch ready base) left remaining finish →
      CallbackSliceEnd profile ready base bindings older left right remaining finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, peerFrames, peerRest⟩
  let read := destructorPromotionAfterStore ready yielding target start.store
  let atReadLeft := { start with ctl := check.control (.op .hostGet read) }
  let atReadRight := { incoming with ctl := canon.control (.op .hostGet read) }
  have checkStore : Step profile ready (specDispatch ready base) start .tau atReadLeft := .get leftAt
  have rawStore : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau atReadRight := by
    let otherRead := destructorPromotionAfterStore ready yielding target incoming.store
    have step : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau
        { incoming with ctl := canon.control (.op .hostGet otherRead) } := .get rightAt
    have sameRead : otherRead = read := congrArg (destructorPromotionAfterStore ready yielding target) stores.symm
    rw [sameRead] at step
    exact step
  cases run with
  | refl => exact .exhausted
  | cons actual tail =>
    obtain ⟨rfl, rfl⟩ := silentStepUnique checkStore actual
    have storeRead := sharedSchedulerTransport (bindings := bindings) (edit := .same) checkStore rawStore
      (by rw [transitionEdit, leftAt]; rfl) (by rw [transitionEdit, rightAt]; rfl)
    refine .destructorPrefix storeRead (frameCalloutStep storeRead rfl rfl) (fun scheduler => scheduler) ?_
    rcases inspectReplyStep tail with ⟨rfl, stops⟩ | ⟨_, trailing, _, used, actual, tail⟩
    · exact stops ▸ CallbackSliceEnd.exhausted
    · rw [used]
      rw [used] at returned
      let checkNext := { atReadLeft with ctl := check.control (read atReadLeft.host) }
      let rawNext := { atReadRight with ctl := canon.control (read atReadRight.host) }
      have leftGet : Step profile ready (specDispatch ready base) atReadLeft .tau checkNext := .hostGet rfl
      have rightGet : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) atReadRight .tau rawNext :=
        .hostGet rfl
      obtain ⟨rfl, rfl⟩ := silentStepUnique leftGet actual
      have got := sharedSchedulerTransport (bindings := bindings) (edit := .same) leftGet rightGet rfl rfl
      classical
      by_cases agrees : read atReadLeft.host = read atReadRight.host
      · refine .destructorPrefix got (frameCalloutStep got rfl rfl) (fun scheduler => scheduler) ?_
        let runnable := start.store.threadReady (ready start.host) target
        have lhs : checkNext.ctl = check.control (destructorAfterPromotion yielding target runnable) := rfl
        have rhs : rawNext.ctl = canon.control (destructorAfterPromotion yielding target runnable) :=
          congrArg canon.control agrees.symm
        cases verdict : runnable with
        | true =>
          let edits : Session grow sig Unit := do
            Thread.stopWaiting target
            if yielding then
              let thread ← currentThreadId
              Thread.startWaiting thread .always
          have effects : StoreEffects edits := by
            refine (storeEffectModify (CStore.stopWaitingSt target)).bind fun _ => ?_
            cases yielding
            · exact .pure _
            · exact storeEffectCurrentThread.bind fun thread => storeEffectModify (CStore.startWaitingSt thread .always)
          rw [verdict] at lhs rhs
          have compiled : destructorAfterPromotion yielding target true =
              edits >>= fun _ => destructorSwitchReply target := destructorPromotionSwitch yielding target
          refine crossSharedWorkerBody (check := check) (canon := canon) rfl edits (fun _ => destructorSwitchReply target)
            (liftDestructorStoreEffects effects (trivialPreserves _)) trivial stores
            (congrArg check.control compiled ▸ lhs) (congrArg canon.control compiled ▸ rhs) tail ?_
          intro left right _ _ _ _ same checkAt canonAt residual
          exact .sharedDropSwitch parents segments same checkAt canonAt residual
        | false =>
          rw [verdict] at lhs rhs
          cases yielding with
          | false => exact crossDestructorPark parents segments (.pure (.flat [i32Flat 0])) stores lhs rhs tail
          | true =>
            have compiled : (destructorAfterPromotion true target false : Session grow sig (Ret (core3 grow))) =
                sharedDestructorYieldDecision >>= sharedDestructorYieldAfter := sharedDestructorYieldCode
            refine crossSharedWorkerBody (check := check) (canon := canon) rfl sharedDestructorYieldDecision
              sharedDestructorYieldAfter (liftDestructorStoreEffects destructorYieldDecisionEffects (trivialPreserves _))
              trivial stores (congrArg check.control compiled ▸ lhs) (congrArg canon.control compiled ▸ rhs) tail ?_
            intro left right remaining early bounded _ same lAt rAt residual
            cases early with
            | false => exact crossDestructorPark parents segments (.pure (.flat [i32Flat 0])) same lAt rAt residual
            | true => exact returned (Nat.le_trans bounded (by simp only [List.length_cons]; omega)) same lAt rAt residual
      · exact .observation rfl agrees got (frameCalloutStep got rfl rfl) tail

private theorem crossDestructorPromoteBuiltin {worker : ThreadId} {frames peerFrames rest peerRest body}
    (parents : DestructorParentChain older body rest peerRest)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) frames peerFrames)
    (yielding : Bool) (index : Nat) (stores : start.store = incoming.store)
    (leftAt : start.ctl = (PayloadPrefix.Cursor.mk (some worker) frames rest).control
      ((if yielding then Builtins.threadYieldThenPromote ready Quirks.none index
        else Builtins.threadSuspendThenPromote ready Quirks.none index) >>= fun words => .pure (.flat words)))
    (rightAt : incoming.ctl = (PayloadPrefix.Cursor.mk (some worker) peerFrames peerRest).control
      ((if yielding then Builtins.threadYieldThenPromote ready Quirks.none index
        else Builtins.threadSuspendThenPromote ready Quirks.none index) >>= fun words => .pure (.flat words)))
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (returned : ∀ {left right : Config (core3 grow) (HostState sig)} {remaining : Trace grow sig},
      remaining.length ≤ labels.length → left.store = right.store →
      left.ctl = (PayloadPrefix.Cursor.mk (some worker) frames rest).control (.pure (.flat [i32Flat 0])) →
      right.ctl = (PayloadPrefix.Cursor.mk (some worker) peerFrames peerRest).control (.pure (.flat [i32Flat 0])) →
      Steps profile ready (specDispatch ready base) left remaining finish →
      CallbackSliceEnd profile ready base bindings older left right remaining finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, peerFrames, peerRest⟩
  have code := destructorPromotionSource (grow := grow) ready yielding index
  refine crossSharedWorkerBody (check := check) (canon := canon) rfl (destructorPromotionTarget index)
    (destructorPromotionRead ready yielding)
    (liftDestructorStoreEffects (destructorPromotionTargetEffects index) (trivialPreserves _))
    trivial stores (congrArg check.control code ▸ leftAt) (congrArg canon.control code ▸ rightAt) run ?_
  intro left right _ target bounded _ same lAt rAt tail
  exact crossDestructorPromotionRead parents segments yielding target same lAt rAt tail
    (fun shorter => returned (shorter.trans bounded))

private theorem flatImportTrap (reason : TrapReason) :
    (trap reason >>= fun words => .pure (.flat words) : Session grow sig (Ret (core3 grow))) = trap reason := by
  simp only [trap, Prog.bind_eq, Prog.bind]
  congr 1
  funext empty
  cases empty

open ReturnFrame.Occurrence in
private theorem crossSharedDestructorImport {thread frames peerFrames rest peerRest core host args body}
    (task : TaskId) (tk : Task (core3 grow))
    (parents : DestructorParentChain older body rest peerRest)
    (activeThread : ∃ worker, thread = some worker)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) frames peerFrames)
    (stores : start.store = incoming.store)
    (leftAt : start.ctl = ⟨thread, .core core (sharedDestructorCoreResult task tk), frames⟩ :: rest)
    (rightAt : incoming.ctl = ⟨thread, .core core (sharedDestructorCoreResult task tk), peerFrames⟩ :: peerRest)
    (status : (core3 grow).status start.store.core core = .callout host args)
    (run : Steps profile ready (specDispatch ready base) start (.tau :: labels) finish)
    (reenter : SharedDestructorCoreContinuation profile ready base bindings older
      ⟨thread, frames, rest⟩ ⟨thread, peerFrames, peerRest⟩ task tk (.tau :: labels).length finish) :
    CallbackSliceEnd profile ready base bindings older start incoming (.tau :: labels) finish := by
  let frame : Seg (core3 grow) (HostState sig) := .core core (sharedDestructorCoreResult task tk)
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, frame :: frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, frame :: peerFrames, peerRest⟩
  let call : Call (core3 grow) := .hostCallout host args
  let left := { start with ctl := check.control (specDispatch ready base call) }
  let right := { incoming with ctl := canon.control (specDispatch ready (LiveDispatch.host bindings base) call) }
  have leftInstall : Step profile ready (specDispatch ready base) start .tau left := .coreCallout leftAt status
  have rightInstall : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau right :=
    .coreCallout rightAt (stores ▸ status)
  cases run with
  | cons actual tail =>
    obtain ⟨_, rfl⟩ := silentStepUnique leftInstall actual
    have installed := sharedSchedulerTransport (bindings := bindings) (edit := .push frame) leftInstall rightInstall
      (by simp only [transitionEdit, leftAt, status, frame])
      (by simp only [transitionEdit, rightAt, ← stores, status, frame])
    refine .destructorPrefix installed (frameCalloutStep installed rfl rfl) (fun scheduler => scheduler) ?_
    have checked := sharedDestructorImportReads (profile := profile) (ready := ready) (start := left) base check host args rfl
    have canonical := sharedDestructorImportReads (profile := profile) (ready := ready) (start := right)
      (LiveDispatch.host bindings base) canon host args rfl
    obtain ⟨used, remaining, reached, peer, split, paths, writers, residual, ending⟩ :=
      cutSharedQuietWorker checked canonical tail
    rw [split]
    rcases ending with empty | ⟨rfl, rfl⟩
    · subst remaining
      cases residual
      exact .comparedPrefix paths writers .exhausted
    · refine .destructorPrefix paths writers (fun scheduler => scheduler) ?_
      cases admitted : calloutEntry start.store thread host with
      | some reason =>
        have checkCode : sharedDestructorImportProgram ready base start.store thread host args = trap reason := by
          simp only [sharedDestructorImportProgram, admitted]
        have canonCode : sharedDestructorImportProgram ready (LiveDispatch.host bindings base) incoming.store thread host args =
            trap reason := by simp only [sharedDestructorImportProgram, ← stores, admitted]
        exact compareSharedDestructorTrap reason (congrArg check.control checkCode) (congrArg canon.control canonCode) residual
      | none =>
        have checkCode : sharedDestructorImportProgram ready base start.store thread host args =
            calloutBody Limits.spec Quirks.none ready base start.store thread host args := by
          simp only [sharedDestructorImportProgram, admitted]
        have canonCode : sharedDestructorImportProgram ready (LiveDispatch.host bindings base) incoming.store thread host args =
            calloutBody Limits.spec Quirks.none ready (LiveDispatch.host bindings base) incoming.store thread host args := by
          simp only [sharedDestructorImportProgram, ← stores, admitted]
        have checkAt := congrArg check.control checkCode
        have canonAt := congrArg canon.control canonCode
        have resumeCore {l r : Config (core3 grow) (HostState sig)} {restLabels : Trace grow sig}
            (words : List FlatValue) (bounded : restLabels.length ≤ remaining.length)
            (same : l.store = r.store) (lAt : l.ctl = check.control (.pure (.flat words)))
            (rAt : r.ctl = canon.control (.pure (.flat words)))
            (actual : Steps profile ready (specDispatch ready base) l restLabels finish) :
            CallbackSliceEnd profile ready base bindings older l r restLabels finish := by
          let k := sharedDestructorCoreResult (sig := sig) task tk
          let checked := { l with ctl := ⟨thread, .core ((core3 grow).resume l.store.core core (.values words)) k, frames⟩ :: rest }
          let raw := { r with ctl := ⟨thread, .core ((core3 grow).resume r.store.core core (.values words)) k, peerFrames⟩ :: peerRest }
          have leftPop : Step profile ready (specDispatch ready base) l .tau checked :=
            .popCore (th := thread) (ct := core) (k := k) (vs := words) (segs := frames) (rest := rest) lAt
          have rightPop : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) r .tau raw :=
            .popCore (th := thread) (ct := core) (k := k) (vs := words) (segs := peerFrames) (rest := peerRest) rAt
          rcases splitSilent (count := 1) (.cons leftPop (.refl _)) actual with ⟨after, usedPop, tail⟩ | short
          · rw [usedPop]
            have popped := sharedSchedulerTransport (bindings := bindings) (edit := .pop) leftPop rightPop
              (by rw [transitionEdit, lAt]; rfl) (by rw [transitionEdit, rAt]; rfl)
            refine .destructorPrefix popped (frameCalloutStep popped rfl rfl) (fun scheduler => scheduler) ?_
            have shorter : after.length < (.tau :: labels).length := by
              rw [split, List.length_cons, List.length_append]
              rw [usedPop] at bounded
              simp only [List.length_replicate, List.length_append] at bounded
              omega
            refine reenter (left := checked) (right := raw)
              (core := (core3 grow).resume l.store.core core (.values words)) shorter same rfl ?_ tail
            change ⟨thread, .core ((core3 grow).resume r.store.core core (.values words)) k, peerFrames⟩ :: peerRest = _
            rw [← same]
          · have empty : restLabels = [] := List.length_eq_zero_iff.mp (by omega)
            have stopped := stepsAtEmpty (empty ▸ actual)
            exact empty.symm ▸ stopped ▸ CallbackSliceEnd.exhausted
        by_cases localImport : sharedDestructorLocalImport host = true
        · obtain ⟨body, effects, compiled⟩ := sharedDestructorLocalProgram host args localImport
          have checkBody := checkAt.trans (congrArg check.control (compiled ready base start.store thread))
          have canonBody := canonAt.trans (congrArg canon.control
            (compiled ready (LiveDispatch.host bindings base) incoming.store thread))
          refine crossSharedWorkerBody (check := check) (canon := canon) rfl body (fun words => .pure (.flat words)) effects
            trivial stores checkBody canonBody residual ?_
          intro l r restLabels words bounded _ same lAt rAt actual
          exact resumeCore words bounded same lAt rAt actual
        · by_cases suspend : ∃ inst, host = .builtin .threadSuspend inst
          · obtain ⟨inst, rfl⟩ := suspend
            obtain ⟨worker, rfl⟩ := activeThread
            cases args with
            | nil => exact crossDestructorSuspend parents (.cons (.same frame) segments) stores checkAt canonAt residual
            | cons arg rest =>
              let reason := TrapReason.internal "built-in: wrong number of arguments"

              exact compareSharedDestructorTrap reason
                (checkAt.trans (congrArg check.control (flatImportTrap reason))) (canonAt.trans (congrArg canon.control (flatImportTrap reason))) residual
          · by_cases wait : ∃ mem inst, host = .builtin (.waitableSetWait mem) inst
            · obtain ⟨mem, inst, rfl⟩ := wait
              obtain ⟨worker, rfl⟩ := activeThread
              let reason := TrapReason.internal "built-in: wrong number of arguments"

              rcases args with _ | ⟨first, _ | ⟨second, _ | ⟨extra, tail⟩⟩⟩
              · exact compareSharedDestructorTrap reason
                  (checkAt.trans (congrArg check.control (flatImportTrap reason))) (canonAt.trans (congrArg canon.control (flatImportTrap reason))) residual
              · exact compareSharedDestructorTrap reason
                  (checkAt.trans (congrArg check.control (flatImportTrap reason))) (canonAt.trans (congrArg canon.control (flatImportTrap reason))) residual
              · exact crossDestructorWait parents (.cons (.same frame) segments) mem (flatNat first) (flatNat second)
                  stores checkAt canonAt residual resumeCore
              · exact compareSharedDestructorTrap reason
                  (checkAt.trans (congrArg check.control (flatImportTrap reason))) (canonAt.trans (congrArg canon.control (flatImportTrap reason))) residual
            · by_cases yielding : ∃ inst, host = .builtin .threadYield inst
              · obtain ⟨inst, rfl⟩ := yielding
                obtain ⟨worker, rfl⟩ := activeThread
                cases args with
                | nil =>
                  exact crossDestructorYield parents (.cons (.same frame) segments) stores checkAt canonAt residual
                    (resumeCore [i32Flat 0])
                | cons arg rest =>
                  let reason := TrapReason.internal "built-in: wrong number of arguments"
                  exact compareSharedDestructorTrap reason
                    (checkAt.trans (congrArg check.control (flatImportTrap reason)))
                    (canonAt.trans (congrArg canon.control (flatImportTrap reason))) residual
              · by_cases switched : ∃ (isYield : Bool) (inst : InstId), host =
                    .builtin (if isYield then .threadYieldThenResume else .threadSuspendThenResume) inst
                · obtain ⟨isYield, inst, rfl⟩ := switched
                  obtain ⟨worker, rfl⟩ := activeThread
                  let reason := TrapReason.internal "built-in: wrong number of arguments"
                  cases isYield <;> rcases args with _ | ⟨word, _ | ⟨extra, tail⟩⟩
                  all_goals
                    first
                    | exact crossDestructorSwitchBuiltin parents (.cons (.same frame) segments)
                        false (flatNat word) stores checkAt canonAt residual
                    | exact crossDestructorSwitchBuiltin parents (.cons (.same frame) segments)
                        true (flatNat word) stores checkAt canonAt residual
                    | exact compareSharedDestructorTrap reason
                        (checkAt.trans (congrArg check.control (flatImportTrap reason)))
                        (canonAt.trans (congrArg canon.control (flatImportTrap reason))) residual
                · by_cases promote : ∃ (isYield : Bool) (inst : InstId), host =
                      .builtin (if isYield then .threadYieldThenPromote else .threadSuspendThenPromote) inst
                  · obtain ⟨isYield, inst, rfl⟩ := promote
                    obtain ⟨worker, rfl⟩ := activeThread
                    let reason := TrapReason.internal "built-in: wrong number of arguments"
                    cases isYield <;> rcases args with _ | ⟨word, _ | ⟨extra, tail⟩⟩
                    all_goals
                      first
                      | exact crossDestructorPromoteBuiltin parents (.cons (.same frame) segments)
                          false (flatNat word) stores checkAt canonAt residual (resumeCore [i32Flat 0])
                      | exact crossDestructorPromoteBuiltin parents (.cons (.same frame) segments)
                          true (flatNat word) stores checkAt canonAt residual (resumeCore [i32Flat 0])
                      | exact compareSharedDestructorTrap reason
                          (checkAt.trans (congrArg check.control (flatImportTrap reason)))
                          (canonAt.trans (congrArg canon.control (flatImportTrap reason))) residual
                  · exact .sharedDropWorkerImport parents segments admitted stores checkAt canonAt residual

private theorem rejoinDestructorParentJournal {limit : Nat} {sourceCfg peerCfg : Config (core3 grow) (HostState sig)}
    {actualLabels : Trace grow sig}
    (ending : CallbackSliceEnd profile ready base bindings older sourceCfg peerCfg actualLabels finish)
    (scheduler : DestructorSchedulerAlignment older sourceCfg peerCfg)
    (bounded : actualLabels.length ≤ limit) (compare : ShorterCallbackSlices profile ready base bindings limit) :
    CallbackSliceEnd profile ready base bindings older sourceCfg peerCfg actualLabels finish := by
  match ending with
  | .destructorPrefix paths writers next tail =>
    exact .destructorPrefix paths writers next
      (rejoinDestructorParentJournal tail (next scheduler) (by simp only [List.length_append] at bounded; omega) compare)
  | .sharedDropParentPop paths writers checkedLost canonicalLost restore residual =>
    have restored := restore scheduler
    obtain ⟨used, live, trailing, reached, peer, split, compared, tail⟩ :=
      compare (Nat.lt_of_succ_le bounded) residual restored
    rw [split]
    exact .sharedDropParentJoined paths writers checkedLost canonicalLost restored
      (.comparedPrefix compared.occurrences compared.writers tail)
  | other => exact other
termination_by structural ending

open ReturnFrame.Occurrence in
private theorem destructorEnclosingFrame {config : Config (core3 grow) (HostState sig)}
    {cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)} {resume value enclosing}
    (focused : config.ctl = { cursor with frames := .prog resume :: cursor.frames }.control (.pure value))
    (marked : segmentAt (segmentStorage config) (.active 0 1) = some enclosing) :
    ∃ frames, cursor.frames = enclosing :: frames := by
  cases cursor with
  | mk thread frames rest =>
    cases frames with
    | nil => simp [segmentStorage, segmentAt, focused, PayloadPrefix.Cursor.control] at marked
    | cons first tail =>
      have frame : first = enclosing := by
        simpa [segmentStorage, segmentAt, focused, PayloadPrefix.Cursor.control] using marked
      exact ⟨tail, by rw [frame]⟩

open ReturnFrame.Occurrence in
private theorem finishBlockedDestructorLoop {limit leftTicket rightTicket : Nat}
    {enclosing : Seg (core3 grow) (HostState sig)}
    (frames : DestructorParentLoopFrames (sharedDestructorParentReply leftTicket) (sharedDestructorParentReply rightTicket)
      enclosing start incoming)
    (aligned : HostFrame.Related.Paired (ReturnFrame.Extend older (sharedDestructorParentReply leftTicket)
      (sharedDestructorParentReply rightTicket)) start incoming)
    (outside : Outside older (segmentStorage start) (segmentStorage incoming) (some (.active 0 0)))
    (residual : Steps profile ready (specDispatch ready base) start labels finish)
    (shorter : labels.length < limit) (compare : ShorterCallbackSlices profile ready base bindings limit) :
    CallbackSliceEnd profile ready base bindings (ReturnFrame.Extend older (sharedDestructorParentReply leftTicket)
      (sharedDestructorParentReply rightTicket)) start incoming labels finish := by
  obtain ⟨used, live, trailing, reached, peer, split, compared, tail⟩ := compare shorter residual aligned
  rw [split]
  refine .comparedPrefix compared.occurrences compared.writers ?_
  obtain ⟨move, tracks, retained⟩ := compared.occurrences
  let top : Option Location := some (.active 0 0)
  classical
  by_cases atTop : move top = top
  · have lostOutside : Outside older (segmentStorage reached) (segmentStorage peer) top := by
      have moved := retained older [top] (outsideMarks_singleton.mpr outside)
      exact outsideMarks_singleton.mp (by simpa only [List.nil_append, List.map_cons, List.map_nil, atTop] using moved)
    have leftTrail := (atTop ▸ (tracks top).1)
    have rightTrail := (atTop ▸ (tracks top).2)
    have marked : AllocatorMark profile ready base bindings older start incoming used live reached peer top :=
      ⟨lostOutside, leftTrail, rightTrail, CallbackPrefix.transportPaths compared.occurrences⟩
    obtain ⟨_, atLeft, leftPrefix⟩ := leftTrail.survives
    obtain ⟨_, atRight, rightPrefix⟩ := rightTrail.survives
    dsimp only [top] at atLeft atRight
    cases atLeft
    cases atRight
    let first := sharedDestructorParentReply (grow := grow) (sig := sig) leftTicket
    let second := sharedDestructorParentReply (grow := grow) (sig := sig) rightTicket
    by_cases returning : ∃ (cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)) (value : Ret (core3 grow)),
        reached.ctl = cursor.control (.pure value)
    · obtain ⟨cursor, value, focus⟩ := returning
      obtain ⟨check, focused⟩ := cursorAtInstalledReply focus
        ((prefix_survives leftPrefix).2.trans frames.checkedLoop)
      have returning := focused ▸ focus
      obtain ⟨canon, frame, checked, canonical, _, _, _, canonAt⟩ :=
        CallbackPrefix.pop marked compared.paired returning frames.canonicalLoop
      have leftEnclosing : segmentAt (segmentStorage reached) (.active 0 1) = some enclosing :=
        (prefix_survives (leftPrefix.under 1)).2.trans frames.checkedEnclosing
      have rightEnclosing : segmentAt (segmentStorage peer) (.active 0 1) = some enclosing :=
        (prefix_survives (rightPrefix.under 1)).2.trans frames.canonicalEnclosing
      obtain ⟨checkFrames, checkAt⟩ := destructorEnclosingFrame returning leftEnclosing
      obtain ⟨canonFrames, canonFramesAt⟩ := destructorEnclosingFrame canonAt rightEnclosing
      let left := { reached with ctl := check.control (first value) }
      let right := { peer with ctl := canon.control (second value) }
      rcases splitSilent (count := 1) (.cons checked (.refl _)) (callbackEndSteps tail)
        with ⟨remaining, popped, actual⟩ | short
      · rw [popped]
        have checkedEdit : transitionEdit reached .tau = .pop := by
          rw [transitionEdit, returning]; rfl
        have canonicalEdit : transitionEdit peer .tau = .pop := by
          rw [transitionEdit, canonAt]; rfl
        have paths := sharedSchedulerTransport (bindings := bindings) (edit := .pop)
          checked canonical checkedEdit canonicalEdit
        have checkedLost : Trail profile ready (specDispatch ready base) reached top [.tau] left none :=
          .step checked (by rw [checkedEdit]; exact .done _ _)
        have canonicalLost : Trail profile ready (specDispatch ready (LiveDispatch.host bindings base)) peer top [.tau] right none :=
          .step canonical (by rw [canonicalEdit]; exact .done _ _)
        have checkedCaller : Trail profile ready (specDispatch ready base) start (some (.active 0 1))
            (used ++ [.tau]) left (some (.active 0 0)) :=
          (leftPrefix.under 1).toTrail.append (Trail.pop_prog (some (.active 0 1)) returning)
        have canonicalCaller : Trail profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming
            (some (.active 0 1)) (live ++ [.tau]) right (some (.active 0 0)) :=
          (rightPrefix.under 1).toTrail.append (Trail.pop_prog (some (.active 0 1)) canonAt)
        refine .sharedDropLoopReturn paths (frameCalloutStep paths rfl rfl) checkedLost canonicalLost
          checkedCaller canonicalCaller ?_
        cases value with
        | unit =>
          have segments := frame.frames
          rw [checkAt, canonFramesAt] at segments
          cases segments with
          | cons _ related =>
            have checkedJournal : left.ctl =
                (PayloadPrefix.Cursor.mk check.thread (enclosing :: checkFrames) check.rest).control
                  (scheduledReply leftTicket (.ok 0)) := by
              simp only [left, PayloadPrefix.Cursor.control, checkAt, first, sharedDestructorParentReply]
            have rawJournal : right.ctl =
                (PayloadPrefix.Cursor.mk check.thread (enclosing :: canonFrames) canon.rest).control
                  (scheduledReply rightTicket (.ok 0)) := by
              simp only [right, PayloadPrefix.Cursor.control, canonFramesAt, ← frame.thread, second, sharedDestructorParentReply]
            have journal := compareDestructorParentJournal (bindings := bindings) (start := left) (incoming := right)
              leftTicket rightTicket frame.store related frame.rest checkedJournal rawJournal actual
            have scheduler : DestructorSchedulerAlignment older left right :=
              ⟨frame.blocked, frame.pending, frame.results, frame.cancels⟩
            have bound : remaining.length ≤ limit := by
              rw [split, popped] at shorter
              simp only [List.length_append, List.length_replicate] at shorter
              omega
            exact rejoinDestructorParentJournal journal scheduler bound compare
        | _ => exact compareSharedDestructorTrap (.internal "late-bound call: expected Ret.unit") rfl rfl actual
      · exact tail
    · exact tail
  · exact tail

private theorem rejoinDestructorLoopEntry {limit : Nat} {sourceCfg peerCfg : Config (core3 grow) (HostState sig)}
    {actualLabels : Trace grow sig}
    (ending : CallbackSliceEnd profile ready base bindings older sourceCfg peerCfg actualLabels finish)
    (scheduler : DestructorSchedulerAlignment older sourceCfg peerCfg)
    (bounded : actualLabels.length ≤ limit) (compare : ShorterCallbackSlices profile ready base bindings limit) :
    CallbackSliceEnd profile ready base bindings older sourceCfg peerCfg actualLabels finish := by
  match ending with
  | .sharedDropParentLoop paths writers frames restore residual =>
    obtain ⟨restored, outside⟩ := restore scheduler
    exact .sharedDropParentLoopJoined paths writers restored
      (finishBlockedDestructorLoop frames restored outside residual (Nat.lt_of_succ_le bounded) compare)
  | other => exact other

open ReturnFrame.Occurrence in
private theorem finishDestructorSwitchTarget {limit : Nat} {body : ThreadBody (core3 grow)}
    {rest peerRest left right active peerActive}
    (parents : DestructorParentChain older body rest peerRest)
    (target : ReturnFrame.Related.Active older left right)
    (resumers : List.Forall₂ (ReturnFrame.Related.Active older) active peerActive)
    (stores : start.store = incoming.store)
    (scheduler : DestructorSchedulerAlignment older start incoming)
    (leftAt : start.ctl = left :: (active ++ rest)) (rightAt : incoming.ctl = right :: (peerActive ++ peerRest))
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (bounded : labels.length ≤ limit) (compare : ShorterCallbackSlices profile ready base bindings limit) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  induction labels generalizing start incoming left right active peerActive finish with
  | nil =>
    cases run
    exact .exhausted
  | cons label trailing ih =>
    cases run with
    | cons actual tail =>
      have frontier := CallbackSliceEnd.sharedDropSwitchTarget (bindings := bindings)
        parents target resumers stores scheduler leftAt rightAt (.cons actual tail)
      have shorter : trailing.length ≤ limit := by simp only [List.length_cons] at bounded; omega
      have leave {lhs rhs : Config (core3 grow) (HostState sig)}
          (same : lhs.store = rhs.store) (aligned : DestructorSchedulerAlignment older lhs rhs)
          (lhsAt : lhs.ctl = active ++ rest) (rhsAt : rhs.ctl = peerActive ++ peerRest)
          (residual : Steps profile ready (specDispatch ready base) lhs trailing finish) :
          CallbackSliceEnd profile ready base bindings older lhs rhs trailing finish := by
        cases resumers with
        | nil =>
          have reached : DestructorParentChain older body lhs.ctl rhs.ctl := by
            rw [lhsAt, rhsAt]
            exact parents
          exact rejoinDestructorLoopEntry (enterDestructorParentLoop reached same residual) aligned shorter compare
        | cons front others => exact ih front others same aligned lhsAt rhsAt residual shorter
      have parentPresent : rest ≠ [] ∧ peerRest ≠ [] := by
        cases parents
        exact ⟨List.cons_ne_nil _ _, List.cons_ne_nil _ _⟩
      cases target with
      | @mk thread focus frames peerFrames segments =>
        have advance {lhs rhs : Config (core3 grow) (HostState sig)}
            {next : Focus (core3 grow) (HostState sig)} {outFrames outPeerFrames}
            (leftStep : Step profile ready (specDispatch ready base) start label lhs)
            (rightStep : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming label rhs)
            (residual : Steps profile ready (specDispatch ready base) lhs trailing finish)
            (related : List.Forall₂ (ReturnFrame.Related.Segment older) outFrames outPeerFrames)
            (leftNext : lhs.ctl = ⟨thread, next, outFrames⟩ :: (active ++ rest))
            (rightNext : rhs.ctl = ⟨thread, next, outPeerFrames⟩ :: (peerActive ++ peerRest))
            (same : lhs.store = rhs.store)
            (aligned : DestructorSchedulerAlignment older lhs rhs)
            (leftWriter : lhs.host.writer = start.host.writer) (rightWriter : rhs.host.writer = incoming.host.writer)
            {edit : Edit (core3 grow) (HostState sig)}
            (leftEdit : transitionEdit start label = edit) (rightEdit : transitionEdit incoming label = edit) :
            CallbackSliceEnd profile ready base bindings older start incoming (label :: trailing) finish := by
          have paths := sharedSchedulerTransport (bindings := bindings) leftStep rightStep leftEdit rightEdit
          exact .destructorPrefix paths (.framed (.same leftStep leftWriter (.done _)) (.same rightStep rightWriter (.done _)))
            (fun _ => aligned) (ih (.mk related) resumers same aligned leftNext rightNext residual shorter)
        cases actual with
        | @call _ request resume _ _ atCall =>
          rw [leftAt] at atCall
          cases atCall
          by_cases shared : LiveDispatch.Unchanged bindings request
          · have code := LiveDispatch.unchanged_dispatch (ready := ready) (base := base) shared
            have raw := Step.call (prof := profile) (hr := ready)
              (dispatch := specDispatch ready (LiveDispatch.host bindings base)) rightAt
            rw [← code] at raw
            exact advance (edit := .push (.prog resume)) (.call leftAt) raw tail (.cons (.same _) segments) rfl rfl
              stores scheduler rfl rfl (by rw [transitionEdit, leftAt]) (by rw [transitionEdit, rightAt])
          · exact frontier
        | callCore atCall =>
          rw [leftAt] at atCall
          cases atCall
          exact advance (.callCore leftAt) (.callCore rightAt) tail segments rfl rfl stores scheduler rfl rfl
            (by rw [transitionEdit, leftAt]) (by rw [transitionEdit, rightAt])
        | coreInternal atCore status internal =>
          rw [leftAt] at atCore
          cases atCore
          rename_i coreStore coreStep
          have raw := Step.coreInternal (prof := profile) (hr := ready)
            (dispatch := specDispatch ready (LiveDispatch.host bindings base)) rightAt (stores ▸ status) (stores ▸ internal)
          exact advance (.coreInternal leftAt status internal) raw tail segments rfl rfl
            (by change { start.store with core := coreStore } = { incoming.store with core := coreStore }; rw [stores])
            scheduler rfl rfl rfl rfl
        | coreReturned atCore status =>
          rw [leftAt] at atCore
          cases atCore
          have raw := Step.coreReturned (prof := profile) (hr := ready)
            (dispatch := specDispatch ready (LiveDispatch.host bindings base)) rightAt (stores ▸ status)
          exact advance (edit := .same) (.coreReturned leftAt status) raw tail segments rfl rfl stores scheduler rfl rfl
            (by simp only [transitionEdit, leftAt, status]) (by simp only [transitionEdit, rightAt, ← stores, status])
        | @coreCallout _ core resume _ _ host args atCall status =>
          rw [leftAt] at atCall
          cases atCall
          by_cases shared : LiveDispatch.Unchanged bindings (.hostCallout host args)
          · have code := LiveDispatch.unchanged_dispatch (ready := ready) (base := base) shared
            have rawStatus := stores ▸ status
            have raw := Step.coreCallout (prof := profile) (hr := ready)
              (dispatch := specDispatch ready (LiveDispatch.host bindings base)) rightAt rawStatus
            rw [← code] at raw
            exact advance (edit := .push (.core core resume)) (.coreCallout leftAt status) raw tail
              (.cons (.same _) segments) rfl rfl stores scheduler rfl rfl
              (by simp only [transitionEdit, leftAt, status])
              (by simp only [transitionEdit, rightAt, rawStatus])
          · exact frontier
        | coreTrap atCore status =>
          rw [leftAt] at atCore
          cases atCore
          have raw := Step.coreTrap (prof := profile) (hr := ready)
            (dispatch := specDispatch ready (LiveDispatch.host bindings base)) rightAt (stores ▸ status)
          have paths := sharedSchedulerTransport (bindings := bindings) (edit := .clear) (.coreTrap leftAt status) raw rfl rfl
          exact .coreAcceptTerminal paths (frameCalloutStep paths rfl rfl) tail (.inr (.inr (.inr ⟨rfl, rfl⟩)))
        | @get _ read _ _ atGet =>
          rw [leftAt] at atGet
          cases atGet
          have raw := Step.get (prof := profile) (hr := ready)
            (dispatch := specDispatch ready (LiveDispatch.host bindings base)) rightAt
          exact advance (.get leftAt) raw tail segments rfl
            (by change ⟨thread, .prog (read incoming.store), peerFrames⟩ :: (peerActive ++ peerRest) = _; rw [stores])
            stores scheduler rfl rfl (by rw [transitionEdit, leftAt]) (by rw [transitionEdit, rightAt])
        | @modify _ update _ _ _ atWrite =>
          rw [leftAt] at atWrite
          cases atWrite
          exact advance (.modify leftAt) (.modify rightAt) tail segments rfl rfl (congrArg update stores) scheduler rfl rfl
            (by rw [transitionEdit, leftAt]) (by rw [transitionEdit, rightAt])
        | currentThread atThread =>
          rw [leftAt] at atThread
          cases atThread
          exact advance (.currentThread leftAt) (.currentThread rightAt) tail segments rfl rfl stores scheduler rfl rfl
            (by rw [transitionEdit, leftAt]) (by rw [transitionEdit, rightAt])
        | choose answer atChoice allowed =>
          rw [leftAt] at atChoice
          cases atChoice
          exact advance (.choose answer leftAt allowed) (.choose answer rightAt allowed) tail
            segments rfl rfl stores scheduler rfl rfl rfl rfl
        | @hostGet _ read _ _ atRead =>
          rw [leftAt] at atRead
          cases atRead
          have raw := Step.hostGet (prof := profile) (hr := ready)
            (dispatch := specDispatch ready (LiveDispatch.host bindings base)) rightAt
          classical
          by_cases agrees : read start.host = read incoming.host
          · exact advance (.hostGet leftAt) raw tail segments rfl
              (by change ⟨thread, .prog (read incoming.host), peerFrames⟩ :: (peerActive ++ peerRest) = _; rw [agrees])
              stores scheduler rfl rfl
              (by rw [transitionEdit, leftAt]) (by rw [transitionEdit, rightAt])
          · have paths := sharedSchedulerTransport (bindings := bindings) (edit := .same) (.hostGet leftAt) raw
              (by rw [transitionEdit, leftAt]) (by rw [transitionEdit, rightAt])
            exact .observation leftAt agrees paths (frameCalloutStep paths rfl rfl) tail
        | @emit _ notice _ _ _ atEmit =>
          rw [leftAt] at atEmit
          cases atEmit
          have aligned : DestructorSchedulerAlignment older (StepDefs.observe start notice)
              (StepDefs.observe incoming notice) := by
            cases notice with
            | resolved call values => exact DestructorSchedulerAlignment.observeResolved scheduler call values
            | _ => exact scheduler
          exact advance (.emit leftAt) (.emit rightAt) tail segments rfl rfl
            (by cases notice <;> exact stores) aligned (by cases notice <;> rfl) (by cases notice <;> rfl) rfl rfl
        | @newThread _ bodyCode resume _ _ store threadId atNew allocated =>
          rw [leftAt] at atNew
          cases atNew
          have dispatchCode := LiveDispatch.unchanged_dispatch (ready := ready) (base := base)
            (bindings := bindings) (call := .threadBody bodyCode) trivial
          let saved := StepDefs.threadAct (specDispatch ready base) threadId bodyCode
          have sameBody : StepDefs.threadAct (specDispatch ready (LiveDispatch.host bindings base)) threadId bodyCode =
              saved := by
            change Activation.ofProg (some threadId) (specDispatch ready (LiveDispatch.host bindings base) (.threadBody bodyCode)) =
              Activation.ofProg (some threadId) (specDispatch ready base (.threadBody bodyCode))
            rw [← dispatchCode]
          have raw := Step.newThread (prof := profile) (hr := ready)
            (dispatch := specDispatch ready (LiveDispatch.host bindings base)) rightAt (stores ▸ allocated)
          rw [sameBody] at raw
          exact advance (edit := .write threadId.idx []) (.newThread leftAt allocated) raw tail segments
            rfl rfl rfl ⟨relatedSetSlot .none scheduler.1 threadId.idx (.some (.mk .nil)), scheduler.2⟩ rfl rfl
            (by simp only [transitionEdit, leftAt, allocated])
            (by simp only [transitionEdit, rightAt, ← stores, allocated])
        | trap atTrap =>
          rw [leftAt] at atTrap
          cases atTrap
          have paths := sharedSchedulerTransport (profile := profile) (ready := ready) (base := base)
            (bindings := bindings) (edit := .clear)
            (.trap leftAt) (.trap rightAt) rfl rfl
          exact .coreAcceptTerminal paths (frameCalloutStep paths rfl rfl) tail (.inr (.inr (.inr ⟨rfl, rfl⟩)))
        | popCore atPop =>
          rw [leftAt] at atPop
          cases atPop
          cases segments with
          | cons head tails =>
            cases head
            have raw := Step.popCore (prof := profile) (hr := ready)
              (dispatch := specDispatch ready (LiveDispatch.host bindings base)) rightAt
            rw [congrArg CStore.core stores.symm] at raw
            exact advance (.popCore leftAt) raw tail tails rfl rfl stores scheduler rfl rfl
              (by rw [transitionEdit, leftAt]) (by rw [transitionEdit, rightAt]; rfl)
        | @popProg _ result resume _ _ atPop =>
          rw [leftAt] at atPop
          cases atPop
          cases segments with
          | cons head tails =>
            cases head with
            | same _ =>
              exact advance (.popProg leftAt) (.popProg rightAt) tail tails rfl rfl stores scheduler rfl rfl
                (by rw [transitionEdit, leftAt]) (by rw [transitionEdit, rightAt]; rfl)
            | @swap _ second source =>
              classical
              by_cases agrees : resume result = second result
              · exact advance (.popProg leftAt) (.popProg rightAt) tail tails rfl
                  (by change ⟨thread, .prog (second result), _⟩ :: (peerActive ++ peerRest) = _; rw [← agrees])
                  stores scheduler rfl rfl (by rw [transitionEdit, leftAt]) (by rw [transitionEdit, rightAt]; rfl)
              · exact .boundary (.protectedPop ⟨second, source⟩ leftAt) (.popProg leftAt) tail
        | threadExit atExit =>
          rw [leftAt] at atExit
          cases atExit
          cases segments
          have raw := Step.threadExit (prof := profile) (hr := ready)
            (dispatch := specDispatch ready (LiveDispatch.host bindings base)) rightAt
          have paths := sharedSchedulerTransport (bindings := bindings) (edit := .exit) (.threadExit leftAt) raw
            (by rw [transitionEdit, leftAt]; rfl) (by rw [transitionEdit, rightAt]; rfl)
          refine .destructorPrefix paths (frameCalloutStep paths rfl rfl) (fun same => same) ?_
          exact leave (congrArg (StepDefs.threadStatusSt _ .exited) stores) scheduler rfl rfl tail
        | @hostDone value _ atDone =>
          rw [leftAt] at atDone
          cases atDone
          cases segments
          have leftTail : active ++ rest ≠ [] := fun empty =>
            parentPresent.1 (List.append_eq_nil_iff.mp empty).2
          have rightTail : peerActive ++ peerRest ≠ [] := fun empty =>
            parentPresent.2 (List.append_eq_nil_iff.mp empty).2
          have finishes (cfg : Config (core3 grow) (HostState sig))
              (stack : List (Activation (core3 grow) (HostState sig))) (present : stack ≠ []) :
              StepDefs.hostFinish value stack cfg = { cfg with ctl := stack } := by
            cases stack with
            | nil => exact (present rfl).elim
            | cons => rfl
          have checked := Step.hostDone (prof := profile) (hr := ready) (dispatch := specDispatch ready base) leftAt
          have raw := Step.hostDone (prof := profile) (hr := ready)
            (dispatch := specDispatch ready (LiveDispatch.host bindings base)) rightAt
          rw [finishes _ _ leftTail] at checked tail
          rw [finishes _ _ rightTail] at raw
          have paths := sharedSchedulerTransport (bindings := bindings) (edit := .exit) checked raw
            (by rw [transitionEdit, leftAt]; rfl) (by rw [transitionEdit, rightAt]; rfl)
          exact .destructorPrefix paths (frameCalloutStep paths rfl rfl) (fun same => same)
            (leave stores scheduler rfl rfl tail)
        | @block worker reply _ _ atBlock =>
          rw [leftAt] at atBlock
          cases atBlock
          have raw := Step.block (prof := profile) (hr := ready)
            (dispatch := specDispatch ready (LiveDispatch.host bindings base)) rightAt
          have paths := sharedSchedulerTransport (bindings := bindings) (edit := .block _) (.block leftAt) raw
            (by rw [transitionEdit, leftAt]; rfl) (by rw [transitionEdit, rightAt]; rfl)
          let savedLeft := StepDefs.blockedAct (E := core3 grow) worker reply frames
          let savedRight := StepDefs.blockedAct (E := core3 grow) worker reply peerFrames
          let blockedLeft := { start.setCont worker (some savedLeft) with
            store := StepDefs.threadStatusSt worker .blocked start.store, ctl := active ++ rest }
          let blockedRight := { incoming.setCont worker (some savedRight) with
            store := StepDefs.threadStatusSt worker .blocked incoming.store, ctl := peerActive ++ peerRest }
          have save (before : DestructorSchedulerAlignment older start incoming) :
              DestructorSchedulerAlignment older blockedLeft blockedRight :=
            ⟨relatedSetSlot .none before.1 worker.idx (.some (.mk segments)), before.2⟩
          refine .destructorPrefix paths (frameCalloutStep paths rfl rfl) save ?_
          exact leave (congrArg (StepDefs.threadStatusSt _ .blocked) stores) (save scheduler) rfl rfl tail
        | @blockSwitch worker switched reply _ _ next atSwitch found =>
          rw [leftAt] at atSwitch
          cases atSwitch
          let savedLeft := start.setCont worker (some (StepDefs.blockedAct worker reply frames))
          let savedRight := incoming.setCont worker (some (StepDefs.blockedAct worker reply peerFrames))
          have saved : List.Forall₂ (ReturnFrame.Related.Saved older) savedLeft.conts savedRight.conts :=
            relatedSetSlot .none scheduler.1 worker.idx (.some (.mk segments))
          have slot := relatedContLookup saved switched
          rw [found] at slot
          obtain ⟨peer, rawFound, selected⟩ := relatedSavedSome slot
          let update (store : CStore (core3 grow)) :=
            StepDefs.threadStatusSt switched .running (StepDefs.threadStatusSt worker .blocked store)
          let lhs := { savedLeft.setCont switched none with store := update start.store, ctl := next :: (active ++ rest) }
          let rhs := { savedRight.setCont switched none with store := update incoming.store, ctl := peer :: (peerActive ++ peerRest) }
          have checked : Step profile ready (specDispatch ready base) start .tau lhs := .blockSwitch leftAt found
          have raw : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau rhs :=
            .blockSwitch rightAt rawFound
          have moved := sharedSchedulerTransport (bindings := bindings) (edit := .switch worker.idx switched.idx)
            checked raw (by rw [transitionEdit, leftAt]; rfl) (by rw [transitionEdit, rightAt]; rfl)
          have aligned : DestructorSchedulerAlignment older lhs rhs :=
            ⟨relatedSetSlot .none saved switched.idx .none, scheduler.2⟩
          exact .destructorPrefix moved (frameCalloutStep moved rfl rfl) (fun _ => aligned)
            (ih selected resumers (congrArg update stores) aligned rfl rfl tail shorter)
        | @resumeThread _ resumed resume _ _ next atResume found =>
          rw [leftAt] at atResume
          cases atResume
          have slot := relatedContLookup scheduler.1 resumed
          rw [found] at slot
          obtain ⟨peer, rawFound, selected⟩ := relatedSavedSome slot
          let update := StepDefs.threadStatusSt (E := core3 grow) resumed .running
          let lhs := { start.setCont resumed none with
            store := update start.store, ctl := next :: ⟨thread, .prog (resume ()), frames⟩ :: (active ++ rest) }
          let rhs := { incoming.setCont resumed none with
            store := update incoming.store, ctl := peer :: ⟨thread, .prog (resume ()), peerFrames⟩ :: (peerActive ++ peerRest) }
          have checked : Step profile ready (specDispatch ready base) start .tau lhs := .resumeThread leftAt found
          have raw : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau rhs :=
            .resumeThread rightAt rawFound
          have moved := sharedSchedulerTransport (bindings := bindings) (edit := .resume resumed.idx)
            checked raw (by rw [transitionEdit, leftAt]) (by rw [transitionEdit, rightAt])
          have aligned : DestructorSchedulerAlignment older lhs rhs :=
            ⟨relatedSetSlot .none scheduler.1 resumed.idx .none, scheduler.2⟩
          exact .destructorPrefix moved (frameCalloutStep moved rfl rfl) (fun _ => aligned)
            (ih selected (.cons (.mk segments) resumers) (congrArg update stores) aligned rfl rfl tail shorter)
        | @fault msg fault =>
          have rawFault : Fault incoming msg := by
            cases fault with
            | blockNoThread atBlock =>
              rw [leftAt] at atBlock
              cases atBlock
              exact .blockNoThread rightAt
            | @switchMissing worker switched reply _ _ atSwitch missing =>
              rw [leftAt] at atSwitch
              cases atSwitch
              have saved : List.Forall₂ (ReturnFrame.Related.Saved older)
                  (start.setCont worker (some (StepDefs.blockedAct worker reply frames))).conts
                  (incoming.setCont worker (some (StepDefs.blockedAct worker reply peerFrames))).conts :=
                relatedSetSlot .none scheduler.1 worker.idx (.some (.mk segments))
              have slot := relatedContLookup saved switched
              rw [missing] at slot
              exact .switchMissing rightAt (relatedSavedNone slot)
            | @resumeMissing _ resumed _ _ _ atResume missing =>
              rw [leftAt] at atResume
              cases atResume
              have slot := relatedContLookup scheduler.1 resumed
              rw [missing] at slot
              exact .resumeMissing rightAt (relatedSavedNone slot)
            | calloutBadRet atReturn bad =>
              rw [leftAt] at atReturn
              cases atReturn
              cases segments with
              | cons head tails =>
                cases head
                exact .calloutBadRet rightAt bad
          have paths := sharedSchedulerTransport (profile := profile) (ready := ready) (base := base)
            (bindings := bindings) (edit := .clear) (.fault fault) (.fault rawFault) rfl rfl
          exact .coreAcceptTerminal paths (frameCalloutStep paths rfl rfl) tail (.inr (.inr (.inr ⟨rfl, rfl⟩)))
        | hostInvoke ready _ | hostTick ready | hostCancel ready _ _ | hostRun ready =>
          have empty := ready.1
          rw [leftAt] at empty
          contradiction
        | @hostSet _ state _ _ _ atWrite =>
          rw [leftAt] at atWrite
          cases atWrite
          classical
          by_cases same : state.writer = start.host.writer ∧ state.writer = incoming.host.writer
          · exact advance (.hostSet leftAt) (.hostSet rightAt) tail segments rfl rfl stores scheduler same.1 same.2
              (by rw [transitionEdit, leftAt]) (by rw [transitionEdit, rightAt])
          · exact .boundary (.write leftAt) (.hostSet leftAt) tail

open ReturnFrame.Occurrence in
private theorem finishDestructorSwitch {limit : Nat} {body : ThreadBody (core3 grow)}
    {worker target : ThreadId} {frames peerFrames rest peerRest}
    {reply : Session grow sig (Ret (core3 grow))}
    (parents : DestructorParentChain older body rest peerRest)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) frames peerFrames)
    (stores : start.store = incoming.store)
    (leftAt : start.ctl = (PayloadPrefix.Cursor.mk (some worker) frames rest).control
      (.op (.block (some target)) fun _ => reply))
    (rightAt : incoming.ctl = (PayloadPrefix.Cursor.mk (some worker) peerFrames peerRest).control
      (.op (.block (some target)) fun _ => reply))
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (scheduler : DestructorSchedulerAlignment older start incoming)
    (bounded : labels.length ≤ limit) (compare : ShorterCallbackSlices profile ready base bindings limit) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  let left := start.setCont worker (some (StepDefs.blockedAct worker (fun _ => reply) frames))
  let right := incoming.setCont worker (some (StepDefs.blockedAct worker (fun _ => reply) peerFrames))
  have saved : List.Forall₂ (ReturnFrame.Related.Saved older) left.conts right.conts :=
    relatedSetSlot .none scheduler.1 worker.idx (.some (.mk segments))
  have found := relatedContLookup saved target
  cases run with
  | refl => exact .exhausted
  | @cons _ _ _ label trailing actual tail =>
    cases present : left.cont? target with
    | none =>
      have rawMissing : right.cont? target = none := relatedSavedNone (present ▸ found)
      have fault := Fault.switchMissing leftAt present
      let reason := TrapReason.internal "switch to a thread without a saved continuation"
      have checked : Step profile ready (specDispatch ready base) start (.trap reason) (StepDefs.trapCfg start) :=
        .fault fault
      have canonical : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming
          (.trap reason) (StepDefs.trapCfg incoming) := .fault (.switchMissing rightAt rawMissing)
      have equalLabel : label = .trap reason := by
        by_contra differs
        exact (differentStepBranch checked actual (Ne.symm differs)).1
      subst label
      have equalEnd := labelledStepUnique checked actual
      have paths := sharedSchedulerTransport (bindings := bindings) (edit := .clear) checked canonical rfl rfl
      exact .coreAcceptTerminal paths (frameCalloutStep paths rfl rfl) (equalEnd.symm ▸ tail)
        (.inr (.inr (.inr ⟨rfl, rfl⟩)))
    | some next =>
      rw [present] at found
      obtain ⟨peer, rawFound, related⟩ := relatedSavedSome found
      let update (store : CStore (core3 grow)) :=
        StepDefs.threadStatusSt target .running (StepDefs.threadStatusSt worker .blocked store)
      let checkedEnd := { left.setCont target none with store := update start.store, ctl := next :: rest }
      let rawEnd := { right.setCont target none with store := update incoming.store, ctl := peer :: peerRest }
      have checked : Step profile ready (specDispatch ready base) start .tau checkedEnd := .blockSwitch leftAt present
      have canonical : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau rawEnd :=
        .blockSwitch rightAt rawFound
      obtain ⟨rfl, rfl⟩ := silentStepUnique checked actual
      have paths := sharedSchedulerTransport (bindings := bindings) (edit := .switch worker.idx target.idx) checked canonical
        (by rw [transitionEdit, leftAt]; rfl) (by rw [transitionEdit, rightAt]; rfl)
      have aligned : DestructorSchedulerAlignment older checkedEnd rawEnd :=
        ⟨relatedSetSlot .none saved target.idx .none, scheduler.2⟩
      exact .destructorPrefix paths (frameCalloutStep paths rfl rfl)
        (fun _ => aligned) (finishDestructorSwitchTarget parents related .nil (congrArg update stores)
          aligned rfl rfl tail (by simp only [List.length_cons] at bounded; omega) compare)

private theorem finishDeniedDestructorImport {limit : Nat}
    {thread frames peerFrames rest peerRest name kind args inst parentBody}
    {frame : Seg (core3 grow) (HostState sig)} {body : Nat → Session grow sig (Except Scheduled.Issue Nat)}
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (rawEmbedder : (LiveDispatch.host bindings base).embedder name kind args =
      (Scheduled.host (grow := grow) bindings).embedder name kind args)
    (routed : ∀ ticket, route (grow := grow) ticket bindings name kind args =
      (do Scheduled.finish ticket (← admit inst (body ticket))))
    (denied : ¬ (Plain.callerInstance start.store thread = .ok (some inst) ∧
      (start.store.inst? inst).any (·.mayLeave) = true))
    (parents : DestructorParentChain older parentBody rest peerRest)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) frames peerFrames)
    (stores : start.store = incoming.store)
    (checked : start.ctl = (PayloadPrefix.Cursor.mk thread (frame :: frames) rest).control
      (calloutBody Limits.spec Quirks.none ready base start.store thread (.embedder name kind) args))
    (canonical : incoming.ctl = (PayloadPrefix.Cursor.mk thread (frame :: peerFrames) peerRest).control
      (calloutBody Limits.spec Quirks.none ready (LiveDispatch.host bindings base) incoming.store thread (.embedder name kind) args))
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (scheduler : DestructorSchedulerAlignment older start incoming)
    (bounded : labels.length ≤ limit) (compare : ShorterCallbackSlices profile ready base bindings limit) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, frame :: frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, frame :: peerFrames, peerRest⟩
  let verdict := scheduledDenial start.store thread
  let ending (state : Config (core3 grow) (HostState sig)) (cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)) :=
    let entered := state.host.enter name kind args
    let reply := completion state.host.nextTicket (.error .wrongContext)
    { state with
      host := if verdict.2 then entered else entered.record reply.1
      ctl := cursor.control (if verdict.2 then trap (.internal "dangling arena id") else .pure (.flat reply.2)) }
  have leftPath : FramedQuietPath profile ready (specDispatch ready base) check start
      (List.replicate verdict.1 id) (ending start check) :=
    scheduledDenialPath base routed (congrFun (congrFun (congrFun embedder name) kind) args) check denied checked
  have rightPath : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon incoming
      (List.replicate verdict.1 id) (ending incoming canon) := by
    have path := scheduledDenialPath (profile := profile) (ready := ready) (start := incoming)
      (LiveDispatch.host bindings base) routed rawEmbedder canon (stores ▸ denied) canonical
    have same : scheduledDenial incoming.store thread = verdict := by rw [← stores]
    simpa only [ending, canon, same] using path
  obtain ⟨used, leftOver, reached, peer, split, paths, writers, tail, completed⟩ :=
    cutSharedQuietWorker leftPath rightPath run
  rw [split]
  rcases completed with empty | ⟨rfl, rfl⟩
  · subst leftOver
    cases tail
    exact .comparedPrefix paths writers .exhausted
  · refine .destructorPrefix paths writers (fun aligned => aligned) ?_
    cases dangling : verdict.2 with
    | true =>
      exact compareSharedDestructorTrap (check := check) (canon := canon) (.internal "dangling arena id")
        (by simp only [ending, dangling, ite_true]) (by simp only [ending, dangling, ite_true]) tail
    | false =>
      let words := (completion 0 (.error .wrongContext)).2
      have leftReply : (ending start check).ctl = check.control (.pure (.flat words)) := by
        simp only [ending, dangling, Bool.false_eq_true, ite_false]
        rfl
      have rawReply : (ending incoming canon).ctl = canon.control (.pure (.flat words)) := by
        simp only [ending, dangling, Bool.false_eq_true, ite_false]
        rfl
      have shorter : leftOver.length ≤ limit := by
        rw [split, List.length_append] at bounded
        omega
      exact finishDestructorSwitchTarget parents (.mk (.cons (.same _) segments)) .nil stores scheduler
        leftReply rawReply tail shorter compare

open ReturnFrame.Occurrence in
private theorem finishDestructorCoreReplyPaths {limit : Nat} {body : ThreadBody (core3 grow)}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    {left right : Config (core3 grow) (HostState sig)} {edits : List (ComponentStoreEdit grow)} {words : List FlatValue}
    (parents : DestructorParentChain older body check.rest canon.rest)
    (thread : check.thread = canon.thread)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) check.frames canon.frames)
    (stores : left.store = right.store)
    (checked : ComponentQuietPath profile ready (specDispatch ready base) check start edits left)
    (raw : ComponentQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon incoming edits right)
    (leftAt : left.ctl = check.control (.pure (.flat words)))
    (rightAt : right.ctl = canon.control (.pure (.flat words)))
    (writers : ∀ {used left right}, used.length ≤ edits.length →
      Steps profile ready (specDispatch ready base) start used left →
      Steps profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming used right →
      VisitorWriterPath profile ready base bindings start incoming used used left right)
    (keep : DestructorSchedulerAlignment older start incoming → DestructorSchedulerAlignment older left right)
    (scheduler : DestructorSchedulerAlignment older start incoming)
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (bounded : labels.length ≤ limit) (compare : ShorterCallbackSlices profile ready base bindings limit) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  obtain ⟨used, following, reached, peer, split, consumed, paths, residual, ending⟩ :=
    cutSharedWorkerPath checked raw run
  have actual := (CallbackPrefix.transportPaths paths none).choose_spec
  have effects := writers consumed actual.1.steps actual.2.steps
  rw [split]
  rcases ending with empty | ⟨_, rfl, rfl⟩
  · subst following
    cases residual
    exact .comparedPrefix paths effects .exhausted
  · refine .destructorPrefix paths effects keep ?_
    have shorter : following.length ≤ limit := by rw [split, List.length_append] at bounded; omega
    cases check
    cases canon
    cases thread
    exact finishDestructorSwitchTarget parents (.mk segments) .nil stores (keep scheduler) leftAt rightAt residual shorter compare

open ReturnFrame.Occurrence in
private theorem finishDestructorLegacyCompletion {limit : Nat} {body : ThreadBody (core3 grow)}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)} {leftTicket rightTicket : Nat}
    {loaded : Except Silmaril.Wasm.Game.HandleAccept.Wit.Stored.OwnedMemory.Claims.Core.Issue (Stored.OwnedMemory.Tree sig)}
    (parents : DestructorParentChain older body check.rest canon.rest)
    (thread : check.thread = canon.thread)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) check.frames canon.frames)
    (stores : start.store = incoming.store)
    (leftFocus : start.ctl = check.control (coreAcceptAfterLoad leftTicket loaded))
    (rightFocus : incoming.ctl = canon.control (coreAcceptAfterLoad rightTicket loaded))
    (scheduler : DestructorSchedulerAlignment older start incoming)
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (bounded : labels.length ≤ limit) (compare : ShorterCallbackSlices profile ready base bindings limit) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  classical
  have framed (issue : Scheduled.Issue) {edits : List (ComponentStoreEdit grow)}
      (left : FramedQuietPath profile ready (specDispatch ready base) check start edits
        { start with
          host := start.host.record (completion leftTicket (.error issue)).1,
          ctl := check.control (.pure (.flat (completion leftTicket (.error issue)).2)) })
      (right : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon incoming edits
        { incoming with
          host := incoming.host.record (completion rightTicket (.error issue)).1,
          ctl := canon.control (.pure (.flat (completion rightTicket (.error issue)).2)) }) :
      CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
    refine finishDestructorCoreReplyPaths (words := (completion leftTicket (.error issue)).2)
      parents thread segments ?_ left.1 right.1 rfl rfl
      (fun count lhs rhs => .framed (takeQuietWriterPath left.2 lhs count) (takeQuietWriterPath right.2 rhs count))
      (fun same => same) scheduler run bounded compare
    exact stores
  cases loaded with
  | error issue =>
    exact framed (.accept issue)
      (checkedCompletionPath (completion leftTicket (.error (.accept issue))) leftFocus)
      (checkedCompletionPath (completion rightTicket (.error (.accept issue))) rightFocus)
  | ok tree =>
    have refuse (issue : Scheduled.Issue)
        (left : coreAcceptRegistrationProgram (grow := grow) leftTicket tree start.host =
          (do return .flat (← writeCompletion (completion leftTicket (.error issue)))))
        (right : coreAcceptRegistrationProgram (grow := grow) rightTicket tree incoming.host =
          (do return .flat (← writeCompletion (completion rightTicket (.error issue))))) :
        CallbackSliceEnd profile ready base bindings older start incoming labels finish :=
      framed issue (coreAcceptRefusalPath (specDispatch ready base) check leftTicket tree issue leftFocus left)
        (coreAcceptRefusalPath (specDispatch ready (LiveDispatch.host bindings base)) canon rightTicket tree issue rightFocus right)
    by_cases agrees : componentRegistration start.host.writer tree = componentRegistration incoming.host.writer tree
    · cases observation : componentRegistration start.host.writer tree with
      | aliased =>
        have left := coreRegistrationAliased observation
        have right := coreRegistrationAliased (agrees.symm.trans observation)
        exact refuse (.accept (.claims .alias))
          (by simp only [coreAcceptRegistrationProgram, left]; rfl)
          (by simp only [coreAcceptRegistrationProgram, right]; rfl)
      | exhausted =>
        obtain ⟨_, left, fullLeft⟩ := coreRegistrationExhausted observation
        obtain ⟨_, right, fullRight⟩ := coreRegistrationExhausted (agrees.symm.trans observation)
        exact refuse (.accept (.boundary .exhaustedHandles))
          (by simp only [coreAcceptRegistrationProgram, left, fullLeft, ite_true]; rfl)
          (by simp only [coreAcceptRegistrationProgram, right, fullRight, ite_true]; rfl)
      | fresh handle =>
        obtain ⟨lhs, left, leftIndex, leftRoom⟩ := coreRegistrationFresh observation
        obtain ⟨rhs, right, rightIndex, rightRoom⟩ := coreRegistrationFresh (agrees.symm.trans observation)
        have leftPath := coreAcceptPublicationPath (profile := profile) (ready := ready)
          (specDispatch ready base) check leftTicket tree lhs leftFocus left (leftIndex ▸ leftRoom)
        have rightPath := coreAcceptPublicationPath (profile := profile) (ready := ready)
          (specDispatch ready (LiveDispatch.host bindings base)) canon rightTicket tree rhs rightFocus right (rightIndex ▸ rightRoom)
        refine finishDestructorCoreReplyPaths (words := (completion leftTicket (.ok handle)).2)
          parents thread segments ?_ leftPath.1 rightPath.1
          (by simp only [← leftIndex]) (by simp only [← rightIndex]; rfl)
          (fun count lhsRun rhsRun => .publication ⟨leftPath.2 lhsRun count, rightPath.2 rhsRun count⟩)
          (fun same => same) scheduler run bounded compare
        exact stores
    · cases run with
      | refl => exact .exhausted
      | cons first tail =>
        let left := { start with ctl := check.control (coreAcceptRegistrationProgram leftTicket tree start.host) }
        let right := { incoming with ctl := canon.control (coreAcceptRegistrationProgram rightTicket tree incoming.host) }
        have checked : Step profile ready (specDispatch ready base) start .tau left := coreAcceptProbeStep leftFocus
        have raw : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau right :=
          coreAcceptProbeStep rightFocus
        obtain ⟨rfl, rfl⟩ := silentStepUnique checked first
        have mismatch : RegistrationProbeMismatch start incoming left right check canon leftTicket rightTicket none tree :=
          ⟨leftFocus, rightFocus, rfl, rfl, agrees⟩
        have moved := sharedSchedulerTransport (bindings := bindings) (edit := .same) checked raw
          (by rw [transitionEdit, leftFocus]; rfl) (by rw [transitionEdit, rightFocus]; rfl)
        exact .coreAcceptTerminal moved (.registrationMismatch mismatch (.same checked rfl (.done _))
          (.same raw rfl (.done _))) tail (.inr (.inr (.inl ⟨_, _, _, _, _, _, _, mismatch⟩)))

private theorem finishAdmittedLegacyDestructor {limit : Nat}
    {worker frames peerFrames rest peerRest name kind args inst parentBody loader}
    {frame : Seg (core3 grow) (HostState sig)}
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (source : LinkedCoreAcceptLoader (grow := grow) bindings name kind args inst loader)
    (caller : Plain.callerInstance start.store (some worker) = .ok (some inst))
    (mayLeave : (start.store.inst? inst).any (·.mayLeave) = true)
    (parents : DestructorParentChain older parentBody rest peerRest)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) frames peerFrames)
    (stores : start.store = incoming.store)
    (checked : start.ctl = (PayloadPrefix.Cursor.mk (some worker) (frame :: frames) rest).control
      (calloutBody Limits.spec Quirks.none ready base start.store (some worker) (.embedder name kind) args))
    (canonical : incoming.ctl = (PayloadPrefix.Cursor.mk (some worker) (frame :: peerFrames) peerRest).control
      (calloutBody Limits.spec Quirks.none ready (LiveDispatch.host bindings base) incoming.store (some worker) (.embedder name kind) args))
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (scheduler : DestructorSchedulerAlignment older start incoming)
    (bounded : labels.length ≤ limit) (compare : ShorterCallbackSlices profile ready base bindings limit) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  classical
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, frame :: frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, frame :: peerFrames, peerRest⟩
  let load (ticket : Nat) : Session grow sig (Ret (core3 grow)) :=
    .flat <$> (do Scheduled.finish ticket (← acceptWith ticket loader))
  let left := { start with host := start.host.enter name kind args, ctl := check.control (load start.host.nextTicket) }
  let right := { incoming with host := incoming.host.enter name kind args, ctl := canon.control (load incoming.host.nextTicket) }
  have leftPath : FramedQuietPath profile ready (specDispatch ready base) check start [id, id, id, id, id, id] left :=
    scheduledEntryPath base (coreAcceptRoute source) (congrFun (congrFun (congrFun embedder name) kind) args)
      check rfl caller mayLeave checked
  have rightPath : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon incoming
      [id, id, id, id, id, id] right :=
    scheduledEntryPath (LiveDispatch.host bindings base) (coreAcceptRoute source) (coreAcceptRawEmbedder source embedder)
      canon rfl (stores ▸ caller) (stores ▸ mayLeave) canonical
  obtain ⟨used, following, reached, peer, split, paths, writers, residual, ending⟩ :=
    cutSharedQuietWorker leftPath rightPath run
  rw [split]
  rcases ending with empty | ⟨rfl, rfl⟩
  · subst following
    cases residual
    exact .comparedPrefix paths writers .exhausted
  · by_cases history : left.host.writer.accepted = right.host.writer.accepted
    · refine .destructorPrefix paths writers (fun aligned => aligned) ?_
      have same := linkedCoreAcceptLoadAgreement (start := left) (incoming := right) source stores history
      have checkedLoad := coreAcceptLoadPath (profile := profile) (ready := ready) (start := left)
        (specDispatch ready base) check start.host.nextTicket loader rfl rfl
      have rawLoad := coreAcceptLoadPath (profile := profile) (ready := ready) (start := right)
        (specDispatch ready (LiveDispatch.host bindings base)) canon incoming.host.nextTicket loader rfl same
      obtain ⟨middle, remaining, reached, peer, splitLoad, loadPaths, loadWriters, tail, ending⟩ :=
        cutSharedQuietWorker checkedLoad rawLoad residual
      rw [splitLoad]
      rcases ending with empty | ⟨rfl, rfl⟩
      · subst remaining
        cases tail
        exact .comparedPrefix loadPaths loadWriters .exhausted
      · refine .destructorPrefix loadPaths loadWriters (fun aligned => aligned) ?_
        have within : remaining.length ≤ limit := by
          rw [split, splitLoad, List.length_append, List.length_append] at bounded
          omega
        exact finishDestructorLegacyCompletion (check := check) (canon := canon) parents rfl (.cons (.same _) segments)
          rfl rfl rfl scheduler tail within compare
    · exact .coreAcceptTerminal paths writers residual (.inr (.inl history))

open ReturnFrame.Occurrence in
private theorem destructorBindingTrapPath (impl : HostImpl (core3 grow) (HostState sig))
    {check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)} {name kind args issue}
    (embedder : impl.embedder name kind args = (Scheduled.host (grow := grow) bindings).embedder name kind args)
    (rejected : resolveBinding bindings name kind = .error issue)
    (focus : start.ctl = check.control
      (calloutBody Limits.spec Quirks.none ready impl start.store check.thread (.embedder name kind) args)) :
    let entered := start.host.enter name kind args
    FramedQuietPath profile ready (specDispatch ready impl) check start [id, id, id, id]
      { start with
        host := entered.record (.bindingTrap start.host.nextTicket issue)
        ctl := check.control (trap (.hostTrap "invalid mixed acceptor import binding")) } := by
  let reason := TrapReason.hostTrap "invalid mixed acceptor import binding"
  let body : Session grow sig (Ret (core3 grow)) := .op .hostGet fun first =>
    .op (.hostSet (first.enter name kind args)) fun _ =>
      .op .hostGet fun state =>
        .op (.hostSet (state.record (.bindingTrap first.nextTicket issue))) fun _ => trap reason
  have code : calloutBody Limits.spec Quirks.none ready impl start.store check.thread (.embedder name kind) args = body := by
    simp only [calloutBody, embedder]
    cases threadMayLeave start.store check.thread <;>
      simp [Scheduled.host, dispatchImport, route, rejected, rejectBinding, hostGet, hostSet, perform, Prog.lift,
        bind, Prog.bind, confine, Op.observes, body, trap, reason]
    all_goals
      congr 1
      funext first
      congr 1
      funext entered
      congr 1
      funext journal
      congr 1
      funext recorded
      congr 1
      funext impossible
      cases impossible
  rw [code] at focus
  exact .step (.hostGet focus) (by rw [transitionEdit, focus]; rfl) rfl
    (.step (.hostSet rfl) rfl rfl (.step (.hostGet rfl) rfl rfl (.step (.hostSet rfl) rfl rfl .done)))

private theorem finishDestructorBindingTrap {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    {name kind args issue}
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (rejected : resolveBinding bindings name kind = .error issue)
    (checked : start.ctl = check.control (calloutBody Limits.spec Quirks.none ready base start.store check.thread (.embedder name kind) args))
    (canonical : incoming.ctl = canon.control (calloutBody Limits.spec Quirks.none ready (LiveDispatch.host bindings base)
      incoming.store canon.thread (.embedder name kind) args))
    (run : Steps profile ready (specDispatch ready base) start labels finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  have raw : (LiveDispatch.host bindings base).embedder name kind args =
      (Scheduled.host (grow := grow) bindings).embedder name kind args := by
    simp only [LiveDispatch.host, selectBinding, rejected, embedder]
  have lhs := destructorBindingTrapPath (profile := profile) (ready := ready) base
    (congrFun (congrFun (congrFun embedder name) kind) args) rejected checked
  have rhs := destructorBindingTrapPath (profile := profile) (ready := ready) (LiveDispatch.host bindings base)
    raw rejected canonical
  obtain ⟨used, following, reached, peer, split, paths, writers, residual, ending⟩ :=
    cutSharedQuietWorker lhs rhs run
  rw [split]
  rcases ending with empty | ⟨rfl, rfl⟩
  · subst following
    cases residual
    exact .comparedPrefix paths writers .exhausted
  · exact .comparedPrefix paths writers
      (compareSharedDestructorTrap (check := check) (canon := canon)
        (.hostTrap "invalid mixed acceptor import binding") rfl rfl residual)

private theorem finishDestructorScheduledReply {limit : Nat} {body : ThreadBody (core3 grow)}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)} {leftTicket rightTicket : Nat}
    (parents : DestructorParentChain older body check.rest canon.rest)
    (thread : check.thread = canon.thread)
    (segments : List.Forall₂ (ReturnFrame.Related.Segment older) check.frames canon.frames)
    (stores : start.store = incoming.store)
    (result : Except Scheduled.Issue Nat)
    (checked : start.ctl = check.control (do return .flat (← Scheduled.finish leftTicket result)))
    (canonical : incoming.ctl = canon.control (do return .flat (← Scheduled.finish rightTicket result)))
    (scheduler : DestructorSchedulerAlignment older start incoming)
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (bounded : labels.length ≤ limit) (compare : ShorterCallbackSlices profile ready base bindings limit) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  have left := checkedCompletionPath (profile := profile) (ready := ready) (dispatch := specDispatch ready base)
    (completion leftTicket result) checked
  have right := checkedCompletionPath (profile := profile) (ready := ready)
    (dispatch := specDispatch ready (LiveDispatch.host bindings base)) (completion rightTicket result) canonical
  refine finishDestructorCoreReplyPaths (words := (completion leftTicket result).2)
    parents thread segments ?_ left.1 right.1 rfl (by cases result <;> rfl)
    (fun count lhs rhs => .framed (takeQuietWriterPath left.2 lhs count) (takeQuietWriterPath right.2 rhs count))
    (fun same => same) scheduler run bounded compare
  exact stores

private def sharedRecordPlace (cx : LiftLowerContext (core3 grow)) (type : Stored.TypeOf) (value : Value.Val) (ptr : Nat) :
    Session grow sig (Option AddrType) := do
  let width ← ptrType cx
  if !Stored.Lower.fits Quirks.none cx.opts.encoding width type value then return none
  let area := ABI.layout width type
  checkAligned ptr area.alignment.bytes
  checkInBounds cx ptr area.size
  return some width

open Stored.OwnedMemory.Claims Stored.Endpoints in
private theorem sharedRecordPlacementCode (cx : LiftLowerContext (core3 grow)) (type : Stored.TypeOf) (value : Value.Val)
    (fields : List RecordLower.Field) (ptr ticket : Nat) :
    (sharedRecordEmit cx type value fields ptr ticket : Session grow sig (Ret (core3 grow))) =
      sharedRecordPlace cx type value ptr >>= sharedRecordVisit cx fields ptr ticket := by
  simp [sharedRecordEmit, sharedRecordPlace, ptrType, gets, getStore, perform, Prog.lift,
    bind, Prog.bind]
  congr 1
  funext store
  let width := ptrTypeIn (show CStore (core3 grow) from store) cx
  cases Stored.Lower.fits Quirks.none cx.opts.encoding width type value with
  | false => rfl
  | true =>
    let aligned : Session grow sig Unit := checkAligned ptr (ABI.layout width type).alignment.bytes
    let bounded : Session grow sig Unit := checkInBounds cx ptr (ABI.layout width type).size
    let visit : Session grow sig (Except RecordLower.Issue Unit) :=
      RecordLower.Internal.runMemory Limits.spec Quirks.none cx (Record.authority recordClaims Limits.spec cx)
        width fields ptr 0
    have joined := Prog.bind_assoc aligned (fun _ => bounded.bind (fun _ => visit)) (sharedRecordReport ticket)
    have inner := Prog.bind_assoc bounded (fun _ => visit) (sharedRecordReport ticket)
    have onLeft := joined.trans (congrArg (fun next => aligned.bind (fun _ => next)) inner)
    let returnWidth : Session grow sig (Option AddrType) := .pure (some width)
    let visitAfter := sharedRecordVisit (sig := sig) cx fields ptr ticket
    have joined := Prog.bind_assoc aligned (fun _ => bounded.bind (fun _ => returnWidth)) visitAfter
    have inner := Prog.bind_assoc bounded (fun _ => returnWidth) visitAfter
    have onRight := joined.trans (congrArg (fun next => aligned.bind (fun _ => next)) inner)
    exact onLeft.trans onRight.symm

open Stored.Endpoints in
private theorem sharedRecordPlaceEffects (cx : LiftLowerContext (core3 grow)) (type : Stored.TypeOf)
    (value : Value.Val) (ptr : Nat) :
    StoreEffects (sharedRecordPlace cx type value ptr : Session grow sig (Option AddrType)) := by
  apply (storeEffectPtrType cx).bind
  intro width
  by_cases fits : Stored.Lower.fits Quirks.none cx.opts.encoding width type value
  · have aligned : StoreEffects (checkAligned ptr (ABI.layout width type).alignment.bytes : Session grow sig Unit) :=
      storeEffectTrapIf _ _
    simp only [fits, Bool.not_true, Bool.false_eq_true, ite_false]
    exact aligned.bind (fun _ => (storeEffectBounds cx ptr (ABI.layout width type).size).bind fun _ => .pure (some width))
  · have refused : Stored.Lower.fits Quirks.none cx.opts.encoding width type value = false := Bool.eq_false_iff.mpr fits
    simp only [refused, Bool.not_false, ite_true]
    exact .pure none

private theorem storeEffectEncodeFloat (type : FloatType) (bits : BitVec type.width) :
    StoreEffects (encodeFloat type bits : Session grow sig (BitVec (ABI.floatIntType type).width)) := by
  have lowered : StoreEffects (lowerFloat type bits : Session grow sig (BitVec type.width)) := by
    unfold lowerFloat
    split
    · exact .op rfl fun result => .pure result
    · exact .pure bits
  exact lowered.bind fun _ => .pure _

private theorem storeEffectPrimitive (cx : LiftLowerContext (core3 grow)) (ptr : Nat)
    (value : Value.Val) (primitive : WIT.Primitive) (nonString : primitive ≠ .string) :
    StoreEffects (Canon.store Limits.spec Quirks.none cx value (.prim primitive) ptr : Session grow sig Unit) := by
  rw [Canon.store.eq_def]
  change StoreEffects (storePrim Limits.spec Quirks.none cx primitive value ptr : Session grow sig Unit)
  unfold storePrim
  split
  · exact storeEffectWrite _ _ _
  · exact (storeEffectEncodeFloat .f32 _).bind fun _ => storeEffectWrite _ _ _
  · exact (storeEffectEncodeFloat .f64 _).bind fun _ => storeEffectWrite _ _ _
  · exact storeEffectWrite _ _ _
  · contradiction
  · split
    · exact storeEffectWrite _ _ _
    · exact storeEffectTrap _
  · exact storeEffectTrap _

private theorem storeEffectLocalData (cx : LiftLowerContext (core3 grow)) (type : Stored.TypeOf)
    (localType : PayloadPrefix.LocalDataType type) (payload : Stored.Payload type) (ptr : Nat) :
    StoreEffects (Canon.store Limits.spec Quirks.none cx payload.val type ptr : Session grow sig Unit) := by
  cases localType with
  | primitive nonString => exact storeEffectPrimitive cx ptr _ _ nonString
  | @enum names _ =>
    obtain ⟨value, typed⟩ := payload
    cases typed with
    | enum expanded =>
      cases expanded with
      | @variant tag _ _ _ =>
        rw [Canon.store.eq_def]
        change StoreEffects ((if tag < names.length then do
          let _ ← storeVariantHead cx names.length .one tag ptr
          pure ()
        else storeMismatch) : Session grow sig Unit)
        split
        · exact ((storeEffectWrite cx ptr _).bind fun _ => .pure _).bind fun _ => .pure ()
        · exact storeEffectTrap _
  | flags valid =>
    obtain ⟨value, typed⟩ := payload
    cases typed
    rw [Canon.store.eq_def]
    exact storeEffectWrite _ _ _

open Stored.OwnedMemory.Claims Stored.Endpoints in
private theorem sharedRecordScalarEffects (cx : LiftLowerContext (core3 grow)) (width : AddrType)
    (type : Stored.TypeOf) (localType : PayloadPrefix.LocalDataType type) (payload : Stored.Payload type)
    (index ptr : Nat) :
    StoreEffects (RecordLower.Internal.runField Limits.spec Quirks.none cx (Record.authority recordClaims Limits.spec cx)
      width (.data type payload) index (.memory ptr) : Session grow sig (Except RecordLower.Issue Unit)) := by
  simp only [RecordLower.Internal.runField, Stored.Lower.lower]
  split
  · exact .pure _
  · refine ((storeEffectPtrType cx).bind fun actualWidth => ?_).bind fun _ => .pure _
    split
    · exact .pure _
    · have align : StoreEffects (checkAligned ptr (ABI.layout actualWidth type).alignment.bytes : Session grow sig Unit) :=
        storeEffectTrapIf _ _
      exact (align.bind fun _ => (storeEffectBounds cx ptr (ABI.layout actualWidth type).size).bind fun _ =>
        storeEffectLocalData cx type localType payload ptr).bind fun _ => .pure _

section
open Stored.Endpoints

mutual
private inductive SharedRecordLocalField : RecordLower.Field → Prop where
  | data {type : Stored.TypeOf} {payload : Stored.Payload type} :
      PayloadPrefix.LocalDataType type → SharedRecordLocalField (.data type payload)
  | aggregate {type fields} : SharedRecordLocalFields fields → SharedRecordLocalField (.aggregate type fields)
  | fixed {element length entries} : SharedRecordLocalFields entries → SharedRecordLocalField (.fixed element length entries)
  | sumNone {type arms tag} : SharedRecordLocalField (.sum type arms tag none)
  | sumSome {type arms tag field} :
      SharedRecordLocalField field → SharedRecordLocalField (.sum type arms tag (some field))

private inductive SharedRecordLocalFields : List RecordLower.Field → Prop where
  | nil : SharedRecordLocalFields []
  | cons {field fields} : SharedRecordLocalField field → SharedRecordLocalFields fields →
      SharedRecordLocalFields (field :: fields)
end

open Stored.Endpoints in
private theorem sharedRecordVariantHeadEffects (cx : LiftLowerContext (core3 grow)) (width : AddrType)
    (arms : List (Option Stored.TypeOf)) (tag ptr : Nat) :
    StoreEffects (storeVariantHead cx arms.length (ABI.maxCaseAlignment (arms.map (ABI.layoutOption width))) tag ptr :
      Session grow sig Nat) :=
  (storeEffectWrite cx ptr _).bind fun _ => .pure _

open Stored.OwnedMemory.Claims Stored.Endpoints in
private theorem sharedRecordLocalFieldEffects (cx : LiftLowerContext (core3 grow)) (width : AddrType)
    {field : RecordLower.Field} (localField : SharedRecordLocalField field) (index ptr : Nat) :
    StoreEffects (RecordLower.Internal.runField Limits.spec Quirks.none cx (Record.authority recordClaims Limits.spec cx)
      width field index (.memory ptr) : Session grow sig (Except RecordLower.Issue Unit)) := by
  revert index ptr
  let authority : RecordLower.Authority (core3 grow) (HostState sig) := Record.authority recordClaims Limits.spec cx
  refine SharedRecordLocalField.rec
    (motive_1 := fun field _ => ∀ index ptr,
      StoreEffects (RecordLower.Internal.runField Limits.spec Quirks.none cx authority
        width field index (.memory ptr) : Session grow sig (Except RecordLower.Issue Unit)))
    (motive_2 := fun fields _ =>
      (∀ cursor index, StoreEffects (RecordLower.Internal.runMemory Limits.spec Quirks.none cx authority
        width fields cursor index : Session grow sig (Except RecordLower.Issue Unit))) ∧
      (∀ stride ptr index, StoreEffects (RecordLower.Internal.runElements Limits.spec Quirks.none cx authority
        width fields stride ptr index : Session grow sig (Except RecordLower.Issue Unit))))
    ?_ ?_ ?_ ?_ ?_ ?_ ?_ localField
  · intro type payload localType index ptr
    exact sharedRecordScalarEffects cx width type localType payload index ptr
  · intro type fields _ ih index ptr
    simp only [RecordLower.Internal.runField]
    exact (storeEffectBounds cx ptr (ABI.layout width type).size).bind fun _ =>
      (ih.1 ptr 0).bind fun _ => .pure _
  · intro element length fields _ ih index ptr
    simp only [RecordLower.Internal.runField]
    exact (ih.2 (ABI.layout width element).size ptr 0).bind fun _ => .pure _
  · intro type arms tag index ptr
    simp only [RecordLower.Internal.runField]
    exact (sharedRecordVariantHeadEffects cx width arms tag ptr).bind fun _ => .pure _
  · intro type arms tag field _ ih index ptr
    simp only [RecordLower.Internal.runField]
    exact (sharedRecordVariantHeadEffects cx width arms tag ptr).bind fun address =>
      (ih 0 address).bind fun _ => .pure _
  · exact ⟨fun _ _ => .pure _, fun _ _ _ => .pure _⟩
  · intro field fields _ _ head tail
    constructor
    · intro cursor index
      rw [RecordLower.Internal.runMemory.eq_2]
      let area := ABI.layout width field.type
      let ptr := ABI.alignTo cursor area.alignment
      refine (head index ptr).bind ?_
      intro result
      cases result with
      | error issue => exact .pure (Except.error issue)
      | ok unitResult =>
        cases unitResult
        exact tail.1 (ptr + area.size) (index + 1)
    · intro stride ptr index
      rw [RecordLower.Internal.runElements.eq_2]
      refine (head index ptr).bind ?_
      intro result
      cases result with
      | error issue => exact .pure (Except.error issue)
      | ok unitResult =>
        cases unitResult
        exact tail.2 stride (ptr + stride) (index + 1)

end

open Stored.OwnedMemory.Claims Stored.Endpoints LinkedCallback.MemorySequence in
private theorem sharedRecordMemoryCons (mode : Track) (cx : LiftLowerContext (core3 grow)) (width : AddrType)
    (field : RecordLower.Field) (fields : List RecordLower.Field) (cursor index : Nat)
    (reply : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow))) :
    let slot := mode.slot width field cursor
    sharedRecordMemory mode cx width (field :: fields) cursor index reply =
      RecordLower.Internal.runField Limits.spec Quirks.none cx (Record.authority recordClaims Limits.spec cx)
        width field index (.memory slot.1) >>= sharedRecordAfterField mode cx width fields slot.2 (index + 1) reply := by
  dsimp only
  let slot := mode.slot width field cursor
  let visit : Session grow sig (Except RecordLower.Issue Unit) :=
    RecordLower.Internal.runField Limits.spec Quirks.none cx (Record.authority recordClaims Limits.spec cx)
      width field index (.memory slot.1)
  let next (result : Except RecordLower.Issue Unit) : Session grow sig (Except RecordLower.Issue Unit) :=
    match result with
    | .error issue => pure (.error issue)
    | .ok () =>
      let authority := Record.authority recordClaims Limits.spec cx
      match mode with
      | .fields | .placedFields => RecordLower.Internal.runMemory Limits.spec Quirks.none cx authority width fields slot.2 (index + 1)
      | .elements stride =>
        RecordLower.Internal.runElements Limits.spec Quirks.none cx authority width fields stride slot.2 (index + 1)
  let after := sharedRecordAfterField mode cx width fields slot.2 (index + 1) reply
  have source : sharedRecordMemory mode cx width (field :: fields) cursor index reply = (visit.bind next).bind reply := by
    unfold sharedRecordMemory
    cases mode <;> dsimp only <;>
      first | rw [RecordLower.Internal.runMemory.eq_def] | rw [RecordLower.Internal.runElements.eq_def]
    all_goals
      simp only [Prog.bind_eq]
      congr 1
      dsimp [visit, next, slot, Track.slot]
      congr 1
      funext result
      cases result with
      | error issue => rfl
      | ok result => cases result; rfl
  refine source.trans ((Prog.bind_assoc visit next reply).trans (congrArg visit.bind ?_))
  funext result
  cases result with
  | error issue => rfl
  | ok result => cases result; rfl

open Stored.OwnedMemory.Claims Stored.Endpoints in
private theorem sharedRecordAggregateCode (cx : LiftLowerContext (core3 grow)) (width : AddrType)
    (type : Stored.TypeOf) (fields : List RecordLower.Field) (index ptr : Nat)
    (next : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow))) :
    (RecordLower.Internal.runField Limits.spec Quirks.none cx (Record.authority recordClaims Limits.spec cx)
      width (.aggregate type fields) index (.memory ptr) >>= next) =
    (checkInBounds cx ptr (ABI.layout width type).size >>= fun _ =>
      sharedRecordMemory .fields cx width fields ptr 0 (fun result => next (result.mapError (.nested index)))) := by
  let bounds : Session grow sig Unit := checkInBounds cx ptr (ABI.layout width type).size
  let visit : Session grow sig (Except RecordLower.Issue Unit) :=
    RecordLower.Internal.runMemory Limits.spec Quirks.none cx (Record.authority recordClaims Limits.spec cx)
      width fields ptr 0
  let wrap (result : Except RecordLower.Issue Unit) : Session grow sig (Except RecordLower.Issue Unit) :=
    .pure (result.mapError (.nested index))
  simp only [RecordLower.Internal.runField]
  change (bounds.bind (fun _ => visit.bind wrap)).bind next =
    bounds.bind (fun _ => visit.bind (fun result => next (result.mapError (.nested index))))
  exact (Prog.bind_assoc bounds (fun _ => visit.bind wrap) next).trans
    (congrArg (fun rest => bounds.bind (fun _ => rest)) (Prog.bind_assoc visit wrap next))

open Stored.OwnedMemory.Claims Stored.Endpoints in
private theorem sharedRecordFixedCode (cx : LiftLowerContext (core3 grow)) (width : AddrType)
    (element : Stored.TypeOf) (length : Nat) (entries : List RecordLower.Field) (index ptr : Nat)
    (next : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow))) :
    (RecordLower.Internal.runField Limits.spec Quirks.none cx (Record.authority recordClaims Limits.spec cx)
      width (.fixed element length entries) index (.memory ptr) >>= next) =
    sharedRecordMemory (.elements (ABI.layout width element).size) cx width entries ptr 0
      (fun result => next (result.mapError (.nested index))) := by
  let entriesVisit : Session grow sig (Except RecordLower.Issue Unit) :=
    RecordLower.Internal.runElements Limits.spec Quirks.none cx (Record.authority recordClaims Limits.spec cx)
      width entries (ABI.layout width element).size ptr 0
  let wrap (result : Except RecordLower.Issue Unit) : Session grow sig (Except RecordLower.Issue Unit) :=
    .pure (result.mapError (.nested index))
  simp only [RecordLower.Internal.runField]
  exact Prog.bind_assoc entriesVisit wrap next

open Stored.OwnedMemory.Claims Stored.Endpoints in
private theorem sharedRecordSumCode (cx : LiftLowerContext (core3 grow)) (width : AddrType)
    (type : Stored.TypeOf) (arms : List (Option Stored.TypeOf)) (tag : Nat) (child : RecordLower.Field)
    (index ptr : Nat) (next : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow))) :
    (RecordLower.Internal.runField Limits.spec Quirks.none cx (Record.authority recordClaims Limits.spec cx)
      width (.sum type arms tag (some child)) index (.memory ptr) >>= next) =
    (storeVariantHead cx arms.length (ABI.maxCaseAlignment (arms.map (ABI.layoutOption width))) tag ptr >>=
      fun address => sharedRecordMemory (.elements 0) cx width [child] address 0
        (fun result => next (result.mapError (.nested index)))) := by
  let head : Session grow sig Nat :=
    storeVariantHead cx arms.length (ABI.maxCaseAlignment (arms.map (ABI.layoutOption width))) tag ptr
  let visit (address : Nat) : Session grow sig (Except RecordLower.Issue Unit) :=
    RecordLower.Internal.runField Limits.spec Quirks.none cx (Record.authority recordClaims Limits.spec cx)
      width child 0 (.memory address)
  let wrap (result : Except RecordLower.Issue Unit) : Session grow sig (Except RecordLower.Issue Unit) :=
    .pure (result.mapError (.nested index))
  simp only [RecordLower.Internal.runField]
  change (head.bind (fun address => (visit address).bind wrap)).bind next = _
  rw [Prog.bind_assoc]
  refine congrArg head.bind (funext fun address => ?_)
  rw [Prog.bind_assoc, sharedRecordMemoryCons]
  change (visit address).bind _ = (visit address).bind _
  refine congrArg (visit address).bind (funext fun result => ?_)
  cases result with
  | error issue => rfl
  | ok result => cases result; rfl

open Stored.Endpoints in
private abbrev DestructorRecordAt {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    (profile : ProfileKind) (ready : HostReady (HostState sig)) (base : HostImpl (core3 grow) (HostState sig))
    (bindings : List (Binding sig)) (older : ReturnFrame.Substitutions (core3 grow) (HostState sig))
    (limit : Nat) (finish : Config (core3 grow) (HostState sig))
    (leftProgram rightProgram : Session grow sig (Ret (core3 grow))) :=
  ∀ {left right : Config (core3 grow) (HostState sig)} {remaining : Trace grow sig},
    left.store = right.store →
    left.ctl = check.control leftProgram → right.ctl = canon.control rightProgram →
    DestructorSchedulerAlignment older left right →
    Steps profile ready (specDispatch ready base) left remaining finish →
    remaining.length ≤ limit →
    CallbackSliceEnd profile ready base bindings older left right remaining finish

open Stored.Endpoints in
private def sharedRecordContextBody (cx : LiftLowerContext (core3 grow)) (identity : ErrCtxId) (index ptr : Nat) :
    Session grow sig (Except RecordLower.Issue Unit) := do
  if ((← getStore).errCtx? identity).isNone then
    return .error (.field index (.beforeAllocation .missingContext))
  let slot ← lowerErrorContext Limits.spec cx identity
  return .ok (← RecordLower.Internal.publishSlot cx slot (.memory ptr))

open Stored.OwnedMemory.Claims Stored.Endpoints in
private theorem sharedRecordContextCode (cx : LiftLowerContext (core3 grow)) (width : AddrType)
    (identity : ErrCtxId) (index ptr : Nat) :
    (RecordLower.Internal.runField Limits.spec Quirks.none cx (Record.authority recordClaims Limits.spec cx)
      width (.context identity) index (.memory ptr) : Session grow sig (Except RecordLower.Issue Unit)) =
      .op .hostGet (fun _ => sharedRecordContextBody cx identity index ptr) := by
  simp [RecordLower.Internal.runField, Record.authority, recordClaims, claims, sharedRecordContextBody,
    hostGet, getStore, perform, Prog.lift, bind, Prog.bind]
  congr 1
  funext snapshot
  congr 1
  funext store
  change CStore (core3 grow) at store
  by_cases missing : store.errCtx? identity = none
  · simp only [missing, ite_true]
    rfl
  · simp only [missing, ite_false]
    let insert : Session grow sig Nat := lowerErrorContext Limits.spec cx identity
    let verdict (slot : Nat) : Session grow sig (Except RecordLower.Issue Nat) := .pure (.ok slot)
    let publish : Except RecordLower.Issue Nat → Session grow sig (Except RecordLower.Issue Unit)
      | .error issue => .pure (.error issue)
      | .ok slot => RecordLower.Internal.publishSlot cx slot (.memory ptr) >>= fun result => .pure (.ok result)
    exact Prog.bind_assoc insert verdict publish

private theorem sharedRecordContextEffects (cx : LiftLowerContext (core3 grow)) (identity : ErrCtxId) (index ptr : Nat) :
    StoreEffects (sharedRecordContextBody cx identity index ptr : Session grow sig (Except Stored.Endpoints.RecordLower.Issue Unit)) := by
  unfold sharedRecordContextBody
  apply storeEffectGet.bind
  intro store
  split
  · exact .pure _
  · exact (sharedHandleInsertEffects _ _).bind fun _ => (storeEffectWrite _ _ _).bind fun _ => .pure _


open Stored.OwnedMemory.Claims Stored.Endpoints in
private theorem sharedRecordOwnerCode (cx : LiftLowerContext (core3 grow)) (width : AddrType)
    (receipt : Stored.OwnedMemory.Receipt) (index ptr : Nat) :
    (RecordLower.Internal.runField Limits.spec Quirks.none cx (Record.authority recordClaims Limits.spec cx)
      width (.owner receipt) index (.memory ptr) : Session grow sig (Except RecordLower.Issue Unit)) =
      .op .hostGet (fun state =>
        sharedRecordOwnerAfterProbe cx receipt index ptr ((Record.prepareOwner state.writer receipt).map Prod.fst)) := by
  simp [RecordLower.Internal.runField, Record.authority, recordClaims, claims, sharedRecordOwnerAfterProbe,
    hostGet, perform, Prog.lift, bind, Prog.bind]
  congr 1
  funext snapshot
  change HostState sig at snapshot
  cases outcome : Record.prepareOwner snapshot.writer receipt with
  | error issue => rfl
  | ok result =>
    obtain ⟨rep, writer⟩ := result
    simp [Except.map, sharedRecordOwnerTransfer, commitOwner, Prog.bind_assoc]
    rfl

open Stored.OwnedMemory.Claims Stored.Endpoints in
private theorem sharedRecordEndpointCode (cx : LiftLowerContext (core3 grow)) (width : AddrType)
    (channel : Async.Channel) (element : Async.Element) (identity : EndId) (index ptr : Nat) :
    (RecordLower.Internal.runField Limits.spec Quirks.none cx (Record.authority recordClaims Limits.spec cx)
      width (.endpoint channel element identity) index (.memory ptr) : Session grow sig (Except RecordLower.Issue Unit)) =
      .op .hostGet (fun state => sharedRecordEndpointRead ⟨channel, element, identity, cx.inst⟩ cx index ptr state.writer) := by
  simp [RecordLower.Internal.runField, Record.authority, recordClaims, claims, sharedRecordEndpointRead,
    hostGet, getStore, perform, Prog.lift, bind, Prog.bind]
  congr 1
  funext snapshot
  congr 1
  funext store
  change CStore (core3 grow) at store
  change HostState sig at snapshot
  cases outcome : Record.prepareEndpoint store snapshot.writer channel element identity with
  | error issue =>
    simp [sharedRecordEndpointPrepare, Record.prepare, outcome, sharedRecordEndpointAfterPrepare, bind, Except.bind, Prog.bind]
    rfl
  | ok prospective =>
    simp [sharedRecordEndpointPrepare, Record.prepare, outcome, sharedRecordEndpointAfterPrepare, bind, Except.bind, Prog.bind,
      sharedRecordEndpointTransfer, SharedEndpointGive.transfer, claims, hostGet, perform, Prog.lift, Prog.bind_assoc]
    rfl

open Stored.OwnedMemory.Claims in
private theorem sharedRecordEndpointPrepared (site : SharedEndpointGive) (store : CStore (core3 grow))
    (writer : State sig) (accepted : sharedRecordEndpointPrepare site store writer = .ok ()) :
    ∃ spent, Record.prepareEndpoint store writer site.channel site.element site.identity = .ok spent := by
  cases result : Record.prepareEndpoint store writer site.channel site.element site.identity with
  | error issue =>
    simp [sharedRecordEndpointPrepare, Record.prepare, result, bind, Except.bind] at accepted
  | ok spent => exact ⟨spent, rfl⟩

open ReturnFrame.Occurrence in
private theorem finishDestructorFramedCut
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    {edits : List (ComponentStoreEdit grow)} {target peerTarget : Config (core3 grow) (HostState sig)}
    (lhs : FramedQuietPath profile ready (specDispatch ready base) check start edits target)
    (rhs : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon incoming edits peerTarget)
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (bounded : labels.length ≤ edits.length) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  obtain ⟨used, remaining, reached, peer, split, consumed, paths, tail, ending⟩ :=
    cutSharedWorkerPath lhs.1 rhs.1 run
  have empty : remaining = [] := by
    rcases ending with empty | ⟨allUsed, _, _⟩
    · exact empty
    · rw [split, List.length_append, allUsed] at bounded
      exact List.length_eq_zero_iff.mp (by omega)
  have actual := (CallbackPrefix.transportPaths paths none).choose_spec
  have writers := VisitorWriterPath.framed
    (takeQuietWriterPath lhs.2 actual.1.steps consumed) (takeQuietWriterPath rhs.2 actual.2.steps consumed)
  rw [split, empty]
  exact .comparedPrefix paths writers (stepsAtEmpty (empty ▸ tail) ▸ CallbackSliceEnd.exhausted)

open Stored.Endpoints in
private theorem crossDestructorRecordStore {limit : Nat} {Result : Type}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    (thread : check.thread = canon.thread) (body : Session grow sig Result) (effects : StoreEffects body)
    (checkedNext canonicalNext : Result → Session grow sig (Ret (core3 grow)))
    (onResult : ∀ result, DestructorRecordAt (check := check) (canon := canon) profile ready base bindings older limit finish
      (checkedNext result) (canonicalNext result)) :
    DestructorRecordAt (check := check) (canon := canon) profile ready base bindings older limit finish
      (body >>= checkedNext) (body >>= canonicalNext) := by
  intro start incoming labels stores checked canonical scheduler run bounded
  exact crossSharedWorkerBodyWith (check := check) (canon := canon) thread body checkedNext canonicalNext
    (liftDestructorStoreEffects effects (trivialPreserves _)) trivial stores checked canonical run
    (fun result shorter _ same leftAt rightAt aligned residual =>
      onResult result same leftAt rightAt (aligned scheduler) residual (shorter.trans bounded))

open ReturnFrame.Occurrence Stored.OwnedMemory.Claims Stored.Endpoints in
private theorem crossDestructorRecordContext {limit : Nat}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    (thread : check.thread = canon.thread) (cx : LiftLowerContext (core3 grow)) (identity : ErrCtxId) (index ptr : Nat)
    (checkedNext canonicalNext : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow)))
    (onResult : ∀ result, DestructorRecordAt (check := check) (canon := canon) profile ready base bindings older limit finish
      (checkedNext result) (canonicalNext result)) :
    DestructorRecordAt (check := check) (canon := canon) profile ready base bindings older limit finish
      (.op .hostGet (fun _ => sharedRecordContextBody cx identity index ptr >>= checkedNext))
      (.op .hostGet (fun _ => sharedRecordContextBody cx identity index ptr >>= canonicalNext)) := by
  intro left right labels stores checked canonical scheduler run bounded
  let body := sharedRecordContextBody (sig := sig) cx identity index ptr
  let leftAfter := { left with ctl := check.control (body >>= checkedNext) }
  let rightAfter := { right with ctl := canon.control (body >>= canonicalNext) }
  have read : Step profile ready (specDispatch ready base) left .tau leftAfter :=
    .hostGet (th := check.thread) (segs := check.frames) (rest := check.rest) (k := fun _ => body >>= checkedNext) checked
  have peerRead : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) right .tau rightAfter :=
    .hostGet (th := canon.thread) (segs := canon.frames) (rest := canon.rest) (k := fun _ => body >>= canonicalNext) canonical
  cases run with
  | refl => exact .exhausted
  | cons actual residual =>
    obtain ⟨rfl, rfl⟩ := silentStepUnique read actual
    have paths := sharedSchedulerTransport (bindings := bindings) (edit := .same) read peerRead
      (by rw [transitionEdit, checked]; rfl) (by rw [transitionEdit, canonical]; rfl)
    exact .destructorPrefix paths (frameCalloutStep paths rfl rfl) (fun aligned => aligned)
      (crossDestructorRecordStore thread body (sharedRecordContextEffects cx identity index ptr)
        checkedNext canonicalNext onResult stores rfl rfl scheduler residual (by simp at bounded; omega))

open ReturnFrame.Occurrence Stored.OwnedMemory.Claims Stored.Endpoints in
private theorem crossDestructorRecordOwner {limit : Nat}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    (thread : check.thread = canon.thread) (cx : LiftLowerContext (core3 grow)) (receipt : Stored.OwnedMemory.Receipt)
    (index ptr : Nat) (checkedNext canonicalNext : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow)))
    (onResult : ∀ result, DestructorRecordAt (check := check) (canon := canon) profile ready base bindings older limit finish
      (checkedNext result) (canonicalNext result)) :
    DestructorRecordAt (check := check) (canon := canon) profile ready base bindings older limit finish
      (.op .hostGet (fun state =>
        sharedRecordOwnerAfterProbe cx receipt index ptr ((Record.prepareOwner state.writer receipt).map Prod.fst) >>= checkedNext))
      (.op .hostGet (fun state =>
        sharedRecordOwnerAfterProbe cx receipt index ptr ((Record.prepareOwner state.writer receipt).map Prod.fst) >>= canonicalNext)) := by
  classical
  intro left right labels stores checked canonical scheduler run bounded
  let verdict (host : HostState sig) := (Record.prepareOwner host.writer receipt).map Prod.fst
  let following (next : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow))) (host : HostState sig) :=
    sharedRecordOwnerAfterProbe cx receipt index ptr (verdict host) >>= next
  let checkedAt : left.ctl = check.control (.op .hostGet (following checkedNext)) := checked
  let canonicalAt : right.ctl = canon.control (.op .hostGet (following canonicalNext)) := canonical
  let leftRead := { left with ctl := check.control (following checkedNext left.host) }
  let rightRead := { right with ctl := canon.control (following canonicalNext right.host) }
  have guard : Step profile ready (specDispatch ready base) left .tau leftRead :=
    .hostGet (th := check.thread) (segs := check.frames) (rest := check.rest) (k := following checkedNext) checkedAt
  have peerGuard : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) right .tau rightRead :=
    .hostGet (th := canon.thread) (segs := canon.frames) (rest := canon.rest) (k := following canonicalNext) canonicalAt
  cases run with
  | refl => exact .exhausted
  | @cons _ _ _ _ suffix actual afterGuard =>
    obtain ⟨rfl, rfl⟩ := silentStepUnique guard actual
    have editsLeft : transitionEdit left .tau = .same := by rw [transitionEdit, checkedAt]; rfl
    have editsRight : transitionEdit right .tau = .same := by rw [transitionEdit, canonicalAt]; rfl
    have paths := sharedSchedulerTransport (bindings := bindings) guard peerGuard editsLeft editsRight
    by_cases agrees : verdict left.host = verdict right.host
    · cases observed : verdict left.host with
      | error issue =>
        refine .destructorPrefix paths (frameCalloutStep paths rfl rfl) (fun aligned => aligned) ?_
        refine onResult (.error (.nested index issue)) stores ?_ ?_ scheduler afterGuard (by simp at bounded; omega)
        · change check.control (sharedRecordOwnerAfterProbe cx receipt index ptr (verdict left.host) >>= checkedNext) = _
          rw [observed]
          rfl
        · change canon.control (sharedRecordOwnerAfterProbe cx receipt index ptr (verdict right.host) >>= canonicalNext) = _
          rw [← agrees, observed]
          rfl
      | ok rep =>
        have prepared (host : HostState sig) (accepted : verdict host = .ok rep) :
            ∃ spent, Record.prepareOwner host.writer receipt = .ok (rep, spent) := by
          unfold verdict at accepted
          cases result : Record.prepareOwner host.writer receipt with
          | error issue => simp [result, Except.map] at accepted
          | ok resultValue =>
            obtain ⟨representation, spent⟩ := resultValue
            simp only [result, Except.map, Except.ok.injEq] at accepted
            subst representation
            exact ⟨spent, rfl⟩
        obtain ⟨leftSpent, leftPrepared⟩ := prepared left.host observed
        obtain ⟨rightSpent, rightPrepared⟩ := prepared right.host (agrees.symm.trans observed)
        have leftReached : leftRead.ctl = check.control (sharedRecordOwnerAfterProbe cx receipt index ptr (.ok rep) >>= checkedNext) :=
          congrArg check.control (congrArg (fun result => sharedRecordOwnerAfterProbe cx receipt index ptr result >>= checkedNext) observed)
        have rightReached : rightRead.ctl = canon.control (sharedRecordOwnerAfterProbe cx receipt index ptr (.ok rep) >>= canonicalNext) :=
          congrArg canon.control (congrArg (fun result => sharedRecordOwnerAfterProbe cx receipt index ptr result >>= canonicalNext) (agrees.symm.trans observed))
        let body := sharedRecordOwnerTransfer (sig := sig) cx receipt.1 rep ptr
        let spendHost (host : HostState sig) := { host with writer := (Spend.owner (receiptId receipt)).apply host.writer }
        let writeAfter (next : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow))) (host : HostState sig) : Session grow sig (Ret (core3 grow)) :=
          Prog.op (.hostSet (spendHost host)) (fun _ => body >>= next)
        let leftWrite := { leftRead with ctl := check.control (writeAfter checkedNext leftRead.host) }
        let rightWrite := { rightRead with ctl := canon.control (writeAfter canonicalNext rightRead.host) }
        let leftDone := { leftWrite with host := spendHost leftWrite.host, ctl := check.control (body >>= checkedNext) }
        let rightDone := { rightWrite with host := spendHost rightWrite.host, ctl := canon.control (body >>= canonicalNext) }
        have read : Step profile ready (specDispatch ready base) leftRead .tau leftWrite :=
          .hostGet (th := check.thread) (segs := check.frames) (rest := check.rest) (k := writeAfter checkedNext) leftReached
        have peerRead : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) rightRead .tau rightWrite :=
          .hostGet (th := canon.thread) (segs := canon.frames) (rest := canon.rest) (k := writeAfter canonicalNext) rightReached
        have commit : Step profile ready (specDispatch ready base) leftWrite .tau leftDone :=
          .hostSet (th := check.thread) (segs := check.frames) (rest := check.rest) (s := leftDone.host) (k := fun _ => body >>= checkedNext) rfl
        have peerCommit : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) rightWrite .tau rightDone :=
          .hostSet (th := canon.thread) (segs := canon.frames) (rest := canon.rest) (s := rightDone.host) (k := fun _ => body >>= canonicalNext) rfl
        have lhs : FramedQuietPath profile ready (specDispatch ready base) check left [id, id] leftWrite :=
          .step guard editsLeft rfl (.step read (by rw [transitionEdit, leftReached]; rfl) rfl .done)
        have rhs : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon right [id, id] rightWrite :=
          .step peerGuard editsRight rfl (.step peerRead (by rw [transitionEdit, rightReached]; rfl) rfl .done)
        rcases splitSilent (count := 2) (.cons read (.cons commit (.refl _))) afterGuard with ⟨remaining, used, residual⟩ | short
        · rw [used]
          have leftPath : ComponentQuietPath profile ready (specDispatch ready base) check left [id, id, id] leftDone :=
            lhs.1.append (ComponentQuietPath.step (update := id) commit rfl (.done _))
          have rightPath : ComponentQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon right [id, id, id] rightDone :=
            rhs.1.append (ComponentQuietPath.step (update := id) peerCommit rfl (.done _))
          have committed : ExecutedSharedRecordOwnerSpend profile ready (specDispatch ready base) receipt cx index ptr rep checkedNext left leftDone :=
            ⟨check, leftRead, leftWrite, leftSpent, checkedAt, leftPrepared,
              congrArg (fun ctl => { left with ctl }) leftReached, rfl, rfl, guard, read, commit⟩
          have peerCommitted : ExecutedSharedRecordOwnerSpend profile ready (specDispatch ready (LiveDispatch.host bindings base))
              receipt cx index ptr rep canonicalNext right rightDone :=
            ⟨canon, rightRead, rightWrite, rightSpent, canonicalAt, rightPrepared,
              congrArg (fun ctl => { right with ctl }) rightReached, rfl, rfl, peerGuard, peerRead, peerCommit⟩
          have moved := CallbackPrefix.stationaryTransport (bindings := bindings) leftPath.track rightPath.track
          refine .destructorPrefix moved (.recordOwnerCommit committed peerCommitted) (fun aligned => aligned) ?_
          have lowered : StoreEffects (lowerOwn Limits.spec cx receipt.1 rep : Session grow sig Nat) :=
            sharedOwnerTransferEffects ⟨receipt.1, receiptId receipt, cx.inst⟩ rep
          have effects : StoreEffects body := lowered.bind fun _ => (storeEffectWrite _ _ _).bind fun _ => .pure _
          exact crossDestructorRecordStore thread body effects checkedNext canonicalNext onResult stores rfl rfl scheduler residual (by
            rw [used] at bounded
            simp at bounded
            omega)
        · exact finishDestructorFramedCut lhs rhs (.cons guard afterGuard) (by simp only [List.length_cons, List.length_nil]; omega)
    · have mismatch : SharedRecordOwnerProbeMismatch left right leftRead rightRead receipt cx index ptr check canon :=
        ⟨checkedNext, canonicalNext, checkedAt, canonicalAt, rfl, rfl, agrees⟩
      exact .sharedRecordOwnerMismatch mismatch paths
        (.recordOwnerMismatch mismatch (.same guard rfl (.done _)) (.same peerGuard rfl (.done _))) afterGuard

open ReturnFrame.Occurrence Stored.OwnedMemory.Claims Stored.Endpoints in
private theorem crossDestructorRecordEndpoint {limit : Nat}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    (thread : check.thread = canon.thread) (cx : LiftLowerContext (core3 grow)) (site : SharedEndpointGive)
    (index ptr : Nat) (checkedNext canonicalNext : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow)))
    (onResult : ∀ result, DestructorRecordAt (check := check) (canon := canon) profile ready base bindings older limit finish
      (checkedNext result) (canonicalNext result)) :
    DestructorRecordAt (check := check) (canon := canon) profile ready base bindings older limit finish
      (.op .hostGet (fun state => sharedRecordEndpointRead site cx index ptr state.writer >>= checkedNext))
      (.op .hostGet (fun state => sharedRecordEndpointRead site cx index ptr state.writer >>= canonicalNext)) := by
  classical
  intro left right labels stores checked canonical scheduler run bounded
  let leftRead := { left with ctl := check.control (sharedRecordEndpointRead site cx index ptr left.host.writer >>= checkedNext) }
  let rightRead := { right with ctl := canon.control (sharedRecordEndpointRead site cx index ptr right.host.writer >>= canonicalNext) }
  let leftResult := sharedRecordEndpointPrepare site left.store left.host.writer
  let rightResult := sharedRecordEndpointPrepare site right.store right.host.writer
  let leftReady := { leftRead with ctl := check.control (sharedRecordEndpointAfterPrepare site cx index ptr leftResult >>= checkedNext) }
  let rightReady := { rightRead with ctl := canon.control (sharedRecordEndpointAfterPrepare site cx index ptr rightResult >>= canonicalNext) }
  have capture : Step profile ready (specDispatch ready base) left .tau leftRead :=
    .hostGet (th := check.thread) (segs := check.frames) (rest := check.rest)
      (k := fun state => sharedRecordEndpointRead site cx index ptr state.writer >>= checkedNext) checked
  have peerCapture : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) right .tau rightRead :=
    .hostGet (th := canon.thread) (segs := canon.frames) (rest := canon.rest)
      (k := fun state => sharedRecordEndpointRead site cx index ptr state.writer >>= canonicalNext) canonical
  have probe : Step profile ready (specDispatch ready base) leftRead .tau leftReady :=
    .get (th := check.thread) (segs := check.frames) (rest := check.rest)
      (k := fun store => sharedRecordEndpointAfterPrepare site cx index ptr
        (sharedRecordEndpointPrepare site store left.host.writer) >>= checkedNext) rfl
  have peerProbe : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) rightRead .tau rightReady :=
    .get (th := canon.thread) (segs := canon.frames) (rest := canon.rest)
      (k := fun store => sharedRecordEndpointAfterPrepare site cx index ptr
        (sharedRecordEndpointPrepare site store right.host.writer) >>= canonicalNext) rfl
  have lhs : FramedQuietPath profile ready (specDispatch ready base) check left [id, id] leftReady :=
    .step capture (by rw [transitionEdit, checked]; rfl) rfl (.step probe rfl rfl .done)
  have rhs : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon right [id, id] rightReady :=
    .step peerCapture (by rw [transitionEdit, canonical]; rfl) rfl (.step peerProbe rfl rfl .done)
  rcases splitSilent (count := 2) (.cons capture (.cons probe (.refl _))) run with ⟨suffix, used, residual⟩ | short
  · rw [used]
    have leftGuard : ExecutedSharedRecordEndpointGuard profile ready (specDispatch ready base)
        site cx index ptr checkedNext left leftRead leftReady check :=
      ⟨checked, rfl, rfl, capture, probe⟩
    have rightGuard : ExecutedSharedRecordEndpointGuard profile ready (specDispatch ready (LiveDispatch.host bindings base))
        site cx index ptr canonicalNext right rightRead rightReady canon :=
      ⟨canonical, rfl, rfl, peerCapture, peerProbe⟩
    have within : suffix.length ≤ limit := by rw [used, List.length_append, List.length_replicate] at bounded; omega
    by_cases agrees : leftResult = rightResult
    · cases answer : leftResult with
      | error issue =>
        have paths := CallbackPrefix.stationaryTransport (bindings := bindings) lhs.1.track rhs.1.track
        refine .destructorPrefix paths (.framed lhs.2 rhs.2) (fun aligned => aligned) ?_
        refine onResult (.error (.nested index issue)) stores ?_ ?_ scheduler residual within
        · change check.control (sharedRecordEndpointAfterPrepare site cx index ptr leftResult >>= checkedNext) = _
          rw [answer]
          rfl
        · change canon.control (sharedRecordEndpointAfterPrepare site cx index ptr rightResult >>= canonicalNext) = _
          rw [← agrees, answer]
          rfl
      | ok readyResult =>
        cases readyResult
        obtain ⟨leftSpent, leftPrepared⟩ := sharedRecordEndpointPrepared site left.store left.host.writer answer
        obtain ⟨rightSpent, rightPrepared⟩ := sharedRecordEndpointPrepared site right.store right.host.writer (agrees.symm.trans answer)
        let body := sharedRecordEndpointTransfer (sig := sig) site cx ptr
        let spendHost (host : HostState sig) := { host with writer := (Spend.endpoint site.identity).apply host.writer }
        let writeAfter (next : Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow))) (host : HostState sig) :
            Session grow sig (Ret (core3 grow)) :=
          .op (.hostSet (spendHost host)) (fun _ => body >>= next)
        let leftWrite := { leftReady with ctl := check.control (writeAfter checkedNext leftReady.host) }
        let rightWrite := { rightReady with ctl := canon.control (writeAfter canonicalNext rightReady.host) }
        let leftDone := { leftWrite with host := spendHost leftWrite.host, ctl := check.control (body >>= checkedNext) }
        let rightDone := { rightWrite with host := spendHost rightWrite.host, ctl := canon.control (body >>= canonicalNext) }
        have leftAt : leftReady.ctl = check.control (.op .hostGet (writeAfter checkedNext)) := by
          change check.control (sharedRecordEndpointAfterPrepare site cx index ptr leftResult >>= checkedNext) = _
          rw [answer]
          rfl
        have rightAt : rightReady.ctl = canon.control (.op .hostGet (writeAfter canonicalNext)) := by
          change canon.control (sharedRecordEndpointAfterPrepare site cx index ptr rightResult >>= canonicalNext) = _
          rw [← agrees, answer]
          rfl
        have read : Step profile ready (specDispatch ready base) leftReady .tau leftWrite :=
          .hostGet (th := check.thread) (segs := check.frames) (rest := check.rest) leftAt
        have peerRead : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) rightReady .tau rightWrite :=
          .hostGet (th := canon.thread) (segs := canon.frames) (rest := canon.rest) rightAt
        have commit : Step profile ready (specDispatch ready base) leftWrite .tau leftDone :=
          .hostSet (th := check.thread) (segs := check.frames) (rest := check.rest) (s := leftDone.host) (k := fun _ => body >>= checkedNext) rfl
        have peerCommit : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) rightWrite .tau rightDone :=
          .hostSet (th := canon.thread) (segs := canon.frames) (rest := canon.rest) (s := rightDone.host) (k := fun _ => body >>= canonicalNext) rfl
        have leftQuiet : FramedQuietPath profile ready (specDispatch ready base) check left [id, id, id] leftWrite :=
          lhs.append (.step (update := id) read (by rw [transitionEdit, leftAt]; rfl) rfl .done)
        have rightQuiet : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon right [id, id, id] rightWrite :=
          rhs.append (.step (update := id) peerRead (by rw [transitionEdit, rightAt]; rfl) rfl .done)
        rcases splitSilent (count := 2) (.cons read (.cons commit (.refl _))) residual with ⟨remaining, assigned, tail⟩ | short
        · rw [assigned]
          have leftPath : ComponentQuietPath profile ready (specDispatch ready base) check left [id, id, id, id] leftDone :=
            leftQuiet.1.append (ComponentQuietPath.step (update := id) commit rfl (.done _))
          have rightPath : ComponentQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon right [id, id, id, id] rightDone :=
            rightQuiet.1.append (ComponentQuietPath.step (update := id) peerCommit rfl (.done _))
          have committed : ExecutedSharedRecordEndpointSpend profile ready (specDispatch ready base)
              site cx index ptr checkedNext left leftDone :=
            ⟨check, leftRead, leftReady, leftWrite, leftSpent, leftGuard, leftPrepared, rfl, rfl, read, commit⟩
          have peerCommitted : ExecutedSharedRecordEndpointSpend profile ready (specDispatch ready (LiveDispatch.host bindings base))
              site cx index ptr canonicalNext right rightDone :=
            ⟨canon, rightRead, rightReady, rightWrite, rightSpent, rightGuard, rightPrepared, rfl, rfl, peerRead, peerCommit⟩
          have moved := CallbackPrefix.stationaryTransport (bindings := bindings) leftPath.track rightPath.track
          refine .destructorPrefix (leading := [.tau, .tau, .tau, .tau]) moved (.recordEndpointCommit committed peerCommitted) (fun aligned => aligned) ?_
          have effects : StoreEffects body :=
            (sharedEndpointTransferEffects site).bind fun _ => (storeEffectWrite _ _ _).bind fun _ => .pure _
          exact crossDestructorRecordStore thread body effects checkedNext canonicalNext onResult stores rfl rfl scheduler tail (by
            rw [assigned, List.length_append, List.length_replicate] at within
            omega)
        · exact finishDestructorFramedCut leftQuiet rightQuiet (used ▸ run) (by
            rw [List.length_append, List.length_replicate]
            simp only [List.length_cons, List.length_nil]
            omega)
    · have mismatch : SharedRecordEndpointMismatch profile ready base bindings site left right leftReady rightReady :=
        ⟨cx, index, ptr, check, canon, checkedNext, canonicalNext, leftRead, rightRead, leftGuard, rightGuard, stores, agrees⟩
      have paths := CallbackPrefix.stationaryTransport (bindings := bindings) lhs.1.track rhs.1.track
      exact .sharedRecordEndpointMismatch mismatch paths (.recordEndpointMismatch mismatch) residual
  · exact finishDestructorFramedCut lhs rhs run (by simp only [List.length_cons, List.length_nil]; omega)

