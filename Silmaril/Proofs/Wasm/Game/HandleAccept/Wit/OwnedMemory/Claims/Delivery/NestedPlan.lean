private theorem checkedSelectorJournalPath (request : GiveSelector bindings)
    (cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig))
    (focus : start.ctl = cursor.control (request.checkedEntry >>= request.checkedContinuation start.store cursor.thread)) :
    FramedQuietPath profile ready (specDispatch ready base) cursor start [id, id]
      { start with
        host := start.host.enter request.name request.kind request.args
        ctl := cursor.control (request.program >>= fun verdict => request.checkedContinuation start.store cursor.thread
          (start.host.nextTicket, verdict)) } := by
  cases cursor
  refine .step (.hostGet focus) (by rw [transitionEdit, focus]; rfl) rfl ?_
  refine .step (.hostSet rfl) rfl rfl ?_
  simp [id, Prog.bind, Prog.bind_assoc]
  exact .done

private theorem ComponentQuietPath.shortIdentityStore
    {dispatch : Call (core3 grow) → Session grow sig (Ret (core3 grow))}
    {cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)} {count : Nat} {target}
    (path : ComponentQuietPath profile ready dispatch cursor start (List.replicate count id) target)
    (run : Steps profile ready dispatch start labels finish) (short : labels.length < count) : finish.store = start.store := by
  induction count generalizing start labels with
  | zero => simp at short
  | succ count ih =>
    rw [List.replicate_succ] at path
    cases run with
    | refl => rfl
    | cons step tail =>
      cases path with
      | step planned _ remaining =>
        obtain ⟨rfl, rfl⟩ := silentStepUnique planned step
        have stored := ih remaining tail (by simpa using short)
        exact stored

open ReturnFrame.Occurrence in
private theorem quietIdentityThrough
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)} {count : Nat} {target peerTarget}
    (left : ComponentQuietPath profile ready (specDispatch ready base) check start (List.replicate count id) target)
    (right : ComponentQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon incoming
      (List.replicate count id) peerTarget)
    (stored : start.store = incoming.store)
    (run : Steps profile ready (specDispatch ready base) start labels finish) (bounded : labels.length ≤ count) :
    ∃ peer, finish.store = peer.store ∧ PayloadPrefix.visible labels = [] ∧ ∀ place,
      Prefix profile ready (specDispatch ready base) start place labels finish place ∧
      Prefix profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming place labels peer place := by
  induction run generalizing incoming count target peerTarget with
  | refl => exact ⟨incoming, stored, rfl, fun place => ⟨.done _ place, .done _ place⟩⟩
  | cons actual rest ih =>
    cases count with
    | zero => simp at bounded
    | succ count =>
      rw [List.replicate_succ] at left right
      cases left with
      | step planned leftEdit leftTail =>
        cases right with
        | step peerStep rightEdit rightTail =>
          obtain ⟨rfl, rfl⟩ := silentStepUnique planned actual
          obtain ⟨peer, same, visible, tracks⟩ := ih leftTail rightTail stored (by simpa using bounded)
          exact ⟨peer, same, (visibleTauCons _).trans visible, fun place =>
            ⟨.step planned (by rw [leftEdit]; rfl) (tracks place).1,
             .step peerStep (by rw [rightEdit]; rfl) (tracks place).2⟩⟩

open ReturnFrame.Occurrence in
private theorem bindDangling {Input Output : Type} (next : Input → Session grow sig Output) :
    (trap (.internal "dangling arena id") : Session grow sig Input).bind next = trap (.internal "dangling arena id") :=
  internalBind _ next

private theorem scanAdmit {Result : Type} (store : CStore (core3 grow)) (thread : Option ThreadId) (inst : InstId)
    (selection : Session grow sig (Except Scheduled.Issue Result)) :
    (scanSelector store thread (admit inst selection)).2 =
      match Plain.callerInstance store thread with
      | .error _ => internal "dangling arena id"
      | .ok caller =>
        if caller != some inst || !(store.inst? inst).any (·.mayLeave) then pure (.error .wrongContext)
        else (scanSelector store thread selection).2 := by
  cases thread with
  | none => rfl
  | some worker =>
    simp only [admit, currentInst?, currentTask?, getThread, getTask, getObj, currentThread, getStore, perform,
      Prog.bind_eq, Prog.bind_assoc]
    cases active : ArenaField.threads.get? store worker with
    | none =>
      simp [bind, Prog.lift, Prog.bind, Plain.callerInstance, active, scanSelector, internal,
        throw, throwThe, MonadExceptOf.throw, trap]
      congr 1
      funext impossible
      exact nomatch impossible
    | some running =>
      cases task : ArenaField.tasks.get? store running.task with
      | none =>
        simp [bind, Prog.lift, Prog.bind, Plain.callerInstance, active, task, scanSelector, internal,
          throw, throwThe, MonadExceptOf.throw, trap]
        congr 1
        funext impossible
        exact nomatch impossible
      | some owner =>
        simp [bind, Prog.lift, Prog.bind, Plain.callerInstance, active, task, scanSelector, pure, Except.pure]
        split <;> rfl

private theorem selectorScanFrontier (request : GiveSelector bindings) (store : CStore (core3 grow)) (thread : Option ThreadId) :
    SelectorFrontier request store thread (scanSelector store thread request.program).2 := by
  cases request with
  | mk name kind args inst dest schema linked =>
    cases schema with
    | none =>
      simp only [GiveSelector.program, scanAdmit]
      generalize caller : Plain.callerInstance store thread = verdict
      cases verdict with
      | error => exact .trapped _
      | ok callerInst =>
        change SelectorFrontier (⟨name, kind, args, inst, dest, none, linked⟩ : GiveSelector bindings) store thread
          (if callerInst != some inst || !(store.inst? inst).any (·.mayLeave)
          then pure (.error .wrongContext) else (scanSelector store thread (selectMemoryDestination dest args)).2)
        split
        · exact .verdict _
        next context =>
          unfold selectMemoryDestination
          split
          next _ handle pointer =>
            split
            · exact .verdict _
            next width =>
              cases checked : dest.check store with
              | error issue =>
                simpa [bind, Prog.bind, getStore, perform, Prog.lift, scanSelector, checked] using
                  (SelectorFrontier.verdict (request := ⟨name, kind, _, inst, dest, none, linked⟩) (store := store) (thread := thread)
                    (.error issue))
              | ok valid =>
                let request : GiveSelector bindings := ⟨name, kind, [.int .i32 handle, pointer], inst, dest, none, linked⟩
                have demanded : request.lookupDemand store thread = some handle := by
                  simp [request, GiveSelector.lookupDemand, giveLookupDemand, caller, context, checked, width, Execution.Runtime.Value.int]
                let decode : Option (Stored.OwnedMemory.Tree sig) → Except Scheduled.Issue (Stored.OwnedMemory.Tree sig × Nat) :=
                  fun found => match found with
                  | none => .error .badSelection
                  | some tree => .ok (tree, flatNat pointer)
                have shape : (scanSelector store thread (selectMemoryDestination (sig := sig) dest [.int .i32 handle, pointer])).2 =
                    select handle >>= fun found => pure (decode found) := by
                  simp [selectMemoryDestination, Execution.Runtime.Value.int, bind, Prog.bind, getStore, perform,
                    Prog.lift, scanSelector, select, hostGet, checked, width, decode]
                  congr 1
                  funext observation
                  cases Stored.Endpoints.Core.childFromHistory observation.writer.accepted handle <;> rfl
                have frontier : SelectorFrontier request store thread
                    (scanSelector store thread (selectMemoryDestination dest [.int .i32 handle, pointer])).2 := by
                  rw [shape]
                  exact .lookup handle decode demanded
                simpa [request, selectMemoryDestination, Execution.Runtime.Value.int, width] using frontier
          next => exact .verdict _
    | some schema =>
      simp only [GiveSelector.program, scanAdmit]
      generalize caller : Plain.callerInstance store thread = verdict
      cases verdict with
      | error => exact .trapped _
      | ok callerInst =>
        change SelectorFrontier (⟨name, kind, args, inst, dest, some schema, linked⟩ : GiveSelector bindings) store thread
          (if callerInst != some inst || !(store.inst? inst).any (·.mayLeave)
          then pure (.error .wrongContext) else (scanSelector store thread (selectFlatDestination dest schema args)).2)
        split
        · exact .verdict _
        next context =>
          unfold selectFlatDestination
          split
          next _ handle =>
            cases checked : dest.check store with
            | error issue =>
              simpa [bind, Prog.bind, getStore, perform, Prog.lift, scanSelector, checked] using
                (SelectorFrontier.verdict (request := ⟨name, kind, _, inst, dest, some schema, linked⟩) (store := store) (thread := thread)
                  (.error issue))
            | ok valid =>
              let request : GiveSelector bindings := ⟨name, kind, [.int .i32 handle], inst, dest, some schema, linked⟩
              have demanded : request.lookupDemand store thread = some handle := by
                simp [request, GiveSelector.lookupDemand, giveLookupDemand, caller, context, checked, Execution.Runtime.Value.int]
              let decode : Option (Stored.OwnedMemory.Tree sig) → Except Scheduled.Issue (Stored.OwnedMemory.Tree sig) :=
                fun found => match found with
                | none => .error .badSelection
                | some tree => if !rootHasSchema tree schema then .error .wrongPayloadType else .ok tree
              have shape : (scanSelector store thread (selectFlatDestination (sig := sig) dest schema [.int .i32 handle])).2 =
                  select handle >>= fun found => pure (decode found) := by
                simp [selectFlatDestination, Execution.Runtime.Value.int, bind, Prog.bind, getStore, perform,
                  Prog.lift, scanSelector, select, hostGet, checked, decode]
                congr 1
                funext observation
                generalize Stored.Endpoints.Core.childFromHistory observation.writer.accepted handle = found
                cases found with
                | none => rfl
                | some tree => simp; split <;> rfl
              change SelectorFrontier request store thread
                (scanSelector store thread (selectFlatDestination dest schema [.int .i32 handle])).2
              rw [shape]
              exact SelectorFrontier.lookup (request := request) handle decode demanded
          next => exact .verdict _

open ReturnFrame.Occurrence in
private theorem selectorDanglingPath
    {dispatch : Call (core3 grow) → Session grow sig (Ret (core3 grow))}
    {reason : TrapReason}
    (request : GiveSelector bindings) (worker : ThreadId) (frames rest)
    (next : Except Scheduled.Issue (SelectionValue sig request.schema) → Session grow sig (Ret (core3 grow)))
    (focus : start.ctl = (PayloadPrefix.Cursor.mk (some worker) frames rest).control (request.program >>= next))
    (dangling : Plain.callerInstance start.store (some worker) = .error (.trapped reason)) :
    let count := if (ArenaField.threads.get? start.store worker).isSome then 3 else 2
    reason = .internal "dangling arena id" ∧
      FramedQuietPath profile ready dispatch ⟨some worker, frames, rest⟩ start (List.replicate count id)
        { start with ctl := (PayloadPrefix.Cursor.mk (some worker) frames rest).control (trap reason) } := by
  have path {Result : Type} (selection : Session grow sig (Except Scheduled.Issue Result))
      (follow : Except Scheduled.Issue Result → Session grow sig (Ret (core3 grow)))
      (focused : start.ctl = (PayloadPrefix.Cursor.mk (some worker) frames rest).control
        (admit request.inst selection >>= follow)) :
      let count := if (ArenaField.threads.get? start.store worker).isSome then 3 else 2
      reason = .internal "dangling arena id" ∧
        FramedQuietPath profile ready dispatch ⟨some worker, frames, rest⟩ start (List.replicate count id)
          { start with ctl := (PayloadPrefix.Cursor.mk (some worker) frames rest).control (trap reason) } := by
    simp only [admit, currentInst?, currentTask?, getThread, getTask, getObj,
      currentThread, getStore, perform, Prog.bind_eq, Prog.bind_assoc] at focused
    cases active : ArenaField.threads.get? start.store worker with
    | none =>
      have cause : reason = .internal "dangling arena id" := by
        simpa [Plain.callerInstance, active, throw, throwThe, MonadExceptOf.throw] using dangling.symm
      subst reason
      refine ⟨rfl, .step (.currentThread focused) (by rw [transitionEdit, focused]; rfl) rfl ?_⟩
      apply prependSelectorGet rfl
      simp [active, Prog.lift, Prog.bind, internal, bindDangling]
      exact .done
    | some current =>
      cases task : ArenaField.tasks.get? start.store current.task with
      | none =>
        have cause : reason = .internal "dangling arena id" := by
          simpa [Plain.callerInstance, active, task, throw, throwThe, MonadExceptOf.throw] using dangling.symm
        subst reason
        refine ⟨rfl, .step (.currentThread focused) (by rw [transitionEdit, focused]; rfl) rfl ?_⟩
        apply prependSelectorGet rfl
        simp [id, active, Prog.lift, Prog.bind]
        apply prependSelectorGet rfl
        simp [task, Prog.bind, internal, bindDangling]
        exact .done
      | some currentTask => simp [Plain.callerInstance, active, task, pure, Except.pure] at dangling
  cases request with
  | mk name kind args inst dest schema linked =>
    cases schema <;> exact path _ next focus

open ReturnFrame.Occurrence in
private theorem selectorReadStep
    {dispatch : Call (core3 grow) → Session grow sig (Ret (core3 grow))}
    (cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)) (handle : BitVec IntType.i32.width)
    (follow : Option (Stored.OwnedMemory.Tree sig) → Session grow sig (Ret (core3 grow)))
    (focus : start.ctl = cursor.control (select handle >>= follow)) :
    let next := { start with ctl := cursor.control (follow (Stored.Endpoints.Core.childFromHistory start.host.writer.accepted handle)) }
    Step profile ready dispatch start .tau next ∧ FramedQuietPath profile ready dispatch cursor start [id] next := by
  cases cursor
  have read : Step profile ready dispatch start .tau _ := .hostGet focus
  exact ⟨read, .step read (by rw [transitionEdit, focus]; rfl) rfl (.done)⟩

private theorem commonSelectorPaths (request : GiveSelector bindings) (thread : Option ThreadId)
    {frames rest peerFrames peerRest} {selected : Except Scheduled.Issue (SelectionValue sig request.schema)}
    (source : HostState sig)
    (checkNext canonNext : Except Scheduled.Issue (SelectionValue sig request.schema) → Session grow sig (Ret (core3 grow)))
    (leftAt : start.ctl = (PayloadPrefix.Cursor.mk thread frames rest).control (request.program >>= checkNext))
    (rightAt : incoming.ctl = (PayloadPrefix.Cursor.mk thread peerFrames peerRest).control (request.program >>= canonNext))
    (sameStore : start.store = incoming.store)
    (evaluated : Plain.runBody request.program start.store source (some thread) = (start.store, source, .ok selected))
    (reads : ∀ handle, request.lookupDemand start.store thread = some handle →
      Stored.Endpoints.Core.childFromHistory source.writer.accepted handle =
        Stored.Endpoints.Core.childFromHistory start.host.writer.accepted handle ∧
      Stored.Endpoints.Core.childFromHistory source.writer.accepted handle =
        Stored.Endpoints.Core.childFromHistory incoming.host.writer.accepted handle) :
    ∃ count,
      FramedQuietPath profile ready (specDispatch ready base) ⟨thread, frames, rest⟩ start (List.replicate count id)
        { start with ctl := (PayloadPrefix.Cursor.mk thread frames rest).control (checkNext selected) } ∧
      FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) ⟨thread, peerFrames, peerRest⟩
        incoming (List.replicate count id)
          { incoming with ctl := (PayloadPrefix.Cursor.mk thread peerFrames peerRest).control (canonNext selected) } := by
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, peerFrames, peerRest⟩
  generalize scanned : scanSelector start.store thread request.program = normal
  obtain ⟨count, pending⟩ := normal
  have certified := selectorScanFrontier request start.store thread
  rw [scanned] at certified
  have left := scanSelectorPath (profile := profile) (ready := ready) (dispatch := specDispatch ready base)
    check request.program checkNext leftAt
  have right := scanSelectorPath (profile := profile) (ready := ready) (dispatch := specDispatch ready (LiveDispatch.host bindings base))
    canon request.program canonNext rightAt
  have peerScanned : scanSelector incoming.store thread request.program = (count, pending) := sameStore ▸ scanned
  dsimp only [check, canon] at left right
  rw [scanned] at left
  rw [peerScanned] at right
  rw [← scanSelectorEval start.store thread source request.program, scanned] at evaluated
  cases certified with
  | verdict verdict =>
    have same : verdict = selected := Except.ok.inj (congrArg (·.2.2) evaluated)
    subst verdict
    exact ⟨count, left, right⟩
  | trapped reason => cases evaluated
  | lookup handle decode demanded =>
    have verdict : decode (Stored.Endpoints.Core.childFromHistory source.writer.accepted handle) = selected :=
      Except.ok.inj (congrArg (·.2.2) evaluated)
    obtain ⟨checkedValue, canonicalValue⟩ := reads handle demanded
    let leftRead := { start with ctl := check.control (select handle >>= fun found => checkNext (decode found)) }
    let rightRead := { incoming with ctl := canon.control (select handle >>= fun found => canonNext (decode found)) }
    have leftPath : FramedQuietPath profile ready (specDispatch ready base) check start (List.replicate count id) leftRead := by
      simpa [leftRead, check, select, hostGet, perform, Prog.lift, bind, Prog.bind] using left
    have rightPath : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon
        incoming (List.replicate count id) rightRead := by
      simpa [rightRead, canon, select, hostGet, perform, Prog.lift, bind, Prog.bind] using right
    obtain ⟨_, leftLast⟩ := selectorReadStep (profile := profile) (ready := ready) (dispatch := specDispatch ready base)
      (start := leftRead) check handle (fun found => checkNext (decode found)) rfl
    obtain ⟨_, rightLast⟩ := selectorReadStep (profile := profile) (ready := ready)
      (dispatch := specDispatch ready (LiveDispatch.host bindings base)) (start := rightRead)
      canon handle (fun found => canonNext (decode found)) rfl
    refine ⟨count + 1, ?_, ?_⟩
    · rw [List.replicate_add]
      simpa only [leftRead, ← checkedValue, verdict, List.replicate_succ, List.replicate_zero] using
        leftPath.append leftLast
    · rw [List.replicate_add]
      simpa only [rightRead, ← canonicalValue, verdict, List.replicate_succ, List.replicate_zero] using
        rightPath.append rightLast

private theorem selectorRefusalReplies (request : GiveSelector bindings) (store : CStore (core3 grow)) (thread : Option ThreadId)
    (ticket : Nat) (issue : Scheduled.Issue) :
    let reply := giveAdmissionReply ticket request.destination request.schema issue
    request.checkedContinuation store thread (ticket, .error issue) = (do return .flat (← writeCompletion reply)) ∧
    request.canonicalContinuation store thread (.error issue) = .pure (.flat reply.2) := by
  cases request with
  | mk name kind args inst dest schema linked =>
    cases schema <;> simp only [GiveSelector.checkedContinuation, GiveSelector.canonicalContinuation]
    all_goals cases threadMayLeave store thread <;> exact ⟨rfl, rfl⟩

open ReturnFrame.Occurrence in
private theorem checkedCompletionPath {check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    {dispatch : Call (core3 grow) → Session grow sig (Ret (core3 grow))}
    (reply : Event × List FlatValue)
    (focus : start.ctl = check.control (do return .flat (← writeCompletion reply))) :
    FramedQuietPath profile ready dispatch check start [id, id]
      { start with host := start.host.record reply.1, ctl := check.control (.pure (.flat reply.2)) } := by
  cases check
  exact .step (.hostGet focus) (by rw [transitionEdit, focus]; rfl) rfl (.step (.hostSet rfl) rfl rfl .done)

open ReturnFrame.Occurrence in
private theorem coreAcceptProbeStep
    {dispatch : Call (core3 grow) → Session grow sig (Ret (core3 grow))}
    {check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)} {ticket : Nat} {tree : Stored.OwnedMemory.Tree sig}
    (focus : start.ctl = check.control (coreAcceptAfterLoad ticket (.ok tree))) :
    Step profile ready dispatch start .tau
      { start with ctl := check.control (coreAcceptRegistrationProgram ticket tree start.host) } := by
  exact .hostGet (th := check.thread) (segs := check.frames) (rest := check.rest)
    (k := coreAcceptRegistrationProgram ticket tree) focus

open ReturnFrame.Occurrence in
private theorem compareCoreAcceptPaths {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    {left right : Config (core3 grow) (HostState sig)} {edits : List (ComponentStoreEdit grow)}
    {leftTicket rightTicket : Nat} {words : List FlatValue}
    (site : PairedComponentSite older start incoming check canon)
    (checked : ComponentQuietPath profile ready (specDispatch ready base) check start edits left)
    (raw : ComponentQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon incoming edits right)
    (leftEntry : ∃ program, start.ctl = check.control program) (rightEntry : ∃ program, incoming.ctl = canon.control program)
    (leftReply : left.ctl = check.control (.pure (.flat words))) (rightReply : right.ctl = canon.control (.pure (.flat words)))
    (frame : PairedComponentSite older left right check canon)
    (effects : ∀ {used lhs rhs}, used.length ≤ edits.length →
      Steps profile ready (specDispatch ready base) start used lhs →
      Steps profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming used rhs →
      VisitorWriterPath profile ready base bindings start incoming used used lhs rhs)
    (run : Steps profile ready (specDispatch ready base) start labels finish) :
    CoreAcceptCompletionCut profile ready base bindings older start incoming check canon leftTicket rightTicket labels finish := by
  have full := (checked.track (.active 0 0)).toTrail.steps
  rcases splitSilent full run with ⟨tail, split, residual⟩ | short
  · exact ⟨_, tail, left, right, split, visibleTaus _, fun place => ⟨checked.track place, raw.track place⟩,
      effects (by simp) full (raw.track (.active 0 0)).toTrail.steps, residual, frame, .inr (.inl ⟨_, leftReply, rightReply⟩)⟩
  · obtain ⟨_, peer, paths, atPeer, _, _⟩ := compareQuietShort checked raw site leftEntry rightEntry run short
    have peerRun := (CallbackPrefix.transportPaths paths none).choose_spec.2.steps
    have writers := effects (Nat.le_of_lt short) run peerRun
    obtain ⟨quiet, checkedPaths⟩ := quietCheckedShort checked run short
    obtain ⟨_, rawPaths⟩ := quietCheckedShort raw peerRun short
    exact ⟨labels, [], finish, peer, (List.append_nil _).symm, quiet, fun place => ⟨checkedPaths place, rawPaths place⟩, writers, .refl _, atPeer, .inl rfl⟩

private theorem compareCoreAcceptFramed {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    {edits : List (ComponentStoreEdit grow)} {left right : Config (core3 grow) (HostState sig)}
    {leftTicket rightTicket : Nat} {words : List FlatValue}
    (site : PairedComponentSite older start incoming check canon)
    (checked : FramedQuietPath profile ready (specDispatch ready base) check start edits left)
    (raw : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon incoming edits right)
    (leftEntry : ∃ program, start.ctl = check.control program) (rightEntry : ∃ program, incoming.ctl = canon.control program)
    (leftReply : left.ctl = check.control (.pure (.flat words))) (rightReply : right.ctl = canon.control (.pure (.flat words)))
    (frame : PairedComponentSite older left right check canon)
    (run : Steps profile ready (specDispatch ready base) start labels finish) :
    CoreAcceptCompletionCut profile ready base bindings older start incoming check canon leftTicket rightTicket labels finish :=
  compareCoreAcceptPaths site checked.1 raw.1 leftEntry rightEntry leftReply rightReply frame
    (fun bounded lhs rhs => .framed (takeQuietWriterPath checked.2 lhs bounded) (takeQuietWriterPath raw.2 rhs bounded)) run

open ReturnFrame.Occurrence in
private theorem coreAcceptRefusalPath
    (dispatch : Call (core3 grow) → Session grow sig (Ret (core3 grow)))
    (cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)) (ticket : Nat) (tree : Stored.OwnedMemory.Tree sig)
    (issue : Scheduled.Issue) (focus : start.ctl = cursor.control (coreAcceptAfterLoad ticket (.ok tree)))
    (refused : coreAcceptRegistrationProgram (grow := grow) ticket tree start.host = (do return .flat (← writeCompletion (completion ticket (.error issue))))) :
    FramedQuietPath profile ready dispatch cursor start [id, id, id]
      { start with
        host := start.host.record (completion ticket (.error issue)).1
        ctl := cursor.control (.pure (.flat (completion ticket (.error issue)).2)) } := by
  have read := coreAcceptProbeStep (profile := profile) (ready := ready) (dispatch := dispatch) focus
  rw [refused] at read
  exact FramedQuietPath.step read (by rw [transitionEdit, focus]; rfl) rfl
    (checkedCompletionPath (start := { start with ctl := cursor.control _ }) (completion ticket (.error issue)) rfl)

open ReturnFrame.Occurrence in
private theorem coreAcceptPublicationPath
    (dispatch : Call (core3 grow) → Session grow sig (Ret (core3 grow)))
    (cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)) (ticket : Nat) (tree : Stored.OwnedMemory.Tree sig)
    (writer : Stored.OwnedMemory.Claims.State sig) (focus : start.ctl = cursor.control (coreAcceptAfterLoad ticket (.ok tree)))
    (registered : start.host.writer.register tree = .ok writer) (room : writer.accepted.length < 2 ^ 32) :
    let reply := completion ticket (.ok writer.accepted.length)
    let published := ({ start.host with writer } : HostState sig).record (.published ticket writer.accepted.length)
    let replied := { start with host := published.record reply.1, ctl := cursor.control (.pure (.flat reply.2)) }
    ComponentQuietPath profile ready dispatch cursor start [id, id, id, id] replied ∧
      ∀ {used reached}, Steps profile ready dispatch start used reached → used.length ≤ 4 →
        ComponentPublicationWriterPrefix profile ready dispatch tree start used reached := by
  dsimp only
  let handle := writer.accepted.length
  let published := ({ start.host with writer } : HostState sig).record (.published ticket handle)
  let reply := completion ticket (.ok handle)
  let complete : Session grow sig (Ret (core3 grow)) := do return .flat (← writeCompletion reply)
  let probe := { start with ctl := cursor.control (.op (.hostSet published) (fun _ => complete)) }
  let committed := { start with host := published, ctl := cursor.control complete }
  have read : Step profile ready dispatch start .tau probe := by
    have read := coreAcceptProbeStep (profile := profile) (ready := ready) (dispatch := dispatch) focus
    simp only [coreAcceptRegistrationProgram, registered, Nat.not_le.mpr room, ite_false] at read
    exact read
  have assign : Step profile ready dispatch probe .tau committed :=
    .hostSet (th := cursor.thread) (segs := cursor.frames) (rest := cursor.rest)
      (s := published) (k := fun _ => complete) rfl
  have journal := checkedCompletionPath (profile := profile) (ready := ready) (dispatch := dispatch)
    (start := committed) (check := cursor) reply rfl
  refine ⟨.step read (by rw [transitionEdit, focus]; rfl) (.step assign rfl journal.1), ?_⟩
  intro used reached actual bounded
  cases actual with
  | refl => exact .done _
  | cons first tail =>
    obtain ⟨rfl, rfl⟩ := silentStepUnique read first
    cases tail with
    | refl => exact .same read rfl (.done _)
    | cons second remaining =>
      obtain ⟨rfl, rfl⟩ := silentStepUnique assign second
      have suffix := takeQuietWriterPath journal.2 remaining (by simpa using bounded)
      have finalWriter : reached.host.writer = writer := WriterPaths.spend suffix (updates := []) .nil
      have different : committed.host.writer ≠ probe.host.writer := by
        change writer ≠ start.host.writer
        intro equal
        have grows := congrArg List.length (Stored.OwnedMemory.Claims.register_claims registered).1
        simp [equal] at grows
      simp only [ComponentPublicationWriterPrefix, List.length_cons, Nat.not_lt.mpr (Nat.le_add_left 2 _), ite_false]
      have path : WriterPath profile ready dispatch start (.tau :: .tau :: _) reached [(start.host.writer, writer)] :=
        .same read rfl (.changed assign different suffix)
      refine ⟨?_, ?_, ⟨ticket, handle, cursor, probe, committed, fun _ => complete, _, rfl, .inr focus, rfl,
        read, assign, rfl, registered, suffix⟩⟩
      · rw [finalWriter]
        exact path
      · rwa [finalWriter]

private theorem coreRegistrationAliased {writer : Stored.OwnedMemory.Claims.State sig} {tree : Stored.OwnedMemory.Tree sig}
    (aliased : componentRegistration writer tree = .aliased) :
    writer.register tree = .error .alias := by
  cases verdict : writer.register tree with
  | error issue =>
    unfold Stored.OwnedMemory.Claims.State.register at verdict
    dsimp only at verdict
    split at verdict
    · cases verdict
    · exact verdict.symm
  | ok registered =>
    simp only [componentRegistration, verdict] at aliased
    split at aliased <;> contradiction

private theorem coreRegistrationExhausted {writer : Stored.OwnedMemory.Claims.State sig} {tree : Stored.OwnedMemory.Tree sig}
    (exhausted : componentRegistration writer tree = .exhausted) :
    ∃ registered, writer.register tree = .ok registered ∧ 2 ^ 32 ≤ registered.accepted.length := by
  cases verdict : writer.register tree with
  | error issue => simp [componentRegistration, verdict] at exhausted
  | ok registered =>
    simp only [componentRegistration, verdict] at exhausted
    split at exhausted
    · exact ⟨registered, rfl, ‹_›⟩
    · contradiction

private theorem coreRegistrationFresh {writer : Stored.OwnedMemory.Claims.State sig} {tree : Stored.OwnedMemory.Tree sig}
    {handle : Nat} (fresh : componentRegistration writer tree = .fresh handle) :
    ∃ registered, writer.register tree = .ok registered ∧ handle = registered.accepted.length ∧ handle < 2 ^ 32 := by
  cases verdict : writer.register tree with
  | error issue => simp [componentRegistration, verdict] at fresh
  | ok registered =>
    simp only [componentRegistration, verdict] at fresh
    split at fresh
    · contradiction
    · rename_i room
      cases fresh
      exact ⟨registered, rfl, rfl, Nat.lt_of_not_ge room⟩

open ReturnFrame.Occurrence in
private theorem cutCoreAcceptRegistration {tree : Stored.OwnedMemory.Tree sig}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)} {leftTicket rightTicket : Nat}
    (leftFocus : start.ctl = check.control (coreAcceptAfterLoad leftTicket (.ok tree)))
    (rightFocus : incoming.ctl = canon.control (coreAcceptAfterLoad rightTicket (.ok tree)))
    (site : PairedComponentSite older start incoming check canon)
    (run : Steps profile ready (specDispatch ready base) start labels finish) :
    CoreAcceptCompletionCut profile ready base bindings older start incoming check canon leftTicket rightTicket labels finish := by
  classical
  have refuse (issue : Scheduled.Issue)
      (left : coreAcceptRegistrationProgram (grow := grow) leftTicket tree start.host = (do return .flat (← writeCompletion (completion leftTicket (.error issue)))))
      (right : coreAcceptRegistrationProgram (grow := grow) rightTicket tree incoming.host =
        (do return .flat (← writeCompletion (completion rightTicket (.error issue))))) :
      CoreAcceptCompletionCut profile ready base bindings older start incoming check canon leftTicket rightTicket labels finish :=
    compareCoreAcceptFramed site
      (coreAcceptRefusalPath (specDispatch ready base) check leftTicket tree issue leftFocus left)
      (coreAcceptRefusalPath (specDispatch ready (LiveDispatch.host bindings base)) canon rightTicket tree issue rightFocus right)
      ⟨_, leftFocus⟩ ⟨_, rightFocus⟩ rfl rfl (by
          unfold PairedComponentSite HostFrame.Related.Paired HostFrame.replace at site ⊢
          exact pairQuietHost site _) run
  by_cases agrees : componentRegistration start.host.writer tree = componentRegistration incoming.host.writer tree
  · cases observation : componentRegistration start.host.writer tree with
    | aliased =>
      have left := coreRegistrationAliased observation
      have right := coreRegistrationAliased (agrees.symm.trans observation)
      exact refuse (.accept (.claims .alias))
        (by simp only [coreAcceptRegistrationProgram, left]; rfl)
        (by simp only [coreAcceptRegistrationProgram, right]; rfl)
    | exhausted =>
      obtain ⟨lhs, left, fullLeft⟩ := coreRegistrationExhausted observation
      obtain ⟨rhs, right, fullRight⟩ := coreRegistrationExhausted (agrees.symm.trans observation)
      exact refuse (.accept (.boundary .exhaustedHandles))
        (by simp only [coreAcceptRegistrationProgram, left, fullLeft, ite_true]; rfl)
        (by simp only [coreAcceptRegistrationProgram, right, fullRight, ite_true]; rfl)
    | fresh handle =>
      obtain ⟨lhs, left, leftIndex, leftRoom⟩ := coreRegistrationFresh observation
      obtain ⟨rhs, right, rightIndex, rightRoom⟩ := coreRegistrationFresh (agrees.symm.trans observation)
      have leftPath := coreAcceptPublicationPath (profile := profile) (ready := ready)
        (specDispatch ready base) check leftTicket tree lhs leftFocus left (leftIndex ▸ leftRoom)
      have rightPath := coreAcceptPublicationPath (profile := profile) (ready := ready)
        (specDispatch ready (LiveDispatch.host bindings base)) canon rightTicket tree rhs rightFocus right (rightIndex ▸ rightRoom)
      exact compareCoreAcceptPaths (words := (completion leftTicket (.ok handle)).2)
        site leftPath.1 rightPath.1 ⟨_, leftFocus⟩ ⟨_, rightFocus⟩
        (by simp only [← leftIndex]) (by simp only [← rightIndex]; rfl)
        (by
          unfold PairedComponentSite HostFrame.Related.Paired HostFrame.replace at site ⊢
          exact pairQuietHost site _)
        (fun bounded lhsRun rhsRun => .publication ⟨leftPath.2 lhsRun bounded, rightPath.2 rhsRun bounded⟩) run
  · cases run with
    | refl =>
      exact ⟨[], [], start, incoming, rfl, rfl, fun place => ⟨.done _ place, .done _ place⟩,
        WriterPaths.empty, .refl _, site, .inl rfl⟩
    | cons first tail =>
      let left := { start with ctl := check.control (coreAcceptRegistrationProgram leftTicket tree start.host) }
      let right := { incoming with ctl := canon.control (coreAcceptRegistrationProgram rightTicket tree incoming.host) }
      have checked : Step profile ready (specDispatch ready base) start .tau left := coreAcceptProbeStep leftFocus
      have raw : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau right :=
        coreAcceptProbeStep rightFocus
      obtain ⟨rfl, rfl⟩ := silentStepUnique checked first
      have mismatch : RegistrationProbeMismatch start incoming left right check canon leftTicket rightTicket none tree :=
        ⟨leftFocus, rightFocus, rfl, rfl, agrees⟩
      refine ⟨[.tau], _, left, right, rfl, rfl, ?_, .registrationMismatch mismatch (.same checked rfl (.done _))
        (.same raw rfl (.done _)), tail, (by simpa only [PairedComponentSite, HostFrame.Related.Paired, HostFrame.replace, left, right] using site),
        .inr (.inr ⟨tree, mismatch⟩)⟩
      intro place
      exact ⟨Prefix.step checked (by rw [transitionEdit, leftFocus]; rfl) (.done _ place),
        Prefix.step raw (by rw [transitionEdit, rightFocus]; rfl) (.done _ place)⟩

private theorem cutCoreAcceptCompletion
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)} {leftTicket rightTicket : Nat}
    {loaded : Except Silmaril.Wasm.Game.HandleAccept.Wit.Stored.OwnedMemory.Claims.Core.Issue (Stored.OwnedMemory.Tree sig)}
    (leftFocus : start.ctl = check.control (coreAcceptAfterLoad leftTicket loaded))
    (rightFocus : incoming.ctl = canon.control (coreAcceptAfterLoad rightTicket loaded))
    (site : PairedComponentSite older start incoming check canon)
    (run : Steps profile ready (specDispatch ready base) start labels finish) :
    CoreAcceptCompletionCut profile ready base bindings older start incoming check canon leftTicket rightTicket labels finish := by
  cases loaded with
  | ok tree => exact cutCoreAcceptRegistration leftFocus rightFocus site run
  | error issue =>
    have left := checkedCompletionPath (profile := profile) (ready := ready) (dispatch := specDispatch ready base)
      (check := check) (completion leftTicket (.error (.accept issue))) leftFocus
    have right := checkedCompletionPath (profile := profile) (ready := ready) (dispatch := specDispatch ready (LiveDispatch.host bindings base))
      (check := canon) (completion rightTicket (.error (.accept issue))) rightFocus
    exact compareCoreAcceptFramed site left right ⟨_, leftFocus⟩ ⟨_, rightFocus⟩ rfl rfl (by
          unfold PairedComponentSite HostFrame.Related.Paired HostFrame.replace at site ⊢
          exact pairQuietHost site _) run

open ReturnFrame.Occurrence in
private theorem cutGiveQuietPrefix
    {left right leftEntered leftEnd rightEnd : Config (core3 grow) (HostState sig)}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)} {bodyLabels : Trace grow sig} {count : Nat}
    (total : .tau :: labels = [.tau, .tau, .tau] ++ bodyLabels)
    (paths : OccurrenceTransport profile ready base bindings start incoming [.tau, .tau, .tau] [.tau, .tau, .tau]
      left right [some (.active 0 0)])
    (entryWriters : VisitorWriterPath profile ready base bindings start incoming [.tau, .tau, .tau] [.tau, .tau, .tau] left right)
    (paired : HostFrame.Related.Paired older start incoming)
    (journal : FramedQuietPath profile ready (specDispatch ready base) check left [id, id] leftEntered)
    (checked : FramedQuietPath profile ready (specDispatch ready base) check leftEntered (List.replicate count id) leftEnd)
    (canonical : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon
      right (List.replicate count id) rightEnd)
    (stored : left.store = right.store) (enteredStore : leftEntered.store = left.store)
    (run : Steps profile ready (specDispatch ready base) left bodyLabels finish)
    (bounded : bodyLabels.length ≤ count + 2) :
    CallbackSlice profile ready base bindings older start incoming (.tau :: labels) finish := by
  rw [total]
  rcases splitSilent (count := 2) (journal.1.track (.active 0 0)).toTrail.steps run with ⟨remaining, front, residual⟩ | short
  · have remainingBound : remaining.length ≤ count := by simp [front] at bounded; omega
    obtain ⟨peer, same, seen, tracks⟩ := quietIdentityThrough checked.1 canonical.1 (enteredStore.trans stored) residual remainingBound
    have moved := retainComparedOccurrences paths (fun place => ⟨(journal.1.track place).append (tracks place).1, (tracks place).2⟩)
    have leftPrefix := takeQuietWriterPath (by simpa only [List.length_replicate] using checked.2) residual remainingBound
    have rightPrefix := takeQuietWriterPath (by simpa only [List.length_replicate] using canonical.2)
      (tracks (.active 0 0)).2.toTrail.steps remainingBound
    have writers := entryWriters.append (.framed (WriterPaths.append journal.2 leftPrefix) rightPrefix)
    rw [front]
    exact callbackTerminalSlice paired (.directGiveFinite (right := peer)
      (giveBodyAtEntryFrontier (by simp only [visibleAppend, visibleTaus, seen, List.append_nil]) same moved (.refl _) writers))
  · obtain ⟨seen, checkedPrefix⟩ := quietCheckedShort journal.1 run short
    have same := journal.1.shortIdentityStore (count := 2) run short
    have moved := retainComparedOccurrences paths (fun place => ⟨checkedPrefix place, Prefix.done right place⟩)
    have leftPrefix := takeQuietWriterPath journal.2 run (Nat.le_of_lt short)
    have writers := entryWriters.append (.framed leftPrefix (.done right))
    rw [List.append_nil] at moved writers
    exact callbackTerminalSlice paired (.directGiveFinite (right := right)
      (giveBodyAtEntryFrontier (by rw [visibleAppend, seen, List.append_nil]) (same.trans stored) moved (.refl _) writers))

open ReturnFrame.Occurrence in
private theorem cutGiveCommonRefusal (request : GiveSelector bindings) (thread : Option ThreadId)
    {left right : Config (core3 grow) (HostState sig)} {frames rest peerFrames peerRest} {bodyLabels}
    {issue : Scheduled.Issue}
    (entered : labels = [.tau, .tau] ++ bodyLabels)
    (leftAt : left.ctl = (PayloadPrefix.Cursor.mk thread frames rest).control
      (calloutBody Limits.spec Quirks.none ready base left.store thread (.embedder request.name request.kind) request.args))
    (rightAt : right.ctl = (PayloadPrefix.Cursor.mk thread peerFrames peerRest).control
      (calloutBody Limits.spec Quirks.none ready (LiveDispatch.host bindings base) right.store thread
        (.embedder request.name request.kind) request.args))
    (site : PairedComponentSite older left right ⟨thread, frames, rest⟩ ⟨thread, peerFrames, peerRest⟩)
    (paths : OccurrenceTransport profile ready base bindings start incoming [.tau, .tau, .tau] [.tau, .tau, .tau]
      left right [some (.active 0 0)])
    (entryWriters : VisitorWriterPath profile ready base bindings start incoming [.tau, .tau, .tau] [.tau, .tau, .tau] left right)
    (run : Steps profile ready (specDispatch ready base) left bodyLabels finish)
    (paired : HostFrame.Related.Paired older start incoming)
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (refused : Plain.runBody request.program left.store left.host (some thread) = (left.store, left.host, .ok (.error issue)))
    (reads : ∀ handle, request.lookupDemand left.store thread = some handle →
      Stored.Endpoints.Core.childFromHistory left.host.writer.accepted handle =
        Stored.Endpoints.Core.childFromHistory right.host.writer.accepted handle) :
    CallbackSlice profile ready base bindings older start incoming (.tau :: labels) finish ∨
    ∃ used live trailing reached peer,
      let reply := giveAdmissionReply left.host.nextTicket request.destination request.schema issue
      labels = used ++ trailing ∧
      OccurrenceTransport profile ready base bindings start incoming (.tau :: used) live reached peer [some (.active 0 0)] ∧
      VisitorWriterPath profile ready base bindings start incoming (.tau :: used) live reached peer ∧
      PayloadPrefix.visible live = PayloadPrefix.visible (.tau :: used) ∧
      PairedComponentSite older reached peer ⟨thread, frames, rest⟩ ⟨thread, peerFrames, peerRest⟩ ∧
      reached.ctl = (PayloadPrefix.Cursor.mk thread frames rest).control (.pure (.flat reply.2)) ∧
      peer.ctl = (PayloadPrefix.Cursor.mk thread peerFrames peerRest).control (.pure (.flat reply.2)) ∧
      Steps profile ready (specDispatch ready base) reached trailing finish := by
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, peerFrames, peerRest⟩
  let checkNext := fun verdict => request.checkedContinuation left.store thread (left.host.nextTicket, verdict)
  let canonNext := request.canonicalContinuation right.store thread
  rw [(request.body_split (ready := ready) (base := base) left.store thread base embedder).1] at leftAt
  rw [(request.body_split (ready := ready) (base := base) right.store thread base embedder).2] at rightAt
  let leftEntered := { left with
    host := left.host.enter request.name request.kind request.args
    ctl := check.control (request.program >>= checkNext) }
  have journal : FramedQuietPath profile ready (specDispatch ready base) check left [id, id] leftEntered :=
    checkedSelectorJournalPath request check leftAt
  have sameStore : left.store = right.store := site.data.1
  obtain ⟨count, checked, canonical⟩ := commonSelectorPaths (start := leftEntered) (incoming := right)
    request thread left.host checkNext canonNext rfl rightAt sameStore refused (fun handle demand => ⟨rfl, reads handle demand⟩)
  let selected := { leftEntered with ctl := check.control (checkNext (.error issue)) }
  let peer := { right with ctl := canon.control (canonNext (.error issue)) }
  let reply := giveAdmissionReply left.host.nextTicket request.destination request.schema issue
  have checkedAt : selected.ctl = check.control (do return .flat (← writeCompletion reply)) :=
    congrArg check.control (selectorRefusalReplies request left.store thread left.host.nextTicket issue).1
  have canonicalAt : peer.ctl = canon.control (.pure (.flat reply.2)) := by
    change canon.control (request.canonicalContinuation right.store thread (.error issue)) = _
    rw [(selectorRefusalReplies request right.store thread left.host.nextTicket issue).2]
  have writing := checkedCompletionPath (start := selected) (profile := profile) (ready := ready) (dispatch := specDispatch ready base) reply checkedAt
  have beforeReply := journal.append checked
  have canonWriters : WriterPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) right
      (List.replicate count .tau) peer [] := by
    simpa only [List.length_replicate] using canonical.2
  have before : Steps profile ready (specDispatch ready base) left (List.replicate (2 + count) .tau) selected := by
    simpa only [List.length_append, List.length_cons, List.length_nil, List.length_replicate] using
      (beforeReply.1.track (.active 0 0)).toTrail.steps
  have total : .tau :: labels = [.tau, .tau, .tau] ++ bodyLabels := by rw [entered]; rfl
  rcases splitSilent before run with ⟨remaining, front, residual⟩ | short
  · rcases splitSilent (count := 2) (writing.1.track (.active 0 0)).toTrail.steps residual with ⟨trailing, tailSplit, tail⟩ | short
    · let reached := { selected with host := selected.host.record reply.1, ctl := check.control (.pure (.flat reply.2)) }
      let ending : Trace grow sig := (List.replicate 2 .tau ++ List.replicate count .tau) ++ List.replicate 2 .tau
      have checkedTrack (place : Location) : Prefix profile ready (specDispatch ready base) left place ending reached place := by
        simp only [ending, ← List.replicate_add]
        simpa only [List.length_append, List.length_cons, List.length_nil, List.length_replicate] using
          (beforeReply.append writing).1.track place
      have canonicalTrack (place : Location) : Prefix profile ready (specDispatch ready (LiveDispatch.host bindings base)) right
          place (List.replicate count .tau) peer place := by
        simpa only [List.length_replicate] using canonical.1.track place
      have moved := retainComparedOccurrences paths (fun place => ⟨checkedTrack place, canonicalTrack place⟩)
      let used : Trace grow sig := [.tau, .tau] ++ ending
      let live : Trace grow sig := [.tau, .tau, .tau] ++ List.replicate count .tau
      refine .inr ⟨used, live, trailing, reached, peer, ?_, ?_, ?_, ?_, site, rfl, canonicalAt, tail⟩
      · rw [entered, front, tailSplit]
        simp only [used, ending, List.replicate_add, List.append_assoc]
      · exact moved
      · have leftFrame : WriterPath profile ready (specDispatch ready base) left ending reached [] := by
          simpa only [ending, ← List.replicate_add, List.length_append, List.length_cons, List.length_nil, List.length_replicate]
            using (beforeReply.append writing).2
        exact entryWriters.append (.framed leftFrame canonWriters)
      · simp only [used, ending, live, visibleAppend, visibleTauCons, visibleTaus, List.append_nil]
    · obtain ⟨seen, checkedTail⟩ := quietCheckedShort writing.1 residual short
      have stored := writing.1.shortIdentityStore (count := 2) residual short
      have moved := retainComparedOccurrences paths (fun place => ⟨(beforeReply.1.track place).append (checkedTail place), canonical.1.track place⟩)
      have aligned : .tau :: labels = [.tau, .tau, .tau] ++ (List.replicate (2 + count) .tau ++ remaining) := by rw [total, front]
      rw [aligned]
      have lhsWriter : WriterPath profile ready (specDispatch ready base) left (List.replicate (2 + count) .tau ++ remaining) finish [] := by
        simpa only [List.length_append, List.length_cons, List.length_nil, List.length_replicate, Nat.zero_add, List.nil_append] using
          WriterPaths.append beforeReply.2 (takeQuietWriterPath writing.2 residual (Nat.le_of_lt short))
      refine .inl (callbackTerminalSlice paired (.directGiveFinite (right := peer)
        (canonical := [.tau, .tau, .tau] ++ List.replicate count .tau) (marks := [some (.active 0 0)])
        ⟨?_, stored.trans sameStore, ?_, .refl _, entryWriters.append (.framed lhsWriter canonWriters)⟩))
      · simp only [visibleAppend, visibleTaus, seen, List.append_nil]
      · simpa only [List.length_append, List.length_cons, List.length_nil, List.length_replicate] using moved
  · rw [total]
    rcases splitSilent (count := 2) (journal.1.track (.active 0 0)).toTrail.steps run with
      ⟨remaining, front, residual⟩ | beforeJournal
    · have bounded : remaining.length ≤ count := by simp [front] at short; omega
      obtain ⟨atPeer, store, seen, tracks⟩ := quietIdentityThrough checked.1 canonical.1 sameStore residual bounded
      have moved := retainComparedOccurrences paths (fun place => ⟨(journal.1.track place).append (tracks place).1, (tracks place).2⟩)
      have checkFrame : WriterPath profile ready (specDispatch ready base) left ([.tau, .tau] ++ remaining) finish [] := by
        apply WriterPaths.append journal.2
        exact takeQuietWriterPath (by simpa only [List.length_replicate] using checked.2) residual bounded
      have rawFrame := takeQuietWriterPath canonWriters (tracks (.active 0 0)).2.toTrail.steps bounded
      rw [front]
      refine .inl (callbackTerminalSlice paired (.directGiveFinite (right := atPeer)
        ⟨?_, store, moved, .refl _, entryWriters.append (.framed checkFrame rawFrame)⟩))
      simp only [visibleAppend, visibleTaus, seen, List.append_nil]
    · obtain ⟨seen, tracks⟩ := quietCheckedShort journal.1 run beforeJournal
      have store := journal.1.shortIdentityStore (count := 2) run beforeJournal
      have moved := retainComparedOccurrences paths (fun place => ⟨tracks place, Prefix.done right place⟩)
      rw [List.append_nil] at moved
      have framed := takeQuietWriterPath journal.2 run (Nat.le_of_lt beforeJournal)
      have writers := entryWriters.append (.framed framed (.done right))
      rw [List.append_nil] at writers
      exact .inl (callbackTerminalSlice paired (.directGiveFinite (right := right)
        ⟨by rw [visibleAppend, seen, List.append_nil], store.trans sameStore, moved, .refl _, writers⟩))

open ReturnFrame.Occurrence in
private theorem quietTrapTracks {cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    {dispatch : Call (core3 grow) → Session grow sig (Ret (core3 grow))}
    {updates : List (ComponentStoreEdit grow)} {target : Config (core3 grow) (HostState sig)} {reason : TrapReason}
    (path : ComponentQuietPath profile ready dispatch cursor start updates target)
    (focus : target.ctl = cursor.control (trap reason)) (mark : Option Location) :
    Trail profile ready dispatch start mark (List.replicate updates.length .tau ++ [.trap reason])
      (StepDefs.trapCfg target) (mark.bind (Edit.clear : Edit (core3 grow) (HostState sig)).follow) := by
  have step : Step profile ready dispatch target (.trap reason) (StepDefs.trapCfg target) := by
    cases cursor
    exact .trap focus
  have last : Trail profile ready dispatch target mark [.trap reason] (StepDefs.trapCfg target)
      (mark.bind (Edit.clear : Edit (core3 grow) (HostState sig)).follow) := .step step (.done _ _)
  cases mark with
  | none => exact (Trail.absent (path.track (.active 0 0)).toTrail.steps).append last
  | some place => exact (path.track place).toTrail.append last

private theorem quietTrapWriters {cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    {dispatch : Call (core3 grow) → Session grow sig (Ret (core3 grow))}
    {updates : List (ComponentStoreEdit grow)} {target : Config (core3 grow) (HostState sig)} {reason : TrapReason}
    (path : FramedQuietPath profile ready dispatch cursor start updates target)
    (focus : target.ctl = cursor.control (trap reason)) :
    WriterPath profile ready dispatch start (List.replicate updates.length .tau ++ [.trap reason])
      (StepDefs.trapCfg target) [] := by
  cases cursor
  exact WriterPaths.append path.2 (.same (.trap focus) rfl (.done _))

open ReturnFrame.Occurrence in
private theorem cutGiveDangling (request : GiveSelector bindings) (worker : ThreadId)
    {left right : Config (core3 grow) (HostState sig)} {frames rest peerFrames peerRest} {bodyLabels}
    {reason : TrapReason}
    (entered : labels = [.tau, .tau] ++ bodyLabels)
    (leftAt : left.ctl = (PayloadPrefix.Cursor.mk (some worker) frames rest).control
      (calloutBody Limits.spec Quirks.none ready base left.store (some worker) (.embedder request.name request.kind) request.args))
    (rightAt : right.ctl = (PayloadPrefix.Cursor.mk (some worker) peerFrames peerRest).control
      (calloutBody Limits.spec Quirks.none ready (LiveDispatch.host bindings base) right.store (some worker)
        (.embedder request.name request.kind) request.args))
    (sameStore : left.store = right.store)
    (paths : OccurrenceTransport profile ready base bindings start incoming [.tau, .tau, .tau] [.tau, .tau, .tau]
      left right [some (.active 0 0)])
    (entryWriters : VisitorWriterPath profile ready base bindings start incoming [.tau, .tau, .tau] [.tau, .tau, .tau] left right)
    (run : Steps profile ready (specDispatch ready base) left bodyLabels finish)
    (paired : HostFrame.Related.Paired older start incoming)
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (dangling : Plain.callerInstance left.store (some worker) = .error (.trapped reason)) :
    CallbackSlice profile ready base bindings older start incoming (.tau :: labels) finish := by
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, peerFrames, peerRest⟩
  rw [(request.body_split (ready := ready) (base := base) left.store (some worker) base embedder).1] at leftAt
  rw [(request.body_split (ready := ready) (base := base) right.store (some worker) base embedder).2] at rightAt
  let leftEntered := { left with
    host := left.host.enter request.name request.kind request.args
    ctl := check.control (request.program >>= fun verdict => request.checkedContinuation left.store (some worker)
      (left.host.nextTicket, verdict)) }
  have journal : FramedQuietPath profile ready (specDispatch ready base) check left [id, id] leftEntered :=
    checkedSelectorJournalPath request check leftAt
  let count := if (ArenaField.threads.get? left.store worker).isSome then 3 else 2
  obtain ⟨_, checked⟩ := selectorDanglingPath (profile := profile) (ready := ready) (dispatch := specDispatch ready base)
    (start := leftEntered) request worker frames rest _ rfl dangling
  obtain ⟨_, canonical⟩ := selectorDanglingPath (profile := profile) (ready := ready)
    (dispatch := specDispatch ready (LiveDispatch.host bindings base)) (start := right)
    request worker peerFrames peerRest _ rightAt (sameStore ▸ dangling)
  have rightCount : (if (ArenaField.threads.get? right.store worker).isSome then 3 else 2) = count := by
    rw [← sameStore]
  change FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon right
    (List.replicate (if (ArenaField.threads.get? right.store worker).isSome then 3 else 2) id) _ at canonical
  rw [rightCount] at canonical
  change FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon right
    (List.replicate count id) _ at canonical
  have leftPath := quietTrapTracks (journal.append checked).1 rfl
  have rightPath := quietTrapTracks canonical.1 rfl
  have total : .tau :: labels = [.tau, .tau, .tau] ++ bodyLabels := by rw [entered]; rfl
  have seen (size : Nat) : PayloadPrefix.visible (List.replicate size .tau ++ [.trap reason] : Trace grow sig) = [.trap reason] := by
    rw [visibleAppend, visibleTaus]
    rfl
  cases alignLocalBody (leftPath none).steps run (noBranchOfVisible (seen _) (by simp [workerBranchLabel])) with
  | inside split nonempty _ =>
    apply cutGiveQuietPrefix total paths entryWriters paired journal checked canonical sameStore rfl run
    have positive : 0 < (List.length _) := List.length_pos_iff.mpr nonempty
    have size := congrArg List.length split
    simp only [List.length_append, List.length_cons, List.length_nil, List.length_replicate] at size
    omega
  | @reached remaining split residual =>
    obtain ⟨move, before, framed⟩ := paths
    have lost : OccurrenceTransport profile ready base bindings start incoming
        ([.tau, .tau, .tau] ++ (List.replicate (([id, id] ++ List.replicate count id : List (ComponentStoreEdit grow)).length) .tau ++ [.trap reason]))
        ([.tau, .tau, .tau] ++ (List.replicate count .tau ++ [.trap reason]))
        (StepDefs.trapCfg leftEntered) (StepDefs.trapCfg right) [none] := by
      refine ⟨fun mark => (move mark).bind (Edit.clear : Edit (core3 grow) (HostState sig)).follow, ?_, ?_⟩
      · intro mark
        exact ⟨(before mark).1.append (leftPath _),
          (before mark).2.append (by simpa only [List.length_replicate, StepDefs.trapCfg] using rightPath (move mark))⟩
      · intro changes marks outside
        have cleared := (framed changes _ outside).edit (.clear : Edit (core3 grow) (HostState sig))
        simpa only [segmentStorage, StepDefs.trapCfg, Edit.apply, List.cons_append, List.nil_append,
          List.map_nil, List.map_cons, List.map_map, Function.comp_def, Option.bind_some, Edit.follow] using cleared
    have used : .tau :: labels =
        ([.tau, .tau, .tau] ++ (List.replicate (([id, id] ++ List.replicate count id : List (ComponentStoreEdit grow)).length) .tau ++
          [.trap reason])) ++ remaining := by
      rw [total]
      exact (congrArg ([.tau, .tau, .tau] ++ ·) split).trans (List.append_assoc ..).symm
    have writers := entryWriters.append (.framed (quietTrapWriters (journal.append checked) rfl)
      (by simpa only [List.length_replicate] using quietTrapWriters canonical rfl))
    rw [used]
    exact callbackTerminalSlice paired (.directGiveTrap
      (giveBodyAtEntryFrontier (by simp only [visibleAppend, seen]) (congrArg StepDefs.lockdownSt sameStore) lost residual writers)
      (by simp only [visibleAppend, seen]; rfl) rfl rfl)

open ReturnFrame.Occurrence in
private theorem cutGiveDemandedRead (request : GiveSelector bindings) (worker : ThreadId)
    {left right : Config (core3 grow) (HostState sig)} {frames rest peerFrames peerRest} {bodyLabels}
    (entered : labels = [.tau, .tau] ++ bodyLabels)
    (leftAt : left.ctl = (PayloadPrefix.Cursor.mk (some worker) frames rest).control
      (calloutBody Limits.spec Quirks.none ready base left.store (some worker) (.embedder request.name request.kind) request.args))
    (rightAt : right.ctl = (PayloadPrefix.Cursor.mk (some worker) peerFrames peerRest).control
      (calloutBody Limits.spec Quirks.none ready (LiveDispatch.host bindings base) right.store (some worker)
        (.embedder request.name request.kind) request.args))
    (site : PairedComponentSite older left right ⟨some worker, frames, rest⟩ ⟨some worker, peerFrames, peerRest⟩)
    (paths : OccurrenceTransport profile ready base bindings start incoming [.tau, .tau, .tau] [.tau, .tau, .tau]
      left right [some (.active 0 0)])
    (entryWriters : VisitorWriterPath profile ready base bindings start incoming [.tau, .tau, .tau] [.tau, .tau, .tau] left right)
    (run : Steps profile ready (specDispatch ready base) left bodyLabels finish)
    (paired : HostFrame.Related.Paired older start incoming)
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (handle : BitVec IntType.i32.width) (demand : request.lookupDemand left.store (some worker) = some handle)
    (boundary : bodyLabels.length < 8 ∨ Stored.Endpoints.Core.childFromHistory left.host.writer.accepted handle ≠
      Stored.Endpoints.Core.childFromHistory right.host.writer.accepted handle) :
    CallbackSlice profile ready base bindings older start incoming (.tau :: labels) finish := by
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, peerFrames, peerRest⟩
  have checkedSplit := (request.body_split (ready := ready) (base := base) left.store (some worker) base embedder).1
  have canonSplit := (request.body_split (ready := ready) (base := base) right.store (some worker) base embedder).2
  rw [checkedSplit] at leftAt
  rw [canonSplit] at rightAt
  let enteredLeft := { left with
    host := left.host.enter request.name request.kind request.args
    ctl := check.control (request.program >>= fun verdict => request.checkedContinuation left.store (some worker)
      (left.host.nextTicket, verdict)) }
  have journal := checkedSelectorJournalPath (profile := profile) (ready := ready) (base := base) request check leftAt
  change FramedQuietPath profile ready (specDispatch ready base) check left [id, id] enteredLeft at journal
  have sameStore := site.data.1
  have total : .tau :: labels = [.tau, .tau, .tau] ++ bodyLabels := by rw [entered]; rfl
  obtain ⟨checkNext, beforeCheck⟩ := selectorLookupPath (profile := profile) (ready := ready) (dispatch := specDispatch ready base)
    (start := enteredLeft) request worker handle frames rest _ rfl demand
  obtain ⟨canonNext, beforeCanon⟩ := selectorLookupPath (profile := profile) (ready := ready)
    (dispatch := specDispatch ready (LiveDispatch.host bindings base)) (start := right)
    request worker handle peerFrames peerRest _ rightAt (sameStore ▸ demand)
  let beforeLeft := { enteredLeft with ctl := check.control (select handle >>= checkNext) }
  let beforeRight := { right with ctl := canon.control (select handle >>= canonNext) }
  by_cases short : bodyLabels.length < 8
  · exact cutGiveQuietPrefix total paths entryWriters paired journal (count := 5) beforeCheck beforeCanon sameStore rfl run (by omega)
  obtain ⟨checkRead, checkLast⟩ := selectorReadStep (profile := profile) (ready := ready) (dispatch := specDispatch ready base)
    (start := beforeLeft) check handle checkNext rfl
  obtain ⟨canonRead, canonLast⟩ := selectorReadStep (profile := profile) (ready := ready)
    (dispatch := specDispatch ready (LiveDispatch.host bindings base)) (start := beforeRight) canon handle canonNext rfl
  have checkPath := journal.append (beforeCheck.append checkLast)
  have canonPath := beforeCanon.append canonLast
  obtain ⟨trailing, split, tail⟩ := (splitSilent (count := 8) (checkPath.1.track (.active 0 0)).toTrail.steps run).resolve_right short
  have moved := retainComparedOccurrences paths (fun place => ⟨checkPath.1.track place, canonPath.1.track place⟩)
  have used : .tau :: labels = ([.tau, .tau, .tau] ++ List.replicate 8 .tau) ++ trailing := by
    rw [total, split, ← List.append_assoc]
  rw [used]
  refine callbackTerminalSlice paired (.giveLookupMismatch (beforeLeft := beforeLeft) (beforeRight := beforeRight)
    (canonical := [.tau, .tau, .tau] ++ List.replicate 6 .tau)
    (check := check) (canon := canon) (checkNext := checkNext) (canonNext := canonNext) request
    ?_ rfl rfl checkRead canonRead demand (boundary.resolve_left short))
  exact giveBodyAtEntryFrontier rfl sameStore moved tail (entryWriters.append (.framed checkPath.2 canonPath.2))

open ReturnFrame.Occurrence in
private theorem crossActiveDirectGive (request : GiveSelector bindings) (worker : ThreadId)
    {left right : Config (core3 grow) (HostState sig)} {resume frames rest peerFrames peerRest} {bodyLabels}
    {installed : Config (core3 grow) (HostState sig)}
    (install : GiveInstall bindings (specDispatch ready base) start .tau installed)
    (entered : labels = [.tau, .tau] ++ bodyLabels)
    (leftAt : left.ctl = (PayloadPrefix.Cursor.mk (some worker) (.prog resume :: frames) rest).control
      (calloutBody Limits.spec Quirks.none ready base left.store (some worker) (.embedder request.name request.kind) request.args))
    (rightAt : right.ctl = (PayloadPrefix.Cursor.mk (some worker) (.prog resume :: peerFrames) peerRest).control
      (calloutBody Limits.spec Quirks.none ready (LiveDispatch.host bindings base) right.store (some worker)
        (.embedder request.name request.kind) request.args))
    (site : PairedComponentSite older left right ⟨some worker, .prog resume :: frames, rest⟩
      ⟨some worker, .prog resume :: peerFrames, peerRest⟩)
    (paths : OccurrenceTransport profile ready base bindings start incoming [.tau, .tau, .tau] [.tau, .tau, .tau]
      left right [some (.active 0 0)])
    (entryWriters : VisitorWriterPath profile ready base bindings start incoming [.tau, .tau, .tau] [.tau, .tau, .tau] left right)
    (run : Steps profile ready (specDispatch ready base) left bodyLabels finish)
    (paired : HostFrame.Related.Paired older start incoming)
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (compare : ShorterCallbackSlices profile ready base bindings (.tau :: labels).length) :
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  classical
  by_cases early : ∃ handle, request.lookupDemand left.store (some worker) = some handle ∧ bodyLabels.length < 8
  · obtain ⟨handle, demand, short⟩ := early
    exact .inr (cutGiveDemandedRead request worker entered leftAt rightAt site paths entryWriters run paired embedder handle demand (.inl short))
  have lookupMismatch (handle : BitVec IntType.i32.width)
      (demand : request.lookupDemand left.store (some worker) = some handle)
      (different : Stored.Endpoints.Core.childFromHistory left.host.writer.accepted handle ≠
        Stored.Endpoints.Core.childFromHistory right.host.writer.accepted handle) :
      CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
    exact .inr (cutGiveDemandedRead request worker entered leftAt rightAt site paths entryWriters run paired embedder handle demand (.inr different))
  rcases request.result left (some worker) with ⟨reason, trapped⟩ | ⟨verdict, selected⟩
  · exact .inr (cutGiveDangling request worker entered leftAt rightAt site.data.1 paths entryWriters run paired embedder trapped)
  cases verdict with
  | ok root =>
    have admitted := request.admitted left (some worker) selected
    by_cases reads : ∀ handle, request.lookupDemand left.store (some worker) = some handle →
      Stored.Endpoints.Core.childFromHistory left.host.writer.accepted handle =
        Stored.Endpoints.Core.childFromHistory right.host.writer.accepted handle
    · have sameStore := site.data.1
      let checkCursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, .prog resume :: frames, rest⟩
      let canonCursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, .prog resume :: peerFrames, peerRest⟩
      have checkedBody := leftAt
      have canonicalBody := rightAt
      rw [(request.body_split (ready := ready) (base := base) left.store (some worker) base embedder).1] at checkedBody
      rw [(request.body_split (ready := ready) (base := base) right.store (some worker) base embedder).2] at canonicalBody
      let checkNext := fun verdict => request.checkedContinuation left.store (some worker) (left.host.nextTicket, verdict)
      let canonNext := request.canonicalContinuation right.store (some worker)
      let leftEntered := { left with
        host := left.host.enter request.name request.kind request.args
        ctl := checkCursor.control (request.program >>= checkNext) }
      have journal : FramedQuietPath profile ready (specDispatch ready base) checkCursor left [id, id] leftEntered :=
        checkedSelectorJournalPath request checkCursor checkedBody
      obtain ⟨canonCount, checked, canonical⟩ := commonSelectorPaths (profile := profile) (ready := ready) (base := base)
        (start := leftEntered) (incoming := right)
        request (some worker) left.host checkNext canonNext rfl canonicalBody sameStore selected
        (fun handle wanted => ⟨rfl, reads handle wanted⟩)
      let checkCount := 2 + canonCount
      have checkedPath : FramedQuietPath profile ready (specDispatch ready base) checkCursor left (List.replicate checkCount id)
          { leftEntered with ctl := checkCursor.control (checkNext (.ok root)) } := by
        rw [List.replicate_add]
        exact journal.append checked
      have leftPath (place : Location) : Prefix profile ready (specDispatch ready base) left place
          (List.replicate checkCount .tau) { leftEntered with ctl := checkCursor.control (checkNext (.ok root)) } place := by
        simpa only [List.length_replicate] using checkedPath.1.track place
      have rightPath (place : Location) : Prefix profile ready (specDispatch ready (LiveDispatch.host bindings base)) right place
          (List.replicate canonCount .tau) { right with ctl := canonCursor.control (canonNext (.ok root)) } place := by
        simpa only [List.length_replicate] using canonical.1.track place
      rcases splitSilent (count := checkCount) (leftPath (.active 0 0)).toTrail.steps run with ⟨remaining, split, residual⟩ | short
      · have moved := retainComparedOccurrences paths (fun place => ⟨leftPath place, rightPath place⟩)
        have selectedWriters := entryWriters.append (.framed
          (by simpa only [List.length_replicate] using checkedPath.2)
          (by simpa only [List.length_replicate] using canonical.2))
        have seen (count : Nat) : PayloadPrefix.visible ([.tau, .tau, .tau] ++ List.replicate count .tau : Trace grow sig) = [] := by
          rw [visibleAppend, visibleTaus]
          rfl
        have used : .tau :: labels = ([.tau, .tau, .tau] ++ List.replicate checkCount .tau) ++ remaining := by
          rw [entered]
          change [.tau, .tau, .tau] ++ bodyLabels = _
          exact (congrArg ([.tau, .tau, .tau] ++ ·) split).trans (List.append_assoc ..).symm
        let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, frames, rest⟩
        let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, peerFrames, peerRest⟩
        let checkedEntry := { left with
          host := left.host.enter request.name request.kind request.args
          ctl := { check with frames := .prog resume :: check.frames }.control
            (request.checkedContinuation left.store (some worker) (left.host.nextTicket, .ok root)) }
        let canonicalEntry := { right with
          ctl := { canon with frames := .prog resume :: canon.frames }.control
            (request.canonicalContinuation right.store (some worker) (.ok root)) }
        have selectedSite : PairedComponentSite older checkedEntry canonicalEntry { check with frames := .prog resume :: check.frames }
            { canon with frames := .prog resume :: canon.frames } := by
          simpa only [PairedComponentSite, HostFrame.Related.Paired, HostFrame.replace, checkedEntry, canonicalEntry, check, canon] using site
        have pending : canonicalEntry.ctl = { canon with frames := .prog resume :: canon.frames }.control
            (referenceTail request.inst request.destination request.schema (.ok root) >>= fun reply => pure (.flat reply)) := by
          have leaves := sameStore ▸ admitted.unconfined
          simp only [canonicalEntry, GiveSelector.canonicalContinuation, leaves, ite_true]
        have terminal :=
          CallbackSliceEnd.directGiveSelected (resume := resume) (check := check) (canon := canon)
            (left := checkedEntry) (right := canonicalEntry)
            (ticket := left.host.nextTicket) request root
            ⟨(seen checkCount).trans (seen canonCount).symm, sameStore, moved, residual, selectedWriters⟩
            ⟨admitted.caller, admitted.mayLeave, admitted.unconfined, admitted.destination, admitted.selectedRoute⟩
            selectedSite rfl pending
        cases checked : request.preflight (grow := grow) root with
        | ok compiled =>
          obtain ⟨field, plan⟩ := compiled
          have body := congrArg (PayloadPrefix.Cursor.mk (some worker) (.prog resume :: frames) rest).control
            (request.compiler_accepted left.store (some worker) left.host.nextTicket root admitted.unconfined checked)
          have prep := cutDirectGivePreparation (start := checkedEntry) (incoming := canonicalEntry) (check := check) (resume := resume)
            request left.host.nextTicket root field plan admitted.destination sameStore body residual
          have stopped := callbackTerminalSlice paired (terminal (.inl ⟨field, plan, checked, body, prep⟩))
          have total : labels = ([.tau, .tau] ++ List.replicate checkCount .tau) ++ remaining := by
            rw [entered, split, List.append_assoc]
          exact crossPreparedDirectGive request left.host.nextTicket root field plan total moved selectedWriters
            ((seen canonCount).trans (seen checkCount).symm) install paired selectedSite checked admitted.destination pending prep
            embedder compare (used.symm ▸ stopped)
        | error issue =>
          have reply := congrArg (PayloadPrefix.Cursor.mk (some worker) (.prog resume :: frames) rest).control
            (request.compiler_refused left.store (some worker) left.host.nextTicket root checked)
          exact .inr (used.symm ▸ callbackTerminalSlice paired
            (terminal (.inr ⟨issue, checked,
              cutCheckedProgramReply (start := checkedEntry) (check := check) (resume := resume) _ reply residual⟩)))
      · have total : .tau :: labels = [.tau, .tau, .tau] ++ bodyLabels := by rw [entered]; rfl
        exact .inr (cutGiveQuietPrefix total paths entryWriters paired journal checked canonical sameStore rfl run
          (by dsimp [checkCount] at short; omega))
    · push Not at reads
      obtain ⟨handle, demand, different⟩ := reads
      exact lookupMismatch handle demand different
  | error issue =>
    by_cases reads : ∀ handle, request.lookupDemand left.store (some worker) = some handle →
      Stored.Endpoints.Core.childFromHistory left.host.writer.accepted handle =
        Stored.Endpoints.Core.childFromHistory right.host.writer.accepted handle
    · rcases cutGiveCommonRefusal request (some worker) entered leftAt rightAt site paths entryWriters run paired embedder selected reads with
        cut | ⟨used, _, _, _, _, split, moved, writers, seen, replySite, checked, canonical, residual⟩
      · exact .inr cut
      exact crossDirectGiveRefusal (after := ⟨some worker, frames, rest⟩) (canon := ⟨some worker, peerFrames, peerRest⟩)
        split moved writers seen paired replySite checked canonical residual
    · push Not at reads
      obtain ⟨handle, demand, different⟩ := reads
      exact lookupMismatch handle demand different

open ReturnFrame.Occurrence in
private theorem cutShortGivePrelude (name : String) (kind : V1.FuncType) (args : List FlatValue)
    {left right : Config (core3 grow) (HostState sig)}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    (checkedFocus : left.ctl = check.control (specDispatch ready base (.hostCallout (.embedder name kind) args)))
    (canonicalFocus : right.ctl = canon.control
      (specDispatch ready (LiveDispatch.host bindings base) (.hostCallout (.embedder name kind) args)))
    (installed : OccurrenceTransport profile ready base bindings start incoming [.tau] [.tau] left right [some (.active 0 0)])
    (installWriters : VisitorWriterPath profile ready base bindings start incoming [.tau] [.tau] left right)
    (paired : HostFrame.Related.Paired older start incoming)
    (early : ComponentEarlyPrefix profile ready base bindings older check canon left right labels finish 2)
    (actual : Steps profile ready (specDispatch ready base) left labels finish) :
    CallbackSlice profile ready base bindings older start incoming (.tau :: labels) finish := by
  obtain ⟨short, peer, compared, endpoint, _, _⟩ := early
  have checked := directGivePreludePath (profile := profile) (ready := ready) base name kind args check checkedFocus
  have canonical := directGivePreludePath (profile := profile) (ready := ready) (LiveDispatch.host bindings base)
    name kind args canon canonicalFocus
  have peerRun := (compared.choose_spec.1 none).2.steps
  obtain ⟨_, leftPath⟩ := quietCheckedShort checked.1 actual short
  obtain ⟨_, rightPath⟩ := quietCheckedShort canonical.1 peerRun short
  have moved := retainComparedOccurrences installed (fun place => ⟨leftPath place, rightPath place⟩)
  have writers := installWriters.append (.framed (takeQuietWriterPath checked.2 actual (Nat.le_of_lt short))
    (takeQuietWriterPath canonical.2 peerRun (Nat.le_of_lt short)))
  exact callbackTerminalSlice paired (.directGiveFinite (right := peer) ⟨rfl, endpoint.data.1, moved, .refl _, writers⟩)

open ReturnFrame.Occurrence in
private theorem cutCoreGiveSelectorBoundary (request : CoreGiveRequest bindings start)
    {label : Label (core3 grow) (HostState sig)} {next : Config (core3 grow) (HostState sig)}
    (install : GiveInstall bindings (specDispatch ready base) start label next)
    (actual : Steps profile ready (specDispatch ready base) next labels finish)
    (paired : HostFrame.Related.Paired older start incoming)
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (boundary : ((∃ reason, Plain.callerInstance start.store request.thread = .error (.trapped reason)) ∨
      (∃ handle, request.lookupDemand = some handle ∧
        (labels.length < 10 ∨ Stored.Endpoints.Core.childFromHistory start.host.writer.accepted handle ≠
          Stored.Endpoints.Core.childFromHistory incoming.host.writer.accepted handle))) ∨
      ∃ issue, Plain.runBody request.selectionProgram start.store start.host (some request.thread) =
          (start.store, start.host, .ok (.error issue)) ∧
        (∀ handle, request.lookupDemand = some handle →
          Stored.Endpoints.Core.childFromHistory start.host.writer.accepted handle =
            Stored.Endpoints.Core.childFromHistory incoming.host.writer.accepted handle) ∧
        ShorterCallbackSlices profile ready base bindings (label :: labels).length) :
    CallbackSlice profile ready base bindings older start incoming (label :: labels) finish := by
  obtain ⟨peerFrames, peerRest, rfl, rfl, site, paths, _, _⟩ := cutSharedCalloutInstall
    (.embedder request.name request.kind) request.args request.focused request.calling install.step paired
  let caller : Seg (core3 grow) (HostState sig) := .core request.core request.next
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨request.thread, caller :: request.frames, request.rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨request.thread, caller :: peerFrames, peerRest⟩
  have installWriters := frameGiveInstall paths rfl rfl
  have prelude := cutDirectGivePrelude request.name request.kind request.args request.destination request.schema request.inst
    request.linked embedder (check := check) (canon := canon) rfl rfl site paths installWriters actual
  rcases prelude with early |
      ⟨_, left, right, entered, leftHost, rightHost, leftStore, _, leftAt, rightAt, bodySite, bodyPaths, bodyWriters, bodyRun, _⟩
  · exact cutShortGivePrelude request.name request.kind request.args rfl rfl paths installWriters paired early actual
  · rcases boundary with two | ⟨issue, refused, reads, compare⟩
    swap
    · have refusal : Plain.runBody request.selector.program left.store left.host (some request.thread) =
          (left.store, left.host, .ok (.error issue)) := by
        rw [leftStore, leftHost]
        exact refused
      have agree : ∀ handle, request.selector.lookupDemand left.store request.thread = some handle →
          Stored.Endpoints.Core.childFromHistory left.host.writer.accepted handle =
          Stored.Endpoints.Core.childFromHistory right.host.writer.accepted handle := by
        intro handle wanted
        rw [leftStore] at wanted
        simpa only [leftHost, rightHost] using reads handle wanted
      rcases cutGiveCommonRefusal (left := left) (right := right) request.selector request.thread entered
          leftAt rightAt bodySite bodyPaths bodyWriters bodyRun paired embedder refusal agree with
          cut | ⟨used, live, trailing, reached, peer, split, moved, writers, observed, replySite, leftReply, rightReply, remainder⟩
      · exact cut
      rcases cutWaitableCorePop (bindings := bindings) (core := request.core) (resume := request.next)
          leftReply rightReply replySite remainder with ⟨empty, rfl⟩ | popped
      · rw [split, empty, List.append_nil]
        exact callbackTerminalSlice paired (.directGiveFinite (right := peer)
          ⟨observed.symm, replySite.data.1, moved, .refl _, writers⟩)
      obtain ⟨suffix, popped, residual, after, pop, lost⟩ := popped
      obtain ⟨move, whole, tracks⟩ := CallbackPrefix.transportAppend moved pop
      have gone : move (some (.active 0 0)) = none := by
        have occurrence := (tracks (some (.active 0 0))).1
        generalize move (some (.active 0 0)) = target at occurrence ⊢
        cases occurrence with
        | step _ tail =>
          have edit : transitionEdit reached (.tau : Label (core3 grow) (HostState sig)) = .pop := by
            rw [transitionEdit, leftReply]; rfl
          rw [edit] at tail
          cases tail
          rfl
      have eraseLost {lhs rhs} (run : OccurrenceTransport profile ready base bindings start incoming
          ((.tau :: used) ++ [.tau]) (live ++ [.tau]) lhs rhs [none]) :
          OccurrenceTransport profile ready base bindings start incoming ((.tau :: used) ++ [.tau]) (live ++ [.tau]) lhs rhs := by
        simpa only [OccurrenceTransport, List.cons_append, List.nil_append, outsideMarks_drop_lost] using run
      simp only [List.nil_append, List.map_cons, List.map_nil, gone] at whole
      have joined := eraseLost whole
      have full : .tau :: labels = ((.tau :: used) ++ [.tau]) ++ suffix := by rw [split, popped, List.append_assoc]; rfl
      have seen : PayloadPrefix.visible (live ++ [.tau]) = PayloadPrefix.visible ((.tau :: used) ++ [.tau]) := by
        rw [visibleAppend, visibleAppend, observed]
      have replyWriters := VisitorWriterPath.framed (profile := profile) (ready := ready) (base := base) (bindings := bindings)
        (.same (.popCore leftReply) rfl (.done _)) (.same (.popCore rightReply) rfl (.done _))
      rcases classifyReachedGrowth (CallbackPrefix.transportPaths joined none).choose_spec.1.steps with growing | uncertified
      · have smaller : suffix.length < (.tau :: labels).length := by
          rw [full]
          simp only [List.length_append, List.length_cons, List.length_nil]
          omega
        obtain ⟨checked, canonical, restLabels, final, other, divided, run, ending⟩ := compare smaller residual after
        have prefixRun : ExecutedCallbackSegment profile ready base bindings older start incoming _ _ _ _ :=
          ⟨growing, seen, after, joined, writers.append replyWriters⟩
        exact ⟨_, _, restLabels, final, other, by rw [full, divided]; simp only [List.append_assoc],
          CallbackPrefix.appendExecutedCallbacks prefixRun run, ending⟩
      · rw [full]
        exact callbackTerminalSlice paired (.nonGrowing uncertified after joined (writers.append replyWriters) residual)
    cases thread : request.thread with
    | none => simp [CoreGiveRequest.lookupDemand, giveLookupDemand, Plain.callerInstance, thread] at two
    | some worker =>
      rcases two with ⟨reason, dangling⟩ | ⟨handle, demand, lookup⟩
      · have cause : Plain.callerInstance left.store (some worker) = .error (.trapped reason) := by
          simpa only [leftStore, thread] using dangling
        exact cutGiveDangling (left := left) (right := right) request.selector worker entered
          (by simpa only [check, thread, CoreGiveRequest.selector] using leftAt)
          (by simpa only [canon, thread, CoreGiveRequest.selector] using rightAt)
          bodySite.data.1 bodyPaths bodyWriters bodyRun paired embedder cause
      · have wanted : request.selector.lookupDemand left.store (some worker) = some handle := by
          rw [leftStore]
          change giveLookupDemand start.store (some worker) request.inst request.destination request.schema request.args = _
          simpa only [CoreGiveRequest.lookupDemand, thread] using demand
        refine cutGiveDemandedRead request.selector worker entered
          (by simpa only [check, thread, CoreGiveRequest.selector] using leftAt)
          (by simpa only [canon, thread, CoreGiveRequest.selector] using rightAt)
          (by simpa only [check, canon, thread] using bodySite) bodyPaths bodyWriters bodyRun paired embedder handle wanted
          ?_
        rcases lookup with short | different
        · left
          rw [entered, List.length_append] at short
          simp only [List.length_cons, List.length_nil] at short
          omega
        · right
          simpa only [leftHost, rightHost] using different

private theorem shortParkedGive (request : CoreGiveRequest bindings start) {handle label next}
    (demand : request.lookupDemand = some handle)
    (install : GiveInstall bindings (specDispatch ready base) start label next)
    (run : Steps profile ready (specDispatch ready base) start labels finish) (short : labels.length < 11)
    (paired : HostFrame.Related.Paired older start incoming)
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder) :
    CallbackSlice profile ready base bindings older start incoming labels finish := by
  have silent : label = .tau := by cases install <;> rfl
  subst label
  cases run with
  | refl => exact callbackTerminalSlice paired .exhausted
  | cons first tail =>
    obtain ⟨rfl, rfl⟩ := silentStepUnique install.step first
    exact cutCoreGiveSelectorBoundary request install tail paired embedder
      (.inl (.inr ⟨handle, demand, .inl (by simp only [List.length_cons] at short; omega)⟩))

open PayloadPrefix ReturnFrame.Occurrence in
private theorem parkedAdmissionInterior {route : GiveEffectRoute} (site : PayloadRoot.Site grow sig route)
    (linked : site.Linked bindings) {label nextCfg planned waiting wanted}
    (install : GiveInstall bindings (specDispatch ready base) site.start label nextCfg)
    (prepared : site.PreparedEntry profile ready base planned)
    (run : Steps profile ready (specDispatch ready base) site.start labels finish)
    (nonempty : waiting ≠ []) (pending : Steps profile ready (specDispatch ready base) finish waiting wanted)
    (paired : HostFrame.Related.Paired older site.start incoming)
    (selected : Stored.Endpoints.Core.childFromHistory incoming.host.writer.accepted site.handle = some site.tree)
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder) :
    CallbackSlice profile ready base bindings older site.start incoming labels finish := by
  obtain ⟨front, next, _, _, entry⟩ := prepared
  cases alignLocalBody entry.entry.steps run (noBranchOfVisible entry.quiet (by simp)) with
  | @inside remaining divided later _ =>
    have length : labels.length < 11 := by
      have count := congrArg List.length divided
      have positive : 0 < remaining.length := List.length_pos_iff.mpr later
      simp only [entry.length, List.length_append] at count
      omega
    let schema := match route with | .memory _ => none | .flat type => some type
    have resolved : resolveBinding bindings site.name site.functionType = .ok ⟨site.name, site.inst,
        schema.elim (.givePayload site.destination) (.giveFlat site.destination)⟩ := by
      cases route <;> exact linked.linked
    let request : CoreGiveRequest bindings site.start :=
      ⟨site.name, site.functionType, route.args site.handle, site.inst, site.destination, schema, site.thread,
        site.core, site.resume, site.frames, site.rest, linked.parked, linked.calling, resolved⟩
    have selection : request.Selected route :=
      ⟨site.handle, site.tree, rfl, linked.linked, linked.caller, linked.mayLeave,
        linked.destination, linked.selected, linked.admitted⟩
    exact shortParkedGive request selection.lookup_demand install run length paired embedder
  | reached split residual =>
    obtain ⟨raw, peer, quiet, canonical, related, _, storage, writer⟩ :=
      LiveDispatch.entry_paired_framed_storage (profile := profile) (ready := ready) (base := base) site linked paired selected
    have frame := WriterPaths.ofHostFrames writer
    have finishAt {body used rest} (split : labels = used ++ rest)
        (paths : site.EntryPrefix profile ready base used (site.withBody body)) (silent : visible used = [])
        (writers : VisitorWriterPath profile ready base bindings site.start incoming used raw (site.withBody body) peer)
        (residual : Steps profile ready (specDispatch ready base) (site.withBody body) rest finish) :
        CallbackSlice profile ready base bindings older site.start incoming labels finish :=
      split.symm ▸ callbackTerminalSlice paired (.body (marks := []) install
        (parkedEntryCut site linked paths canonical storage (silent.trans (silentVisible quiet).symm) related.data.1 writers residual)
        (.localPrefix nonempty pending))
    obtain ⟨get, read⟩ := parkedPrepareSteps site entry
    rcases inspectReplyStep residual with ⟨rfl, rfl⟩ | ⟨_, _, _, rfl, first, remaining⟩
    · exact finishAt split entry.entry entry.quiet (.framed (WriterPaths.ofHostFrames entry.framed) frame) (.refl _)
    · have getter : Step profile ready (specDispatch ready base) site.entered .tau (site.prepareReader next) := .get entry.getFocus
      obtain ⟨rfl, rfl⟩ := silentStepUnique getter first
      have intoRead : site.EntryPrefix profile ready base (front ++ [.tau]) (site.prepareReader next) :=
        fun place => (entry.entry place).append (get (site.entryPlace place))
      rcases inspectReplyStep remaining with ⟨rfl, rfl⟩ | ⟨_, rest, _, rfl, second, tail⟩
      · have framed := WriterPaths.append (WriterPaths.ofHostFrames entry.framed) (.same getter rfl (.done _))
        exact finishAt (by rw [split, List.append_nil]) intoRead (by rw [visibleAppend, entry.quiet]; rfl)
          (.framed framed frame) (.refl _)
      · have reader := parkedPrepareRead (profile := profile) (ready := ready) (base := base) site next
        obtain ⟨rfl, rfl⟩ := silentStepUnique reader second
        have through : site.EntryPrefix profile ready base (front ++ [.tau, .tau]) (site.prepared next) := by
          intro place
          simpa only [List.append_assoc, List.cons_append, List.nil_append] using
            (intoRead place).append (read (site.entryPlace place))
        have reached : labels = (front ++ [.tau, .tau]) ++ rest := by rw [split, List.append_assoc]; rfl
        have silent : visible (front ++ [.tau, .tau]) = [] := by rw [visibleAppend, entry.quiet]; rfl
        have writers := parkedPrepareWriter site entry frame related.data.1
        have beforeWidth := finishAt reached through silent writers tail
        cases verdict : Stored.OwnedMemory.Claims.Record.prepare site.start.store site.entered.host.writer site.field.objects with
        | error => exact beforeWidth
        | ok passed =>
          cases passed
          rcases inspectReplyStep tail with _ | ⟨_, trailing, _, rfl, actual, residual⟩
          · exact beforeWidth
          obtain ⟨width, focus⟩ := entry.widthFocus
          let measured := site.withBody (width site.start.store)
          have widthAt : (site.prepared next).ctl = site.cursor.control (.op .get width) := by
            change site.cursor.control (next (Stored.OwnedMemory.Claims.Record.prepare site.start.store
              site.entered.host.writer site.field.objects)) = _
            rw [verdict, focus]
          have step : Step profile ready (specDispatch ready base) (site.prepared next) .tau measured := .get widthAt
          obtain ⟨rfl, rfl⟩ := silentStepUnique step actual
          have tracks : site.EntryPrefix profile ready base ((front ++ [.tau, .tau]) ++ [.tau]) measured :=
            fun place => (through place).append (Prefix.read_at (site.entryPlace place) widthAt)
          have divided : labels = ((front ++ [.tau, .tau]) ++ [.tau]) ++ trailing :=
            reached.trans (List.append_assoc (front ++ [.tau, .tau]) [.tau] trailing).symm
          exact finishAt divided tracks (by rw [visibleAppend, silent]; rfl)
            (by simpa only [List.append_nil] using writers.append (.framed (.same step rfl (.done _)) (.done peer))) residual

theorem actualMemoryRequest {pointer : FlatValue} (site : PayloadRoot.Site grow sig (.memory pointer))
    (linked : site.Linked bindings) (shape : MemoryVisitShape site.field)
    (paired : HostFrame.Related.Paired older site.start incoming)
    (selected : Stored.Endpoints.Core.childFromHistory incoming.host.writer.accepted site.handle = some site.tree)
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (run : Steps profile ready (specDispatch ready base) site.start labels finish)
    (compare : ShorterCallbackSlices profile ready base bindings labels.length) :
    PayloadRoot.Cut site profile ready bindings (ActualMemoryRequestRun profile ready base bindings older site incoming labels finish) base := by
  cases linkedMemoryResidualBody site linked shape paired selected embedder compare with
  | refused issue quiet entered framed read => exact .refused issue quiet entered framed read
  | placementTrap reason count verdict entered framed read beforeTrap => exact .placementTrap reason count verdict entered framed read beforeTrap
  | @placed entry quiet verdict prepared entered body framed read =>
    refine .placed quiet verdict prepared entered ⟨entry, entered, quiet, ?_⟩ framed read
    cases alignLocalBody (entered (.active 0 0)).toTrail.steps run (noBranchOfVisible quiet (by simp)) with
    | inside split nonempty tail =>
      exact ⟨.inl ⟨_, split, nonempty, tail⟩,
        fun install => parkedAdmissionInterior site linked install read run nonempty tail paired selected embedder⟩
    | @reached residual split tail =>
      obtain ⟨canonEntry, canon, silent, tracks, host, visit⟩ := body
      have bounded : residual.length ≤ labels.length := by rw [split, List.length_append]; omega
      have visited := visit entry entered framed read quiet residual finish tail bounded
      refine ⟨.inr ⟨canonEntry, canon, residual, split, silent, tracks, host, visited⟩, fun install => ?_⟩
      obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, cut⟩ := visited
      exact split ▸ cut install

theorem actualSelectedMemoryRequest {pointer : FlatValue} {request : CoreGiveRequest bindings start}
    (selection : request.Selected (.memory pointer)) {field : Stored.Endpoints.RecordLower.Field} {plan label}
    {next : Config (core3 grow) (HostState sig)}
    (compiled : selection.preflight = .ok (field, plan))
    (install : GiveInstall bindings (specDispatch ready base) start label next)
    (tail : Steps profile ready (specDispatch ready base) next labels finish)
    (paired : HostFrame.Related.Paired older start incoming)
    (selected : Stored.Endpoints.Core.childFromHistory incoming.host.writer.accepted selection.handle = some selection.tree)
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (compare : ShorterCallbackSlices profile ready base bindings (label :: labels).length) :
    ∃ tag payload arity children, selection.tree = .tag ⟨tag, payload⟩ arity children ∧
      let site := selection.site tag payload arity children field
      site.Linked bindings ∧ PayloadRoot.Cut site profile ready bindings
        (ActualMemoryRequestRun profile ready base bindings older site incoming (label :: labels) finish) base := by
  obtain ⟨tag, payload, arity, children, root, linked⟩ := selection.compiler_success compiled
  exact ⟨tag, payload, arity, children, root, linked, actualMemoryRequest _ linked (siteVisitShapes linked).2 paired
    (selected.trans (congrArg some root)) embedder (.cons install.step tail) compare⟩

open PayloadPrefix ReturnFrame.Occurrence in
private theorem compilerRefusedCallback {route : GiveEffectRoute} {request : CoreGiveRequest bindings start}
    (selection : request.Selected route) {issue label next} (refused : selection.preflight = .error issue)
    (install : GiveInstall bindings (specDispatch ready base) start label next)
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (paired : HostFrame.Related.Paired older start incoming)
    (selected : Stored.Endpoints.Core.childFromHistory incoming.host.writer.accepted selection.handle = some selection.tree)
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder) :
    CallbackSlice profile ready base bindings older start incoming labels finish := by
  have reads handle (demand : request.lookupDemand = some handle) :
      Stored.Endpoints.Core.childFromHistory start.host.writer.accepted handle =
        Stored.Endpoints.Core.childFromHistory incoming.host.writer.accepted handle := by
    rw [selection.lookup_demand] at demand
    cases demand
    exact selection.selected.trans selected.symm
  let reply := route.reply request.destination start.host.nextTicket (.error issue)
  let stopped := { start with
    host := start.host.enter request.name request.kind (route.args selection.handle)
    ctl := ⟨request.thread, .prog (do return .flat (← writeCompletion reply)),
      .core request.core request.next :: request.frames⟩ :: request.rest }
  let caller := Seg.core request.core request.next
  obtain ⟨front, quiet, count, checked, framed⟩ := selection.compiler_refusal_entry (profile := profile) (ready := ready) refused base embedder
  cases alignLocalBody (checked (.active 0 0)).toTrail.steps run (noBranchOfVisible (silentVisible quiet) (by simp)) with
  | @inside remaining divided nonempty _ =>
    have length : labels.length < 11 := by
      have lengths := congrArg List.length divided
      have positive : 0 < remaining.length := List.length_pos_iff.mpr nonempty
      simp only [count, List.length_append] at lengths
      omega
    exact shortParkedGive request selection.lookup_demand install run length paired embedder
  | reached split remaining =>
    obtain ⟨_, entered, canonQuiet, canonical, host, pending, storage, canonFramed⟩ := selection.paired_canonical_pending_framed
      (profile := profile) (ready := ready) (base := base) paired reads
    have pushed : segmentStorage stopped = (Edit.push caller).apply (segmentStorage start) := by
      simp only [stopped, caller, request.focused, segmentStorage, Edit.apply, ReturnFrame.Occurrence.front,
        List.map_cons, List.headD_cons, List.tail_cons]
    have paths := CallbackRange.pushedEntryTransport caller checked canonical pushed storage
    have writers := VisitorWriterPath.framed (bindings := bindings) (WriterPaths.ofHostFrames framed) (WriterPaths.ofHostFrames canonFramed)
    have observed := (silentVisible quiet).trans (silentVisible canonQuiet).symm
    have shared : stopped.store = entered.store := pending.data.1
    have popRun : Steps profile ready (specDispatch ready base) stopped [.tau, .tau, .tau] (selection.compilerRefused issue) :=
      Plain.give_completion_steps reply rfl
    rcases splitSilent (count := 3) popRun remaining with ⟨suffix, divided, tail⟩ | short
    · have replicated : front = List.replicate front.length .tau := List.eq_replicate_length.mpr (fun label member => by
        have tau := List.all_eq_true.mp quiet label member
        cases label <;> first | rfl | contradiction)
      have total : labels = List.replicate (front.length + 3) .tau ++ suffix := by
        rw [split, divided, List.replicate_add, ← replicated, List.append_assoc]
      have completed : ∀ place, Trail profile ready (specDispatch ready base) start (some place)
          (List.replicate (front.length + 3) .tau) (selection.compilerRefused issue) (some place) := by
        rw [List.replicate_add, ← replicated]
        intro place
        let pushed := ((Edit.push caller).follow place).getD place
        have popped : (Edit.pop (E := core3 grow) (Host := HostState sig)).follow pushed = some place := by
          cases place with
          | active activation segment => cases activation <;> rfl
          | saved slot segment => rfl
        exact (checked place).toTrail.append
          (popped ▸ Plain.give_completion_trail (start := stopped) reply pushed rfl)
      obtain ⟨written, framed, pop, edit⟩ := Plain.give_completion_write (profile := profile) (ready := ready)
        (dispatch := specDispatch ready base) (start := stopped) reply rfl
      let wrote := { stopped with
        host := stopped.host.record reply.1
        ctl := ⟨request.thread, .prog (.pure (.flat reply.2)), .core request.core request.next :: request.frames⟩ :: request.rest }
      have moved := retainComparedOccurrences paths (fun place => ⟨written place, Prefix.done entered place⟩)
      rw [List.append_nil] at moved
      rw [total]
      refine callbackTerminalSlice paired (.compilerRefused selection install refused completed canonical (silentVisible canonQuiet) pending host tail ?_)
      refine ⟨front ++ [.tau, .tau], .tau :: suffix, wrote, ?_,
        ⟨?_, shared, moved, .cons pop tail, ?_⟩, .executed pop (.inl edit) rfl tail⟩
      · rw [List.replicate_add, ← replicated]
        simp only [List.replicate_succ, List.replicate_zero, List.append_assoc, List.cons_append, List.nil_append]
      · rw [visibleAppend, observed, show PayloadPrefix.visible ([.tau, .tau] : Trace grow sig) = [] from rfl, List.append_nil]
      · simpa only [List.append_nil] using writers.append (.framed (WriterPaths.ofHostFrames framed) (.done entered))
    · rw [split]
      exact callbackTerminalSlice paired (.body (left := stopped) (right := entered) (marks := [])
        (caller := some (.active 0 0)) install ⟨observed, shared, paths, remaining, writers⟩
        (.coreReplyPrefix (some issue) (checkedCoreReplyPrefix reply rfl remaining short)))

open PayloadPrefix ReturnFrame.Occurrence in
private theorem rootRefusedCallback {route : GiveEffectRoute} (site : PayloadRoot.Site grow sig route)
    (linked : site.Linked bindings) {issue checkLeading label next}
    (install : GiveInstall bindings (specDispatch ready base) site.start label next)
    (quiet : PayloadPrefix.visible checkLeading = [])
    (checked : site.EntryPrefix profile ready base checkLeading (site.withBody (site.reply (.error issue))))
    (framed : Plain.HostFramedSteps HostState.writer profile ready (specDispatch ready base) site.start
      checkLeading (site.withBody (site.reply (.error issue))))
    (prepare : site.PreparedEntry profile ready base checkLeading)
    (run : Steps profile ready (specDispatch ready base) site.start labels finish)
    (paired : HostFrame.Related.Paired older site.start incoming)
    (selected : Stored.Endpoints.Core.childFromHistory incoming.host.writer.accepted site.handle = some site.tree)
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder) :
    CallbackSlice profile ready base bindings older site.start incoming labels finish := by
  let reply := route.reply site.destination site.start.host.nextTicket (.error issue)
  let stopped := site.withBody (site.reply (.error issue))
  have completed := Plain.give_completion_steps (profile := profile) (ready := ready) (dispatch := specDispatch ready base)
    (start := stopped) reply rfl
  have frontRun := (checked (.active 0 0)).toTrail.steps
  cases alignLocalBody frontRun run (noBranchOfVisible quiet (by simp)) with
  | inside _ nonempty tail => exact parkedAdmissionInterior site linked install prepare run nonempty tail paired selected embedder
  | reached split residual =>
    obtain ⟨_, entered, canonQuiet, canonical, related, _, storage, canonFramed⟩ := LiveDispatch.entry_paired_framed_storage
      (profile := profile) (ready := ready) (base := base) site linked paired selected
    have body := parkedEntryCut site linked checked canonical storage (quiet.trans (silentVisible canonQuiet).symm)
      related.data.1 (parkedAdmissionWriters site prepare framed canonFramed related.data.1) residual
    rw [split]
    rcases splitSilent (count := 3) completed residual with ⟨suffix, divided, tail⟩ | short
    · refine callbackTerminalSlice paired (.refused (route := route) (destination := site.destination)
        (ticket := site.start.host.nextTicket) (issue := issue) (left := stopped) (right := entered)
        install body.observed.symm body.paths body.writers ?_)
      refine ⟨suffix, _, divided, frontRun, completed, tail, rfl, rfl, Plain.give_completion_framed reply rfl,
        ⟨_, Plain.give_completion_write (start := stopped) reply rfl⟩, fun place => ?_⟩
      cases place with
      | none => exact ⟨none, none, .absent (append frontRun completed), .absent (canonical (.active 0 0)).toTrail.steps⟩
      | some place =>
        exact ⟨_, _, (checked place).toTrail.append (Plain.give_completion_trail (start := stopped) reply (site.entryPlace place) rfl),
          (canonical place).toTrail⟩
    · exact callbackTerminalSlice paired (.body (marks := []) install body
        (.coreReplyPrefix (some issue) (checkedCoreReplyPrefix reply rfl residual short)))

private theorem compiledMemoryCallback {pointer : FlatValue} (site : PayloadRoot.Site grow sig (.memory pointer))
    (linked : site.Linked bindings) {label next}
    (install : GiveInstall bindings (specDispatch ready base) site.start label next)
    (run : Steps profile ready (specDispatch ready base) site.start labels finish)
    (paired : HostFrame.Related.Paired older site.start incoming)
    (chosen : Stored.Endpoints.Core.childFromHistory incoming.host.writer.accepted site.handle = some site.tree)
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (compare : ShorterCallbackSlices profile ready base bindings labels.length) :
    CallbackSlice profile ready base bindings older site.start incoming labels finish := by
  have cut := actualMemoryRequest site linked (siteVisitShapes linked).2 paired chosen embedder run compare
  cases cut with
  | refused issue quiet entered framed read => exact rootRefusedCallback site linked install quiet entered framed read run paired chosen embedder
  | placementTrap reason count verdict entered _ read beforeTrap =>
    have quiet : PayloadPrefix.visible (List.replicate count .tau ++ ([.trap reason] : Trace grow sig)) = [.trap reason] := by
      rw [visibleAppend, visibleTaus]
      rfl
    obtain ⟨_, peer, canonQuiet, canonical, pending, host, storage, framed⟩ := LiveDispatch.entry_paired_framed_storage
      (profile := profile) (ready := ready) (base := base) site linked paired chosen
    have quietPrefix : PayloadPrefix.visible (List.replicate count .tau : Trace grow sig) = [] := visibleTaus count
    have body {trailing : Trace grow sig}
        (remaining : Steps profile ready (specDispatch ready base) (site.withBody (trap reason)) trailing finish) :
        GiveBodyCut profile ready base bindings site.start incoming (site.withBody (trap reason)) peer
          (List.replicate count .tau) _ trailing finish [some (.active 0 0)] :=
      parkedEntryCut site linked beforeTrap.tracks canonical storage (quietPrefix.trans (silentVisible canonQuiet).symm)
        pending.data.1 (parkedAdmissionWriters site beforeTrap.prepared beforeTrap.framed framed pending.data.1) remaining
    cases alignLocalBody (entered (.active 0 0)).steps run (noBranchOfVisible quiet (by simp [workerBranchLabel])) with
    | inside _ nonempty tail =>
      cases alignLocalBody beforeTrap.tracks.steps run (noBranchOfVisible quietPrefix (by simp)) with
      | inside _ _ _ => exact parkedAdmissionInterior site linked install read run nonempty tail paired chosen embedder
      | reached split remaining =>
        exact split.symm ▸ callbackTerminalSlice paired (.body (marks := []) install (body remaining) (.localPrefix nonempty tail))
    | reached split tail =>
      rw [split]
      have steps := append (entered (.active 0 0)).steps tail
      have remaining := stripExactPrefix (trailing := .trap reason :: _) beforeTrap.tracks.steps
        (by simpa only [List.append_assoc, List.cons_append, List.nil_append] using steps)
      have fault : Step profile ready (specDispatch ready base) (site.withBody (trap reason)) (.trap reason)
          (StepDefs.trapCfg site.checked) := .trap rfl
      exact callbackTerminalSlice paired (.placementTrap site install verdict entered canonical (silentVisible canonQuiet)
        pending host tail ⟨_, _, _, List.append_assoc .., body remaining, .executed fault (.inr rfl) rfl tail⟩)
  | placed _ _ _ _ body _ _ =>
    obtain ⟨_, _, _, _, compare⟩ := body
    exact compare install

open ABI PayloadPrefix ReturnFrame.Occurrence Stored.Endpoints.RecordLower Stored.OwnedMemory.Claims in
private theorem driveFlatGiveBody {schema : Stored.TypeOf} (site : PayloadRoot.Site grow sig (.flat schema))
    (linked : site.Linked bindings) (shape : FlatVisitShape site.field)
    (paired : HostFrame.Related.Paired older site.start incoming)
    (selected : Stored.Endpoints.Core.childFromHistory incoming.host.writer.accepted site.handle = some site.tree)
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (fits : Stored.Lower.fits Quirks.none site.destination.encoding site.destination.width (sig.payload site.tag) site.payload.val.value = true)
    {label next} (install : GiveInstall bindings (specDispatch ready base) site.start label next)
    {checkEntry actual : Trace grow sig} {budget : Nat}
    (entered : site.EntryPrefix profile ready base checkEntry site.checked)
    (checkFramed : Plain.HostFramedSteps HostState.writer profile ready (specDispatch ready base) site.start checkEntry site.checked)
    (prepare : site.PreparedEntry profile ready base checkEntry)
    (silent : visible checkEntry = [])
    (run : Steps profile ready (specDispatch ready base) site.checked actual finish) (bounded : actual.length ≤ budget)
    (compare : ShorterCallbackSlices profile ready base bindings budget) :
    CallbackSlice profile ready base bindings older site.start incoming (checkEntry ++ actual) finish := by
  obtain ⟨plan, compiled⟩ := linked.compiled
  have matched := Record.preflightValue_layout _ _ _ _ _ plan compiled
  have fit := Record.preflightValue_value _ _ _ _ _ plan compiled ▸ fits
  have width := site.destination.check_width site.start.store linked.destination
  obtain ⟨entry, peerEntry, quiet, installed, related, _, storage, canonFramed⟩ :=
    LiveDispatch.entry_paired_framed_storage (profile := profile) (ready := ready) (base := base) site linked paired selected
  obtain ⟨peer, frame, canonAt⟩ := CallbackRange.referenceFrame site (site.reference_at linked site.referenceReply) related
  obtain ⟨checked, canonical, trailing, left, right, marks, split, seen, storePaths, store, residual, writers, endpoint⟩ :=
    driveCompiledFlat (origin := site.checked.store) site.destination site.inst shape matched fit
      (CallbackRange.preflightAllocator site linked) (.self _) embedder width compare
      0 site.reply site.referenceReply site.checked peerEntry site.cursor peer frame (Core3.Grows.refl _) rfl canonAt actual finish run bounded
  obtain ⟨move, paths, outside⟩ := storePaths
  obtain ⟨atEntry, track, frameEntry⟩ := CallbackRange.publicEntryTransport site linked entered installed storage
  have entryWriters : VisitorWriterPath profile ready base bindings site.start incoming checkEntry entry site.checked peerEntry :=
    parkedAdmissionWriters site prepare checkFramed canonFramed frame.store
  let caller := move (some (.active 0 0))
  have leading (place : Option Location) :
      Trail profile ready (specDispatch ready base) site.start place (checkEntry ++ checked) left (move (atEntry place)) ∧
      Trail profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming place
        (entry ++ canonical) right (move (atEntry place)) :=
    ⟨(track place).1.append (paths (atEntry place)).1, (track place).2.append (paths (atEntry place)).2⟩
  have rebased : OccurrenceTransport profile ready base bindings site.start incoming
      (checkEntry ++ checked) (entry ++ canonical) left right (marks ++ [caller]) := by
    refine ⟨move ∘ atEntry, leading, fun changes retained prior => ?_⟩
    simpa only [List.append_assoc, List.map_append, List.map_cons, List.map_map, List.map_nil, caller]
      using outside changes _ (frameEntry changes retained prior)
  have observed : visible (checkEntry ++ checked) = visible (entry ++ canonical) := by
    rw [visibleAppend, visibleAppend, silent, silentVisible quiet, seen]
  have total : checkEntry ++ actual = (checkEntry ++ checked) ++ trailing := by rw [split, List.append_assoc]
  have cut : GiveBodyCut profile ready base bindings site.start incoming left right (checkEntry ++ checked)
      (entry ++ canonical) trailing finish (marks ++ [caller]) := ⟨observed, store, rebased, residual, .append entryWriters writers⟩
  have stop (why : GiveBodyStop profile ready base left right trailing finish caller) :
      CallbackSlice profile ready base bindings older site.start incoming (checkEntry ++ actual) finish :=
    total ▸ callbackTerminalSlice paired (.body install cut why)
  cases endpoint with
  | trap lhs rhs => exact stop (.trap lhs rhs)
  | localPrefix nonempty tail => exact stop (.localPrefix nonempty tail)
  | localChoice divided choice shared step tail => exact stop (.localChoice divided choice shared step tail)
  | installPrefix exhausted => exact stop (.allocatorInstall exhausted)
  | collectionInstall exhausted => exact stop (.allocatorInstall exhausted)
  | collectionRange nonempty tail => exact stop (.localPrefix nonempty tail)
  | callback tracked aligned ending notPopped =>
    rw [total]
    exact callbackTerminalSlice paired (.allocator install cut tracked aligned ending notPopped)
  | @descriptor pointer check canon arrived =>
    by_cases active : caller = some (.active 0 0)
    · have marked := (paths (some (.active 0 0))).1
      change move (some (.active 0 0)) = some (.active 0 0) at active
      rw [active] at marked
      obtain ⟨_, equal, original⟩ := marked.survives
      cases equal
      cases arrived with
      | returned words returned _ checkAt canonAt =>
        rw [List.nil_append, show caller = some (.active 0 0) from active] at rebased
        rcases consumeGiveCommonReply site words split residual rebased (.append entryWriters writers) original returned checkAt canonAt observed bounded compare with
          short | ⟨suffix, replied, peer, divided, _, tail, _, _, result⟩
        · exact stop (.coreReplyPrefix none short)
        rcases result with ⟨_, compared⟩ | ⟨update, aligned, trails, flow⟩
        · exact compared
        · rw [total, divided, ← List.append_assoc]
          exact callbackTerminalSlice paired (.nonGrowing update aligned trails flow tail)
      | refused issue checkAt =>
        obtain ⟨segments, frames⟩ := site.reached_caller checkAt original
        let reply := (GiveEffectRoute.flat schema).reply site.destination site.start.host.nextTicket (.error issue)
        have atReply : left.ctl = ⟨check.thread, .prog (do return .flat (← writeCompletion reply)),
            .core site.core site.resume :: segments⟩ :: check.rest := by
          simpa only [Cursor.control, frames, PayloadRoot.Site.reply, reply] using! checkAt
        have completed := Plain.give_completion_steps (profile := profile) (ready := ready)
          (dispatch := specDispatch ready base) reply atReply
        rcases splitSilent (count := 3) completed residual with ⟨suffix, divided, tail⟩ | short
        · have stopped : CheckedOnlyGiveReply profile ready base bindings (.flat schema) site.destination site.start.host.nextTicket
              issue site.start incoming left right (checkEntry ++ checked) (entry ++ canonical) trailing finish := by
            refine ⟨suffix, _, divided, (leading none).1.steps, completed, tail, rfl, rfl,
              Plain.give_completion_framed reply atReply, ⟨_, Plain.give_completion_write reply atReply⟩, fun place => ?_⟩
            obtain ⟨checkedLead, canonicalLead⟩ := leading place
            cases reached : move (atEntry place) with
            | none =>
              rw [reached] at checkedLead canonicalLead
              exact ⟨none, none, checkedLead.append (.absent completed), canonicalLead⟩
            | some prior =>
              rw [reached] at checkedLead canonicalLead
              exact ⟨_, some prior, checkedLead.append (Plain.give_completion_trail reply prior atReply), canonicalLead⟩
          rw [total]
          exact callbackTerminalSlice paired (.refused install observed.symm rebased (.append entryWriters writers) stopped)
        · exact stop (.coreReplyPrefix (some issue) (checkedCoreReplyPrefix reply atReply residual short))
    · cases arrived with
      | returned => exact stop (.callerNotTop none active)
      | refused issue _ => exact stop (.callerNotTop (some issue) active)

private theorem compiledFlatCallback {schema : Stored.TypeOf} (site : PayloadRoot.Site grow sig (.flat schema))
    (linked : site.Linked bindings) {label next}
    (install : GiveInstall bindings (specDispatch ready base) site.start label next)
    (run : Steps profile ready (specDispatch ready base) site.start labels finish)
    (paired : HostFrame.Related.Paired older site.start incoming)
    (chosen : Stored.Endpoints.Core.childFromHistory incoming.host.writer.accepted site.handle = some site.tree)
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (compare : ShorterCallbackSlices profile ready base bindings labels.length) :
    CallbackSlice profile ready base bindings older site.start incoming labels finish := by
  have cut := site.parked_after_admission (profile := profile) (ready := ready) linked
    (Stored.Lower.fits Quirks.none site.destination.encoding site.destination.width (sig.payload site.tag) site.payload.val.value = true)
    (fun fits _ _ => fits) base embedder
  cases cut with
  | refused issue quiet entered framed read => exact rootRefusedCallback site linked install quiet entered framed read run paired chosen embedder
  | placementTrap _ _ verdict _ _ _ _ => cases verdict
  | @placed entry quiet verdict prepared entered fits framed read =>
    cases alignLocalBody (entered (.active 0 0)).toTrail.steps run (noBranchOfVisible quiet (by simp)) with
    | inside _ nonempty tail => exact parkedAdmissionInterior site linked install read run nonempty tail paired chosen embedder
    | @reached remaining split tail =>
      have bounded : remaining.length ≤ labels.length := by rw [split, List.length_append]; omega
      exact split ▸ driveFlatGiveBody site linked (siteVisitShapes linked).1 paired chosen embedder fits install entered framed read quiet tail bounded compare

private theorem actualSelectedCallback {route : GiveEffectRoute} {request : CoreGiveRequest bindings start}
    (selection : request.Selected route) {label next}
    (install : GiveInstall bindings (specDispatch ready base) start label next)
    (tail : Steps profile ready (specDispatch ready base) next labels finish)
    (paired : HostFrame.Related.Paired older start incoming)
    (selected : Stored.Endpoints.Core.childFromHistory incoming.host.writer.accepted selection.handle = some selection.tree)
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (compare : ShorterCallbackSlices profile ready base bindings (label :: labels).length) :
    ActualSelectedGive profile ready base selection older incoming (label :: labels) finish := by
  have run := Steps.cons install.step tail
  cases compiled : selection.preflight with
  | error issue =>
    exact ⟨.inl ⟨issue, compiled⟩, compilerRefusedCallback selection compiled install run paired selected embedder⟩
  | ok result =>
    obtain ⟨field, plan⟩ := result
    obtain ⟨tag, payload, arity, children, root, linked⟩ := selection.compiler_success compiled
    let site := selection.site tag payload arity children field
    have chosen : Stored.Endpoints.Core.childFromHistory incoming.host.writer.accepted site.handle = some site.tree :=
      selected.trans (congrArg some root)
    refine ⟨.inr ⟨tag, payload, arity, children, field, plan, compiled, root, linked⟩, ?_⟩
    cases route with
    | memory pointer => exact compiledMemoryCallback _ linked install run paired chosen embedder compare
    | flat schema => exact compiledFlatCallback _ linked install run paired chosen embedder compare

theorem actualSelectedMemoryCallback {pointer : FlatValue} {request : CoreGiveRequest bindings start}
    (selection : request.Selected (.memory pointer)) {label next}
    (install : GiveInstall bindings (specDispatch ready base) start label next)
    (tail : Steps profile ready (specDispatch ready base) next labels finish)
    (paired : HostFrame.Related.Paired older start incoming)
    (selected : Stored.Endpoints.Core.childFromHistory incoming.host.writer.accepted selection.handle = some selection.tree)
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (compare : ShorterCallbackSlices profile ready base bindings (label :: labels).length) :
    CallbackSlice profile ready base bindings older start incoming (label :: labels) finish :=
  (actualSelectedCallback selection install tail paired selected embedder compare).callback

private theorem classifiedGiveCrossing
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder) :
    CallbackGiveCrossing profile ready base bindings := by
  classical
  intro changes checked canonical next finish label trailing install actual paired compare
  rcases install.request with ⟨⟨request⟩⟩ | direct
  · apply Or.inr
    by_cases early : ∃ handle, request.lookupDemand = some handle ∧ trailing.length < 10
    · obtain ⟨handle, demand, short⟩ := early
      exact cutCoreGiveSelectorBoundary request install actual paired embedder (.inl (.inr ⟨handle, demand, .inl short⟩))
    by_cases reads : ∀ handle, request.lookupDemand = some handle →
        Stored.Endpoints.Core.childFromHistory checked.host.writer.accepted handle =
          Stored.Endpoints.Core.childFromHistory canonical.host.writer.accepted handle
    · rcases request.selector_result with ⟨reason, trap⟩ | ⟨verdict, evaluated⟩
      · exact cutCoreGiveSelectorBoundary request install actual paired embedder (.inl (.inl ⟨reason, trap⟩))
      · cases verdict with
        | error issue => exact cutCoreGiveSelectorBoundary request install actual paired embedder (.inr ⟨issue, evaluated, reads, compare⟩)
        | ok result =>
          obtain ⟨route, ⟨selection⟩⟩ := request.selected_of_return evaluated
          have selected := (reads selection.handle selection.lookup_demand).symm.trans selection.selected
          exact (actualSelectedCallback selection install actual paired selected embedder compare).callback
    · push Not at reads
      obtain ⟨handle, demand, different⟩ := reads
      exact cutCoreGiveSelectorBoundary request install actual paired embedder (.inl (.inr ⟨handle, demand, .inr different⟩))
  · obtain ⟨name, kind, args, thread, resume, frames, rest, inst, destination, schema, focused, linked⟩ := direct
    obtain ⟨peerFrames, peerRest, rfl, rfl, site, paths, _, _, _⟩ :=
      cutProgramCallInstall (bindings := bindings) (.prog (.pure (.cancel .none))) focused install.step paired
    let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, .prog resume :: frames, rest⟩
    let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, .prog resume :: peerFrames, peerRest⟩
    have installWriters := frameGiveInstall paths rfl rfl
    have prelude := cutDirectGivePrelude name kind args destination schema inst linked embedder
      (check := check) (canon := canon) rfl rfl site paths installWriters actual
    rcases prelude with early | ⟨_, body, peerBody, entered, _, _, _, _, bodyAt, peerAt, bodySite, bodyPaths, bodyWriters, bodyRun, _⟩
    · exact .inr (cutShortGivePrelude name kind args rfl rfl paths installWriters paired early actual)
    cases thread with
    | some worker =>
      exact crossActiveDirectGive ⟨name, kind, args, inst, destination, schema, linked⟩ worker install
        entered bodyAt peerAt bodySite bodyPaths bodyWriters bodyRun paired embedder compare
    | none =>
      let request : GiveSelector bindings := ⟨name, kind, args, inst, destination, schema, linked⟩
      have refused : Plain.runBody request.program body.store body.host (some none) = (body.store, body.host, .ok (.error .wrongContext)) := by
        cases schema <;> rfl
      rcases cutGiveCommonRefusal (left := body) (right := peerBody) request none entered bodyAt peerAt bodySite bodyPaths bodyWriters bodyRun
          paired embedder refused (by simp [request, GiveSelector.lookupDemand, giveLookupDemand, Plain.callerInstance]) with
          cut | ⟨_, _, _, _, _, split, moved, writers, seen, replySite, checked, canonical, residual⟩
      · exact .inr cut
      exact crossDirectGiveRefusal (after := ⟨none, frames, rest⟩) (canon := ⟨none, peerFrames, peerRest⟩)
        split moved writers seen paired replySite checked canonical residual

theorem classifyGiveCallbacks
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (paired : HostFrame.Related.Paired older start incoming) :
    CallbackSlice profile ready base bindings older start incoming labels finish :=
  foldCallbackSlices (classifiedGiveCrossing embedder) run paired

open ReturnFrame.Occurrence in
private theorem markTransport {leading : Trace grow sig} {peer : Config (core3 grow) (HostState sig)}
    (moved : OccurrenceTransport profile ready base bindings start incoming leading leading finish peer) :
    OccurrenceTransport profile ready base bindings start incoming leading leading finish peer [some (.active 0 0)] := by
  obtain ⟨move, paths, retained⟩ := moved
  refine ⟨move, paths, ?_⟩
  intro older marks outside place off first second left right
  exact retained older marks outside place (fun member => off (List.mem_cons_of_mem _ member)) first second left right

open ReturnFrame.Occurrence in
private theorem crossComponentReply {origin reference reached peer : Config (core3 grow) (HostState sig)}
    {used leading suffix : Trace grow sig} {check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    {resume : ReturnFrame.Continuation (core3 grow) (HostState sig)}
    (split : labels = used ++ suffix)
    (moved : OccurrenceTransport profile ready base bindings start incoming (.tau :: used) (.tau :: used) reached peer)
    (writers : VisitorWriterPath profile ready base bindings start incoming (.tau :: used) (.tau :: used) reached peer)
    (reply : ComponentMarkedReplyTail profile ready base bindings older origin reference reached peer leading
      check resume resume suffix finish)
    (focus : reached.ctl = check.control (.pure (.cancel .none)))
    (nonempty : suffix ≠ [])
    (actualTail : Steps profile ready (specDispatch ready base) reached suffix finish)
    (paired : HostFrame.Related.Paired older start incoming) :
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  obtain ⟨mark, tracked, actual⟩ := reply
  have stop (missing : mark ≠ some (.active 0 0)) :
      CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
    apply Or.inr
    apply callbackTerminalSlice paired
    rw [split, ← List.cons_append]
    exact .componentReplyDisplaced tracked focus missing moved writers actualTail
  rcases actual focus with missing | ⟨after, atCaller, pop⟩
  · exact stop missing
  rcases pop with missing | empty | ⟨remaining, canon, _, popped, _, residual, livePop, frame, _, _, transport⟩
  · exact stop missing
  · exact (nonempty empty.1).elim
  have whole := transport (markTransport moved)
  have pops := VisitorWriterPath.framed (base := base) (bindings := bindings)
    (.same (.popProg (atCaller ▸ focus)) rfl (.done _)) (.same livePop rfl (.done _))
  rcases classifyReachedGrowth (CallbackPrefix.transportPaths whole none).choose_spec.1.steps with growing | nonGrowing
  · refine .inl ⟨used ++ [.tau], .tau :: (used ++ [.tau]), remaining, { reached with ctl := after.control (resume (.cancel .none)) },
      { peer with ctl := canon.control (resume (.cancel .none)) }, ?_, ?_, residual⟩
    · rw [split, popped, List.append_assoc]
      rfl
    · exact ⟨by simpa only [List.cons_append] using growing, rfl, pairAfterComponentPop frame,
        by simpa only [List.cons_append, List.map_nil] using whole,
        by simpa only [List.cons_append, PayloadPrefix.Cursor.control] using writers.append pops⟩
  · refine .inr (callbackTerminalSlice paired ?_)
    have full : .tau :: labels = ((.tau :: used) ++ [.tau]) ++ remaining := by
      rw [split, popped]
      exact (List.append_assoc (.tau :: used) [.tau] remaining).symm
    rw [full]
    exact .nonGrowing nonGrowing (pairAfterComponentPop frame) whole (writers.append pops) residual

private theorem crossComponentBodyReply
    {left right startBody peerBody reached peer : Config (core3 grow) (HostState sig)}
    {entry suffix leading remainder : Trace grow sig} {check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    {resume : ReturnFrame.Continuation (core3 grow) (HostState sig)}
    (installed : OccurrenceTransport profile ready base bindings start incoming [.tau] [.tau] left right)
    (entrySplit : labels = entry ++ suffix)
    (entryPath : OccurrenceTransport profile ready base bindings left right entry entry startBody peerBody)
    (entryWriters : VisitorWriterPath profile ready base bindings start incoming (.tau :: entry) (.tau :: entry) startBody peerBody)
    (bodySplit : suffix = leading ++ remainder)
    (bodyPath : OccurrenceTransport profile ready base bindings startBody peerBody leading leading reached peer)
    (bodyWriters : VisitorWriterPath profile ready base bindings startBody peerBody leading leading reached peer)
    (reply : ComponentMarkedReplyTail profile ready base bindings older startBody peerBody reached peer leading
      check resume resume remainder finish)
    (focus : reached.ctl = check.control (.pure (.cancel .none)))
    (nonempty : remainder ≠ [])
    (residual : Steps profile ready (specDispatch ready base) reached remainder finish)
    (paired : HostFrame.Related.Paired older start incoming) :
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  have prefixPath := (CallbackPrefix.transportAppend entryPath bodyPath).choose_spec.1
  have whole := (CallbackPrefix.transportAppend installed prefixPath).choose_spec.1
  have split : labels = (entry ++ leading) ++ remainder := by rw [entrySplit, bodySplit, List.append_assoc]
  have full : OccurrenceTransport profile ready base bindings start incoming (.tau :: (entry ++ leading))
      (.tau :: (entry ++ leading)) reached peer := whole
  exact crossComponentReply split full (entryWriters.append bodyWriters) reply focus nonempty residual paired

private theorem componentRefusedReplyFocus {changes reached peer suffix check canon}
    (frontier : ComponentStoreFrontier (grow := grow) (sig := sig) (Result := Unit) changes check canon
      (fun _ => .pure (.cancel .none)) (fun _ => .pure (.cancel .none)) reached peer suffix True)
    (continued : ¬ (suffix = [] ∨ (reached.ctl = [] ∧ peer.ctl = []))) :
    reached.ctl = check.control (.pure (.cancel .none)) := by
  cases frontier with
  | returned _ checked _ _ => exact checked
  | pending _ _ _ _ _ cut =>
    rcases cut with empty | ⟨impossible, _⟩
    · exact (continued (.inl empty)).elim
    · exact (impossible trivial).elim
  | trapped checked canonical _ => exact (continued (.inr ⟨checked, canonical⟩)).elim

private theorem componentAcceptedReplyFocus {changes reached peer suffix check canon tree handle}
    (frontier : ComponentAcceptedFrontier (grow := grow) (sig := sig) changes check canon tree handle reached peer suffix)
    (continued : ¬ (suffix = [] ∨ (reached.ctl = [] ∧ peer.ctl = []))) :
    reached.ctl = check.control (.pure (.cancel .none)) := by
  cases frontier with
  | published checked _ _ _ _ => exact checked
  | pending _ empty => exact (continued (.inl empty)).elim
  | trapped checked canonical _ => exact (continued (.inr ⟨checked, canonical⟩)).elim

set_option maxHeartbeats 800000 in
private theorem classifiedComponentCrossing {callees : List (ComponentCall.Callee sig)} :
    CallbackComponentCrossing profile ready (ComponentCall.hostWithComponent (grow := grow) bindings callees) bindings := by
  classical
  intro older start incoming next finish label labels active hostId caller resume frames rest focus step tail paired
  by_cases admits : ComponentHostAdmission callees hostId caller active start
  · obtain ⟨callee, subtask, cx, args, pos, ft, limits, results, entry, task, linked, record, liveThread, liveTask, context, admitted⟩ := admits
    obtain ⟨peerFrames, peerRest, rfl, rfl, entered, install, leftMark, rightMark, outside⟩ :=
      cutLinkedComponentInstall linked focus step paired
    have installed := sharedTopTransport install leftMark rightMark
    have paths := (CallbackPrefix.transportPaths installed none).choose_spec
    have installWriters := VisitorWriterPath.framed (base := ComponentCall.hostWithComponent bindings callees) (bindings := bindings)
      (WriterPaths.frameSingle paths.1.steps rfl) (WriterPaths.frameSingle paths.2.steps rfl)
    let leftInstall := { start with ctl := ⟨some active, .prog (ComponentCall.invoke callee caller), .prog resume :: frames⟩ :: rest }
    let rightInstall := { incoming with ctl := ⟨some active, .prog (ComponentCall.invoke callee caller), .prog resume :: peerFrames⟩ :: peerRest }
    rcases cutAdmittedComponent (bindings := bindings)
        (start := leftInstall) (incoming := rightInstall)
        callee caller rfl record liveThread liveTask context admitted
        entered leftMark rightMark outside tail with early |
          ⟨entryFrames, entryRest, suffix, entrySplit, moved, writers, entryResidual, _, classified⟩
    · obtain ⟨canon, _, peer, entryPath, site, writers, checked, canonical⟩ := early
      have throughEntry := CallbackPrefix.transportAppend install entryPath
      let mark := throughEntry.choose (some (.active 0 0))
      have finalPaths : OccurrenceTransport profile ready (ComponentCall.hostWithComponent bindings callees) bindings
          start incoming (.tau :: labels) (.tau :: labels) finish peer [mark] := by
        simpa only [mark, List.singleton_append, List.nil_append, List.map_cons, List.map_nil] using throughEntry.choose_spec.1
      exact .inr (callbackTerminalSlice paired (.componentEntryPrefix site checked canonical finalPaths
        (installWriters.append writers)))
    let checkEntry : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some active, .prog resume :: frames, rest⟩
    let canonEntry : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some active, entryFrames, entryRest⟩
    let leftEntry := componentPreflightAt callee caller cx args leftInstall checkEntry
    let rightEntry := componentPreflightAt callee caller cx args rightInstall canonEntry
    have entryWriters := installWriters.append writers
    rcases classified with ⟨different, history⟩ | ⟨plan, _, _, body⟩
    · have throughEntry := CallbackPrefix.transportAppend install moved
      let mark := throughEntry.choose (some (.active 0 0))
      have finalPaths : OccurrenceTransport profile ready (ComponentCall.hostWithComponent bindings callees) bindings
          start incoming (.tau :: List.replicate 7 .tau) (.tau :: List.replicate 7 .tau) leftEntry rightEntry [mark] := by
        simpa only [mark, List.singleton_append, List.nil_append, List.map_cons, List.map_nil] using throughEntry.choose_spec.1
      apply Or.inr
      apply callbackTerminalSlice paired
      simpa only [entrySplit, List.cons_append] using
        (CallbackSliceEnd.componentPreflightMismatch (bindings := bindings) (changes := older)
          (reached := start) (peer := incoming) (left := leftEntry) (right := rightEntry)
          (callee := callee) (caller := caller) (check := checkEntry) (canon := canonEntry)
          (leftTicket := start.host.nextTicket) (rightTicket := incoming.host.nextTicket)
          rfl rfl different history finalPaths entryWriters entryResidual)
    cases plan with
    | error issue =>
      rcases body with early | ⟨leading, remainder, reached, peer, split, path, bodyWriters, residual, frontier, reply⟩
      · obtain ⟨_, peer, bodyPath, site, bodyWriters, checked, canonical⟩ := early
        have throughBody := CallbackPrefix.transportAppend install (CallbackPrefix.transportAppend moved bodyPath).choose_spec.1
        let mark := throughBody.choose (some (.active 0 0))
        have finalPaths : OccurrenceTransport profile ready (ComponentCall.hostWithComponent bindings callees) bindings
            start incoming (.tau :: (List.replicate 7 .tau ++ suffix)) (.tau :: (List.replicate 7 .tau ++ suffix))
            finish peer [mark] := by
          simpa only [mark, List.singleton_append, List.nil_append, List.map_cons, List.map_nil] using throughBody.choose_spec.1
        apply Or.inr
        apply callbackTerminalSlice paired
        simpa only [entrySplit] using
          (CallbackSliceEnd.componentEntryPrefix site checked canonical finalPaths (entryWriters.append bodyWriters))
      · by_cases terminal : remainder = [] ∨ (reached.ctl = [] ∧ peer.ctl = [])
        · have throughBody := CallbackPrefix.transportAppend install (CallbackPrefix.transportAppend moved path).choose_spec.1
          let mark := throughBody.choose (some (.active 0 0))
          have finalPaths : OccurrenceTransport profile ready (ComponentCall.hostWithComponent bindings callees) bindings
              start incoming (.tau :: (List.replicate 7 .tau ++ leading)) (.tau :: (List.replicate 7 .tau ++ leading))
              reached peer [mark] := by
            simpa only [mark, List.singleton_append, List.nil_append, List.map_cons, List.map_nil] using throughBody.choose_spec.1
          apply Or.inr
          apply callbackTerminalSlice paired
          simpa only [entrySplit, split, List.cons_append, List.append_assoc] using
            (CallbackSliceEnd.componentRefusedTerminal frontier terminal finalPaths (entryWriters.append bodyWriters) residual)
        · exact crossComponentBodyReply installed entrySplit moved entryWriters split path bodyWriters reply
            (componentRefusedReplyFocus frontier terminal) (fun empty => terminal (.inl empty)) residual paired
    | ok planned =>
      obtain ⟨leading, remainder, reached, peer, split, path, checkedResidual, observed⟩ := body
      have stopObserver {wider : ReturnFrame.Substitutions (core3 grow) (HostState sig)}
          {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
          (terminal : (remainder = [] ∧ PairedComponentSite wider reached peer check canon) ∨
            (reached.ctl = [] ∧ peer.ctl = [] ∧ HostFrame.Related.Paired wider reached peer))
          (bodyWriters : VisitorWriterPath profile ready (ComponentCall.hostWithComponent bindings callees) bindings
            leftEntry rightEntry leading leading reached peer) :
          CallbackSlice profile ready (ComponentCall.hostWithComponent bindings callees) bindings
            older start incoming (.tau :: labels) finish := by
        have throughBody := CallbackPrefix.transportAppend install (CallbackPrefix.transportAppend moved path).choose_spec.1
        let mark := throughBody.choose (some (.active 0 0))
        have finalPaths : OccurrenceTransport profile ready (ComponentCall.hostWithComponent bindings callees) bindings
            start incoming (.tau :: (List.replicate 7 .tau ++ leading)) (.tau :: (List.replicate 7 .tau ++ leading))
            reached peer [mark] := by
          simpa only [mark, List.singleton_append, List.nil_append, List.map_cons, List.map_nil] using throughBody.choose_spec.1
        apply callbackTerminalSlice paired
        simpa only [entrySplit, split, List.cons_append, List.append_assoc] using
          (CallbackSliceEnd.componentObserverTerminal terminal finalPaths (entryWriters.append bodyWriters) checkedResidual)
      cases observed with
      | pending empty site writers => exact .inr (stopObserver (.inl ⟨empty, site⟩) writers)
      | trapped checked canonical site writers =>
        exact .inr (stopObserver (check := checkEntry) (canon := canonEntry) (.inr ⟨checked, canonical, site⟩) writers)
      | registrationMismatch mismatch site bodyWriters writers _ =>
        have bodyPath := CallbackPrefix.transportAppend moved path
        have throughRead := CallbackPrefix.transportAppend install bodyPath.choose_spec.1
        let mark := throughRead.choose (some (.active 0 0))
        have finalPaths : OccurrenceTransport profile ready (ComponentCall.hostWithComponent bindings callees) bindings
            start incoming (.tau :: (List.replicate 7 .tau ++ leading)) (.tau :: (List.replicate 7 .tau ++ leading))
            reached peer [mark] := by
          simpa only [mark, List.singleton_append, List.nil_append, List.map_cons, List.map_nil] using
            throughRead.choose_spec.1
        apply Or.inr
        apply callbackTerminalSlice paired
        simpa only [entrySplit, split, List.cons_append, List.append_assoc] using
          (CallbackSliceEnd.componentRegistrationMismatch mismatch site finalPaths (entryWriters.append bodyWriters)
            writers checkedResidual)
      | refused frontier bodyWriters reply =>
        by_cases terminal : remainder = [] ∨ (reached.ctl = [] ∧ peer.ctl = [])
        · have throughBody := CallbackPrefix.transportAppend install (CallbackPrefix.transportAppend moved path).choose_spec.1
          let mark := throughBody.choose (some (.active 0 0))
          have finalPaths : OccurrenceTransport profile ready (ComponentCall.hostWithComponent bindings callees) bindings
              start incoming (.tau :: (List.replicate 7 .tau ++ leading)) (.tau :: (List.replicate 7 .tau ++ leading))
              reached peer [mark] := by
            simpa only [mark, List.singleton_append, List.nil_append, List.map_cons, List.map_nil] using throughBody.choose_spec.1
          apply Or.inr
          apply callbackTerminalSlice paired
          simpa only [entrySplit, split, List.cons_append, List.append_assoc] using
            (CallbackSliceEnd.componentRefusedTerminal frontier terminal finalPaths (entryWriters.append bodyWriters) checkedResidual)
        · exact crossComponentBodyReply installed entrySplit moved entryWriters split path bodyWriters reply
            (componentRefusedReplyFocus frontier terminal) (fun empty => terminal (.inl empty)) checkedResidual paired
      | accepted frontier reply bodyWriters flow =>
        by_cases terminal : remainder = [] ∨ (reached.ctl = [] ∧ peer.ctl = [])
        · have throughBody := CallbackPrefix.transportAppend install (CallbackPrefix.transportAppend moved path).choose_spec.1
          let mark := throughBody.choose (some (.active 0 0))
          have finalPaths : OccurrenceTransport profile ready (ComponentCall.hostWithComponent bindings callees) bindings
              start incoming (.tau :: (List.replicate 7 .tau ++ leading)) (.tau :: (List.replicate 7 .tau ++ leading))
              reached peer [mark] := by
            simpa only [mark, List.singleton_append, List.nil_append, List.map_cons, List.map_nil] using throughBody.choose_spec.1
          apply Or.inr
          apply callbackTerminalSlice paired
          simpa only [entrySplit, split, List.cons_append, List.append_assoc] using
            (CallbackSliceEnd.componentAcceptedTerminal frontier terminal finalPaths (entryWriters.append bodyWriters)
              (fun pending related => flow pending related) checkedResidual)
        · exact crossComponentBodyReply installed entrySplit moved entryWriters split path bodyWriters reply
            (componentAcceptedReplyFocus frontier terminal) (fun empty => terminal (.inl empty)) checkedResidual paired
  · have failure : ComponentEntryFailure profile ready bindings callees older start incoming finish label labels := by
      by_cases linked : ∃ callee, callees.filter (·.hostId == hostId) = [callee]
      · obtain ⟨callee, singleton⟩ := linked
        exact cutComponentDenied singleton admits focus step tail paired
      · exact cutComponentBadLink linked focus step tail paired
    obtain ⟨leading, suffix, reached, peer, check, canon, rfl, split, mark, paths, writers, residual, outcome⟩ := failure
    apply Or.inr
    apply callbackTerminalSlice paired
    simpa only [split, List.cons_append] using
      (CallbackSliceEnd.componentObserverTerminal (mark := mark) outcome paths writers residual)

open ReturnFrame.Occurrence in
private theorem crossAsymmetricFlatCalloutExit {Observation : Type} {code : Observation → Nat} {leading canonLeading suffix reached peer}
    (used : labels = leading ++ suffix)
    (observed : PayloadPrefix.visible canonLeading = PayloadPrefix.visible leading)
    (exit : FlatCalloutExit code profile ready base bindings older reached peer suffix finish)
    (writers : VisitorWriterPath profile ready base bindings start incoming (.tau :: leading) (.tau :: canonLeading) reached peer)
    (live : ∀ {thread core resume frames rest peerFrames peerRest} {observation : Observation},
      reached.ctl = ⟨thread, .prog (.pure (.flat [i32Flat (code observation)])), .core core resume :: frames⟩ :: rest →
      peer.ctl = ⟨thread, .prog (.pure (.flat [i32Flat (code observation)])), .core core resume :: peerFrames⟩ :: peerRest →
      OccurrenceTransport profile ready base bindings start incoming (.tau :: leading) (.tau :: canonLeading) reached peer)
    (terminal : suffix = [] ∨ (reached.ctl = [] ∧ peer.ctl = []) →
      CallbackSlice profile ready base bindings older start incoming (.tau :: labels) finish)
    (paired : HostFrame.Related.Paired older start incoming) :
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  cases exit with
  | exhausted empty _ => exact .inr (terminal (.inl empty))
  | trapped left right _ => exact .inr (terminal (.inr ⟨left, right⟩))
  | @rejoined observation active state resume frames rest peerFrames peerRest remaining checked canonical split residual returned _ pop =>
    have whole := (CallbackPrefix.transportAppend (live checked canonical) pop).choose_spec.1
    have pops := VisitorWriterPath.framed (profile := profile) (ready := ready) (base := base) (bindings := bindings)
      (.same (.popCore checked) rfl (.done _)) (.same (.popCore canonical) rfl (.done _))
    rcases classifyReachedGrowth (CallbackPrefix.transportPaths whole none).choose_spec.1.steps with growing | nonGrowing
    · let replied := { reached with ctl := ⟨active,
          .core ((core3 grow).resume reached.store.core state (.values [i32Flat (code observation)])) resume, frames⟩ :: rest }
      let peerReply := { peer with ctl := ⟨active,
          .core ((core3 grow).resume peer.store.core state (.values [i32Flat (code observation)])) resume, peerFrames⟩ :: peerRest }
      refine .inl ⟨leading ++ [.tau], .tau :: (canonLeading ++ [.tau]), remaining, replied, peerReply, ?_, ?_, residual⟩
      · rw [used, split, List.append_assoc]
        rfl
      · exact ⟨by simpa only [List.cons_append] using growing,
          by simp only [visibleTauCons, visibleAppend, observed], returned,
          by simpa only [List.cons_append, List.map_nil, List.append_nil] using whole,
          by simpa only [List.cons_append] using writers.append pops⟩
    · refine .inr (callbackTerminalSlice paired ?_)
      have full : .tau :: labels = ((.tau :: leading) ++ [.tau]) ++ remaining := by
        rw [used, split]
        exact (List.append_assoc (.tau :: leading) [.tau] remaining).symm
      rw [full]
      exact .nonGrowing nonGrowing returned whole (writers.append pops) residual

open ReturnFrame.Occurrence in
private theorem crossFlatCalloutExit {Observation : Type} {code : Observation → Nat} {leading suffix reached peer}
    (used : labels = leading ++ suffix)
    (exit : FlatCalloutExit code profile ready base bindings older reached peer suffix finish)
    (writers : VisitorWriterPath profile ready base bindings start incoming (.tau :: leading) (.tau :: leading) reached peer)
    (live : ∀ {thread core resume frames rest peerFrames peerRest} {observation : Observation},
      reached.ctl = ⟨thread, .prog (.pure (.flat [i32Flat (code observation)])), .core core resume :: frames⟩ :: rest →
      peer.ctl = ⟨thread, .prog (.pure (.flat [i32Flat (code observation)])), .core core resume :: peerFrames⟩ :: peerRest →
      OccurrenceTransport profile ready base bindings start incoming (.tau :: leading) (.tau :: leading) reached peer)
    (terminal : suffix = [] ∨ (reached.ctl = [] ∧ peer.ctl = []) →
      CallbackSlice profile ready base bindings older start incoming (.tau :: labels) finish)
    (paired : HostFrame.Related.Paired older start incoming) :
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish :=
  crossAsymmetricFlatCalloutExit used rfl exit writers live terminal paired

open ReturnFrame.Occurrence in
private theorem classifiedPollCrossing : CallbackWaitableCrossing profile ready base bindings true := by
  intro changes start incoming installed finish label labels thread core resume frames rest mem inst args focused calling step tail paired
  obtain ⟨_, _, leading, suffix, reached, peer, split, ⟨mark, paths⟩, live, actual, frontier, unchanged, writers, exit⟩ :=
    cutPublicPoll (bindings := bindings) mem inst args focused calling step tail paired
  obtain ⟨rfl, used⟩ := List.cons.inj split
  refine crossFlatCalloutExit used exit writers ?_ (fun stop => callbackTerminalSlice paired ?_) paired
  · intro _ core resume _ _ _ _ _ checked canonical
    exact sharedTopTransport (live (by rw [checked]; exact List.cons_ne_nil _ _))
      (frame := .core core resume)
      (by rw [segmentStorage, checked]; rfl) (by rw [segmentStorage, canonical]; rfl)
  · rw [used]
    exact .pollTerminal paths writers unchanged frontier stop actual

private theorem classifiedWaitResumeCrossing : CallbackWaitResumeCrossing profile ready base bindings := by
  intro changes start incoming next finish label labels waiter resumer afterResume frames rest core resume savedFrames mem entry
    scheduled found step tail paired
  obtain ⟨leading, suffix, reached, peer, check, canon, split, paths, actual, frontier, exit, _, _, _, writers⟩ :=
    cutResumedWaitDelivery (bindings := bindings) mem entry scheduled found step tail paired
  obtain ⟨rfl, used⟩ := List.cons.inj split
  refine crossFlatCalloutExit used exit writers (fun _ _ => paths) (fun stop => callbackTerminalSlice paired ?_) paired
  rw [used]
  exact .waitTerminal paths writers frontier stop actual

private theorem classifiedCancelResumeCrossing : CallbackCancelResumeCrossing profile ready base bindings := by
  intro changes start incoming next finish label labels waiter resumer afterResume frames rest core resume savedFrames subtask
    scheduled found step tail paired
  obtain ⟨leading, suffix, reached, peer, split, paths, actual, exit, _, _, _, writers⟩ :=
    cutResumedCancelFinish (bindings := bindings) subtask scheduled found step tail paired
  obtain ⟨rfl, used⟩ := List.cons.inj split
  refine crossFlatCalloutExit used exit writers (fun _ _ => paths) (fun stop => callbackTerminalSlice paired ?_) paired
  rw [used]
  exact .cancelTerminal paths writers rfl exit stop actual

open ReturnFrame.Occurrence in
theorem cutCancelHookInstall (async : Bool) (subtask : SubtaskId) (hook : CancelRef)
    {thread frames rest peerFrames peerRest}
    (leftFocus : start.ctl = ⟨thread, .prog (cancelAfterRequestWrite async subtask hook), frames⟩ :: rest)
    (rightFocus : incoming.ctl = ⟨thread, .prog (cancelAfterRequestWrite async subtask hook), peerFrames⟩ :: peerRest)
    (paired : PairedComponentSite older start incoming ⟨thread, frames, rest⟩ ⟨thread, peerFrames, peerRest⟩)
    (run : Steps profile ready (specDispatch ready base) start labels finish) :
    (labels = [] ∧ finish = start) ∨
    ∃ suffix,
      let resume := cancelHookReturn (grow := grow) (sig := sig) async subtask
      let body := specDispatch ready base (.onCancel hook)
      let reached := { start with ctl := ⟨thread, .prog body, .prog resume :: frames⟩ :: rest }
      let peer := { incoming with ctl := ⟨thread, .prog body, .prog resume :: peerFrames⟩ :: peerRest }
      labels = .tau :: suffix ∧ Steps profile ready (specDispatch ready base) reached suffix finish ∧
      HostFrame.Related.Paired (ReturnFrame.Extend older resume resume) reached peer ∧
      OccurrenceTransport profile ready base bindings start incoming [.tau] [.tau] reached peer [some (.active 0 0)] := by
  cases run with
  | refl => exact .inl ⟨rfl, rfl⟩
  | cons first tail =>
    let resume := cancelHookReturn (grow := grow) (sig := sig) async subtask
    let body := specDispatch ready base (.onCancel hook)
    let reached := { start with ctl := ⟨thread, .prog body, .prog resume :: frames⟩ :: rest }
    let peer := { incoming with ctl := ⟨thread, .prog body, .prog resume :: peerFrames⟩ :: peerRest }
    have sameDispatch : specDispatch ready (LiveDispatch.host bindings base) (.onCancel hook) = body := by cases hook <;> rfl
    have checked : Step profile ready (specDispatch ready base) start .tau reached := .call leftFocus
    have canonical : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau peer := by
      simpa only [peer, ← sameDispatch] using (Step.call rightFocus : Step profile ready
        (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau _)
    obtain ⟨rfl, rfl⟩ := silentStepUnique checked first
    have focused := pairComponentFocus leftFocus rightFocus paired
    obtain ⟨otherFrames, otherRest, shape, aligned⟩ :=
      focused.push leftFocus body resume resume
    rw [rightFocus, List.cons.injEq, Activation.mk.injEq] at shape
    obtain ⟨⟨_, _, rfl⟩, rfl⟩ := shape
    have leftEdit : transitionEdit start .tau = .push (.prog resume) := by rw [transitionEdit, leftFocus]; rfl
    have rightEdit : transitionEdit incoming .tau = .push (.prog resume) := by rw [transitionEdit, rightFocus]; rfl
    exact .inr ⟨_, rfl, tail, aligned, sharedPushTransport checked canonical leftEdit rightEdit⟩

open ReturnFrame.Occurrence in
private theorem classifiedWaitCrossing : CallbackWaitableCrossing profile ready base bindings false := by
  intro changes start incoming next finish label labels thread core resume frames rest mem inst args focused calling step tail paired
  obtain ⟨peerFrames, peerRest, leading, suffix, reached, peer, split, ⟨mark, paths⟩, live, residual, frontier, decisionWriters⟩ :=
    cutPublicWaitDecision (bindings := bindings) mem inst args focused calling step tail paired
  obtain ⟨rfl, used⟩ := List.cons.inj split
  have terminal (stop : suffix = [] ∨ (reached.ctl = [] ∧ peer.ctl = [])) :
      CallbackCrossingAt profile ready base bindings changes start incoming .tau labels finish := by
    refine .inr (callbackTerminalSlice paired ?_)
    rw [used]
    exact .waitTerminal paths decisionWriters frontier stop residual
  cases frontier with
  | trapped checked canonical _ => exact terminal (.inr ⟨checked, canonical⟩)
  | pending op resume checked canonical site stop => exact terminal (.inl (stop.resolve_right (fun impossible => impossible.1 trivial)))
  | returned result checked canonical site =>
    have original := live (by rw [checked]; exact List.cons_ne_nil _ _)
    have decision := sharedTopTransport original (frame := .core core resume)
      (by rw [segmentStorage, checked]; rfl) (by rw [segmentStorage, canonical]; rfl)
    rcases result with ⟨entry, choice⟩
    cases choice with
    | none =>
      obtain ⟨body, remaining, delivered, peerDelivery, consumed, path, actual, outcome, exit, _, _, _, bodyWriters⟩ :=
        cutWaitableWaitDelivery (bindings := bindings) mem entry checked canonical site residual
      have whole := (CallbackPrefix.transportAppend decision path).choose_spec.1
      have compared : OccurrenceTransport profile ready base bindings start incoming (.tau :: (leading ++ body))
          (.tau :: (leading ++ body)) delivered peerDelivery := by
        simpa only [List.nil_append, List.map_nil, List.cons_append] using whole
      have useAll : labels = (leading ++ body) ++ remaining :=
        used.trans ((congrArg (leading ++ ·) consumed).trans (List.append_assoc ..).symm)
      have writers : VisitorWriterPath profile ready base bindings start incoming (.tau :: (leading ++ body))
          (.tau :: (leading ++ body)) delivered peerDelivery := by
        simpa only [List.cons_append] using decisionWriters.append bodyWriters
      refine crossFlatCalloutExit useAll exit writers (fun _ _ => compared)
        (fun stop => callbackTerminalSlice paired ?_) paired
      rw [useAll]
      exact .waitTerminal compared writers outcome stop actual
    | some waiter =>
      cases thread with
      | none =>
        have aligned := pairComponentFocus checked canonical site
        rcases classifyReachedGrowth (CallbackPrefix.transportPaths decision none).choose_spec.1.steps with growing | nonGrowing
        · exact .inl ⟨leading, .tau :: leading, suffix, reached, peer, used,
            ⟨growing, rfl, aligned, decision, decisionWriters⟩, residual⟩
        · refine .inr (callbackTerminalSlice paired ?_)
          rw [used]
          exact .nonGrowing nonGrowing aligned decision decisionWriters residual
      | some active =>
        rcases cutWaitableWaitPark (bindings := bindings) (thread := active) mem entry checked canonical site residual
          with empty | ⟨remaining, parked, parkedRun, aligned, path, _, _⟩
        · exact terminal (.inl empty.1)
        have split : labels = (leading ++ [.tau]) ++ remaining := by
          rw [used, parked, List.append_assoc, List.singleton_append]
          rfl
        have whole := (CallbackPrefix.transportAppend decision path).choose_spec.1
        have writers := decisionWriters.append (frameCalloutStep path rfl rfl)
        rcases classifyReachedGrowth (CallbackPrefix.transportPaths whole none).choose_spec.1.steps with growing | nonGrowing
        · have compared := ExecutedCallbackSegment.mk growing rfl aligned whole writers
          exact .inl ⟨leading ++ [.tau], .tau :: (leading ++ [.tau]), remaining, _, _, split,
            by simpa only [List.cons_append] using compared, parkedRun⟩
        · refine .inr (callbackTerminalSlice paired ?_)
          rw [split, ← List.cons_append]
          exact .nonGrowing (by simpa only [List.cons_append] using nonGrowing) aligned
            (by simpa only [List.cons_append, List.nil_append, List.map_nil] using whole)
            (by simpa only [List.cons_append] using writers) parkedRun

open ReturnFrame.Occurrence in
private theorem classifyCancelHookWith (async : Bool) (subtask : SubtaskId) (hook : CancelRef)
    {thread frames rest peerFrames peerRest} {budget : Nat}
    (leftFocus : start.ctl = ⟨thread, .prog (cancelAfterRequestWrite async subtask hook), frames⟩ :: rest)
    (rightFocus : incoming.ctl = ⟨thread, .prog (cancelAfterRequestWrite async subtask hook), peerFrames⟩ :: peerRest)
    (paired : PairedComponentSite older start incoming ⟨thread, frames, rest⟩ ⟨thread, peerFrames, peerRest⟩)
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (bounded : labels.length ≤ budget) (compare : ShorterCallbackSlices profile ready base bindings budget) :
    CancelHookCallbackSlice profile ready base bindings older (cancelHookReturn async subtask) start incoming labels finish := by
  rcases cutCancelHookInstall (bindings := bindings) async subtask hook leftFocus rightFocus paired run with empty | installed
  · exact .inl empty
  obtain ⟨suffix, split, residual, related, install⟩ := installed
  have shorter : suffix.length < budget := by rw [split, List.length_cons] at bounded; omega
  obtain ⟨checked, canonical, trailing, reached, peer, used, compared, ending⟩ := compare shorter residual related
  obtain ⟨move, whole, tracks⟩ := CallbackPrefix.transportAppend install compared.occurrences
  let mark := move (some (.active 0 0))
  have aligned := pairComponentFocus (check := ⟨thread, frames, rest⟩) (canon := ⟨thread, peerFrames, peerRest⟩)
    leftFocus rightFocus paired
  have outside : OutsideMarks older (segmentStorage start) (segmentStorage incoming) [] :=
    fun place _ => paired_outside (left := HostFrame.replace start incoming.host) aligned place (by simp)
  have kept : Outside older (segmentStorage reached) (segmentStorage peer) mark := by
    apply outsideMarks_singleton.mp
    obtain ⟨_, _, retained⟩ := whole
    exact retained older [] outside
  obtain ⟨checkMark, canonMark⟩ := tracks (some (.active 0 0))
  have tracked : AllocatorMark profile ready base bindings older _ _ checked canonical reached peer mark :=
    ⟨kept, checkMark, canonMark, CallbackPrefix.transportPaths compared.occurrences⟩
  refine .inr ⟨_, _, checked, canonical, trailing, reached, peer, mark, by rw [split, used], install, whole,
    (frameCalloutStep install rfl rfl).append compared.writers, compared.observed.symm, tracked, ending, ?_⟩
  intro value cursor returning
  exact alignAllocatorPop tracked compared.paired returning rfl (callbackEndSteps ending)

open ReturnFrame.Occurrence in
private theorem oneStepLocation {left right : Config (core3 grow) (HostState sig)} {place first second : Option Location}
    {label : Label (core3 grow) (HostState sig)}
    (leftTrail : Trail profile ready (specDispatch ready base) left place [label] right first)
    (rightTrail : Trail profile ready (specDispatch ready base) left place [label] right second) : first = second := by
  cases leftTrail with
  | step _ leftTail =>
    cases leftTail
    cases rightTrail with
    | step _ rightTail => cases rightTail; rfl

open ReturnFrame.Occurrence in
private theorem crossReadyCancelCore {decision peerDecision : Config (core3 grow) (HostState sig)}
    {checked canonical trailing : Trace grow sig} {thread core resume frames rest peerFrames peerRest}
    (subtask : SubtaskId) (choice : Option ThreadId)
    (split : labels = checked ++ trailing)
    (observed : PayloadPrefix.visible canonical = PayloadPrefix.visible checked)
    (caller : OccurrenceTransport profile ready base bindings start incoming (.tau :: checked) (.tau :: canonical)
      decision peerDecision [some (.active 0 0)])
    (decisionWriters : VisitorWriterPath profile ready base bindings start incoming (.tau :: checked) (.tau :: canonical)
      decision peerDecision)
    (leftFocus : decision.ctl = ⟨thread, .prog (cancelAfterHookDecision subtask choice), .core core resume :: frames⟩ :: rest)
    (rightFocus : peerDecision.ctl = ⟨thread, .prog (cancelAfterHookDecision subtask choice), .core core resume :: peerFrames⟩ :: peerRest)
    (site : PairedComponentSite older decision peerDecision ⟨thread, .core core resume :: frames, rest⟩
      ⟨thread, .core core resume :: peerFrames, peerRest⟩)
    (actual : Steps profile ready (specDispatch ready base) decision trailing finish)
    (paired : HostFrame.Related.Paired older start incoming)
    (compare : ShorterCallbackSlices profile ready base bindings (.tau :: labels).length)
    (nonempty : trailing ≠ []) :
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  cases choice with
  | none =>
    obtain ⟨body, remaining, reached, peer, used, paths, residual, exit, stationary, _, _, bodyWriters⟩ :=
      cutCancelFinish (bindings := bindings) subtask leftFocus rightFocus site actual
    have consumed : labels = (checked ++ body) ++ remaining := by rw [split, used, List.append_assoc]
    have seen : PayloadPrefix.visible (canonical ++ body) = PayloadPrefix.visible (checked ++ body) := by
      simp only [visibleAppend, observed]
    have writers : VisitorWriterPath profile ready base bindings start incoming (.tau :: (checked ++ body))
        (.tau :: (canonical ++ body)) reached peer := by
      simpa only [List.cons_append] using decisionWriters.append bodyWriters
    refine crossAsymmetricFlatCalloutExit consumed seen exit writers ?_ ?_ paired
    · intro _ finalCore finalResume _ _ _ _ _ left right
      have live := retainComparedOccurrences caller (stationary (by rw [left]; exact List.cons_ne_nil _ _))
      exact sharedTopTransport live (frame := .core finalCore finalResume)
        (by rw [segmentStorage, left]; rfl) (by rw [segmentStorage, right]; rfl)
    · intro terminal
      have throughFinish := (CallbackPrefix.transportAppend caller paths).choose_spec.1
      refine callbackTerminalSlice paired ?_
      rw [consumed]
      exact .cancelTerminal throughFinish (by simpa only [List.cons_append] using writers)
        (by simpa only [List.cons_append, visibleTauCons] using seen) exit terminal residual
  | some waiter =>
    cases thread with
    | none =>
      cases actual with
      | refl => exact (nonempty rfl).elim
      | @cons _ next _ action suffix first tail =>
        let reason := TrapReason.internal "block on a host frame"
        have checkedFault : Step profile ready (specDispatch ready base) decision (.trap reason) (StepDefs.trapCfg decision) :=
          .fault (.blockNoThread leftFocus)
        have rawFault : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) peerDecision
            (.trap reason) (StepDefs.trapCfg peerDecision) :=
          .fault (.blockNoThread rightFocus)
        have actualLabel : action = .trap reason := by
          by_contra different
          exact (differentStepBranch checkedFault first (Ne.symm different)).1
        subst action
        cases labelledStepUnique checkedFault first
        let clearEdit : Edit (core3 grow) (HostState sig) := .clear
        have faultPaths : OccurrenceTransport profile ready base bindings decision peerDecision
            [.trap reason] [.trap reason] (StepDefs.trapCfg decision) (StepDefs.trapCfg peerDecision) := by
          refine ⟨(·.bind clearEdit.follow), fun mark => ⟨.step checkedFault (.done _ _), .step rawFault (.done _ _)⟩, ?_⟩
          intro changes marks outside
          rw [step_edit checkedFault, step_edit rawFault,
            show transitionEdit decision (.trap reason) = clearEdit from rfl,
            show transitionEdit peerDecision (.trap reason) = clearEdit from rfl]
          simpa only [List.nil_append] using outside.edit clearEdit
        have aligned := pairComponentFocus leftFocus rightFocus site
        have trapped : HostFrame.Related.Paired older (StepDefs.trapCfg decision) (StepDefs.trapCfg peerDecision) := by
          simpa only [StepDefs.trapCfg, aligned.data.1] using
            (aligned.set_store (StepDefs.lockdownSt peerDecision.store)).clear_control
        have paths := (CallbackPrefix.transportAppend caller faultPaths).choose_spec.1
        have effects := decisionWriters.append (.framed (.same checkedFault rfl (.done _)) (.same rawFault rfl (.done _)))
        have full : .tau :: labels = ((.tau :: checked) ++ [.trap reason]) ++ suffix := by
          rw [split]
          simp only [List.cons_append, List.append_assoc, List.nil_append]
        refine .inr (callbackTerminalSlice paired ?_)
        rw [full]
        exact .cancelDecisionTerminal (check := ⟨none, .core core resume :: frames, rest⟩)
          (canon := ⟨none, .core core resume :: peerFrames, peerRest⟩) (subtask := subtask) paths effects
          (by simp only [visibleAppend, visibleTauCons, observed]) (.trapped rfl rfl trapped) (.inr ⟨rfl, rfl⟩) tail
    | some active =>
      rcases cutCoreCalloutPark (bindings := bindings) (cancelFinish subtask) leftFocus rightFocus site actual with stopped | parked
      · exact (nonempty stopped.1).elim
      obtain ⟨remaining, used, residual, aligned, path, saved, _⟩ := parked
      have shorter : remaining.length < (.tau :: labels).length := by
        rw [split, used, List.length_cons, List.length_append, List.length_cons]
        omega
      obtain ⟨parkMove, throughPark, parkTrails⟩ := CallbackPrefix.transportAppend caller path
      have atSaved := oneStepLocation (parkTrails (some (.active 0 0))).1 saved
      let parked := { (decision.setCont active (some ⟨some active, .prog (cancelFinish subtask), .core core resume :: frames⟩)) with
        store := StepDefs.threadStatusSt active .blocked decision.store, ctl := rest }
      let peerParked := { (peerDecision.setCont active (some ⟨some active, .prog (cancelFinish subtask), .core core resume :: peerFrames⟩)) with
        store := StepDefs.threadStatusSt active .blocked peerDecision.store, ctl := peerRest }
      have markedPark : OccurrenceTransport profile ready base bindings start incoming
          (.tau :: (checked ++ [.tau])) (.tau :: (canonical ++ [.tau])) parked peerParked [some (.saved active.idx 0)] :=
        by simpa only [List.cons_append, List.nil_append, List.map_cons, List.map_nil, atSaved] using throughPark
      obtain ⟨ran, ranCanon, restLabels, reached, peer, continued, compared, ending⟩ := compare shorter residual aligned
      obtain ⟨_, whole, _⟩ := CallbackPrefix.transportAppend markedPark compared.occurrences
      have full : labels = ((checked ++ [.tau]) ++ ran) ++ restLabels := by
        rw [split, used, continued]
        simp only [List.append_assoc, List.cons_append, List.nil_append]
      refine .inr (callbackTerminalSlice paired ?_)
      rw [full]
      have writers : VisitorWriterPath profile ready base bindings start incoming
          (.tau :: (checked ++ [.tau])) (.tau :: (canonical ++ [.tau])) parked peerParked := by
        simpa only [List.cons_append] using decisionWriters.append (frameCalloutStep path rfl rfl)
      exact .cancelParked whole (writers.append compared.writers)
        (by simp only [List.cons_append, visibleTauCons, visibleAppend, observed, compared.observed]) ending

private theorem pairedCoreTop {frames peerFrames : List (Seg (core3 grow) (HostState sig))} {core resume below}
    (related : List.Forall₂ (ReturnFrame.Related.Segment older) frames peerFrames)
    (top : frames = .core core resume :: below) :
    ∃ peerBelow, peerFrames = .core core resume :: peerBelow := by
  rw [top] at related
  cases related with
  | cons first _ => cases first; exact ⟨_, rfl⟩

private theorem cursorShape (cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)) {thread frames}
    (threadAt : cursor.thread = thread) (framesAt : cursor.frames = frames) : cursor = ⟨thread, frames, cursor.rest⟩ := by
  cases cursor
  cases threadAt
  cases framesAt
  rfl

open ReturnFrame.Occurrence in
private theorem crossCancelAfterHook {resumed peerResume : Config (core3 grow) (HostState sig)}
    {checked canonical remaining : Trace grow sig} {mark : Option Location}
    (async : Bool) (subtask : SubtaskId) (value : Ret (core3 grow))
    (check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig))
    (split : labels = checked ++ remaining)
    (observed : PayloadPrefix.visible canonical = PayloadPrefix.visible checked)
    (path : OccurrenceTransport profile ready base bindings start incoming (.tau :: checked) (.tau :: canonical) resumed peerResume)
    (caller : OccurrenceTransport profile ready base bindings start incoming (.tau :: checked) (.tau :: canonical) resumed peerResume [mark])
    (hookWriters : VisitorWriterPath profile ready base bindings start incoming (.tau :: checked) (.tau :: canonical) resumed peerResume)
    (leftFocus : resumed.ctl = check.control (cancelHookReturn async subtask value))
    (rightFocus : peerResume.ctl = canon.control (cancelHookReturn async subtask value))
    (site : PairedComponentSite older resumed peerResume check canon)
    (threadAligned : check.thread = canon.thread)
    (framesAligned : List.Forall₂ (ReturnFrame.Related.Segment older) check.frames canon.frames)
    (actual : Steps profile ready (specDispatch ready base) resumed remaining finish)
    (paired : HostFrame.Related.Paired older start incoming)
    (compare : ShorterCallbackSlices profile ready base bindings (.tau :: labels).length) :
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  obtain ⟨decision, residual, reached, peer, used, pathDecision, run, frontier, decisionWriters⟩ :=
    cutCancelHookDecision (bindings := bindings) async subtask value leftFocus rightFocus site actual
  have writers : VisitorWriterPath profile ready base bindings start incoming (.tau :: (checked ++ decision))
      (.tau :: (canonical ++ decision)) reached peer := by
    simpa only [List.cons_append] using hookWriters.append decisionWriters
  have consumed : labels = (checked ++ decision) ++ residual := by rw [split, used, List.append_assoc]
  have seen : PayloadPrefix.visible (.tau :: (canonical ++ decision)) = PayloadPrefix.visible (.tau :: (checked ++ decision)) := by
    simp only [visibleTauCons, visibleAppend, observed]
  have terminal (stop : residual = [] ∨ (reached.ctl = [] ∧ peer.ctl = [])) :
      CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
    obtain ⟨_, throughDecision, _⟩ := CallbackPrefix.transportAppend caller pathDecision
    refine .inr (callbackTerminalSlice paired ?_)
    rw [consumed]
    exact .cancelDecisionTerminal throughDecision writers seen frontier stop run
  cases frontier with
  | trapped left right _ => exact terminal (.inr ⟨left, right⟩)
  | pending _ _ _ _ _ stop => exact terminal (.inl (stop.resolve_right (fun impossible => impossible.1 trivial)))
  | returned choice left right finalSite =>
    by_cases empty : residual = []
    · exact terminal (.inl empty)
    have throughDecision := (CallbackPrefix.transportAppend path pathDecision).choose_spec.1
    obtain ⟨move, marked, _⟩ := CallbackPrefix.transportAppend caller pathDecision
    have fallback : CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
      rcases classifyReachedGrowth (CallbackPrefix.transportPaths throughDecision none).choose_spec.1.steps with growing | nonGrowing
      · exact .inl ⟨checked ++ decision, .tau :: (canonical ++ decision), residual, reached, peer, consumed,
          ⟨growing, seen, pairComponentFocus left right finalSite, throughDecision, writers⟩, run⟩
      · refine .inr (callbackTerminalSlice paired ?_)
        rw [consumed]
        exact .nonGrowing nonGrowing (pairComponentFocus left right finalSite) marked writers run
    classical
    by_cases active : move mark = some (.active 0 0)
    · by_cases coreTop : ∃ core resume frames, check.frames = .core core resume :: frames
      · obtain ⟨core, resume, frames, leftTop⟩ := coreTop
        obtain ⟨peerFrames, rightTop⟩ := pairedCoreTop framesAligned leftTop
        have checkAt := cursorShape check rfl leftTop
        have canonAt := cursorShape canon threadAligned.symm rightTop
        exact crossReadyCancelCore (thread := check.thread) (core := core) (resume := resume)
          (frames := frames) (rest := check.rest) (peerFrames := peerFrames) (peerRest := canon.rest)
          subtask choice consumed (by simpa only [visibleTauCons] using seen)
          (by simpa only [List.cons_append, List.nil_append, List.map_cons, List.map_nil, active] using marked)
          writers
          (left.trans (congrArg (fun cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) =>
            cursor.control (cancelAfterHookDecision subtask choice)) checkAt))
          (right.trans (congrArg (fun cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) =>
            cursor.control (cancelAfterHookDecision subtask choice)) canonAt))
          ((congrArg₂ (PairedComponentSite older reached peer) checkAt canonAt).mp finalSite) run paired compare empty
      · exact fallback
    · exact fallback

open ReturnFrame.Occurrence in
private theorem classifiedCancelCrossing : CallbackCancelCrossing profile ready base bindings := by
  intro changes start incoming next finish label labels thread core resume frames rest async inst args focused calling step tail paired compare
  obtain ⟨peerFrames, peerRest, leading, suffix, reached, peer, split, ⟨mark, paths⟩, live, residual, frontier, entryWriters⟩ :=
    cutPublicCancelEntry (bindings := bindings) async inst args focused calling step tail paired
  obtain ⟨rfl, used⟩ := List.cons.inj split
  have terminal (stop : suffix = [] ∨ (reached.ctl = [] ∧ peer.ctl = [])) :
      CallbackCrossingAt profile ready base bindings changes start incoming .tau labels finish := by
    refine .inr (callbackTerminalSlice paired ?_)
    rw [used]
    exact .waitTerminal paths entryWriters frontier stop residual
  cases frontier with
  | trapped checked canonical _ => exact terminal (.inr ⟨checked, canonical⟩)
  | pending _ _ _ _ _ stop => exact terminal (.inl (stop.resolve_right (fun impossible => impossible.1 trivial)))
  | returned result checked canonical site =>
    rcases result with ⟨subtask, hook⟩
    cases hook with
    | none =>
      have entry := sharedTopTransport (live (by rw [checked]; exact List.cons_ne_nil _ _)) (frame := .core core resume)
        (by rw [segmentStorage, checked]; rfl) (by rw [segmentStorage, canonical]; rfl)
      obtain ⟨body, remaining, delivered, peerDelivery, consumed, path, actual, outcome, exit, bodyWriters, _⟩ :=
        cutCancelDelivery (bindings := bindings) async subtask checked canonical site residual
      have whole : OccurrenceTransport profile ready base bindings start incoming (.tau :: (leading ++ body))
          (.tau :: (leading ++ body)) delivered peerDelivery :=
        by simpa only [List.nil_append, List.map_nil, List.cons_append] using (CallbackPrefix.transportAppend entry path).choose_spec.1
      have useAll : labels = (leading ++ body) ++ remaining :=
        used.trans ((congrArg (leading ++ ·) consumed).trans (List.append_assoc ..).symm)
      have writers : VisitorWriterPath profile ready base bindings start incoming (.tau :: (leading ++ body))
          (.tau :: (leading ++ body)) delivered peerDelivery := by
        simpa only [List.cons_append] using entryWriters.append bodyWriters
      refine crossFlatCalloutExit useAll exit writers (fun _ _ => whole) (fun stop => callbackTerminalSlice paired ?_) paired
      rw [useAll]
      exact .waitTerminal whole writers outcome stop actual
    | some hook =>
      have entry := live (by rw [checked]; exact List.cons_ne_nil _ _)
      obtain ⟨write, remainder, written, peerWritten, consumed, writePaths, actual, outcome, writeWriters⟩ :=
        cutCancelRequestWrite (bindings := bindings) async subtask hook checked canonical site residual
      obtain ⟨_, prefixPath, _⟩ := CallbackPrefix.transportAppend entry writePaths
      have useAll : labels = (leading ++ write) ++ remainder :=
        used.trans ((congrArg (leading ++ ·) consumed).trans (List.append_assoc ..).symm)
      have terminalWrite (stop : remainder = [] ∨ (written.ctl = [] ∧ peerWritten.ctl = [])) :
          CallbackCrossingAt profile ready base bindings changes start incoming .tau labels finish := by
        refine .inr (callbackTerminalSlice paired ?_)
        rw [useAll]
        exact .waitTerminal prefixPath (entryWriters.append writeWriters) outcome stop actual
      cases outcome with
      | trapped left right _ => exact terminalWrite (.inr ⟨left, right⟩)
      | pending _ _ _ _ _ stop => exact terminalWrite (.inl (stop.resolve_right (fun impossible => impossible.1 trivial)))
      | returned _ left right afterWrite =>
        have bounded : remainder.length ≤ (Label.tau :: labels).length := by
          rw [useAll, List.length_cons, List.length_append]
          omega
        rcases classifyCancelHookWith (bindings := bindings) async subtask hook left right afterWrite actual bounded compare with empty | body
        · exact terminalWrite (.inl empty.1)
        obtain ⟨entryHook, peerHook, ran, ranCanon, trailing, atHook, peerAtHook, hookMark, hookUsed, _, hookPaths,
          hookWriters, observed, tracked, ending, pop⟩ := body
        obtain ⟨_, whole, _⟩ := CallbackPrefix.transportAppend prefixPath hookPaths
        have writers := (entryWriters.append writeWriters).append hookWriters
        have full : labels = ((leading ++ write) ++ .tau :: ran) ++ trailing := by
          rw [useAll, hookUsed]
          simp only [List.append_assoc, List.cons_append]
        have stopped : CallbackSlice profile ready base bindings changes start incoming (.tau :: labels) finish := by
          refine callbackTerminalSlice paired ?_
          rw [full]
          refine .cancelHookBody whole writers ?_ tracked ending
          simp only [List.cons_append, visibleTauCons, visibleAppend, observed]
        classical
        by_cases returns : ∃ (value : Ret (core3 grow)) (cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)),
            atHook.ctl = { cursor with frames := .prog (cancelHookReturn async subtask) :: cursor.frames }.control (.pure value)
        · obtain ⟨value, cursor, returning⟩ := returns
          rcases pop value cursor returning with _ | _ | ⟨remaining, canon, top, popped, _, rest, livePop, frame, _, _, transport⟩
          · exact .inr stopped
          · exact .inr stopped
          subst hookMark
          have initial := sharedTopTransport entry (frame := .core core resume)
            (by rw [segmentStorage, checked]; rfl) (by rw [segmentStorage, canonical]; rfl)
          have prior := (CallbackPrefix.transportAppend initial writePaths).choose_spec.1
          have hookOnly := (CallbackPrefix.transportAppend prior hookPaths).choose_spec.1
          have returned := transport hookOnly
          have originalCaller := transport whole
          let consumed := ((leading ++ write) ++ .tau :: ran) ++ [.tau]
          let canonLabels := ((leading ++ write) ++ .tau :: ranCanon) ++ [.tau]
          have usedAll : labels = consumed ++ remaining := by
            rw [full, popped]
            simp only [consumed, List.append_assoc, List.cons_append, List.nil_append]
          have seen : PayloadPrefix.visible canonLabels = PayloadPrefix.visible consumed := by
            simp only [consumed, canonLabels, visibleTauCons, visibleAppend, observed]
          have popWriters := VisitorWriterPath.framed (profile := profile) (ready := ready) (base := base) (bindings := bindings)
            (.same (.popProg returning) rfl (.done _)) (.same livePop rfl (.done _))
          exact crossCancelAfterHook async subtask value cursor canon usedAll seen returned originalCaller
            (by simpa only [consumed, canonLabels, List.cons_append, PayloadPrefix.Cursor.control] using writers.append popWriters) rfl rfl
            (pairAfterComponentPop (left := atHook) (right := peerAtHook) (program := .pure (.cancel .none)) frame)
            frame.thread frame.frames rest paired compare
        · exact .inr stopped

private theorem coreAcceptRoute {name kind args inst loader}
    (source : LinkedCoreAcceptLoader (grow := grow) bindings name kind args inst loader) (ticket : Nat) :
    route (grow := grow) ticket bindings name kind args =
      (do Scheduled.finish ticket (← admit inst (acceptWith ticket loader))) := by
  cases source with
  | memory _ _ linked =>
    simp only [route, linked, invoke, admit, Scheduled.accept, bne_self_eq_false, Bool.false_eq_true, ite_false]
  | flat _ linked =>
    simp only [route, linked, invoke, admit, bne_self_eq_false, Bool.false_eq_true, ite_false]

private theorem coreAcceptRawEmbedder {name kind args inst loader}
    (source : LinkedCoreAcceptLoader (grow := grow) bindings name kind args inst loader)
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder) :
    (LiveDispatch.host bindings base).embedder name kind args = (Scheduled.host (grow := grow) bindings).embedder name kind args := by
  cases source with
  | memory _ _ linked => simp only [LiveDispatch.host, selectBinding, linked, embedder]
  | flat _ linked => simp only [LiveDispatch.host, selectBinding, linked, embedder]

open ReturnFrame.Occurrence in
private theorem scheduledEntryPath (impl : HostImpl (core3 grow) (HostState sig))
    {name kind args inst} {body : Nat → Session grow sig (Except Scheduled.Issue Nat)} {worker : ThreadId}
    (routed : ∀ ticket, route (grow := grow) ticket bindings name kind args =
      (do Scheduled.finish ticket (← admit inst (body ticket))))
    (embedder : impl.embedder name kind args = (Scheduled.host (grow := grow) bindings).embedder name kind args)
    (check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig))
    (active : check.thread = some worker)
    (caller : Plain.callerInstance start.store (some worker) = .ok (some inst))
    (mayLeave : (start.store.inst? inst).any (·.mayLeave) = true)
    (focused : start.ctl = check.control (calloutBody Limits.spec Quirks.none ready impl start.store check.thread
      (.embedder name kind) args)) :
    FramedQuietPath profile ready (specDispatch ready impl) check start [id, id, id, id, id, id]
      { start with
        host := start.host.enter name kind args
        ctl := check.control (.flat <$> (do Scheduled.finish start.host.nextTicket (← body start.host.nextTicket))) } := by
  have unconfined := Plain.thread_may_leave caller mayLeave
  have atEntry : start.ctl = check.control (do return .flat (← dispatchImport bindings name kind args)) := by
    simpa only [calloutBody, active, unconfined, ite_true, embedder, Scheduled.host] using focused
  cases check with
  | mk elected frames rest =>
    change elected = some worker at active
    subst elected
    let cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, frames, rest⟩
    let selection := body start.host.nextTicket
    let next := fun result => (do return .flat (← Scheduled.finish start.host.nextTicket result) : Session grow sig (Ret (core3 grow)))
    let entered := { start with host := start.host.enter name kind args, ctl := cursor.control (admit inst selection >>= next) }
    have journal : FramedQuietPath profile ready (specDispatch ready impl) cursor start [id, id] entered := by
      simp only [dispatchImport, routed, Prog.bind_eq, Prog.bind_assoc] at atEntry
      refine .step (.hostGet atEntry) (by rw [transitionEdit, atEntry]; rfl) rfl ?_
      exact .step (.hostSet rfl) rfl rfl .done
    have admission := selectorAdmissionPath (profile := profile) (ready := ready) (dispatch := specDispatch ready impl)
      (start := entered) inst worker frames rest selection next rfl caller mayLeave
    simpa only [entered, cursor, selection, next, Functor.map, bind, Prog.bind_eq, Prog.bind_assoc, Prog.pure_eq,
      Function.comp_def, List.cons_append, List.nil_append] using journal.append admission

private def scheduledDenial (store : CStore (core3 grow)) (thread : Option ThreadId) : Nat × Bool :=
  match thread with
  | none => (6, false)
  | some worker =>
    match ArenaField.threads.get? store worker with
    | none => (4, true)
    | some active =>
      if (ArenaField.tasks.get? store active.task).isSome then (8, false) else (5, true)

open ReturnFrame.Occurrence in
private theorem scheduledDenialPath (impl : HostImpl (core3 grow) (HostState sig))
    {name kind args inst} {body : Nat → Session grow sig (Except Scheduled.Issue Nat)}
    (routed : ∀ ticket, route (grow := grow) ticket bindings name kind args =
      (do Scheduled.finish ticket (← admit inst (body ticket))))
    (embedder : impl.embedder name kind args = (Scheduled.host (grow := grow) bindings).embedder name kind args)
    (check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig))
    (denied : ¬ (Plain.callerInstance start.store check.thread = .ok (some inst) ∧
      (start.store.inst? inst).any (·.mayLeave) = true))
    (focused : start.ctl = check.control (calloutBody Limits.spec Quirks.none ready impl start.store check.thread
      (.embedder name kind) args)) :
    let (count, dangling) := scheduledDenial start.store check.thread
    let entered := start.host.enter name kind args
    let reply := completion start.host.nextTicket (.error .wrongContext)
    FramedQuietPath profile ready (specDispatch ready impl) check start (List.replicate count id)
      { start with
        host := if dangling then entered else entered.record reply.1
        ctl := check.control (if dangling then trap (.internal "dangling arena id") else .pure (.flat reply.2)) } := by
  cases check with
  | mk thread frames rest =>
    cases thread with
    | none =>
      simp only [calloutBody, threadMayLeave, instOfThread?, embedder, Scheduled.host,
        PayloadPrefix.Cursor.control, dispatchImport, routed, admit, currentInst?, currentTask?,
        Prog.bind_eq, Prog.bind_assoc] at focused
      refine .step (.hostGet focused) (by rw [transitionEdit, focused]; rfl) rfl ?_
      refine .step (.hostSet rfl) rfl rfl (.step (.currentThread rfl) rfl rfl (.step (.get rfl) rfl rfl ?_))
      exact .step (.hostGet rfl) rfl rfl (.step (.hostSet rfl) rfl rfl .done)
    | some worker =>
      cases liveThread : ArenaField.threads.get? start.store worker with
      | none =>
        have leaves : threadMayLeave start.store (some worker) = true := by
          simp [threadMayLeave, instOfThread?, liveThread]
        simp only [calloutBody, PayloadPrefix.Cursor.control, leaves, ite_true, embedder, Scheduled.host, dispatchImport,
          routed, admit, currentInst?, currentTask?, getThread, getTask, getObj,
          Prog.bind_eq, Prog.bind_assoc] at focused
        simp only [PayloadPrefix.Cursor.control, scheduledDenial, liveThread, List.replicate_succ, List.replicate_zero]
        refine .step (.hostGet focused) (by rw [transitionEdit, focused]; rfl) rfl ?_
        refine .step (.hostSet rfl) rfl rfl (.step (.currentThread rfl) rfl rfl (.step (.get rfl) rfl rfl ?_))
        simp only [id, Prog.bind, liveThread, internalBind]
        exact .done
      | some active =>
        cases liveTask : ArenaField.tasks.get? start.store active.task with
        | none =>
          have leaves : threadMayLeave start.store (some worker) = true := by
            simp [threadMayLeave, instOfThread?, liveThread, liveTask]
          simp only [calloutBody, PayloadPrefix.Cursor.control, leaves, ite_true, embedder, Scheduled.host, dispatchImport,
            routed, admit, currentInst?, currentTask?, getThread, getTask, getObj,
            Prog.bind_eq, Prog.bind_assoc] at focused
          simp only [PayloadPrefix.Cursor.control, scheduledDenial, liveThread, liveTask, Option.isSome_none]
          refine .step (.hostGet focused) (by rw [transitionEdit, focused]; rfl) rfl ?_
          refine .step (.hostSet rfl) rfl rfl (.step (.currentThread rfl) rfl rfl (.step (.get rfl) rfl rfl ?_))
          simp only [id, Prog.bind, liveThread, Prog.pure_eq]
          refine .step (.get rfl) rfl rfl ?_
          simp only [id, Prog.bind, liveTask, internalBind]
          exact .done
        | some task =>
          have refuses : ¬ (task.inst = inst ∧ (start.store.inst? inst).any (·.mayLeave) = true) := by
            simpa [Plain.callerInstance, liveThread, liveTask, pure, Except.pure] using denied
          have guard : (some task.inst != some inst || !((start.store.inst? inst).any (·.mayLeave))) = true := by
            rw [Bool.or_eq_true, bne_iff_ne]
            cases allowed : (start.store.inst? inst).any (·.mayLeave)
            · exact .inr rfl
            · exact .inl (fun same => refuses ⟨Option.some.inj same, allowed⟩)
          simp only [PayloadPrefix.Cursor.control, scheduledDenial, liveThread, liveTask, Option.isSome_some]
          cases leaves : threadMayLeave start.store (some worker)
          all_goals
            simp only [calloutBody, PayloadPrefix.Cursor.control, leaves, Bool.false_eq_true, ite_false, ite_true,
              embedder, Scheduled.host, dispatchImport, routed, admit, currentInst?, currentTask?,
              getThread, getTask, getObj, Prog.bind_eq, Prog.bind_assoc] at focused
            refine .step (.hostGet focused) (by rw [transitionEdit, focused]; rfl) rfl ?_
            refine .step (.hostSet rfl) rfl rfl (.step (.currentThread rfl) rfl rfl (.step (.get rfl) rfl rfl ?_))
            simp only [id, liveThread, Prog.bind]
            refine .step (.get rfl) rfl rfl ?_
            simp only [id, liveTask, Prog.bind]
            refine .step (.get rfl) rfl rfl ?_
            simp only [id, guard, ite_true, Prog.bind, Scheduled.finish, writeCompletion, hostGet, hostSet,
              perform, Prog.lift, Prog.pure_eq]
            exact .step (.hostGet rfl) rfl rfl (.step (.hostSet rfl) rfl rfl .done)

open ReturnFrame.Occurrence in
private theorem finishCoreAcceptCrossing {left right : Config (core3 grow) (HostState sig)} {leftTicket rightTicket : Nat}
    {thread frames rest peerFrames peerRest} {caller : Seg (core3 grow) (HostState sig)} {leading live trailing : Trace grow sig}
    (split : labels = leading ++ trailing)
    (paired : HostFrame.Related.Paired older start incoming)
    (observed : PayloadPrefix.visible live = PayloadPrefix.visible (.tau :: leading))
    (path : OccurrenceTransport profile ready base bindings start incoming (.tau :: leading) live
      left right [some (.active 0 0)])
    (writers : VisitorWriterPath profile ready base bindings start incoming (.tau :: leading) live left right)
    (cut : CoreAcceptCompletionCut profile ready base bindings older left right
      ⟨thread, caller :: frames, rest⟩ ⟨thread, caller :: peerFrames, peerRest⟩
      leftTicket rightTicket trailing finish) :
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  obtain ⟨used, suffix, reached, peer, divided, _, paths, effects, actual, site, ending⟩ := cut
  have total : labels = (leading ++ used) ++ suffix := by rw [split, divided, List.append_assoc]
  have retained := retainComparedOccurrences path paths
  have through := writers.append effects
  have seen : PayloadPrefix.visible (live ++ used) = PayloadPrefix.visible (.tau :: (leading ++ used)) := by
    rw [← List.cons_append, visibleAppend, visibleAppend, observed]
  have stop (reason : suffix = [] ∨ reached.host.writer.accepted ≠ peer.host.writer.accepted ∨
      ∃ beforeLeft beforeRight check canon leftTicket rightTicket tree,
        RegistrationProbeMismatch beforeLeft beforeRight reached peer check canon leftTicket rightTicket none tree) :
      CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
    exact .inr (callbackTerminalSlice paired (by
      rw [total, ← List.cons_append]
      exact .coreAcceptTerminal retained through actual
        (reason.elim Or.inl (fun rest => .inr (rest.elim Or.inl (fun mismatch => .inr (.inl mismatch)))))))
  rcases ending with empty | ⟨words, leftReply, rightReply⟩ | ⟨tree, mismatch⟩
  · exact stop (.inl empty)
  · cases caller with
    | prog resume =>
      cases actual with
      | refl => exact stop (.inl rfl)
      | cons step tail =>
        exact crossDirectGiveRefusal (after := ⟨thread, frames, rest⟩) (canon := ⟨thread, peerFrames, peerRest⟩)
          total (by simpa only [List.cons_append] using retained) (by simpa only [List.cons_append] using through)
          seen paired site leftReply rightReply (.cons step tail)
    | core core resume =>
      rcases cutWaitableCorePop leftReply rightReply site actual with empty |
            ⟨remaining, popped, residual, rejoined, pop, lost⟩
      · exact stop (.inl empty.1)
      · have pops := VisitorWriterPath.framed (profile := profile) (ready := ready) (base := base) (bindings := bindings)
          (.same (.popCore leftReply) rfl (.done _)) (.same (.popCore rightReply) rfl (.done _))
        obtain ⟨move, full, tracks⟩ := CallbackPrefix.transportAppend retained pop
        have removed : move (some (.active 0 0)) = none := by
          have followed := (tracks (some (.active 0 0))).1
          generalize endpoint : move (some (.active 0 0)) = last at followed ⊢
          cases followed with
          | step step tail =>
            cases tail
            rw [transitionEdit, leftReply]
            rfl
        have all := through.append pops
        have finalSplit : labels = ((leading ++ used) ++ [.tau]) ++ remaining := by
          simp only [total, popped, List.append_assoc, List.cons_append, List.nil_append]
        rcases classifyReachedGrowth (CallbackPrefix.transportPaths full none).choose_spec.1.steps with growing | openUpdate
        · let checkedPop := { reached with ctl := ⟨thread,
              .core ((core3 grow).resume reached.store.core core (.values words)) resume, frames⟩ :: rest }
          let rawPop := { peer with ctl := ⟨thread,
              .core ((core3 grow).resume peer.store.core core (.values words)) resume, peerFrames⟩ :: peerRest }
          have unmarked : OccurrenceTransport profile ready base bindings start incoming
              ((.tau :: (leading ++ used)) ++ [.tau]) ((live ++ used) ++ [.tau]) checkedPop rawPop := by
            obtain ⟨next, trails, outside⟩ := full
            refine ⟨next, trails, fun older marks before => ?_⟩
            apply outsideMarks_drop_lost.mp
            simpa only [List.nil_append, List.map_cons, List.map_nil, List.cons_append, removed] using outside older marks before
          have observedPop : PayloadPrefix.visible ((live ++ used) ++ [.tau]) =
              PayloadPrefix.visible (.tau :: ((leading ++ used) ++ [.tau])) := by
            change PayloadPrefix.visible ((live ++ used) ++ [.tau]) =
              PayloadPrefix.visible ((.tau :: (leading ++ used)) ++ [.tau])
            exact (visibleAppend (live ++ used) [.tau]).trans
              ((congrArg (· ++ PayloadPrefix.visible [.tau]) seen).trans
                (visibleAppend (.tau :: (leading ++ used)) [.tau]).symm)
          exact .inl ⟨(leading ++ used) ++ [.tau], (live ++ used) ++ [.tau], remaining,
            checkedPop, rawPop, finalSplit, ⟨by simpa only [List.cons_append] using growing, observedPop, rejoined,
              by simpa only [List.cons_append] using unmarked, by simpa only [List.cons_append] using all⟩, residual⟩
        · exact .inr (callbackTerminalSlice paired (by
            rw [finalSplit, ← List.cons_append, ← List.cons_append]
            exact .nonGrowing openUpdate rejoined full all residual))
  · exact stop (.inr (.inr ⟨left, right, _, _, leftTicket, rightTicket, tree, mismatch⟩))

private def installedAccept (ready : HostReady (HostState sig)) (impl : HostImpl (core3 grow) (HostState sig))
    (state : Config (core3 grow) (HostState sig)) (cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig))
    (name : String) (kind : Silmaril.Wasm.V1.FuncType) (args : List FlatValue) : Config (core3 grow) (HostState sig) :=
  { state with ctl := cursor.control (specDispatch ready impl (.hostCallout (.embedder name kind) args)) }

open ReturnFrame.Occurrence in
private theorem crossAdmittedAcceptBody {worker frames rest peerFrames peerRest name kind args inst loader}
    {callerFrame : Seg (core3 grow) (HostState sig)}
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (source : LinkedCoreAcceptLoader (grow := grow) bindings name kind args inst loader)
    (caller : Plain.callerInstance start.store (some worker) = .ok (some inst))
    (mayLeave : (start.store.inst? inst).any (·.mayLeave) = true)
    (paired : HostFrame.Related.Paired older start incoming) :
    let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, callerFrame :: frames, rest⟩
    let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, callerFrame :: peerFrames, peerRest⟩
    let checked := installedAccept ready base start check name kind args
    let raw := installedAccept ready (LiveDispatch.host bindings base) incoming canon name kind args
    PairedComponentSite older checked raw check canon →
    OccurrenceTransport profile ready base bindings start incoming [.tau] [.tau] checked raw [some (.active 0 0)] →
    Steps profile ready (specDispatch ready base) checked labels finish →
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  classical
  dsimp only
  intro site installed run
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, callerFrame :: frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, callerFrame :: peerFrames, peerRest⟩
  let checked := installedAccept ready base start check name kind args
  let raw := installedAccept ready (LiveDispatch.host bindings base) incoming canon name kind args
  let leftBody := { start with ctl := check.control (calloutBody Limits.spec Quirks.none ready base start.store
    check.thread (.embedder name kind) args) }
  let rightBody := { incoming with ctl := canon.control (calloutBody Limits.spec Quirks.none ready (LiveDispatch.host bindings base)
    incoming.store canon.thread (.embedder name kind) args) }
  have rawEmbedder := coreAcceptRawEmbedder source embedder
  have same : start.store = incoming.store := paired.data.1
  have leftPrelude := directGivePreludePath (profile := profile) (ready := ready) (start := checked) base name kind args check rfl
  have rightPrelude := directGivePreludePath (profile := profile) (ready := ready) (start := raw)
    (LiveDispatch.host bindings base) name kind args canon rfl
  have leftEntry := leftPrelude.append
    (scheduledEntryPath (profile := profile) (ready := ready) (start := leftBody) base (coreAcceptRoute source)
      (congrFun (congrFun (congrFun embedder name) kind) args) check rfl caller mayLeave rfl)
  have rightEntry := rightPrelude.append
    (scheduledEntryPath (profile := profile) (ready := ready) (start := rightBody) (LiveDispatch.host bindings base) (coreAcceptRoute source)
      rawEmbedder canon rfl (same ▸ caller) (same ▸ mayLeave) rfl)
  have installedWriters := frameCalloutStep installed rfl rfl
  have stop {left right : Config (core3 grow) (HostState sig)} {used suffix : Trace grow sig} {marks}
      (split : labels = used ++ suffix)
      (paths : OccurrenceTransport profile ready base bindings start incoming (.tau :: used) (.tau :: used) left right marks)
      (writers : VisitorWriterPath profile ready base bindings start incoming (.tau :: used) (.tau :: used) left right)
      (residual : Steps profile ready (specDispatch ready base) left suffix finish)
      (why : suffix = [] ∨ left.host.writer.accepted ≠ right.host.writer.accepted) :
      CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
    exact .inr (callbackTerminalSlice paired (by
      rw [split, ← List.cons_append]
      exact .coreAcceptTerminal paths writers residual (why.elim Or.inl (fun diff => .inr (.inl diff)))))
  rcases splitSilent (count := 8) (leftEntry.1.track (.active 0 0)).toTrail.steps run with ⟨suffix, split, residual⟩ | short
  · let leftLoad := { start with
      host := start.host.enter name kind args
      ctl := check.control (.flat <$> (do Scheduled.finish start.host.nextTicket (← acceptWith start.host.nextTicket loader))) }
    let rightLoad := { incoming with
      host := incoming.host.enter name kind args
      ctl := canon.control (.flat <$> (do Scheduled.finish incoming.host.nextTicket (← acceptWith incoming.host.nextTicket loader))) }
    have paths : OccurrenceTransport profile ready base bindings start incoming
        (.tau :: List.replicate 8 .tau) (.tau :: List.replicate 8 .tau) leftLoad rightLoad [some (.active 0 0)] :=
      retainInstalledWaitable installed (fun place => ⟨leftEntry.1.track place, rightEntry.1.track place⟩)
    have writers : VisitorWriterPath profile ready base bindings start incoming
        (.tau :: List.replicate 8 .tau) (.tau :: List.replicate 8 .tau) leftLoad rightLoad :=
      installedWriters.append (.framed leftEntry.2 rightEntry.2)
    have entrySite : PairedComponentSite older leftLoad rightLoad check canon := by
      unfold PairedComponentSite HostFrame.Related.Paired HostFrame.replace
      exact pairQuietHost site _
    by_cases history : leftLoad.host.writer.accepted = rightLoad.host.writer.accepted
    · rcases cutCoreAcceptLoad source rfl rfl entrySite history residual with early | ⟨trailing, used, tracked, effects, loadedSite, actual⟩
      · obtain ⟨_, peer, moved, _, framed, _, _⟩ := early
        obtain ⟨_, whole, _⟩ := CallbackPrefix.transportAppend paths moved
        exact stop (by rw [split, List.append_nil])
          (by simpa only [List.cons_append] using whole)
          (by simpa only [List.cons_append] using writers.append framed) (.refl _) (.inl rfl)
      · exact finishCoreAcceptCrossing
          (by rw [split, used, List.append_assoc]) paired (live := .tau :: (_ ++ _)) rfl
          (by simpa only [List.cons_append] using retainComparedOccurrences paths tracked)
          (by simpa only [List.cons_append] using writers.append effects)
          (cutCoreAcceptCompletion rfl rfl loadedSite actual)
    · exact stop split paths writers residual (.inr history)
  · obtain ⟨_, peer, moved, _, framed, _, _⟩ := compareFramedQuietShort leftEntry rightEntry site ⟨_, rfl⟩ ⟨_, rfl⟩ run short
    obtain ⟨_, whole, _⟩ := CallbackPrefix.transportAppend installed moved
    exact stop (List.append_nil _).symm
      (by simpa only [List.singleton_append] using whole)
      (by simpa only [List.singleton_append] using installedWriters.append framed) (.refl _) (.inl rfl)

open ReturnFrame.Occurrence in
private theorem finishCoreAcceptTrap {left right : Config (core3 grow) (HostState sig)} {leading trailing : Trace grow sig}
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)} {reason : TrapReason} {marks}
    (split : labels = leading ++ trailing)
    (paired : HostFrame.Related.Paired older start incoming)
    (paths : OccurrenceTransport profile ready base bindings start incoming (.tau :: leading) (.tau :: leading) left right marks)
    (writers : VisitorWriterPath profile ready base bindings start incoming (.tau :: leading) (.tau :: leading) left right)
    (leftFocus : left.ctl = check.control (trap reason)) (rightFocus : right.ctl = canon.control (trap reason))
    (actual : Steps profile ready (specDispatch ready base) left trailing finish) :
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  have fault : Step profile ready (specDispatch ready base) left (.trap reason) (StepDefs.trapCfg left) := .trap leftFocus
  have rawFault : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) right (.trap reason) (StepDefs.trapCfg right) :=
    .trap rightFocus
  apply Or.inr
  apply callbackTerminalSlice paired
  cases alignLocalBody (.cons fault (.refl _)) actual (by simp [workerBranchLabel]) with
  | inside divided nonempty _ =>
    have empty : trailing = [] := List.length_eq_zero_iff.mp (by
      have size := congrArg List.length divided
      have positive := List.length_pos_iff.mpr nonempty
      simp only [List.length_cons, List.length_nil, List.length_append] at size
      omega)
    rw [split, ← List.cons_append]
    exact .coreAcceptTerminal paths writers actual (.inl empty)
  | @reached remaining taken residual =>
    have lhs : transitionEdit left (.trap reason) = .clear := rfl
    have rhs : transitionEdit right (.trap reason) = .clear := rfl
    have moved : OccurrenceTransport profile ready base bindings left right [.trap reason] [.trap reason]
        (StepDefs.trapCfg left) (StepDefs.trapCfg right) := by
      refine ⟨fun place => place.bind (Edit.clear : Edit (core3 grow) (HostState sig)).follow, ?_, ?_⟩
      · intro place
        exact ⟨.step fault (by rw [lhs]; exact .done _ _), .step rawFault (by rw [rhs]; exact .done _ _)⟩
      · intro previous tracked before
        rw [step_edit fault, step_edit rawFault, lhs, rhs]
        exact before.edit (.clear : Edit (core3 grow) (HostState sig))
    obtain ⟨_, whole, _⟩ := CallbackPrefix.transportAppend paths moved
    have used : .tau :: labels = ((.tau :: leading) ++ [.trap reason]) ++ remaining := by
      rw [split, taken]
      simp only [List.cons_append, List.append_assoc]
    rw [used]
    exact .coreAcceptTerminal whole (writers.append (.framed (.same fault rfl (.done _)) (.same rawFault rfl (.done _))))
      residual (.inr (.inr (.inr ⟨rfl, rfl⟩)))

open ReturnFrame.Occurrence in
private theorem crossDeniedScheduledBody {thread frames rest peerFrames peerRest name kind args inst} {body : Nat → Session grow sig (Except Scheduled.Issue Nat)}
    {callerFrame : Seg (core3 grow) (HostState sig)}
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (rawEmbedder : (LiveDispatch.host bindings base).embedder name kind args = (Scheduled.host (grow := grow) bindings).embedder name kind args)
    (routed : ∀ ticket, route (grow := grow) ticket bindings name kind args =
      (do Scheduled.finish ticket (← admit inst (body ticket))))
    (denied : ¬ (Plain.callerInstance start.store thread = .ok (some inst) ∧
      (start.store.inst? inst).any (·.mayLeave) = true))
    (paired : HostFrame.Related.Paired older start incoming) :
    let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, callerFrame :: frames, rest⟩
    let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, callerFrame :: peerFrames, peerRest⟩
    let checked := installedAccept ready base start check name kind args
    let raw := installedAccept ready (LiveDispatch.host bindings base) incoming canon name kind args
    PairedComponentSite older checked raw check canon →
    OccurrenceTransport profile ready base bindings start incoming [.tau] [.tau] checked raw [some (.active 0 0)] →
    Steps profile ready (specDispatch ready base) checked labels finish →
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  dsimp only
  intro site installed run
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, callerFrame :: frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, callerFrame :: peerFrames, peerRest⟩
  let checked := installedAccept ready base start check name kind args
  let raw := installedAccept ready (LiveDispatch.host bindings base) incoming canon name kind args
  let leftBody := { start with ctl := check.control (calloutBody Limits.spec Quirks.none ready base start.store
    thread (.embedder name kind) args) }
  let rightBody := { incoming with ctl := canon.control (calloutBody Limits.spec Quirks.none ready (LiveDispatch.host bindings base)
    incoming.store thread (.embedder name kind) args) }
  have same : start.store = incoming.store := paired.data.1
  let verdict := scheduledDenial start.store thread
  let ending (state : Config (core3 grow) (HostState sig)) (cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)) :=
    let entered := state.host.enter name kind args
    let reply := completion state.host.nextTicket (.error .wrongContext)
    { state with
      host := if verdict.2 then entered else entered.record reply.1
      ctl := cursor.control (if verdict.2 then trap (.internal "dangling arena id") else .pure (.flat reply.2)) }
  let edits : List (ComponentStoreEdit grow) := [id, id] ++ List.replicate verdict.1 id
  have leftEntry : FramedQuietPath profile ready (specDispatch ready base) check checked edits (ending start check) := by
    refine (directGivePreludePath base name kind args check rfl).append ?_
    exact scheduledDenialPath (start := leftBody) base routed (congrFun (congrFun (congrFun embedder name) kind) args) check denied rfl
  have rightEntry : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon raw edits (ending incoming canon) := by
    refine (directGivePreludePath (LiveDispatch.host bindings base) name kind args canon rfl).append ?_
    have localPath := scheduledDenialPath (profile := profile) (ready := ready) (start := rightBody) (LiveDispatch.host bindings base)
      routed rawEmbedder canon (same ▸ denied) rfl
    have sameDenial : scheduledDenial incoming.store thread = verdict := by rw [← same]
    simpa only [ending, raw, rightBody, installedAccept, canon, sameDenial] using localPath
  have installedWriters := frameCalloutStep installed rfl rfl
  rcases splitSilent (leftEntry.1.track (.active 0 0)).toTrail.steps run with ⟨suffix, split, residual⟩ | short
  · have paths := retainInstalledWaitable installed (fun place => ⟨leftEntry.1.track place, rightEntry.1.track place⟩)
    have writers := installedWriters.append (.framed leftEntry.2 rightEntry.2)
    cases dangling : verdict.2 with
    | false =>
      have pairedReply : PairedComponentSite older (ending start check) (ending incoming canon) check canon := by
        unfold PairedComponentSite HostFrame.Related.Paired HostFrame.replace
        exact pairQuietHost site _
      exact finishCoreAcceptCrossing (leftTicket := start.host.nextTicket) (rightTicket := incoming.host.nextTicket) split paired rfl paths writers
        ⟨[], suffix, _, _, rfl, rfl, fun place => ⟨.done _ place, .done _ place⟩, WriterPaths.empty, residual,
          pairedReply, .inr (.inl ⟨(completion start.host.nextTicket (.error .wrongContext)).2,
            by simp only [ending, dangling, Bool.false_eq_true, ite_false]; rfl,
            by simp only [ending, dangling, Bool.false_eq_true, ite_false]; rfl⟩)⟩
    | true =>
      exact finishCoreAcceptTrap (check := check) (canon := canon) (reason := .internal "dangling arena id")
        split paired paths writers (by simp [ending, dangling]) (by simp [ending, dangling]) residual
  · obtain ⟨_, _, moved, _, framed, _, _⟩ :=
      compareFramedQuietShort leftEntry rightEntry site ⟨_, rfl⟩ ⟨_, rfl⟩ run short
    obtain ⟨_, whole, _⟩ := CallbackPrefix.transportAppend installed moved
    apply Or.inr
    apply callbackTerminalSlice paired
    simpa only [List.singleton_append, List.append_nil] using
      (CallbackSliceEnd.coreAcceptTerminal (changes := older) whole (installedWriters.append framed) (.refl _) (.inl rfl))

open ReturnFrame.Occurrence in
private theorem crossInstalledAccept {thread frames rest peerFrames peerRest name kind args inst loader}
    {callerFrame : Seg (core3 grow) (HostState sig)}
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder)
    (source : LinkedCoreAcceptLoader (grow := grow) bindings name kind args inst loader)
    (paired : HostFrame.Related.Paired older start incoming) :
    let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, callerFrame :: frames, rest⟩
    let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, callerFrame :: peerFrames, peerRest⟩
    let checked := installedAccept ready base start check name kind args
    let raw := installedAccept ready (LiveDispatch.host bindings base) incoming canon name kind args
    PairedComponentSite older checked raw check canon →
    OccurrenceTransport profile ready base bindings start incoming [.tau] [.tau] checked raw [some (.active 0 0)] →
    Steps profile ready (specDispatch ready base) checked labels finish →
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  classical
  dsimp only
  intro site installed run
  by_cases admitted : Plain.callerInstance start.store thread = .ok (some inst) ∧
      (start.store.inst? inst).any (·.mayLeave) = true
  · cases thread with
    | none => simp [Plain.callerInstance] at admitted
    | some worker => exact crossAdmittedAcceptBody embedder source admitted.1 admitted.2 paired site installed run
  · exact crossDeniedScheduledBody embedder (coreAcceptRawEmbedder source embedder) (coreAcceptRoute source) admitted paired site installed run

private theorem classifiedCoreAcceptCrossing
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder) :
    CallbackCoreAcceptCrossing profile ready base bindings := by
  intro older start incoming next finish label labels name kind args inst loader call source step run paired
  cases call with
  | core focus calling =>
    obtain ⟨_, _, rfl, rfl, site, installed, _, _⟩ :=
      cutSharedCalloutInstall (.embedder name kind) args focus calling step paired
    exact crossInstalledAccept embedder source paired site installed run
  | program focus =>
    obtain ⟨_, _, rfl, rfl, site, installed, _, _, _⟩ :=
      cutProgramCallInstall (.prog (.pure (.cancel .none))) focus step paired
    exact crossInstalledAccept embedder source paired site installed run

private theorem sharedNominalBody (action : SharedGiveAction) (inst : InstId) (args : List FlatValue)
    (nominal : ∀ dest, action ≠ .record dest) :
    withTree args (action.selected (grow := grow) (sig := sig) inst) = action.run inst args := by
  cases action with
  | record dest => exact (nominal dest rfl).elim
  | giveOwner _ | dropOwner _ | endpoint _ _ =>
    simp only [withTree, SharedGiveAction.run, SharedGiveAction.selection]
    split
    · simp only [Prog.bind_eq, Prog.bind_assoc]
      congr 1
      funext found
      cases found <;> rfl
    · split
      · rename_i handle position impossible
        exact (impossible handle position rfl).elim
      · rfl

private theorem sharedGiveRoute {name kind args inst} {action : SharedGiveAction}
    (linked : resolveBinding bindings name kind = .ok ⟨name, inst, action.bindingAction⟩) (ticket : Nat) :
    route (grow := grow) ticket bindings name kind args =
      (do Scheduled.finish ticket (← admit inst (action.run inst args))) := by
  cases action with
  | record dest =>
    simp only [route, linked, SharedGiveAction.bindingAction, invoke, admit, SharedGiveAction.run,
      SharedGiveAction.selection, SharedGiveAction.selected, giveRecord, giveToMemory]
    rfl
  | giveOwner resource =>
    rw [← sharedNominalBody (grow := grow) (sig := sig) (.giveOwner resource) inst args (by intro _ equal; cases equal)]
    simp only [route, linked, SharedGiveAction.bindingAction]
    rfl
  | dropOwner resource =>
    rw [← sharedNominalBody (grow := grow) (sig := sig) (.dropOwner resource) inst args (by intro _ equal; cases equal)]
    simp only [route, linked, SharedGiveAction.bindingAction]
    rfl
  | endpoint channel element =>
    rw [← sharedNominalBody (grow := grow) (sig := sig) (.endpoint channel element) inst args (by intro _ equal; cases equal)]
    simp only [route, linked, SharedGiveAction.bindingAction]
    rfl

private theorem sharedGiveRawEmbedder {name kind args inst} {action : SharedGiveAction}
    (linked : resolveBinding bindings name kind = .ok ⟨name, inst, action.bindingAction⟩)
    (embedder : base.embedder = (Scheduled.host (grow := grow) bindings).embedder) :
    (LiveDispatch.host bindings base).embedder name kind args =
      (Scheduled.host (grow := grow) bindings).embedder name kind args := by
  cases action <;> simp only [LiveDispatch.host, selectBinding, linked, SharedGiveAction.bindingAction, embedder]

private def finishSharedSelection (action : SharedGiveAction) (inst : InstId) (ticket : Nat) :
    Except Scheduled.Issue (Stored.OwnedMemory.Tree sig × Nat) → Session grow sig (Ret (core3 grow))
  | .error issue => do return .flat (← Scheduled.finish ticket (.error issue))
  | .ok (tree, position) => action.afterLookup inst ticket position (some tree)

private theorem sharedGiveBeforeSelection (action : SharedGiveAction) (inst : InstId) (args : List FlatValue) (ticket : Nat) :
    (.flat <$> (do Scheduled.finish ticket (← action.run inst args)) : Session grow sig (Ret (core3 grow))) =
      action.selection args >>= finishSharedSelection action inst ticket := by
  simp only [Functor.map, SharedGiveAction.run, Prog.bind_assoc, bind, Prog.pure_eq, Function.comp_def]
  congr 1
  funext verdict
  cases verdict with
  | error => rfl
  | ok value => cases value; rfl

private def selectedAt (position : Nat) (found : Option (Stored.OwnedMemory.Tree sig)) :
    Session grow sig (Except Scheduled.Issue (Stored.OwnedMemory.Tree sig × Nat)) :=
  match found with
  | some tree => pure (.ok (tree, position))
  | _ => pure (.error .badSelection)

private inductive SharedSelectionFrontier :
    Session grow sig (Except Scheduled.Issue (Stored.OwnedMemory.Tree sig × Nat)) → Prop where
  | refused (issue : Scheduled.Issue) : SharedSelectionFrontier (.pure (.error issue))
  | lookup (handle : BitVec IntType.i32.width) (position : Nat) :
      SharedSelectionFrontier (select handle >>= selectedAt position)

private theorem sharedSelectionFrontier (action : SharedGiveAction)
    (args : List FlatValue) (store : CStore (core3 grow)) (thread : Option ThreadId) :
    SharedSelectionFrontier (scanSelector store thread (action.selection (sig := sig) args)).2 := by
  cases action with
  | record dest =>
    simp only [SharedGiveAction.selection, selectMemoryDestination]
    split
    next _ handle pointer =>
      split
      · exact .refused _
      next width =>
        cases checked : dest.check store with
        | error issue =>
          simpa [bind, Prog.bind, getStore, perform, Prog.lift, scanSelector, checked] using
            (SharedSelectionFrontier.refused (grow := grow) (sig := sig) issue)
        | ok valid =>
          have shape : (scanSelector store thread (selectMemoryDestination (sig := sig) dest [.int .i32 handle, pointer])).2 =
              select handle >>= selectedAt (flatNat pointer) := by
            simp [selectMemoryDestination, Execution.Runtime.Value.int, bind, Prog.bind, getStore, perform,
              Prog.lift, scanSelector, select, hostGet, checked, width, selectedAt]
            congr 1
          have frontier : SharedSelectionFrontier
              (scanSelector store thread (selectMemoryDestination (sig := sig) dest [.int .i32 handle, pointer])).2 := by
            rw [shape]
            exact .lookup handle (flatNat pointer)
          simpa [selectMemoryDestination, Execution.Runtime.Value.int, width] using frontier
    next => exact .refused _
  | giveOwner _ | dropOwner _ | endpoint _ _ =>
    simp only [SharedGiveAction.selection]
    split
    next _ handle position =>
      have lookup := SharedSelectionFrontier.lookup (grow := grow) (sig := sig) handle position.toNat
      simp only [select, hostGet, bind, Prog.bind, perform, Prog.lift, scanSelector] at lookup ⊢
      convert lookup using 1
      congr 1
    next => exact .refused _

private theorem sharedSelectionFinishLookup (action : SharedGiveAction) (inst : InstId) (ticket position : Nat)
    (handle : BitVec IntType.i32.width) :
    ((select handle >>= selectedAt position) >>= finishSharedSelection action inst ticket :
      Session grow sig (Ret (core3 grow))) = select handle >>= action.afterLookup inst ticket position := by
  simp only [Prog.bind_eq, Prog.bind_assoc]
  congr 1
  funext found
  cases found <;> rfl

open ReturnFrame.Occurrence in
private theorem finishSharedResultCompared {left right : Config (core3 grow) (HostState sig)} {leftTicket rightTicket : Nat}
    {thread frames rest peerFrames peerRest} {caller : Seg (core3 grow) (HostState sig)}
    {leading live trailing : Trace grow sig} (result : Except Scheduled.Issue Nat)
    (split : labels = leading ++ trailing)
    (paired : HostFrame.Related.Paired older start incoming)
    (observed : PayloadPrefix.visible live = PayloadPrefix.visible (.tau :: leading))
    (path : OccurrenceTransport profile ready base bindings start incoming (.tau :: leading) live
      left right [some (.active 0 0)])
    (writers : VisitorWriterPath profile ready base bindings start incoming (.tau :: leading) live left right)
    (site : PairedComponentSite older left right ⟨thread, caller :: frames, rest⟩ ⟨thread, caller :: peerFrames, peerRest⟩)
    (leftFocus : left.ctl = (PayloadPrefix.Cursor.mk thread (caller :: frames) rest).control
      (do return .flat (← Scheduled.finish leftTicket result)))
    (rightFocus : right.ctl = (PayloadPrefix.Cursor.mk thread (caller :: peerFrames) peerRest).control
      (do return .flat (← Scheduled.finish rightTicket result)))
    (run : Steps profile ready (specDispatch ready base) left trailing finish) :
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  have checked := checkedCompletionPath (profile := profile) (ready := ready) (dispatch := specDispatch ready base)
    (completion leftTicket result) leftFocus
  have raw := checkedCompletionPath (profile := profile) (ready := ready) (dispatch := specDispatch ready (LiveDispatch.host bindings base))
    (completion rightTicket result) rightFocus
  exact finishCoreAcceptCrossing split paired observed path writers (compareCoreAcceptFramed (leftTicket := leftTicket)
    (rightTicket := rightTicket) site checked raw ⟨_, leftFocus⟩ ⟨_, rightFocus⟩ rfl (by cases result <;> rfl) (by
      unfold PairedComponentSite HostFrame.Related.Paired HostFrame.replace at site ⊢
      exact pairQuietHost site _) run)

private theorem finishSharedResult {left right : Config (core3 grow) (HostState sig)} {leftTicket rightTicket : Nat}
    {thread frames rest peerFrames peerRest} {caller : Seg (core3 grow) (HostState sig)}
    {leading trailing : Trace grow sig} (result : Except Scheduled.Issue Nat)
    (split : labels = leading ++ trailing)
    (paired : HostFrame.Related.Paired older start incoming)
    (path : OccurrenceTransport profile ready base bindings start incoming (.tau :: leading) (.tau :: leading)
      left right [some (.active 0 0)])
    (writers : VisitorWriterPath profile ready base bindings start incoming (.tau :: leading) (.tau :: leading) left right)
    (site : PairedComponentSite older left right ⟨thread, caller :: frames, rest⟩ ⟨thread, caller :: peerFrames, peerRest⟩)
    (leftFocus : left.ctl = (PayloadPrefix.Cursor.mk thread (caller :: frames) rest).control
      (do return .flat (← Scheduled.finish leftTicket result)))
    (rightFocus : right.ctl = (PayloadPrefix.Cursor.mk thread (caller :: peerFrames) peerRest).control
      (do return .flat (← Scheduled.finish rightTicket result)))
    (run : Steps profile ready (specDispatch ready base) left trailing finish) :
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish :=
  finishSharedResultCompared result split paired rfl path writers site leftFocus rightFocus run

open Stored.OwnedMemory.Claims Stored.Endpoints in
private def sharedRecordAfterPrepare (cx : LiftLowerContext (core3 grow)) (type : Stored.TypeOf) (value : Value.Val)
    (fields : List RecordLower.Field) (ptr ticket : Nat) :
    Except RecordLower.Issue Unit → Session grow sig (Ret (core3 grow))
  | .error issue => sharedRecordReport ticket (.error issue)
  | .ok () => sharedRecordEmit cx type value fields ptr ticket

open Stored.OwnedMemory.Claims Stored.Endpoints in
private def sharedRecordPrepare (cx : LiftLowerContext (core3 grow)) (type : Stored.TypeOf) (value : Value.Val)
    (fields : List RecordLower.Field) (ptr ticket : Nat) : Session grow sig (Ret (core3 grow)) :=
  .op .get fun store => .op .hostGet fun state =>
    sharedRecordAfterPrepare cx type value fields ptr ticket
      (Record.prepare store state.writer (RecordLower.Field.listObjects fields))

open Stored.OwnedMemory.Claims Stored.Endpoints in
private theorem sharedRecordCode (dest : RecordDestination) (inst : InstId) (ticket ptr : Nat)
    (payload : Σ tag, Stored.OwnedMemory.Payload (sig.payload tag))
    (n : Nat) (children : Fin n → Stored.OwnedMemory.Tree sig) :
    (SharedGiveAction.afterLookup (.record dest) inst ticket ptr (some (.tag payload n children)) :
      Session grow sig (Ret (core3 grow))) =
      match Record.preflight (dest.context (grow := grow) inst) (sig.payload payload.1) payload.2 (.memory ptr) with
      | .error issue => sharedRecordReport ticket (.error issue)
      | .ok (fields, _) => sharedRecordPrepare (dest.context inst) (sig.payload payload.1)
          payload.2.val.value fields ptr ticket := by
  unfold SharedGiveAction.afterLookup SharedGiveAction.selected
  dsimp [Record.lowerRoot, Record.lower, RecordLower.Internal.lowerCompiled, RecordLower.Internal.lowerWithPlan]
  cases Record.preflight (dest.context (grow := grow) inst)
      (sig.payload payload.1) payload.2 (.memory ptr) with
  | error issue =>
    rfl
  | ok plan =>
    obtain ⟨fields, objects⟩ := plan
    simp [sharedRecordPrepare, sharedRecordAfterPrepare, sharedRecordEmit, sharedRecordReport, scheduledReply, Record.authority,
      recordClaims, claims, getStore, hostGet, perform, Prog.lift, bind, Prog.bind, Prog.bind_assoc]
    congr 1
    funext store
    congr 1
    funext host
    cases Record.prepare (show CStore (core3 grow) from store)
      (show HostState sig from host).writer (RecordLower.Field.listObjects fields) with
    | error issue => rfl
    | ok result => cases result; rfl

private def missingSharedPosition (action : SharedGiveAction) (tree : Stored.OwnedMemory.Tree sig)
    (position : Nat) : Prop :=
  match action with
  | .record _ => False
  | .giveOwner _ | .dropOwner _ => (Stored.OwnedMemory.Claims.rootReceipts tree)[position]? = none
  | .endpoint _ _ => (Stored.OwnedMemory.Claims.rootEndpoints tree)[position]? = none

private theorem sharedPositionRefusal (action : SharedGiveAction) (inst : InstId) (ticket position : Nat)
    (tree : Stored.OwnedMemory.Tree sig) (missing : missingSharedPosition action tree position) :
    (action.afterLookup inst ticket position (some tree) : Session grow sig (Ret (core3 grow))) =
      (do return .flat (← Scheduled.finish ticket (.error .badSelection))) := by
  cases action with
  | record _ => exact False.elim missing
  | giveOwner _ | dropOwner _ | endpoint _ _ =>
    simp only [missingSharedPosition] at missing
    simp only [SharedGiveAction.afterLookup, SharedGiveAction.selected, missing, Prog.bind_eq, Prog.pure_eq, Prog.pure_bind']

open Stored.OwnedMemory.Claims in
private theorem sharedClaimProgram (action : SharedGiveAction) (inst : InstId) (ticket position : Nat)
    (tree : Stored.OwnedMemory.Tree sig) {claim : SharedGiveClaim} (selected : action.claimAt tree position = some claim) :
    (action.afterLookup inst ticket position (some tree) : Session grow sig (Ret (core3 grow))) =
      claim.probe inst ticket := by
  have read : (claims (grow := grow) (sig := sig)).read = .op .hostGet (fun state => .pure state.writer) := rfl
  cases action with
  | record _ => cases selected
  | giveOwner resource =>
    cases atPosition : (rootReceipts tree)[position]? with
    | none => simp [SharedGiveAction.claimAt, atPosition] at selected
    | some receipt =>
      have source : SharedGiveClaim.giveOwner resource (receiptId receipt) = claim := by
        simpa [SharedGiveAction.claimAt, atPosition] using selected
      subst claim
      simp only [SharedGiveAction.afterLookup, SharedGiveAction.selected, atPosition, SharedGiveClaim.probe,
        Access.give, read, Prog.bind_eq, Prog.bind_assoc]
      simp only [Prog.bind]
      congr 1
      funext current
      simp only [SharedGiveClaim.observe]
      cases current.writer.prepare resource (receiptId receipt) with
      | error => rfl
      | ok value =>
        cases value
        simp [Except.map, SharedGiveClaim.afterRead, SharedGiveClaim.admitted, Prog.bind_assoc, Except.mapError]
  | dropOwner resource =>
    cases atPosition : (rootReceipts tree)[position]? with
    | none => simp [SharedGiveAction.claimAt, atPosition] at selected
    | some receipt =>
      have source : SharedGiveClaim.dropOwner resource (receiptId receipt) = claim := by
        simpa [SharedGiveAction.claimAt, atPosition] using selected
      subst claim
      simp only [SharedGiveAction.afterLookup, SharedGiveAction.selected, atPosition, SharedGiveClaim.probe,
        Access.drop, read, Prog.bind_eq, Prog.bind_assoc]
      simp only [Prog.bind]
      congr 1
      funext current
      simp only [SharedGiveClaim.observe]
      cases current.writer.prepare resource (receiptId receipt) with
      | error => rfl
      | ok value =>
        cases value
        simp [Except.map, SharedGiveClaim.afterRead, SharedGiveClaim.admitted, Prog.bind_assoc, Except.mapError]
        congr 1
        funext caller
        congr 1
        funext request
        cases request with
        | none =>
          simp only [internal, trap, Prog.bind]
          congr 1
          funext impossible
          cases impossible
        | some request => simp [Prog.bind_assoc]
  | endpoint channel element =>
    cases atPosition : (rootEndpoints tree)[position]? with
    | none => simp [SharedGiveAction.claimAt, atPosition] at selected
    | some id =>
      have source : SharedGiveClaim.endpoint channel element id = claim := by
        simpa [SharedGiveAction.claimAt, atPosition] using selected
      subst claim
      simp only [SharedGiveAction.afterLookup, SharedGiveAction.selected, atPosition, SharedGiveClaim.probe,
        Access.giveEndpoint, read, Prog.bind_eq, Prog.bind_assoc]
      simp only [Prog.bind]
      congr 1
      funext current
      simp only [SharedGiveClaim.observe]
      cases current.writer.spendEndpoint id with
      | error => rfl
      | ok value =>
        simp only [SharedGiveClaim.afterRead, SharedGiveClaim.admitted, Except.map, Prog.bind_eq,
          getStore, perform, Prog.lift]
        simp only [Prog.bind]
        congr 1
        funext store
        change CStore (core3 grow) at store
        let next : Session grow sig (Except Scheduled.Issue Nat) := do
          match Async.Transfer.readyToGive store channel element ⟨id⟩ with
          | .error issue => return .error (.claim (.endpointTransfer issue))
          | .ok () =>
            claims.spend (.endpoint id)
            return .ok (← lowerAsyncValue Limits.spec (channel.endKind .read) { opts := {}, inst } id)
        change _ = (do return Ret.flat (← Scheduled.finish ticket (← next)) : Session grow sig (Ret (core3 grow)))
        dsimp only [next]
        cases Async.Transfer.readyToGive store channel element ⟨id⟩ with
        | error => rfl
        | ok accepted => cases accepted; simp [Prog.bind_assoc, Except.mapError]

private theorem sharedHandleInsertEffects (inst : InstId) (entry : HandleEntry) :
    StoreEffects (handlesAdd inst entry : Session grow sig Nat) := by
  unfold handlesAdd getInst
  refine (storeEffectGetObject ArenaField.insts inst).bind fun state => ?_
  cases state.addHandle? entry with
  | none => exact storeEffectTrap _
  | some result => exact (storeEffectModify _).bind fun _ => .pure _

private theorem sharedEndpointTransferEffects (site : SharedEndpointGive) :
    StoreEffects (site.transfer : Session grow sig Nat) := by
  unfold SharedEndpointGive.transfer lowerAsyncValue
  exact (storeEffectModify _).bind fun _ => (sharedHandleInsertEffects _ _).bind fun _ =>
    (storeEffectModify _).bind fun _ => .pure _

open ReturnFrame.Occurrence in
private theorem crossSharedStoreTransfer {left right : Config (core3 grow) (HostState sig)}
    {thread frames rest peerFrames peerRest} {callerFrame : Seg (core3 grow) (HostState sig)}
    {leftTicket rightTicket} {leading trailing : Trace grow sig} (body : Session grow sig Nat) (effects : StoreEffects body)
    (split : labels = leading ++ trailing)
    (paired : HostFrame.Related.Paired older start incoming)
    (paths : OccurrenceTransport profile ready base bindings start incoming (.tau :: leading) (.tau :: leading)
      left right [some (.active 0 0)])
    (writers : VisitorWriterPath profile ready base bindings start incoming (.tau :: leading) (.tau :: leading) left right)
    (site : PairedComponentSite older left right ⟨thread, callerFrame :: frames, rest⟩ ⟨thread, callerFrame :: peerFrames, peerRest⟩)
    (leftFocus : left.ctl = (PayloadPrefix.Cursor.mk thread (callerFrame :: frames) rest).control (body >>= fun slot => scheduledReply leftTicket (.ok slot)))
    (rightFocus : right.ctl = (PayloadPrefix.Cursor.mk thread (callerFrame :: peerFrames) peerRest).control (body >>= fun slot => scheduledReply rightTicket (.ok slot)))
    (run : Steps profile ready (specDispatch ready base) left trailing finish) :
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, callerFrame :: frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, callerFrame :: peerFrames, peerRest⟩
  obtain ⟨used, suffix, reached, peer, divided, localPaths, residual, boundary, _, _, checkedPath, rawPath, stationary⟩ :=
    cutComponentStoreBodyFramed (bindings := bindings) (closed := True) body
      (fun slot => scheduledReply leftTicket (.ok slot)) (fun slot => scheduledReply rightTicket (.ok slot))
      (fun _ => effects) (trivialPreserves _) trivial leftFocus rightFocus site run
  have usedAll : labels = (leading ++ used) ++ suffix := by rw [split, divided, List.append_assoc]
  have traced : VisitorWriterPath profile ready base bindings start incoming (.tau :: (leading ++ used))
      (.tau :: (leading ++ used)) reached peer := by
    simpa only [List.cons_append] using writers.append (.framed checkedPath rawPath)
  have stop (terminal : suffix = [] ∨ (reached.ctl = [] ∧ peer.ctl = [])) :
      CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
    obtain ⟨_, transported, _⟩ := CallbackPrefix.transportAppend paths localPaths
    exact .inr (callbackTerminalSlice paired (by
      rw [usedAll, ← List.cons_append]
      exact .coreAcceptTerminal (by simpa only [List.cons_append] using transported) traced residual
        (terminal.elim Or.inl (fun trapped => .inr (.inr (.inr trapped))))))
  cases boundary with
  | pending op next checked raw frame normal =>
    exact stop (.inl (normal.resolve_right (fun unsupported => unsupported.1 trivial)))
  | trapped checked raw frame => exact stop (.inr ⟨checked, raw⟩)
  | returned slot checked raw frame =>
    have retained := retainComparedOccurrences paths (stationary (by
      rw [checked]
      cases check
      exact List.cons_ne_nil _ _)).2
    exact finishSharedResult (leftTicket := leftTicket) (rightTicket := rightTicket) (.ok slot) usedAll
      paired (by simpa only [List.cons_append] using retained) traced frame checked raw residual

private theorem sharedEndpointReadyCode (endpoint : SharedEndpointGive) (ticket : Nat) :
    (endpoint.claim.afterRead endpoint.inst ticket (.ok ()) : Session grow sig (Ret (core3 grow))) =
      endpoint.checkedStore ticket := by
  let execute (store : CStore (core3 grow)) : Session grow sig (Except Scheduled.Issue Nat) :=
    match Async.Transfer.readyToGive store endpoint.channel endpoint.element ⟨endpoint.identity⟩ with
    | .error issue => pure (.error (.claim (.endpointTransfer issue)))
    | .ok () => do
      claims.spend (.endpoint endpoint.identity)
      return .ok (← endpoint.transfer)
  let follow (store : CStore (core3 grow)) : Session grow sig (Ret (core3 grow)) :=
    execute store >>= scheduledReply ticket
  change (.op .get follow : Session grow sig (Ret (core3 grow))) = endpoint.checkedStore ticket
  unfold SharedEndpointGive.checkedStore
  congr 1
  funext store
  change CStore (core3 grow) at store
  unfold follow execute SharedEndpointGive.afterReady
  cases Async.Transfer.readyToGive store endpoint.channel endpoint.element ⟨endpoint.identity⟩ with
  | error issue => rfl
  | ok allowed =>
    cases allowed
    simp [SharedEndpointGive.spend, SharedEndpointGive.afterSpend, Prog.bind_assoc]

open Stored.OwnedMemory.Claims in
private theorem sharedEndpointLive {writer : Stored.OwnedMemory.Claims.State sig} (endpoint : SharedEndpointGive)
    (admitted : endpoint.claim.observe writer = .ok ()) :
    endpoint.identity ∈ writer.endpoints := by
  by_contra absent
  simp [SharedEndpointGive.claim, SharedGiveClaim.observe, State.spendEndpoint, absent, Except.map] at admitted

open ReturnFrame.Occurrence Stored.OwnedMemory.Claims in
private theorem crossSharedEndpointReady {left right checked raw : Config (core3 grow) (HostState sig)}
    {thread frames rest peerFrames peerRest} {callerFrame : Seg (core3 grow) (HostState sig)}
    {leftTicket rightTicket} {leading remaining : Trace grow sig}
    (endpoint : SharedEndpointGive)
    (split : labels = leading ++ .tau :: remaining)
    (paired : HostFrame.Related.Paired older start incoming)
    (paths : OccurrenceTransport profile ready base bindings start incoming (.tau :: leading) (.tau :: leading)
      left right [some (.active 0 0)])
    (writers : VisitorWriterPath profile ready base bindings start incoming (.tau :: leading) (.tau :: leading) left right)
    (before : PairedComponentSite older left right ⟨thread, callerFrame :: frames, rest⟩ ⟨thread, callerFrame :: peerFrames, peerRest⟩)
    (leftFocus : left.ctl = (PayloadPrefix.Cursor.mk thread (callerFrame :: frames) rest).control (endpoint.claim.probe endpoint.inst leftTicket))
    (rightFocus : right.ctl = (PayloadPrefix.Cursor.mk thread (callerFrame :: peerFrames) peerRest).control (endpoint.claim.probe endpoint.inst rightTicket))
    (leftLive : endpoint.claim.observe left.host.writer = .ok ())
    (rightLive : endpoint.claim.observe right.host.writer = .ok ())
    (leftGuard : checked = { left with
      ctl := (PayloadPrefix.Cursor.mk thread (callerFrame :: frames) rest).control (endpoint.checkedStore leftTicket) })
    (rightGuard : raw = { right with
      ctl := (PayloadPrefix.Cursor.mk thread (callerFrame :: peerFrames) peerRest).control (endpoint.checkedStore rightTicket) })
    (guard : Step profile ready (specDispatch ready base) left .tau checked)
    (peerGuard : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) right .tau raw)
    (run : Steps profile ready (specDispatch ready base) checked remaining finish) :
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, callerFrame :: frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, callerFrame :: peerFrames, peerRest⟩
  subst checked
  subst raw
  let checked := { left with ctl := check.control (endpoint.checkedStore leftTicket) }
  let raw := { right with ctl := canon.control (endpoint.checkedStore rightTicket) }
  have same : left.store = right.store := (HostFrame.Related.Paired.data before).1
  have frame : PairedComponentSite older checked raw check canon := by
    unfold PairedComponentSite HostFrame.Related.Paired HostFrame.replace at before ⊢
    exact before
  have guards : OccurrenceTransport profile ready base bindings start incoming
      (.tau :: (leading ++ [.tau])) (.tau :: (leading ++ [.tau])) checked raw [some (.active 0 0)] := by
    simpa only [List.cons_append] using retainComparedOccurrences paths (fun place =>
      ⟨Prefix.step guard (by rw [transitionEdit, leftFocus]; cases place <;> rfl) (.done _ _),
       Prefix.step peerGuard (by rw [transitionEdit, rightFocus]; cases place <;> rfl) (.done _ _)⟩)
  have guardedWriters : VisitorWriterPath profile ready base bindings start incoming
      (.tau :: (leading ++ [.tau])) (.tau :: (leading ++ [.tau])) checked raw := by
    simpa only [List.cons_append] using writers.append (.framed (.same guard rfl (.done _)) (.same peerGuard rfl (.done _)))
  let leftReady := { checked with ctl := check.control (endpoint.afterReady leftTicket left.store) }
  let rightReady := { raw with ctl := canon.control (endpoint.afterReady rightTicket right.store) }
  have readiness : Step profile ready (specDispatch ready base) checked .tau leftReady := .get rfl
  have peerReadiness : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) raw .tau rightReady := .get rfl
  have early {edits : List (ComponentStoreEdit grow)} {reached peer}
      (lhs : FramedQuietPath profile ready (specDispatch ready base) check checked edits reached)
      (rhs : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon raw edits peer)
      (short : remaining.length < edits.length) :
      CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
    obtain ⟨_, _, moved, _, pairedWriters, _, _⟩ :=
      compareFramedQuietShort lhs rhs frame ⟨_, rfl⟩ ⟨_, rfl⟩ run short
    obtain ⟨_, through, _⟩ := CallbackPrefix.transportAppend guards moved
    exact .inr (callbackTerminalSlice paired (by
      rw [split]
      simpa only [List.cons_append, List.singleton_append, List.append_assoc, List.append_nil, List.nil_append] using
        (CallbackSliceEnd.coreAcceptTerminal (changes := older) through (guardedWriters.append pairedWriters)
          (.refl _) (.inl rfl))))
  cases verdict : Async.Transfer.readyToGive left.store endpoint.channel endpoint.element ⟨endpoint.identity⟩ with
  | error issue =>
    have leftPath : FramedQuietPath profile ready (specDispatch ready base) check checked [id] leftReady :=
      .step readiness rfl rfl .done
    have rightPath : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon raw [id] rightReady :=
      .step peerReadiness rfl rfl .done
    rcases splitSilent (leftPath.1.track (.active 0 0)).toTrail.steps run with ⟨suffix, crossed, residual⟩ | short
    · have used : labels = ((leading ++ [.tau]) ++ [.tau]) ++ suffix := by
        rw [split, crossed]
        simp only [List.append_assoc, List.length_cons, List.length_nil, List.replicate_succ,
          List.replicate_zero, List.cons_append, List.nil_append]
      have moved := retainComparedOccurrences guards (fun place => ⟨leftPath.1.track place, rightPath.1.track place⟩)
      have traced := guardedWriters.append (.framed leftPath.2 rightPath.2)
      exact finishSharedResult (leftTicket := leftTicket) (rightTicket := rightTicket) (.error (.claim (.endpointTransfer issue)))
        used paired moved traced
        (by unfold PairedComponentSite HostFrame.Related.Paired HostFrame.replace at frame ⊢; exact frame)
        (by simp only [leftReady, SharedEndpointGive.afterReady, verdict]; rfl)
        (by simp only [rightReady, SharedEndpointGive.afterReady, ← same, verdict]; rfl) residual
    · exact early leftPath rightPath short
  | ok valid =>
    cases valid
    let lhsSpend := { checked with ctl := check.control (endpoint.spend leftTicket) }
    let rhsSpend := { raw with ctl := canon.control (endpoint.spend rightTicket) }
    have lhsReady : leftReady = lhsSpend := by simp only [leftReady, lhsSpend, SharedEndpointGive.afterReady, verdict]
    have rhsReady : rightReady = rhsSpend := by simp only [rightReady, rhsSpend, SharedEndpointGive.afterReady, ← same, verdict]
    let lhsWrite := { lhsSpend with ctl := check.control (.op (.hostSet
      { lhsSpend.host with writer := (Spend.endpoint endpoint.identity).apply lhsSpend.host.writer })
      (fun _ => endpoint.afterSpend leftTicket)) }
    let rhsWrite := { rhsSpend with ctl := canon.control (.op (.hostSet
      { rhsSpend.host with writer := (Spend.endpoint endpoint.identity).apply rhsSpend.host.writer })
      (fun _ => endpoint.afterSpend rightTicket)) }
    let writeAfter (ticket : Nat) (state : HostState sig) : Session grow sig (Ret (core3 grow)) :=
      .op (.hostSet { state with writer := (Spend.endpoint endpoint.identity).apply state.writer })
        (fun _ => endpoint.afterSpend ticket)
    have read : Step profile ready (specDispatch ready base) lhsSpend .tau lhsWrite :=
      .hostGet (th := check.thread) (segs := check.frames) (rest := check.rest) (k := writeAfter leftTicket) rfl
    have rawRead : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) rhsSpend .tau rhsWrite :=
      .hostGet (th := canon.thread) (segs := canon.frames) (rest := canon.rest) (k := writeAfter rightTicket) rfl
    have checkedReady : Step profile ready (specDispatch ready base) checked .tau lhsSpend := lhsReady ▸ readiness
    have rawReady : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) raw .tau rhsSpend :=
      rhsReady ▸ peerReadiness
    have leftPath : FramedQuietPath profile ready (specDispatch ready base) check checked [id, id] lhsWrite :=
      .step checkedReady rfl rfl (.step read rfl rfl .done)
    have rightPath : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon raw [id, id] rhsWrite :=
      .step rawReady rfl rfl (.step rawRead rfl rfl .done)
    rcases splitSilent (count := 2) (leftPath.1.track (.active 0 0)).toTrail.steps run with ⟨suffix, crossed, residual⟩ | short
    · have beforeCommit := retainComparedOccurrences guards (fun place => ⟨leftPath.1.track place, rightPath.1.track place⟩)
      have view {beforeState afterState : Config (core3 grow) (HostState sig)} {remaining : Trace grow sig}
          (ran : Steps profile ready (specDispatch ready base) beforeState remaining afterState) :
          (remaining = [] ∧ afterState = beforeState) ∨ ∃ action tail reached,
            remaining = action :: tail ∧ Step profile ready (specDispatch ready base) beforeState action reached ∧
              Steps profile ready (specDispatch ready base) reached tail afterState := by
        cases ran with
        | refl => exact .inl ⟨rfl, rfl⟩
        | cons first later => exact .inr ⟨_, _, _, rfl, first, later⟩
      rcases view residual with ⟨finite, stopped⟩ | ⟨action, tail, _, used, step, residual⟩
      · exact .inr (callbackTerminalSlice paired (by
          rw [split, crossed, finite, stopped]
          simpa only [List.append_nil, List.cons_append, List.singleton_append, List.append_assoc, List.replicate_succ,
            List.replicate_zero, List.length_cons, List.length_nil, List.nil_append] using
            (CallbackSliceEnd.coreAcceptTerminal (changes := older) beforeCommit
              (guardedWriters.append (.framed leftPath.2 rightPath.2)) (.refl _) (.inl rfl))))
      · let leftDone := { lhsWrite with
          host := { lhsWrite.host with writer := (Spend.endpoint endpoint.identity).apply lhsWrite.host.writer }
          ctl := check.control (endpoint.afterSpend leftTicket) }
        let rightDone := { rhsWrite with
          host := { rhsWrite.host with writer := (Spend.endpoint endpoint.identity).apply rhsWrite.host.writer }
          ctl := canon.control (endpoint.afterSpend rightTicket) }
        have commit : Step profile ready (specDispatch ready base) lhsWrite .tau leftDone :=
          .hostSet (th := check.thread) (segs := check.frames) (rest := check.rest)
            (s := leftDone.host) (k := fun _ => endpoint.afterSpend leftTicket) rfl
        have peerCommit : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) rhsWrite .tau rightDone :=
          .hostSet (th := canon.thread) (segs := canon.frames) (rest := canon.rest)
            (s := rightDone.host) (k := fun _ => endpoint.afterSpend rightTicket) rfl
        obtain ⟨rfl, rfl⟩ := silentStepUnique commit step
        have certified : ExecutedSharedEndpointSpend profile ready (specDispatch ready base) endpoint leftTicket left leftDone :=
          ⟨check, checked, lhsSpend, lhsWrite, leftFocus, sharedEndpointLive endpoint leftLive, verdict,
            rfl, rfl, rfl, rfl, guard, checkedReady, read, commit⟩
        have rawCertified : ExecutedSharedEndpointSpend profile ready (specDispatch ready (LiveDispatch.host bindings base))
            endpoint rightTicket right rightDone :=
          ⟨canon, raw, rhsSpend, rhsWrite, rightFocus, sharedEndpointLive endpoint rightLive, same ▸ verdict,
            rfl, rfl, rfl, rfl, peerGuard, rawReady, rawRead, peerCommit⟩
        have leadingUsed : labels = (leading ++ [.tau, .tau, .tau, .tau]) ++ tail := by
          rw [split, crossed, used]
          simp only [List.replicate_succ, List.replicate_zero, List.nil_append, List.append_assoc, List.cons_append]
        have moved := retainComparedOccurrences beforeCommit (fun place =>
          ⟨Prefix.step commit (by cases place <;> rfl) (.done _ _),
           Prefix.step peerCommit (by cases place <;> rfl) (.done _ _)⟩)
        have traced := writers.append (.endpointCommit certified rawCertified)
        exact crossSharedStoreTransfer (leftTicket := leftTicket) (rightTicket := rightTicket) endpoint.transfer
          (sharedEndpointTransferEffects endpoint) leadingUsed paired
          (by simpa only [List.cons_append, List.length_cons, List.length_nil, List.replicate_succ, List.replicate_zero,
            List.singleton_append, List.append_assoc, List.nil_append] using moved)
          (by simpa only [List.cons_append] using traced)
          (by
            unfold PairedComponentSite HostFrame.Related.Paired HostFrame.replace at frame ⊢
            exact pairQuietHost frame _) rfl rfl residual
    · exact early leftPath rightPath short

private theorem sharedOwnerTransferEffects (site : SharedOwnerGive) (rep : Nat) :
    StoreEffects (site.transfer rep : Session grow sig Nat) := by
  unfold SharedOwnerGive.transfer lowerOwn addResHandle allocObj
  refine Prog.Every.bind (storeEffectGet.bind fun _ => (storeEffectModify _).bind fun _ => .pure _) ?_
  intro identity
  exact sharedHandleInsertEffects site.inst (.resource identity)

private theorem sharedOwnerSpendCode (owner : SharedOwnerGive) (rep ticket : Nat) :
    (owner.claim.afterRead owner.inst ticket (.ok rep) : Session grow sig (Ret (core3 grow))) =
      owner.spend rep ticket := by
  simp [SharedOwnerGive.claim, SharedGiveClaim.afterRead, SharedGiveClaim.admitted, Stored.OwnedMemory.Claims.commitOwner,
    SharedOwnerGive.spend, SharedOwnerGive.afterSpend, SharedOwnerGive.transfer, scheduledReply, Prog.bind_assoc]

open Stored.OwnedMemory.Claims in
private theorem reachedOwnerPrepared (resource : RtId) (identity : HandleObjId)
    {writer : Stored.OwnedMemory.Claims.State sig} {rep : Nat}
    (admitted : (writer.prepare resource identity).map Prod.fst = .ok rep) :
    ∃ spent, writer.prepare resource identity = .ok (rep, spent) := by
  cases prepared : writer.prepare resource identity with
  | error issue => simp [prepared, Except.map] at admitted
  | ok result =>
    rcases result with ⟨representation, spent⟩
    simp only [prepared, Except.map, Except.ok.injEq] at admitted
    subst representation
    exact ⟨spent, rfl⟩

private theorem stepsAtEmpty {dispatch : Call (core3 grow) → Session grow sig (Ret (core3 grow))}
    {beforeState afterState : Config (core3 grow) (HostState sig)}
    (run : Steps profile ready dispatch beforeState [] afterState) : afterState = beforeState := by
  cases run
  rfl

open ReturnFrame.Occurrence Stored.OwnedMemory.Claims in
private theorem crossSharedOwnerSpend {left right checked raw : Config (core3 grow) (HostState sig)}
    {thread frames rest peerFrames peerRest} {callerFrame : Seg (core3 grow) (HostState sig)}
    {leftTicket rightTicket rep} {leading remaining : Trace grow sig}
    (owner : SharedOwnerGive)
    (split : labels = leading ++ .tau :: remaining)
    (paired : HostFrame.Related.Paired older start incoming)
    (paths : OccurrenceTransport profile ready base bindings start incoming (.tau :: leading) (.tau :: leading)
      left right [some (.active 0 0)])
    (writers : VisitorWriterPath profile ready base bindings start incoming (.tau :: leading) (.tau :: leading) left right)
    (before : PairedComponentSite older left right ⟨thread, callerFrame :: frames, rest⟩ ⟨thread, callerFrame :: peerFrames, peerRest⟩)
    (leftFocus : left.ctl = (PayloadPrefix.Cursor.mk thread (callerFrame :: frames) rest).control (owner.claim.probe owner.inst leftTicket))
    (rightFocus : right.ctl = (PayloadPrefix.Cursor.mk thread (callerFrame :: peerFrames) peerRest).control (owner.claim.probe owner.inst rightTicket))
    (leftLive : owner.claim.observe left.host.writer = .ok rep)
    (rightLive : owner.claim.observe right.host.writer = .ok rep)
    (leftGuard : checked = { left with
      ctl := (PayloadPrefix.Cursor.mk thread (callerFrame :: frames) rest).control (owner.spend rep leftTicket) })
    (rightGuard : raw = { right with
      ctl := (PayloadPrefix.Cursor.mk thread (callerFrame :: peerFrames) peerRest).control (owner.spend rep rightTicket) })
    (guard : Step profile ready (specDispatch ready base) left .tau checked)
    (peerGuard : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) right .tau raw)
    (run : Steps profile ready (specDispatch ready base) checked remaining finish) :
    CallbackCrossingAt profile ready base bindings older start incoming .tau labels finish := by
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, callerFrame :: frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, callerFrame :: peerFrames, peerRest⟩
  subst checked
  subst raw
  let checked := { left with ctl := check.control (owner.spend rep leftTicket) }
  let raw := { right with ctl := canon.control (owner.spend rep rightTicket) }
  have frame : PairedComponentSite older checked raw check canon := by
    unfold PairedComponentSite HostFrame.Related.Paired HostFrame.replace at before ⊢
    exact before
  have guards := retainComparedOccurrences paths (fun place =>
    ⟨Prefix.step guard (by rw [transitionEdit, leftFocus]; cases place <;> rfl) (.done _ _),
     Prefix.step peerGuard (by rw [transitionEdit, rightFocus]; cases place <;> rfl) (.done _ _)⟩)
  have guardedWriters := writers.append (.framed (.same guard rfl (.done _)) (.same peerGuard rfl (.done _)))
  let spendHost (host : HostState sig) : HostState sig :=
    { host with writer := (Spend.owner owner.identity).apply host.writer }
  let writeAfter (ticket : Nat) (host : HostState sig) : Session grow sig (Ret (core3 grow)) :=
    .op (.hostSet (spendHost host)) (fun _ => owner.afterSpend rep ticket)
  let leftWrite := { checked with ctl := check.control (writeAfter leftTicket checked.host) }
  let rightWrite := { raw with ctl := canon.control (writeAfter rightTicket raw.host) }
  have read : Step profile ready (specDispatch ready base) checked .tau leftWrite :=
    .hostGet (th := check.thread) (segs := check.frames) (rest := check.rest) (k := writeAfter leftTicket) rfl
  have peerRead : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) raw .tau rightWrite :=
    .hostGet (th := canon.thread) (segs := canon.frames) (rest := canon.rest) (k := writeAfter rightTicket) rfl
  have leftPath : FramedQuietPath profile ready (specDispatch ready base) check checked [id] leftWrite :=
    .step read rfl rfl .done
  have rightPath : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon raw [id] rightWrite :=
    .step peerRead rfl rfl .done
  rcases splitSilent (count := 1) (leftPath.1.track (.active 0 0)).toTrail.steps run with ⟨suffix, crossed, residual⟩ | short
  · have beforeCommit := retainComparedOccurrences guards (fun place => ⟨leftPath.1.track place, rightPath.1.track place⟩)
    let leftDone := { leftWrite with
      host := spendHost leftWrite.host
      ctl := check.control (owner.afterSpend rep leftTicket) }
    let rightDone := { rightWrite with
      host := spendHost rightWrite.host
      ctl := canon.control (owner.afterSpend rep rightTicket) }
    have commit : Step profile ready (specDispatch ready base) leftWrite .tau leftDone :=
      .hostSet (th := check.thread) (segs := check.frames) (rest := check.rest)
        (s := leftDone.host) (k := fun _ => owner.afterSpend rep leftTicket) rfl
    have peerCommit : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) rightWrite .tau rightDone :=
      .hostSet (th := canon.thread) (segs := canon.frames) (rest := canon.rest)
        (s := rightDone.host) (k := fun _ => owner.afterSpend rep rightTicket) rfl
    rcases splitSilent (count := 1) (.cons commit (.refl _)) residual with ⟨tail, committed, continuation⟩ | short
    · obtain ⟨leftSpent, leftPrepared⟩ := reachedOwnerPrepared owner.resource owner.identity leftLive
      obtain ⟨rightSpent, rightPrepared⟩ := reachedOwnerPrepared owner.resource owner.identity rightLive
      have certified : ExecutedSharedOwnerSpend profile ready (specDispatch ready base) owner rep leftTicket left leftDone :=
        ⟨check, checked, leftWrite, leftSpent, leftFocus, leftPrepared, rfl, rfl, rfl, guard, read, commit⟩
      have rawCertified : ExecutedSharedOwnerSpend profile ready (specDispatch ready (LiveDispatch.host bindings base))
          owner rep rightTicket right rightDone :=
        ⟨canon, raw, rightWrite, rightSpent, rightFocus, rightPrepared, rfl, rfl, rfl, peerGuard, peerRead, peerCommit⟩
      have leadingUsed : labels = (leading ++ [.tau, .tau, .tau]) ++ tail := by
        rw [split, crossed, committed]
        simp only [List.replicate_succ, List.replicate_zero, List.nil_append, List.append_assoc, List.cons_append]
      have moved := retainComparedOccurrences beforeCommit (fun place =>
        ⟨Prefix.step commit (by cases place <;> rfl) (.done _ _),
         Prefix.step peerCommit (by cases place <;> rfl) (.done _ _)⟩)
      have traced := writers.append (.ownerCommit certified rawCertified)
      exact crossSharedStoreTransfer (leftTicket := leftTicket) (rightTicket := rightTicket) (owner.transfer rep)
        (sharedOwnerTransferEffects owner rep) leadingUsed paired
        (by simpa only [List.cons_append, List.length_cons, List.length_nil, List.replicate_succ, List.replicate_zero,
          List.singleton_append, List.append_assoc, List.nil_append] using moved)
        (by simpa only [List.cons_append] using traced)
        (by
          unfold PairedComponentSite HostFrame.Related.Paired HostFrame.replace at frame ⊢
          exact pairQuietHost frame _) rfl rfl continuation
    · have empty : suffix = [] := List.length_eq_zero_iff.mp (by omega)
      have stopped : finish = leftWrite := by
        have atEnd : Steps profile ready (specDispatch ready base) leftWrite [] finish := empty ▸ residual
        exact stepsAtEmpty atEnd
      exact .inr (callbackTerminalSlice paired (by
        rw [split, crossed, empty, stopped]
        simpa only [List.append_nil, List.cons_append, List.singleton_append, List.append_assoc, List.replicate_succ,
          List.replicate_zero, List.length_cons, List.length_nil, List.nil_append] using
          (CallbackSliceEnd.coreAcceptTerminal (changes := older) beforeCommit
            (guardedWriters.append (.framed leftPath.2 rightPath.2)) (.refl _) (.inl rfl))))
  · obtain ⟨_, _, moved, _, pairedWriters, _, _⟩ :=
      compareFramedQuietShort leftPath rightPath frame ⟨_, rfl⟩ ⟨_, rfl⟩ run short
    obtain ⟨_, through, _⟩ := CallbackPrefix.transportAppend guards moved
    exact .inr (callbackTerminalSlice paired (by
      rw [split]
      simpa only [List.cons_append, List.singleton_append, List.append_assoc, List.append_nil, List.nil_append] using
        (CallbackSliceEnd.coreAcceptTerminal (changes := older) through (guardedWriters.append pairedWriters)
          (.refl _) (.inl rfl))))

private theorem sharedOwnerDropCode (drop : SharedOwnerDrop) (rep ticket : Nat) :
    (drop.claim.afterRead drop.inst ticket (.ok rep) : Session grow sig (Ret (core3 grow))) =
      drop.prepare rep >>= drop.spend ticket := by
  simp [SharedOwnerDrop.claim, SharedGiveClaim.afterRead, SharedGiveClaim.admitted, SharedOwnerDrop.prepare,
    SharedOwnerDrop.spend, SharedOwnerDrop.afterSpend, dropHandleTail, scheduledReply, Prog.bind_assoc, getResourceType]

private theorem sharedDropPrepareEffects (drop : SharedOwnerDrop) (rep : Nat) :
    StoreEffects (drop.prepare rep : Session grow sig (InstId × DtorRequest (core3 grow))) := by
  unfold SharedOwnerDrop.prepare Builtins.resourceEnter getInst getResourceType
  have admitted : StoreEffects (do
      let inst ← currentInst
      trapIf (!(← getObj ArenaField.insts inst).mayLeave) .cannotLeave
      return inst : Session grow sig InstId) :=
    storeEffectCurrentInst.bind fun _ => (storeEffectGetObject _ _).bind fun _ =>
      (storeEffectTrapIf _ _).bind fun _ => .pure _
  exact admitted.bind fun _ => (storeEffectGetObject _ _).bind fun _ => .pure _

private theorem sharedDestructorCode (result : InstId × DtorRequest (core3 grow)) (ticket : Nat) :
    (SharedOwnerDrop.afterSpend ticket result : Session grow sig (Ret (core3 grow))) =
      sharedDestructorWorker result >>= sharedDestructorStart ticket := by
  cases implementation : result.2.impl with
  | none =>
    simp [SharedOwnerDrop.afterSpend, destructorCall, sharedDestructorWorker, implementation, sharedDestructorStart]
  | some impl =>
    cases dtor : result.2.dtor <;>
      simp [SharedOwnerDrop.afterSpend, destructorCall, sharedDestructorWorker, sharedDestructorTask, sharedDestructorTaskDescription, sharedDestructorResourceRep,
        sharedDestructorTaskRecord, sharedDestructorThread, implementation, dtor,
        sharedDestructorStart, canonLift, canonLiftNoop, newThread, dtorType,
        bind, Prog.bind_assoc, Prog.bind, perform, Prog.lift] <;> rfl

private theorem sharedDestructorResourceRepEffects (result : InstId × DtorRequest (core3 grow)) :
    StoreEffects (sharedDestructorResourceRep result : Session grow sig AddrType) := by
  unfold sharedDestructorResourceRep getInst
  exact (storeEffectGetObject _ _).bind fun _ => (storeEffectTrapIf _ _).bind fun _ =>
    (storeEffectGetObject _ _).bind fun _ => .pure _

private theorem sharedDestructorTaskCode (result : InstId × DtorRequest (core3 grow)) (impl : InstId)
    (implementation : result.2.impl = some impl) (ticket : Nat) :
    (SharedOwnerDrop.afterSpend ticket result : Session grow sig (Ret (core3 grow))) =
      sharedDestructorResourceRep result >>= fun rep =>
        allocObj ArenaField.callers (Caller.sub (.destructor result.2.rep)) >>= fun caller =>
          allocObj ArenaField.tasks (sharedDestructorTaskRecord impl rep caller).val >>= fun task =>
            sharedDestructorStart ticket (some (sharedDestructorThread task result.2.dtor)) := by
  rw [sharedDestructorCode]
  simp [sharedDestructorWorker, implementation, sharedDestructorTask, sharedDestructorTaskDescription,
    bind, Prog.bind_assoc, Prog.bind]

open ReturnFrame.Occurrence in
private theorem sharedDestructorAllocationPath {dispatch : Call (core3 grow) → Session grow sig (Ret (core3 grow))}
    (cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig))
    {Id Data : Type} (field : ArenaField (core3 grow) Id Data)
    (entry : Data) (next : Id → Session grow sig (Ret (core3 grow)))
    (focus : start.ctl = cursor.control (allocObj field entry >>= next)) :
    let allocation := field.alloc start.store entry
    FramedQuietPath profile ready dispatch cursor start [id, fun store => (field.alloc store entry).1]
      { start with store := allocation.1, ctl := cursor.control (next allocation.2) } := by
  have code : (allocObj field entry >>= next) =
      .op .get (fun store => .op (.modify (ArenaOps.allocSt field entry))
        (fun _ => next (field.mkId (field.size (show CStore (core3 grow) from store))))) := by
    simp [allocObj, getStore, modifyStore, perform, Prog.lift, bind, Prog.bind]
  rw [code] at focus
  exact .step (.get focus) (by rw [transitionEdit, focus]; rfl) rfl
    (.step (.modify (th := cursor.thread) (segs := cursor.frames) (rest := cursor.rest)
      (f := ArenaOps.allocSt field entry)
      (k := fun _ => next (field.alloc start.store entry).2) rfl) rfl rfl .done)

private def destructorResumeStore (thread : ThreadId) (store : CStore (core3 grow)) : CStore (core3 grow) :=
  if store.threadIs Thread.waiting thread then CStore.stopWaitingSt thread store else store

private def destructorResumeEdits (thread : ThreadId) (store : CStore (core3 grow)) : List (ComponentStoreEdit grow) :=
  if store.threadIs Thread.waiting thread then [id, CStore.stopWaitingSt thread] else [id]

open ReturnFrame.Occurrence in
private theorem sharedThreadResumePath {dispatch : Call (core3 grow) → Session grow sig (Ret (core3 grow))}
    (thread : ThreadId) (cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig))
    (after : Session grow sig (Ret (core3 grow)))
    (focus : start.ctl = cursor.control ((Thread.resume thread >>= fun _ => after))) :
    FramedQuietPath profile ready dispatch cursor start (destructorResumeEdits thread start.store)
      { start with store := destructorResumeStore thread start.store
                   ctl := cursor.control (.op (.resumeThread thread) (fun _ => after)) } := by
  let next : Session grow sig (Ret (core3 grow)) :=
    .op (.resumeThread thread) (fun _ => after)
  let wait (store : CStore (core3 grow)) : Session grow sig (Ret (core3 grow)) :=
    (if store.threadIs Thread.waiting thread then Thread.stopWaiting thread else pure ()) >>= fun _ => next
  have source : (Thread.resume thread >>= fun _ => after) = .op .get wait := by
    simp [Thread.resume, getStore, perform, Prog.lift, bind, Prog.bind, resumeThread, next, wait]
    congr 1
    funext store
    let stop : Session grow sig Unit :=
      if (show CStore (core3 grow) from store).threadIs Thread.waiting thread then
        Thread.stopWaiting thread
      else pure ()
    exact Prog.bind_assoc stop (fun _ => Prog.op (.resumeThread thread) Prog.pure)
      (fun _ => after)
  have read : Step profile ready dispatch start .tau { start with ctl := cursor.control (wait start.store) } :=
    .get (th := cursor.thread) (segs := cursor.frames) (rest := cursor.rest) (k := wait) (source ▸ focus)
  have readEdit : transitionEdit start .tau = .same := by rw [transitionEdit, focus, source]; rfl
  cases waiting : start.store.threadIs Thread.waiting thread with
  | false =>
    have reached : wait start.store = next := by simp [wait, waiting]
    simp only [destructorResumeEdits, destructorResumeStore, waiting, Bool.false_eq_true, ite_false]
    rw [reached] at read
    exact .step read readEdit rfl .done
  | true =>
    have reached : wait start.store = .op (.modify (CStore.stopWaitingSt thread)) (fun _ => next) := by
      simp [wait, waiting, Thread.stopWaiting, modifyStore, perform, Prog.lift, bind, Prog.bind]
    simp only [destructorResumeEdits, destructorResumeStore, waiting, ite_true]
    rw [reached] at read
    exact .step read readEdit rfl
      (.step (.modify (th := cursor.thread) (segs := cursor.frames) (rest := cursor.rest) (k := fun _ => next) rfl)
        rfl rfl .done)

open ReturnFrame.Occurrence in
private theorem sharedDestructorResumePath {dispatch : Call (core3 grow) → Session grow sig (Ret (core3 grow))}
    (body : ThreadBody (core3 grow)) (ticket : Nat) (thread : ThreadId)
    (cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig))
    (focus : start.ctl = cursor.control (sharedDestructorAfterInstall body ticket thread)) :
    FramedQuietPath profile ready dispatch cursor start (destructorResumeEdits thread start.store)
      { start with store := destructorResumeStore thread start.store
                   ctl := cursor.control (.op (.resumeThread thread) (fun _ => sharedDestructorAfterResume body ticket)) } := sharedThreadResumePath thread cursor (sharedDestructorAfterResume body ticket) focus

private theorem relatedSetSlot {α : Type} {relation : Option α → Option α → Prop}
    (empty : relation none none) {lhs rhs : List (Option α)} (paired : List.Forall₂ relation lhs rhs)
    (index : Nat) {left right : Option α} (fresh : relation left right) :
    List.Forall₂ relation (Config.setSlot lhs index left) (Config.setSlot rhs index right) := by
  induction index generalizing lhs rhs with
  | zero =>
    cases paired with
    | nil => exact .cons fresh .nil
    | cons _ paired => exact .cons fresh paired
  | succ index ih =>
    cases paired with
    | nil => exact .cons empty (ih .nil)
    | cons first rest => exact .cons first (ih rest)

private theorem relatedContLookup {left right : Config (core3 grow) (HostState sig)}
    (paired : List.Forall₂ (ReturnFrame.Related.Saved older) left.conts right.conts)
    (thread : ThreadId) : ReturnFrame.Related.Saved older (left.cont? thread) (right.cont? thread) := by
  have lookup {left right : List (Option (Activation (core3 grow) (HostState sig)))}
      (paired : List.Forall₂ (ReturnFrame.Related.Saved older) left right) (index : Nat) :
      ReturnFrame.Related.Saved older left[index]?.join right[index]?.join := by
    induction index generalizing left right with
    | zero => cases paired with
      | nil => exact .none
      | cons head _ => exact head
    | succ _ ih => cases paired with
      | nil => exact .none
      | cons _ tail => exact ih tail
  exact lookup paired thread.idx

private theorem relatedSavedNone {slot : Option (Activation (core3 grow) (HostState sig))}
    (related : ReturnFrame.Related.Saved older none slot) : slot = none := by
  cases related
  rfl

private theorem relatedSavedSome {left : Activation (core3 grow) (HostState sig)}
    {right : Option (Activation (core3 grow) (HostState sig))}
    (related : ReturnFrame.Related.Saved older (some left) right) :
    ∃ peer, right = some peer ∧ ReturnFrame.Related.Active older left peer := by
  cases related with
  | some active => exact ⟨_, rfl, active⟩

private theorem pairedSetContinuation {left right : Config (core3 grow) (HostState sig)}
    (paired : ReturnFrame.Related.Paired older left right)
    (thread : ThreadId) {first second : Option (Activation (core3 grow) (HostState sig))}
    (slot : ReturnFrame.Related.Saved older first second) :
    ReturnFrame.Related.Paired older (left.setCont thread first) (right.setCont thread second) := by
  cases paired with
  | mk active saved => exact .mk active (relatedSetSlot .none saved thread.idx slot)

private theorem pairedPushActivation {left right : Config (core3 grow) (HostState sig)}
    (paired : ReturnFrame.Related.Paired older left right)
    {first second : Activation (core3 grow) (HostState sig)}
    (worker : ReturnFrame.Related.Active older first second) :
    ReturnFrame.Related.Paired older { left with ctl := first :: left.ctl } { right with ctl := second :: right.ctl } := by
  cases paired with
  | mk control saved => exact .mk (.cons worker control) saved

open ReturnFrame.Occurrence in
private theorem sharedSchedulerTransport {left right : Config (core3 grow) (HostState sig)}
    {label : Label (core3 grow) (HostState sig)}
    (checked : Step profile ready (specDispatch ready base) start label left)
    (canonical : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming label right)
    {edit : Edit (core3 grow) (HostState sig)}
    (leftEdit : transitionEdit start label = edit) (rightEdit : transitionEdit incoming label = edit) :
    OccurrenceTransport profile ready base bindings start incoming [label] [label] left right := by
  refine ⟨(·.bind edit.follow), fun place => ⟨.step checked ?_, .step canonical ?_⟩, ?_⟩
  · rw [leftEdit]; exact .done _ _
  · rw [rightEdit]; exact .done _ _
  · intro previous marks outside
    rw [step_edit checked, step_edit canonical, leftEdit, rightEdit]
    exact outside.edit edit

private theorem destructorReturnScheduler {left right : Config (core3 grow) (HostState sig)}
    (paired : ReturnFrame.Related.Paired older left right) :
    DestructorSchedulerAlignment older left right := by
  cases paired with
  | mk _ saved => exact ⟨saved, rfl, rfl, rfl⟩

private theorem destructorSchedulerOfPair {left right : Config (core3 grow) (HostState sig)}
    (paired : HostFrame.Related.Paired older left right) :
    DestructorSchedulerAlignment older left right := by
  have scheduler := destructorReturnScheduler (show ReturnFrame.Related.Paired older (HostFrame.replace left right.host) right from paired)
  exact scheduler

private theorem destructorSchedulerPair {left right : Config (core3 grow) (HostState sig)}
    (scheduler : DestructorSchedulerAlignment older left right) (stores : left.store = right.store)
    (control : List.Forall₂ (ReturnFrame.Related.Active older) left.ctl right.ctl) :
    HostFrame.Related.Paired older left right := by
  rcases left with ⟨leftStore, leftHost, leftSaved, leftControl, leftPending, leftResults, leftCancels⟩
  rcases right with ⟨rightStore, rightHost, rightSaved, rightControl, rightPending, rightResults, rightCancels⟩
  obtain ⟨saved, pending, results, cancels⟩ := scheduler
  dsimp only at stores pending results cancels
  subst rightStore rightPending rightResults rightCancels
  exact .mk control saved

private theorem destructorReturnControl {left right : Config (core3 grow) (HostState sig)}
    (paired : ReturnFrame.Related.Paired older left right) :
    List.Forall₂ (ReturnFrame.Related.Active older) left.ctl right.ctl := by
  cases paired with
  | mk control _ => exact control

private theorem destructorEnclosingControl {left right : Config (core3 grow) (HostState sig)}
    {thread frame frames peerFrames rest peerRest}
    (site : PairedComponentSite older left right
      ⟨thread, frame :: frames, rest⟩ ⟨thread, frame :: peerFrames, peerRest⟩) :
    List.Forall₂ (ReturnFrame.Related.Segment older) frames peerFrames ∧
      List.Forall₂ (ReturnFrame.Related.Active older) rest peerRest := by
  unfold PairedComponentSite HostFrame.Related.Paired at site
  have control := destructorReturnControl site
  simp only [PayloadPrefix.Cursor.control] at control
  cases control with
  | cons head rest =>
    cases head with
    | mk paired =>
      cases paired with
      | cons _ tail => exact ⟨tail, rest⟩

private theorem DestructorSchedulerAlignment.observeResolved {left right : Config (core3 grow) (HostState sig)}
    (scheduler : DestructorSchedulerAlignment older left right) (call : CallId) (values : Option (List Value.Val)) :
    DestructorSchedulerAlignment older (StepDefs.observe left (.resolved call values))
      (StepDefs.observe right (.resolved call values)) :=
  ⟨scheduler.1, scheduler.2.1, congrArg (· ++ [(call, values)]) scheduler.2.2.1, scheduler.2.2.2⟩

private theorem sharedDestructorDispatchCode (task : TaskId) (callee : Option (core3 grow).FuncAddr)
    (host : HostImpl (core3 grow) (HostState sig)) (ready : HostReady (HostState sig)) :
    specDispatch ready host (.threadBody (sharedDestructorThread task callee)) =
      .op .currentThread (sharedDestructorAfterThreadRead task callee) := by
  have compiled : specDispatch ready host (.threadBody (sharedDestructorThread task callee)) =
      Task.enterImplicitThread Quirks.none task >>= sharedDestructorAfterAdmission task callee := by
    cases callee
    case none =>
      change liftNoopThreadBody Limits.spec Quirks.none task = _
      unfold liftNoopThreadBody
      simp only [Prog.bind_eq]
      congr 1
      funext admitted
      cases admitted <;> rfl
    case some callee =>
      change liftThreadBody Limits.spec Quirks.none task callee = _
      unfold liftThreadBody
      simp only [Prog.bind_eq]
      congr 1
      funext admitted
      cases admitted <;> rfl
  rw [compiled]
  simp [Task.enterImplicitThread, currentThreadId, currentThread, bind, Prog.bind_assoc, perform, Prog.lift, Prog.bind]
  congr 1
  funext thread
  cases thread with
  | none =>
    simp [sharedDestructorAfterThreadRead, internal, trap, Prog.bind]
    congr 1
    funext response
    cases response
  | some worker =>
    simp [sharedDestructorAfterThreadRead, modifyStore, getTask, getObj, getStore, bind, perform, Prog.lift, Prog.bind]
    congr 1
    funext response
    congr 1
    funext store
    cases lookup : ArenaField.tasks.get? (show CStore (core3 grow) from store) task with
    | none =>
      simp [sharedDestructorAfterTaskRead, lookup, internal, trap, Prog.bind]
      congr 1
      funext response
      cases response
    | some tk => simp [sharedDestructorAfterTaskRead, lookup, bind, Prog.bind]

open ReturnFrame.Occurrence in
private theorem sharedDestructorEntryPath {impl : HostImpl (core3 grow) (HostState sig)}
    (task : TaskId) (callee : Option (core3 grow).FuncAddr) (worker : ThreadId)
    (rest : List (Activation (core3 grow) (HostState sig)))
    (focus : start.ctl = (PayloadPrefix.Cursor.mk (some worker) [] rest).control
      (specDispatch ready impl (.threadBody (sharedDestructorThread task callee)))) :
    let cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, [], rest⟩
    let store := CStore.setImplicitThread task worker start.store
    FramedQuietPath profile ready (specDispatch ready impl) cursor start [id, CStore.setImplicitThread task worker, id]
      { start with store, ctl := cursor.control (sharedDestructorAfterTaskRead task callee worker store) } := by
  rw [sharedDestructorDispatchCode] at focus
  exact .step (.currentThread focus) (by rw [transitionEdit, focus]; rfl) rfl
    (.step (.modify rfl) rfl rfl (.step (.get rfl) rfl rfl .done))

open ReturnFrame.Occurrence in
private theorem cutSharedWorkerPath
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    {edits : List (ComponentStoreEdit grow)} {target peerTarget : Config (core3 grow) (HostState sig)}
    (checked : ComponentQuietPath profile ready (specDispatch ready base) check start edits target)
    (canonical : ComponentQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon incoming edits peerTarget)
    (run : Steps profile ready (specDispatch ready base) start labels finish) :
    ∃ used trailing reached peer, labels = used ++ trailing ∧ used.length ≤ edits.length ∧
      OccurrenceTransport profile ready base bindings start incoming used used reached peer ∧
      Steps profile ready (specDispatch ready base) reached trailing finish ∧
      (trailing = [] ∨ used.length = edits.length ∧ reached = target ∧ peer = peerTarget) := by
  induction checked generalizing incoming labels with
  | done =>
    cases canonical
    exact ⟨[], labels, _, _, rfl, Nat.le_refl _, CallbackPrefix.stationaryTransport
      (fun place => .done _ place) (fun place => .done _ place), run, .inr ⟨rfl, rfl, rfl⟩⟩
  | step leftStep leftEdit _ ih =>
    cases canonical with
    | step rightStep rightEdit rest =>
      cases run with
      | refl =>
        exact ⟨[], [], _, _, rfl, Nat.zero_le _, CallbackPrefix.stationaryTransport
          (fun place => .done _ place) (fun place => .done _ place), .refl _, .inl rfl⟩
      | cons first tail =>
        obtain ⟨rfl, rfl⟩ := silentStepUnique leftStep first
        obtain ⟨used, following, reached, peer, split, bounded, moved, residual, ending⟩ := ih rest tail
        have leading := sharedSchedulerTransport (bindings := bindings) leftStep rightStep leftEdit rightEdit
        obtain ⟨_, paths, _⟩ := CallbackPrefix.transportAppend leading moved
        exact ⟨.tau :: used, following, reached, peer, congrArg (List.cons .tau) split, Nat.succ_le_succ bounded,
          by simpa only [List.map_nil, List.append_nil, List.singleton_append] using paths, residual, ending.imp_right (fun completed => ⟨congrArg Nat.succ completed.1, completed.2⟩)⟩

open ReturnFrame.Occurrence in
private theorem cutSharedQuietWorker
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    {edits : List (ComponentStoreEdit grow)} {target peerTarget : Config (core3 grow) (HostState sig)}
    (checked : FramedQuietPath profile ready (specDispatch ready base) check start edits target)
    (canonical : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon incoming edits peerTarget)
    (run : Steps profile ready (specDispatch ready base) start labels finish) :
    ∃ used trailing reached peer, labels = used ++ trailing ∧
      OccurrenceTransport profile ready base bindings start incoming used used reached peer ∧
      VisitorWriterPath profile ready base bindings start incoming used used reached peer ∧
      Steps profile ready (specDispatch ready base) reached trailing finish ∧
      (trailing = [] ∨ reached = target ∧ peer = peerTarget) := by
  obtain ⟨used, trailing, reached, peer, split, bounded, paths, residual, ending⟩ :=
    cutSharedWorkerPath checked.1 canonical.1 run
  have actual := (CallbackPrefix.transportPaths paths none).choose_spec
  exact ⟨used, trailing, reached, peer, split, paths,
    .framed (takeQuietWriterPath checked.2 actual.1.steps bounded) (takeQuietWriterPath canonical.2 actual.2.steps bounded),
    residual, ending.imp_right And.right⟩

private theorem sharedDestructorSyncCode (task : TaskId) (callee : Option (core3 grow).FuncAddr) (worker : ThreadId)
    (store : CStore (core3 grow)) (entry : Runtime.Task (core3 grow))
    (found : ArenaField.tasks.get? store task = some entry) (sync : entry.ft.async_ = false) :
    (sharedDestructorAfterTaskRead task callee worker store : Session grow sig (Ret (core3 grow))) =
      (Task.registerThread task worker >>= fun _ => sharedDestructorAfterAdmission task callee true) := by
  simp only [sharedDestructorAfterTaskRead, found, sync, Bool.false_eq_true, ite_false, Prog.bind_eq,
    Prog.pure_eq, Prog.pure_bind', Prog.bind_assoc, ite_true]

private def sharedDestructorRegisterInst (task : TaskId) (worker : ThreadId)
    (next : Session grow sig (Ret (core3 grow))) (inst : InstId) (store : CStore (core3 grow)) :
    Session grow sig (Ret (core3 grow)) :=
  match ArenaField.insts.get? store inst with
  | none => internal "dangling arena id"
  | some st => match st.addThread? worker with
    | none => trap .tableFull
    | some _ => .op (.modify (CStore.registerThreadSt task worker)) (fun _ => next)

private def sharedDestructorRegisterTask (task : TaskId) (worker : ThreadId)
    (next : Session grow sig (Ret (core3 grow))) (store : CStore (core3 grow)) :
    Session grow sig (Ret (core3 grow)) :=
  match ArenaField.tasks.get? store task with
  | none => internal "dangling arena id"
  | some tk => .op .get (sharedDestructorRegisterInst task worker next tk.inst)

private def sharedDestructorRegistration (task : TaskId) (worker : ThreadId) (next : Session grow sig (Ret (core3 grow))) :
    Session grow sig (Ret (core3 grow)) :=
  .op .get (sharedDestructorRegisterTask task worker next)

private theorem sharedDestructorRegistrationCode (task : TaskId) (worker : ThreadId) (next : Session grow sig (Ret (core3 grow))) :
    (Task.registerThread task worker >>= fun _ => next) = sharedDestructorRegistration task worker next := by
  simp [Task.registerThread, getTask, getInst, getObj, getStore, perform, Prog.lift, bind, Prog.bind,
    sharedDestructorRegistration]
  congr 1
  funext store
  change CStore (core3 grow) at store
  unfold sharedDestructorRegisterTask
  cases found : ArenaField.tasks.get? store task with
  | none =>
    simp [internal, trap, Prog.bind]
    congr 1
    funext response
    cases response
  | some tk =>
    simp only [Prog.bind]
    congr 1
    funext current
    change CStore (core3 grow) at current
    unfold sharedDestructorRegisterInst
    cases inst : ArenaField.insts.get? current tk.inst with
    | none =>
      simp [internal, trap, Prog.bind]
      congr 1
      funext response
      cases response
    | some st =>
      simp only [Prog.bind]
      cases admission : st.addThread? worker with
      | none =>
        simp [trap, Prog.bind]
        congr 1
        funext response
        cases response
      | some i => cases i; rfl

private def sharedDestructorRegisterResult (store : CStore (core3 grow)) (inst : InstId) (worker : ThreadId) :
    Except TrapReason Unit :=
  match ArenaField.insts.get? store inst with
  | none => .error (.internal "dangling arena id")
  | some entry => if (entry.addThread? worker).isNone then .error .tableFull else .ok ()

private def sharedDestructorRegisterEdits (task : TaskId) (worker : ThreadId) (result : Except TrapReason Unit) :
    List (ComponentStoreEdit grow) :=
  id :: id :: match result with
  | .error _ => []
  | .ok () => [CStore.registerThreadSt task worker]

private def sharedDestructorRegisterStore (task : TaskId) (worker : ThreadId) (store : CStore (core3 grow)) :
    Except TrapReason Unit → CStore (core3 grow)
  | .error _ => store
  | .ok () => CStore.registerThreadSt task worker store

private def sharedDestructorRegisterTail (next : Session grow sig (Ret (core3 grow))) :
    Except TrapReason Unit → Session grow sig (Ret (core3 grow))
  | .error reason => trap reason
  | .ok () => next

open ReturnFrame.Occurrence in
private theorem sharedDestructorRegisterPath {dispatch : Call (core3 grow) → Session grow sig (Ret (core3 grow))}
    (task : TaskId) (worker : ThreadId) (cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig))
    (next : Session grow sig (Ret (core3 grow))) (entry : Runtime.Task (core3 grow))
    (found : ArenaField.tasks.get? start.store task = some entry)
    (focus : start.ctl = cursor.control (Task.registerThread task worker >>= fun _ => next)) :
    let result := sharedDestructorRegisterResult start.store entry.inst worker
    FramedQuietPath profile ready dispatch cursor start (sharedDestructorRegisterEdits task worker result)
      { start with
        store := sharedDestructorRegisterStore task worker start.store result
        ctl := cursor.control (sharedDestructorRegisterTail next result) } := by
  dsimp only
  rw [sharedDestructorRegistrationCode] at focus
  let program := sharedDestructorRegisterInst task worker next entry.inst
  let reading := { start with ctl := cursor.control (.op .get program) }
  have read : Step profile ready dispatch start .tau reading := by
    have atRead : sharedDestructorRegisterTask task worker next start.store = .op .get program := by
      simp only [sharedDestructorRegisterTask, found, program]
    have actual := Step.get (prof := profile) (hr := ready) (dispatch := dispatch)
      (th := cursor.thread) (k := sharedDestructorRegisterTask task worker next)
      (segs := cursor.frames) (rest := cursor.rest) focus
    rw [atRead] at actual
    exact actual
  have readEdit : transitionEdit start .tau = .same := by rw [transitionEdit, focus]; rfl
  have get : Step profile ready dispatch reading .tau { start with ctl := cursor.control (program start.store) } :=
    .get (th := cursor.thread) (k := program) (segs := cursor.frames) (rest := cursor.rest) rfl
  dsimp only [program, sharedDestructorRegisterInst] at get
  refine FramedQuietPath.step (update := id) read readEdit rfl ?_
  cases inst : ArenaField.insts.get? start.store entry.inst with
  | none =>
    simp only [sharedDestructorRegisterResult, inst,
      sharedDestructorRegisterStore, sharedDestructorRegisterTail]
    rw [inst] at get
    exact .step get rfl rfl .done
  | some target =>
    rw [inst] at get
    cases available : target.addThread? worker with
    | none =>
      simp only [sharedDestructorRegisterResult, inst, available, Option.isNone_none, ite_true,
        sharedDestructorRegisterStore, sharedDestructorRegisterTail]
      simp only [available] at get
      exact .step get rfl rfl .done
    | some slot =>
      simp only [sharedDestructorRegisterResult, inst, available, Option.isNone_some, Bool.false_eq_true, ite_false,
        sharedDestructorRegisterStore, sharedDestructorRegisterTail]
      simp only [available] at get
      exact .step get rfl rfl (.step (.modify rfl) rfl rfl .done)

open ReturnFrame.Occurrence in
private theorem classifySharedDestructorTrap
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)} (reason : TrapReason)
    (checked : start.ctl = check.control (trap reason)) (canonical : incoming.ctl = canon.control (trap reason))
    (run : Steps profile ready (specDispatch ready base) start labels finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  cases run with
  | refl => exact .exhausted
  | cons first residual =>
    obtain ⟨rfl, rfl⟩ := componentTrapUnique checked first
    have raw := Step.trap (prof := profile) (hr := ready) (dispatch := specDispatch ready (LiveDispatch.host bindings base)) canonical
    have paths : OccurrenceTransport profile ready base bindings start incoming [.trap reason] [.trap reason]
      (StepDefs.trapCfg start) (StepDefs.trapCfg incoming) := by
      refine ⟨(·.bind (Edit.clear : Edit (core3 grow) (HostState sig)).follow), fun place => ⟨.step first (.done _ _), .step raw (.done _ _)⟩, ?_⟩
      intro older marks related
      rw [step_edit first, step_edit raw]
      exact related.edit _
    exact .coreAcceptTerminal paths (.framed (.same first rfl (.done _)) (.same raw rfl (.done _)))
      residual (.inr (.inr (.inr ⟨rfl, rfl⟩)))

private def sharedDestructorStartRead (task : TaskId) (callee : Option (core3 grow).FuncAddr) (entry : Task (core3 grow))
    (store : CStore (core3 grow)) : Session grow sig (Ret (core3 grow)) :=
  match ArenaField.tasks.get? store task with
  | none => internal "dangling arena id"
  | some tk => .op (.modify (CStore.setTaskState task .started)) fun _ =>
      .op (.call (.onStart tk.caller)) (sharedDestructorStartReply task callee entry)

private def sharedDestructorRegisteredRead (task : TaskId) (callee : Option (core3 grow).FuncAddr)
    (store : CStore (core3 grow)) : Session grow sig (Ret (core3 grow)) :=
  match ArenaField.tasks.get? store task with
  | none => internal "dangling arena id"
  | some tk => .op .get (sharedDestructorStartRead task callee tk)

private theorem sharedDestructorRegisteredCode (task : TaskId) (callee : Option (core3 grow).FuncAddr) :
    (sharedDestructorAfterAdmission task callee true : Session grow sig (Ret (core3 grow))) =
      .op .get (sharedDestructorRegisteredRead task callee) := by
  have initial : (sharedDestructorAfterAdmission task callee true : Session grow sig (Ret (core3 grow))) =
      getTask task >>= fun tk => Task.start task >>= sharedDestructorArguments task callee tk := by
    cases callee <;> rfl
  rw [initial]
  simp [Task.start, getTask, getObj, getStore, perform, Prog.lift, bind, Prog.bind]
  congr 1
  funext store
  change CStore (core3 grow) at store
  unfold sharedDestructorRegisteredRead
  cases found : ArenaField.tasks.get? store task with
  | none =>
    simp [internal, trap, Prog.bind]
    congr 1
    funext response
    cases response
  | some entry =>
    simp only [Prog.bind]
    congr 1
    funext current
    change CStore (core3 grow) at current
    unfold sharedDestructorStartRead
    cases entryAt : ArenaField.tasks.get? current task with
    | none =>
      simp [internal, trap, Prog.bind]
      congr 1
      funext response
      cases response
    | some currentTask =>
      simp [modifyStore, callVals, callRet, perform, Prog.lift, bind, Prog.bind]
      congr 1
      funext result
      congr 1
      funext reply
      cases reply <;> try rfl
      all_goals simp [sharedDestructorStartReply, internal, trap, Prog.bind]
      all_goals congr 1
      all_goals funext response
      all_goals cases response

private def sharedDestructorOnStartArguments (caller : CallerId) (rep : Nat) (store : CStore (core3 grow)) : List Value.Val :=
  [repVal (((callerTaskFt? store caller).map paramTypes).getD []) rep]


private def sharedDestructorCallerStartFromRecord (caller : CallerId) : Caller (core3 grow) → Session grow sig (Ret (core3 grow))
  | .host call args depth => do
    if depth = 0 then emit (.started call)
    return .vals args
  | .lower .. => return .vals (← lowerOnStart Limits.spec Quirks.none caller)
  | .sub (.invoke args _) => return .vals args
  | .sub _ => onStartProg caller

private theorem sharedDestructorCallerStartSource (caller : CallerId) (ready : HostReady (HostState sig))
    (host : HostImpl (core3 grow) (HostState sig)) :
    specDispatch ready host (.onStart caller) = getObj ArenaField.callers caller >>= sharedDestructorCallerStartFromRecord caller := by
  change callerOnStart Limits.spec Quirks.none caller = _
  unfold callerOnStart
  simp only [Prog.bind_eq]
  congr 1
  funext record
  cases record <;> try rfl
  rename_i tag
  cases tag <;> rfl

private def sharedDestructorInnerStartFromRecord (caller : CallerId) : Caller (core3 grow) → Session grow sig (Ret (core3 grow))
  | .sub (.realloc args _) => .pure (.vals args)
  | .sub (.destructor rep) => .op .get fun store => .pure (.vals (sharedDestructorOnStartArguments caller rep store))
  | .sub .start => .pure (.vals [])
  | _ => internal "onStartProg: not an internal caller"

private theorem sharedDestructorInnerStartSource (caller : CallerId) :
    (onStartProg caller : Session grow sig (Ret (core3 grow))) = getObj ArenaField.callers caller >>= sharedDestructorInnerStartFromRecord caller := by
  unfold onStartProg
  simp only [Prog.bind_eq]
  congr 1
  funext record
  cases record <;> try rfl
  rename_i tag
  cases tag <;> rfl

private def sharedArenaReader {Id Data : Type} (field : ArenaField (core3 grow) Id Data)
    (id : Id) (after : Data → Session grow sig (Ret (core3 grow))) (store : CStore (core3 grow)) :
    Session grow sig (Ret (core3 grow)) :=
  match field.get? store id with
  | none => internal "dangling arena id"
  | some object => after object

private theorem sharedArenaReaderCode {Id Data : Type} (field : ArenaField (core3 grow) Id Data)
    (id : Id) (after : Data → Session grow sig (Ret (core3 grow))) :
    (getObj field id >>= after) = .op .get (sharedArenaReader field id after) := by
  simp [getObj, getStore, perform, Prog.lift, bind, Prog.bind]
  congr 1
  funext store
  change CStore (core3 grow) at store
  unfold sharedArenaReader
  cases found : field.get? store id with
  | none => exact internalBind _ _
  | some data => rfl

open ReturnFrame.Occurrence in
private theorem FramedQuietPath.get {dispatch : Call (core3 grow) → Session grow sig (Ret (core3 grow))}
    {cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    {read : CStore (core3 grow) → Session grow sig (Ret (core3 grow))}
    {body : Session grow sig (Ret (core3 grow))} {edits : List (ComponentStoreEdit grow)}
    (focus : start.ctl = cursor.control (.op .get read))
    (readAt : read start.store = body)
    (tail : FramedQuietPath profile ready dispatch cursor { start with ctl := cursor.control body } edits finish) :
    FramedQuietPath profile ready dispatch cursor start (id :: edits) finish := by
  have step := Step.get (prof := profile) (hr := ready) (dispatch := dispatch)
    (th := cursor.thread) (k := read) (segs := cursor.frames) (rest := cursor.rest) focus
  rw [readAt] at step
  exact .step step (by rw [transitionEdit, focus]; rfl) rfl tail

open ReturnFrame.Occurrence in
private theorem sharedDestructorStartPath {dispatch : Call (core3 grow) → Session grow sig (Ret (core3 grow))}
    (task : TaskId) (callee : Option (core3 grow).FuncAddr)
    (cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)) (tk : Task (core3 grow))
    (focus : start.ctl = cursor.control (sharedDestructorAfterAdmission task callee true))
    (found : ArenaField.tasks.get? start.store task = some tk) :
    FramedQuietPath profile ready dispatch cursor start [id, id, CStore.setTaskState task .started]
      { start with
        store := CStore.setTaskState task .started start.store
        ctl := cursor.control (.op (.call (.onStart tk.caller)) (sharedDestructorStartReply task callee tk)) } := by
  rw [sharedDestructorRegisteredCode] at focus
  refine .get focus (body := .op .get (sharedDestructorStartRead task callee tk)) ?_ ?_
  · simp only [sharedDestructorRegisteredRead, found]
  refine .get rfl (body := .op (.modify (CStore.setTaskState task .started))
    (fun _ => .op (.call (.onStart tk.caller)) (sharedDestructorStartReply task callee tk))) ?_ ?_
  · simp only [sharedDestructorStartRead, found]
  exact .step (.modify (th := cursor.thread) (segs := cursor.frames) (rest := cursor.rest)
    (f := CStore.setTaskState task .started)
    (k := fun _ => .op (.call (.onStart tk.caller)) (sharedDestructorStartReply task callee tk)) rfl) rfl rfl .done

open ReturnFrame.Occurrence in
private theorem sharedDestructorOnStartPath {impl : HostImpl (core3 grow) (HostState sig)}
    (caller : CallerId) (cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)) (rep : Nat)
    (focus : start.ctl = cursor.control (specDispatch ready impl (.onStart caller)))
    (found : ArenaField.callers.get? start.store caller = some (.sub (.destructor rep))) :
    FramedQuietPath profile ready (specDispatch ready impl) cursor start [id, id, id]
      { start with ctl := cursor.control (.pure (.vals (sharedDestructorOnStartArguments caller rep start.store))) } := by
  rw [sharedDestructorCallerStartSource, sharedArenaReaderCode] at focus
  refine .get focus (body := onStartProg caller) ?_ ?_
  · simp only [sharedArenaReader, found, sharedDestructorCallerStartFromRecord]
  have inner : (onStartProg caller : Session grow sig (Ret (core3 grow))) = .op .get (sharedArenaReader ArenaField.callers caller (sharedDestructorInnerStartFromRecord caller)) := by
    rw [sharedDestructorInnerStartSource, sharedArenaReaderCode]
  refine .get (congrArg cursor.control inner) (body :=
    .op .get (fun store => .pure (.vals (sharedDestructorOnStartArguments caller rep store)))) ?_ ?_
  · simp only [sharedArenaReader, found, sharedDestructorInnerStartFromRecord]
  exact .get rfl rfl .done

open ReturnFrame.Occurrence in
private theorem crossSharedDestructorOnStart
    {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    (task : TaskId) (callee : Option (core3 grow).FuncAddr)
    (source : SharedDestructorRegisteredSource task start.store incoming.store)
    (leftAt : start.ctl = check.control (sharedDestructorAfterAdmission task callee true))
    (rightAt : incoming.ctl = canon.control (sharedDestructorAfterAdmission task callee true))
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (afterPop : ∀ {left right : Config (core3 grow) (HostState sig)} {remaining : Trace grow sig}
      (tk : Task (core3 grow)) (args : List Value.Val) (width : AddrType) (rep : Nat),
      tk.ft = dtorType width → tk.opts = {} → (∃ kind, args = [.int kind (rep : Int)]) →
      left.store = right.store →
      SharedDestructorOnStartPop profile ready (specDispatch ready base) check tk.caller (sharedDestructorStartReply task callee tk) args left →
      SharedDestructorOnStartPop profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon
        tk.caller (sharedDestructorStartReply task callee tk) args right →
      left.ctl = check.control (sharedDestructorArguments task callee tk args) →
      right.ctl = canon.control (sharedDestructorArguments task callee tk args) →
      Steps profile ready (specDispatch ready base) left remaining finish →
      CallbackSliceEnd profile ready base bindings older left right remaining finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  obtain ⟨tk, width, rep, taskAt, typeAt, optionsAt, callerAt⟩ := source.entry
  have rightTask : ArenaField.tasks.get? incoming.store task = some tk := source.paired ▸ taskAt
  let resume := sharedDestructorStartReply (sig := sig) task callee tk
  let call := Call.onStart (E := core3 grow) tk.caller
  let program := Prog.op (S := Eff (core3 grow) (HostState sig)) (.call call) resume
  let callLeft := { start with store := CStore.setTaskState task .started start.store, ctl := check.control program }
  let callRight := { incoming with store := CStore.setTaskState task .started incoming.store, ctl := canon.control program }
  have lhs : FramedQuietPath profile ready (specDispatch ready base) check start [id, id, CStore.setTaskState task .started] callLeft :=
    sharedDestructorStartPath task callee check tk leftAt taskAt
  have rhs : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon incoming
      [id, id, CStore.setTaskState task .started] callRight :=
    sharedDestructorStartPath task callee canon tk rightAt rightTask
  obtain ⟨used, trailing, reached, peer, split, paths, writers, residual, ending⟩ := cutSharedQuietWorker lhs rhs run
  rw [split]
  rcases ending with empty | ⟨rfl, rfl⟩
  · subst trailing
    cases residual
    exact .comparedPrefix paths writers .exhausted
  · refine .destructorPrefix paths writers (fun scheduler => scheduler) ?_
    let leftCursor := { check with frames := .prog resume :: check.frames }
    let rightCursor := { canon with frames := .prog resume :: canon.frames }
    let enterLeft := { callLeft with ctl := leftCursor.control (specDispatch ready base call) }
    let enterRight := { callRight with ctl := rightCursor.control (specDispatch ready (LiveDispatch.host bindings base) call) }
    have callCheck : Step profile ready (specDispatch ready base) callLeft .tau enterLeft :=
      .call (th := check.thread) (k := resume) (c := call) (segs := check.frames) (rest := check.rest) rfl
    have callCanon : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) callRight .tau enterRight :=
      .call (th := canon.thread) (k := resume) (c := call) (segs := canon.frames) (rest := canon.rest) rfl
    rcases splitSilent (count := 1) (.cons callCheck (.refl _)) residual with ⟨afterCall, installed, rest⟩ | short
    · rw [installed]
      have entered := sharedSchedulerTransport (bindings := bindings) callCheck callCanon rfl rfl
      have written := frameCalloutStep entered rfl rfl
      change CallbackSliceEnd profile ready base bindings older callLeft callRight ([.tau] ++ afterCall) finish
      refine .destructorPrefix entered written (fun scheduler => scheduler) ?_
      have leftCaller : ArenaField.callers.get? enterLeft.store tk.caller = some (.sub (.destructor rep)) := callerAt
      have rightCaller : ArenaField.callers.get? enterRight.store tk.caller = some (.sub (.destructor rep)) := by
        change ArenaField.callers.get? incoming.store tk.caller = _
        exact source.paired ▸ callerAt
      have sameStore : enterLeft.store = enterRight.store := congrArg (CStore.setTaskState task .started) source.paired
      let args := sharedDestructorOnStartArguments tk.caller rep enterLeft.store
      let retLeft := { enterLeft with ctl := leftCursor.control (.pure (.vals args)) }
      let retRight := { enterRight with ctl := rightCursor.control (.pure (.vals args)) }
      have readLeft : FramedQuietPath profile ready (specDispatch ready base) leftCursor enterLeft [id, id, id] retLeft :=
        sharedDestructorOnStartPath tk.caller leftCursor rep rfl leftCaller
      have readRight : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) rightCursor enterRight
          [id, id, id] retRight := by
        have path := sharedDestructorOnStartPath (profile := profile) (ready := ready) (impl := LiveDispatch.host bindings base)
          (start := enterRight) tk.caller rightCursor rep rfl rightCaller
        rw [congrArg (sharedDestructorOnStartArguments tk.caller rep) sameStore.symm] at path
        exact path
      obtain ⟨seen, following, reached, peer, cut, moved, writes, tail, atEnd⟩ :=
        cutSharedQuietWorker readLeft readRight rest
      rw [cut]
      rcases atEnd with empty | ⟨rfl, rfl⟩
      · subst following
        cases tail
        exact .comparedPrefix moved writes .exhausted
      · refine .destructorPrefix moved writes (fun scheduler => scheduler) ?_
        have popLeft : Step profile ready (specDispatch ready base) retLeft .tau
            { retLeft with ctl := check.control (resume (.vals args)) } :=
          .popProg (th := check.thread) (k := resume) (segs := check.frames) (rest := check.rest) rfl
        have popRight : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) retRight .tau
            { retRight with ctl := canon.control (resume (.vals args)) } :=
          .popProg (th := canon.thread) (k := resume) (segs := canon.frames) (rest := canon.rest) rfl
        rcases splitSilent (count := 1) (.cons popLeft (.refl _)) tail with ⟨afterReturn, returned, residual⟩ | short
        · rw [returned]
          have popped := sharedSchedulerTransport (bindings := bindings) popLeft popRight rfl rfl
          change CallbackSliceEnd profile ready base bindings older retLeft retRight ([.tau] ++ afterReturn) finish
          refine .destructorPrefix popped (frameCalloutStep popped rfl rfl) (fun scheduler => scheduler) ?_
          have integer : ∃ kind, args = [.int kind (rep : Int)] := by
            unfold args sharedDestructorOnStartArguments repVal
            split <;> exact ⟨_, rfl⟩
          exact afterPop tk args width rep typeAt optionsAt integer (congrArg (CStore.setTaskState task .started) source.paired)
            ⟨callLeft, enterLeft, retLeft, rfl, callCheck, rfl, readLeft.1.track _, rfl, popLeft⟩
            ⟨callRight, enterRight, retRight, rfl, callCanon, rfl, readRight.1.track _, rfl, popRight⟩
            rfl rfl residual
        · have empty : following = [] := List.length_eq_zero_iff.mp (by omega)
          have stopped := stepsAtEmpty (empty ▸ tail)
          exact empty.symm ▸ stopped ▸ CallbackSliceEnd.exhausted
    · have empty : trailing = [] := List.length_eq_zero_iff.mp (by omega)
      have stopped := stepsAtEmpty (empty ▸ residual)
      exact empty.symm ▸ stopped ▸ CallbackSliceEnd.exhausted

private theorem sharedDestructorFlatArgumentCode (cx : LiftLowerContext (core3 grow)) (width : AddrType) (kind : Value.IntKind) (rep : Nat) :
    (lowerFlatValues Limits.spec Quirks.none cx ABI.maxFlatParams [.int kind rep]
      (paramTypes (dtorType width)) none : Session grow sig (List FlatValue)) =
    .op .get (fun _ => .pure [sharedDestructorFlatArgument width rep]) := by
  unfold lowerFlatValues ptrType
  simp [gets, getStore, perform, Prog.lift, bind, Prog.bind]
  congr 1
  funext store
  change CStore (core3 grow) at store
  generalize ptrTypeIn store cx = address
  have fits : ¬ ABI.maxFlatParams < (ABI.flattenTypes address (paramTypes (dtorType width))).length := by
    cases width <;> simp [dtorType, ptrPrim, paramTypes, ABI.flattenTypes, ABI.flatten, ABI.flattenPrimitive, ABI.maxFlatParams]
  simp only [fits, ite_false]
  cases width <;> cases address <;> rfl

private theorem sharedDestructorNoResultCode (cx : LiftLowerContext (core3 grow)) (words : List FlatValue) :
    (liftFlatValues Limits.spec Quirks.none cx ABI.maxFlatResults (.ofList words) [] :
      Session grow sig (List Value.Val × FlatCursor)) =
    .op .get (fun _ => .pure ([], .ofList words)) := by
  unfold liftFlatValues ptrType
  simp [gets, getStore, perform, Prog.lift, bind, Prog.bind]
  congr 1
  funext store
  change CStore (core3 grow) at store
  generalize ptrTypeIn store cx = address
  have fits : ¬ ABI.maxFlatResults < (ABI.flattenTypes (Resource := RtId) address []).length := by
    simp [ABI.flattenTypes]
  simp only [fits, ite_false]
  cases address <;> rfl

private def sharedDestructorScalars (task : TaskId) (callee : Option (core3 grow).FuncAddr)
    (tk : Task (core3 grow)) (width : AddrType) (rep : Nat) : Session grow sig (Ret (core3 grow)) :=
  match callee with
  | none => .op .get (fun _ => sharedDestructorFinish task [])
  | some f => .op (.callCore f [sharedDestructorFlatArgument width rep]) (sharedDestructorCoreResult task tk)

private theorem sharedDestructorScalarsCode (task : TaskId) (callee : Option (core3 grow).FuncAddr)
    (tk : Task (core3 grow)) (width : AddrType) (rep : Nat) (kind : Value.IntKind)
    (typeAt : tk.ft = dtorType width) (optionsAt : tk.opts = {}) :
    (sharedDestructorArguments task callee tk [.int kind (rep : Int)] : Session grow sig (Ret (core3 grow))) =
      .op .get (fun _ => sharedDestructorScalars task callee tk width rep) := by
  let cx : LiftLowerContext (core3 grow) := { opts := tk.opts, inst := tk.inst, scope := .task task }
  have resultTypesEmpty : resultTypes tk.ft = [] := by rw [typeAt]; rfl
  have flat : (lowerFlatValues Limits.spec Quirks.none cx ABI.maxFlatParams [.int kind (rep : Int)]
        (paramTypes tk.ft) none : Session grow sig (List FlatValue)) =
      .op .get (fun _ => .pure [sharedDestructorFlatArgument width rep]) := by
    rw [typeAt]
    exact sharedDestructorFlatArgumentCode cx width kind rep
  cases callee with
  | none =>
    unfold sharedDestructorArguments sharedDestructorScalars
    change (lowerFlatValues Limits.spec Quirks.none cx ABI.maxFlatParams [.int kind (rep : Int)] (paramTypes tk.ft) none >>= fun _ =>
      liftFlatValues Limits.spec Quirks.none cx ABI.maxFlatResults (.ofList []) (resultTypes tk.ft) >>= fun result =>
        sharedDestructorFinish task result.1) = _
    rw [flat, resultTypesEmpty, sharedDestructorNoResultCode]
    rfl
  | some f =>
    unfold sharedDestructorArguments liftArgumentsBody sharedDestructorScalars
    change (lowerFlatValues Limits.spec Quirks.none cx ABI.maxFlatParams [.int kind (rep : Int)] (paramTypes tk.ft) none >>=
      liftArgumentsTail Limits.spec Quirks.none task f tk cx) = _
    rw [flat]
    unfold liftArgumentsTail liftSyncTail
    simp [optionsAt, cx, callCore, perform, Prog.lift, bind, Prog.bind, Prog.bind_assoc]
    congr 1
    funext store
    congr 1
    funext words
    simp [sharedDestructorCoreResult, sharedDestructorFinish, optionsAt, bind]

open ReturnFrame.Occurrence in
private theorem crossSharedDestructorScalars {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    (task : TaskId) (callee : Option (core3 grow).FuncAddr) (tk : Task (core3 grow)) (width : AddrType) (rep : Nat)
    (args : List Value.Val) (typeAt : tk.ft = dtorType width) (optionsAt : tk.opts = {})
    (integer : ∃ kind, args = [.int kind (rep : Int)])
    (stores : start.store = incoming.store)
    (leftAt : start.ctl = check.control (sharedDestructorArguments task callee tk args))
    (rightAt : incoming.ctl = canon.control (sharedDestructorArguments task callee tk args))
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (resume : ∀ {left right : Config (core3 grow) (HostState sig)} {trailing : Trace grow sig},
      left.store = right.store →
      left.ctl = ⟨check.thread, sharedDestructorBodyFocus task callee tk width rep, check.frames⟩ :: check.rest →
      right.ctl = ⟨canon.thread, sharedDestructorBodyFocus task callee tk width rep, canon.frames⟩ :: canon.rest →
      Steps profile ready (specDispatch ready base) left trailing finish →
      CallbackSliceEnd profile ready base bindings older left right trailing finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  obtain ⟨kind, rfl⟩ := integer
  rw [sharedDestructorScalarsCode task callee tk width rep kind typeAt optionsAt] at leftAt rightAt
  let program := sharedDestructorScalars (sig := sig) task callee tk width rep
  let left := { start with ctl := check.control program }
  let right := { incoming with ctl := canon.control program }
  have getLeft : Step profile ready (specDispatch ready base) start .tau left :=
    .get (th := check.thread) (segs := check.frames) (rest := check.rest) (k := fun _ => program) leftAt
  have getRight : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau right :=
    .get (th := canon.thread) (segs := canon.frames) (rest := canon.rest) (k := fun _ => program) rightAt
  rcases splitSilent (count := 1) (.cons getLeft (.refl _)) run with ⟨afterGet, tookGet, residual⟩ | short
  · rw [tookGet]
    have read := sharedSchedulerTransport (bindings := bindings) (edit := .same) getLeft getRight
      (by rw [transitionEdit, leftAt]; rfl) (by rw [transitionEdit, rightAt]; rfl)
    refine .destructorPrefix read (frameCalloutStep read rfl rfl) (fun scheduler => scheduler) ?_
    let body := sharedDestructorBodyFocus (sig := sig) task callee tk width rep
    let checkBody := { left with ctl := ⟨check.thread, body, check.frames⟩ :: check.rest }
    let canonBody := { right with ctl := ⟨canon.thread, body, canon.frames⟩ :: canon.rest }
    have checkStep : Step profile ready (specDispatch ready base) left .tau checkBody := by
      cases callee with
      | none => exact .get (th := check.thread) (segs := check.frames) (rest := check.rest) (k := fun _ => sharedDestructorFinish task []) rfl
      | some f =>
        exact .callCore (th := check.thread) (segs := check.frames) (rest := check.rest) (f := f)
          (args := [sharedDestructorFlatArgument width rep]) (k := sharedDestructorCoreResult task tk) rfl
    have canonStep : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) right .tau canonBody := by
      cases callee with
      | none => exact .get (th := canon.thread) (segs := canon.frames) (rest := canon.rest) (k := fun _ => sharedDestructorFinish task []) rfl
      | some f =>
        exact .callCore (th := canon.thread) (segs := canon.frames) (rest := canon.rest) (f := f)
          (args := [sharedDestructorFlatArgument width rep]) (k := sharedDestructorCoreResult task tk) rfl
    rcases splitSilent (count := 1) (.cons checkStep (.refl _)) residual with ⟨rest, used, tail⟩ | short
    · rw [used]
      have compared := sharedSchedulerTransport (bindings := bindings) (edit := .same) checkStep canonStep
        (by cases callee <;> rfl) (by cases callee <;> rfl)
      exact .destructorPrefix compared (frameCalloutStep compared rfl rfl) (fun scheduler => scheduler) (resume stores rfl rfl tail)
    · have empty : afterGet = [] := List.length_eq_zero_iff.mp (by omega)
      have stopped := stepsAtEmpty (empty ▸ residual)
      exact empty.symm ▸ stopped ▸ CallbackSliceEnd.exhausted
  · have empty : labels = [] := List.length_eq_zero_iff.mp (by omega)
    have stopped := stepsAtEmpty (empty ▸ run)
    exact empty.symm ▸ stopped ▸ CallbackSliceEnd.exhausted

private def SharedDestructorCoreContinuation (profile : ProfileKind) (ready : HostReady (HostState sig))
    (base : HostImpl (core3 grow) (HostState sig)) (bindings : List (Binding sig))
    (older : ReturnFrame.Substitutions (core3 grow) (HostState sig))
    (check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)) (task : TaskId) (tk : Task (core3 grow))
    (bound : Nat) (finish : Config (core3 grow) (HostState sig)) : Prop :=
  ∀ {left right : Config (core3 grow) (HostState sig)} {remaining : Trace grow sig}
    {core : (core3 grow).Thread (CanonHost (core3 grow))},
    remaining.length < bound → left.store = right.store →
    left.ctl = ⟨check.thread, .core core (sharedDestructorCoreResult task tk), check.frames⟩ :: check.rest →
    right.ctl = ⟨canon.thread, .core core (sharedDestructorCoreResult task tk), canon.frames⟩ :: canon.rest →
    Steps profile ready (specDispatch ready base) left remaining finish →
    CallbackSliceEnd profile ready base bindings older left right remaining finish

private def SharedFramedCoreContinuation (profile : ProfileKind) (ready : HostReady (HostState sig))
    (base : HostImpl (core3 grow) (HostState sig)) (bindings : List (Binding sig))
    (older : ReturnFrame.Substitutions (core3 grow) (HostState sig))
    (check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)) (task : TaskId) (tk : Task (core3 grow))
    (frame : Config (core3 grow) (HostState sig) → Config (core3 grow) (HostState sig) → Prop)
    (bound : Nat) (finish : Config (core3 grow) (HostState sig)) : Prop :=
  ∀ {left right : Config (core3 grow) (HostState sig)} {remaining : Trace grow sig}
    {core : (core3 grow).Thread (CanonHost (core3 grow))},
    remaining.length < bound → left.store = right.store → frame left right →
    left.ctl = ⟨check.thread, .core core (sharedDestructorCoreResult task tk), check.frames⟩ :: check.rest →
    right.ctl = ⟨canon.thread, .core core (sharedDestructorCoreResult task tk), canon.frames⟩ :: canon.rest →
    Steps profile ready (specDispatch ready base) left remaining finish →
    CallbackSliceEnd profile ready base bindings older left right remaining finish

open ReturnFrame.Occurrence in
private theorem crossSharedDestructorCoreWith {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    {initial : (core3 grow).Thread (CanonHost (core3 grow))} (task : TaskId) (tk : Task (core3 grow))
    {frame : Config (core3 grow) (HostState sig) → Config (core3 grow) (HostState sig) → Prop}
    (coreFrame : ∀ {left right}, frame left right → ∀ leftCore rightCore leftCtl rightCtl,
      frame { left with store := { left.store with core := leftCore }, ctl := leftCtl }
        { right with store := { right.store with core := rightCore }, ctl := rightCtl })
    (same : start.store = incoming.store) (aligned : frame start incoming)
    (leftAt : start.ctl = ⟨check.thread, .core initial (sharedDestructorCoreResult task tk), check.frames⟩ :: check.rest)
    (rightAt : incoming.ctl = ⟨canon.thread, .core initial (sharedDestructorCoreResult task tk), canon.frames⟩ :: canon.rest)
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (callout : ∀ {left right : Config (core3 grow) (HostState sig)} {trailing : Trace grow sig}
      {ct : (core3 grow).Thread (CanonHost (core3 grow))} {host args},
      left.store = right.store → frame left right →
      left.ctl = ⟨check.thread, .core ct (sharedDestructorCoreResult task tk), check.frames⟩ :: check.rest →
      right.ctl = ⟨canon.thread, .core ct (sharedDestructorCoreResult task tk), canon.frames⟩ :: canon.rest →
      (core3 grow).status left.store.core ct = .callout host args →
      Steps profile ready (specDispatch ready base) left (.tau :: trailing) finish →
      SharedFramedCoreContinuation profile ready base bindings older check canon task tk frame
        (.tau :: trailing).length finish →
      CallbackSliceEnd profile ready base bindings older left right (.tau :: trailing) finish)
    (returned : ∀ {left right : Config (core3 grow) (HostState sig)} {trailing : Trace grow sig} (words : List FlatValue),
      left.store = right.store → frame left right →
      left.ctl = check.control (sharedDestructorCoreResult task tk words) →
      right.ctl = canon.control (sharedDestructorCoreResult task tk words) →
      Steps profile ready (specDispatch ready base) left trailing finish →
      CallbackSliceEnd profile ready base bindings older left right trailing finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  induction size : labels.length using Nat.strong_induction_on generalizing start incoming initial labels with
  | ind bound ih =>
    cases run with
    | refl => exact .exhausted
    | @cons _ _ _ _ suffix first tail =>
      have smaller : suffix.length < bound := by
        rw [← size, List.length_cons]
        omega
      have impossible : start.ctl ≠ [] := by rw [leftAt]; exact List.cons_ne_nil _ _
      cases first with
      | coreInternal found status internal =>
        rw [leftAt] at found
        cases found
        rename_i coreStore coreStep
        have step := Step.coreInternal (prof := profile) (hr := ready)
          (dispatch := specDispatch ready (LiveDispatch.host bindings base)) rightAt (same ▸ status) (same ▸ internal)
        have paths := sharedSchedulerTransport (bindings := bindings) (edit := .same)
          (.coreInternal leftAt status internal) step rfl rfl
        exact .destructorPrefix paths (frameCalloutStep paths rfl rfl) (fun scheduler => scheduler)
          (ih suffix.length smaller
            (by change { start.store with core := coreStore } = { incoming.store with core := coreStore }; rw [same])
            (coreFrame aligned _ _ _ _) rfl rfl tail rfl)
      | coreReturned found status =>
        rw [leftAt] at found
        cases found
        have step := Step.coreReturned (prof := profile) (hr := ready)
          (dispatch := specDispatch ready (LiveDispatch.host bindings base)) rightAt (same ▸ status)
        have paths := sharedSchedulerTransport (bindings := bindings) (edit := .same)
          (.coreReturned leftAt status) step
          (by simp only [transitionEdit, leftAt, status]) (by simp only [transitionEdit, rightAt, ← same, status])
        exact .destructorPrefix paths (frameCalloutStep paths rfl rfl) (fun scheduler => scheduler) (returned _ same (coreFrame aligned _ _ _ _) rfl rfl tail)
      | coreTrap found status =>
        rw [leftAt] at found
        cases found
        have step := Step.coreTrap (prof := profile) (hr := ready)
          (dispatch := specDispatch ready (LiveDispatch.host bindings base)) rightAt (same ▸ status)
        have paths := sharedSchedulerTransport (bindings := bindings) (edit := .clear)
          (.coreTrap leftAt status) step rfl rfl
        exact .coreAcceptTerminal paths (frameCalloutStep paths rfl rfl) tail (.inr (.inr (.inr ⟨rfl, rfl⟩)))
      | coreCallout found status =>
        rw [leftAt] at found
        cases found
        refine callout same aligned leftAt rightAt status (.cons (.coreCallout leftAt status) tail) ?_
        intro _ _ remaining _ less paired aligned reached peer run
        exact ih remaining.length (size ▸ less) paired aligned reached peer run rfl
      | fault fault =>
        cases fault <;> simp_all
      | _ => simp_all [StepDefs.HostReadyCfg]

open ReturnFrame.Occurrence in
private theorem crossSharedDestructorCore {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    {initial : (core3 grow).Thread (CanonHost (core3 grow))} (task : TaskId) (tk : Task (core3 grow))
    (same : start.store = incoming.store)
    (leftAt : start.ctl = ⟨check.thread, .core initial (sharedDestructorCoreResult task tk), check.frames⟩ :: check.rest)
    (rightAt : incoming.ctl = ⟨canon.thread, .core initial (sharedDestructorCoreResult task tk), canon.frames⟩ :: canon.rest)
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (callout : ∀ {left right : Config (core3 grow) (HostState sig)} {trailing : Trace grow sig}
      {ct : (core3 grow).Thread (CanonHost (core3 grow))} {host args},
      left.store = right.store →
      left.ctl = ⟨check.thread, .core ct (sharedDestructorCoreResult task tk), check.frames⟩ :: check.rest →
      right.ctl = ⟨canon.thread, .core ct (sharedDestructorCoreResult task tk), canon.frames⟩ :: canon.rest →
      (core3 grow).status left.store.core ct = .callout host args →
      Steps profile ready (specDispatch ready base) left (.tau :: trailing) finish →
      SharedDestructorCoreContinuation profile ready base bindings older check canon task tk
        (.tau :: trailing).length finish →
      CallbackSliceEnd profile ready base bindings older left right (.tau :: trailing) finish)
    (returned : ∀ {left right : Config (core3 grow) (HostState sig)} {trailing : Trace grow sig} (words : List FlatValue),
      left.store = right.store →
      left.ctl = check.control (sharedDestructorCoreResult task tk words) →
      right.ctl = canon.control (sharedDestructorCoreResult task tk words) →
      Steps profile ready (specDispatch ready base) left trailing finish →
      CallbackSliceEnd profile ready base bindings older left right trailing finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish :=
  crossSharedDestructorCoreWith (frame := fun _ _ => True) task tk (fun _ _ _ _ _ => trivial)
    same trivial leftAt rightAt run
    (fun stores _ checked canonical status tail reenter =>
      callout stores checked canonical status tail
        (fun shorter same atLeft atRight run => reenter shorter same trivial atLeft atRight run))
    (fun words stores _ checked canonical tail => returned words stores checked canonical tail)

open ReturnFrame.Occurrence in
private theorem crossSharedDestructorCoreResult {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    (task : TaskId) (tk : Task (core3 grow)) (width : AddrType) (words : List FlatValue)
    (typeAt : tk.ft = dtorType width)
    (stores : start.store = incoming.store)
    (leftAt : start.ctl = check.control (sharedDestructorCoreResult task tk words))
    (rightAt : incoming.ctl = canon.control (sharedDestructorCoreResult task tk words))
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (finishRead : ∀ {left right : Config (core3 grow) (HostState sig)} {trailing : Trace grow sig},
      left.store = right.store →
      left.ctl = check.control (sharedDestructorFinish task []) →
      right.ctl = canon.control (sharedDestructorFinish task []) →
      Steps profile ready (specDispatch ready base) left trailing finish →
      CallbackSliceEnd profile ready base bindings older left right trailing finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  have noResults : resultTypes tk.ft = [] := by rw [typeAt]; rfl
  have program : (sharedDestructorCoreResult task tk words : Session grow sig (Ret (core3 grow))) =
      .op .get (fun _ => sharedDestructorFinish task []) := by
    unfold sharedDestructorCoreResult
    dsimp only
    rw [noResults, sharedDestructorNoResultCode]
    rfl
  rw [program] at leftAt rightAt
  have checkRead := Step.get (prof := profile) (hr := ready) (dispatch := specDispatch ready base)
    (th := check.thread) (segs := check.frames) (rest := check.rest) (k := fun _ => sharedDestructorFinish task []) leftAt
  have canonRead := Step.get (prof := profile) (hr := ready) (dispatch := specDispatch ready (LiveDispatch.host bindings base))
    (th := canon.thread) (segs := canon.frames) (rest := canon.rest) (k := fun _ => sharedDestructorFinish task []) rightAt
  cases run with
  | refl => exact .exhausted
  | cons first tail =>
    obtain ⟨rfl, rfl⟩ := silentStepUnique checkRead first
    have read := sharedSchedulerTransport (bindings := bindings) (edit := .same) checkRead canonRead
      (by rw [transitionEdit, leftAt]; rfl) (by rw [transitionEdit, rightAt]; rfl)
    exact .destructorPrefix read (frameCalloutStep read rfl rfl) (fun scheduler => scheduler) (finishRead stores rfl rfl tail)

private def sharedDestructorReturnCall (task : TaskId) (tk : Task (core3 grow)) (values : List Value.Val := []) : Session grow sig (Ret (core3 grow)) :=
  if tk.state = .resolved then trap .taskReturnTwice
  else if tk.numBorrows > 0 then trap .borrowsRemain
  else .op (.call (.onResolve tk.caller (some values))) (sharedDestructorResolveReply task)

private theorem sharedDestructorCompletionCode (task : TaskId) (values : List Value.Val := []) :
    (sharedDestructorFinish task values : Session grow sig (Ret (core3 grow))) =
      .op .get (fun store => match ArenaField.tasks.get? store task with
        | none => internal "dangling arena id"
        | some tk => sharedDestructorReturnCall task tk values) := by
  simp [sharedDestructorFinish, Task.return_, getTask, getObj, getStore, perform, Prog.lift, bind, Prog.bind]
  congr 1
  funext store
  change CStore (core3 grow) at store
  cases found : ArenaField.tasks.get? store task with
  | none =>
    simp [internal, trap, Prog.bind]
    congr 1
    funext response
    cases response
  | some tk =>
    unfold sharedDestructorReturnCall
    by_cases resolved : tk.state = .resolved
    · simp [resolved, trapIf, trap, Prog.bind]
      congr 1
      funext response
      cases response
    · by_cases borrows : tk.numBorrows > 0
      · simp [resolved, borrows, trapIf, trap, Prog.bind]
        congr 1
        funext response
        cases response
      · simp [resolved, borrows, trapIf, callUnit, callRet, Prog.lift, perform, modifyStore, bind, Prog.bind]
        congr 1
        funext ret
        cases ret <;> try rfl
        all_goals simp [sharedDestructorResolveReply, internal, trap, Prog.bind]
        all_goals congr 1
        all_goals funext response
        all_goals cases response

private def sharedDestructorResolveFromRecord (caller : CallerId) (values : List Value.Val) (record : Caller (core3 grow)) : Session grow sig (Ret (core3 grow)) :=
  match record with
  | .host call _ depth => do
    if depth = 0 then emit (.resolved call (some values))
    return .unit
  | .lower .. => do
    lowerOnResolve Limits.spec Quirks.none caller (some values)
    return .unit
  | .sub (.invoke _ _) => do
    modifyObj ArenaField.callers caller (DispatchSt.recordInvokeResult (some values))
    return .unit
  | .sub _ => onResolveProg caller (some values)

private theorem sharedDestructorResolveDispatchCode (caller : CallerId) (ready : HostReady (HostState sig))
    (host : HostImpl (core3 grow) (HostState sig)) (values : List Value.Val := []) :
    specDispatch ready host (.onResolve caller (some values)) =
      getObj ArenaField.callers caller >>= sharedDestructorResolveFromRecord caller values := by
  change (callerOnResolve Limits.spec Quirks.none caller (some values) : Session grow sig (Ret (core3 grow))) = _
  unfold callerOnResolve
  simp only [Prog.bind_eq]
  congr 1
  funext record
  cases record <;> try rfl
  rename_i tag
  cases tag <;> rfl

private def sharedDestructorInnerResolve (record : Caller (core3 grow)) : Session grow sig (Ret (core3 grow)) :=
  match record with
  | .sub (.realloc _ _) => internal "reallocate: on_resolve expects exactly one result"
  | .sub (.destructor _) => .pure .unit
  | .sub .start => .pure .unit
  | _ => internal "onResolveProg: not an internal caller"

private theorem sharedDestructorInnerResolveCode (caller : CallerId) :
    (onResolveProg caller (some []) : Session grow sig (Ret (core3 grow))) =
      getObj ArenaField.callers caller >>= sharedDestructorInnerResolve := by
  unfold onResolveProg
  simp only [Prog.bind_eq]
  congr 1
  funext record
  cases record <;> try rfl
  rename_i tag
  cases tag <;> rfl

private def sharedDestructorResolved (task : TaskId) (s : CStore (core3 grow)) : Prop :=
  ∀ tk, s.task? task = some tk → tk.state = .resolved

private theorem sharedDestructorResolvedWrite (task : TaskId) (s : CStore (core3 grow)) :
    sharedDestructorResolved task (CStore.setTaskState task .resolved s) := by
  intro tk found
  change ArenaField.tasks.get? (ArenaField.tasks.modify s task (Task.withState .resolved)) task = some tk at found
  rw [ArenaField.get?_modify_self] at found
  cases h : ArenaField.tasks.get? s task with
  | none => simp [h] at found
  | some original =>
    have eq : original.withState .resolved = tk := by simpa [h] using found
    rw [← eq]
    rfl

private theorem sharedDestructorUnregisterPreserves (task : TaskId) (worker : ThreadId) (index : Nat)
    (s : CStore (core3 grow)) (resolved : sharedDestructorResolved task s) :
    sharedDestructorResolved task (CStore.unregisterThreadSt task worker index s) := by
  cases found : s.task? task with
  | none => simpa only [CStore.unregisterThreadSt, found] using resolved
  | some record =>
    intro tk lookup
    simp only [CStore.unregisterThreadSt, found] at lookup
    change ArenaField.tasks.get? (ArenaField.tasks.modify s task (fun old => {old with threads := old.threads.erase worker})) task =
      some tk at lookup
    rw [ArenaField.get?_modify_self] at lookup
    have original : ArenaField.tasks.get? s task = some record := found
    rw [original] at lookup
    have eq : { record with threads := record.threads.erase worker } = tk := Option.some.inj lookup
    rw [← eq]
    exact resolved record found

private theorem sharedDestructorExitPreserves (task : TaskId) (worker : ThreadId)
    (s : CStore (core3 grow)) (resolved : sharedDestructorResolved task s) :
    sharedDestructorResolved task (StepDefs.threadStatusSt worker .exited s) := resolved

private theorem sharedDestructorGetPreserves {Id Data} (task : TaskId) (field : ArenaField (core3 grow) Id Data) (id : Id) :
    Prog.Every (storePreserves (sharedDestructorResolved task)) (getObj field id : Session grow sig Data) := by
  unfold getObj
  refine (show Prog.Every (storePreserves (sharedDestructorResolved task)) (getStore : Session grow sig _) from
    .op trivial fun _ => .pure _).bind fun _ => ?_
  split
  · exact .pure _
  · exact .op trivial (fun impossible => nomatch impossible)

private theorem sharedDestructorOrTrapPreserves {Data} (task : TaskId) (reason : TrapReason) (data : Option Data) :
    Prog.Every (storePreserves (sharedDestructorResolved task)) (orTrap reason data : Session grow sig Data) := by
  cases data
  · exact .op trivial (fun impossible => nomatch impossible)
  · exact .pure _

private theorem sharedDestructorUnregisterKeepsResolved (task : TaskId) (worker : ThreadId) :
    Prog.Every (storePreserves (sharedDestructorResolved task)) (Task.unregisterThread task worker : Session grow sig Unit) := by
  unfold Task.unregisterThread getTask getThread getInst
  refine (sharedDestructorGetPreserves task ArenaField.tasks task).bind fun tk =>
    (show Prog.Every (storePreserves (sharedDestructorResolved task)) (trapIf _ .taskNotResolved : Session grow sig Unit) from ?_).bind fun _ =>
    (sharedDestructorGetPreserves task ArenaField.threads worker).bind fun thread =>
    (sharedDestructorOrTrapPreserves task _ thread.index).bind fun index =>
    (sharedDestructorGetPreserves task ArenaField.insts tk.inst).bind fun inst => ?_
  · unfold trapIf
    split
    · exact .op trivial (fun impossible => nomatch impossible)
    · exact .pure _
  · split
    · exact .op trivial (fun impossible => nomatch impossible)
    · exact .op (sharedDestructorUnregisterPreserves task worker index) (fun _ => .pure _)

private theorem sharedDestructorExitKeepsResolved (task : TaskId) :
    Prog.Every (storePreserves (sharedDestructorResolved task)) (Task.exitImplicitThread task : Session grow sig Unit) := by
  unfold Task.exitImplicitThread getTask
  refine (sharedDestructorGetPreserves task ArenaField.tasks task).bind fun tk =>
    (sharedDestructorOrTrapPreserves task _ tk.implicitThread).bind fun thread =>
    (sharedDestructorUnregisterKeepsResolved task thread).bind fun _ => ?_
  split
  · unfold modifyInst modifyObj
    exact .op (fun _ keeps => keeps) fun _ => .pure _
  · exact .pure _

private theorem sharedDestructorUnregisterEffects (task : TaskId) (thread : ThreadId) :
    StoreEffects (Task.unregisterThread task thread : Session grow sig Unit) := by
  unfold Task.unregisterThread getTask getThread getInst
  refine (storeEffectGetObject ArenaField.tasks task).bind fun tk =>
    (storeEffectTrapIf _ .taskNotResolved).bind fun _ =>
    (storeEffectGetObject ArenaField.threads thread).bind fun th =>
    (storeEffectOrTrap _ th.index).bind fun index =>
    (storeEffectGetObject ArenaField.insts tk.inst).bind fun inst => ?_
  split
  · exact storeEffectTrap _
  · exact storeEffectModify _

private theorem sharedDestructorExitEffects (task : TaskId) :
    StoreEffects (Task.exitImplicitThread task : Session grow sig Unit) := by
  unfold Task.exitImplicitThread getTask
  refine (storeEffectGetObject ArenaField.tasks task).bind fun tk =>
    (storeEffectOrTrap _ tk.implicitThread).bind fun thread =>
    (sharedDestructorUnregisterEffects task thread).bind fun _ => ?_
  split
  · unfold modifyInst modifyObj
    exact storeEffectModify _
  · exact .pure _

private def destructorWorkerOp (invariant : CStore (core3 grow) → Prop) :
    (Eff (core3 grow) (HostState sig)).Op → Prop
  | .newThread body =>
    match body with
    | .newIndirect task _ _ => ∀ store, invariant store →
        invariant (ArenaField.threads.alloc store { task := task }).1
    | _ => False
  | operation => componentStoreOp operation = true ∧ storePreserves invariant operation

private abbrev DestructorWorkerEffects {Result : Type} (invariant : CStore (core3 grow) → Prop) (body : Session grow sig Result) :=
  Prog.Every (destructorWorkerOp invariant) body

private theorem liftDestructorStoreEffects {Result : Type} {invariant : CStore (core3 grow) → Prop}
    {body : Session grow sig Result} (effects : StoreEffects body)
    (preserves : Prog.Every (storePreserves invariant) body) :
    DestructorWorkerEffects invariant body := by
  induction effects with
  | pure value => exact .pure value
  | @op operation next allowed _ ih =>
    cases preserves with
    | op kept following =>
      refine .op ?_ (fun response => ih response (following response))
      cases operation <;> try exact ⟨allowed, kept⟩
      contradiction

open ReturnFrame.Occurrence in
/-- The active worker executes store-local operations above two distinct
dormant programs. The relation compares the actual top and stores without
requiring equality of the dormant programs. -/
private theorem crossSharedWorkerBodyWith {Result : Type} {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    (threads : check.thread = canon.thread)
    (body : Session grow sig Result) (complete canonicalComplete : Result → Session grow sig (Ret (core3 grow)))
    {invariant : CStore (core3 grow) → Prop}
    (effects : DestructorWorkerEffects invariant body) (initial : invariant start.store)
    (stores : start.store = incoming.store)
    (leftAt : start.ctl = check.control (body >>= complete)) (rightAt : incoming.ctl = canon.control (body >>= canonicalComplete))
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (returned : ∀ {left right : Config (core3 grow) (HostState sig)} {remaining : Trace grow sig} (reply : Result),
      remaining.length ≤ labels.length → invariant left.store → left.store = right.store → left.ctl = check.control (complete reply) → right.ctl = canon.control (canonicalComplete reply) →
      (DestructorSchedulerAlignment older start incoming → DestructorSchedulerAlignment older left right) →
      Steps profile ready (specDispatch ready base) left remaining finish →
      CallbackSliceEnd profile ready base bindings older left right remaining finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  induction labels generalizing start incoming body with
  | nil =>
    cases run
    exact .exhausted
  | cons label suffix ih =>
    cases body with
    | pure reply => exact returned reply (Nat.le_refl _) initial stores leftAt rightAt (fun aligned => aligned) run
    | op action next =>
      obtain ⟨permitted, continuing⟩ := (show _ ∧ _ from by cases effects with
        | op allowed follow => exact ⟨allowed, follow⟩)
      cases run with
      | cons actual tail =>
        have consume (response : (Eff (core3 grow) (HostState sig)).Resp action)
            (updated : CStore (core3 grow)) (keeps : invariant updated) {observed : Label (core3 grow) (HostState sig)}
            (lhs : Step profile ready (specDispatch ready base) start observed
              { start with store := updated, ctl := check.control (next response >>= complete) })
            (rhs : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming observed
              { incoming with store := updated, ctl := canon.control (next response >>= canonicalComplete) })
            (leftEdit : transitionEdit start observed = .same) (rightEdit : transitionEdit incoming observed = .same)
            (actualTail : Steps profile ready (specDispatch ready base)
              { start with store := updated, ctl := check.control (next response >>= complete) } suffix finish) :
            CallbackSliceEnd profile ready base bindings older start incoming (observed :: suffix) finish := by
          have path := sharedSchedulerTransport (bindings := bindings) lhs rhs leftEdit rightEdit
          exact .destructorPrefix path (frameCalloutStep path rfl rfl) (fun scheduler => scheduler)
            (ih (next response) (continuing response) keeps rfl rfl rfl actualTail
              (fun value shorter => returned value (Nat.le_trans shorter (Nat.le_succ _))))
        have silent (response : (Eff (core3 grow) (HostState sig)).Resp action)
            (updated : CStore (core3 grow)) (keeps : invariant updated)
            (lhs : Step profile ready (specDispatch ready base) start .tau
              { start with store := updated, ctl := check.control (next response >>= complete) })
            (rhs : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau
              { incoming with store := updated, ctl := canon.control (next response >>= canonicalComplete) })
            (leftEdit : transitionEdit start .tau = .same) (rightEdit : transitionEdit incoming .tau = .same) :
            CallbackSliceEnd profile ready base bindings older start incoming (label :: suffix) finish := by
          obtain ⟨actualLabel, actualNext⟩ := silentStepUnique lhs actual
          exact actualLabel.symm ▸ consume response updated keeps lhs rhs leftEdit rightEdit (actualNext ▸ tail)
        cases action with
        | get =>
          exact silent start.store start.store initial (.get leftAt)
            (by rw [stores]; exact .get rightAt)
            (by rw [transitionEdit, leftAt]; rfl) (by rw [transitionEdit, rightAt]; rfl)
        | modify update =>
          exact silent () (update start.store) (permitted.2 _ initial) (.modify leftAt)
            (by rw [stores]; exact .modify rightAt)
            (by rw [transitionEdit, leftAt]; rfl) (by rw [transitionEdit, rightAt]; rfl)
        | currentThread =>
          exact silent check.thread start.store initial (.currentThread leftAt)
            (by rw [stores, threads]; exact .currentThread rightAt)
            (by rw [transitionEdit, leftAt]; rfl) (by rw [transitionEdit, rightAt]; rfl)
        | choose choice =>
          obtain ⟨answer, rfl, rfl, allowed⟩ := componentChoiceActual leftAt actual
          exact consume answer start.store initial (.choose answer leftAt allowed)
            (by rw [stores]; exact .choose answer rightAt allowed) rfl rfl tail
        | newThread threadBody =>
          cases threadBody with
          | newIndirect task function argument =>
            let source : ThreadBody (core3 grow) := .newIndirect task function argument
            let allocation := ArenaField.threads.alloc start.store { task := task }
            let saved := StepDefs.threadAct (specDispatch ready base) allocation.2 source
            let checked := { start.setCont allocation.2 (some saved) with
              store := allocation.1, ctl := check.control (next allocation.2 >>= complete) }
            let canonical := { incoming.setCont allocation.2 (some saved) with
              store := allocation.1, ctl := canon.control (next allocation.2 >>= canonicalComplete) }
            have leftStep : Step profile ready (specDispatch ready base) start .tau checked :=
              .newThread leftAt rfl
            have rightStep : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau canonical :=
              .newThread rightAt (by rw [← stores]; rfl)
            obtain ⟨rfl, rfl⟩ := silentStepUnique leftStep actual
            have moved := sharedSchedulerTransport (bindings := bindings) (edit := .write allocation.2.idx [])
              leftStep rightStep (by rw [transitionEdit, leftAt]; rfl) (by rw [transitionEdit, rightAt, ← stores]; rfl)
            have savedAlignment (scheduler : DestructorSchedulerAlignment older start incoming) :
                DestructorSchedulerAlignment older checked canonical :=
              ⟨relatedSetSlot .none scheduler.1 allocation.2.idx (.some (.mk .nil)), scheduler.2⟩
            exact .destructorPrefix moved (frameCalloutStep moved rfl rfl) savedAlignment
              (ih (next allocation.2) (continuing allocation.2) (permitted _ initial) rfl rfl rfl tail
                (fun value shorter ok same atLeft atRight nextAlignment =>
                  returned value (Nat.le_trans shorter (Nat.le_succ _)) ok same atLeft atRight (nextAlignment ∘ savedAlignment)))
          | _ => exact False.elim permitted
        | trap reason =>
          obtain ⟨rfl, rfl⟩ := componentTrapUnique leftAt actual
          have path := sharedSchedulerTransport (profile := profile) (ready := ready) (base := base) (bindings := bindings)
            (edit := .clear) (.trap leftAt) (.trap rightAt) rfl rfl
          exact .coreAcceptTerminal path (frameCalloutStep path rfl rfl) tail (.inr (.inr (.inr ⟨rfl, rfl⟩)))
        | _ => exact (Bool.noConfusion permitted.1)

private theorem crossSharedWorkerBody {Result : Type} {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    (threads : check.thread = canon.thread)
    (body : Session grow sig Result) (complete : Result → Session grow sig (Ret (core3 grow)))
    {invariant : CStore (core3 grow) → Prop}
    (effects : DestructorWorkerEffects invariant body) (initial : invariant start.store)
    (stores : start.store = incoming.store)
    (leftAt : start.ctl = check.control (body >>= complete)) (rightAt : incoming.ctl = canon.control (body >>= complete))
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (returned : ∀ {left right : Config (core3 grow) (HostState sig)} {remaining : Trace grow sig} (reply : Result),
      remaining.length ≤ labels.length → invariant left.store → left.store = right.store → left.ctl = check.control (complete reply) → right.ctl = canon.control (complete reply) →
      Steps profile ready (specDispatch ready base) left remaining finish →
      CallbackSliceEnd profile ready base bindings older left right remaining finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish :=
  crossSharedWorkerBodyWith threads body complete complete effects initial stores leftAt rightAt run
    (fun value shorter ok same atLeft atRight _ => returned value shorter ok same atLeft atRight)

private theorem crossSharedWorkerStore {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    (threads : check.thread = canon.thread)
    (body : Session grow sig (Ret (core3 grow))) (effects : StoreEffects body)
    {invariant : CStore (core3 grow) → Prop}
    (preserves : Prog.Every (storePreserves invariant) body) (initial : invariant start.store)
    (stores : start.store = incoming.store)
    (leftAt : start.ctl = check.control body) (rightAt : incoming.ctl = canon.control body)
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (returned : ∀ {left right : Config (core3 grow) (HostState sig)} {remaining : Trace grow sig} (reply : Ret (core3 grow)),
      invariant left.store → left.store = right.store → left.ctl = check.control (.pure reply) → right.ctl = canon.control (.pure reply) →
      Steps profile ready (specDispatch ready base) left remaining finish →
      CallbackSliceEnd profile ready base bindings older left right remaining finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish :=
  crossSharedWorkerBody (check := check) (canon := canon) threads body Prog.pure (liftDestructorStoreEffects effects preserves) initial stores
    (by simpa only [Prog.bind_eq, Prog.bind_pure] using leftAt)
    (by simpa only [Prog.bind_eq, Prog.bind_pure] using rightAt) run (fun reply _ => returned reply)

open ReturnFrame.Occurrence in
private theorem crossSharedDestructorExit {checkRest canonRest : List (Activation (core3 grow) (HostState sig))}
    (task : TaskId) (worker : ThreadId) (stores : start.store = incoming.store)
    (leftAt : start.ctl = (PayloadPrefix.Cursor.mk (some worker) [] checkRest).control (sharedDestructorResolveReply task .unit))
    (rightAt : incoming.ctl = (PayloadPrefix.Cursor.mk (some worker) [] canonRest).control (sharedDestructorResolveReply task .unit))
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (parent : ∀ {left right : Config (core3 grow) (HostState sig)} {remaining : Trace grow sig},
      sharedDestructorResolved task left.store → left.store = right.store → left.ctl = checkRest → right.ctl = canonRest →
      Steps profile ready (specDispatch ready base) left remaining finish →
      CallbackSliceEnd profile ready base bindings older left right remaining finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, [], checkRest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨some worker, [], canonRest⟩
  let exit : Session grow sig (Ret (core3 grow)) := Task.exitImplicitThread task >>= fun _ => .pure .unit
  let write := CStore.setTaskState (E := core3 grow) task .resolved
  let left := { start with store := write start.store, ctl := check.control exit }
  let right := { incoming with store := write incoming.store, ctl := canon.control exit }
  have leftWrite : Step profile ready (specDispatch ready base) start .tau left :=
    .modify (th := check.thread) (segs := check.frames) (rest := check.rest) (f := write) (k := fun _ => exit) leftAt
  have rightWrite : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau right :=
    .modify (th := canon.thread) (segs := canon.frames) (rest := canon.rest) (f := write) (k := fun _ => exit) rightAt
  cases run with
  | refl => exact .exhausted
  | cons first tail =>
    obtain ⟨rfl, rfl⟩ := silentStepUnique leftWrite first
    have wrote := sharedSchedulerTransport (bindings := bindings) (edit := .same) leftWrite rightWrite
      (by rw [transitionEdit, leftAt]; rfl) (by rw [transitionEdit, rightAt]; rfl)
    refine .destructorPrefix wrote (frameCalloutStep wrote rfl rfl) (fun scheduler => scheduler) ?_
    refine crossSharedWorkerStore (check := check) (canon := canon) rfl exit
      ((sharedDestructorExitEffects task).bind fun _ => .pure _)
      ((sharedDestructorExitKeepsResolved task).bind fun _ => .pure _)
      (sharedDestructorResolvedWrite task start.store) (congrArg write stores) rfl rfl tail ?_
    intro left right remaining reply resolved stores leftAt rightAt run
    let checked := { left with store := StepDefs.threadStatusSt worker .exited left.store, ctl := checkRest }
    let canonical := { right with store := StepDefs.threadStatusSt worker .exited right.store, ctl := canonRest }
    have leftExit : Step profile ready (specDispatch ready base) left .tau checked :=
      .threadExit (t := worker) (r := reply) leftAt
    have rightExit : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) right .tau canonical :=
      .threadExit (t := worker) (r := reply) rightAt
    rcases splitSilent (count := 1) (.cons leftExit (.refl _)) run with ⟨after, used, tail⟩ | short
    · rw [used]
      have paths := sharedSchedulerTransport (bindings := bindings) (edit := .exit) leftExit rightExit
        (by rw [transitionEdit, leftAt]; rfl) (by rw [transitionEdit, rightAt]; rfl)
      exact .destructorPrefix paths (frameCalloutStep paths rfl rfl) (fun scheduler => scheduler)
        (parent (sharedDestructorExitPreserves task worker left.store resolved)
        (congrArg (StepDefs.threadStatusSt worker .exited) stores) rfl rfl tail)
    · have empty : remaining = [] := List.length_eq_zero_iff.mp (by omega)
      have stopped := stepsAtEmpty (empty ▸ run)
      exact empty.symm ▸ stopped ▸ CallbackSliceEnd.exhausted

open ReturnFrame.Occurrence in
private theorem compareSharedDestructorTrap {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    (reason : TrapReason) (leftAt : start.ctl = check.control (trap reason))
    (rightAt : incoming.ctl = canon.control (trap reason))
    (run : Steps profile ready (specDispatch ready base) start labels finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  cases run with
  | refl => exact .exhausted
  | cons actual tail =>
    obtain ⟨rfl, rfl⟩ := componentTrapUnique leftAt actual
    have path := sharedSchedulerTransport (profile := profile) (ready := ready) (base := base) (bindings := bindings)
      (edit := .clear) (.trap leftAt) (.trap rightAt) rfl rfl
    exact .coreAcceptTerminal path (frameCalloutStep path rfl rfl) tail (.inr (.inr (.inr ⟨rfl, rfl⟩)))

private theorem sharedDestructorInnerResolveEffects (caller : CallerId) :
    StoreEffects (onResolveProg caller (some []) : Session grow sig (Ret (core3 grow))) := by
  rw [sharedDestructorInnerResolveCode]
  refine (storeEffectGetObject ArenaField.callers caller).bind fun record => ?_
  cases record with
  | host => exact storeEffectTrap _
  | lower => exact storeEffectTrap _
  | sub kind => cases kind <;> first | exact storeEffectTrap _ | exact .pure _

private theorem componentEmitUnique {observation : HostObs}
    {cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    {k : Unit → Session grow sig (Ret (core3 grow))}
    (focused : start.ctl = cursor.control (.op (.emit observation) k))
    {label next} (actual : Step profile ready (specDispatch ready base) start label next) :
    label = .obs observation ∧ next = { StepDefs.observe start observation with ctl := cursor.control (k ()) } := by
  cases cursor
  cases actual
  all_goals try (cases (show Fault start _ from by assumption))
  all_goals simp_all [PayloadPrefix.Cursor.control, StepDefs.HostReadyCfg]
  all_goals
    have heads := (show (_ ∧ Prog.op (S := Eff (core3 grow) (HostState sig)) (α := Ret (core3 grow)) _ _ = Prog.op _ _ ∧ _) ∧ _
      from by assumption)
    obtain ⟨⟨_, programs, _⟩, _⟩ := heads
    obtain ⟨op, continuation⟩ := progOpEq programs
    simp_all
  obtain rfl := Op.emit.inj op
  exact ⟨rfl, rfl, rfl, rfl, congrFun (eq_of_heq continuation) (), rfl, rfl, rfl⟩

private theorem sharedDestructorProgressEffects (subtask : SubtaskId) :
    StoreEffects (maybeOnProgress subtask : Session grow sig Unit) := by
  unfold maybeOnProgress
  refine (storeEffectGetObject ArenaField.subtasks subtask).bind fun reached => ?_
  split
  · exact storeEffectModify (CStore.setPendingSt (.subtask subtask) (.subtask subtask))
  · exact .pure _

private theorem sharedDestructorLowerResultEffects (cx : LiftLowerContext (core3 grow)) (maxResults : Nat)
    (types : List (WIT.ClosedType RtId)) (cursor : FlatCursor) :
    StoreEffects (lowerFlatValues Limits.spec Quirks.none cx maxResults [] types (some cursor) :
      Session grow sig (List FlatValue)) := by
  unfold lowerFlatValues
  refine (storeEffectPtrType cx).bind fun width => ?_
  split
  · unfold spillPointer FlatCursor.next
    have pointer : StoreEffects ((match cursor.values[cursor.pos]? with
        | some value => pure (value, { cursor with pos := cursor.pos + 1 })
        | none => internal "CoreValueIter.next: no more flat values") :
        Session grow sig (FlatValue × FlatCursor)) := by
      split
      · exact .pure _
      · exact storeEffectTrap _
    refine (pointer.bind fun pair => .pure _).bind fun output => ?_
    obtain ⟨ptr, flat⟩ := output
    refine (storeEffectTrapIf _ .unalignedPointer).bind fun _ =>
      (storeEffectBounds _ _ _).bind fun _ => ?_
    have tuple : StoreEffects (Canon.store Limits.spec Quirks.none cx (.record []) (.tuple types) ptr :
        Session grow sig Unit) := by
      simp only [Canon.store]
      cases types
      · simp only [storeTuple]; exact .pure _
      · simp only [storeTuple]; exact storeEffectTrap _
    exact tuple.bind fun _ => .pure flat
  · cases types
    · exact .pure _
    · exact storeEffectTrap _

/-- The destructor's actual result carries zero WIT values. The result
program can read a spill cursor and check memory before rejecting a nonempty
schema. Successful lowering reaches the original subtask resolution update. -/
private theorem sharedDestructorLowerResolveEffects (caller : CallerId) :
    StoreEffects (lowerOnResolve Limits.spec Quirks.none caller (some []) : Session grow sig Unit) := by
  unfold lowerOnResolve
  refine (storeEffectGetObject ArenaField.callers caller).bind fun record => ?_
  cases record with
  | host | sub => exact storeEffectTrap _
  | lower subtask cx args pos ft maxParams maxResults =>
    exact (sharedDestructorProgressEffects subtask).bind fun _ =>
      (sharedDestructorLowerResultEffects cx maxResults ft.result.toList ⟨args, pos⟩).bind fun flat =>
        storeEffectModify (CStore.subtaskResolveSt subtask .returned flat)

open ReturnFrame.Occurrence in
private theorem crossSharedDestructorResolve {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    (task : TaskId) (caller : CallerId) (threads : check.thread = canon.thread) (stores : start.store = incoming.store)
    (leftAt : start.ctl = check.control (.op (.call (.onResolve caller (some []))) (sharedDestructorResolveReply task)))
    (rightAt : incoming.ctl = canon.control (.op (.call (.onResolve caller (some []))) (sharedDestructorResolveReply task)))
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (afterPop : ∀ {left right : Config (core3 grow) (HostState sig)} {trailing : Trace grow sig},
      left.store = right.store →
      left.ctl = check.control (sharedDestructorResolveReply task .unit) →
      right.ctl = canon.control (sharedDestructorResolveReply task .unit) →
      Steps profile ready (specDispatch ready base) left trailing finish →
      CallbackSliceEnd profile ready base bindings older left right trailing finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  let call : Call (core3 grow) := .onResolve caller (some [])
  let resume := sharedDestructorResolveReply (grow := grow) (sig := sig) task
  let checking := { check with frames := .prog resume :: check.frames }
  let canonical := { canon with frames := .prog resume :: canon.frames }
  let left := { start with ctl := checking.control (specDispatch ready base call) }
  let right := { incoming with ctl := canonical.control (specDispatch ready (LiveDispatch.host bindings base) call) }
  have leftCall : Step profile ready (specDispatch ready base) start .tau left :=
    .call (th := check.thread) (c := call) (k := resume) (segs := check.frames) (rest := check.rest) leftAt
  have rightCall : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau right :=
    .call (th := canon.thread) (c := call) (k := resume) (segs := canon.frames) (rest := canon.rest) rightAt
  cases run with
  | refl => exact .exhausted
  | @cons _ _ _ _ suffix actual tail =>
    obtain ⟨rfl, rfl⟩ := silentStepUnique leftCall actual
    have installed := sharedSchedulerTransport (bindings := bindings) (edit := .push (.prog resume))
      leftCall rightCall (by rw [transitionEdit, leftAt]; rfl) (by rw [transitionEdit, rightAt]; rfl)
    refine .destructorPrefix installed (frameCalloutStep installed rfl rfl) (fun scheduler => scheduler) ?_
    let read := sharedArenaReader ArenaField.callers caller (sharedDestructorResolveFromRecord (grow := grow) (sig := sig) caller [])
    have readCode (impl : HostImpl (core3 grow) (HostState sig)) :
        specDispatch ready impl call = .op .get read := by
      change specDispatch ready impl (.onResolve caller (some [])) = _
      rw [sharedDestructorResolveDispatchCode, sharedArenaReaderCode]
    have leftReadAt : left.ctl = checking.control (.op .get read) := congrArg checking.control (readCode base)
    have rightReadAt : right.ctl = canonical.control (.op .get read) := congrArg canonical.control (readCode _)
    let readLeft := { left with ctl := checking.control (read start.store) }
    let readRight := { right with ctl := canonical.control (read start.store) }
    have leftRead : Step profile ready (specDispatch ready base) left .tau readLeft :=
      .get (th := checking.thread) (segs := checking.frames) (rest := checking.rest) (k := read) leftReadAt
    have rightRead : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) right .tau readRight := by
      have step := Step.get (prof := profile) (hr := ready) (dispatch := specDispatch ready (LiveDispatch.host bindings base))
        (th := canonical.thread) (segs := canonical.frames) (rest := canonical.rest) (k := read) rightReadAt
      rw [congrArg read stores.symm] at step
      exact step
    rcases splitSilent (count := 1) (.cons leftRead (.refl _)) tail with ⟨afterRead, used, residual⟩ | short
    · rw [used]
      have visited := sharedSchedulerTransport (bindings := bindings) (edit := .same) leftRead rightRead
        (by rw [transitionEdit, leftReadAt]; rfl) (by rw [transitionEdit, rightReadAt]; rfl)
      refine .destructorPrefix visited (frameCalloutStep visited rfl rfl) (fun scheduler => scheduler) ?_
      have pop {l r : Config (core3 grow) (HostState sig)} {remaining : Trace grow sig}
          (reply : Ret (core3 grow)) (same : l.store = r.store)
          (lAt : l.ctl = checking.control (.pure reply)) (rAt : r.ctl = canonical.control (.pure reply))
          (run : Steps profile ready (specDispatch ready base) l remaining finish) :
          CallbackSliceEnd profile ready base bindings older l r remaining finish := by
        have leftPop := Step.popProg (prof := profile) (hr := ready) (dispatch := specDispatch ready base)
          (m := l) (th := check.thread) (r := reply) (k := resume) (segs := check.frames) (rest := check.rest) lAt
        have rightPop := Step.popProg (prof := profile) (hr := ready) (dispatch := specDispatch ready (LiveDispatch.host bindings base))
          (m := r) (th := canon.thread) (r := reply) (k := resume) (segs := canon.frames) (rest := canon.rest) rAt
        rcases splitSilent (count := 1) (.cons leftPop (.refl _)) run with ⟨trailing, used, tail⟩ | short
        · rw [used]
          have popped := sharedSchedulerTransport (bindings := bindings) (edit := .pop) leftPop rightPop
            (by rw [transitionEdit, lAt]; rfl) (by rw [transitionEdit, rAt]; rfl)
          refine .destructorPrefix popped (frameCalloutStep popped rfl rfl) (fun scheduler => scheduler) ?_
          cases reply <;> first | exact afterPop same rfl rfl tail |
            exact compareSharedDestructorTrap (.internal "late-bound call: expected Ret.unit") rfl rfl tail
        · have empty : remaining = [] := List.length_eq_zero_iff.mp (by omega)
          have stopped := stepsAtEmpty (empty ▸ run)
          exact empty.symm ▸ stopped ▸ CallbackSliceEnd.exhausted
      have closed (program : Session grow sig (Ret (core3 grow))) (effects : StoreEffects program)
          (code : read start.store = program) :
          CallbackSliceEnd profile ready base bindings older readLeft readRight afterRead finish :=
        crossSharedWorkerStore (check := checking) (canon := canonical) threads program effects (trivialPreserves _) trivial
          stores (congrArg checking.control code) (congrArg canonical.control code) residual
          (fun reply _ => pop reply)
      cases callerAt : ArenaField.callers.get? start.store caller with
      | none =>
        exact closed (internal "dangling arena id") (storeEffectTrap _)
          (by simp only [read, sharedArenaReader, callerAt])
      | some record =>
        have code : read start.store = sharedDestructorResolveFromRecord caller [] record := by
          simp only [read, sharedArenaReader, callerAt]
        cases record with
        | sub kind =>
          cases kind with
          | invoke =>
            refine closed _ ?_ code
            unfold sharedDestructorResolveFromRecord modifyObj
            exact (storeEffectModify _).bind fun _ => .pure _
          | _ => exact closed (onResolveProg caller (some [])) (sharedDestructorInnerResolveEffects caller) code
        | lower =>
          exact closed _ ((sharedDestructorLowerResolveEffects caller).bind fun _ => .pure _) code
        | host id args depth =>
          by_cases top : depth = 0
          · let observation := HostObs.resolved id (some [])
            let program : Session grow sig (Ret (core3 grow)) := .op (.emit observation) (fun _ => .pure .unit)
            have emits : read start.store = program := by
              rw [code]
              simp [sharedDestructorResolveFromRecord, top, program, observation, emit, perform, Prog.lift, bind, Prog.bind]
            have leftEmitAt : readLeft.ctl = checking.control program := congrArg checking.control emits
            have rightEmitAt : readRight.ctl = canonical.control program := congrArg canonical.control emits
            have emitLeft : Step profile ready (specDispatch ready base) readLeft (.obs observation)
                { StepDefs.observe readLeft observation with ctl := checking.control (.pure .unit) } :=
              .emit (th := checking.thread) (segs := checking.frames) (rest := checking.rest) (k := fun _ => .pure .unit) leftEmitAt
            have emitRight : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) readRight (.obs observation)
                { StepDefs.observe readRight observation with ctl := canonical.control (.pure .unit) } :=
              .emit (th := canonical.thread) (segs := canonical.frames) (rest := canonical.rest) (k := fun _ => .pure .unit) rightEmitAt
            cases empty : afterRead with
            | nil =>
              have stopped := stepsAtEmpty (empty ▸ residual)
              exact stopped ▸ CallbackSliceEnd.exhausted
            | cons label trailing =>
              have actual : Steps profile ready (specDispatch ready base) readLeft (label :: trailing) finish := empty ▸ residual
              cases actual with
              | cons step tail =>
                obtain ⟨rfl, rfl⟩ := componentEmitUnique (cursor := checking) leftEmitAt step
                have emitted := sharedSchedulerTransport (bindings := bindings) (edit := .same) emitLeft emitRight rfl rfl
                exact .destructorPrefix emitted (frameCalloutStep emitted rfl rfl)
                  (fun scheduler => DestructorSchedulerAlignment.observeResolved scheduler id (some [])) (pop .unit stores rfl rfl tail)
          · exact pop .unit stores
              (congrArg checking.control (by rw [code]; simp [sharedDestructorResolveFromRecord, top]))
              (congrArg canonical.control (by rw [code]; simp [sharedDestructorResolveFromRecord, top])) residual
    · have empty : suffix = [] := List.length_eq_zero_iff.mp (by omega)
      have stopped := stepsAtEmpty (empty ▸ tail)
      exact empty.symm ▸ stopped ▸ CallbackSliceEnd.exhausted

open ReturnFrame.Occurrence in
private theorem crossSharedDestructorCompletion {check canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)}
    (task : TaskId) (threads : check.thread = canon.thread) (stores : start.store = incoming.store)
    (leftAt : start.ctl = check.control (sharedDestructorFinish task []))
    (rightAt : incoming.ctl = canon.control (sharedDestructorFinish task []))
    (run : Steps profile ready (specDispatch ready base) start labels finish)
    (afterPop : ∀ {left right : Config (core3 grow) (HostState sig)} {trailing : Trace grow sig},
      left.store = right.store →
      left.ctl = check.control (sharedDestructorResolveReply task .unit) →
      right.ctl = canon.control (sharedDestructorResolveReply task .unit) →
      Steps profile ready (specDispatch ready base) left trailing finish →
      CallbackSliceEnd profile ready base bindings older left right trailing finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  rw [sharedDestructorCompletionCode] at leftAt rightAt
  let read (store : CStore (core3 grow)) : Session grow sig (Ret (core3 grow)) :=
    match ArenaField.tasks.get? store task with
    | none => internal "dangling arena id"
    | some reached => sharedDestructorReturnCall task reached
  let left := { start with ctl := check.control (read start.store) }
  let right := { incoming with ctl := canon.control (read start.store) }
  have leftRead : Step profile ready (specDispatch ready base) start .tau left :=
    .get (th := check.thread) (segs := check.frames) (rest := check.rest) (k := read) leftAt
  have rightRead : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau right := by
    have step := Step.get (prof := profile) (hr := ready) (dispatch := specDispatch ready (LiveDispatch.host bindings base))
      (th := canon.thread) (segs := canon.frames) (rest := canon.rest) (k := read) rightAt
    rw [congrArg read stores.symm] at step
    exact step
  cases run with
  | refl => exact .exhausted
  | cons first tail =>
    obtain ⟨rfl, rfl⟩ := silentStepUnique leftRead first
    have path := sharedSchedulerTransport (bindings := bindings) (edit := .same) leftRead rightRead
      (by rw [transitionEdit, leftAt]; rfl) (by rw [transitionEdit, rightAt]; rfl)
    refine .destructorPrefix path (frameCalloutStep path rfl rfl) (fun scheduler => scheduler) ?_
    have trapped {remaining : Trace grow sig} {outcome : Config (core3 grow) (HostState sig)}
        (reason : TrapReason) (focus : read start.store = trap reason)
        (tail : Steps profile ready (specDispatch ready base) left remaining outcome) :
        CallbackSliceEnd profile ready base bindings older left right remaining outcome := by
      have atLeft : left.ctl = check.control (trap reason) := congrArg check.control focus
      have atRight : right.ctl = canon.control (trap reason) := congrArg canon.control focus
      have leftTrap : Step profile ready (specDispatch ready base) left (.trap reason) (StepDefs.trapCfg left) :=
        .trap (th := check.thread) (segs := check.frames) (rest := check.rest) atLeft
      have rightTrap : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) right
          (.trap reason) (StepDefs.trapCfg right) :=
        .trap (th := canon.thread) (segs := canon.frames) (rest := canon.rest) atRight
      cases tail with
      | refl => exact .exhausted
      | cons actual rest =>
        obtain ⟨rfl, rfl⟩ := componentTrapUnique atLeft actual
        have paths := sharedSchedulerTransport (bindings := bindings) (edit := .clear) leftTrap rightTrap rfl rfl
        exact .coreAcceptTerminal paths (frameCalloutStep paths rfl rfl) rest (.inr (.inr (.inr ⟨rfl, rfl⟩)))
    cases found : ArenaField.tasks.get? start.store task with
    | none => exact trapped (.internal "dangling arena id") (by simp only [read, found, internal]) tail
    | some reached =>
      by_cases resolved : reached.state = .resolved
      · exact trapped .taskReturnTwice (by simp only [read, found, sharedDestructorReturnCall, resolved, ite_true]) tail
      by_cases borrows : reached.numBorrows > 0
      · exact trapped .borrowsRemain (by simp only [read, found, sharedDestructorReturnCall, resolved, borrows, ite_true, ite_false]) tail
      have code : read start.store = .op (.call (.onResolve reached.caller (some []))) (sharedDestructorResolveReply task) := by
        simp only [read, found, sharedDestructorReturnCall, resolved, borrows, ite_false]
      have atLeft := congrArg check.control code
      have atRight := congrArg canon.control code
      exact crossSharedDestructorResolve task reached.caller threads stores atLeft atRight tail afterPop

private theorem sharedDestructorParentCode (body : ThreadBody (core3 grow)) (ticket : Nat) :
    (sharedDestructorAfterResume body ticket : Session grow sig (Ret (core3 grow))) =
      .op (.call (.loop (.syncLiftLoop body.task))) (sharedDestructorParentReply ticket) := by
  simp [sharedDestructorAfterResume, callUnit, callRet, Prog.lift, perform, bind, Prog.bind]
  congr 1
  funext reply
  cases reply <;> try rfl
  all_goals simp [sharedDestructorParentReply, internal, trap, Prog.bind]
  all_goals congr 1
  all_goals funext response
  all_goals cases response

private def sharedDestructorReadLoopTask (ready : HostReady (HostState sig)) (task : TaskId) (s : CStore (core3 grow)) :
    Session grow sig (Ret (core3 grow)) :=
  match s.task? task with
  | none => internal "dangling arena id"
  | some record =>
    if record.state = .resolved then .pure .unit
    else .op .get (fun store => .op .hostGet (fun host => syncLiftCandidates task
      ((show CStore (core3 grow) from store).instCandidates (ready host) record.inst)))

private theorem sharedDestructorLoopReadCode (ready : HostReady (HostState sig)) (task : TaskId) :
    (syncLiftLoopBody ready task : Session grow sig (Ret (core3 grow))) = .op .get (sharedDestructorReadLoopTask ready task) := by
  simp [syncLiftLoopBody, getTask, getObj, getStore, hostGet, Prog.lift, perform, bind, Prog.bind]
  congr 1
  funext store
  change CStore (core3 grow) at store
  unfold sharedDestructorReadLoopTask CStore.task?
  cases found : ArenaField.tasks.get? store task with
  | none =>
    simp [internal, trap, Prog.bind]
    congr 1
    funext response
    cases response
  | some record => rfl

open ReturnFrame.Occurrence in
private theorem compareDestructorParentJournal {thread frame frames peerFrames rest peerRest}
    (leftTicket rightTicket : Nat)
    (stores : start.store = incoming.store)
    (framesPaired : List.Forall₂ (ReturnFrame.Related.Segment older) frames peerFrames)
    (restPaired : List.Forall₂ (ReturnFrame.Related.Active older) rest peerRest)
    (leftAt : start.ctl = (PayloadPrefix.Cursor.mk thread (frame :: frames) rest).control (scheduledReply leftTicket (.ok 0)))
    (rightAt : incoming.ctl = (PayloadPrefix.Cursor.mk thread (frame :: peerFrames) peerRest).control (scheduledReply rightTicket (.ok 0)))
    (run : Steps profile ready (specDispatch ready base) start labels finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, frame :: frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, frame :: peerFrames, peerRest⟩
  let first := completion leftTicket (.ok 0)
  let second := completion rightTicket (.ok 0)
  let left := { start with host := start.host.record first.1, ctl := check.control (.pure (.flat first.2)) }
  let right := { incoming with host := incoming.host.record second.1, ctl := canon.control (.pure (.flat second.2)) }
  have checkJournal : FramedQuietPath profile ready (specDispatch ready base) check start [id, id] left :=
    checkedCompletionPath first leftAt
  have canonJournal : FramedQuietPath profile ready (specDispatch ready (LiveDispatch.host bindings base)) canon incoming [id, id] right :=
    checkedCompletionPath second rightAt
  obtain ⟨used, trailing, reached, peer, split, paths, writers, residual, ending⟩ :=
    cutSharedQuietWorker checkJournal canonJournal run
  rw [split]
  rcases ending with empty | ⟨rfl, rfl⟩
  · subst trailing
    cases residual
    exact .comparedPrefix paths writers .exhausted
  · refine .destructorPrefix paths writers (fun scheduler => scheduler) ?_
    have complete {leftNext rightNext : Config (core3 grow) (HostState sig)}
        (checked : Step profile ready (specDispatch ready base) left .tau leftNext)
        (canonical : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) right .tau rightNext)
        (checkedHost : leftNext.host = left.host) (canonicalHost : rightNext.host = right.host)
        (checkEdit : transitionEdit left .tau = .pop) (canonEdit : transitionEdit right .tau = .pop)
        (restore : DestructorSchedulerAlignment older left right → HostFrame.Related.Paired older leftNext rightNext) :
        CallbackSliceEnd profile ready base bindings older left right trailing finish := by
      rcases splitSilent (count := 1) (.cons checked (.refl _)) residual with ⟨rest, popped, tail⟩ | short
      · rw [popped]
        have path := sharedSchedulerTransport (bindings := bindings) (edit := .pop) checked canonical checkEdit canonEdit
        have lostLeft : Trail profile ready (specDispatch ready base) left (some (.active 0 0)) [.tau] leftNext none :=
          .step checked (by rw [checkEdit]; exact .done _ _)
        have lostRight : Trail profile ready (specDispatch ready (LiveDispatch.host bindings base)) right
            (some (.active 0 0)) [.tau] rightNext none :=
          .step canonical (by rw [canonEdit]; exact .done _ _)
        exact .sharedDropParentPop path (frameCalloutStep path checkedHost canonicalHost) lostLeft lostRight restore tail
      · have noStep : trailing = [] := List.length_eq_zero_iff.mp (by omega)
        have stopped := stepsAtEmpty (noStep ▸ residual)
        exact noStep.symm ▸ stopped ▸ CallbackSliceEnd.exhausted
    cases frame with
    | prog resume =>
      exact complete
        (.popProg (th := thread) (r := .flat first.2) (k := resume) (segs := frames) (rest := rest) rfl)
        (.popProg (th := thread) (r := .flat second.2) (k := resume) (segs := peerFrames) (rest := peerRest) rfl) rfl rfl rfl rfl
        (fun scheduler => destructorSchedulerPair scheduler stores (.cons (.mk framesPaired) restPaired))
    | core core resume =>
      exact complete
        (.popCore (th := thread) (vs := first.2) (ct := core) (k := resume) (segs := frames) (rest := rest) rfl)
        (.popCore (th := thread) (vs := second.2) (ct := core) (k := resume) (segs := peerFrames) (rest := peerRest) rfl) rfl rfl rfl rfl (fun scheduler => by
          refine destructorSchedulerPair ?_ ?_ ?_
          · exact scheduler
          · exact stores
          change List.Forall₂ (ReturnFrame.Related.Active older)
            (⟨thread, .core ((core3 grow).resume start.store.core core (.values first.2)) resume, frames⟩ :: rest)
            (⟨thread, .core ((core3 grow).resume incoming.store.core core (.values second.2)) resume, peerFrames⟩ :: peerRest)
          rw [← stores]
          exact .cons (.mk framesPaired) restPaired)

open ReturnFrame.Occurrence in
private theorem compareDestructorParentLoop {thread frame frames peerFrames rest peerRest}
    (body : ThreadBody (core3 grow)) (leftTicket rightTicket : Nat)
    (resolved : sharedDestructorResolved body.task start.store) (stores : start.store = incoming.store)
    (framesPaired : List.Forall₂ (ReturnFrame.Related.Segment older) frames peerFrames)
    (restPaired : List.Forall₂ (ReturnFrame.Related.Active older) rest peerRest)
    (leftAt : start.ctl = (PayloadPrefix.Cursor.mk thread (frame :: frames) rest).control (sharedDestructorAfterResume body leftTicket))
    (rightAt : incoming.ctl = (PayloadPrefix.Cursor.mk thread (frame :: peerFrames) peerRest).control (sharedDestructorAfterResume body rightTicket))
    (run : Steps profile ready (specDispatch ready base) start labels finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  rw [sharedDestructorParentCode] at leftAt rightAt
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, frame :: frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, frame :: peerFrames, peerRest⟩
  let first := sharedDestructorParentReply (grow := grow) (sig := sig) leftTicket
  let second := sharedDestructorParentReply (grow := grow) (sig := sig) rightTicket
  let checking := { check with frames := .prog first :: check.frames }
  let canonical := { canon with frames := .prog second :: canon.frames }
  let call : Call (core3 grow) := .loop (.syncLiftLoop body.task)
  let left := { start with ctl := checking.control (syncLiftLoopBody ready body.task) }
  let right := { incoming with ctl := canonical.control (syncLiftLoopBody ready body.task) }
  have leftCall : Step profile ready (specDispatch ready base) start .tau left :=
    .call (th := check.thread) (c := call) (k := first) (segs := check.frames) (rest := check.rest) leftAt
  have rightCall : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau right :=
    .call (th := canon.thread) (c := call) (k := second) (segs := canon.frames) (rest := canon.rest) rightAt
  cases run with
  | refl => exact .exhausted
  | @cons _ _ _ _ suffix actual tail =>
    obtain ⟨rfl, rfl⟩ := silentStepUnique leftCall actual
    have leftEdit : transitionEdit start .tau = .push (.prog first) := by rw [transitionEdit, leftAt]; rfl
    have rightEdit : transitionEdit incoming .tau = .push (.prog second) := by rw [transitionEdit, rightAt]; rfl
    have installed := sharedPushTransport (bindings := bindings) leftCall rightCall leftEdit rightEdit
    refine .destructorPrefix installed (frameCalloutStep installed rfl rfl) (fun scheduler => scheduler) ?_
    let read := sharedDestructorReadLoopTask (grow := grow) ready body.task
    have leftReadAt : left.ctl = checking.control (.op .get read) := congrArg checking.control (sharedDestructorLoopReadCode ready body.task)
    have rightReadAt : right.ctl = canonical.control (.op .get read) := congrArg canonical.control (sharedDestructorLoopReadCode ready body.task)
    let readLeft := { left with ctl := checking.control (read left.store) }
    let readRight := { right with ctl := canonical.control (read left.store) }
    have leftRead : Step profile ready (specDispatch ready base) left .tau readLeft :=
      .get (th := checking.thread) (segs := checking.frames) (rest := checking.rest) (k := read) leftReadAt
    have rightRead : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) right .tau readRight := by
      have step := Step.get (prof := profile) (hr := ready) (dispatch := specDispatch ready (LiveDispatch.host bindings base))
        (th := canonical.thread) (segs := canonical.frames) (rest := canonical.rest) (k := read) rightReadAt
      rw [congrArg read stores.symm] at step
      exact step
    rcases splitSilent (count := 1) (.cons leftRead (.refl _)) tail with ⟨afterRead, used, residual⟩ | short
    · rw [used]
      have visited := sharedSchedulerTransport (bindings := bindings) (edit := .same) leftRead rightRead
        (by rw [transitionEdit, leftReadAt]; rfl) (by rw [transitionEdit, rightReadAt]; rfl)
      refine .destructorPrefix visited (frameCalloutStep visited rfl rfl) (fun scheduler => scheduler) ?_
      cases taskAt : left.store.task? body.task with
      | none =>
        have evaluates : read left.store = internal "dangling arena id" := by simp only [read, sharedDestructorReadLoopTask, taskAt]
        have checkedAt := congrArg checking.control evaluates
        have canonicalAt := congrArg canonical.control evaluates
        exact compareSharedDestructorTrap (.internal "dangling arena id") checkedAt canonicalAt residual
      | some tk =>
        have doneState : tk.state = .resolved := resolved tk taskAt
        have evaluates : read left.store = .pure .unit := by
          simp only [read, sharedDestructorReadLoopTask, taskAt, doneState, ite_true]
        have leftReplyAt : readLeft.ctl = checking.control (.pure .unit) := congrArg checking.control evaluates
        have rightReplyAt : readRight.ctl = canonical.control (.pure .unit) := congrArg canonical.control evaluates
        have leftPop := Step.popProg (prof := profile) (hr := ready) (dispatch := specDispatch ready base)
          (m := readLeft) (th := check.thread) (r := .unit) (k := first) (segs := check.frames) (rest := check.rest)
          (congrArg checking.control evaluates)
        have rightPop := Step.popProg (prof := profile) (hr := ready) (dispatch := specDispatch ready (LiveDispatch.host bindings base))
          (m := readRight) (th := canon.thread) (r := .unit) (k := second) (segs := canon.frames) (rest := canon.rest)
          (congrArg canonical.control evaluates)
        rcases splitSilent (count := 1) (.cons leftPop (.refl _)) residual with ⟨afterPop, popped, remainder⟩ | short
        · rw [popped]
          have pop := sharedSchedulerTransport (bindings := bindings) (edit := .pop) leftPop rightPop
            (by rw [transitionEdit, leftReplyAt]; rfl)
            (by rw [transitionEdit, rightReplyAt]; rfl)
          exact .destructorPrefix pop (frameCalloutStep pop rfl rfl) (fun scheduler => scheduler)
            (compareDestructorParentJournal leftTicket rightTicket stores framesPaired restPaired rfl rfl remainder)
        · have empty : afterRead = [] := List.length_eq_zero_iff.mp (by omega)
          have stopped := stepsAtEmpty (empty ▸ residual)
          exact empty.symm ▸ stopped ▸ CallbackSliceEnd.exhausted
    · have empty : suffix = [] := List.length_eq_zero_iff.mp (by omega)
      have stopped := stepsAtEmpty (empty ▸ tail)
      exact empty.symm ▸ stopped ▸ CallbackSliceEnd.exhausted

private theorem destructorParentCoordinates {body : ThreadBody (core3 grow)}
    {left right : List (Activation (core3 grow) (HostState sig))}
    (parents : DestructorParentChain older body left right) :
    ∃ thread frame frames peerFrames rest peerRest leftTicket rightTicket,
      List.Forall₂ (ReturnFrame.Related.Segment older) frames peerFrames ∧
      List.Forall₂ (ReturnFrame.Related.Active older) rest peerRest ∧
      left = (PayloadPrefix.Cursor.mk thread (frame :: frames) rest).control (sharedDestructorAfterResume body leftTicket) ∧
      right = (PayloadPrefix.Cursor.mk thread (frame :: peerFrames) peerRest).control
        (sharedDestructorAfterResume body rightTicket) := by
  cases parents with
  | paired frames rest _ => exact ⟨_, _, _, _, _, _, _, _, frames, rest, rfl, rfl⟩

open ReturnFrame.Occurrence in
private theorem enterDestructorParentLoop {body : ThreadBody (core3 grow)}
    (parents : DestructorParentChain older body start.ctl incoming.ctl)
    (stores : start.store = incoming.store)
    (run : Steps profile ready (specDispatch ready base) start labels finish) :
    CallbackSliceEnd profile ready base bindings older start incoming labels finish := by
  obtain ⟨thread, frame, frames, peerFrames, rest, peerRest, leftTicket, rightTicket,
    framesPaired, restPaired, leftAt, rightAt⟩ := destructorParentCoordinates parents
  rw [sharedDestructorParentCode] at leftAt rightAt
  let check : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, frame :: frames, rest⟩
  let canon : PayloadPrefix.Cursor (E := core3 grow) (HostState sig) := ⟨thread, frame :: peerFrames, peerRest⟩
  let first := sharedDestructorParentReply (grow := grow) (sig := sig) leftTicket
  let second := sharedDestructorParentReply (grow := grow) (sig := sig) rightTicket
  let program := syncLiftLoopBody (E := core3 grow) ready body.task
  let left := { start with ctl := { check with frames := .prog first :: check.frames }.control program }
  let right := { incoming with ctl := { canon with frames := .prog second :: canon.frames }.control program }
  have leftCall : Step profile ready (specDispatch ready base) start .tau left := .call leftAt
  have rightCall : Step profile ready (specDispatch ready (LiveDispatch.host bindings base)) incoming .tau right := .call rightAt
  cases run with
  | refl => exact .exhausted
  | cons actual tail =>
    obtain ⟨rfl, rfl⟩ := silentStepUnique leftCall actual
    have installed := sharedPushTransport (bindings := bindings) leftCall rightCall
      (by rw [transitionEdit, leftAt]; rfl) (by rw [transitionEdit, rightAt]; rfl)
    refine .sharedDropParentLoop (leftTicket := leftTicket) (rightTicket := rightTicket) (enclosing := frame)
      installed (frameCalloutStep installed rfl rfl) ⟨rfl, rfl, rfl, rfl⟩ ?_ tail
    intro scheduler
    let idle : Session grow sig (Ret (core3 grow)) := .pure .unit
    have aligned : HostFrame.Related.Paired older
        { start with ctl := check.control idle } { incoming with ctl := canon.control idle } :=
      destructorSchedulerPair scheduler stores (.cons (.mk (.cons (.same _) framesPaired)) restPaired)
    obtain ⟨otherFrames, otherRest, atPeer, expanded⟩ :=
      aligned.push (show ({ start with ctl := check.control idle }).ctl = _ from rfl) program first second
    change ⟨thread, .prog idle, frame :: peerFrames⟩ :: peerRest = _ at atPeer
    rw [List.cons.injEq, Activation.mk.injEq] at atPeer
    obtain ⟨⟨_, _, rfl⟩, rfl⟩ := atPeer
    refine ⟨expanded, ?_⟩
    have related := paired_outside (show ReturnFrame.Related.Paired older
      (HostFrame.replace { start with ctl := check.control idle } incoming.host) { incoming with ctl := canon.control idle }
      from aligned)
    exact outside_push (.prog first) (.prog second) related

private def sharedDestructorImportProgram (ready : HostReady (HostState sig)) (impl : HostImpl (core3 grow) (HostState sig))
    (store : CStore (core3 grow)) (thread : Option ThreadId) (host : CanonHost (core3 grow)) (args : List FlatValue) :
    Session grow sig (Ret (core3 grow)) :=
  match calloutEntry store thread host with
  | some reason => trap reason
  | none => calloutBody Limits.spec Quirks.none ready impl store thread host args

open ReturnFrame.Occurrence in
private theorem sharedDestructorImportReads (impl : HostImpl (core3 grow) (HostState sig))
    (cursor : PayloadPrefix.Cursor (E := core3 grow) (HostState sig)) (host : CanonHost (core3 grow)) (args : List FlatValue)
    (atImport : start.ctl = cursor.control (specDispatch ready impl (.hostCallout host args))) :
    FramedQuietPath profile ready (specDispatch ready impl) cursor start [id, id]
      { start with ctl := cursor.control (sharedDestructorImportProgram ready impl start.store cursor.thread host args) } := by
  cases cursor with
  | mk thread frames rest =>
    refine FramedQuietPath.step (.currentThread atImport) (by rw [transitionEdit, atImport]; rfl) rfl ?_
    exact FramedQuietPath.step (.get rfl) rfl rfl .done

