module

public import Silmaril.Semantics.Accept.MonoidRegex.Defs
public import Mathlib.Algebra.Group.Submonoid.Membership
public import Mathlib.Algebra.Group.Submonoid.BigOperators
public import Mathlib.Algebra.Group.Pointwise.Set.Basic

/-!
# Regular expressions over a monoid: proofs

Proofs for `Silmaril.Semantics.Accept.MonoidRegex.Thms`. Nothing imports this module except
that header.
-/

public section

namespace Silmaril.Proofs.Semantics.Accept.MonoidRegex

open Silmaril.Accept.MonoidRegex
open scoped Computability

universe u v w

variable {M : Type u} [Monoid M] {ι : Type v} {κ : Type w}

theorem one_mem_star (L : Set M) : (1 : M) ∈ star L := ⟨[], by simp, rfl⟩

theorem subset_star (L : Set M) : L ⊆ star L := fun x hx => ⟨[x], by simpa using hx, by simp⟩

theorem mul_mem_star {L : Set M} {x y : M} (hx : x ∈ star L) (hy : y ∈ star L) :
    x * y ∈ star L := by
  obtain ⟨l, hl, rfl⟩ := hx
  obtain ⟨k, hk, rfl⟩ := hy
  refine ⟨l ++ k, fun z hz => ?_, by simp⟩
  rcases List.mem_append.mp hz with h | h
  · exact hl z h
  · exact hk z h

/-- `star L` is the carrier of the submonoid generated by `L`. -/
theorem star_eq_closure (L : Set M) : star L = (Submonoid.closure L : Set M) := by
  ext x
  constructor
  · rintro ⟨l, hl, rfl⟩
    exact list_prod_mem (fun y hy => Submonoid.subset_closure (hl y hy))
  · intro hx
    induction hx using Submonoid.closure_induction with
    | mem y hy => exact subset_star L hy
    | one => exact one_mem_star L
    | mul y z _ _ hy hz => exact mul_mem_star hy hz

theorem star_mono {L K : Set M} (h : L ⊆ K) : star L ⊆ star K := by
  rintro x ⟨l, hl, rfl⟩
  exact ⟨l, fun y hy => h (hl y hy), rfl⟩

theorem prod_mono {L L' K K' : Set M} (hL : L ⊆ L') (hK : K ⊆ K') : prod L K ⊆ prod L' K' := by
  rintro x ⟨a, ha, b, hb, rfl⟩
  exact ⟨a, hL ha, b, hK hb, rfl⟩

theorem eval_mono {ρ σ : ι → Set M} (h : ∀ i, ρ i ⊆ σ i) (e : Expr ι M) :
    Expr.eval ρ e ⊆ Expr.eval σ e := by
  induction e with
  | zero | one | atom _ | cls _ => exact le_rfl
  | leaf i => exact h i
  | plus e f he hf => exact Set.union_subset_union he hf
  | comp e f he hf => exact prod_mono he hf
  | star e he => exact star_mono he

theorem eval_bind (ρ : κ → Set M) (σ : ι → Expr κ M) (e : Expr ι M) :
    Expr.eval ρ (Expr.bind σ e) = Expr.eval (fun i => Expr.eval ρ (σ i)) e := by
  induction e with
  | zero | one | atom _ | cls _ | leaf _ => rfl
  | plus e f he hf => simp only [Expr.bind, Expr.eval, he, hf]
  | comp e f he hf => simp only [Expr.bind, Expr.eval, he, hf]
  | star e he => simp only [Expr.bind, Expr.eval, he]

/-! ## The free monoid: the list semantics -/

variable {α : Type u}

theorem toList_inj {x y : FreeMonoid α} (h : FreeMonoid.toList x = FreeMonoid.toList y) :
    x = y := by
  rw [← FreeMonoid.ofList_toList x, h, FreeMonoid.ofList_toList]

theorem toList_preimage_prod (L K : Language α) :
    prod (FreeMonoid.toList ⁻¹' L) (FreeMonoid.toList ⁻¹' K) =
      FreeMonoid.toList ⁻¹' (L * K : Language α) := by
  ext x
  change (∃ a, FreeMonoid.toList a ∈ L ∧ ∃ b, FreeMonoid.toList b ∈ K ∧ a * b = x) ↔
    FreeMonoid.toList x ∈ L * K
  rw [Language.mem_mul]
  constructor
  · rintro ⟨a, ha, b, hb, rfl⟩
    exact ⟨_, ha, _, hb, (FreeMonoid.toList_mul a b).symm⟩
  · rintro ⟨a, ha, b, hb, hx⟩
    refine ⟨FreeMonoid.ofList a, ha, FreeMonoid.ofList b, hb, toList_inj ?_⟩
    rw [FreeMonoid.toList_mul, FreeMonoid.toList_ofList, FreeMonoid.toList_ofList, hx]

theorem toList_preimage_star (L : Language α) :
    Silmaril.Accept.MonoidRegex.star (FreeMonoid.toList ⁻¹' L) = FreeMonoid.toList ⁻¹' (L∗ : Language α) := by
  ext x
  change (∃ l : List (FreeMonoid α), (∀ y ∈ l, FreeMonoid.toList y ∈ L) ∧ l.prod = x) ↔
    FreeMonoid.toList x ∈ L∗
  rw [Language.mem_kstar]
  constructor
  · rintro ⟨l, hl, rfl⟩
    refine ⟨l.map FreeMonoid.toList, FreeMonoid.toList_prod l, ?_⟩
    intro y hy
    obtain ⟨z, hz, rfl⟩ := List.mem_map.mp hy
    exact hl z hz
  · rintro ⟨S, hx, hS⟩
    refine ⟨S.map FreeMonoid.ofList, ?_, toList_inj ?_⟩
    · intro y hy
      obtain ⟨z, hz, rfl⟩ := List.mem_map.mp hy
      exact hS z hz
    · rw [FreeMonoid.toList_prod, hx, List.map_map]
      congr 1
      exact (List.map_congr_left fun z _ => FreeMonoid.toList_ofList z).trans (List.map_id _)

theorem eval_ofRegex (ρ : ι → Language α) (e : Silmaril.Accept.Regex.Expr ι α) :
    Expr.eval (fun i => FreeMonoid.toList ⁻¹' ρ i) (Expr.ofRegex e) =
      FreeMonoid.toList ⁻¹' Silmaril.Accept.Regex.Expr.eval ρ e := by
  induction e with
  | zero =>
    ext x
    change x ∈ (∅ : Set (FreeMonoid α)) ↔ FreeMonoid.toList x ∈ (0 : Language α)
    exact iff_of_false (Set.notMem_empty x) (Language.notMem_zero _)
  | one =>
    ext x
    change x = 1 ↔ FreeMonoid.toList x ∈ (1 : Language α)
    rw [Language.mem_one]
    exact ⟨fun h => h ▸ FreeMonoid.toList_one, fun h => toList_inj h⟩
  | char a =>
    ext x
    change x = FreeMonoid.of a ↔ FreeMonoid.toList x = [a]
    exact ⟨fun h => h ▸ FreeMonoid.toList_of a, fun h => toList_inj h⟩
  | cls p =>
    ext x
    change Expr.oneLetter p x = true ↔ ∃ a, p a = true ∧ FreeMonoid.toList x = [a]
    unfold Expr.oneLetter
    constructor
    · intro h
      split at h
      · next a ha => exact ⟨a, h, ha⟩
      · exact absurd h Bool.false_ne_true
    · rintro ⟨a, ha, hx⟩
      rw [hx]; exact ha
  | leaf i => rfl
  | plus e f he hf =>
    change Expr.eval _ (Expr.ofRegex e) ∪ Expr.eval _ (Expr.ofRegex f) = _
    rw [he, hf]; rfl
  | comp e f he hf =>
    change Silmaril.Accept.MonoidRegex.prod (Expr.eval _ (Expr.ofRegex e)) (Expr.eval _ (Expr.ofRegex f)) = _
    rw [he, hf]
    exact toList_preimage_prod _ _
  | star e he =>
    change Silmaril.Accept.MonoidRegex.star (Expr.eval _ (Expr.ofRegex e)) = _
    rw [he]
    exact toList_preimage_star _

end Silmaril.Proofs.Semantics.Accept.MonoidRegex
