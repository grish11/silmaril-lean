module

public import Silmaril.Machine.MulticoreVM.Defs

/-! # Adjacent swaps of scheduler decisions -/

@[expose] public section

namespace Silmaril.Machine.MulticoreVM

open Silmaril.Semantics.ConcurrentTrace (ofWord)

universe u

variable {State Thread Choice Event : Type u}

/-- Each successful source run has a target run from the same initial state to the same
final state, with the same concurrent trace. The replay may choose different outcomes. -/
def ScheduleReplay (step : Transition State Thread Choice Event) (initial : State)
    (source target : Schedule Thread Choice) : Prop :=
  ∀ ⦃word final⦄, Scheduled step source initial word final →
    ∃ replay, Scheduled step target initial replay final ∧ ofWord word = ofWord replay

/-- Both orders of the two decisions replay all successful outcomes at this state. -/
def LocalDiamond (step : Transition State Thread Choice Event) (initial : State)
    (a b : Decision Thread Choice) : Prop :=
  ScheduleReplay step initial [a, b] [b, a] ∧ ScheduleReplay step initial [b, a] [a, b]

/-- The decision pairs generating the schedule congruence. The adapter supplies the policy
for allowing pairs, and the soundness theorem requires a local diamond for each allowed pair. -/
inductive DecisionSwap (allowed : Decision Thread Choice → Decision Thread Choice → Prop) :
    FreeMonoid (Decision Thread Choice) → FreeMonoid (Decision Thread Choice) → Prop where
  | pair {a b : Decision Thread Choice} : allowed a b → DecisionSwap allowed
      (.ofList [a, b]) (.ofList [b, a])

/-- The least concatenation congruence containing the allowed adjacent decision swaps. -/
def scheduleCongruence (allowed : Decision Thread Choice → Decision Thread Choice → Prop) :
    Con (FreeMonoid (Decision Thread Choice)) :=
  conGen (DecisionSwap allowed)

/-- Schedule equivalence generated by the allowed swaps under arbitrary list contexts. -/
def ScheduleEquivalent (allowed : Decision Thread Choice → Decision Thread Choice → Prop)
    (source target : Schedule Thread Choice) : Prop :=
  scheduleCongruence allowed (.ofList source) (.ofList target)

end Silmaril.Machine.MulticoreVM
