module

public import Silmaril.Games.DPull.Defs
import Silmaril.Proofs.Games.DPull.Laws

/-!
# Pulling strategies back along a move map: laws

* Membership: the plays, divergences and infinite plays of a pull are the preimages
  (`Strategy.mem_pull`, `DStrategy.mem_toStrategy_pull`, `DStrategy.mem_div_pull`,
  `DStrategy.mem_inf_pull`); the finite plays are the strategy generated by the preimage
  (`Strategy.pull_eq_generate`, `DStrategy.toStrategy_pull`), the form of `spull`.
* Functoriality: `PullData.id`, `PullData.comp`; `pull_id`, `pull_comp`.
* Monotonicity: `Strategy.pull_mono`, `DStrategy.pull_mono`.

Proofs are in `Silmaril.Proofs.Games.DPull.Laws`.
-/

public section

namespace Silmaril.Games

universe u

variable {E F E' F' E'' F'' : Sig.{u}}

/-! ## Compatibility data -/

/-- The identity is compatible with the legality automaton. -/
theorem PullData.id : PullData (E := E) (F := F) id id :=
  ⟨rfl, fun h => h, fun h => ⟨_, h⟩, fun h => ⟨_, h⟩⟩

/-- Compatible move maps compose. -/
theorem PullData.comp {g : Move E' F' → Move E'' F''} {pg : Pos E' F' → Pos E'' F''}
    {f : Move E F → Move E' F'} {pf : Pos E F → Pos E' F'}
    (hg : PullData g pg) (hf : PullData f pf) : PullData (g ∘ f) (pg ∘ pf) :=
  Silmaril.Proofs.Games.DPull.pullData_comp hg hf

/-! ## Strategies -/

namespace Strategy

variable {f : Move E F → Move E' F'} {pf : Pos E F → Pos E' F'}

/-- **The plays of a pull are the preimage.** -/
@[simp] theorem mem_pull {hf : PullData f pf} {σ : Strategy E' F'} {p : List (Move E F)} :
    p ∈ σ.pull f pf hf ↔ p.map f ∈ σ := Iff.rfl

/-- The pull is the strategy generated by the preimage. -/
theorem pull_eq_generate (hf : PullData f pf) (σ : Strategy E' F') :
    σ.pull f pf hf = generate {p | p.map f ∈ σ} :=
  Silmaril.Proofs.Games.DPull.pull_eq_generate hf σ

/-- Pulling back along the identity does nothing. -/
theorem pull_id (σ : Strategy E F) : σ.pull id id PullData.id = σ :=
  Silmaril.Proofs.Games.DPull.strategy_pull_id σ

/-- Pulling back along a composite is pulling back twice. -/
theorem pull_comp {g : Move E' F' → Move E'' F''} {pg : Pos E' F' → Pos E'' F''}
    (hg : PullData g pg) (hf : PullData f pf) (σ : Strategy E'' F'') :
    σ.pull (g ∘ f) (pg ∘ pf) (hg.comp hf) = (σ.pull g pg hg).pull f pf hf :=
  Silmaril.Proofs.Games.DPull.strategy_pull_comp hg hf _ σ

/-- Pulling back is monotone. -/
theorem pull_mono (hf : PullData f pf) {σ τ : Strategy E' F'} (h : σ ≤ τ) :
    σ.pull f pf hf ≤ τ.pull f pf hf := fun _ hp => h hp

end Strategy

/-! ## Divergence-observing strategies -/

namespace DStrategy

variable {f : Move E F → Move E' F'} {pf : Pos E F → Pos E' F'}

/-- **The finite plays of a pull** are the strategy generated by the preimage. -/
theorem toStrategy_pull (hf : PullData f pf) (σ : DStrategy E' F') :
    (σ.pull f pf hf).toStrategy = Strategy.generate {p | p.map f ∈ σ.toStrategy} :=
  Strategy.pull_eq_generate hf σ.toStrategy

/-- The finite plays of a pull are the pull of the finite plays. -/
@[simp] theorem forget_pull (hf : PullData f pf) (σ : DStrategy E' F') :
    (σ.pull f pf hf).forget = σ.forget.pull f pf hf := rfl

/-- **The finite plays of a pull are the preimage.** -/
@[simp] theorem mem_toStrategy_pull {hf : PullData f pf} {σ : DStrategy E' F'}
    {p : List (Move E F)} : p ∈ (σ.pull f pf hf).toStrategy ↔ p.map f ∈ σ.toStrategy :=
  Iff.rfl

/-- **The divergences of a pull are the preimage.** -/
@[simp] theorem mem_div_pull {hf : PullData f pf} {σ : DStrategy E' F'} {p : List (Move E F)} :
    p ∈ (σ.pull f pf hf).div ↔ p.map f ∈ σ.div := Iff.rfl

/-- **The infinite plays of a pull** are the infinite traces whose image is an infinite play. -/
@[simp] theorem mem_inf_pull {hf : PullData f pf} {σ : DStrategy E' F'}
    {J : Set (List (Move E F))} :
    J ∈ (σ.pull f pf hf).inf ↔ IsInfPlay J ∧ List.map f '' J ∈ σ.inf := Iff.rfl

/-- Pulling back along the identity does nothing. -/
theorem pull_id (σ : DStrategy E F) : σ.pull id id PullData.id = σ :=
  Silmaril.Proofs.Games.DPull.pull_id σ

/-- Pulling back along a composite is pulling back twice. -/
theorem pull_comp {g : Move E' F' → Move E'' F''} {pg : Pos E' F' → Pos E'' F''}
    (hg : PullData g pg) (hf : PullData f pf) (σ : DStrategy E'' F'') :
    σ.pull (g ∘ f) (pg ∘ pf) (hg.comp hf) = (σ.pull g pg hg).pull f pf hf :=
  Silmaril.Proofs.Games.DPull.pull_comp hg hf _ σ

/-- Pulling back is monotone. -/
theorem pull_mono (hf : PullData f pf) {σ τ : DStrategy E' F'} (h : σ ≤ τ) :
    σ.pull f pf hf ≤ τ.pull f pf hf :=
  ⟨Strategy.pull_mono hf h.1, fun _ hp => h.2.1 hp, fun _ hJ => ⟨hJ.1, h.2.2 hJ.2⟩⟩

end DStrategy

end Silmaril.Games
