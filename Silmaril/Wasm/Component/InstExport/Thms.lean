module

public import Silmaril.Wasm.Component.InstExport.Defs
public import Silmaril.Wasm.Component.InstEngine.Defs
import Silmaril.Proofs.Wasm.Component.InstExport.Basic

/-!
# The export phase of an instantiable strategy: theorems

All proved; proofs in `Silmaril.Proofs.Wasm.Component.InstExport.Basic`.

**Start-free semantics.**

* `exportPhase_instGuard_withReady`: the export phase of `instGuard (withReady τ)` is `τ`;
* `denX_toI`: for a start-free core semantics `C`, `c.denX C.toI = c.denU C`: the export phase
  of the instantiating denotation is the start-free denotation, for every component.

**Refinement.** `exportPhase_mono`, `instGuard_mono`; `denIR_mono_on` (refinement on the core
modules of `c` refines `c`); `denX_le_denU`: if every core module of `c` satisfies `P`, and on
`P` the core semantics `C` is bounded by a start-free `C'` ready at once, then the export phase
of `c` under `C` is bounded by `c.denU C'`.

**Engine instances** (`Param.engineStrategyI`):

* `engineStrategyI_le_withReady`: an instance without a start function is bounded by its
  start-free strategy, ready at once;
* `exportPhase_engineStrategyI_noStart`: its export phase is its start-free strategy;
* `exportPhase_engineStrategyI_start`: with a start function, the export phase is generated by
  the plays of `engineStrategy` from every store a start run returns at, over all import calls
  of the start function and all answers of the environment;
* `exportPhase_engineStrategyI_noInst`: without an instance the export phase never answers.

Not proved: the converse of `denX_le_denU` (that the IR's wiring only exercises its nodes along
the instantiation protocol, so that the guard could be pushed to the core modules).
-/

public section

namespace Silmaril.Wasm.Component

open Silmaril.Games Silmaril.Games.Inst
open Silmaril.Wasm.Component.Param Silmaril.Wasm.Component.Reference

variable {E F : Sig.{0}} {R : Type} {M : Type} [CoreModule M]

/-- **The export phase of a ready-at-once strategy under the protocol is the strategy.** -/
theorem exportPhase_instGuard_withReady (τ : Strategy E F) :
    exportPhase (instGuard (withReady (R := R) τ)) = τ :=
  Silmaril.Proofs.Wasm.Component.InstExport.exportPhase_withReady τ

theorem exportPhase_mono {σ σ' : Strategy E (F.withInst R)} (h : σ ≤ σ') :
    exportPhase σ ≤ exportPhase σ' :=
  Silmaril.Proofs.Wasm.Component.InstExport.exportPhase_mono h

theorem instGuard_mono {σ σ' : Strategy E (F.withInst R)} (h : σ ≤ σ') :
    instGuard σ ≤ instGuard σ' :=
  Silmaril.Proofs.Wasm.Component.InstExport.instGuard_mono h

/-- **For start-free core semantics, the export phase is `Comp.denU`.** -/
theorem denX_toI (C : CoreSem M) (c : Comp M) : c.denX C.toI = c.denU C :=
  Silmaril.Proofs.Wasm.Component.InstExport.denX_toI C c

/-- **Refinement on the core modules of a component refines the component.** -/
theorem denIR_mono_on {C C' : CoreSemI M} {P : M → Prop} (h : ∀ m, P m → C.sem m ≤ C'.sem m)
    {c : Comp M} (hc : c.AllCore P) : c.denIR C ≤ c.denIR C' :=
  Silmaril.Proofs.Wasm.Component.InstExport.denIR_mono_on h c hc

/-- **The export phase is bounded by a start-free denotation** when every core module is
bounded by the start-free one, ready at once. -/
theorem denX_le_denU {C : CoreSemI M} {C' : CoreSem M} {P : M → Prop}
    (h : ∀ m, P m → C.sem m ≤ C'.toI.sem m) {c : Comp M} (hc : c.AllCore P) :
    c.denX C ≤ c.denU C' :=
  Silmaril.Proofs.Wasm.Component.InstExport.denX_le_denU h hc

variable {En : Engine} {I : Option (IInstance En)} {imps exps : CoreIface}

/-- **An engine instance without a start function is bounded by its start-free strategy, ready
at once.** -/
theorem engineStrategyI_le_withReady {J : IInstance En} (hI : I = some J) (ha : J.start = none) :
    engineStrategyI En I imps exps ≤ withReady (engineStrategy En J.toE imps exps) :=
  Silmaril.Proofs.Wasm.Component.InstExport.engine_le_withReady hI ha

/-- **The export phase of an engine instance without a start function** is its start-free
strategy. -/
theorem exportPhase_engineStrategyI_noStart {J : IInstance En} (hI : I = some J)
    (ha : J.start = none) :
    exportPhase (engineStrategyI En I imps exps) = engineStrategy En J.toE imps exps :=
  Silmaril.Proofs.Wasm.Component.InstExport.exportPhase_engine_noStart hI ha

/-- **The export phase of an engine instance with a start function**: generated by the plays of
`engineStrategy` from every store a start run returns at. -/
theorem exportPhase_engineStrategyI_start {J : IInstance En} {a : En.FuncAddr} (hI : I = some J)
    (ha : J.start = some a) :
    exportPhase (engineStrategyI En I imps exps) = Strategy.generate {p | ∃ cs c' ys,
      StartRunI En imps (J.store, En.invoke a []) cs c' ∧
        En.status c'.1 c'.2 = .returned (.values ys) ∧
        p ∈ engineStrategy En ⟨c'.1, J.addrs⟩ imps exps} :=
  Silmaril.Proofs.Wasm.Component.InstExport.exportPhase_engine_start hI ha

/-- **Without an instance, the export phase never answers.** -/
theorem exportPhase_engineStrategyI_noInst (hI : I = none) :
    exportPhase (engineStrategyI En I imps exps) = ⊥ :=
  Silmaril.Proofs.Wasm.Component.InstExport.exportPhase_engine_noInst hI

end Silmaril.Wasm.Component
