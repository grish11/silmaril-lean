module

public import Silmaril.Wasm.Binary.Quote.Defs
public import Silmaril.Wasm.Perf.CoreDecode.Thms
public meta import Lean.Elab.Command

/-! An opt-in source theorem for explicit Wasm terms, including terms imported from other
modules. The kernel must verify the actual decoding equation; there is no native fallback. -/

public section

namespace Silmaril.Wasm.Binary.Quote

theorem source_agrees {bytes : ByteArray} {result : Option Wasm.Module}
    (checked : Perf.CoreDecode.decodeF bytes = result) : Core.decode? bytes = result :=
  Perf.CoreDecode.decodeF_eq ▸ checked

end Silmaril.Wasm.Binary.Quote

end

public meta section

namespace Silmaril.Wasm.Binary.Quote

open Lean Elab Command

/-- `wasm_prove_source theoremName : packedBytes => decodedModule` proves
`Core.decode? packedBytes.toByteArray = some decodedModule`. The arguments are constants;
they need not be generated by `wasm_module`. No file is read by this command. -/
elab "wasm_prove_source " name:ident " : " source:ident " => " contents:ident : command => do
  let ns ← getCurrNamespace
  liftCoreM do
    let source ← realizeGlobalConstNoOverloadWithInfo source
    let contents ← realizeGlobalConstNoOverloadWithInfo contents
    let bytes := mkApp (mkConst ``KBytes.toByteArray) (mkConst source)
    let type := mkApp (mkConst ``Option [0]) (mkConst ``Wasm.Module)
    let result := mkApp2 (mkConst ``Option.some [0]) (mkConst ``Wasm.Module) (mkConst contents)
    let goal := KBytes.Elab.eqExpr type (mkApp (mkConst ``Core.decode?) bytes) result
    let refl := mkApp2 (mkConst ``Eq.refl [1]) type result
    let proof := mkApp3 (mkConst ``source_agrees) bytes result refl
    KBytes.Elab.addThm (ns ++ name.getId) goal proof

end Silmaril.Wasm.Binary.Quote
