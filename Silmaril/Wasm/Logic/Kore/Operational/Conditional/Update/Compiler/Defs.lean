module

public import Silmaril.Wasm.Logic.Kore.Operational.Conditional.Update.Source.Thms
public import Silmaril.Wasm.Logic.Kore.Operational.Conditional.Update.Total.Thms

/-! An executable compiler for exactly two complementary checked counter rules.
The emitted layout, bodies and installation facts are computed from the source
rule list; they are not obligations supplied by a compilation client. -/
@[expose] public section
namespace Silmaril.Logic.Kore.Operational.Conditional.UpdateDraft.Compiler
open Silmaril.Wasm Silmaril.Wasm.Execution Silmaril.Wasm.Execution.Core
open Silmaril.Logic.Kore.Operational.Conditional.WasmBranch

/-- The certificate records actual code generation and its source installation.
Initialization of runtime locals remains a separate operational requirement. -/
structure Plan (target : LocalIdx) (tailCode : List String → List Admin) where
  layout : Layout
  zeroLiteral : Int
  nonzeroLiteral : Int
  zeroBody : layout.zeroBody = BodyDraft.assignBody target (BitVec.ofInt 32 zeroLiteral)
  nonzeroBody : layout.nonzeroBody = BodyDraft.assignBody target (BitVec.ofInt 32 nonzeroLiteral)
  blockType : layout.blockType = .empty
  tail : layout.tailCode = tailCode
  zeroRange : -(2^31) ≤ zeroLiteral ∧ zeroLiteral < 2^31
  nonzeroRange : -(2^31) ≤ nonzeroLiteral ∧ nonzeroLiteral < 2^31

/-- Installation is checked against the entire actual axiom list after code
selection. Its proof is generated by the compiler, never supplied by a caller. -/
structure Compiled (p : CheckedProgram) (target : LocalIdx)
    (tailCode : List String → List Admin) extends Plan target tailCode where
  installed : p.axioms = Native.rules layout zeroLiteral nonzeroLiteral

/-- Source order is zero then nonzero. Extra axioms, wrong targets, incompatible
entry names, coincident states and out-of-range literals are rejected. Claims
are never inserted into the axiom list. No execution or semantic premise occurs. -/
def plan (rules : List Rule) (target : LocalIdx)
    (tailCode : List String → List Admin) : Option (Plan target tailCode) :=
  match rules with
  | [⟨entry, zero, .zero, .counter, z⟩, ⟨entry', nonzero, .nonzero, .counter, n⟩] =>
    if entry' = entry then
      if ez : entry ≠ zero then
        if en : entry ≠ nonzero then
          if zn : zero ≠ nonzero then
            if zr : -(2^31) ≤ z ∧ z < 2^31 then
              if nr : -(2^31) ≤ n ∧ n < 2^31 then
                some {
                  layout := ⟨entry, zero, nonzero, ez, en, zn, .empty,
                    BodyDraft.assignBody target (BitVec.ofInt 32 z),
                    BodyDraft.assignBody target (BitVec.ofInt 32 n), tailCode⟩
                  zeroLiteral := z
                  nonzeroLiteral := n
                  zeroBody := rfl
                  nonzeroBody := rfl
                  blockType := rfl
                  tail := rfl
                  zeroRange := zr
                  nonzeroRange := nr }
              else none
            else none
          else none
        else none
      else none
    else none
  | _ => none

/-- Reuse the same layout and instruction generator for a selected source cell.
The original target check precedes normalization; installation is still checked
against the unmodified source rules by the chosen compiler. -/
def planFor (cell : Target) (rules : List Rule) (target : LocalIdx)
    (tailCode : List String → List Admin) : Option (Plan target tailCode) :=
  if rules.all (fun r => decide (r.target = cell)) then
    plan (rules.map fun r => { r with target := .counter }) target tailCode
  else none

/-- An installation check ties the generated code to every source axiom.
The nondependent plan computation avoids transporting code through source-list
proofs; proof data are attached only after the ordinary executable traversal. -/
def compile (p : CheckedProgram) (target : LocalIdx)
    (tailCode : List String → List Admin) : Option (Compiled p target tailCode) := do
  let result ← plan p.axioms target tailCode
  if installed : p.axioms = Native.rules result.layout result.zeroLiteral result.nonzeroLiteral then
    some { result with installed := installed }
  else none

/-- Complete source-to-code operation retains the exact accepted source program. -/
def compileText (input : String) (target : LocalIdx)
    (tailCode : List String → List Admin) :
    Option ((p : CheckedProgram) × Compiled p target tailCode) := do
  let p ← check input
  let c ← compile p target tailCode
  pure ⟨p, c⟩

end Silmaril.Logic.Kore.Operational.Conditional.UpdateDraft.Compiler
