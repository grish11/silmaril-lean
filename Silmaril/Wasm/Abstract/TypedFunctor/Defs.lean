module

public import Silmaril.Wasm.Abstract.ExposePTyped.Defs
public import Silmaril.Wasm.Abstract.FunctorP.Defs
public import Silmaril.Semantics.IterOpsGen.Defs

/-!
# The typed premonoidal Elgot functor of the exact F5 denotation (definitions)

The exact denotation `ExposePStruct.denL : List BExpr → PHom H Cfg ResP` of the canonical F5
semantics is a Kleisli arrow of `M (CallSig H) H` whose result `ResP` mixes the fallthrough with
the other exits. This topic presents it as a Kleisli arrow of an **exit monad**, and bundles the
typed code as a sub-structure of the generic premonoidal Elgot structure
`IterOps.kleisliOps` (#216) of that monad. No new category is introduced: the codomain is the
sub-structure of `kleisliOps (PX H)` generated by the images of typed code
(`IterOps.genOps`), lawful by transfer.

**The exit monad.** `XOut` is a non-fallthrough body result: a branch, a return, a `.flow .trap`
result, a thrown exception or a pending tail call. `Exit` is a frame with an `XOut`, and
`PX H X = ExceptT Exit (M (CallSig H) H) X`: a body that either falls through with an `X` or
leaves by an exit. `enc`/`dec` are the two directions of the equivalence `ResP ≃ Except Exit Cfg`
(`TypedFunctor.Thms.resEquiv`).

**The concrete map.** `toK g` reads a body `g : PHom H Cfg ResP` as an arrow `Cfg → PX H Cfg`
(a fallthrough is the value, every other result an exit); `ofK` is its inverse. `denK es` is
`toK (denL es)`; `denL es = ofK (denK es)`.

* `stepK F` reads an iteration body `F : Cfg → M (ResP ⊕ Cfg)` (`inl` leaves, `inr` loops) as an
  iteration body `Cfg → PX H (Cfg ⊕ Cfg)` (a leaving fallthrough `inl`, a continue `inr`, every
  other result an exit). `loopK bt body` is the step of `loop bt body` (`br 0` continues).
* `testK`: the boolean test of an `if`: pop an `i32`, choose `inl` (nonzero) or `inr` (zero);
  no `i32` on top is `stuck`.
* `rwhiskK k`: `k` run on the configuration of a pair, the other component passive.
* `trimX`, `trimK`: read a branch at its label's arity and a return at the result arity
  (`ExposePStruct.trimP` on exits); `appK` appends a passive stack below a configuration's
  stack (`ExposePStruct.wcfg`).

**The generated sub-structure.** `TGen Γ`, the generators: the denotations `denK es` of typed
code (`ExposePTyped.TMor Γ I J ft es`, any interfaces and either end), the loop step `loopK` of
a typed `loop`, the pieces of a typed `if` (its condition, its two arms as blocks) and the
boolean test. `kOps H = kleisliOps (PX H)`, `TOps Γ = genOps (kOps H) (TGen Γ)`, and
`TArr Γ A B` its homs.

**The typed domain.** `TObj Γ`: the typed interfaces whose stack types are valid
(`TIface.Ok`, which `thom_id` needs); `THomE Γ I J` the typed morphisms `I ⟶ J`; `OpRel` the open
interaction equivalence `FunctorP.OpEquivP` on them, the kernel of `denL`
(`TypedFunctor.Thms.opEquivP_iff_eq`).
-/

@[expose] public section

namespace Silmaril.Wasm.Abstract.TypedFunctor

open Silmaril.Wasm Silmaril.Wasm.Binaryen Silmaril.Wasm.Execution.Core
open Silmaril.Wasm.Abstract.StoreBody Silmaril.Wasm.Abstract.StoreCall
open Silmaril.Wasm.Abstract.ExposeP Silmaril.Wasm.Abstract.ExposePStruct
open Silmaril.Wasm.Abstract.ExposePTyped
open Silmaril.Wasm.Abstract.CallXP (POut)

variable {H : Type}

/-! ## The exit monad -/

/-- A non-fallthrough body result. -/
inductive XOut where
  /-- A branch to the label `n` with the stack `vs`. -/
  | brk (n : Nat) (vs : List Val)
  /-- A return with the stack `vs`. -/
  | ret (vs : List Val)
  /-- A trap as a flow result. -/
  | trap
  /-- A thrown exception at the address `a`. -/
  | throw (a : Nat)
  /-- A pending tail call (`POut.tail`). -/
  | tail (a : Nat) (args : List Val) (n : Nat)

/-- The body result of an exit. -/
def XOut.toPOut : XOut → POut
  | .brk n vs => .flow (.brk n vs)
  | .ret vs => .flow (.ret vs)
  | .trap => .flow .trap
  | .throw a => .flow (.throw a)
  | .tail a args n => .tail a args n

/-- An exit: a frame and a non-fallthrough result. -/
abbrev Exit : Type 1 := ULift.{1} (Frame × XOut)

/-- **The exit monad**: fall through with a value, or leave by an exit. -/
abbrev PX (H : Type) : Type 1 → Type 1 := ExceptT Exit (M (CallSig H) H)

/-- A body result as a fallthrough configuration or an exit. -/
def enc : ResP → Except Exit Cfg
  | ⟨(f, .flow (.normal vs))⟩ => .ok ⟨(f, vs)⟩
  | ⟨(f, .flow (.brk n vs))⟩ => .error ⟨(f, .brk n vs)⟩
  | ⟨(f, .flow (.ret vs))⟩ => .error ⟨(f, .ret vs)⟩
  | ⟨(f, .flow .trap)⟩ => .error ⟨(f, .trap)⟩
  | ⟨(f, .flow (.throw a))⟩ => .error ⟨(f, .throw a)⟩
  | ⟨(f, .tail a args n)⟩ => .error ⟨(f, .tail a args n)⟩

/-- A fallthrough configuration or an exit as a body result. -/
def dec : Except Exit Cfg → ResP
  | .ok c => ⟨(c.down.1, .flow (.normal c.down.2))⟩
  | .error x => ⟨(x.down.1, x.down.2.toPOut)⟩

/-! ## The concrete map -/

/-- A body read in the exit monad. -/
noncomputable def toK (g : PHom H Cfg ResP) : Cfg → PX H Cfg := fun c => ExceptT.mk (enc <$> g c)

/-- An arrow of the exit monad read as a body. -/
noncomputable def ofK (k : Cfg → PX H Cfg) : PHom H Cfg ResP := fun c => dec <$> (k c).run

/-- **The denotation in the exit monad.** -/
noncomputable def denK (es : List BExpr) : Cfg → PX H Cfg := toK (denL es)

/-- An iteration result in the exit monad. -/
def encStep : ResP ⊕ Cfg → Except Exit (Cfg ⊕ Cfg)
  | .inl r =>
    match enc r with
    | .ok c => .ok (.inl c)
    | .error x => .error x
  | .inr c => .ok (.inr c)

/-- An iteration body read in the exit monad. -/
noncomputable def stepK (F : Cfg → M (CallSig H) H (ResP ⊕ Cfg)) : Cfg → PX H (Cfg ⊕ Cfg) :=
  fun c => ExceptT.mk (encStep <$> F c)

/-- The step of `loop bt body` in the exit monad: `br 0` continues (`inr`). -/
noncomputable def loopK (bt : BlockType) (body : List BExpr) : Cfg → PX H (Cfg ⊕ Cfg) :=
  stepK (loopStepP bt (denL body))

/-- The boolean test of an `if`: pop an `i32` and choose `inl` when it is nonzero, `inr` when
it is zero. -/
noncomputable def testK : Cfg → PX H (Cfg ⊕ Cfg)
  | ⟨(f, cv :: stk)⟩ =>
    match truthy cv with
    | some b => pure (if b then .inl ⟨(f, stk)⟩ else .inr ⟨(f, stk)⟩)
    | none => ExceptT.mk stuck
  | ⟨(_, [])⟩ => ExceptT.mk stuck

/-! ## The stack tensor in the exit monad -/

/-- Read a branch at its label's arity and a return at the result arity (`trimP`). -/
def trimX (labels : List Nat) (ret : Nat) : Exit → Exit
  | ⟨(f, .brk l vs)⟩ =>
    ⟨(f, .brk l (match labels[l]? with
      | some n => vs.take n
      | none => vs))⟩
  | ⟨(f, .ret vs)⟩ => ⟨(f, .ret (vs.take ret))⟩
  | x => x

/-- A computation of the exit monad, its exits read through `trimX`. -/
noncomputable def trimK {X : Type 1} (labels : List Nat) (ret : Nat) (x : PX H X) : PX H X :=
  ExceptT.mk (Except.mapError (trimX labels ret) <$> x.run)

/-- Run `k` on the configuration component, the other component passive (`k ⋊ A`). -/
noncomputable def rwhiskK {A : Type 1} (k : Cfg → PX H Cfg) : Cfg × A → PX H (Cfg × A) :=
  fun p => (fun c => (c, p.2)) <$> k p.1

/-- Append the passive stack below a configuration's stack. -/
def appK (p : ULift.{1} (List Val) × Cfg) : Cfg := wcfg p.1.down p.2

/-! ## The generated sub-structure -/

/-- The Kleisli operations of the exit monad (`IterOps.kleisliOps`). -/
noncomputable abbrev kOps (H : Type) : IterOps.Ops (fun A B : Type 1 => A → PX H B) :=
  IterOps.kleisliOps (PX H)

/-- **The generators**: typed code, the step of a typed loop, the pieces of a typed `if`, and
the boolean test. -/
inductive TGen (Γ : Ctx H) : {A B : Type 1} → (A → PX H B) → Prop
  /-- The denotation of typed code. -/
  | code {I J : TIface} {ft : Bool} {es : List BExpr} : TMor Γ I J ft es → TGen Γ (denK es)
  /-- The step of a typed loop. -/
  | step {I J : TIface} {ft : Bool} {bt : BlockType} {body : List BExpr} :
      TMor Γ I J ft [.loop bt body] → TGen Γ (loopK bt body)
  /-- The condition of a typed `if`. -/
  | ifCond {I J : TIface} {ft : Bool} {bt : BlockType} {c t el : List BExpr} :
      TMor Γ I J ft [.if_ bt c t el] → TGen Γ (denK c)
  /-- The `then` arm of a typed `if`, as a block. -/
  | ifThen {I J : TIface} {ft : Bool} {bt : BlockType} {c t el : List BExpr} :
      TMor Γ I J ft [.if_ bt c t el] → TGen Γ (denK [.block bt t])
  /-- The `else` arm of a typed `if`, as a block. -/
  | ifElse {I J : TIface} {ft : Bool} {bt : BlockType} {c t el : List BExpr} :
      TMor Γ I J ft [.if_ bt c t el] → TGen Γ (denK [.block bt el])
  /-- The boolean test. -/
  | test : TGen Γ testK

/-- **The generated sub-structure** of `kleisliOps (PX H)`. -/
noncomputable abbrev TOps (Γ : Ctx H) : IterOps.Ops (IterOps.GHom (kOps H) (TGen Γ)) :=
  IterOps.genOps (kOps H) (TGen Γ)

/-- Its homs. -/
abbrev TArr (Γ : Ctx H) (A B : Type 1) : Type 1 := IterOps.GHom (kOps H) (TGen Γ) A B

/-- The denotation of typed code, as a hom of the generated sub-structure. -/
noncomputable def denKT {Γ : Ctx H} {I J : TIface} {ft : Bool} {es : List BExpr}
    (h : TMor Γ I J ft es) : TArr Γ Cfg Cfg :=
  IterOps.GHom.ofGen (TGen.code h)

/-! ## The typed domain -/

/-- The objects: typed interfaces with valid stack types. -/
def TObj (_Γ : Ctx H) : Type := {I : TIface // I.Ok}

/-- The typed morphisms `I ⟶ J`. -/
abbrev THomE (Γ : Ctx H) (I J : TIface) : Type := {es : List BExpr // THom Γ I J es}

/-- The open interaction equivalence on typed morphisms. -/
def OpRel (Γ : Ctx H) (I J : TIface) (m m' : THomE Γ I J) : Prop :=
  FunctorP.OpEquivP H m.1 m'.1

end Silmaril.Wasm.Abstract.TypedFunctor
