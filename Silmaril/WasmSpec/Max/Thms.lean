public import Silmaril.Proofs.WasmSpec.Max.Script
public import Silmaril.Proofs.WasmSpec.Max.Smt

/-!
# Wasm specification library: `Max` v1, results

Solutions of `Spec` (see `manifest.toml`):

* `tactic`: `Silmaril.WasmSpec.Max.spec_tactic` (`Silmaril.Proofs.WasmSpec.Max.Tactic`);
* `tactic+script`: `Silmaril.WasmSpec.Max.Script.spec_script`, generated by
  `tools/wasm-vc gen` (`Silmaril.Proofs.WasmSpec.Max.Script`).
* `tactic+smt`: `Silmaril.WasmSpec.Max.spec_smt` (`Silmaril.Proofs.WasmSpec.Max.Smt`), never canonical.

Canonical results: `Silmaril.WasmSpec.Max.spec : Spec`;
`Silmaril.WasmSpec.Max.smax_comm`: the specified result is symmetric.
-/

@[expose] public section

namespace Silmaril.WasmSpec.Max

/-- The canonical solution: the kernel-checked `tactic` one. -/
theorem spec : Spec := spec_tactic

/-- The signed maximum is symmetric. -/
theorem smax_comm (x y : BitVec 32) : smax x y = smax y x := by
  have modular (v : BitVec 32) : v.toInt % 4294967296 = (v.toNat : Int) := by
    rw [BitVec.toInt_eq_toNat_cond]
    split
    · exact Int.emod_eq_of_lt (Int.natCast_nonneg _) (Int.ofNat_lt.mpr v.isLt)
    · rw [Int.sub_emod, show ((2 ^ 32 : Nat) : Int) = 4294967296 from rfl,
        Int.emod_self, Int.sub_zero, Int.emod_emod]
      exact Int.emod_eq_of_lt (Int.natCast_nonneg _) (Int.ofNat_lt.mpr v.isLt)
  unfold smax
  rcases Int.lt_trichotomy x.toInt y.toInt with h | h | h
  · have h₁ : y.slt x = false := by
      rw [BitVec.slt, decide_eq_false_iff_not]
      exact Int.lt_asymm h
    have h₂ : x.slt y = true := by simpa [BitVec.slt_iff_toInt_lt] using h
    rw [h₁, h₂]
    rfl
  · have he : x = y := by
      apply BitVec.eq_of_toNat_eq
      apply Int.ofNat_inj.mp
      rw [← modular x, ← modular y, h]
    rw [he]
  · have h₁ : y.slt x = true := by simpa [BitVec.slt_iff_toInt_lt] using h
    have h₂ : x.slt y = false := by
      rw [BitVec.slt, decide_eq_false_iff_not]
      exact Int.lt_asymm h
    rw [h₁, h₂]
    rfl

end Silmaril.WasmSpec.Max

