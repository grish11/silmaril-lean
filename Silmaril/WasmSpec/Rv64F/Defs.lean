/-- The function `$f` (the module's first function). -/
def func : Func := program.funcs[0]

/-- The little-endian doubleword at byte `a` (`0` out of bounds). -/
def dw (B : ByteArray) (a : Nat) : BitVec 64 := (Memory.load B a 8).getD 0

/-- Triangular numbers modulo 2^64. -/
def triBV (x : BitVec 64) : BitVec 64 := BitVec.ofNat 64 (x.toNat * (x.toNat + 1) / 2)

/-- `n` doublewords from `p`. -/
def dws (B : ByteArray) (p n : Nat) : List (BitVec 64) := (List.range n).map fun i => dw B (p + 8 * i)

set_option linter.unusedVariables false in
/-- The precondition on the entry values of the parameters. -/
def Pre (B : ByteArray) (a0 a1 ra sp s0 s1 : BitVec 64) : Prop :=
  sp.toNat % 16 = 0 ∧ 32 ≤ sp.toNat ∧ sp.toNat ≤ 2 ^ 26 ∧ 2 ^ 26 ≤ B.size ∧ a0.toNat < 2 ^ 32

set_option linter.unusedVariables false in
/-- The postcondition on entry values and results. -/
def Post (B B' : ByteArray) (a0 a1 ra sp s0 s1 : BitVec 64) (r_a0 : BitVec 64) : Prop :=
  r_a0 = triBV a0 + a1 * a1 ∧ SameOutside B B' (sp.toNat - 32) 32

/-- **Call-level specification** of the function at address `a`, for memory `ma` of `m`. -/
def CallSpec {H : Type} (P : Profile) (host : HostSemantics H) (Inv : Store H → Prop)
