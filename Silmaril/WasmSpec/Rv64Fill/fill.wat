;; Wasm problem: RV64 function `fill` @ 0x11350 (7 instructions) of memcall, plan wasm-sim/rv64/memcall
;; Generated by tools/wasm-sim (rv64 reduce, P-locals). Registers are i64 locals (ABI names);
;; each instruction is its simulator method body (examples/wasm-sim/rv64/parts) specialised
;; to constant registers and pc; memory is `env.memory`, at least 1024 pages (RV address = Wasm address).
;; Params are entry values in @requires/@ensures; `result` is a0, `(result r)` another result.
;; @define (define-fun arr ((p (_ BitVec 64)) (n (_ BitVec 64))) Bool (and (bvule n #x0000000000000400) (= ((_ extract 2 0) p) #b000) (bvule p #x0000000004000000) (bvule (bvadd p (bvmul n #x0000000000000008)) #x0000000004000000)))
;; @define (define-fun stack ((sp (_ BitVec 64))) Bool (and (= ((_ extract 3 0) sp) #x0) (bvuge sp #x0000000000000020) (bvule sp #x0000000004000000)))
;; @define (declare-fun sumarr ((_ BitVec 64) (_ BitVec 64)) (_ BitVec 64))
;; @define (declare-fun sumsq ((_ BitVec 64) (_ BitVec 64)) (_ BitVec 64))
;; @define (define-fun tri ((x (_ BitVec 64))) (_ BitVec 64) ((_ extract 63 0) (bvudiv (bvmul ((_ zero_extend 64) x) (bvadd ((_ zero_extend 64) x) #x00000000000000000000000000000001)) #x00000000000000000000000000000002)))
(module
  (import "env" "memory" (memory 1024))
  ;; @requires (arr a0 a1)
  ;; @ensures (forall ((i (_ BitVec 64))) (=> (bvult i a1) (= (mem64 (bvadd a0 (bvmul i #x0000000000000008))) a2)))
  ;; @writes a0 (bvmul a1 #x0000000000000008)
  (func $fill (export "fill") (param $a0 i64) (param $a1 i64) (param $a2 i64) (result i64)
    (block $B3
      ;; 0x11350: 00b05c63 bge
      (if (i64.ge_s (i64.const 0) (local.get $a1))
        (then
          (br $B3)
        )
        (else
          ;; 0x11354: 00359593 slli
          (local.set $a1 (i64.shl (local.get $a1) (i64.const 3)))
          ;; 0x11358: 00b505b3 add
          (local.set $a1 (i64.add (local.get $a0) (local.get $a1)))
          (loop $L2
            ;; cut at +12 (0x1135c)
            ;; @invariant TODO
            ;; 0x1135c: 00c53023 sd
            (i64.store (call $ea (i64.add (local.get $a0) (i64.const 0)) (i64.const 8)) (local.get $a2))
            ;; 0x11360: 00850513 addi
            (local.set $a0 (i64.add (local.get $a0) (i64.const 8)))
            ;; 0x11364: feb51ce3 bne
            (if (i64.ne (local.get $a0) (local.get $a1))
              (then
                (br $L2)
              )
              (else
                (br $B3)
              ))
          )
        ))
    )
    ;; 0x11368: 00008067 jalr
    (return (local.get $a0))
    (unreachable))
  ;; effective address check of the `mem` group methods: misaligned -> fault (Ext.Instr.exec),
  ;; outside the memory -> fault (the environment's `mem.*` import traps)
  (func $ea (param $a i64) (param $w i64) (result i32)
    (if (i32.wrap_i64 (i64.and (local.get $a) (i64.sub (local.get $w) (i64.const 1)))) (then (unreachable)))
    (if (i64.gt_u (local.get $a) (i64.sub (i64.shl (i64.extend_i32_u (memory.size)) (i64.const 16)) (local.get $w)))
      (then (unreachable)))
    (i32.wrap_i64 (local.get $a)))
)
