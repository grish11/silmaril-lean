module

public import Silmaril.WasmSpec.Common.Thms
public import Silmaril.Proofs.WasmSpec.Adder.Tactic
public import Silmaril.Proofs.WasmSpec.Adder.Script

/-!
# Wasm specification library: `Adder` v1, results

Solutions of `Spec` by mode (see `manifest.toml`):

* `tactic`: `Silmaril.WasmSpec.Adder.spec_tactic` (`Silmaril.Proofs.WasmSpec.Adder.Tactic`);
* `tactic+script`: `Silmaril.WasmSpec.Adder.Script.spec_script`, generated by
  `tools/wasm-vc gen` (`Silmaril.Proofs.WasmSpec.Adder.Script`).

The canonical results other entries use:

* `Silmaril.WasmSpec.Adder.spec : Spec`, from the `tactic` solution;
* `Silmaril.WasmSpec.Adder.callSpec`: the call-level `CallSpec` for a function
  instance running `$add` with a type of arity `2 → 1`;
* `Silmaril.WasmSpec.Adder.res_comm`: the results are symmetric in the arguments.

The `#print axioms` audits below are checked at build time (`#guard_msgs`);
`scripts/check-wasm-spec.py` (`make check`) compares them with the manifest's `axioms` fields.
-/

@[expose] public section

namespace Silmaril.WasmSpec.Adder

open Silmaril.Wasm Silmaril.Wasm.Execution.Core Silmaril.Wasm.Numerics Silmaril.Wasm.Validation
  Silmaril.Wasm.Logic.Core

/-- The canonical solution: the kernel-checked `tactic` one. -/
theorem spec : Spec := spec_tactic

/-- **Call-level specification** of a function instance running `$add`. -/
theorem callSpec {H : Type} {P : Profile} {host : HostSemantics H} {a : Nat} {fi : FuncInst H}
    {Inv : Store H → Prop} {ps rs : Ty (.list .val)}
    (hfi : ∀ s, Inv s → s.funcs[a]? = some fi) (hcode : fi.code = .wasm addFunc)
    (he : Expand fi.type (.func ps rs)) (hps : ps.length = 2) (hrs : rs.length = 1) :
    CallSpec P host a Inv :=
  Computes.funcSpec (fun xy => spec xy.1 xy.2) hfi hcode he
    (fun _ => by simp [args, hps]) (fun _ => by simp [res, hrs])

/-- The specified results are symmetric in the arguments. -/
theorem res_comm (x y : BitVec 32) : res (x, y) = res (y, x) := by
  simp [res, BitVec.add_comm]

end Silmaril.WasmSpec.Adder

/-- info: 'Silmaril.WasmSpec.Adder.spec_tactic' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in
#print axioms Silmaril.WasmSpec.Adder.spec_tactic

/-- info: 'Silmaril.WasmSpec.Adder.callSpec' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in
#print axioms Silmaril.WasmSpec.Adder.callSpec

/-- info: 'Silmaril.WasmSpec.Adder.spec' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in
#print axioms Silmaril.WasmSpec.Adder.spec

/-- info: 'Silmaril.WasmSpec.Adder.Script.spec_script' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in
#print axioms Silmaril.WasmSpec.Adder.Script.spec_script
