module

public import Silmaril.Calculi.PERConstraints.Congruence.Defs
public import Silmaril.Formats.PER.Congruence.Thms

/-! Bounds on a PER in the relation-inclusion order, with optional restrictions
on its completions. The existing constraint language supplies the queries. -/

@[expose] public section
namespace Silmaril.Calculi.PERConstraints

open CategoryTheory Silmaril.Formats

variable {α β : Type}

/-- An interval of PERs on one carrier. Its endpoints are themselves PERs. -/
structure Bounds (α : Type) where
  lower : PER α
  upper : PER α
  ordered : lower ≤ upper

namespace Bounds

/-- Ordinary PER models embed as singleton intervals. -/
def exact (model : PER α) : Bounds α := ⟨model, model, le_rfl⟩

/-- Admissibility can express closure under guarded constructors or satisfaction
of a background theory. Even with ordered endpoints this set can be empty. -/
def completions (bounds : Bounds α) (admissible : PER α → Prop) : Set (PER α) :=
  Set.Icc bounds.lower bounds.upper ∩ {model | admissible model}

def Certain (bounds : Bounds α) (admissible query : PER α → Prop) : Prop :=
  ∀ model ∈ bounds.completions admissible, query model

def Possible (bounds : Bounds α) (admissible query : PER α → Prop) : Prop :=
  ∃ model ∈ bounds.completions admissible, query model

/-- More information raises the lower bound and lowers the upper bound. -/
def Refines (more less : Bounds α) : Prop := less.lower ≤ more.lower ∧ more.upper ≤ less.upper

/-- Pull both endpoints back along the same term function. -/
def pull (bounds : Bounds β) (rename : α → β) : Bounds α :=
  ⟨bounds.lower.pull rename, bounds.upper.pull rename, fun _ _ h => bounds.ordered h⟩

def reduct {source target : Syntax} (rename : source ⟶ target) (bounds : Bounds target.Term) :
    Bounds source.Term := bounds.pull rename.term

end Bounds

/-- Every atom of the original CNF is an EQ atom. -/
def CNF.EqOnly (sentence : CNF α) : Prop :=
  ∀ clause ∈ sentence, ∀ atom ∈ clause, ∃ terms, atom = Bound.eq terms

/-- The PER generated by the pairs required by a conjunction of EQ atoms. -/
def eqSeed (equations : Set (Set α)) : PER α :=
  PER.hull fun left right => ∃ terms ∈ equations, left ∈ terms ∧ right ∈ terms

end Silmaril.Calculi.PERConstraints
