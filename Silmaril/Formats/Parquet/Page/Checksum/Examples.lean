private def v1Crc : UInt32 := 0xc70eb149
private def v2Crc : UInt32 := 0x3e64dc5b
private def levelMutationCrc : UInt32 := 0x82927994
private def valueMutationCrc : UInt32 := 0x9399e02f

private def hex (bytes : Bytes) : String :=
  String.ofList (bytes.toList.flatMap fun b => [(b.toNat / 16).digitChar, (b.toNat % 16).digitChar])

private def hexCrc (crc : UInt32) : String :=
  String.ofList ((List.range 8).map fun i => (crc.toNat / 16 ^ (7 - i) % 16).digitChar)

private def fixtureLine (version : String) (expanded levelBytes : Nat) (signed : String)
    (crc : UInt32) (levelMutation valueMutation : String) (header body : Bytes) : String :=
  String.intercalate "\t" [version, toString expanded, toString body.length, toString levelBytes,
    signed, hexCrc crc, levelMutation, valueMutation, hex header, hex body] ++ "\n"

#guard (include_str "../../../../../tests/formats/parquet-page-crc32/pyarrow-26.0.1.tsv") =
  fixtureLine "1.0" 1606 0 "-955338423" v1Crc "-" "-" v1Header v1Body ++
  fixtureLine "2.0" 1602 66 "1046797403" v2Crc (hexCrc levelMutationCrc)
    (hexCrc valueMutationCrc) v2Header v2Body ++
  fixtureLine "2.0" 1602 66 "-" v2Crc "-" "-" noCrcHeader v2Body

private def snapshot (header body : Bytes) : Bytes :=
  ((Bytes.ofList [0xfa]).append (header.append body)).push 0xce

private def parse (header body : Bytes) : Except Page.Error (List Frame) :=
  readChunk {} (snapshot header body) ⟨1, 1 + header.length + body.length⟩

private def result (cap : Nat) (header body : Bytes) : Option (Except Error Status) :=
  match parse header body with
  | .ok [frame] => some (verify cap (snapshot header body) frame)
  | _ => none

private def flip (body : Bytes) (index : Nat) : Bytes :=
  .ofList (body.toList.modify index (· ^^^ 1))

#guard UInt32.ofInt (-955338423) = v1Crc
#guard result 99 v1Header v1Body = some (.ok (.valid v1Crc))
#guard result 153 v2Header v2Body = some (.ok (.valid v2Crc))
#guard result 153 noCrcHeader v2Body = some (.ok .absent)
#guard result 98 v1Header v1Body = some (.error .byteLimit)

private def v2Offsets : Option (Nat × Nat) := do
  let .ok [frame] := parse v2Header v2Body | none
  let spans ← frame.v2Spans
  pure (spans.definition.start - frame.payload.start, spans.values.start - frame.payload.start)

#guard v2Offsets = some (0, 66)
#guard result 153 v2Header (flip v2Body 0) = some (.error (.mismatch v2Crc levelMutationCrc))
#guard result 153 v2Header (flip v2Body 66) = some (.error (.mismatch v2Crc valueMutationCrc))

private def invalidExtents : Bool :=
  match parse v2Header v2Body with
  | .ok [frame] =>
    let source := snapshot v2Header v2Body
    let truncated := (Bytes.ofList [0xfa]).append (v2Header.append (Bytes.ofList (v2Body.toList.take 152)))
    let wrongWidth := { frame with payload := { frame.payload with stop := frame.payload.stop - 1 } }
    let detached := { frame with header := { frame.header with stop := frame.header.stop - 1 } }
    verify 153 truncated frame == .error .invalidExtent &&
      verify 153 source wrongWidth == .error .invalidExtent &&
      verify 153 source detached == .error .invalidExtent
  | _ => false

#guard invalidExtents

end Silmaril.Formats.Parquet.Page.Checksum
