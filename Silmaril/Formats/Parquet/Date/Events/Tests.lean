-- Change the second group's PLAIN encoding to RLE_DICTIONARY.
private meta def damaged : Bytes := Bytes.ofList (twoGroups.toList.set 51 16)

#guard match Date.Events.readAll {} twoGroups with
  | .ok ⟨schema, trace⟩ => schema.width == 1 &&
    trace.batches.map (·.rowCount) == [4, 3] && decide (trace.termination = .eos)
  | .error _ => false

#guard match Date.Events.readAll {} damaged with
  | .ok ⟨_, trace⟩ => trace.batches.map (·.rowCount) == [4] &&
    decide (trace.termination = .readError (.groupFailure 1 (.scan .unsupportedPageEncoding)))
  | .error _ => false

#guard match (Date.Events.batchReader {}).read 1 damaged with
  | .ok ⟨_, trace⟩ => trace.batches.map (·.rowCount) == [4] && decide (trace.termination = .closed)
  | .error _ => false
