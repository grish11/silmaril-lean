module

meta import Silmaril.Formats.Arrow.DateStream.Narrow.Defs
meta import Silmaril.Formats.DateInterop.Conversion.Defs

open Silmaril
open Silmaril.Formats.Arrow.DateStream
open Silmaril.Formats.DateInterop
open Silmaril.Numeric.Gregorian (CivilDate)

private meta def scalar (day milliseconds : Int) : Bool :=
  let value := Int32.ofInt day
  let wide := Date32.widen value
  wide.toInt == milliseconds && Date64.narrow? wide == some value

#guard scalar (-2147483648) (-185542587187200000)
#guard scalar 2147483647 185542587100800000
#guard scalar (-1) (-86400000)
#guard scalar 11016 951782400000
#guard [-185542587273600000, 185542587187200000, -1, 1].all fun milliseconds =>
  (Date64.narrow? (Int64.ofInt milliseconds)).isNone

-- A range error ends narrowing at the first bad slot of the first bad batch.
#guard match Narrow.Internal.narrowBatches
    [[], [none, some (CivilDate.ofEpochDay 2147483648),
      some (CivilDate.ofEpochDay (-2147483649))], [some (CivilDate.ofEpochDay 2147483649)]] with
  | .error (.outOfRange 1 1 2147483648) => true
  | _ => false

-- Helpers for the pinned IPC fixtures generated by the independent oracle.
private meta def observes (input : KBytes) (expected : List (List (Option Int))) : Bool :=
  match Narrow.read {} input with
  | .ok result => result.name == "日付" && result.nullable &&
      result.batches.map (List.map (Option.map Int32.toInt)) == expected
  | .error _ => false

private meta def rejects (input : KBytes) (expected : Narrow.Error) : Bool :=
  match Narrow.read {} input with
  | .error actual => actual == expected
  | .ok _ => false
