module

meta import Silmaril.Formats.Arrow.DateStream.Defs

open Silmaril Silmaril.Formats.Arrow

-- CPython 3.13.5 / PyArrow 26.0.1, pinned by the arrow-date-stream oracle.
private meta def date32 : KBytes :=
  KBytes.ofChunks 16 568
    [0xa00000000001000000078ffffffff, 0x401000000000a000800050006000c,
     0x800040000000800080000000c, 0x140010000000140000000100000004,
     0x1000100000000c000700060008, 0x40000001c0000001008010000,
     0x6000000a597e60000000300000000, 0x600060008,
     0x1400000088ffffffff, 0xc000c0008000500060016000c,
     0x100000001800040300, 0xa00080004000c0018000a0000,
     0x2000000100000003c, 0x200000000,
     0x80000000000000001, 0x1000000000000000000000008,
     0x10000000000000002, 0xffffffff0000000000000001,
     0xa00000000001000000070ffffffff, 0x403000000000a000800050006000e,
     0x800040000000c000a000000000010, 0x200000004000000300000000a,
     0x0, 0x0,
     0x100000000, 0x88ffffffff0000000000000000,
     0x500060016000c0000000000000014, 0x18000403000000000c000c0008,
     0xc0018000a00000000000000000008, 0x100000003c0000000a00080004,
     0x2000000000000000000000002, 0x0,
     0x80000000000000000, 0x20000000100000000,
     0x2b080000000000000000, 0xffffffff]

private meta def date64 : KBytes :=
  KBytes.ofChunks 16 576
    [0xa00000000001000000070ffffffff, 0x401000000000a000800050006000c,
     0x800040000000800080000000c, 0x140010000000140000000100000004,
     0x1000100000000c000700060008, 0x4000000180000001008010000,
     0x4000400a597e60000000300000000, 0x88ffffffff0000000000000004,
     0x500060016000c0000000000000014, 0x18000403000000000c000c0008,
     0xc0018000a00000000000000000018, 0x100000003c0000000a00080004,
     0x2000000000000000000000002, 0x10000000000000000,
     0x100000000000000008, 0x20000000100000000,
     0x10000000000000001, 0xfffffffffad9a400,
     0xa00000000001000000070ffffffff, 0x403000000000a000800050006000e,
     0x800040000000c000a000000000010, 0x200000004000000300000000a,
     0x0, 0x0,
     0x100000000, 0x88ffffffff0000000000000000,
     0x500060016000c0000000000000014, 0x18000403000000000c000c0008,
     0xc0018000a00000000000000000010, 0x100000003c0000000a00080004,
     0x2000000000000000000000002, 0x0,
     0x100000000000000000, 0x20000000100000000,
