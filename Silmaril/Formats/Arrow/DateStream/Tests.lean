private meta def expected : List DateValues.Column :=
  [[some ⟨1969, 12, 31⟩, none], [], [some ⟨2000, 2, 29⟩, some ⟨1970, 1, 1⟩]]

#guard decide ((DateStream.read {} date32).toOption = some ⟨⟨"日", true, .day⟩, expected⟩)
#guard decide ((DateStream.read {} date64).toOption = some ⟨⟨"日", true, .millisecond⟩, expected⟩)

#guard match DateStream.read { batches := 1 } date32 with
  | .error (.batch 1 .batchLimit) => true
  | _ => false

#guard match DateStream.read {} (date32.slice 0 (date32.len - 8)) with
  | .error (.batch 3 (.envelope (.malformed .truncated))) => true
  | _ => false
