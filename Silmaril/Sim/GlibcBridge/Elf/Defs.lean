module

public import Silmaril.Sim.GlibcBridge.Link.Defs

/-!
# The pinned glibc-linked hello ELF and the bridge's link map (header)

`examples/wasm-sim/glibc-bridge/pinned/hello-glibc` is `progs/hello.c` (`puts("Hello, world!");
return 0;`) built by `pinned/pin.sh` with Ubuntu 24.04's `gcc -O2 -no-pie` (13.3.0-6ubuntu2~24.04.1,
glibc 2.39-0ubuntu8.9): ET_EXEC, `DT_NEEDED libc.so.6`, relocations `GLOB_DAT __libc_start_main`,
`GLOB_DAT __gmon_start__` (weak) and `JUMP_SLOT puts` (GOT `0x404000`). `exe` is the whole file as
one little-endian number (`Silmaril.Machine.Link.Blob`), trusted only to be that file (sha256
`367ebd46…20af`, `pinned/SHA256SUMS`); `exeObj := Obj.ofBlob exe` is what the loader model reads
(`Silmaril.Sim.GlibcBridge.Link`).

**The foreign library.** `subsetObj` is the loader's view of the Wasm glibc subset
(`wat/glibc.wat`, interface `glibc-subset`): `DT_SONAME libc.so.6`, no relocations or segments, and
function `i` of the loader table (`build.sh`) defined at `16 i` — so at the foreign base
`EXT_BASE = 0x7f00_0000_0000` (`ghelloLinkMap`), `puts` is `EXT_BASE` and `__libc_start_main` is
`glibcrun.wat`'s `START = EXT_BASE + 0x30`. **`ghelloLinkMap`** = the executable at 0 then the subset
at `EXT_BASE`: what `loader-glibc.wat` builds (its eager binding is `EagerLoaded`, as rt-proc's).
-/

@[expose] public section

namespace Silmaril.Sim.GlibcBridge

open Silmaril.Machine.Link (Blob)
open Silmaril.Sim.GlibcBridge.Link
open Silmaril.X86 (Word)

/-- The pinned executable (15864 bytes). -/
def exe : Blob := ⟨, 15864⟩

/-- The loader's view of the executable. -/
def exeObj : Obj := Obj.ofBlob exe

/-- The functions of the glibc subset, in loader-table order (`EXT_BASE + 16 i`). -/
def subsetNames : List String :=
  ["puts", "strlen", "putchar", "__libc_start_main", "exit", "write", "memcpy", "memset"]

/-- The foreign base. -/
def extBase : Word := 0x7f0000000000#64

/-- The loader's view of the Wasm glibc subset. -/
def subsetObj : Obj where
  soname := some (nm "libc.so.6")
  needed := []
  defines n := ((subsetNames.map nm).idxOf? n).map fun i => ⟨16 * i, false⟩
  rels := []
  slice _ _ := none

/-- The bridge's link map. -/
def ghelloLinkMap : LinkMap := [(exeObj, 0#64), (subsetObj, extBase)]

end Silmaril.Sim.GlibcBridge
