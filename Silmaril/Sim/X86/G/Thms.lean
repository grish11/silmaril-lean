#guard_msgs in
#print axioms Silmaril.Sim.X86.G.xproblem_of_wproblem

/-- info: 'Silmaril.Sim.X86.G.run_of_runExt' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in
#print axioms Silmaril.Sim.X86.G.run_of_runExt

public section

namespace Silmaril.Sim.X86.G

open Silmaril.Wasm Silmaril.Wasm.Execution Silmaril.Wasm.Execution.Core Silmaril.Wasm.Numerics
open Silmaril.Wasm.Logic.VC (wpc)

/-- Evaluate the generator's condition on code generated by the G simulator (see the module
docstring); `hyps` are the `Layout` and `gval` facts of the initial store and the definitions
to unfold. -/
syntax "g_vc" " [" Lean.Parser.Tactic.simpLemma,* "]" : tactic

macro_rules
  | `(tactic| g_vc [$ls,*]) => `(tactic|
      simp (maxDischargeDepth := 20) only [aluCode, cmovCode, nextCode, carryCode, overflowCode,
        zeroCode, msbCode, notCode, aluWasm, List.cons_append, List.nil_append, wpc,
        Silmaril.Sim.X86.G.ctl_gget, Silmaril.Sim.X86.G.ctl_gset, Silmaril.Sim.X86.G.ctl_c64,
        Silmaril.Sim.X86.G.ctl_b64op, List.reverse_cons, List.reverse_nil, exec1_gget, exec1_gset,
        exec1_c64, exec1_add, exec1_sub, exec1_and, exec1_or, exec1_xor, exec1_shr63, Layout.upd,
        gval_upd, Option.map_some, reduceCtorEq, ite_false, ite_true, Loc.reg.injEq, reduceIte,
        List.reverse_reverse, $ls,*])

end Silmaril.Sim.X86.G

end
