variable {H : Type}

/-- Register `k` (`0‥16`, `i64` globals). -/
def R (s : Store H) (mi : ModuleInst) (k : Nat) : BitVec 64 :=
  match globalVal s mi k with
  | some (.num ⟨.int .i64, v⟩) => v
  | _ => 0

/-- Flag `k` (`17‥23`, `i32` globals). -/
def Fl (s : Store H) (mi : ModuleInst) (k : Nat) : BitVec 32 :=
  match globalVal s mi k with
  | some (.num ⟨.int .i32, v⟩) => v
  | _ => 0

/-- The bytes of memory `ma`. -/
def memB (s : Store H) (ma : Nat) : ByteArray := ((s.mems[ma]?).map (·.bytes)).getD default

/-- **The state invariant**: globals `0‥16` are `i64`, `17‥23` `i32`; memory `ma` has type
`mt` and at least one page; the functions at addresses `0‥28` are `fis 0‥28`. -/
structure Good (mi : ModuleInst) (ma : Nat) (mt : MemoryType) (fis : Nat → FuncInst H)
    (s : Store H) : Prop where
  funcs : ∀ a < 29, s.funcs[a]? = some (fis a)
  regs : ∀ k < 17, ∃ v : BitVec 64, globalVal s mi k = some (.num ⟨.int .i64, v⟩)
  flags : ∀ k, 17 ≤ k → k < 24 → ∃ v : BitVec 32, globalVal s mi k = some (.num ⟨.int .i32, v⟩)
  mem : (s.mems[ma]?).map (·.type) = some mt
  size : 65536 ≤ (memB s ma).size

/-! ## Specifications -/

/-- The `i`-th argument as an `i32`. -/
def a32 (args : List Val) (i : Nat) : BitVec 32 :=
  match args.getD i (Val.i64 0) with
  | .num ⟨.int .i32, v⟩ => v
  | _ => 0

/-- The `i`-th argument as an `i64`. -/
def a64 (args : List Val) (i : Nat) : BitVec 64 :=
  match args.getD i (Val.i32 0) with
  | .num ⟨.int .i64, v⟩ => v
  | _ => 0

/-- The guest address `x` lies in the local memory window with `n` bytes. -/
def InWin (x : BitVec 64) (n : Nat) : Prop := 1048576 ≤ x.toNat ∧ x.toNat + n ≤ 1114112

/-- The little-endian `u64` at byte `a` of `B`. -/
def ld64 (B : ByteArray) (a : Nat) : BitVec 64 :=
  BitVec.ofNat 64 (Silmaril.Wasm.Logic.Core.leNat (Silmaril.Wasm.Logic.Core.bytesAt B ⟨a, 8⟩))

section Specs

open Silmaril.Wasm.Logic.Hoare (FSpec)

variable (mi : ModuleInst) (ma : Nat) (mt : MemoryType) (fis : Nat → FuncInst H)

/-- A pure function (store unchanged) with result `res`. -/
def pureSpec (P : List Val → Prop) (res : Store H → List Val → List Val) : FSpec H where
  pre s args := Good mi ma mt fis s ∧ P args
  post s args s' o := s' = s ∧ o = .normal (res s args)

/-- A procedure (no result) with the store effect `eff`. -/
def procSpec (P : List Val → Prop) (eff : Store H → List Val → Store H) : FSpec H where
  pre s args := Good mi ma mt fis s ∧ P args
  post s args s' o := s' = eff s args ∧ o = .normal []

/-- `off a n`: the offset of a guest address in the window. -/
def sOff : FSpec H := pureSpec mi ma mt fis
  (fun args => ∃ x n, args = [Val.i64 x, Val.i64 n] ∧ InWin x n.toNat)
  (fun _ args => [Val.i32 ((a64 args 0 - 1048576#64).setWidth 32)])

/-- `load64 a`. -/
def sLoad64 : FSpec H := pureSpec mi ma mt fis
  (fun args => ∃ x, args = [Val.i64 x] ∧ InWin x 8)
  (fun s args => [Val.i64 (ld64 (memB s ma) ((a64 args 0).toNat - 1048576))])

/-- `store64 a v`. -/
def sStore64 : FSpec H := procSpec mi ma mt fis
  (fun args => ∃ x v, args = [Val.i64 x, Val.i64 v] ∧ InWin x 8)
  (fun s args => s.setMem ma ⟨mt, Silmaril.Wasm.Logic.Core.storeLE (memB s ma)
    ((a64 args 0).toNat - 1048576) 8 (a64 args 1).toNat⟩)

/-- `rget r` (`r ≤ 16`). -/
def sRget : FSpec H := pureSpec mi ma mt fis
  (fun args => ∃ r, args = [Val.i32 r] ∧ r.toNat < 17)
  (fun s args => [Val.i64 (R s mi (a32 args 0).toNat)])

/-- `rset r v` (`r ≤ 16`). -/
def sRset : FSpec H := procSpec mi ma mt fis
  (fun args => ∃ r v, args = [Val.i32 r, Val.i64 v] ∧ r.toNat < 17)
  (fun s args => setGlobalIdx s mi (a32 args 0).toNat (Val.i64 (a64 args 1)))

/-- `fget f` (`17 ≤ f ≤ 23`). -/
def sFget : FSpec H := pureSpec mi ma mt fis
  (fun args => ∃ f, args = [Val.i32 f] ∧ 17 ≤ f.toNat ∧ f.toNat < 24)
  (fun s args => [Val.i32 (Fl s mi (a32 args 0).toNat)])

/-- `fset f v` (`17 ≤ f ≤ 23`). -/
def sFset : FSpec H := procSpec mi ma mt fis
  (fun args => ∃ f v, args = [Val.i32 f, Val.i32 v] ∧ 17 ≤ f.toNat ∧ f.toNat < 24)
  (fun s args => setGlobalIdx s mi (a32 args 0).toNat (Val.i32 (a32 args 1)))

/-- The six status flags written by `fset6`. -/
def set6 (s : Store H) (c p a z sg o : BitVec 32) : Store H :=
  setGlobalIdx (setGlobalIdx (setGlobalIdx (setGlobalIdx (setGlobalIdx (setGlobalIdx s mi 17
    (Val.i32 c)) mi 18 (Val.i32 p)) mi 19 (Val.i32 a)) mi 20 (Val.i32 z)) mi 21 (Val.i32 sg)) mi 22
    (Val.i32 o)

/-- `fset6 c p a z s o`. -/
def sFset6 : FSpec H := procSpec mi ma mt fis
  (fun args => ∃ c p a z sg o, args = [Val.i32 c, Val.i32 p, Val.i32 a, Val.i32 z, Val.i32 sg,
    Val.i32 o])
  (fun s args => set6 mi s (a32 args 0) (a32 args 1) (a32 args 2) (a32 args 3) (a32 args 4)
    (a32 args 5))

/-- `mask 8`. -/
def sMask : FSpec H := pureSpec mi ma mt fis (fun args => args = [Val.i32 8])
  (fun _ _ => [Val.i64 (-1)])

/-- `sbit 8`. -/
def sSbit : FSpec H := pureSpec mi ma mt fis (fun args => args = [Val.i32 8])
  (fun _ _ => [Val.i64 (1 <<< 63)])

/-- A function with the store effect `eff` and result `res`. -/
def fnSpec (P : Store H → List Val → Prop) (eff : Store H → List Val → Store H)
    (res : Store H → List Val → List Val) : FSpec H where
  pre s args := Good mi ma mt fis s ∧ P s args
  post s args s' o := s' = eff s args ∧ o = .normal (res s args)

/-- The parity flag of a result: the low byte has an even number of ones. -/
def par (r : BitVec 64) : BitVec 32 :=
  Silmaril.Wasm.Numerics.bool32 ((((r.setWidth 32 &&& 255#32).cpop) &&& 1#32) == 0#32)

/-- `parity r`. -/
def sParity : FSpec H := pureSpec mi ma mt fis (fun args => ∃ r, args = [Val.i64 r])
  (fun _ args => [Val.i32 (par (a64 args 0))])

/-- The flags `fres 8 r cf af of` writes. -/
def fresEff (s : Store H) (r : BitVec 64) (cf af of : BitVec 32) : Store H :=
  set6 mi s cf (par r) af (Silmaril.Wasm.Numerics.bool32 (r == 0#64))
    (Silmaril.Wasm.Numerics.bool32 ((r &&& 1 <<< 63) != 0#64)) of

/-- `fres 8 r cf af of`. -/
def sFres : FSpec H := procSpec mi ma mt fis
  (fun args => ∃ r cf af of, args = [Val.i32 8, Val.i64 r, Val.i32 cf, Val.i32 af, Val.i32 of])
  (fun s args => fresEff mi s (a64 args 1) (a32 args 2) (a32 args 3) (a32 args 4))

/-- `rd 8 r` (`r < 16`). -/
def sRd : FSpec H := pureSpec mi ma mt fis
  (fun args => ∃ r, args = [Val.i32 8, Val.i32 r] ∧ r.toNat < 16)
  (fun s args => [Val.i64 (R s mi (a32 args 1).toNat)])

/-- `wr 8 r v` (`r < 16`). -/
def sWr : FSpec H := procSpec mi ma mt fis
  (fun args => ∃ r v, args = [Val.i32 8, Val.i32 r, Val.i64 v] ∧ r.toNat < 16)
  (fun s args => setGlobalIdx s mi (a32 args 1).toNat (Val.i64 (a64 args 2)))

/-- `cond 12` (`l`: SF ≠ OF). -/
def sCond : FSpec H := pureSpec mi ma mt fis (fun args => args = [Val.i32 12])
  (fun s _ => [Val.i32 (Fl s mi 21 ^^^ Fl s mi 22)])

/-- The flags of `cmp a, b` (64-bit). -/
def cmpEff (s : Store H) (a b : BitVec 64) : Store H :=
  fresEff mi s (a - b) (Silmaril.Wasm.Numerics.bool32 (decide (a.toNat < b.toNat)))
    (((a ^^^ b ^^^ (a - b)) >>> 4 &&& 1#64).setWidth 32)
    (Silmaril.Wasm.Numerics.bool32 (((a ^^^ b) &&& (a ^^^ (a - b)) &&& 1 <<< 63) != 0#64))

/-- `alu 7 8 a b` (64-bit `cmp`). -/
def sAlu : FSpec H := fnSpec mi ma mt fis
  (fun _ args => ∃ a b, args = [Val.i32 7, Val.i32 8, Val.i64 a, Val.i64 b])
  (fun s args => cmpEff mi s (a64 args 2) (a64 args 3))
  (fun _ args => [Val.i64 (a64 args 2 - a64 args 3)])

/-- `pop`: the `u64` at `[rsp]`, `rsp += 8`. -/
def sPop : FSpec H := fnSpec mi ma mt fis (fun s args => args = [] ∧ InWin (R s mi 4) 8)
  (fun s _ => setGlobalIdx s mi 4 (Val.i64 (R s mi 4 + 8)))
  (fun s _ => [Val.i64 (ld64 (memB s ma) ((R s mi 4).toNat - 1048576))])

/-- `get loc` (`loc ≤ 16`). -/
def sGet : FSpec H := pureSpec mi ma mt fis
  (fun args => ∃ l, args = [Val.i32 l] ∧ l.toNat ≤ 16)
  (fun s args => [Val.i64 (R s mi (a32 args 0).toNat)])

/-- `set loc v` (`loc ≤ 16`). -/
def sSet : FSpec H := procSpec mi ma mt fis
  (fun args => ∃ l v, args = [Val.i32 l, Val.i64 v] ∧ l.toNat ≤ 16)
  (fun s args => setGlobalIdx s mi (a32 args 0).toNat (Val.i64 (a64 args 1)))

/-- `i_next len`. -/
def sNext : FSpec H := procSpec mi ma mt fis (fun args => ∃ n, args = [Val.i32 n])
  (fun s args => setGlobalIdx s mi 16 (Val.i64 (R s mi 16 + (a32 args 0).setWidth 64)))

/-- `i_mov_rr 8 d s` (`d, s < 16`). -/
def sMovRR : FSpec H := procSpec mi ma mt fis
  (fun args => ∃ d r, args = [Val.i32 8, Val.i32 d, Val.i32 r] ∧ d.toNat < 16 ∧ r.toNat < 16)
  (fun s args => setGlobalIdx s mi (a32 args 1).toNat (Val.i64 (R s mi (a32 args 2).toNat)))

/-- `i_alu_rr 7 8 d s` (`cmp`, `d, s < 16`). -/
def sAluRR : FSpec H := procSpec mi ma mt fis
  (fun args => ∃ d r, args = [Val.i32 7, Val.i32 8, Val.i32 d, Val.i32 r] ∧ d.toNat < 16 ∧
    r.toNat < 16)
  (fun s args => cmpEff mi s (R s mi (a32 args 2).toNat) (R s mi (a32 args 3).toNat))

/-- `i_ret`. -/
def sRet : FSpec H := fnSpec mi ma mt fis (fun s args => args = [] ∧ InWin (R s mi 4) 8)
  (fun s _ => setGlobalIdx (setGlobalIdx s mi 4 (Val.i64 (R s mi 4 + 8))) mi 16
    (Val.i64 (ld64 (memB s ma) ((R s mi 4).toNat - 1048576))))
  (fun _ _ => [])

/-- `i_cmov_rr 12 8 d s` (`cmovl`, `d, s < 16`). -/
def sCmovRR : FSpec H := procSpec mi ma mt fis
  (fun args => ∃ d r, args = [Val.i32 12, Val.i32 8, Val.i32 d, Val.i32 r] ∧ d.toNat < 16 ∧
    r.toNat < 16)
  (fun s args => setGlobalIdx s mi (a32 args 2).toNat (Val.i64
    (if Fl s mi 21 ^^^ Fl s mi 22 = 0 then R s mi (a32 args 2).toNat
      else R s mi (a32 args 3).toNat)))

/-- **The x86 function `f_400005`** (P-calls body of `max2`): returns `0` with `rax` the signed
maximum of `rdi` and `rsi` and RIP the return address read from `[rsp]`. -/
def sProg : FSpec H where
  pre s args := Good mi ma mt fis s ∧ args = [] ∧ InWin (R s mi 4) 8
  post s _ s' o := o = .normal [Val.i32 0] ∧ Good mi ma mt fis s' ∧
    R s' mi 0 = (if (R s mi 7).slt (R s mi 6) then R s mi 6 else R s mi 7) ∧
    R s' mi 16 = ld64 (memB s ma) ((R s mi 4).toNat - 1048576)

/-- **The SysV wrapper `max2(rdi, rsi)`**: returns the `@ensures` value
`(ite (bvsgt rsi rdi) rsi rdi)`. -/
def sMax2 : FSpec H where
  pre s args := Good mi ma mt fis s ∧ ∃ x y, args = [Val.i64 x, Val.i64 y]
  post _ args _ o := o = .normal [Val.i64 (if (a64 args 0).slt (a64 args 1) then a64 args 1
    else a64 args 0)]

/-- **The specification table**: the arity and specification of the function at address `a`
(the functions `max2` uses; `u`, `sys.syscall` and `nd.undef` are not called on its path). -/
def specOf (a : Nat) : Option (Nat × FSpec H) :=
  match a with
  | 2 => some (2, sOff mi ma mt fis)
  | 3 => some (1, sLoad64 mi ma mt fis)
  | 4 => some (2, sStore64 mi ma mt fis)
  | 5 => some (1, sRget mi ma mt fis)
  | 6 => some (2, sRset mi ma mt fis)
  | 7 => some (1, sFget mi ma mt fis)
  | 8 => some (2, sFset mi ma mt fis)
  | 9 => some (6, sFset6 mi ma mt fis)
  | 10 => some (1, sMask mi ma mt fis)
  | 11 => some (1, sSbit mi ma mt fis)
  | 13 => some (1, sParity mi ma mt fis)
  | 14 => some (5, sFres mi ma mt fis)
  | 15 => some (2, sRd mi ma mt fis)
  | 16 => some (3, sWr mi ma mt fis)
  | 17 => some (1, sCond mi ma mt fis)
  | 18 => some (4, sAlu mi ma mt fis)
  | 19 => some (0, sPop mi ma mt fis)
  | 20 => some (1, sGet mi ma mt fis)
  | 21 => some (2, sSet mi ma mt fis)
  | 22 => some (1, sNext mi ma mt fis)
  | 23 => some (3, sMovRR mi ma mt fis)
  | 24 => some (4, sAluRR mi ma mt fis)
  | 25 => some (0, sRet mi ma mt fis)
  | 26 => some (4, sCmovRR mi ma mt fis)
  | 27 => some (0, sProg mi ma mt fis)
  | 28 => some (2, sMax2 mi ma mt fis)
  | _ => none

/-- The spec context of the functions below address `n` (the callees of function `n`: the
module's functions are in topological order of the call graph). -/
@[reducible] def ctxBelow (n : Nat) : Silmaril.Wasm.Logic.VC.VCSpecs H :=
  ⟨fun a => if a < n then specOf mi ma mt fis a else none⟩

/-- The number of results of function `a`. -/
def nres (a : Nat) : Nat :=
  match a with
  | 4 | 6 | 8 | 9 | 14 | 16 | 21 | 22 | 23 | 24 | 25 | 26 => 0
  | _ => 1

end Specs

/-- **The instance**: functions at addresses `0‥28` (`mi.funcs = [0, …, 28]`), distinct
global addresses, memory `0` at address `ma`, and function `a` (`2 ≤ a ≤ 28`) runs
`max2M.funcs[a - 2]` with the type of its arity. -/
structure Inst (mi : ModuleInst) (ma : Nat) (mt : MemoryType) (fis : Nat → FuncInst H) :
    Prop where
  funcs : mi.funcs = List.range 29
  module : ∀ a, (fis a).module = mi
  globals : mi.globals.Nodup
  mems : mi.mems[0]? = some ma
  code : ∀ a c, 2 ≤ a → max2M.funcs[a - 2]? = some c → (fis a).code = .wasm c
  type : ∀ a np (S : Silmaril.Wasm.Logic.Hoare.FSpec H), specOf mi ma mt fis a = some (np, S) →
    ∃ ps rs, Silmaril.Wasm.Validation.Expand (fis a).type (.func ps rs) ∧ ps.length = np ∧
      rs.length = nres a

end Silmaril.Sim.X86.Max2
