module

public import Silmaril.Sim.Reduce.PCalls.Defs
public import Silmaril.Sim.Reduce.Toy.Defs
public import Silmaril.Wasm.Game.Instantiate.Defs

/-!
# The toy's `dbl`, reduced to a P-calls Wasm problem: statements

`dbl` (`examples/wasm-sim/reduce/toy/toy.S`): `mov %rdi,%rax; add %rax,%rax; ret`. The canonical
tool (`wasm-sim reduce --granularity insn`, `tools/wasm-sim/src/reduce/insn.rs`) emits
`examples/wasm-sim/reduce/toy/insn/dbl.wat`, quoted here as `dblModule`: the 23 location globals,
one full step method per instruction (`s_mov_rax_rdi_3`, `s_add_rax_rax_3`, equal to
`Silmaril.Sim.X86.G.emit i len` by `rfl`) and the P-calls body `dbl_body` (`call 0; call 1`).

* `dblProg`, `dblCalls`: the straight-line body (before `ret`) and the calls;
* `DblPost`: `rax = rdi + rdi`, the other registers unchanged;
* **`PieceStmt`**: the Wasm piece (`Silmaril.Sim.Reduce.PCalls.Piece`), at every profile and host;
* `X86Stmt`: the x86 problem of the body (`Silmaril.Sim.X86.G.XProblem`);
* the ISA goal is `Silmaril.Sim.Reduce.Toy.isaGoal .dbl` (the System V contract on `Open9.isa` at
  every placement).
-/

@[expose] public section

namespace Silmaril.Sim.Reduce.Toy.Dbl

open Silmaril.Wasm Silmaril.Wasm.Execution Silmaril.Wasm.Execution.Core Silmaril.Wasm.Numerics
open Silmaril.Sim.X86.G Silmaril.Sim.Reduce.PCalls
open Silmaril.X86 (Reg)

/-- The merged module, quoted from `examples/wasm-sim/reduce/toy/insn/dbl.wat`. -/
def dblModule : Module := wat3! r#"
;; Per-instruction P-calls problem for `dbl` (GENERATED by `wasm-sim reduce --granularity insn`).
;; Step methods = `Silmaril.Sim.X86.G.emit i len` (certified); `dbl_body` calls one per
;; instruction (the final `ret` is handled at the ISA level).
(module
  (global $rax (export "rax") (mut i64) (i64.const 0))
  (global $rcx (export "rcx") (mut i64) (i64.const 0))
  (global $rdx (export "rdx") (mut i64) (i64.const 0))
  (global $rbx (export "rbx") (mut i64) (i64.const 0))
  (global $rsp (export "rsp") (mut i64) (i64.const 0))
  (global $rbp (export "rbp") (mut i64) (i64.const 0))
  (global $rsi (export "rsi") (mut i64) (i64.const 0))
  (global $rdi (export "rdi") (mut i64) (i64.const 0))
  (global $r8 (export "r8") (mut i64) (i64.const 0))
  (global $r9 (export "r9") (mut i64) (i64.const 0))
  (global $r10 (export "r10") (mut i64) (i64.const 0))
  (global $r11 (export "r11") (mut i64) (i64.const 0))
  (global $r12 (export "r12") (mut i64) (i64.const 0))
  (global $r13 (export "r13") (mut i64) (i64.const 0))
  (global $r14 (export "r14") (mut i64) (i64.const 0))
  (global $r15 (export "r15") (mut i64) (i64.const 0))
  (global $rip (export "rip") (mut i64) (i64.const 0))
  (global $cf (export "cf") (mut i64) (i64.const 0))
  (global $pf (export "pf") (mut i64) (i64.const 0))
  (global $af (export "af") (mut i64) (i64.const 0))
  (global $zf (export "zf") (mut i64) (i64.const 0))
  (global $sf (export "sf") (mut i64) (i64.const 0))
  (global $of (export "of") (mut i64) (i64.const 0))
  (func $s_mov_rax_rdi_3 (export "s_mov_rax_rdi_3")
    global.get $rdi
    global.set $rax
    global.get $rip
    i64.const 3
    i64.add
    global.set $rip
  )
  (func $s_add_rax_rax_3 (export "s_add_rax_rax_3")
    global.get $rax
    global.get $rax
    i64.and
    global.get $rax
    global.get $rax
    i64.or
    global.get $rax
    global.get $rax
    i64.add
    i64.const -1
    i64.xor
    i64.and
    i64.or
    i64.const 63
    i64.shr_u
    global.set $cf
    global.get $rax
    global.get $rax
    global.get $rax
    i64.add
    i64.xor
    global.get $rax
    global.get $rax
    global.get $rax
    i64.add
    i64.xor
    i64.and
    i64.const 63
    i64.shr_u
    global.set $of
    i64.const 1
    global.get $rax
    global.get $rax
    i64.add
    i64.const 0
    global.get $rax
    global.get $rax
    i64.add
    i64.sub
    i64.or
    i64.const 63
    i64.shr_u
    i64.xor
    global.set $zf
    global.get $rax
    global.get $rax
    i64.add
    i64.const 63
    i64.shr_u
    global.set $sf
    global.get $rax
    global.get $rax
    i64.add
    global.set $rax
    global.get $rip
    i64.const 3
    i64.add
    global.set $rip
  )
  (func $dbl_body (export "dbl_body")
    call $s_mov_rax_rdi_3
    call $s_add_rax_rax_3
  )
)
"#

/-- The body of `dbl` before its `ret`. -/
def dblProg : XProg := [(.mov .q (.reg .rax) .rdi, 3), (.alu .q .add (.reg .rax) .rax, 3)]

/-- The calls of the P-calls body. -/
def dblCalls : List FuncIdx := [⟨0⟩, ⟨1⟩]

/-- `rax = rdi + rdi`, the other registers unchanged. -/
def DblPost (R R' : Reg → BitVec 64) : Prop :=
  R' .rax = R .rdi + R .rdi ∧ ∀ r, r ≠ .rax → R' r = R r

/-- **The Wasm piece** of `dbl`. -/
def PieceStmt : Prop :=
  ∀ {H : Type} (P : Profile) (host : HostSemantics H),
    Piece P host dblProg dblCalls (fun _ => True) DblPost

/-- The x86 problem of `dbl`'s body. -/
def X86Stmt : Prop := XProblem dblProg (fun _ => True) DblPost

/-- The bytes of `dbl`, one list per instruction, `ret` last. -/
def dblBytes : List (List (BitVec 8)) := [[0x48, 0x89, 0xf8], [0x48, 0x01, 0xc0], [0xc3]]

/-- The instantiation of `dblModule` against no imports. -/
def dblRun : Option (Store Nat × Frame × Option FuncIdx) :=
  instantiateOnce? (Silmaril.Wasm.Game.importStore []) dblModule []

/-- The store after instantiation. -/
def dblStore : Store Nat := match dblRun with | some (s, _, _) => s | none => {}

/-- The module instance. -/
def dblMI : ModuleInst := match dblRun with | some (_, f, _) => f.module | none => {}

end Silmaril.Sim.Reduce.Toy.Dbl
