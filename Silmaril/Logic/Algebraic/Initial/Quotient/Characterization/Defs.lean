module

public import Silmaril.Logic.Algebraic.Initial.Quotient.Thms

/-! Independent algebraic properties used to characterize the existing quotient
initial model. These definitions do not encode matching satisfaction. -/
@[expose] public section
namespace Silmaril.Logic.Algebraic.Initial.Presented.Characterization
open Silmaril.Logic.Institution.Examples
variable {S : EQ.Signature}

abbrev Ground (A : EQ.Signature) (s : A.S) := EQ.Term A (closedContext A) s

def evaluate (A : EQ.Algebra S) {s : S.S} (t : Ground S s) : A.carrier s :=
  t.eval A (fun i => i.elim0)

/-- Every element is the value of a closed term, at its own sort. -/
def Generated (A : EQ.Algebra S) : Prop :=
  ∀ s, Function.Surjective (evaluate A (s := s))

/-- Evaluation identifies exactly the least congruence generated by complete
instances of the original theory equations. No decision procedure is assumed. -/
def ExactGroundKernel (T : Theory) (A : EQ.Algebra T.sig) : Prop :=
  ∀ s (a b : Ground T.sig s), evaluate A a = evaluate A b ↔
    Rel T (closedContext T.sig) a b

end Silmaril.Logic.Algebraic.Initial.Presented.Characterization
