module

public import Silmaril.Logic.Algebraic.Initial.Thms
public import Mathlib.Data.Fintype.Quotient

@[expose] public section
namespace Silmaril.Logic.Algebraic.Initial.Presented
open CategoryTheory Silmaril.Logic.Institution.Examples
variable (T : Theory) {k : Nat} (Γ : Fin k → T.sig.S)

/-- Sorted equational congruence generated by complete instances of the theory's
axioms. Even unused context variables require substitution values. -/
inductive Rel : {s : T.sig.S} → EQ.Term T.sig Γ s → EQ.Term T.sig Γ s → Prop where
  | refl {s} (a : EQ.Term T.sig Γ s) : Rel a a
  | symm {s} {a b : EQ.Term T.sig Γ s} : Rel a b → Rel b a
  | trans {s} {a b c : EQ.Term T.sig Γ s} : Rel a b → Rel b c → Rel a c
  | app {n w s} (op : T.sig.Op n w s) (a b : ∀ i, EQ.Term T.sig Γ (w i))
      (h : ∀ i, Rel (a i) (b i)) : Rel (.app op a) (.app op b)
  | equation (e : EQ.Equation T.sig) (he : ULift.up e ∈ T.axioms)
      (v : ∀ i, EQ.Term T.sig Γ (e.ctx i)) :
      Rel (e.lhs.eval (termAlgebra T.sig Γ) v) (e.rhs.eval (termAlgebra T.sig Γ) v)

def setoid (s : T.sig.S) : Setoid (EQ.Term T.sig Γ s) :=
  ⟨Rel T Γ, ⟨Rel.refl, Rel.symm, Rel.trans⟩⟩

/-- Actual public EQ algebra, with an operation-compatible quotient at every
sort. Finite dependent quotient lifting also covers nullary operations. -/
def algebra : EQ.Algebra T.sig where
  carrier s := Quotient (setoid T Γ s)
  op op args :=
    Quotient.finLiftOn args (fun a => Quotient.mk _ (.app op a))
      (fun a b h => Quotient.sound (Rel.app op a b h))

theorem op_mk {n : Nat} {w : Fin n → T.sig.S} {s : T.sig.S}
    (op : T.sig.Op n w s) (args : ∀ i, EQ.Term T.sig Γ (w i)) :
    (algebra T Γ).op op (fun i => Quotient.mk _ (args i)) =
      Quotient.mk (setoid T Γ s) (.app op args) := by
  change Quotient.finLiftOn (S := fun i => setoid T Γ (w i))
    (fun i => Quotient.mk _ (args i)) _ _ = _
  exact congrFun (congrFun (Quotient.finLiftOn_mk args)
    (fun a => Quotient.mk (setoid T Γ s) (.app op a)))
    (fun a b h => Quotient.sound (Rel.app op a b h))

/-- The syntactic projection is an actual algebra homomorphism. -/
def projection : termAlgebra T.sig Γ ⟶ algebra T Γ where
  map _ t := Quotient.mk _ t
  map_op op args := (op_mk T Γ op args).symm

/-- Quotienting preserves precisely which sorts have terms. -/
theorem nonempty_carrier_iff (s : T.sig.S) :
    Nonempty ((algebra T Γ).carrier s) ↔ Nonempty (EQ.Term T.sig Γ s) :=
  nonempty_quotient_iff _

end Silmaril.Logic.Algebraic.Initial.Presented
