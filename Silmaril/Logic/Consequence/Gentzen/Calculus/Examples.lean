module

public import Silmaril.Logic.Consequence.Gentzen.Calculus.Thms
public import Silmaril.Logic.Consequence.Gentzen.Examples

/-!
# Examples: calculi, restrictions, negation profiles

* Literal validity (`Gentzen.Examples.lsat`, `lneg`) has both negation rules, so it is the raw
  refutation relation of its own `[] `-restriction (`lit_eq_viaUnsat`).
* The pure identity calculus (nothing but reflexivity, weakening and cut, over literals with
  `lneg`) derives `p ⊢ p` but not `p, ¬p ⊢`: without negation rules a calculus is not determined
  by its refutation restriction (`identity_not_negL`, `identity_ne_viaUnsat`).
* Joins of calculi are closures of unions: the join of the calculi generated by `p ⊢ q` and
  `q ⊢ r` derives `p ⊢ r` by cut (`join_derives_p_r`), which neither calculus does alone.
* Triviality needs weakening: a relation holding only at `[] ⊢ []` accepts `[] ⊢ []` without
  being universal (`onlyEmpty_not_universal`).
-/

@[expose] public section

namespace Silmaril.Consequence.Gentzen.Calculus.Examples

open Gentzen.Examples

theorem lit_eq_viaUnsat : Valid lsat = viaUnsat (toUnsat (Valid lsat)) lneg :=
  eq_viaUnsat_toUnsat valid_closed (valid_negL lneg_sound) (valid_negR lneg_complete)

/-- The pure identity calculus over literals. -/
abbrev identity : Seq Lit := Derives defaultRules ⊥

theorem identity_p_p : identity [(true, 0)] [(true, 0)] :=
  identity_iff_overlap.2 ⟨_, List.mem_singleton_self _, List.mem_singleton_self _⟩

theorem identity_not_explosion : ¬ identity [(true, 0), (false, 0)] [] := fun h => by
  simpa using identity_iff_overlap.1 h

/-- The identity calculus lacks the left negation rule. -/
theorem identity_not_negL : ¬ NegL lneg identity := fun h =>
  identity_not_explosion (by
    have := h identity_p_p
    exact (derives_closed defaultRules ⊥).weak (by intro x; simp [lneg]; tauto)
      (fun _ h => h) this)

theorem identity_ne_viaUnsat : identity ≠ viaUnsat (toUnsat identity) lneg := fun h =>
  identity_not_explosion (by
    have := congrFun (congrFun h [(true, 0)]) [(true, 0)]
    have h' := this ▸ identity_p_p
    simpa [viaUnsat, toUnsat, lneg] using h')

/-- `p ⊢ q`. -/
def pq : Seq Lit := fun Γ Δ => Γ = [(true, 0)] ∧ Δ = [(true, 1)]

/-- `q ⊢ r`. -/
def qr : Seq Lit := fun Γ Δ => Γ = [(true, 1)] ∧ Δ = [(true, 2)]

theorem join_derives_p_r :
    ((Calculus.of defaultRules pq ⊔ Calculus.of defaultRules qr : Calculus defaultRules) :
      Seq Lit) [(true, 0)] [(true, 2)] := by
  rw [Calculus.coe_sup]
  exact .cut (Γ := [(true, 0)]) (Γ' := []) (Δ := []) (Δ' := [(true, 2)]) trivial
    (.base (Or.inl (.base ⟨rfl, rfl⟩))) (.base (Or.inr (.base ⟨rfl, rfl⟩)))

/-- Holds only at `[] ⊢ []`. -/
def onlyEmpty : Seq Lit := fun Γ Δ => Γ = [] ∧ Δ = []

theorem onlyEmpty_not_universal : onlyEmpty [] [] ∧ ¬ ∀ Γ Δ, onlyEmpty Γ Δ :=
  ⟨⟨rfl, rfl⟩, fun h => by simpa [onlyEmpty] using h [(true, 0)] []⟩

end Silmaril.Consequence.Gentzen.Calculus.Examples
