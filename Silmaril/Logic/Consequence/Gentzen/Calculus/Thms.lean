module

public import Silmaril.Logic.Consequence.Gentzen.Calculus.Defs
import Silmaril.Proofs.Logic.Consequence.Gentzen.Calculus

/-!
# Bundled Gentzen calculi: lattice laws, restrictions, negation profiles

* Lattice of calculi: meets are pointwise (`coe_inf`, `coe_sInf`), joins are the closure of the
  union (`coe_sup`, `coe_sSup`); `Calculus.of` is the left adjoint (`of_le_iff`).
* Restrictions and their converses: `toUnsat_viaUnsat`, `toTaut_viaTauto`; core
  `single_rightExt` covers single conclusions.
* Negation profiles, for a calculus closed under the default rules (reflexivity, `⊆`-weakening on
  both sides, cut), with an arbitrary function `neg` (no involution assumed):
  `negL_inv` (from `NegR`) and `negR_inv` (from `NegL`) invert the rules, and with both rules
  `iff_toUnsat` (`Γ ⊢ Δ` iff `Γ, neg Δ ⊢`) and `iff_toTaut` (iff `⊢ neg Γ, Δ`), i.e.
  `eq_viaUnsat_toUnsat`, `eq_viaTauto_toTaut`.
* Without negation rules these fail: the calculus generated by nothing derives exactly the
  sequents with a shared formula (`identity_iff_overlap`), so it has `p ⊢ p` but not `p, neg p ⊢`
  (`Silmaril.Logic.Consequence.Gentzen.Calculus.Examples`).
* `Valid sat` has `NegL` under `NegSound` (`valid_negL`) and `NegR` under `NegComplete`
  (`valid_negR`), recovering `valid_iff_unsat` and `valid_iff_taut` from the rules.
* Triviality: with weakening on both sides, `[] ⊢ []` holds iff every sequent does
  (`empty_iff_universal`); hence `toUnsat S` and `toTaut S` are universal iff they accept `[]`.
  Without weakening this fails (`Examples`).
-/

@[expose] public section

namespace Silmaril.Consequence.Gentzen

universe u

variable {C : Type u}

/-! ## The lattice of calculi -/

namespace Calculus

variable {rs : Rules C}

theorem coe_of (S : Seq C) : ((Calculus.of rs S : Calculus rs) : Seq C) = Derives rs S := rfl

theorem of_le_iff {S : Seq C} {T : Calculus rs} : Calculus.of rs S ≤ T ↔ S ≤ (T : Seq C) :=
  (closure rs).gi.gc S T

theorem coe_inf (a b : Calculus rs) : ((a ⊓ b : Calculus rs) : Seq C) = (a : Seq C) ⊓ b := rfl

theorem coe_sup (a b : Calculus rs) :
    ((a ⊔ b : Calculus rs) : Seq C) = Derives rs ((a : Seq C) ⊔ b) := rfl

theorem coe_sInf (s : Set (Calculus rs)) :
    ((sInf s : Calculus rs) : Seq C) = sInf (Subtype.val '' s) := rfl

theorem coe_sSup (s : Set (Calculus rs)) :
    ((sSup s : Calculus rs) : Seq C) = Derives rs (sSup (Subtype.val '' s)) := rfl

end Calculus

/-! ## Restrictions -/

theorem toUnsat_viaUnsat (check : List C → Prop) (neg : C → C) :
    toUnsat (viaUnsat check neg) = check := by
  funext Γ; simp [toUnsat, viaUnsat]

theorem toTaut_viaTauto (taut : List C → Prop) (neg : C → C) :
    toTaut (viaTauto taut neg) = taut := by
  funext Δ; simp [toTaut, viaTauto]

theorem empty_iff_universal {S : Seq C} (hw : WeakSubset S) : S [] [] ↔ ∀ Γ Δ, S Γ Δ :=
  Proofs.Logic.Consequence.Gentzen.Calculus.empty_iff_universal hw

theorem toUnsat_universal_iff {S : Seq C} (hw : WeakSubset S) :
    (∀ Γ, toUnsat S Γ) ↔ toUnsat S [] :=
  ⟨fun h => h [], fun h Γ => (empty_iff_universal hw).1 h Γ []⟩

theorem toTaut_universal_iff {S : Seq C} (hw : WeakSubset S) :
    (∀ Δ, toTaut S Δ) ↔ toTaut S [] :=
  ⟨fun h => h [], fun h Δ => (empty_iff_universal hw).1 h [] Δ⟩

/-! ## Negation profiles -/

variable {S : Seq C} {neg : C → C}

theorem negL_inv (hS : Closed defaultRules S) (hR : NegR neg S) {Γ Δ : List C} {d : C}
    (h : S (neg d :: Γ) Δ) : S Γ (d :: Δ) :=
  Proofs.Logic.Consequence.Gentzen.Calculus.negL_inv hS hR h

theorem negR_inv (hS : Closed defaultRules S) (hL : NegL neg S) {Γ Δ : List C} {g : C}
    (h : S Γ (neg g :: Δ)) : S (g :: Γ) Δ :=
  Proofs.Logic.Consequence.Gentzen.Calculus.negR_inv hS hL h

theorem iff_toUnsat (hS : Closed defaultRules S) (hL : NegL neg S) (hR : NegR neg S)
    (Γ Δ : List C) : S Γ Δ ↔ toUnsat S (Γ ++ Δ.map neg) :=
  Proofs.Logic.Consequence.Gentzen.Calculus.iff_toUnsat hS hL hR Γ Δ

theorem iff_toTaut (hS : Closed defaultRules S) (hL : NegL neg S) (hR : NegR neg S)
    (Γ Δ : List C) : S Γ Δ ↔ toTaut S (Γ.map neg ++ Δ) :=
  Proofs.Logic.Consequence.Gentzen.Calculus.iff_toTaut hS hL hR Γ Δ

/-- A calculus with both negation rules is the raw refutation relation of its own restriction. -/
theorem eq_viaUnsat_toUnsat (hS : Closed defaultRules S) (hL : NegL neg S) (hR : NegR neg S) :
    S = viaUnsat (toUnsat S) neg := by
  funext Γ Δ; exact propext (iff_toUnsat hS hL hR Γ Δ)

theorem eq_viaTauto_toTaut (hS : Closed defaultRules S) (hL : NegL neg S) (hR : NegR neg S) :
    S = viaTauto (toTaut S) neg := by
  funext Γ Δ; exact propext (iff_toTaut hS hL hR Γ Δ)

/-- The calculus of pure identity derives exactly the sequents sharing a formula. -/
theorem identity_iff_overlap {Γ Δ : List C} :
    Derives defaultRules (⊥ : Seq C) Γ Δ ↔ ∃ x ∈ Γ, x ∈ Δ :=
  Proofs.Logic.Consequence.Gentzen.Calculus.identity_iff_overlap

/-! ## Semantic validity has both negation rules under the exact negation laws -/

variable {M : Type*} {sat : M → C → Prop}

theorem valid_negL (hn : NegSound sat neg) : NegL neg (Valid sat) :=
  Proofs.Logic.Consequence.Gentzen.Calculus.valid_negL hn

theorem valid_negR (hn : NegComplete sat neg) : NegR neg (Valid sat) :=
  Proofs.Logic.Consequence.Gentzen.Calculus.valid_negR hn

end Silmaril.Consequence.Gentzen
