module

public import Silmaril.Logic.Consequence.Gentzen.Thms
public import Silmaril.Logic.Consequence.Multi.Defs

/-!
# Bundled Gentzen calculi, restrictions, and negation profiles

* `Calculus rs`: a sequent relation bundled with its proof of `Closed rs`, as the closed
  elements of the Mathlib closure operator `closure rs` (`Silmaril.Logic.Consequence.Gentzen`).
  They form a complete lattice in which meets are pointwise and the join of calculi is the
  closure of their union (`…Calculus.Thms`). `Calculus.of rs S` is the calculus generated by `S`.
* Restrictions of a multiple-conclusion relation: `toUnsat S Γ := S Γ []` (refutation),
  `toTaut S Δ := S [] Δ` (tautology); the single-conclusion restriction is core
  `MultiSystem.single`. Their converses are the existing `viaUnsat`, `viaTauto` and core
  `rightExt`.
* Negation profiles, for an explicit function `neg : C → C`, as rules of the calculus (not
  semantic laws): `NegL` (a succedent `d` moves to the antecedent as `neg d`) and `NegR` (an
  antecedent `g` moves to the succedent as `neg g`). Their inverses are *derived* from
  reflexivity, cut and weakening (`…Calculus.Thms`); no involution of `neg` is used.
-/

@[expose] public section

namespace Silmaril.Consequence.Gentzen

universe u

variable {C : Type u}

/-- A calculus: a sequent relation closed under the rules `rs`. -/
abbrev Calculus (rs : Rules C) : Type u := (closure rs).Closeds

/-- The calculus generated by `S`. -/
def Calculus.of (rs : Rules C) (S : Seq C) : Calculus rs := (closure rs).toCloseds S

/-- Calculi under `rs` form a complete lattice (closed elements of a closure operator). -/
instance (rs : Rules C) : CompleteLattice (Calculus rs) := (closure rs).gi.liftCompleteLattice

/-- The refutation restriction: `Γ ⊢ []`. -/
def toUnsat (S : Seq C) (Γ : List C) : Prop := S Γ []

/-- The tautology restriction: `[] ⊢ Δ`. -/
def toTaut (S : Seq C) (Δ : List C) : Prop := S [] Δ

/-- Left negation rule: from `Γ ⊢ d, Δ` infer `neg d, Γ ⊢ Δ`. -/
def NegL (neg : C → C) (S : Seq C) : Prop := ∀ ⦃Γ Δ d⦄, S Γ (d :: Δ) → S (neg d :: Γ) Δ

/-- Right negation rule: from `g, Γ ⊢ Δ` infer `Γ ⊢ neg g, Δ`. -/
def NegR (neg : C → C) (S : Seq C) : Prop := ∀ ⦃Γ Δ g⦄, S (g :: Γ) Δ → S Γ (neg g :: Δ)

end Silmaril.Consequence.Gentzen
