module

public import Silmaril.Logic.TypeTheory.ExtensionalMLTT.Inductives.Encoding.W.Induction.Indexed.Thms

@[expose] public section

/-! # An admissible indexed-W rule presentation

These explicit indexed judgments elaborate to the existing W/equality grammar.
The source formation, constructor, dependent eliminator and computation rules
consume source premise derivations. They are closed-theory contextual rules:
free variables in the ambient context are allowed. No constructor stores a W
proof of the indexed conclusion. This is a derived-rule presentation, not an
independent primitive indexed term grammar.
-/

namespace Silmaril.Logic.TypeTheory.ExtensionalMLTT.Inductives.Indexed

open W WEncoding.Terms

/-- Explicit indexed inference judgments, alongside the ordinary object language. -/
inductive Judgment where
  | ordinary (j : W.Jdg)
  | family (S : Description) (n : ℕ) (Γ : Ctx) (i : Tm 0)
  | node (S : Description) (n : ℕ) (Γ : Ctx) (i a children : Tm 0)
  | eliminate (S : Description) (n m : ℕ) (Γ : Ctx) (C step i value : Tm 0)
  | compute (S : Description) (n m : ℕ) (Γ : Ctx) (C step i a children : Tm 0)

/-- Translate the full indexed judgment, including the actual dependent iota equation. -/
def Judgment.encode : Judgment → W.Jdg
  | .ordinary j => j
  | .family S n Γ i => ⟨Γ, .univ n, S.fibre n i, S.fibre n i⟩
  | .node S n Γ i a f => ⟨Γ, S.fibre n i, S.node i a f, S.node i a f⟩
  | .eliminate S n _ Γ C s i t =>
      ⟨Γ, .app (.app C i) t, S.indexedInduction n C s t, S.indexedInduction n C s t⟩
  | .compute S n _ Γ C s i a f =>
      ⟨Γ, .app (.app C i) (S.node i a f), S.indexedInduction n C s (S.node i a f),
        .app (.app (.app (.app s i) a) f) (S.indexedHypotheses n C s i a f)⟩

/-- Retain source universe annotations and every description field, even if elaboration erases them. -/
def Judgment.annotationBound : Judgment → ℕ
  | .ordinary _ => 0
  | .family S n _ _ | .node S n _ _ _ _ => max S.universeBound (n + 1)
  | .eliminate S n m _ _ _ _ _ | .compute S n m _ _ _ _ _ _ =>
      max S.universeBound (max (n + 1) (m + 1))

def Judgment.universeBound (j : Judgment) : ℕ := max j.encode.universeBound j.annotationBound

def Judgment.UsesBelow (j : Judgment) (levels : ℕ) : Prop := j.universeBound ≤ levels

/-- Actual source rule derivations. The closed theory is essential to the available
context-weakening proofs; the ambient free-variable context remains arbitrary. -/
inductive Derivation (levels : ℕ) : Judgment → Prop where
  | ordinary {j : W.Jdg} (d : Ctx.JEqB levels ∅ j.Γ j.A j.a j.b) :
      Derivation levels (.ordinary j)
  | expose {j : Judgment} (d : Derivation levels j) :
      Derivation levels (.ordinary j.encode)
  | family {S : Description} {n : ℕ} {Γ : Ctx} {i : Tm 0}
      (D : IndexedFormationData S levels n Γ)
      (hi : Derivation levels (.ordinary ⟨Γ, S.index, i, i⟩)) :
      Derivation levels (.family S n Γ i)
  | node {S : Description} {n : ℕ} {Γ : Ctx} {i a f : Tm 0}
      (D : IndexedFormationData S levels n Γ)
      (hi : Derivation levels (.ordinary ⟨Γ, S.index, i, i⟩))
      (ha : Derivation levels (.ordinary ⟨Γ, S.shape.lst i, a, a⟩))
      (hf : Derivation levels (.ordinary
        ⟨Γ, .pi (S.positionAt i a) (S.childFibres n (.pair i a)), f, f⟩)) :
      Derivation levels (.node S n Γ i a f)
  | eliminate {S : Description} {n m : ℕ} {Γ : Ctx} {C s i t : Tm 0}
      (D : IndexedFormationData S levels n Γ) (hm : m + 1 < levels)
      (hC : Derivation levels (.ordinary ⟨Γ, S.motiveType n m, C, C⟩))
      (hs : Derivation levels (.ordinary ⟨Γ, S.indexedStepType n C, s, s⟩))
      (hi : Derivation levels (.ordinary ⟨Γ, S.index, i, i⟩))
      (ht : Derivation levels (.ordinary ⟨Γ, S.fibre n i, t, t⟩)) :
      Derivation levels (.eliminate S n m Γ C s i t)
  | compute {S : Description} {n m : ℕ} {Γ : Ctx} {C s i a f : Tm 0}
      (D : IndexedFormationData S levels n Γ) (hm : m + 1 < levels)
      (hC : Derivation levels (.ordinary ⟨Γ, S.motiveType n m, C, C⟩))
      (hs : Derivation levels (.ordinary ⟨Γ, S.indexedStepType n C, s, s⟩))
      (hi : Derivation levels (.ordinary ⟨Γ, S.index, i, i⟩))
      (ha : Derivation levels (.ordinary ⟨Γ, S.shape.lst i, a, a⟩))
      (hf : Derivation levels (.ordinary
        ⟨Γ, .pi (S.positionAt i a) (S.fibreAt n ((S.next.lst i).lst a)), f, f⟩)) :
      Derivation levels (.compute S n m Γ C s i a f)

/-- Consequence generated by theory leaves, ordinary W inference, and the proved
closed-theory indexed rules. This does not generalize indexed context weakening
under arbitrary judgment hypotheses. -/
inductive Consequence (levels : ℕ) (H : Set Judgment) : Judgment → Prop where
  | hyp {j} (hj : j ∈ H) : Consequence levels H j
  | ordinary {j : W.Jdg} (d : Ctx.JEqB levels (Judgment.encode '' H) j.Γ j.A j.a j.b) :
      Consequence levels H (.ordinary j)
  | indexed {j} (d : Derivation levels j) : Consequence levels H j

end Silmaril.Logic.TypeTheory.ExtensionalMLTT.Inductives.Indexed
