module

public import Silmaril.Logic.TypeTheory.CIC.Productivity.Defs

@[expose] public section

/-! # Declarative CIC typing through dependent elimination

This typing layer implements PCUIC's sort, product, function, let, application,
constant, inductive-reference, constructor, dependent case, projection and
structurally guarded fix and productive cofix rules. Variance-aware
cumulativity and SProp conversion remain separate work. Typing is relative to a
raw signature; declaration checking is a separate requirement.
-/

namespace Silmaril.Logic.TypeTheory.CIC

universe u

/-- A raw global environment extended by local universe parameters and constraints. -/
structure GlobalContext where
  environment : GlobalEnv
  localParameters : ℕ := 0
  localConstraints : List UniverseConstraint := []
  deriving Repr

/-- Universe scoping uses declared global names and a finite local parameter supply. -/
def GlobalContext.AllowsLevel (sig : GlobalContext) : LevelName → Prop
  | .global g => g ∈ sig.environment.globalLevels
  | .parameter i => i < sig.localParameters

def UniverseExpr.AllNames {Level : Type u} (P : Level → Prop) : UniverseExpr Level → Prop
  | .zero => True
  | .level l => P l
  | .succ a => AllNames P a
  | .max a b => AllNames P a ∧ AllNames P b

def GlobalContext.AllowsUniverse (sig : GlobalContext) (a : Universe) : Prop :=
  a.AllNames sig.AllowsLevel

def GlobalContext.AllowsSort (sig : GlobalContext) : SortExpr LevelName → Prop
  | .prop | .sprop => True
  | .type a => sig.AllowsUniverse a

/-- Models of the current universe constraints. Raw contexts need not have one. -/
def GlobalContext.Satisfies (sig : GlobalContext) (ρ : LevelName → ℕ) : Prop :=
  (∀ c ∈ sig.environment.constraints, c.Holds ρ) ∧
  ∀ c ∈ sig.localConstraints, c.Holds ρ

/-- Numerical semantic entailment; no algorithmic constraint checker is assumed. -/
def GlobalContext.Entails (sig : GlobalContext) (c : UniverseConstraint) : Prop :=
  ∀ ρ, sig.Satisfies ρ → c.Holds ρ

def UniverseConstraint.subst (σ : LevelName → Universe) (c : UniverseConstraint) :
    UniverseConstraint :=
  { c with left := c.left.subst σ, right := c.right.subst σ }

/-- Instance scope, atomicity, length and declared constraints are all explicit. -/
def GlobalContext.ValidInstance (sig : GlobalContext) (decl : UniverseDeclaration)
    (ui : List Universe) : Prop :=
  (∀ a ∈ ui, a.IsAtomic ∧ sig.AllowsUniverse a) ∧
  match decl with
  | .monomorphic constraints => ui = [] ∧ ∀ c ∈ constraints, sig.Entails c
  | .polymorphic count constraints => ui.length = count ∧
      ∀ c ∈ constraints, sig.Entails (c.subst (instanceSubstitution ui))

/-- SProp binders are irrelevant; Prop and Type binders are relevant in this profile. -/
def SortExpr.HasRelevance (s : SortExpr LevelName) (r : Relevance) : Prop :=
  match s with
  | .sprop => r = .irrelevant
  | .prop | .type _ => r = .relevant

/-- Raw conversion generated by the stated operational rules, including symmetry. -/
abbrev Conversion (env : GlobalEnv) (Γ : Context) := Relation.EqvGen (Step env Γ)

/-- Cumulativity of sorts and products, closed under raw conversion and transitivity.

This fragment does not yet include variance-aware inductive cumulativity or
typed SProp proof irrelevance. Those must not be inferred from this definition.
-/
inductive CoreCumul (sig : GlobalContext) : Context → Expr → Expr → Prop where
  | conversion {Γ A B} : Conversion sig.environment Γ A B → CoreCumul sig Γ A B
  | sort {Γ a b} : (∀ ρ, sig.Satisfies ρ → a.Cumul ρ b) →
      CoreCumul sig Γ (.sort a) (.sort b)
  | product {Γ na A A' B B'} : Conversion sig.environment Γ A A' →
      CoreCumul sig ({ binder := na, type := A } :: Γ) B B' →
      CoreCumul sig Γ (.prod na A B) (.prod na A' B')
  | trans {Γ A B C} : CoreCumul sig Γ A B → CoreCumul sig Γ B C → CoreCumul sig Γ A C

def constructorType (reference : InductiveRef) (ui : List Universe)
    (block : MutualInductiveBody) (constructor : ConstructorBody) : Expr :=
  (Expr.instantiate ui constructor.type).subst
    (inductiveSubstitution reference.block ui block.bodies) 0

mutual

/-- Declarative PCUIC typing through dependent elimination, relative to a raw signature. -/
inductive CoreTyping (sig : GlobalContext) : Context → Expr → Expr → Prop where
  | rel {Γ : Context} {n : ℕ} {decl : ContextDecl Expr} :
      CoreWfLocal sig Γ → Γ[n]? = some decl →
      CoreTyping sig Γ (.rel n) (decl.type.lift (n + 1) 0)
  | sort {Γ : Context} {s : SortExpr LevelName} :
      CoreWfLocal sig Γ → sig.AllowsSort s →
      CoreTyping sig Γ (.sort s) (.sort s.super)
  | product {Γ : Context} {na : Binder} {A B : Expr} {s1 s2 : SortExpr LevelName} :
      CoreTyping sig Γ A (.sort s1) → s1.HasRelevance na.relevance →
      CoreTyping sig ({ binder := na, type := A } :: Γ) B (.sort s2) →
      CoreTyping sig Γ (.prod na A B) (.sort (s1.product s2))
  | lambda {Γ : Context} {na : Binder} {A body B : Expr} {s : SortExpr LevelName} :
      CoreTyping sig Γ A (.sort s) → s.HasRelevance na.relevance →
      CoreTyping sig ({ binder := na, type := A } :: Γ) body B →
      CoreTyping sig Γ (.lam na A body) (.prod na A B)
  | letIn {Γ : Context} {na : Binder} {value A body B : Expr} {s : SortExpr LevelName} :
      CoreTyping sig Γ A (.sort s) → s.HasRelevance na.relevance →
      CoreTyping sig Γ value A →
      CoreTyping sig ({ binder := na, type := A, value := some value } :: Γ) body B →
      CoreTyping sig Γ (.letIn na value A body) (.letIn na value A B)
  | app {Γ : Context} {na : Binder} {A B function argument : Expr} {s : SortExpr LevelName} :
      CoreTyping sig Γ (.prod na A B) (.sort s) →
      CoreTyping sig Γ function (.prod na A B) → CoreTyping sig Γ argument A →
      CoreTyping sig Γ (.app function argument) (B.subst [argument] 0)
  | constant {Γ : Context} {name : String} {ui : List Universe} {decl : ConstantBody} :
      CoreWfLocal sig Γ → sig.environment.lookupConstant name = some decl →
      sig.ValidInstance decl.universes ui →
      CoreTyping sig Γ (.constant name ui) (Expr.instantiate ui decl.type)
  | inductiveType {Γ : Context} {reference : InductiveRef} {ui : List Universe}
      {block : MutualInductiveBody} {body : InductiveBody} :
      CoreWfLocal sig Γ → sig.environment.lookupInductive reference = some (block, body) →
      sig.ValidInstance block.universes ui →
      CoreTyping sig Γ (.inductiveType reference ui) (Expr.instantiate ui body.type)
  | constructor {Γ : Context} {reference : InductiveRef} {index : ℕ} {ui : List Universe}
      {block : MutualInductiveBody} {body : InductiveBody} {constructor : ConstructorBody} :
      CoreWfLocal sig Γ →
      sig.environment.lookupConstructor reference index = some (block, body, constructor) →
      sig.ValidInstance block.universes ui →
      CoreTyping sig Γ (.constructor reference index ui) (constructorType reference ui block constructor)
  | caseOf {Γ : Context} {ci : CaseInfo} {p : Predicate Expr LevelName} {scrutinee : Expr}
      {branches : List (Branch Expr)} {indices : List Expr} {ps : SortExpr LevelName}
      {block : MutualInductiveBody} {body : InductiveBody} :
      sig.environment.lookupInductive ci.inductiveRef = some (block, body) →
      CoreTyping sig (casePredicateContext ci.inductiveRef block body p ++ Γ)
        p.returnType (.sort ps) →
      CoreTyping sig Γ scrutinee
        (Expr.mkApps (.inductiveType ci.inductiveRef p.universeInstance) (p.parameters ++ indices)) →
      p.parameters.length = block.parameterCount → block.parameterCount = ci.parameterCount →
      sig.ValidInstance block.universes p.universeInstance →
      CoreWfLocal sig (casePredicateContext ci.inductiveRef block body p ++ Γ) →
      (Context.withoutNames p.context) = (predicateDeclarationContext ci.inductiveRef block body).withoutNames →
      (∀ ρ, sig.Satisfies ρ → body.elimination.Allows ρ ps) →
      ps.HasRelevance ci.relevance →
      CoreContextInstance sig Γ (p.parameters ++ indices)
        (Context.instantiate p.universeInstance (body.indices ++ block.parameters)).reverse →
      block.recursivity ≠ .cofinite → branches.length = body.constructors.length →
      (∀ (index : ℕ) (constructor : ConstructorBody) (branch : Branch Expr),
        body.constructors[index]? = some constructor → branches[index]? = some branch →
        (Context.withoutNames branch.context) =
          (branchDeclarationContext ci.inductiveRef block constructor).withoutNames) →
      (∀ (index : ℕ) (constructor : ConstructorBody) (branch : Branch Expr),
        body.constructors[index]? = some constructor → branches[index]? = some branch →
        CoreWfLocal sig (caseBranchContext ci.inductiveRef block constructor p branch ++ Γ)) →
      (∀ (index : ℕ) (constructor : ConstructorBody) (branch : Branch Expr),
        body.constructors[index]? = some constructor → branches[index]? = some branch →
        CoreTyping sig (caseBranchContext ci.inductiveRef block constructor p branch ++ Γ)
          branch.body (caseBranchType ci.inductiveRef block constructor p
            ((casePredicateContext ci.inductiveRef block body p).abstractLambdas p.returnType) index)) →
      (∀ (index : ℕ) (constructor : ConstructorBody) (branch : Branch Expr),
        body.constructors[index]? = some constructor → branches[index]? = some branch →
        CoreTyping sig (caseBranchContext ci.inductiveRef block constructor p branch ++ Γ)
          (caseBranchType ci.inductiveRef block constructor p
            ((casePredicateContext ci.inductiveRef block body p).abstractLambdas p.returnType) index)
          (.sort ps)) →
      CoreTyping sig Γ (.caseOf ci p scrutinee branches)
        (Expr.mkApps ((casePredicateContext ci.inductiveRef block body p).abstractLambdas p.returnType)
          (indices ++ [scrutinee]))
  | projection {Γ : Context} {reference : ProjectionRef} {scrutinee : Expr}
      {ui : List Universe} {args : List Expr} {block : MutualInductiveBody}
      {body : InductiveBody} {constructor : ConstructorBody} {projection : ProjectionBody} :
      sig.environment.lookupProjection reference = some (block, body, constructor, projection) →
      block.parameterCount = reference.parameterCount →
      CoreTyping sig Γ scrutinee (Expr.mkApps (.inductiveType reference.inductiveRef ui) args) →
      args.length = block.parameterCount →
      CoreTyping sig Γ (.projection reference scrutinee)
        ((Expr.instantiate ui projection.type).subst (scrutinee :: args.reverse) 0)
  | fix {Γ : Context} {definitions : List (FixDef Expr)} {index : ℕ} {definition : FixDef Expr} :
      CoreWfLocal sig Γ → StructuralFix sig.environment Γ definitions →
      definitions[index]? = some definition → CoreFixTypes sig Γ definitions →
      CoreFixBodies sig Γ definitions definitions →
      CoreTyping sig Γ (.fix definitions index) definition.type
  | cofix {Γ : Context} {definitions : List (FixDef Expr)} {index : ℕ} {definition : FixDef Expr} :
      CoreWfLocal sig Γ → ProductiveCoFix sig.environment Γ definitions →
      definitions[index]? = some definition → CoreFixTypes sig Γ definitions →
      CoreFixBodies sig Γ definitions definitions →
      CoreTyping sig Γ (.cofix definitions index) definition.type
  | cumul {Γ : Context} {t A B : Expr} {s : SortExpr LevelName} :
      CoreTyping sig Γ t A → CoreTyping sig Γ B (.sort s) → CoreCumul sig Γ A B →
      CoreTyping sig Γ t B

/-- Local context formation is checked by the same typing relation, not assumed in a record. -/
inductive CoreWfLocal (sig : GlobalContext) : Context → Prop where
  | nil : CoreWfLocal sig []
  | assumption {Γ : Context} {na : Binder} {A : Expr} {s : SortExpr LevelName} :
      CoreWfLocal sig Γ → CoreTyping sig Γ A (.sort s) → s.HasRelevance na.relevance →
      CoreWfLocal sig ({ binder := na, type := A } :: Γ)
  | definition {Γ : Context} {na : Binder} {value A : Expr} {s : SortExpr LevelName} :
      CoreWfLocal sig Γ → CoreTyping sig Γ A (.sort s) → s.HasRelevance na.relevance →
      CoreTyping sig Γ value A →
      CoreWfLocal sig ({ binder := na, type := A, value := some value } :: Γ)

/-- Typed substitutions into an oldest-first dependent telescope, including local definitions. -/
inductive CoreContextInstance (sig : GlobalContext) : Context → List Expr → Context → Prop where
  | nil {Γ} : CoreContextInstance sig Γ [] []
  | assumption {Γ na A argument args Δ} : CoreTyping sig Γ argument A →
      CoreContextInstance sig Γ args (Context.substTelescope [argument] 0 Δ) →
      CoreContextInstance sig Γ (argument :: args) ({ binder := na, type := A } :: Δ)
  | definition {Γ na value A args Δ} :
      CoreContextInstance sig Γ args (Context.substTelescope [value] 0 Δ) →
      CoreContextInstance sig Γ args ({ binder := na, type := A, value := some value } :: Δ)

/-- Every recursive signature is typed and its binder relevance agrees with its sort. -/
inductive CoreFixTypes (sig : GlobalContext) : Context → List (FixDef Expr) → Prop where
  | nil {Γ} : CoreFixTypes sig Γ []
  | cons {Γ definition definitions s} :
      CoreTyping sig Γ definition.type (.sort s) → s.HasRelevance definition.binder.relevance →
      CoreFixTypes sig Γ definitions → CoreFixTypes sig Γ (definition :: definitions)

/-- Recursive bodies are typed in the full mutually recursive context at lifted signature types. -/
inductive CoreFixBodies (sig : GlobalContext) : Context → List (FixDef Expr) → List (FixDef Expr) → Prop where
  | nil {Γ definitions} : CoreFixBodies sig Γ definitions []
  | cons {Γ definitions definition remaining} :
      CoreTyping sig (fixContext definitions ++ Γ) definition.body
        (definition.type.lift definitions.length 0) →
      CoreFixBodies sig Γ definitions remaining →
      CoreFixBodies sig Γ definitions (definition :: remaining)

end

end Silmaril.Logic.TypeTheory.CIC
