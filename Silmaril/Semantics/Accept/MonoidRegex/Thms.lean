module

public import Silmaril.Semantics.Accept.MonoidRegex.Defs
public import Mathlib.Algebra.Group.Submonoid.Membership
public import Mathlib.Algebra.Group.Pointwise.Set.Basic
import Silmaril.Proofs.Semantics.Accept.MonoidRegex.Basic

/-!
# Regular expressions over a monoid: laws

* membership: `mem_prod`, `mem_star`, and one `@[simp]` evaluation law per constructor;
* the operators are the standard ones: `prod_eq_mul` (Mathlib's pointwise product) and
  `star_eq_closure` (the submonoid generated by the language), with `one_mem_star`,
  `subset_star`, `mul_mem_star`;
* **monotonicity** `eval_mono` and **substitution** `eval_bind`;
* **the list case**: `eval_ofRegex` — over the free monoid, the language of `ofRegex e` is
  the existing `Silmaril.Accept.Regex.Expr.eval` of `e`, transported along
  `FreeMonoid.toList`; `mem_eval_ofRegex` states it for one word.
-/

@[expose] public section

namespace Silmaril.Accept.MonoidRegex

open scoped Computability

universe u v w

variable {M : Type u} [Monoid M] {ι : Type v} {κ : Type w}

theorem mem_prod {L K : Set M} {x : M} : x ∈ prod L K ↔ ∃ a ∈ L, ∃ b ∈ K, a * b = x := Iff.rfl

theorem mem_star {L : Set M} {x : M} : x ∈ star L ↔ ∃ l : List M, (∀ y ∈ l, y ∈ L) ∧ l.prod = x :=
  Iff.rfl

open Pointwise in
/-- `prod` is Mathlib's pointwise product of sets. -/
theorem prod_eq_mul (L K : Set M) : prod L K = L * K := Set.ext fun _ => Set.mem_mul.symm

theorem one_mem_star (L : Set M) : (1 : M) ∈ star L :=
  Silmaril.Proofs.Semantics.Accept.MonoidRegex.one_mem_star L

theorem subset_star (L : Set M) : L ⊆ star L :=
  Silmaril.Proofs.Semantics.Accept.MonoidRegex.subset_star L

theorem mul_mem_star {L : Set M} {x y : M} (hx : x ∈ star L) (hy : y ∈ star L) :
    x * y ∈ star L :=
  Silmaril.Proofs.Semantics.Accept.MonoidRegex.mul_mem_star hx hy

/-- **The star is the generated submonoid.** -/
theorem star_eq_closure (L : Set M) : star L = (Submonoid.closure L : Set M) :=
  Silmaril.Proofs.Semantics.Accept.MonoidRegex.star_eq_closure L

namespace Expr

variable {ρ : ι → Set M}

@[simp] theorem eval_zero : eval ρ (zero : Expr ι M) = ∅ := rfl
@[simp] theorem eval_one : eval ρ (one : Expr ι M) = {1} := rfl
@[simp] theorem eval_atom (a : M) : eval ρ (atom a : Expr ι M) = {a} := rfl
@[simp] theorem eval_cls (p : M → Bool) : eval ρ (cls p : Expr ι M) = {a | p a = true} := rfl
@[simp] theorem eval_leaf (i : ι) : eval ρ (leaf i : Expr ι M) = ρ i := rfl
@[simp] theorem eval_plus (e f : Expr ι M) : eval ρ (plus e f) = eval ρ e ∪ eval ρ f := rfl
@[simp] theorem eval_comp (e f : Expr ι M) :
    eval ρ (comp e f) = MonoidRegex.prod (eval ρ e) (eval ρ f) := rfl
@[simp] theorem eval_star (e : Expr ι M) : eval ρ (star e) = MonoidRegex.star (eval ρ e) := rfl

/-- **Monotonicity** in the leaf languages. -/
theorem eval_mono {ρ σ : ι → Set M} (h : ∀ i, ρ i ⊆ σ i) (e : Expr ι M) :
    eval ρ e ⊆ eval σ e :=
  Silmaril.Proofs.Semantics.Accept.MonoidRegex.eval_mono h e

/-- **Substitution** evaluates compositionally. -/
theorem eval_bind (ρ : κ → Set M) (σ : ι → Expr κ M) (e : Expr ι M) :
    eval ρ (bind σ e) = eval (fun i => eval ρ (σ i)) e :=
  Silmaril.Proofs.Semantics.Accept.MonoidRegex.eval_bind ρ σ e

/-- **The list case is the existing semantics**: over the free monoid on `α`, `ofRegex e`
denotes the words of `Silmaril.Accept.Regex.Expr.eval ρ e`. -/
theorem eval_ofRegex {α : Type u} (ρ : ι → Language α) (e : Silmaril.Accept.Regex.Expr ι α) :
    eval (fun i => FreeMonoid.toList ⁻¹' ρ i) (ofRegex e) =
      FreeMonoid.toList ⁻¹' Silmaril.Accept.Regex.Expr.eval ρ e :=
  Silmaril.Proofs.Semantics.Accept.MonoidRegex.eval_ofRegex ρ e

theorem mem_eval_ofRegex {α : Type u} (ρ : ι → Language α) (e : Silmaril.Accept.Regex.Expr ι α)
    (w : List α) :
    FreeMonoid.ofList w ∈ eval (fun i => FreeMonoid.toList ⁻¹' ρ i) (ofRegex e) ↔
      w ∈ Silmaril.Accept.Regex.Expr.eval ρ e := by
  rw [eval_ofRegex]; rfl

end Expr

end Silmaril.Accept.MonoidRegex
