module

public import Silmaril.Semantics.Accept.Regex.Defs
public import Mathlib.Algebra.FreeMonoid.Basic

/-!
# Regular expressions over a monoid

`Silmaril.Accept.Regex` presents languages over an alphabet, `Language α = Set (List α)`. A
regular expression only needs a monoid: a unit, a product and finite products. This file
states the semantics for any monoid `M`, so that the same expression syntax presents
languages of byte strings, of Unicode scalar strings, of natural numbers under addition
(`Multiplicative ℕ`), or of any other monoid of observations.

A language over `M` is a set `Set M`. The operators are:

| expression | language over `M` |
|---|---|
| `zero` | `∅` |
| `one` | `{1}` |
| `atom a` | `{a}` |
| `cls p` | `{a ∣ p a = true}` (a set of generators given by a Bool test) |
| `leaf i` | `ρ i`, an arbitrary language supplied by the environment |
| `plus e f` | `eval e ∪ eval f` |
| `comp e f` | `prod (eval e) (eval f) = {a * b ∣ a ∈ eval e, b ∈ eval f}` |
| `star e` | `star (eval e)`: products of finite lists of members |

`star L` is defined explicitly as the products of finite lists of members of `L` (so the
empty product `1` is always a member). `Thms` shows it is the carrier of the submonoid
generated by `L` (`star_eq_closure`), and that `prod` is the pointwise product of
`Mathlib.Algebra.Group.Pointwise` (`prod_eq_mul`).

**The list case is the existing one.** `Expr.ofRegex e` translates a `Regex.Expr ι α` (letters
over `α`) into an expression over the free monoid `FreeMonoid α`: a letter `a` becomes
`atom (FreeMonoid.of a)` and a character class becomes the class of one-letter words. Its
language is the existing `Regex.Expr.eval` transported along `FreeMonoid.toList`
(`Thms`: `eval_ofRegex`), so nothing about the list semantics is re-defined.

As in `Regex`, a leaf is any language: an expression with leaves is a presentation, not a
regularity or decidability certificate.

New definitions (no source); the operators are the standard ones of Kleene algebra over the
powerset of a monoid.
-/

@[expose] public section

namespace Silmaril.Accept.MonoidRegex

universe u v w

variable {M : Type u} [Monoid M]

/-! ## Language operations over a monoid -/

/-- The product of two languages: every `a * b` with `a ∈ L`, `b ∈ K`. -/
def prod (L K : Set M) : Set M := {x | ∃ a ∈ L, ∃ b ∈ K, a * b = x}

/-- The Kleene star of a language: the products of finite lists of members (`1` included, as
the empty product). -/
def star (L : Set M) : Set M := {x | ∃ l : List M, (∀ y ∈ l, y ∈ L) ∧ l.prod = x}

/-! ## Expressions with abstract leaves -/

/-- Regular expressions over a monoid `M`, with leaves `ι` for arbitrary languages. -/
inductive Expr (ι : Type v) (M : Type u) : Type (max u v)
  /-- The empty language. -/
  | zero : Expr ι M
  /-- The unit language `{1}`. -/
  | one : Expr ι M
  /-- A single element. -/
  | atom (a : M) : Expr ι M
  /-- The elements satisfying a Bool test (a class of generators). -/
  | cls (p : M → Bool) : Expr ι M
  /-- An arbitrary language from the environment. -/
  | leaf (i : ι) : Expr ι M
  /-- Union. -/
  | plus (e f : Expr ι M) : Expr ι M
  /-- Product. -/
  | comp (e f : Expr ι M) : Expr ι M
  /-- Kleene star. -/
  | star (e : Expr ι M) : Expr ι M

namespace Expr

variable {ι : Type v} {κ : Type w}

/-- The language of an expression, given the language `ρ i` of each leaf. -/
def eval (ρ : ι → Set M) : Expr ι M → Set M
  | zero => ∅
  | one => {1}
  | atom a => {a}
  | cls p => {a | p a = true}
  | leaf i => ρ i
  | plus e f => eval ρ e ∪ eval ρ f
  | comp e f => MonoidRegex.prod (eval ρ e) (eval ρ f)
  | star e => MonoidRegex.star (eval ρ e)

/-- The leaves that occur in an expression. -/
def leaves : Expr ι M → Set ι
  | zero | one | atom _ | cls _ => ∅
  | leaf i => {i}
  | plus e f | comp e f => leaves e ∪ leaves f
  | star e => leaves e

/-- Substitute the expression `σ i` for each leaf `i`. -/
def bind (σ : ι → Expr κ M) : Expr ι M → Expr κ M
  | zero => zero
  | one => one
  | atom a => atom a
  | cls p => cls p
  | leaf i => σ i
  | plus e f => plus (bind σ e) (bind σ f)
  | comp e f => comp (bind σ e) (bind σ f)
  | star e => star (bind σ e)

/-- The one-letter test of a character class: `w` is a one-letter word whose letter
satisfies `p`. -/
def oneLetter {α : Type u} (p : α → Bool) (w : FreeMonoid α) : Bool :=
  match FreeMonoid.toList w with
  | [a] => p a
  | _ => false

/-- A regular expression over letters `α` (`Silmaril.Accept.Regex.Expr`) as an expression over
the free monoid on `α`: letters are generators, a character class is the class of one-letter
words. -/
def ofRegex {α : Type u} : Silmaril.Accept.Regex.Expr ι α → Expr ι (FreeMonoid α)
  | .zero => zero
  | .one => one
  | .char a => atom (FreeMonoid.of a)
  | .cls p => cls (oneLetter p)
  | .leaf i => leaf i
  | .plus e f => plus (ofRegex e) (ofRegex f)
  | .comp e f => comp (ofRegex e) (ofRegex f)
  | .star e => star (ofRegex e)

end Expr

end Silmaril.Accept.MonoidRegex
