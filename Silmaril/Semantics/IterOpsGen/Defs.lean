module

public import Silmaril.Semantics.IterOps.Defs

/-!
# The sub-structure of a premonoidal Elgot structure generated by a family of homs

Given operations `o : Ops H` and a family of generators `G` (a predicate on every hom type
`H A B`), `Gen o G` is the least family of homs containing `G` and closed under every operation
of `o`: identity, composition, pure maps, copairing, Elgot iteration and whiskering.

`genOps o G` is `o` restricted to it (`GHom o G A B`: the homs of `H A B` in `Gen o G`), and
`genIncl o G : Hom (genOps o G) o` is the inclusion, a faithful, operation-preserving map.
So every law of a lawful `o` holds of the generated sub-structure (`IterOpsGen.Thms`, by
`IterOps.Hom.lawful`): no new category and no new law proof, only the closure.

This is the route for a family of concrete morphisms that is not itself indexed by all types
(for example the denotations of typed code on one configuration type): the generated
sub-structure of a lawful semantic `Ops` is an `Ops`, lawful by transfer.
-/

@[expose] public section

namespace Silmaril.IterOps

universe u w

variable {H : Type u → Type u → Type w}

/-- **The generated homs**: the least family containing the generators `G` and closed under
every operation of `o`. -/
inductive Gen (o : Ops H) (G : ∀ {A B : Type u}, H A B → Prop) : {A B : Type u} → H A B → Prop
  /-- A generator. -/
  | of {A B : Type u} {f : H A B} : G f → Gen o G f
  /-- The identity. -/
  | id (A : Type u) : Gen o G (o.id A)
  /-- Composition. -/
  | comp {A B C : Type u} {f : H A B} {g : H B C} : Gen o G f → Gen o G g → Gen o G (o.comp f g)
  /-- Pure maps. -/
  | pure {A B : Type u} (f : A → B) : Gen o G (o.pure f)
  /-- Copairing. -/
  | case {A B C : Type u} {f : H A C} {g : H B C} : Gen o G f → Gen o G g → Gen o G (o.case f g)
  /-- Elgot iteration. -/
  | iter {A B : Type u} {f : H A (B ⊕ A)} : Gen o G f → Gen o G (o.iter f)
  /-- Whiskering. -/
  | whisker {A B : Type u} (C : Type u) {f : H A B} : Gen o G f → Gen o G (o.whisker C f)

/-- The homs of the generated sub-structure. -/
abbrev GHom (o : Ops H) (G : ∀ {A B : Type u}, H A B → Prop) (A B : Type u) : Type w :=
  {f : H A B // Gen o G f}

/-- **The generated sub-structure**: the operations of `o`, restricted. -/
def genOps (o : Ops H) (G : ∀ {A B : Type u}, H A B → Prop) : Ops (GHom o G) where
  id A := ⟨o.id A, .id A⟩
  comp f g := ⟨o.comp f.1 g.1, .comp f.2 g.2⟩
  pure f := ⟨o.pure f, .pure f⟩
  case f g := ⟨o.case f.1 g.1, .case f.2 g.2⟩
  iter f := ⟨o.iter f.1, .iter f.2⟩
  whisker C f := ⟨o.whisker C f.1, .whisker C f.2⟩

/-- A generator, as a hom of the generated sub-structure. -/
def GHom.ofGen {o : Ops H} {G : ∀ {A B : Type u}, H A B → Prop} {A B : Type u} {f : H A B}
    (h : G f) : GHom o G A B :=
  ⟨f, .of h⟩

/-- **The inclusion** of the generated sub-structure: faithful and operation-preserving. -/
def genIncl (o : Ops H) (G : ∀ {A B : Type u}, H A B → Prop) : Hom (genOps o G) o where
  map f := f.1
  faithful := fun h => Subtype.ext h
  map_id _ := rfl
  map_comp _ _ := rfl
  map_pure _ := rfl
  map_case _ _ := rfl
  map_iter _ := rfl
  map_whisker _ _ := rfl

end Silmaril.IterOps
