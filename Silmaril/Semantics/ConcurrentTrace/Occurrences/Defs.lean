module

public import Silmaril.Semantics.ConcurrentTrace.Defs
public import Mathlib.Logic.Relation

/-! # Occurrence posets of finite concurrent traces -/

@[expose] public section

namespace Silmaril.Semantics.ConcurrentTrace

universe u v

variable {T : Type u} {E : Type v}

/-- A finite labelled strict poset. The finite carrier enumerates occurrences,
including distinct occurrences of equal letters. -/
structure OccurrencePoset (T : Type u) (E : Type v) where
  size : Nat
  label : Fin size → Letter T E
  before : Fin size → Fin size → Prop
  before_irrefl : ∀ i, ¬ before i i
  before_trans : ∀ {i j k}, before i j → before j k → before i k

namespace OccurrencePoset

/-- An arc from an earlier occurrence to a dependent occurrence. -/
def Edge (w : Word T E) (i j : Fin w.length) : Prop :=
  i < j ∧ ¬ w[i].Independent w[j]

/-- Strict occurrence order, generated by earlier dependent pairs. -/
def Causal (w : Word T E) : Fin w.length → Fin w.length → Prop :=
  Relation.TransGen (Edge w)

theorem causal_lt {w : Word T E} {i j : Fin w.length} (h : Causal w i j) : i < j := by
  induction h with
  | single h => exact h.1
  | tail _ h ih => exact Fin.lt_trans ih h.1

/-- A representative enumerates occurrences by position. Trace observations
identify these enumerations by label- and order-preserving transport. -/
def ofWord (w : Word T E) : OccurrencePoset T E where
  size := w.length
  label i := w[i]
  before := Causal w
  before_irrefl _ h := Nat.lt_irrefl _ (causal_lt h)
  before_trans := Relation.TransGen.trans

/-- Concurrency is distinctness and incomparability in the strict order. -/
def Concurrent (p : OccurrencePoset T E) (i j : Fin p.size) : Prop :=
  i ≠ j ∧ ¬ p.before i j ∧ ¬ p.before j i

/-- A bijection of occurrences preserving labels and reflecting and preserving order. -/
structure Iso (p q : OccurrencePoset T E) where
  equiv : Fin p.size ≃ Fin q.size
  label_eq : ∀ i, q.label (equiv i) = p.label i
  before_iff : ∀ i j, q.before (equiv i) (equiv j) ↔ p.before i j

namespace Iso

def refl (p : OccurrencePoset T E) : Iso p p :=
  ⟨Equiv.refl _, fun _ => rfl, fun _ _ => Iff.rfl⟩

def symm {p q : OccurrencePoset T E} (f : Iso p q) : Iso q p where
  equiv := f.equiv.symm
  label_eq i := by simpa using (f.label_eq (f.equiv.symm i)).symm
  before_iff i j := by simpa using (f.before_iff (f.equiv.symm i) (f.equiv.symm j)).symm

def trans {p q r : OccurrencePoset T E} (f : Iso p q) (g : Iso q r) : Iso p r where
  equiv := f.equiv.trans g.equiv
  label_eq i := (g.label_eq (f.equiv i)).trans (f.label_eq i)
  before_iff i j := (g.before_iff (f.equiv i) (f.equiv j)).trans (f.before_iff i j)

end Iso

/-- Labelled occurrence posets up to isomorphism. -/
def isoSetoid (T : Type u) (E : Type v) : Setoid (OccurrencePoset T E) where
  r p q := Nonempty (Iso p q)
  iseqv := ⟨fun p => ⟨Iso.refl p⟩, fun ⟨f⟩ => ⟨f.symm⟩, fun ⟨f⟩ ⟨g⟩ => ⟨f.trans g⟩⟩

abbrev IsoClass (T : Type u) (E : Type v) := Quotient (isoSetoid T E)

end OccurrencePoset

end Silmaril.Semantics.ConcurrentTrace
