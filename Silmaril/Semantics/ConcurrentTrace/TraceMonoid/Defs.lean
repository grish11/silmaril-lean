module

public import Mathlib.Algebra.FreeMonoid.Basic
public import Mathlib.GroupTheory.Congruence.Hom

/-! # Trace monoids

Finite words modulo the least concatenation congruence generated by the given
letter swaps. A symmetric, irreflexive swap relation presents a trace monoid.
-/

@[expose] public section

namespace Silmaril.Semantics.ConcurrentTrace.TraceMonoid

universe u v w

variable {A : Type u} {B : Type v}

/-- The pairs of two-letter words generating the congruence. -/
inductive Swap (independent : A → A → Prop) : FreeMonoid A → FreeMonoid A → Prop where
  | pair {a b : A} : independent a b → Swap independent (.ofList [a, b]) (.ofList [b, a])

/-- The least concatenation congruence containing the generating swaps. -/
def congruence (independent : A → A → Prop) : Con (FreeMonoid A) :=
  conGen (Swap independent)

/-- A trace with the monoid structure induced by concatenation. -/
abbrev Trace (independent : A → A → Prop) := (congruence independent).Quotient

variable {I : A → A → Prop} {J : B → B → Prop}

/-- The trace class of a word. -/
def ofWord (I : A → A → Prop) (word : List A) : Trace I :=
  (congruence I).mk' (.ofList word)

/-- The trace containing a single letter. -/
def singleton (I : A → A → Prop) (a : A) : Trace I := ofWord I [a]

@[simp] theorem ofWord_nil : ofWord I [] = 1 := rfl

@[simp] theorem ofWord_cons (a : A) (word : List A) :
    ofWord I (a :: word) = singleton I a * ofWord I word := rfl

theorem swap {a b : A} (h : I a b) : singleton I a * singleton I b = singleton I b * singleton I a :=
  (congruence I).eq.mpr (Con.le_conGen (r := Swap I) _ _ (.pair h))

theorem ofWord_surjective : Function.Surjective (ofWord I) := by
  intro x
  obtain ⟨w, rfl⟩ := Con.mk'_surjective (c := congruence I) x
  exact ⟨w.toList, rfl⟩

/-- Interpret letters in a monoid in which images of independent letters commute. -/
def lift {M : Type w} [Monoid M] (f : A → M)
    (commutes : ∀ ⦃a b⦄, I a b → f a * f b = f b * f a) : Trace I →* M :=
  (congruence I).lift (FreeMonoid.lift f) (Con.conGen_le.mpr (by
    rintro _ _ ⟨h⟩
    simpa [Con.ker_apply, FreeMonoid.lift_ofList] using commutes h))

@[simp] theorem lift_singleton {M : Type w} [Monoid M] (f : A → M)
    (h : ∀ ⦃a b⦄, I a b → f a * f b = f b * f a) (a : A) :
    lift f h (singleton I a) = f a :=
  FreeMonoid.lift_eval_of f a

/-- Map letters by a function preserving independence. -/
def map (f : A → B) (h : ∀ ⦃a b⦄, I a b → J (f a) (f b)) : Trace I →* Trace J :=
  lift (singleton J ∘ f) (fun {a b} hind => swap (h (a := a) (b := b) hind))

@[simp] theorem map_singleton (f : A → B) (h : ∀ ⦃a b⦄, I a b → J (f a) (f b)) (a : A) :
    map f h (singleton I a) = singleton J (f a) :=
  lift_singleton _ _ _

end Silmaril.Semantics.ConcurrentTrace.TraceMonoid
