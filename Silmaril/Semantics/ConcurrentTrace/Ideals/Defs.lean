module

public import Silmaril.Semantics.ConcurrentTrace.PartialSequence.Thms
public import Mathlib.Order.Ideal
public import Mathlib.Order.Setoid.Basic

/-! # Quotient traces from finite prefix ideals

The preorder on finite observations is a parameter. For finite trace monoids its order is
left divisibility, and the word map sends a word to its finite trace class.
-/

@[expose] public section

namespace Silmaril.Semantics.ConcurrentTrace.Ideals

universe u v w z u' w'

/-- Interpret words in a preorder of finite observations. An actual finite trace quotient
can supply its quotient map and prove that extension of words preserves the prefix order. -/
structure WordMap (E : Type u) (M : Type v) [Preorder M] where
  toFun : List E → M
  preservesPrefix {w v : List E} : w <+: v → toFun w ≤ toFun v

instance {E : Type u} {M : Type v} [Preorder M] : CoeFun (WordMap E M) (fun _ => List E → M) where
  coe := WordMap.toFun

variable {E : Type u} {M : Type v} [Preorder M] {R : Type w}
variable {F : Type u'} {N : Type z} [Preorder N] {S : Type w'}

/-- The ideal generated by the classes of all finite cuts of one sequence. -/
def prefixIdeal (q : WordMap E M) (s : PartialSequence E R) : Order.Ideal M where
  carrier := {x | ∃ n, x ≤ q (s.cut n)}
  lower' := fun _ _ h ⟨n, hx⟩ => ⟨n, h.trans hx⟩
  nonempty' := ⟨q (s.cut 0), 0, le_rfl⟩
  directed' := by
    rintro x ⟨m, hx⟩ y ⟨n, hy⟩
    exact ⟨q (s.cut (max m n)), ⟨max m n, le_rfl⟩,
      hx.trans (q.preservesPrefix (s.prefix_mono (Nat.le_max_left m n))),
      hy.trans (q.preservesPrefix (s.prefix_mono (Nat.le_max_right m n)))⟩

/-- Take the downward closure of an ideal's image under a monotone map. -/
def lowerImage (h : M →o N) (I : Order.Ideal M) : Order.Ideal N where
  carrier := {y | ∃ x ∈ I, y ≤ h x}
  lower' := fun _ _ hle ⟨x, hx, hy⟩ => ⟨x, hx, hle.trans hy⟩
  nonempty' := let ⟨x, hx⟩ := I.nonempty; ⟨h x, x, hx, le_rfl⟩
  directed' := by
    rintro y ⟨x, hx, hy⟩ y' ⟨x', hx', hy'⟩
    obtain ⟨z, hz, hxz, hx'z⟩ := I.directed x hx x' hx'
    exact ⟨h z, ⟨z, hz, le_rfl⟩, hy.trans (h.monotone hxz), hy'.trans (h.monotone hx'z)⟩

/-- Equality of quotient prefix ideals, with completion and its value retained. -/
def observation (q : WordMap E M) (s : PartialSequence E R) : Order.Ideal M × Option R :=
  (prefixIdeal q s, s.completion)

/-- The quotient of sequentially presented partial sequences by their observations. -/
abbrev Trace (q : WordMap E M) (R : Type w) :=
  Quotient (Setoid.ker (observation (R := R) q))

namespace Trace
variable {q : WordMap E M}

/-- Send a partial sequence to its quotient trace. -/
def ofSequence (q : WordMap E M) (s : PartialSequence E R) : Trace q R := Quotient.mk (Setoid.ker (observation q)) s

/-- Forget the representative and retain the observable ideal and optional result. -/
def observe (t : Trace q R) : Order.Ideal M × Option R :=
  Quotient.lift (observation q) (fun _ _ h => h) t

/-- A finite trace class retains the equality of the supplied word interpretation. -/
abbrev FiniteWord (q : WordMap E M) := Quotient (Setoid.ker q.toFun)

end Trace
end Silmaril.Semantics.ConcurrentTrace.Ideals
