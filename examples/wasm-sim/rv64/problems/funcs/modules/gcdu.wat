;; Wasm problem: RV64 function `gcdu` @ 0x112b4 (7 instructions) of funcs, plan wasm-sim/rv64/funcs
;; Generated by tools/wasm-sim (rv64 reduce, P-locals). Registers are i64 locals (ABI names);
;; each instruction is its simulator method body (examples/wasm-sim/rv64/parts) specialised
;; to constant registers and pc; memory is `env.memory`, at least 1024 pages (RV address = Wasm address).
;; Params are entry values in @requires/@ensures; `result` is a0, `(result r)` another result.
;; @define (declare-fun gcd ((_ BitVec 64) (_ BitVec 64)) (_ BitVec 64))
;; @define (declare-fun popcount ((_ BitVec 64)) (_ BitVec 64))
(module
  ;; @requires true
  ;; @ensures (= result (gcd a0 a1))
  (func $gcdu (export "gcdu") (param $a0 i64) (param $a1 i64) (result i64) (local $a2 i64)
    (block $B3
      ;; 0x112b4: 00058c63 beq
      (if (i64.eq (local.get $a1) (i64.const 0))
        (then
          (br $B3)
        )
        (else
          (loop $L1
            ;; cut at +4 (0x112b8)
            ;; @invariant (and (distinct a1 #x0000000000000000) (= (gcd a0 a1) (gcd (old a0) (old a1))))
            ;; @decreases a1
            ;; 0x112b8: 00058613 addi
            (local.set $a2 (i64.add (local.get $a1) (i64.const 0)))
            ;; 0x112bc: 02b575b3 remu
            (local.set $a1 (call $remu64 (local.get $a0) (local.get $a1)))
            ;; 0x112c0: 00060513 addi
            (local.set $a0 (i64.add (local.get $a2) (i64.const 0)))
            ;; 0x112c4: fe059ae3 bne
            (if (i64.ne (local.get $a1) (i64.const 0))
              (then
                (br $L1)
              )
              (else
                ;; 0x112c8: 00060513 addi
                (local.set $a0 (i64.add (local.get $a2) (i64.const 0)))
                (br $B3)
              ))
          )
        ))
    )
    ;; 0x112cc: 00008067 jalr
    (return (local.get $a0))
    (unreachable))
  ;; M-extension helpers, verbatim from parts/grp-mul.wat
  (func $remu64 (param $a i64) (param $b i64) (result i64)
    (if (result i64) (i64.eqz (local.get $b)) (then (local.get $a)) (else (i64.rem_u (local.get $a) (local.get $b)))))
)
