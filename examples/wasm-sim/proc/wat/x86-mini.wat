        (if (i32.and (i32.ge_u (local.get $op) (i32.const 0x18)) (i32.le_u (local.get $op) (i32.const 0x1f)))
          (then (call $modrm (i32.const 0)) (br $done)))
        (if (i32.eq (i32.and (local.get $op) (i32.const 0xf0)) (i32.const 0x80))
          (then (local.set $v (call $fimm (i32.const 4)))
                (if (call $cond (i32.and (local.get $op) (i32.const 15)))
                  (then (global.set $pc (i64.add (global.get $pc) (local.get $v)))))
                (br $done)))
        (if (i32.eq (i32.and (local.get $op) (i32.const 0xf0)) (i32.const 0x90))
          (then (call $modrm (i32.const 0))
                (call $rmw (i32.const 1) (i64.extend_i32_u (call $cond (i32.and (local.get $op) (i32.const 15)))))
                (br $done)))
        (if (i32.eq (i32.and (local.get $op) (i32.const 0xf0)) (i32.const 0x40))
          (then (call $modrm (i32.const 0))
                (local.set $v (call $rmr (local.get $sz)))
                (if (call $cond (i32.and (local.get $op) (i32.const 15)))
                  (then (call $regw (local.get $sz) (global.get $reg) (local.get $v)))
                  (else (if (i32.eq (local.get $sz) (i32.const 4)) ;; 32-bit cmov zero-extends anyway
                    (then (call $regw (i32.const 4) (global.get $reg) (call $regr (i32.const 4) (global.get $reg)))))))
                (br $done)))
        (if (i32.eq (local.get $op) (i32.const 0xaf))
          (then (call $modrm (i32.const 0))
                (call $regw (local.get $sz) (global.get $reg)
                  (call $imul (local.get $sz) (call $regr (local.get $sz) (global.get $reg)) (call $rmr (local.get $sz))))
                (br $done)))
        (if (i32.or (i32.eq (local.get $op) (i32.const 0xb6)) (i32.eq (local.get $op) (i32.const 0xb7)))
          (then (call $modrm (i32.const 0))
                (call $regw (local.get $sz) (global.get $reg) (call $rmr (select (i32.const 1) (i32.const 2) (i32.eq (local.get $op) (i32.const 0xb6)))))
                (br $done)))
        (if (i32.or (i32.eq (local.get $op) (i32.const 0xbe)) (i32.eq (local.get $op) (i32.const 0xbf)))
          (then (call $modrm (i32.const 0))
                (local.set $b (select (i32.const 1) (i32.const 2) (i32.eq (local.get $op) (i32.const 0xbe))))
                (call $regw (local.get $sz) (global.get $reg) (call $sext (local.get $b) (call $rmr (local.get $b))))
                (br $done)))
        (br $bad)))
    (br $bad))
    ;; done: commit rip
    (global.set $rip (global.get $pc))
    (return (i32.const 0)))
    ;; bad: rip unchanged
    (i32.const 2))

  (func (export "run") (param $fuel i64) (result i32)
    (local $s i32)
    (loop $l
      (if (i64.eqz (local.get $fuel)) (then (return (i32.const 4))))
      (local.set $s (call $step))
      (if (local.get $s) (then (return (local.get $s))))
      (local.set $fuel (i64.sub (local.get $fuel) (i64.const 1)))
      (br $l))
    (i32.const 0))
)
