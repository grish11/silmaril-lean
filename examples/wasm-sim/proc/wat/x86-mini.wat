        (global.set $cf (i32.wrap_i64 (i64.and (i64.shr_u (local.get $a) (i64.extend_i32_u (i32.sub (local.get $n) (i32.const 1)))) (i64.const 1))))
        (global.set $of (i32.wrap_i64 (i64.shr_u (local.get $a) (i64.extend_i32_u (i32.sub (local.get $bits) (i32.const 1)))))))
    (else (if (i32.eq (local.get $op) (i32.const 7))
      (then
        (local.set $r (i64.and (i64.shr_s (call $sext (local.get $sz) (local.get $a)) (i64.extend_i32_u (local.get $n))) (call $mask (local.get $sz))))
        (global.set $cf (i32.wrap_i64 (i64.and (i64.shr_s (call $sext (local.get $sz) (local.get $a)) (i64.extend_i32_u (i32.sub (local.get $n) (i32.const 1)))) (i64.const 1))))
