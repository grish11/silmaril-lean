    (local $nr i64)
    (if (i64.eq (global.get $rip) (i64.const 0xFFFFFFFFFFFFF000)) (then (return (i32.const 1))))
    (if (i32.and (i64.ge_u (global.get $rip) (global.get $ext_lo)) (i64.lt_u (global.get $rip) (global.get $ext_hi)))
      (then
        (local.set $t (call $ext_call (global.get $rip)))
        (if (local.get $t) (then (return (local.get $t))))
        (global.set $rip (call $pop))
