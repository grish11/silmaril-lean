            (local.set $v (call $alu (local.get $t) (local.get $sz) (call $regr (local.get $sz) (i32.const 0)) (local.get $w)))
            (if (i32.ne (local.get $t) (i32.const 7)) (then (call $regw (local.get $sz) (i32.const 0) (local.get $v))))))
