    (if (i32.eq (i32.and (local.get $op) (i32.const 0xf8)) (i32.const 0xb8))
      (then (call $regw (local.get $sz) (i32.or (i32.and (local.get $op) (i32.const 7)) (i32.shl (i32.and (global.get $rex) (i32.const 1)) (i32.const 3)))
