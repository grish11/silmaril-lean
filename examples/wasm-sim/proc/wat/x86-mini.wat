    (if (i32.eq (i32.and (local.get $op) (i32.const 0xf8)) (i32.const 0x58))
      (then (call $rset (i32.or (i32.and (local.get $op) (i32.const 7)) (i32.shl (i32.and (global.get $rex) (i32.const 1)) (i32.const 3))) (call $pop)) (br $done)))
