    (if (i32.eq (local.get $op) (i32.const 0x68)) (then (call $push (call $fimm (i32.const 4))) (br $done)))
    (if (i32.eq (local.get $op) (i32.const 0x6a)) (then (call $push (call $fimm (i32.const 1))) (br $done)))
    (if (i32.or (i32.eq (local.get $op) (i32.const 0x69)) (i32.eq (local.get $op) (i32.const 0x6b)))
      (then
