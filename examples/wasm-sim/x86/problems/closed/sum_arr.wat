  (func $i_jmp (param $t i64) (call $rset (i32.const 16) (local.get $t)))
  ;; ---- program (P-calls translation of the machine code)
  ;; x86 function at 0x400020: 12 instructions, 5 blocks
  (func $f_400020 (result i32)
    (local $b i32) (local $s i32)
