      (then (i64.const -1))
      (else (i64.sub (i64.shl (i64.const 1) (i64.extend_i32_u (i32.shl (local.get $w) (i32.const 3))))
                     (i64.const 1)))))
  (func $sbit (param $w i32) (result i64)
