;; Decoder: `step` fetches through mem.load8/32/64 (P-mem), `run`. Needs core.wat.
  ;; ---------------------------------------------------------------- decoder (P-mem)
  ;; Prefixes: 0x66 (operand size 16), REX, F3 (only: rep ret, pause, endbr64, popcnt, tzcnt,
  ;; lzcnt), lock (ignored), CS/DS/ES/SS segment overrides (ignored in 64-bit mode);
  ;; FS/GS, 0x67, F2 -> status 2.
  (global $p (mut i64) (i64.const 0))      ;; fetch pointer
  (global $rex (mut i32) (i32.const 0))    ;; REX bits WRXB
  (global $hasrex (mut i32) (i32.const 0))
  (global $opsz (mut i32) (i32.const 0))   ;; 0x66 seen
  (global $rep (mut i32) (i32.const 0))    ;; 0xF3 seen (0xF2: 2)
  (global $mreg (mut i32) (i32.const 0))   ;; ModRM.reg (+REX.R)
  (global $mrm (mut i32) (i32.const 0))    ;; ModRM.rm register (+REX.B) when register operand
  (global $mmem (mut i32) (i32.const 0))   ;; 1: memory operand at $ea
  (global $ea (mut i64) (i64.const 0))

  (func $f8 (result i64)
    (local $v i64)
    (local.set $v (call $load8 (global.get $p)))
    (global.set $p (i64.add (global.get $p) (i64.const 1)))
    (local.get $v))
  (func $f8s (result i64) (i64.extend8_s (call $f8)))
  (func $f32s (result i64)
    (local $v i64)
    (local.set $v (call $load32 (global.get $p)))
    (global.set $p (i64.add (global.get $p) (i64.const 4)))
    (i64.extend32_s (local.get $v)))
  (func $f64 (result i64)
    (local $v i64)
    (local.set $v (call $load64 (global.get $p)))
    (global.set $p (i64.add (global.get $p) (i64.const 8)))
    (local.get $v))

  ;; decode ModRM (+SIB, disp); $imm = number of immediate bytes that follow (for rip-relative)
  (func $modrm (param $imm i32)
    (local $b i32) (local $mod i32) (local $rm i32) (local $sib i32) (local $idx i32) (local $base i32)
    (local.set $b (i32.wrap_i64 (call $f8)))
    (local.set $mod (i32.shr_u (local.get $b) (i32.const 6)))
    (local.set $rm (i32.and (local.get $b) (i32.const 7)))
    (global.set $mreg (i32.or (i32.and (i32.shr_u (local.get $b) (i32.const 3)) (i32.const 7))
                              (i32.shl (i32.and (global.get $rex) (i32.const 4)) (i32.const 1))))
    (if (i32.eq (local.get $mod) (i32.const 3))
      (then (global.set $mmem (i32.const 0))
            (global.set $mrm (i32.or (local.get $rm) (i32.shl (i32.and (global.get $rex) (i32.const 1)) (i32.const 3))))
            (return)))
    (global.set $mmem (i32.const 1))
    (global.set $ea (i64.const 0))
    (if (i32.eq (local.get $rm) (i32.const 4))
      (then
        (local.set $sib (i32.wrap_i64 (call $f8)))
        (local.set $idx (i32.or (i32.and (i32.shr_u (local.get $sib) (i32.const 3)) (i32.const 7))
                                (i32.shl (i32.and (global.get $rex) (i32.const 2)) (i32.const 2))))
        (local.set $base (i32.and (local.get $sib) (i32.const 7)))
        (if (i32.ne (local.get $idx) (i32.const 4))
          (then (global.set $ea (i64.shl (call $rget (local.get $idx))
                                         (i64.extend_i32_u (i32.shr_u (local.get $sib) (i32.const 6)))))))
        (if (i32.and (i32.eq (local.get $base) (i32.const 5)) (i32.eqz (local.get $mod)))
          (then (global.set $ea (i64.add (global.get $ea) (call $f32s))))
          (else (global.set $ea (i64.add (global.get $ea)
                  (call $rget (i32.or (local.get $base) (i32.shl (i32.and (global.get $rex) (i32.const 1)) (i32.const 3))))))))
      )
      (else
        (if (i32.and (i32.eq (local.get $rm) (i32.const 5)) (i32.eqz (local.get $mod)))
          (then ;; rip-relative: disp32 + address of the next instruction
            (global.set $ea (call $f32s))
            (global.set $ea (i64.add (global.get $ea)
                              (i64.add (global.get $p) (i64.extend_i32_u (local.get $imm)))))
            (return))
          (else (global.set $ea (call $rget (i32.or (local.get $rm)
                                   (i32.shl (i32.and (global.get $rex) (i32.const 1)) (i32.const 3)))))))))
    (if (i32.eq (local.get $mod) (i32.const 1)) (then (global.set $ea (i64.add (global.get $ea) (call $f8s)))))
    (if (i32.eq (local.get $mod) (i32.const 2)) (then (global.set $ea (i64.add (global.get $ea) (call $f32s))))))

  ;; byte-register code: without REX, regs 4..7 at size 1 are ah ch dh bh (codes 16..19)
  (func $bcode (param $w i32) (param $r i32) (result i32)
    (if (result i32) (i32.and (i32.and (i32.eq (local.get $w) (i32.const 1)) (i32.eqz (global.get $hasrex)))
                              (i32.and (i32.ge_u (local.get $r) (i32.const 4)) (i32.lt_u (local.get $r) (i32.const 8))))
      (then (i32.add (local.get $r) (i32.const 12)))
      (else (local.get $r))))
  (func $rdE (param $w i32) (result i64)
    (if (result i64) (global.get $mmem)
      (then (call $ld (local.get $w) (global.get $ea)))
      (else (call $rd (local.get $w) (call $bcode (local.get $w) (global.get $mrm))))))
  (func $wrE (param $w i32) (param $v i64)
    (if (global.get $mmem)
      (then (call $st (local.get $w) (global.get $ea) (local.get $v)))
      (else (call $wr (local.get $w) (call $bcode (local.get $w) (global.get $mrm)) (local.get $v)))))
  (func $rdG (param $w i32) (result i64) (call $rd (local.get $w) (call $bcode (local.get $w) (global.get $mreg))))
  (func $wrG (param $w i32) (param $v i64) (call $wr (local.get $w) (call $bcode (local.get $w) (global.get $mreg)) (local.get $v)))
  ;; finish: rip <- fetch pointer, status 0
  (func $fin (result i32) (call $rset (i32.const 16) (global.get $p)) (i32.const 0))

  ;; immediate of operand size w ("Iz": imm8, imm16, or sign-extended imm32)
  (func $fimm (param $w i32) (result i64)
    (local $v i64)
    (if (i32.eq (local.get $w) (i32.const 1)) (then (return (call $f8))))
    (if (i32.eq (local.get $w) (i32.const 2))
      (then (local.set $v (call $load16 (global.get $p)))
            (global.set $p (i64.add (global.get $p) (i64.const 2)))
            (return (local.get $v))))
    (call $f32s))
  (func $isz (param $w i32) (result i32)
    (select (i32.const 4) (local.get $w) (i32.ge_u (local.get $w) (i32.const 4))))
  ;; register from the low 3 opcode bits (+REX.B)
  (func $oreg (param $op i32) (result i32)
    (i32.or (i32.and (local.get $op) (i32.const 7)) (i32.shl (i32.and (global.get $rex) (i32.const 1)) (i32.const 3))))
  (func $cc (param $op i32) (result i32) (call $cond (i32.and (local.get $op) (i32.const 15))))
  (func $isop (param $op i32) (param $a i32) (param $b i32) (result i32)
    (i32.or (i32.eq (local.get $op) (local.get $a)) (i32.eq (local.get $op) (local.get $b))))

  (func $step (export "step") (result i32)
    (local $op i32) (local $w i32) (local $wd i32) (local $o i32) (local $a i64) (local $b i64) (local $r i64)
    (local $t i64) (local $s i32)
    (if (i64.eq (call $rget (i32.const 16)) (i64.const 0xFFFFFFFFFFFFF000)) (then (return (i32.const 1))))
    (global.set $p (call $rget (i32.const 16)))
    (global.set $rex (i32.const 0)) (global.set $hasrex (i32.const 0))
    (global.set $opsz (i32.const 0)) (global.set $rep (i32.const 0))
    ;; legacy prefixes
    (block $pfx (loop $more
      (local.set $op (i32.wrap_i64 (call $f8)))
      (if (i32.eq (local.get $op) (i32.const 0x66)) (then (global.set $opsz (i32.const 1)) (br $more)))
      (if (i32.eq (local.get $op) (i32.const 0xf3)) (then (global.set $rep (i32.const 1)) (br $more)))
      (if (i32.eq (local.get $op) (i32.const 0xf2)) (then (global.set $rep (i32.const 2)) (br $more)))
      (if (i32.or (i32.or (i32.eq (local.get $op) (i32.const 0x2e)) (i32.eq (local.get $op) (i32.const 0x3e)))
                  (i32.or (i32.or (i32.eq (local.get $op) (i32.const 0x26)) (i32.eq (local.get $op) (i32.const 0x36)))
                          (i32.eq (local.get $op) (i32.const 0xf0))))
        (then (br $more)))))
    (if (i32.eq (i32.and (local.get $op) (i32.const 0xf0)) (i32.const 0x40))
      (then (global.set $rex (i32.and (local.get $op) (i32.const 15))) (global.set $hasrex (i32.const 1))
            (local.set $op (i32.wrap_i64 (call $f8)))))
    (local.set $w (select (i32.const 8) (select (i32.const 2) (i32.const 4) (global.get $opsz))
                          (i32.and (global.get $rex) (i32.const 8))))
    ;; F3/F2 only where listed
    (if (global.get $rep)
      (then
        (if (i32.eq (global.get $rep) (i32.const 2)) (then (return (i32.const 2))))
        (if (i32.eq (local.get $op) (i32.const 0xc3)) (then (call $rset (i32.const 16) (call $pop)) (return (i32.const 0))))
        (if (i32.eq (local.get $op) (i32.const 0x90)) (then (return (call $fin))))
        (if (i32.ne (local.get $op) (i32.const 0x0f)) (then (return (i32.const 2))))
        (local.set $op (i32.wrap_i64 (call $f8)))
        (if (i32.eq (local.get $op) (i32.const 0x1e)) (then (call $modrm (i32.const 0)) (return (call $fin))))
        (local.set $o (select (i32.const 0) (select (i32.const 1) (select (i32.const 2) (i32.const -1)
                                (i32.eq (local.get $op) (i32.const 0xbd)))
                                (i32.eq (local.get $op) (i32.const 0xbc)))
                              (i32.eq (local.get $op) (i32.const 0xb8))))
        (if (i32.lt_s (local.get $o) (i32.const 0)) (then (return (i32.const 2))))
        (call $modrm (i32.const 0))
        (call $bitop (local.get $o) (local.get $w) (global.get $mreg) (call $rdE (local.get $w)))
        (return (call $fin))))

    ;; 00..3F ALU forms (op&7 < 6)
    (if (i32.and (i32.lt_u (local.get $op) (i32.const 0x40)) (i32.lt_u (i32.and (local.get $op) (i32.const 7)) (i32.const 6)))
      (then
        (local.set $o (i32.shr_u (local.get $op) (i32.const 3)))
        (local.set $wd (select (local.get $w) (i32.const 1) (i32.and (local.get $op) (i32.const 1))))
        (local.set $s (i32.and (local.get $op) (i32.const 7)))
        (if (i32.ge_u (local.get $s) (i32.const 4))
          (then ;; AL/eAX, imm
            (local.set $b (i64.and (call $fimm (local.get $wd)) (call $mask (local.get $wd))))
            (local.set $r (call $alu (local.get $o) (local.get $wd) (call $rd (local.get $wd) (i32.const 0)) (local.get $b)))
            (if (i32.ne (local.get $o) (i32.const 7)) (then (call $wr (local.get $wd) (i32.const 0) (local.get $r))))
            (return (call $fin))))
        (call $modrm (i32.const 0))
        (if (i32.lt_u (local.get $s) (i32.const 2))
          (then
            (local.set $r (call $alu (local.get $o) (local.get $wd) (call $rdE (local.get $wd)) (call $rdG (local.get $wd))))
            (if (i32.ne (local.get $o) (i32.const 7)) (then (call $wrE (local.get $wd) (local.get $r)))))
          (else
            (local.set $r (call $alu (local.get $o) (local.get $wd) (call $rdG (local.get $wd)) (call $rdE (local.get $wd))))
            (if (i32.ne (local.get $o) (i32.const 7)) (then (call $wrG (local.get $wd) (local.get $r))))))
        (return (call $fin))))
    ;; 80 81 83: group 1 E, imm
    (if (i32.or (call $isop (local.get $op) (i32.const 0x80) (i32.const 0x81)) (i32.eq (local.get $op) (i32.const 0x83)))
      (then
        (local.set $wd (select (i32.const 1) (local.get $w) (i32.eq (local.get $op) (i32.const 0x80))))
        (call $modrm (select (call $isz (local.get $wd)) (i32.const 1) (i32.eq (local.get $op) (i32.const 0x81))))
        (local.set $b (i64.and (if (result i64) (i32.eq (local.get $op) (i32.const 0x81)) (then (call $fimm (local.get $wd))) (else (call $f8s)))
                               (call $mask (local.get $wd))))
        (local.set $o (i32.and (global.get $mreg) (i32.const 7)))
        (local.set $r (call $alu (local.get $o) (local.get $wd) (call $rdE (local.get $wd)) (local.get $b)))
        (if (i32.ne (local.get $o) (i32.const 7)) (then (call $wrE (local.get $wd) (local.get $r))))
        (return (call $fin))))
    ;; 84 85 test E,G; 86 87 xchg E,G
    (if (i32.eq (i32.and (local.get $op) (i32.const 0xfc)) (i32.const 0x84))
      (then
        (local.set $wd (select (local.get $w) (i32.const 1) (i32.and (local.get $op) (i32.const 1))))
        (call $modrm (i32.const 0))
        (if (i32.lt_u (local.get $op) (i32.const 0x86))
          (then (drop (call $alu (i32.const 8) (local.get $wd) (call $rdE (local.get $wd)) (call $rdG (local.get $wd)))))
          (else (local.set $a (call $rdE (local.get $wd)))
                (call $wrE (local.get $wd) (call $rdG (local.get $wd)))
                (call $wrG (local.get $wd) (local.get $a))))
        (return (call $fin))))
    ;; A8 A9 test AL/eAX, imm
    (if (call $isop (local.get $op) (i32.const 0xa8) (i32.const 0xa9))
      (then
        (local.set $wd (select (local.get $w) (i32.const 1) (i32.and (local.get $op) (i32.const 1))))
        (local.set $b (i64.and (call $fimm (local.get $wd)) (call $mask (local.get $wd))))
        (drop (call $alu (i32.const 8) (local.get $wd) (call $rd (local.get $wd) (i32.const 0)) (local.get $b)))
        (return (call $fin))))
    ;; 88 89 8A 8B mov
    (if (i32.eq (i32.and (local.get $op) (i32.const 0xfc)) (i32.const 0x88))
      (then
        (local.set $wd (select (local.get $w) (i32.const 1) (i32.and (local.get $op) (i32.const 1))))
        (call $modrm (i32.const 0))
        (if (i32.and (local.get $op) (i32.const 2))
          (then (call $wrG (local.get $wd) (call $rdE (local.get $wd))))
          (else (call $wrE (local.get $wd) (call $rdG (local.get $wd)))))
        (return (call $fin))))
    ;; 8D lea
    (if (i32.eq (local.get $op) (i32.const 0x8d))
      (then
        (call $modrm (i32.const 0))
        (if (i32.eqz (global.get $mmem)) (then (return (i32.const 2))))
        (call $wrG (local.get $w) (global.get $ea))
        (return (call $fin))))
    ;; 63 movsxd (REX.W) / mov r32, r/m32
    (if (i32.eq (local.get $op) (i32.const 0x63))
      (then
        (call $modrm (i32.const 0))
        (call $wrG (local.get $w) (call $sext (i32.const 4) (call $rdE (i32.const 4))))
        (return (call $fin))))
    ;; C6 C7 /0 mov E, imm
    (if (call $isop (local.get $op) (i32.const 0xc6) (i32.const 0xc7))
      (then
        (local.set $wd (select (local.get $w) (i32.const 1) (i32.and (local.get $op) (i32.const 1))))
        (call $modrm (call $isz (local.get $wd)))
        (if (i32.ne (global.get $mreg) (i32.and (global.get $mreg) (i32.const 8))) (then (return (i32.const 2))))
        (call $wrE (local.get $wd) (call $fimm (local.get $wd)))
        (return (call $fin))))
    ;; B0..B7 mov r8, imm8; B8..BF mov r, imm16/32/64
    (if (i32.eq (i32.and (local.get $op) (i32.const 0xf8)) (i32.const 0xb0))
      (then
        (call $wr (i32.const 1) (call $bcode (i32.const 1) (call $oreg (local.get $op))) (call $f8))
        (return (call $fin))))
    (if (i32.eq (i32.and (local.get $op) (i32.const 0xf8)) (i32.const 0xb8))
      (then
        (call $wr (local.get $w) (call $oreg (local.get $op))
          (if (result i64) (i32.eq (local.get $w) (i32.const 8)) (then (call $f64)) (else (call $fimm (local.get $w)))))
        (return (call $fin))))
    ;; 50..57 push, 58..5F pop (64-bit)
    (if (i32.eq (i32.and (local.get $op) (i32.const 0xf8)) (i32.const 0x50))
      (then (if (global.get $opsz) (then (return (i32.const 2))))
            (call $push (call $rget (call $oreg (local.get $op)))) (return (call $fin))))
    (if (i32.eq (i32.and (local.get $op) (i32.const 0xf8)) (i32.const 0x58))
      (then (if (global.get $opsz) (then (return (i32.const 2))))
            (local.set $t (call $pop)) (call $rset (call $oreg (local.get $op)) (local.get $t)) (return (call $fin))))
    ;; 68 push imm32, 6A push imm8
    (if (i32.and (call $isop (local.get $op) (i32.const 0x68) (i32.const 0x6a)) (i32.eqz (global.get $opsz)))
      (then (call $push (if (result i64) (i32.eq (local.get $op) (i32.const 0x68)) (then (call $f32s)) (else (call $f8s))))
            (return (call $fin))))
    ;; 69 6B imul G, E, imm
    (if (call $isop (local.get $op) (i32.const 0x69) (i32.const 0x6b))
      (then
        (call $modrm (select (call $isz (local.get $w)) (i32.const 1) (i32.eq (local.get $op) (i32.const 0x69))))
        (local.set $a (call $rdE (local.get $w)))
        (local.set $b (i64.and (if (result i64) (i32.eq (local.get $op) (i32.const 0x69)) (then (call $fimm (local.get $w))) (else (call $f8s)))
                               (call $mask (local.get $w))))
        (call $wrG (local.get $w) (call $imul (local.get $w) (local.get $a) (local.get $b)))
        (return (call $fin))))
    ;; C0 C1 D0 D1 D2 D3: group 2 (rol ror shl shr sar; rcl rcr and /6 unsupported)
    (if (i32.or (call $isop (local.get $op) (i32.const 0xc0) (i32.const 0xc1))
                (i32.eq (i32.and (local.get $op) (i32.const 0xfc)) (i32.const 0xd0)))
      (then
        (local.set $wd (select (local.get $w) (i32.const 1) (i32.and (local.get $op) (i32.const 1))))
        (call $modrm (select (i32.const 1) (i32.const 0) (i32.lt_u (local.get $op) (i32.const 0xd0))))
        (local.set $o (i32.and (global.get $mreg) (i32.const 7)))
        (if (i32.or (i32.or (i32.eq (local.get $o) (i32.const 2)) (i32.eq (local.get $o) (i32.const 3)))
                    (i32.eq (local.get $o) (i32.const 6)))
          (then (return (i32.const 2))))
        (local.set $s (i32.const 1))
        (if (i32.lt_u (local.get $op) (i32.const 0xd0)) (then (local.set $s (i32.wrap_i64 (call $f8)))))
        (if (i32.ge_u (local.get $op) (i32.const 0xd2)) (then (local.set $s (i32.wrap_i64 (call $rget (i32.const 1))))))
        (call $wrE (local.get $wd) (call $shift (local.get $o) (local.get $wd) (call $rdE (local.get $wd)) (local.get $s)))
        (return (call $fin))))
    ;; F6 F7 group 3
    (if (call $isop (local.get $op) (i32.const 0xf6) (i32.const 0xf7))
      (then
        (local.set $wd (select (local.get $w) (i32.const 1) (i32.and (local.get $op) (i32.const 1))))
        ;; peek ModRM.reg to know whether an immediate follows (only /0 test)
        (local.set $o (i32.and (i32.shr_u (i32.wrap_i64 (call $load8 (global.get $p))) (i32.const 3)) (i32.const 7)))
        (call $modrm (select (call $isz (local.get $wd)) (i32.const 0) (i32.eqz (local.get $o))))
        (if (i32.eqz (local.get $o))
          (then
            (local.set $a (call $rdE (local.get $wd)))
            (local.set $b (i64.and (call $fimm (local.get $wd)) (call $mask (local.get $wd))))
            (drop (call $alu (i32.const 8) (local.get $wd) (local.get $a) (local.get $b)))
            (return (call $fin))))
        (if (i32.or (i32.eq (local.get $o) (i32.const 2)) (i32.eq (local.get $o) (i32.const 3)))
          (then
            (call $wrE (local.get $wd) (call $unary (local.get $o) (local.get $wd) (call $rdE (local.get $wd))))
            (return (call $fin))))
        (if (i32.or (i32.lt_u (local.get $wd) (i32.const 4)) (i32.eq (local.get $o) (i32.const 1))) (then (return (i32.const 2))))
        (local.set $s (call $muldiv (local.get $o) (local.get $wd) (call $rdE (local.get $wd))))
        (if (local.get $s) (then (return (local.get $s))))
        (return (call $fin))))
    ;; FE FF group 4/5
    (if (call $isop (local.get $op) (i32.const 0xfe) (i32.const 0xff))
      (then
        (local.set $wd (select (local.get $w) (i32.const 1) (i32.and (local.get $op) (i32.const 1))))
        (call $modrm (i32.const 0))
        (local.set $o (i32.and (global.get $mreg) (i32.const 7)))
        (if (i32.lt_u (local.get $o) (i32.const 2))
          (then (call $wrE (local.get $wd) (call $unary (local.get $o) (local.get $wd) (call $rdE (local.get $wd))))
                (return (call $fin))))
        (if (i32.or (i32.eq (local.get $wd) (i32.const 1)) (global.get $opsz)) (then (return (i32.const 2))))
        (local.set $t (call $rdE (i32.const 8)))
        (if (i32.eq (local.get $o) (i32.const 2))  ;; call E
          (then (call $push (global.get $p)) (call $rset (i32.const 16) (local.get $t)) (return (i32.const 0))))
        (if (i32.eq (local.get $o) (i32.const 4))  ;; jmp E
          (then (call $rset (i32.const 16) (local.get $t)) (return (i32.const 0))))
        (if (i32.eq (local.get $o) (i32.const 6))  ;; push E
          (then (call $push (local.get $t)) (return (call $fin))))
        (return (i32.const 2))))
    ;; 98 cbw/cwde/cdqe, 99 cwd/cdq/cqo
    (if (call $isop (local.get $op) (i32.const 0x98) (i32.const 0x99))
      (then (call $i_cxx (local.get $op) (local.get $w)) (return (call $fin))))
    ;; 90 nop; 91..97 (and 90 with REX.B) xchg eAX, r
    (if (i32.eq (i32.and (local.get $op) (i32.const 0xf8)) (i32.const 0x90))
      (then
        (local.set $s (call $oreg (local.get $op)))
        (if (local.get $s)
          (then (local.set $a (call $rd (local.get $w) (local.get $s)))
                (call $wr (local.get $w) (local.get $s) (call $rd (local.get $w) (i32.const 0)))
                (call $wr (local.get $w) (i32.const 0) (local.get $a))))
        (return (call $fin))))
    ;; control transfer
    (if (i32.eq (local.get $op) (i32.const 0xc3)) (then (call $rset (i32.const 16) (call $pop)) (return (i32.const 0))))
    (if (i32.eq (local.get $op) (i32.const 0xe8))
      (then (local.set $t (call $f32s)) (call $push (global.get $p))
            (call $rset (i32.const 16) (i64.add (global.get $p) (local.get $t))) (return (i32.const 0))))
    (if (i32.eq (local.get $op) (i32.const 0xe9))
      (then (local.set $t (call $f32s)) (call $rset (i32.const 16) (i64.add (global.get $p) (local.get $t))) (return (i32.const 0))))
    (if (i32.eq (local.get $op) (i32.const 0xeb))
      (then (local.set $t (call $f8s)) (call $rset (i32.const 16) (i64.add (global.get $p) (local.get $t))) (return (i32.const 0))))
    (if (i32.eq (i32.and (local.get $op) (i32.const 0xf0)) (i32.const 0x70))
      (then (local.set $t (call $f8s))
            (if (call $cc (local.get $op)) (then (global.set $p (i64.add (global.get $p) (local.get $t)))))
            (return (call $fin))))
    ;; two-byte opcodes
    (if (i32.eq (local.get $op) (i32.const 0x0f))
      (then
        (local.set $op (i32.wrap_i64 (call $f8)))
        (if (i32.eq (local.get $op) (i32.const 0x05))
          (then (return (call $do_syscall (global.get $p)))))
        (if (i32.and (i32.ge_u (local.get $op) (i32.const 0x19)) (i32.le_u (local.get $op) (i32.const 0x1f)))  ;; hint nops
          (then (call $modrm (i32.const 0)) (return (call $fin))))
        (if (i32.eq (i32.and (local.get $op) (i32.const 0xf0)) (i32.const 0x80))   ;; jcc rel32
          (then (local.set $t (call $f32s))
                (if (call $cc (local.get $op)) (then (global.set $p (i64.add (global.get $p) (local.get $t)))))
                (return (call $fin))))
        (if (i32.eq (i32.and (local.get $op) (i32.const 0xf8)) (i32.const 0xc8))   ;; bswap r32/r64
          (then (if (i32.eq (local.get $w) (i32.const 2)) (then (return (i32.const 2))))
                (call $i_bswap_r (local.get $w) (call $oreg (local.get $op)))
                (return (call $fin))))
        (if (i32.eq (i32.and (local.get $op) (i32.const 0xf0)) (i32.const 0x40))   ;; cmovcc
          (then (call $modrm (i32.const 0))
                (local.set $a (call $rdE (local.get $w)))
                (call $wrG (local.get $w) (select (local.get $a) (call $rdG (local.get $w)) (call $cc (local.get $op))))
                (return (call $fin))))
        (if (i32.eq (i32.and (local.get $op) (i32.const 0xf0)) (i32.const 0x90))   ;; setcc
          (then (call $modrm (i32.const 0))
                (call $wrE (i32.const 1) (i64.extend_i32_u (call $cc (local.get $op))))
                (return (call $fin))))
        (if (i32.eq (local.get $op) (i32.const 0xaf))   ;; imul G, E
          (then (call $modrm (i32.const 0))
                (local.set $a (call $rdE (local.get $w)))
                (call $wrG (local.get $w) (call $imul (local.get $w) (call $rdG (local.get $w)) (local.get $a)))
                (return (call $fin))))
        (if (call $isop (local.get $op) (i32.const 0xbc) (i32.const 0xbd))   ;; bsf bsr
          (then (call $modrm (i32.const 0))
                (call $bitop (i32.add (local.get $op) (i32.const -185)) (local.get $w) (global.get $mreg) (call $rdE (local.get $w)))
                (return (call $fin))))
        (if (i32.eq (i32.and (local.get $op) (i32.const 0xf6)) (i32.const 0xb6))   ;; movzx/movsx B6 B7 BE BF
          (then (call $modrm (i32.const 0))
                (local.set $wd (select (i32.const 2) (i32.const 1) (i32.and (local.get $op) (i32.const 1))))
                (local.set $a (call $rdE (local.get $wd)))
                (if (i32.and (local.get $op) (i32.const 8)) (then (local.set $a (call $sext (local.get $wd) (local.get $a)))))
                (call $wrG (local.get $w) (local.get $a))
                (return (call $fin))))
        (return (i32.const 2))))
    (i32.const 2))

  (func (export "run") (param $fuel i64) (result i32)
    (local $s i32)
    (loop $l
      (if (i64.eqz (local.get $fuel)) (then (return (i32.const 4))))
      (local.set $s (call $step))
      (if (local.get $s) (then (return (local.get $s))))
      (local.set $fuel (i64.sub (local.get $fuel) (i64.const 1)))
      (br $l))
    (unreachable))
