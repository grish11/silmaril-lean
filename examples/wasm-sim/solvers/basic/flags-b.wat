;; The same method with different bit tricks: carry via the 65-bit sum's top bit
;; computed from halves, signed overflow via comparisons, registers by if-chains.
(module
  (global $r0 (mut i64) (i64.const 0)) (global $r1 (mut i64) (i64.const 0))
  (global $r2 (mut i64) (i64.const 0)) (global $r3 (mut i64) (i64.const 0))
  (global $cf (mut i32) (i32.const 0)) (global $zf (mut i32) (i32.const 0))
  (global $sf (mut i32) (i32.const 0)) (global $of (mut i32) (i32.const 0))
  (func $rget (param $r i32) (result i64)
    (if (result i64) (i32.eqz (local.get $r)) (then (global.get $r0))
      (else (if (result i64) (i32.eq (local.get $r) (i32.const 1)) (then (global.get $r1))
        (else (if (result i64) (i32.eq (local.get $r) (i32.const 2)) (then (global.get $r2))
          (else (global.get $r3))))))))
  (func $rset (param $r i32) (param $v i64)
    (if (i32.eqz (local.get $r)) (then (global.set $r0 (local.get $v)) (return)))
    (if (i32.eq (local.get $r) (i32.const 1)) (then (global.set $r1 (local.get $v)) (return)))
    (if (i32.eq (local.get $r) (i32.const 2)) (then (global.set $r2 (local.get $v)) (return)))
    (global.set $r3 (local.get $v)))
  (func (export "i_add_rr") (param $d i32) (param $s i32)
    (local $a i64) (local $b i64) (local $r i64) (local $lo i64)
    (local.set $a (call $rget (local.get $d)))
    (local.set $b (call $rget (local.get $s)))
    (local.set $r (i64.add (local.get $a) (local.get $b)))
    ;; carry out of bit 63 from the 32-bit halves
    (local.set $lo (i64.shr_u (i64.add (i64.and (local.get $a) (i64.const 0xffffffff))
                                       (i64.and (local.get $b) (i64.const 0xffffffff))) (i64.const 32)))
    (global.set $cf (i32.wrap_i64 (i64.shr_u
        (i64.add (i64.add (i64.shr_u (local.get $a) (i64.const 32)) (i64.shr_u (local.get $b) (i64.const 32)))
                 (local.get $lo)) (i64.const 32))))
    (global.set $zf (i64.eq (local.get $r) (i64.const 0)))
    (global.set $sf (i64.lt_s (local.get $r) (i64.const 0)))
    (global.set $of (i32.and (i32.eq (i64.lt_s (local.get $a) (i64.const 0)) (i64.lt_s (local.get $b) (i64.const 0)))
                             (i32.ne (i64.lt_s (local.get $a) (i64.const 0)) (i64.lt_s (local.get $r) (i64.const 0)))))
    (call $rset (local.get $d) (local.get $r))))
