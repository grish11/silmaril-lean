;; Abstract state model: one global per location (loc 0..16 registers, 17..23 flags),
;; accessors written as plain if-chains, with their contracts as assertions (`unreachable`):
;; indices in range, flag values 0/1. This is the specification both G and M accessors refine.
(module
  (global $r0 (mut i64) (i64.const 0))
  (global $r1 (mut i64) (i64.const 0))
  (global $r2 (mut i64) (i64.const 0))
  (global $r3 (mut i64) (i64.const 0))
  (global $r4 (mut i64) (i64.const 0))
  (global $r5 (mut i64) (i64.const 0))
  (global $r6 (mut i64) (i64.const 0))
  (global $r7 (mut i64) (i64.const 0))
  (global $r8 (mut i64) (i64.const 0))
  (global $r9 (mut i64) (i64.const 0))
  (global $r10 (mut i64) (i64.const 0))
  (global $r11 (mut i64) (i64.const 0))
  (global $r12 (mut i64) (i64.const 0))
  (global $r13 (mut i64) (i64.const 0))
  (global $r14 (mut i64) (i64.const 0))
  (global $r15 (mut i64) (i64.const 0))
  (global $rip (mut i64) (i64.const 0))
  (global $cf (mut i32) (i32.const 0))
  (global $pf (mut i32) (i32.const 0))
  (global $af (mut i32) (i32.const 0))
  (global $zf (mut i32) (i32.const 0))
  (global $sf (mut i32) (i32.const 0))
  (global $of (mut i32) (i32.const 0))
  (global $df (mut i32) (i32.const 0))
  (func $rget (param $r i32) (result i64)
    (if (i32.eq (local.get $r) (i32.const 0)) (then (return (global.get $r0))))
    (if (i32.eq (local.get $r) (i32.const 1)) (then (return (global.get $r1))))
    (if (i32.eq (local.get $r) (i32.const 2)) (then (return (global.get $r2))))
    (if (i32.eq (local.get $r) (i32.const 3)) (then (return (global.get $r3))))
    (if (i32.eq (local.get $r) (i32.const 4)) (then (return (global.get $r4))))
    (if (i32.eq (local.get $r) (i32.const 5)) (then (return (global.get $r5))))
    (if (i32.eq (local.get $r) (i32.const 6)) (then (return (global.get $r6))))
    (if (i32.eq (local.get $r) (i32.const 7)) (then (return (global.get $r7))))
    (if (i32.eq (local.get $r) (i32.const 8)) (then (return (global.get $r8))))
    (if (i32.eq (local.get $r) (i32.const 9)) (then (return (global.get $r9))))
    (if (i32.eq (local.get $r) (i32.const 10)) (then (return (global.get $r10))))
    (if (i32.eq (local.get $r) (i32.const 11)) (then (return (global.get $r11))))
    (if (i32.eq (local.get $r) (i32.const 12)) (then (return (global.get $r12))))
    (if (i32.eq (local.get $r) (i32.const 13)) (then (return (global.get $r13))))
    (if (i32.eq (local.get $r) (i32.const 14)) (then (return (global.get $r14))))
    (if (i32.eq (local.get $r) (i32.const 15)) (then (return (global.get $r15))))
    (if (i32.eq (local.get $r) (i32.const 16)) (then (return (global.get $rip))))
    (unreachable))
  (func $rset (param $r i32) (param $v i64)
    (if (i32.eq (local.get $r) (i32.const 0)) (then (global.set $r0 (local.get $v)) (return)))
    (if (i32.eq (local.get $r) (i32.const 1)) (then (global.set $r1 (local.get $v)) (return)))
    (if (i32.eq (local.get $r) (i32.const 2)) (then (global.set $r2 (local.get $v)) (return)))
    (if (i32.eq (local.get $r) (i32.const 3)) (then (global.set $r3 (local.get $v)) (return)))
    (if (i32.eq (local.get $r) (i32.const 4)) (then (global.set $r4 (local.get $v)) (return)))
    (if (i32.eq (local.get $r) (i32.const 5)) (then (global.set $r5 (local.get $v)) (return)))
    (if (i32.eq (local.get $r) (i32.const 6)) (then (global.set $r6 (local.get $v)) (return)))
    (if (i32.eq (local.get $r) (i32.const 7)) (then (global.set $r7 (local.get $v)) (return)))
    (if (i32.eq (local.get $r) (i32.const 8)) (then (global.set $r8 (local.get $v)) (return)))
    (if (i32.eq (local.get $r) (i32.const 9)) (then (global.set $r9 (local.get $v)) (return)))
    (if (i32.eq (local.get $r) (i32.const 10)) (then (global.set $r10 (local.get $v)) (return)))
    (if (i32.eq (local.get $r) (i32.const 11)) (then (global.set $r11 (local.get $v)) (return)))
    (if (i32.eq (local.get $r) (i32.const 12)) (then (global.set $r12 (local.get $v)) (return)))
    (if (i32.eq (local.get $r) (i32.const 13)) (then (global.set $r13 (local.get $v)) (return)))
    (if (i32.eq (local.get $r) (i32.const 14)) (then (global.set $r14 (local.get $v)) (return)))
    (if (i32.eq (local.get $r) (i32.const 15)) (then (global.set $r15 (local.get $v)) (return)))
    (if (i32.eq (local.get $r) (i32.const 16)) (then (global.set $rip (local.get $v)) (return)))
    (unreachable))
  (func $fget (param $f i32) (result i32)
    (if (i32.eq (local.get $f) (i32.const 17)) (then (return (global.get $cf))))
    (if (i32.eq (local.get $f) (i32.const 18)) (then (return (global.get $pf))))
    (if (i32.eq (local.get $f) (i32.const 19)) (then (return (global.get $af))))
    (if (i32.eq (local.get $f) (i32.const 20)) (then (return (global.get $zf))))
    (if (i32.eq (local.get $f) (i32.const 21)) (then (return (global.get $sf))))
    (if (i32.eq (local.get $f) (i32.const 22)) (then (return (global.get $of))))
    (if (i32.eq (local.get $f) (i32.const 23)) (then (return (global.get $df))))
    (unreachable))
  (func $fset (param $f i32) (param $v i32)
    (if (i32.gt_u (local.get $v) (i32.const 1)) (then (unreachable)))
    (if (i32.eq (local.get $f) (i32.const 17)) (then (global.set $cf (local.get $v)) (return)))
    (if (i32.eq (local.get $f) (i32.const 18)) (then (global.set $pf (local.get $v)) (return)))
    (if (i32.eq (local.get $f) (i32.const 19)) (then (global.set $af (local.get $v)) (return)))
    (if (i32.eq (local.get $f) (i32.const 20)) (then (global.set $zf (local.get $v)) (return)))
    (if (i32.eq (local.get $f) (i32.const 21)) (then (global.set $sf (local.get $v)) (return)))
    (if (i32.eq (local.get $f) (i32.const 22)) (then (global.set $of (local.get $v)) (return)))
    (if (i32.eq (local.get $f) (i32.const 23)) (then (global.set $df (local.get $v)) (return)))
    (unreachable))
  (func $fset6 (param $c i32) (param $p i32) (param $a i32) (param $z i32) (param $s i32) (param $o i32)
    (if (i32.gt_u (local.get $c) (i32.const 1)) (then (unreachable)))
    (if (i32.gt_u (local.get $p) (i32.const 1)) (then (unreachable)))
    (if (i32.gt_u (local.get $a) (i32.const 1)) (then (unreachable)))
    (if (i32.gt_u (local.get $z) (i32.const 1)) (then (unreachable)))
    (if (i32.gt_u (local.get $s) (i32.const 1)) (then (unreachable)))
    (if (i32.gt_u (local.get $o) (i32.const 1)) (then (unreachable)))
    (global.set $cf (local.get $c)) (global.set $pf (local.get $p)) (global.set $af (local.get $a))
    (global.set $zf (local.get $z)) (global.set $sf (local.get $s)) (global.set $of (local.get $o)))
  (export "rget" (func $rget)) (export "rset" (func $rset)) (export "fget" (func $fget))
  (export "fset" (func $fset)) (export "fset6" (func $fset6)))
