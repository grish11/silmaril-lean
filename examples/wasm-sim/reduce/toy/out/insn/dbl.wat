  (global $af (export "af") (mut i64) (i64.const 0))
  (global $zf (export "zf") (mut i64) (i64.const 0))
  (global $sf (export "sf") (mut i64) (i64.const 0))
  (global $of (export "of") (mut i64) (i64.const 0))
  (func $s_mov_rax_rdi_3 (export "s_mov_rax_rdi_3")
    global.get $rdi
    global.set $rax
    global.get $rip
    i64.const 3
    i64.add
    global.set $rip
  )
  (func $s_add_rax_rax_3 (export "s_add_rax_rax_3")
    global.get $rax
    global.get $rax
    i64.and
    global.get $rax
    global.get $rax
    i64.or
    global.get $rax
    global.get $rax
    i64.add
    i64.const -1
    i64.xor
    i64.and
    i64.or
    i64.const 63
    i64.shr_u
    global.set $cf
    global.get $rax
    global.get $rax
    global.get $rax
    i64.add
    i64.xor
    global.get $rax
    global.get $rax
    global.get $rax
    i64.add
    i64.xor
    i64.and
    i64.const 63
    i64.shr_u
    global.set $of
    i64.const 1
    global.get $rax
    global.get $rax
    i64.add
    i64.const 0
    global.get $rax
    global.get $rax
    i64.add
    i64.sub
    i64.or
    i64.const 63
    i64.shr_u
    i64.xor
    global.set $zf
