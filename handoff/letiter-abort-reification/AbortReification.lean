module

import Silmaril.SSA.Isotope.LetIter.Categorical.Empty.Thms
import Silmaril.SSA.Isotope.Bridge.Packing.Thms

universe u

namespace Silmaril.Thesis.LambdaIter.Syn.SynCat

open CategoryTheory LocallyNameless

variable {S : Sig.{u}}

/-- The empty elimination arrow of the exact computation category. -/
def emptyElim (B : SynCat S) : of (empty : S.Ty) ⟶ B :=
  mk (HasType.abort (C := B.ty) HasType.newest)

/-- The separate composition congruence generated by sequencing empty elimination. -/
inductive AbortSequenced : {A B : SynCat S} → (A ⟶ B) → (A ⟶ B) → Prop where
  | exact {A B : SynCat S} {f g : A ⟶ B} : f = g → AbortSequenced f g
  | symm {A B : SynCat S} {f g : A ⟶ B} : AbortSequenced f g → AbortSequenced g f
  | trans {A B : SynCat S} {f g h : A ⟶ B} :
      AbortSequenced f g → AbortSequenced g h → AbortSequenced f h
  | comp {A B D : SynCat S} {f f' : A ⟶ B} {g g' : B ⟶ D} :
      AbortSequenced f f' → AbortSequenced g g' → AbortSequenced (f ≫ g) (f' ≫ g')
  | seq {A B : SynCat S} {a : Tm Empty S.Instr 1}
      (h : HasType S.Instr Ctx.nil (.snoc .nil A.ty) a (empty : S.Ty)) :
      AbortSequenced (mk (HasType.abort (C := B.ty) h) : A ⟶ B)
        (mk (HasType.let₁ h (HasType.abort (C := B.ty) HasType.newest)))

def abortSequencedSetoid (A B : SynCat S) : Setoid (A ⟶ B) where
  r := AbortSequenced
  iseqv := ⟨fun _ => .exact rfl, .symm, .trans⟩

/-- The separate quotient's projection on computation arrows. -/
def abortSequencedClass {A B : SynCat S} (f : A ⟶ B) :
    Quotient (abortSequencedSetoid A B) := Quotient.mk _ f

/-- The added law commutes empty elimination with context packing. -/
theorem packed_abort_seq {n : Nat} {β : BoundCtx S.Ty n} {a : Tm Empty S.Instr n}
    (d : HasType S.Instr Ctx.nil β a (empty : S.Ty)) (B : SynCat S) :
    AbortSequenced (packedArrow d ≫ emptyElim B) (packedArrow (HasType.abort (C := B.ty) d)) :=
  (AbortSequenced.seq (A := of (packType β)) (B := B) (packedTyping d)).symm

theorem packed_op {n : Nat} {β : BoundCtx S.Ty n} {a : Tm Empty S.Instr n}
    (f : S.Instr) (d : HasType S.Instr Ctx.nil β a (instrSrc f)) :
    packedArrow d ≫ (mk (HasType.op (f := f) HasType.newest) :
      of (instrSrc f) ⟶ of (instrTrg f)) = packedArrow (HasType.op (f := f) d) := by
  apply Quotient.sound
  let h := packedTyping d
  let op := HasType.op (f := f) h
  let next := HasType.op (f := f) (HasType.newest (Φ := S.Instr)
    (Γ := (Ctx.nil : Ctx Empty S.Ty)) (β := .snoc .nil (packType β)))
  have eta := Eqv.ax (pureEff := S.pureEff) (.structural (.letEta _))
    (.let₁ op HasType.newest) op
  have sequence := Eqv.ax (pureEff := S.pureEff) (.sequencing (.bindOp _ _))
    (.let₁ op HasType.newest) (.let₁ h (.let₁ next HasType.newest))
  have etaNext := Eqv.ax (pureEff := S.pureEff) (.structural (.letEta _))
    (.let₁ next HasType.newest) next
  exact ((eta.symm.trans sequence).trans (.let₁ (.refl h) etaNext)).symm

end Silmaril.Thesis.LambdaIter.Syn.SynCat

namespace Silmaril.Isotope.LetIter.Semantics.Categorical.Syntactic

open CategoryTheory
open Silmaril.Thesis.LambdaIter.Syn.SynCat

variable {τ Φ ε : Type u} [TypeFormers τ] [HasTy Φ τ] [HasEff Φ ε]
local instance : Silmaril.Thesis.LambdaIter.TypeFormers τ := Bridge.thesisTypeFormers τ
local instance : Silmaril.Thesis.LambdaIter.HasTy Φ τ := Bridge.thesisHasTy Φ τ
local instance : Silmaril.Thesis.LambdaIter.HasEff Φ ε := Bridge.thesisHasEff Φ ε

private noncomputable def packDenote (pe : ε) {n : Nat} {β : BoundCtx τ n}
    {a : LocallyNameless.Tm Empty Φ n} {A : τ}
    (d : LocallyNameless.Derivation Φ (Ctx.nil : Ctx Empty τ) β a A) :=
  (values (signature (τ := τ) (Φ := Φ) pe)).map (packedEnvIso (Φ := Φ) pe β).inv ≫
    denoteInSyntax pe d

/-- Native abort reifies in the explicitly extended hom quotient if its scrutinee does.
The free context is empty and the bound context is arbitrary. -/
theorem reify_abort_seq (pe : ε) {n : Nat} {β : BoundCtx τ n}
    {a : LocallyNameless.Tm Empty Φ n} (A : τ)
    (d : LocallyNameless.Derivation Φ (Ctx.nil : Ctx Empty τ) β a (empty : τ))
    (hd : Silmaril.Thesis.LambdaIter.LocallyNameless.HasType Φ .nil (Bridge.BoundCtx.toThesis β)
      (Bridge.toThesis a) (empty : τ))
    (ih : abortSequencedClass (packDenote pe d) =
      abortSequencedClass (packedArrow (S := signature (τ := τ) (Φ := Φ) pe) hd)) :
    abortSequencedClass (packDenote pe (.abort (C := A) d)) = abortSequencedClass
      (packedArrow (S := signature (τ := τ) (Φ := Φ) pe)
        (Silmaril.Thesis.LambdaIter.LocallyNameless.HasType.abort (C := A) hd)) := by
  let S := signature (τ := τ) (Φ := Φ) pe
  let J := values S
  let B := of (S := S) A
  let e : of (S := S) (empty : τ) ⟶ B :=
    J.map ((typeModel (Φ := Φ) pe).emptyIsInitial.to (valueObj pe A))
  have elim : e = emptyElim B := fromEmpty_unique B e _
  have step : packDenote pe (.abort (C := A) d) = packDenote pe d ≫ emptyElim B := by
    change J.map (packedEnvIso (Φ := Φ) pe β).inv ≫ denoteInSyntax pe d ≫ e = _
    rw [elim]
    exact (Category.assoc _ _ _).symm
  apply Quotient.sound
  exact (AbortSequenced.exact step).trans
    ((AbortSequenced.comp (Quotient.exact ih) (.exact rfl)).trans (packed_abort_seq hd B))


theorem reify_unit_exact (pe : ε) {n : Nat} (β : BoundCtx τ n) :
    packDenote pe (LocallyNameless.Derivation.unit (Φ := Φ) (Γ := (Ctx.nil : Ctx Empty τ)) (β := β)) =
      packedArrow (S := signature (τ := τ) (Φ := Φ) pe)
        (Silmaril.Thesis.LambdaIter.LocallyNameless.HasType.unit
          (β := Bridge.BoundCtx.toThesis β)) := by
  let S := signature (τ := τ) (Φ := Φ) pe
  let J := values S
  let h := Silmaril.Thesis.LambdaIter.LocallyNameless.HasType.unit
    (Φ := Φ) (Γ := (Silmaril.Thesis.LambdaIter.Ctx.nil : Silmaril.Thesis.LambdaIter.Ctx Empty τ))
    (β := Bridge.BoundCtx.toThesis β)
  let P := valueObj (Φ := Φ) pe (packType (S := S) (Bridge.BoundCtx.toThesis β))
  let U := valueObj (Φ := Φ) pe (unit : τ)
  let q : P ⟶ U := ⟨packedArrow (S := S) h, packedArrow_isPureMor h .unit⟩
  let p : P ⟶ U := (packedEnvIso (Φ := Φ) pe β).inv ≫
    CategoryTheory.CartesianMonoidalCategory.toUnit _ ≫ (typeModel (Φ := Φ) pe).unitIso.inv
  have terminal : CategoryTheory.Limits.IsTerminal U := valueUnitIsTerminal S
  change J.map (packedEnvIso (Φ := Φ) pe β).inv ≫ J.map _ = J.map q
  rw [← J.map_comp]
  exact congrArg J.map (terminal.hom_ext p q)

theorem reify_op_exact (pe : ε) {n : Nat} {β : BoundCtx τ n}
    {a : LocallyNameless.Tm Empty Φ n} (f : Φ)
    (d : LocallyNameless.Derivation Φ (Ctx.nil : Ctx Empty τ) β a (instrSrc f))
    (hd : Silmaril.Thesis.LambdaIter.LocallyNameless.HasType Φ .nil (Bridge.BoundCtx.toThesis β)
      (Bridge.toThesis a) (instrSrc f))
    (ih : packDenote pe d = packedArrow (S := signature (τ := τ) (Φ := Φ) pe) hd) :
    packDenote pe (LocallyNameless.Derivation.op (f := f) d) =
      packedArrow (S := signature (τ := τ) (Φ := Φ) pe)
        (Silmaril.Thesis.LambdaIter.LocallyNameless.HasType.op (f := f) hd) := by
  let S := signature (τ := τ) (Φ := Φ) pe
  let k := (instructionModel (τ := τ) pe).denote f
  have step : packDenote pe (LocallyNameless.Derivation.op (f := f) d) = packDenote pe d ≫ k :=
    (Category.assoc _ _ _).symm
  exact step.trans ((congrArg (fun a => a ≫ k) ih).trans (packed_op (S := S) f hd))

#print axioms reify_unit_exact
#print axioms reify_op_exact
#print axioms packed_abort_seq
#print axioms reify_abort_seq


section Effectful

local instance : Silmaril.HasTy Bool (Ty Empty) where
  src _ := Ty.unit
  trg _ := Ty.empty

local instance : Silmaril.HasEff Bool Bool where
  eff _ := true

private def unitDerivation :
    LocallyNameless.Derivation Bool (Ctx.nil : Ctx Empty (Ty Empty)) .nil .unit Ty.unit := .unit

private def unitTyping :
    Silmaril.Thesis.LambdaIter.LocallyNameless.HasType Bool
      (Silmaril.Thesis.LambdaIter.Ctx.nil : Silmaril.Thesis.LambdaIter.Ctx Empty (Ty Empty))
      .nil .unit Ty.unit := .unit

/-- The effectful closed abort of the reflection counterexample reifies in
the separate abort-sequencing presentation. This is the direct abort from
the counterexample to general exact reflection. -/
theorem reify_effectful_closed_abort :
    abortSequencedClass (packDenote false (LocallyNameless.Derivation.abort
      (C := Ty.unit) (LocallyNameless.Derivation.op (f := true) unitDerivation))) =
      abortSequencedClass (packedArrow
        (S := signature (τ := Ty Empty) (Φ := Bool) false)
        (Silmaril.Thesis.LambdaIter.LocallyNameless.HasType.abort (C := Ty.unit)
          (Silmaril.Thesis.LambdaIter.LocallyNameless.HasType.op (f := true) unitTyping))) := by
  apply reify_abort_seq
  exact congrArg abortSequencedClass
    (reify_op_exact false true unitDerivation unitTyping (reify_unit_exact false .nil))

#print axioms reify_effectful_closed_abort

end Effectful

end Silmaril.Isotope.LetIter.Semantics.Categorical.Syntactic
