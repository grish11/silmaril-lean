build bssl: CXX_EXECUTABLE_LINKER__bssl_Release CMakeFiles/bssl.dir/tool/args.cc.o CMakeFiles/bssl.dir/tool/ciphers.cc.o CMakeFiles/bssl.dir/tool/client.cc.o CMakeFiles/bssl.dir/tool/const.cc.o CMakeFiles/bssl.dir/tool/digest.cc.o CMakeFiles/bssl.dir/tool/fd.cc.o CMakeFiles/bssl.dir/tool/file.cc.o CMakeFiles/bssl.dir/tool/generate_ech.cc.o CMakeFiles/bssl.dir/tool/generate_ed25519.cc.o CMakeFiles/bssl.dir/tool/genrsa.cc.o CMakeFiles/bssl.dir/tool/pkcs12.cc.o CMakeFiles/bssl.dir/tool/rand.cc.o CMakeFiles/bssl.dir/tool/server.cc.o CMakeFiles/bssl.dir/tool/sign.cc.o CMakeFiles/bssl.dir/tool/tool.cc.o CMakeFiles/bssl.dir/tool/transport_common.cc.o | libssl.so libcrypto.so || libcrypto.so libssl.so
  DEP_FILE = CMakeFiles/bssl.dir/link.d
  FLAGS = -O2 -g0 -ffile-prefix-map=/build/boringssl=. -fno-strict-aliasing -ggdb -fno-common -fvisibility=hidden -g0 -DNDEBUG
  LINK_FLAGS = -Wl,--dependency-file=CMakeFiles/bssl.dir/link.d
  LINK_LIBRARIES = -Wl,-rpath,/build/boringssl/boringssl-ebd922adc708a48b0cccfcdf81e854a3fdc1b7b6/build:  libssl.so  libcrypto.so
  OBJECT_DIR = CMakeFiles/bssl.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = CMakeFiles/bssl.dir/
  TARGET_FILE = bssl
  TARGET_PDB = bssl.pdb


