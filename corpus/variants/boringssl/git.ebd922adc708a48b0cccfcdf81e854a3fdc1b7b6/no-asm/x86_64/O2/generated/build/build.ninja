# Link the shared library libssl.so

build libssl.so: CXX_SHARED_LIBRARY_LINKER__ssl_Release CMakeFiles/ssl.dir/ssl/bio_ssl.cc.o CMakeFiles/ssl.dir/ssl/d1_both.cc.o CMakeFiles/ssl.dir/ssl/d1_lib.cc.o CMakeFiles/ssl.dir/ssl/d1_pkt.cc.o CMakeFiles/ssl.dir/ssl/d1_srtp.cc.o CMakeFiles/ssl.dir/ssl/dtls_method.cc.o CMakeFiles/ssl.dir/ssl/dtls_record.cc.o CMakeFiles/ssl.dir/ssl/encrypted_client_hello.cc.o CMakeFiles/ssl.dir/ssl/extensions.cc.o CMakeFiles/ssl.dir/ssl/handoff.cc.o CMakeFiles/ssl.dir/ssl/handshake.cc.o CMakeFiles/ssl.dir/ssl/handshake_client.cc.o CMakeFiles/ssl.dir/ssl/handshake_server.cc.o CMakeFiles/ssl.dir/ssl/s3_both.cc.o CMakeFiles/ssl.dir/ssl/s3_lib.cc.o CMakeFiles/ssl.dir/ssl/s3_pkt.cc.o CMakeFiles/ssl.dir/ssl/ssl_aead_ctx.cc.o CMakeFiles/ssl.dir/ssl/ssl_asn1.cc.o CMakeFiles/ssl.dir/ssl/ssl_buffer.cc.o CMakeFiles/ssl.dir/ssl/ssl_cert.cc.o CMakeFiles/ssl.dir/ssl/ssl_cipher.cc.o CMakeFiles/ssl.dir/ssl/ssl_credential.cc.o CMakeFiles/ssl.dir/ssl/ssl_file.cc.o CMakeFiles/ssl.dir/ssl/ssl_key_share.cc.o CMakeFiles/ssl.dir/ssl/ssl_lib.cc.o CMakeFiles/ssl.dir/ssl/ssl_privkey.cc.o CMakeFiles/ssl.dir/ssl/ssl_session.cc.o CMakeFiles/ssl.dir/ssl/ssl_stat.cc.o CMakeFiles/ssl.dir/ssl/ssl_transcript.cc.o CMakeFiles/ssl.dir/ssl/ssl_versions.cc.o CMakeFiles/ssl.dir/ssl/ssl_x509.cc.o CMakeFiles/ssl.dir/ssl/t1_enc.cc.o CMakeFiles/ssl.dir/ssl/tls13_both.cc.o CMakeFiles/ssl.dir/ssl/tls13_client.cc.o CMakeFiles/ssl.dir/ssl/tls13_enc.cc.o CMakeFiles/ssl.dir/ssl/tls13_server.cc.o CMakeFiles/ssl.dir/ssl/tls_method.cc.o CMakeFiles/ssl.dir/ssl/tls_record.cc.o | libcrypto.so || libcrypto.so
  DEP_FILE = CMakeFiles/ssl.dir/link.d
  LANGUAGE_COMPILE_FLAGS = -O2 -g0 -ffile-prefix-map=/build/boringssl=. -fno-strict-aliasing -ggdb -fno-common -fvisibility=hidden -g0 -DNDEBUG
  LINK_FLAGS = -Wl,--dependency-file=CMakeFiles/ssl.dir/link.d
  LINK_LIBRARIES = -Wl,-rpath,/build/boringssl/boringssl-ebd922adc708a48b0cccfcdf81e854a3fdc1b7b6/build:  libcrypto.so
  OBJECT_DIR = CMakeFiles/ssl.dir
  POST_BUILD = :
  PRE_LINK = :
  SONAME = libssl.so
  SONAME_FLAG = -Wl,-soname,
  TARGET_COMPILE_PDB = CMakeFiles/ssl.dir/
  TARGET_FILE = libssl.so
  TARGET_PDB = libssl.pdb

